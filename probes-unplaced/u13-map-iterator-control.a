// Row 13 control: the iterator replaced by an object literal that holds the map.
interface Node { name: string; next: Node[]; iterators: { map: Map<string, Node> }[] }
const a: Node = { name: 'a' + '', next: [], iterators: [] };
const b: Node = { name: 'b' + '', next: [a], iterators: [] };
a.next.push(b); // this cycle makes the program a graph program, so Node values must be in a region
const map = new Map<string, Node>([[a.name, a]]);
a.iterators.push({ map: map }); // a holds the holder, the holder holds map, map holds a
console.log(`${a.name} ${a.iterators.length} ${map.size} ${map.get('a')?.iterators.length}`);
