// Row 6 control: the same array built by a literal.
interface Node { name: string; next: Node[] }
const a: Node = { name: 'a' + '', next: [] };
const b: Node = { name: 'b' + '', next: [a] };
a.next.push(b); // this cycle makes the program a graph program, so Node values must be in a region
const spliced: Node[] = [b, a];
a.next = spliced; // a holds spliced, spliced holds b (and a), b holds a
console.log(`${a.name} ${a.next.length} ${a.next[0]?.name} ${a.next[0]?.next[0] === a}`);
