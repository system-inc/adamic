// Row 8 (extra): spreading an explicit iterable object, since generators are refused.
interface Node { name: string; next: Node[] }
const a: Node = { name: 'a' + '', next: [] };
const b: Node = { name: 'b' + '', next: [a] };
a.next.push(b); // this cycle makes the program a graph program, so Node values must be in a region
const source = {
    [Symbol.iterator]() {
        let index = 0;
        return {
            next(): { value: Node; done: boolean } {
                index++;
                return { value: b, done: index > 1 };
            },
        };
    },
};
const spread = [...source];
a.next = spread; // a holds spread, spread holds b, b holds a
console.log(`${a.name} ${a.next.length} ${a.next[0]?.name} ${a.next[0]?.next[0] === a}`);
