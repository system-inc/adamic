// @system_adamic Oct 8 07:57: concrete private-constructor indices until generic
// enclosing-type-parameter instantiation lands. Collapse to ArenaIndex<Tag> here
// with all call sites in one commit, no shims. Absent is Index | undefined.
// CFG indices are kept beside the IR indices below; all collapse in place together.
import { panic } from 'adamic';
export class FunctionIndex {
    readonly slot: number;
    private constructor(slot: number) { this.slot = slot; }
    static push(arena: FunctionIndex[]): FunctionIndex {
        const index = new FunctionIndex(arena.length); arena.push(index); return index;
    }
    static read(arena: readonly FunctionIndex[], index: FunctionIndex): number {
        if(!Number.isInteger(index.slot) || index.slot < 0 || index.slot >= arena.length) { panic('FunctionIndex out of range'); }
        if(arena[index.slot] !== index) { panic('FunctionIndex belongs to another arena'); }
        return index.slot;
    }
}
