import { FunctionIndex, BlockIndex, PatternIndex, ScopeIndex, ReactiveIndex } from '../arena_index.a';
const functions: FunctionIndex[] = []; const blocks: BlockIndex[] = [];
const first = FunctionIndex.push(functions); const second = FunctionIndex.push(functions); const third = FunctionIndex.push(functions);
const patterns: PatternIndex[] = []; const pattern = PatternIndex.push(patterns);
const block = BlockIndex.push(blocks); const absent: FunctionIndex | undefined = undefined;
console.log(`${first.slot},${second.slot},${FunctionIndex.read(functions, third)}:${BlockIndex.read(blocks, block)}:${PatternIndex.read(patterns, pattern)}:${absent === undefined}`);

const scopes: ScopeIndex[] = []; const reactive: ReactiveIndex[] = [];
const scope = ScopeIndex.push(scopes); const node = ReactiveIndex.push(reactive);
if(ScopeIndex.read(scopes,scope) !== 0 || ReactiveIndex.read(reactive,node) !== 0) { console.log('scope/reactive identity differs'); }
