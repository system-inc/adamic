import { marks, controls, formats, letters, symbols } from './unicode.a';
function contains(ranges: readonly number[], code: number): boolean {
    let left = 0; let right = ranges.length / 2;
    while(left < right) {
        const middle = Math.floor((left + right) / 2);
        const start = ranges[middle * 2] ?? 0;
        const end = ranges[middle * 2 + 1] ?? 0;
        if(code < start) right = middle;
        else if(code > end) left = middle + 1;
        else return true;
    }
    return false;
}
function extend(code: number): boolean {
    return contains(marks, code) || code === 0x200c || code === 0x200d || (code >= 0x1f3fb && code <= 0x1f3ff) || (code >= 0xe0020 && code <= 0xe007f) || code === 0xe33 || code === 0xeb3;
}
function control(code: number): boolean { return contains(controls, code) || (contains(formats, code) && !extend(code)); }
function regional(code: number): boolean { return code >= 0x1f1e6 && code <= 0x1f1ff; }
function pictograph(code: number): boolean {
    return (code >= 0x1f000 && code <= 0x1faff && !regional(code) && !(code >= 0x1f3fb && code <= 0x1f3ff)) || (code >= 0x2600 && code <= 0x27bf) || contains(symbols, code);
}
function leading(code: number): boolean { return code >= 0x1100 && code <= 0x115f; }
function vowel(code: number): boolean { return code >= 0x1160 && code <= 0x11a7; }
function trailing(code: number): boolean { return code >= 0x11a8 && code <= 0x11ff; }
function syllable(code: number): boolean { return code >= 0xac00 && code <= 0xd7a3; }
function vowelSyllable(code: number): boolean { return syllable(code) && (code - 0xac00) % 28 === 0; }
function hangul(previous: number, code: number): boolean {
    if(leading(previous)) return leading(code) || vowel(code) || syllable(code);
    if(vowel(previous) || vowelSyllable(previous)) return vowel(code) || trailing(code);
    if(trailing(previous) || syllable(previous)) return trailing(code);
    return false;
}
export function graphemes(value: string): number {
    let count = 0; let previous = 0; let startsWithPictograph = false; let indicators = 0;
    for(let index = 0; index < value.length; index++) {
        const code = value.codePointAt(index) ?? 0;
        let continues = false;
        if(index > 0) {
            if(previous === 13 && code === 10) continues = true;
            else if(control(previous)) continues = false;
            else if(extend(code)) continues = true;
            else if(previous === 0x200d && startsWithPictograph && pictograph(code)) continues = true;
            else if(regional(previous) && regional(code)) continues = indicators % 2 === 1;
            else if([0x94d, 0x9cd, 0xacd, 0xb4d, 0xc4d, 0xd4d].includes(previous) && contains(letters, code) && (previous >> 7) === (code >> 7)) continues = true;
            else continues = hangul(previous, code);
        }
        if(continues) { if(regional(code)) indicators++; }
        else { count++; startsWithPictograph = pictograph(code); indicators = regional(code) ? 1 : 0; }
        previous = code;
        if(code > 65535) index++;
    }
    return count;
}
