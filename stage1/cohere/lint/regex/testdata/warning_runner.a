import { Parser } from '../../../../typescript/parser/parser.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { written } from '../../../../typescript/parser/nodes.ts';
import { Linter } from '../../lint.ts';
import { Settings } from '../../settings.ts';
import { warningFixtures } from './warning_fixtures.a';
const fixtures = warningFixtures();
for(let index = 0; index < fixtures.length; index++) {
    const fixture = fixtures[index];
    if(fixture === undefined) continue;
    const parser = new Parser(fixture.source, fixture.file);
    const scanner = new Scanner(fixture.source);
    const settings = new Settings();
    settings.load(fixture.options);
    const linter = new Linter(fixture.source, parser, scanner, 'no-warning-comments', '', '', false, settings);
    linter.run();
    console.log(`case ${index}`);
    for(const finding of linter.findings) console.log(`${finding.start}:${finding.end}:${finding.id}:${written(finding.message)}`);
    console.log(`fixed ${written(linter.fixed())}`);
}
