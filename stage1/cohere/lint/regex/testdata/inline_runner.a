import { InlineCommentsRule, syntaxKinds } from '../inline_rule.a';
import { inlineFixtures } from './inline_fixtures.a';
import { written } from '../../../../typescript/parser/nodes.ts';
const fixtures = inlineFixtures();
for(let index = 0; index < fixtures.length; index++) {
 const fixture = fixtures[index];
 if(fixture === undefined || !syntaxKinds.includes(fixture.kind)) continue;
 const rule = new InlineCommentsRule(fixture.pattern);
 console.log(`case ${index}`);
 for(const finding of rule.visit(fixture)) console.log(`${finding.start}:${finding.end}:${finding.id}:${written(finding.message)}`);
 console.log(`fixed ${written(fixture.source)}`);
}
