// tailwind/class_literals.go:167; pattern
import { observe } from '../observe.a';
const pattern = "^classes(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "classes", 4);
observe(regex, "xclasses", 5);
observe(regex, "classes\n", 6);
