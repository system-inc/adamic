// nexus/abbreviation_vocabulary.go:162; `^` + entry.Abbreviation + `[A-Z]`
import { observe } from '../observe.a';
const pattern = "^cfg[A-Z]";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "cfgA", 4);
observe(regex, "xcfgA", 5);
observe(regex, "cfgA\n", 6);
