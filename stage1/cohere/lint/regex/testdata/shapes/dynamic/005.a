// core/id_match.go:111; patternText
import { observe } from '../observe.a';
const pattern = "^[a-z]+(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "a", 4);
observe(regex, "xa", 5);
observe(regex, "a\n", 6);
observe(regex, "todo", 7);
observe(regex, "file", 8);
observe(regex, "to", 9);
