// nexus/abbreviation_vocabulary.go:177; `[a-z0-9]` + word + `($|[A-Z0-9])`
import { observe } from '../observe.a';
const pattern = "[a-z0-9]Cfg((?![\\s\\S])|[A-Z0-9])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "0Cfg", 4);
observe(regex, "x0Cfg", 5);
observe(regex, "0Cfg\n", 6);
