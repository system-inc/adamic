// tailwind/enforce_canonical_classes.go:334; pattern
import { observe } from '../observe.a';
const pattern = "^custom-";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "custom-", 4);
observe(regex, "xcustom-", 5);
observe(regex, "custom-\n", 6);
