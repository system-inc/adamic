// core/default_case.go:99; resolved.CommentPattern
import { observe } from '../observe.a';
const pattern = "^no default(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "no default", 4);
observe(regex, "xno default", 5);
observe(regex, "no default\n", 6);
