// core/no_unused_vars.go:2276; pattern
import { observe } from '../observe.a';
const pattern = "^_";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "_", 4);
observe(regex, "x_", 5);
observe(regex, "_\n", 6);
observe(regex, "__String", 7);
observe(regex, "_namespaces", 8);
