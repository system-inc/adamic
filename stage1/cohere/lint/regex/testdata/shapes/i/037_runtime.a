// tailwind/collapse/signature.go:71; `(?i)#(?:[a-f0-9]{8}|[a-f0-9]{6}|[a-f0-9]{4}|[a-f0-9]{3})`
import { observe } from '../observe.a';
import { programArguments } from 'adamic';
const argumentsList = programArguments();
const pattern = argumentsList[0] ?? '';
const flags = argumentsList[1] ?? '';
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "#AAAAAAAA", 4);
observe(regex, "x#AAAAAAAA", 5);
observe(regex, "#AAAAAAAA\n", 6);
observe(regex, "// TODO: GH#18217", 7);
observe(regex, "// Omit declaration files from bundle results, too // TODO: GH#18217", 8);
observe(regex, "// TODO: GH#18217 Optional methods are frequently used as non-optional", 9);
