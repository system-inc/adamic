import { observe } from '../observe.a';
const pattern = "^(?:[a-z][0-9+.a-z-]*:|//)";
const flags = "gui";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "A:", 4);
observe(regex, "xA:", 5);
observe(regex, "A:\n", 6);
observe(regex, "// XXX", 7);
observe(regex, "// getModuleInstanceStateForAliasTarget needs to walk up the parent chain, so parent pointers must be set on this tree already", 8);
observe(regex, "// A module is uninstantiated if it contains only", 9);
