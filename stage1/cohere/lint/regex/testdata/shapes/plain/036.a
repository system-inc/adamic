// tailwind/collapse/class_list.go:68; `(\d+)_(\d+)`
import { observe } from '../observe.a';
const pattern = "(\\d+)_(\\d+)";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "0_0", 4);
observe(regex, "x0_0", 5);
observe(regex, "0_0\n", 6);
