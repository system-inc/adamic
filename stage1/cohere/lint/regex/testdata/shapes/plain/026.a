// nexus/consistency_require_matching_return_type.go:216; `^return\s+undefined;$`
import { observe } from '../observe.a';
const pattern = "^return[ \\t\\n\\f\\r]+undefined;(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "return\tundefined;", 4);
observe(regex, "xreturn\tundefined;", 5);
observe(regex, "return\tundefined;\n", 6);
