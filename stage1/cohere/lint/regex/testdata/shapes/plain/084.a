// tailwind/no_deprecated_classes.go:79; `^placeholder-opacity-(.*)$`
import { observe } from '../observe.a';
const pattern = "^placeholder-opacity-([^\\n]*)(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "placeholder-opacity-", 4);
observe(regex, "xplaceholder-opacity-", 5);
observe(regex, "placeholder-opacity-\n", 6);
