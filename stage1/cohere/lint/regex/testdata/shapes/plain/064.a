// tailwind/no_deprecated_classes.go:73; `^bg-opacity-(.*)$`
import { observe } from '../observe.a';
const pattern = "^bg-opacity-([^\\n]*)(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "bg-opacity-", 4);
observe(regex, "xbg-opacity-", 5);
observe(regex, "bg-opacity-\n", 6);
