// nexus/shouting.go:124; `[AEIOUY]`
import { observe } from '../observe.a';
const pattern = "[AEIOUY]";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "A", 4);
observe(regex, "xA", 5);
observe(regex, "A\n", 6);
observe(regex, "PaginationInput", 7);
observe(regex, "TODO", 8);
observe(regex, "🌍TODO", 9);
