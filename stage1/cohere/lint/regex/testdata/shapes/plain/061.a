// react/no_unstable_nested_components.go:450; `^use[A-Z0-9].*$`
import { observe } from '../observe.a';
const pattern = "^use[A-Z0-9][^\\n]*(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "useA", 4);
observe(regex, "xuseA", 5);
observe(regex, "useA\n", 6);
observe(regex, "useEffect(", 7);
