// next/no_html_link_for_pages_routes.go:171; `^page\.[jt]sx?$`
import { observe } from '../observe.a';
const pattern = "^page\\.[jt]sx?(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "page.js", 4);
observe(regex, "xpage.js", 5);
observe(regex, "page.js\n", 6);
