// nexus/consistency_no_ambiguous_identifier.go:19; `^[a-z]$`
import { observe } from '../observe.a';
const pattern = "^[a-z](?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "a", 4);
observe(regex, "xa", 5);
observe(regex, "a\n", 6);
observe(regex, "x", 7);
observe(regex, "s", 8);
