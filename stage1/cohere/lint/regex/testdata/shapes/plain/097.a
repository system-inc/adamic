// tailwind/no_deprecated_classes.go:98; `^object-left-bottom$`
import { observe } from '../observe.a';
const pattern = "^object-left-bottom(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "object-left-bottom", 4);
observe(regex, "xobject-left-bottom", 5);
observe(regex, "object-left-bottom\n", 6);
