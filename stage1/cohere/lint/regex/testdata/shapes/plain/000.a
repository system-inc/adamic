// base/consistency_require_pagination_argument_name.go:27; `PaginationInput$`
import { observe } from '../observe.a';
const pattern = "PaginationInput(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "PaginationInput", 4);
observe(regex, "xPaginationInput", 5);
observe(regex, "PaginationInput\n", 6);
