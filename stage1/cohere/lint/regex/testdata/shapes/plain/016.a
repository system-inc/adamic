// core/require_description.go:220; `^(eslint(?:-env|-enable|-disable(?:(?:-next)?-line)?)?|exported|globals?)(?:` + jsWhitespace + `|$)`
import { observe } from '../observe.a';
const pattern = "^(eslint(?:-env|-enable|-disable(?:(?:-next)?-line)?)?|exported|globals?)(?:[\\t\\n\\x0B\\f\\r \\u{00A0}\\u{1680}\\u{2000}-\\u{200A}\\u{2028}\\u{2029}\\u{202F}\\u{205F}\\u{3000}\\u{FEFF}]|(?![\\s\\S]))";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "eslint\t", 4);
observe(regex, "xeslint\t", 5);
observe(regex, "eslint\t\n", 6);
observe(regex, "eslint-disable no-warning-comments", 7);
observe(regex, "eslint", 8);
observe(regex, "global", 9);
