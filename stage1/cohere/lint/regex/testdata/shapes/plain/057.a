// tailwind/collapse/utility_nodes.go:142; `(-\*){2,}`
import { observe } from '../observe.a';
const pattern = "(-\\*){2,}";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "-*-*", 4);
observe(regex, "x-*-*", 5);
observe(regex, "-*-*\n", 6);
