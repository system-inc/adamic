// core/require_description.go:217; jsWhitespace + `-{2,}` + jsWhitespace
import { observe } from '../observe.a';
const pattern = "[\\t\\n\\x0B\\f\\r \\u{00A0}\\u{1680}\\u{2000}-\\u{200A}\\u{2028}\\u{2029}\\u{202F}\\u{205F}\\u{3000}\\u{FEFF}]-{2,}[\\t\\n\\x0B\\f\\r \\u{00A0}\\u{1680}\\u{2000}-\\u{200A}\\u{2028}\\u{2029}\\u{202F}\\u{205F}\\u{3000}\\u{FEFF}]";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "\t--\t", 4);
observe(regex, "x\t--\t", 5);
observe(regex, "\t--\t\n", 6);
observe(regex, "// string -- any of: string", 7);
observe(regex, "// number -- any of: number", 8);
observe(regex, "// boolean -- any of: boolean", 9);
