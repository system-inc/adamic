// tailwind/no_deprecated_classes.go:90; `^decoration-clone$`
import { observe } from '../observe.a';
const pattern = "^decoration-clone(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "decoration-clone", 4);
observe(regex, "xdecoration-clone", 5);
observe(regex, "decoration-clone\n", 6);
