// nexus/consistency_no_boolean_outcome.go:48; `(Interface|Type|Result|Response|Properties)+$`
import { observe } from '../observe.a';
import { programArguments } from 'adamic';
const argumentsList = programArguments();
const pattern = argumentsList[0] ?? '';
const flags = argumentsList[1] ?? '';
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "Interface", 4);
observe(regex, "xInterface", 5);
observe(regex, "Interface\n", 6);
observe(regex, "AffectedFileResult", 7);
observe(regex, "EmitResult", 8);
observe(regex, "AnonymousType", 9);
