// tailwind/no_deprecated_classes.go:67; `^blur$`
import { observe } from '../observe.a';
const pattern = "^blur(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "blur", 4);
observe(regex, "xblur", 5);
observe(regex, "blur\n", 6);
