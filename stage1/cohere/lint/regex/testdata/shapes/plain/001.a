// base/consistency_require_pagination_argument_name.go:30; `Pagination$`
import { observe } from '../observe.a';
const pattern = "Pagination(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "Pagination", 4);
observe(regex, "xPagination", 5);
observe(regex, "Pagination\n", 6);
