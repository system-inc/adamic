// tailwind/no_deprecated_classes.go:87; `^overflow-ellipsis$`
import { observe } from '../observe.a';
const pattern = "^overflow-ellipsis(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "overflow-ellipsis", 4);
observe(regex, "xoverflow-ellipsis", 5);
observe(regex, "overflow-ellipsis\n", 6);
