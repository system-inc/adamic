// core/require_description.go:225; `^eslint-disable-(next-)?line$`
import { observe } from '../observe.a';
const pattern = "^eslint-disable-(next-)?line(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "eslint-disable-line", 4);
observe(regex, "xeslint-disable-line", 5);
observe(regex, "eslint-disable-line\n", 6);
