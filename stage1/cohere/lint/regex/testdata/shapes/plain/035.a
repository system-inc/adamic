// nexus/shouting.go:177; `'[A-Z0-9_][A-Z0-9_ .,:=\-/]*[A-Z0-9_]'`
import { observe } from '../observe.a';
const pattern = "'[A-Z0-9_][A-Z0-9_ .,:=\\-/]*[A-Z0-9_]'";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "'AA'", 4);
observe(regex, "x'AA'", 5);
observe(regex, "'AA'\n", 6);
