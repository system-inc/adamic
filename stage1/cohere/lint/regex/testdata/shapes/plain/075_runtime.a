// tailwind/no_deprecated_classes.go:66; `^drop-shadow$`
import { observe } from '../observe.a';
import { programArguments } from 'adamic';
const argumentsList = programArguments();
const pattern = argumentsList[0] ?? '';
const flags = argumentsList[1] ?? '';
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "drop-shadow", 4);
observe(regex, "xdrop-shadow", 5);
observe(regex, "drop-shadow\n", 6);
