// tailwind/no_deprecated_classes.go:76; `^border-opacity-(.*)$`
import { observe } from '../observe.a';
const pattern = "^border-opacity-([^\\n]*)(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "border-opacity-", 4);
observe(regex, "xborder-opacity-", 5);
observe(regex, "border-opacity-\n", 6);
