// tailwind/no_deprecated_classes.go:99; `^object-right-top$`
import { observe } from '../observe.a';
const pattern = "^object-right-top(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "object-right-top", 4);
observe(regex, "xobject-right-top", 5);
observe(regex, "object-right-top\n", 6);
