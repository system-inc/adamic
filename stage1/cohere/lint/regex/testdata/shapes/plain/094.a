// tailwind/no_deprecated_classes.go:94; `^bg-right-top$`
import { observe } from '../observe.a';
const pattern = "^bg-right-top(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "bg-right-top", 4);
observe(regex, "xbg-right-top", 5);
observe(regex, "bg-right-top\n", 6);
