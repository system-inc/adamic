// nexus/consistency_require_constant_casing.go:355; `(Creator|Factory)$`
import { observe } from '../observe.a';
import { programArguments } from 'adamic';
const argumentsList = programArguments();
const pattern = argumentsList[0] ?? '';
const flags = argumentsList[1] ?? '';
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "Creator", 4);
observe(regex, "xCreator", 5);
observe(regex, "Creator\n", 6);
observe(regex, "BaseNodeFactory", 7);
observe(regex, "createEmitHelperFactory", 8);
observe(regex, "CustomTransformerFactory", 9);
