// tailwind/collapse/utility_nodes.go:138; `--(.*?)\s--(.*?)`
import { observe } from '../observe.a';
const pattern = "--([^\\n]*?)[ \\t\\n\\f\\r]--([^\\n]*?)";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "--\t--", 4);
observe(regex, "x--\t--", 5);
observe(regex, "--\t--\n", 6);
observe(regex, "// This currently helps enable --diagnostics and --extendedDiagnostics", 7);
