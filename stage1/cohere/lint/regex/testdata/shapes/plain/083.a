// tailwind/no_deprecated_classes.go:78; `^ring-opacity-(.*)$`
import { observe } from '../observe.a';
const pattern = "^ring-opacity-([^\\n]*)(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "ring-opacity-", 4);
observe(regex, "xring-opacity-", 5);
observe(regex, "ring-opacity-\n", 6);
