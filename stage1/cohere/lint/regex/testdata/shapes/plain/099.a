// tailwind/no_deprecated_classes.go:100; `^object-right-bottom$`
import { observe } from '../observe.a';
const pattern = "^object-right-bottom(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "object-right-bottom", 4);
observe(regex, "xobject-right-bottom", 5);
observe(regex, "object-right-bottom\n", 6);
