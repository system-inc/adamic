// nexus/shouting.go:183; `^[ \t]*\*(?: |\t|$)`
import { observe } from '../observe.a';
const pattern = "^[ \\t]*\\*(?: |\\t|(?![\\s\\S]))";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "*\t", 4);
observe(regex, "x*\t", 5);
observe(regex, "*\t\n", 6);
