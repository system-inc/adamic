// tailwind/no_deprecated_classes.go:84; `^flex-grow$`
import { observe } from '../observe.a';
const pattern = "^flex-grow(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "flex-grow", 4);
observe(regex, "xflex-grow", 5);
observe(regex, "flex-grow\n", 6);
