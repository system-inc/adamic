// tailwind/no_deprecated_classes.go:84; `^flex-shrink-(.*)$`
import { observe } from '../observe.a';
const pattern = "^flex-shrink-([^\\n]*)(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "flex-shrink-", 4);
observe(regex, "xflex-shrink-", 5);
observe(regex, "flex-shrink-\n", 6);
