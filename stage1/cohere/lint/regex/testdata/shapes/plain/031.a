// nexus/consistency_no_ambiguous_identifier.go:18; `^on[A-Z]`
import { observe } from '../observe.a';
const pattern = "^on[A-Z]";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "onA", 4);
observe(regex, "xonA", 5);
observe(regex, "onA\n", 6);
observe(regex, "onClick", 7);
