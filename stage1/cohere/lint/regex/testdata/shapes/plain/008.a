// next/no_html_link_for_pages_routes.go:169; `\.[jt]sx?$`
import { observe } from '../observe.a';
const pattern = "\\.[jt]sx?(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, ".js", 4);
observe(regex, "x.js", 5);
observe(regex, ".js\n", 6);
observe(regex, "// See also `isExternalOrCommonJsModule` in utilities.ts", 7);
