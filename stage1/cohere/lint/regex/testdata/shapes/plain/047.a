// nexus/shouting.go:178; `^\s*\*?\s?`
import { observe } from '../observe.a';
const pattern = "^[ \\t\\n\\f\\r]*\\*?[ \\t\\n\\f\\r]?";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "x", 4);
observe(regex, "\n", 5);
observe(regex, "PaginationInput", 6);
observe(regex, "Pagination", 7);
