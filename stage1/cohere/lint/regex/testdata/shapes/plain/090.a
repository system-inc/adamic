// tailwind/no_deprecated_classes.go:88; `^decoration-slice$`
import { observe } from '../observe.a';
const pattern = "^decoration-slice(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "decoration-slice", 4);
observe(regex, "xdecoration-slice", 5);
observe(regex, "decoration-slice\n", 6);
