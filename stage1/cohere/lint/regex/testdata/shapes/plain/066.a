// tailwind/class_existence.go:70; `^\[[^\]]+:[^\]]*\]$`
import { observe } from '../observe.a';
const pattern = "^\\[[^\\]]+:[^\\]]*\\](?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "[A:]", 4);
observe(regex, "x[A:]", 5);
observe(regex, "[A:]\n", 6);
