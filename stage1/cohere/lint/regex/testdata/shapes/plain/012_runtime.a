// core/no_warning_comments.go:378; `\bno-warning-comments\b`
import { observe } from '../observe.a';
import { programArguments } from 'adamic';
const argumentsList = programArguments();
const pattern = argumentsList[0] ?? '';
const flags = argumentsList[1] ?? '';
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "no-warning-comments", 4);
observe(regex, "xno-warning-comments", 5);
observe(regex, "no-warning-comments\n", 6);
observe(regex, "eslint-disable no-warning-comments", 7);
