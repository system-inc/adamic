// tailwind/no_deprecated_classes.go:69; `^backdrop-blur$`
import { observe } from '../observe.a';
const pattern = "^backdrop-blur(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "backdrop-blur", 4);
observe(regex, "xbackdrop-blur", 5);
observe(regex, "backdrop-blur\n", 6);
