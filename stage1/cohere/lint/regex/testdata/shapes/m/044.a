// react/conformance/classify.go:95; `(?m)(?:^|\n)\s*import\b[^\n;]*?['"]react['"]|require\(\s*['"]react['"]\s*\)`
import { observe } from '../observe.a';
const pattern = "(?:(?<=\\n|^)|\\n)[ \\t\\n\\f\\r]*import\\b[^\\n;]*?['\"]react['\"]|require\\([ \\t\\n\\f\\r]*['\"]react['\"][ \\t\\n\\f\\r]*\\)";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "import\"react\"", 4);
observe(regex, "ximport\"react\"", 5);
observe(regex, "import\"react\"\n", 6);
