export interface CollapseThemeOptions { readonly options: number; readonly prefix: string; }
// trimmedSegments must perform Go strings.TrimSpace then collapse.segment with a space separator.
export function collapseParseThemeOptions(params: string, trimmedSegments: (params: string) => readonly string[]): CollapseThemeOptions {
    let options = 0;
    let prefix = '';
    for (const option of trimmedSegments(params)) {
        if (option === 'reference') { options |= 2; }
        else if (option === 'inline') { options |= 1; }
        else if (option === 'default') { options |= 4; }
        else if (option === 'static') { options |= 8; }
        else if (option.startsWith('prefix(') && option.endsWith(')')) { prefix = option.slice(7, -1); }
    }
    return { options, prefix };
}
