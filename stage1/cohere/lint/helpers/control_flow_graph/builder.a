export interface Hooks { Expression: ((b: Builder, node: AstNode | undefined) => void) | undefined; Read: ((b: Builder, node: AstNode | undefined) => void) | undefined; Write: ((b: Builder, node: AstNode | undefined) => void) | undefined; Statement: ((b: Builder, node: AstNode | undefined) => void) | undefined; Loop: ((b: Builder, node: AstNode | undefined) => void) | undefined; }
export interface TryFrame { position: string; hasFinally: boolean; catchEntry: BlockIndex; finallyEntry: BlockIndex; thrownForked: boolean; thrownAny: boolean; implicit: BlockIndex[]; returnedAny: boolean; }
export interface JumpTarget { labels: string[]; breakTo: BlockIndex; continueTo: BlockIndex; loop: AstNode | undefined; breakable: boolean; broken: boolean; }
export class Graph { readonly arena: BlockArena; readonly FinalBlocks: BlockIndex[]; readonly ThrownBlocks: BlockIndex[]; readonly EndReachable: boolean; constructor(arena: BlockArena, finals: BlockIndex[], thrown: BlockIndex[], end: boolean) { this.arena=arena; this.FinalBlocks=finals; this.ThrownBlocks=thrown; this.EndReachable=end; finalizePredecessors(arena); } }
export class Builder {
 readonly ast: AstArena; readonly arena = new BlockArena(); readonly hooks: Hooks;
 cur: BlockIndex = -1; finals: BlockIndex[] = []; thrown: BlockIndex[] = [];
 jumps: JumpTarget[] = []; tryStack: TryFrame[] = []; chainJoins: BlockIndex[] = [];
 constructor(ast: AstArena, hooks: Hooks) { this.ast=ast; this.hooks=hooks; }
 block(index: BlockIndex): Block { return this.arena.read(index); }
    parameter(node: AstNode | undefined): void { parameter(this, node); }
    Current(): BlockIndex { return Current(this); }
    Emit(event: number): EventLocation { return Emit(this, event); }
    newBlock(): BlockIndex { return newBlock(this); }
    markFinal(blk: BlockIndex): void { markFinal(this, blk); }
    markThrown(blk: BlockIndex): void { markThrown(this, blk); }
    link(from: BlockIndex, to: BlockIndex): void { link(this, from, to); }
    linkWithCycleBarrier(from: BlockIndex, to: BlockIndex, barrier: boolean): number { return linkWithCycleBarrier(this, from, to, barrier); }
    appendSuccessor(from: BlockIndex, to: BlockIndex): void { appendSuccessor(this, from, to); }
    setCycleBarrier(from: BlockIndex, index: number, barrier: boolean): void { setCycleBarrier(this, from, index, barrier); }
    enter(blk: BlockIndex): void { enter(this, blk); }
    makeUnreachable(): void { makeUnreachable(this); }
    enterDisconnected(blk: BlockIndex): void { enterDisconnected(this, blk); }
    read(node: AstNode | undefined): void { read(this, node); }
    write(node: AstNode | undefined): void { write(this, node); }
    reachedStatement(node: AstNode | undefined): void { reachedStatement(this, node); }
    loop(node: AstNode | undefined): void { loop(this, node); }
    throwFrame(): number { return throwFrame(this); }
    returnFrame(): number { return returnFrame(this); }
    firstThrowableFork(): void { firstThrowableFork(this); }
    snapshotForks(): (boolean)[] { return snapshotForks(this); }
    restoreForks(snapshot: (boolean)[]): void { restoreForks(this, snapshot); }
    expr(node: AstNode | undefined): void { expr(this, node); }
    condition(node: AstNode | undefined, whenTrue: BlockIndex, whenFalse: BlockIndex): void { condition(this, node, whenTrue, whenFalse); }
    visitUnknown(node: AstNode | undefined): void { visitUnknown(this, node); }
    binaryExpression(node: AstNode | undefined): void { binaryExpression(this, node); }
    conditionalExpression(node: AstNode | undefined): void { conditionalExpression(this, node); }
    updateExpression(operand: AstNode | undefined): void { updateExpression(this, operand); }
    accessOrCall(node: AstNode | undefined): void { accessOrCall(this, node); }
    forkOptionalChain(node: AstNode | undefined): void { forkOptionalChain(this, node); }
    typeArguments(node: AstNode | undefined): void { typeArguments(this, node); }
    typeParameters(node: AstNode | undefined): void { typeParameters(this, node); }
    nestedFunction(node: AstNode | undefined): void { nestedFunction(this, node); }
    classLike(node: AstNode | undefined): void { classLike(this, node); }
    memberHeader(node: AstNode | undefined): void { memberHeader(this, node); }
    decorators(node: AstNode | undefined): void { decorators(this, node); }
    patternReads(node: AstNode | undefined): void { patternReads(this, node); }
    patternWrites(node: AstNode | undefined): void { patternWrites(this, node); }
    patternBind(node: AstNode | undefined): void { patternBind(this, node); }
    bindWithDefault(target: AstNode | undefined, fallback: AstNode | undefined): void { bindWithDefault(this, target, fallback); }
    statements(list: readonly AstNode[] | undefined): void { statements(this, list); }
    statement(node: AstNode | undefined): void { statement(this, node); }
    variableDeclarationList(list: AstNode | undefined): void { variableDeclarationList(this, list); }
    variableDeclaration(node: AstNode | undefined): void { variableDeclaration(this, node); }
    ifStatement(node: AstNode | undefined): void { ifStatement(this, node); }
    whileStatement(node: AstNode | undefined): void { whileStatement(this, node); }
    doStatement(node: AstNode | undefined): void { doStatement(this, node); }
    forStatement(node: AstNode | undefined): void { forStatement(this, node); }
    forInOfStatement(node: AstNode | undefined): void { forInOfStatement(this, node); }
    switchStatement(node: AstNode | undefined): void { switchStatement(this, node); }
    tryStatement(node: AstNode | undefined): void { tryStatement(this, node); }
    labeledStatement(node: AstNode | undefined): void { labeledStatement(this, node); }
    pushJump(node: AstNode | undefined, breakTo: BlockIndex, continueTo: BlockIndex, loop: AstNode | undefined): void { pushJump(this, node, breakTo, continueTo, loop); }
    popJump(): void { popJump(this); }
    makeBreak(label: AstNode | undefined): void { makeBreak(this, label); }
    makeContinue(label: AstNode | undefined): void { makeContinue(this, label); }
    makeReturn(): void { makeReturn(this); }
    makeThrow(): void { makeThrow(this); }
    makeYield(): void { makeYield(this); }
}
