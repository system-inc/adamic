import { finalizePredecessors } from './finalize_predecessors.a';
import { panic } from 'adamic';
import { BlockArena, BlockIndex } from './arena.a';
import type { Block } from './arena.a';
import type { AstNode } from './ast.a';
import { AstArena } from './ast.a';
import { parameter } from './parameter.a';
import { Current } from './current.a';
import { Emit } from './emit.a';
import type { EventLocation } from './emit.a';
