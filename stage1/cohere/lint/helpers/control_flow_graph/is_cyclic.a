import { PathAnalysis,pathCyclic,pathOnEveryFinal,pathExit } from './path_analysis.a';
import { BlockIndex } from './arena.a';
export function IsCyclic(a: PathAnalysis, block: BlockIndex): boolean { if(block===-1)return false;a.graph.arena.read(block);a.countToEnd(block);return (a.flag(block)&pathCyclic)!==0; }
