import { PathAnalysis,pathCyclic,pathOnEveryFinal,pathExit } from './path_analysis.a';
import { CfgBlockIndex as BlockIndex } from '../../../arena/arena_index.a';
export function IsCyclic(a: PathAnalysis, block: BlockIndex | undefined): boolean { if(block===undefined)return false;a.graph.arena.read(block);a.countToEnd(block);return (a.flag(block)&pathCyclic)!==0; }
