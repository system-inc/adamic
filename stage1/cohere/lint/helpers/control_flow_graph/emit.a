import type { Builder } from './builder.a';
import { CfgBlockIndex as BlockIndex } from '../../../arena/arena_index.a';
export interface EventLocation { readonly block: BlockIndex; readonly index: number; }
export function Emit(b: Builder,event: number): EventLocation { const current=b.Current();const index=b.block(current).Events.length;b.block(current).Events.push(event);return {block:current,index:index}; }
