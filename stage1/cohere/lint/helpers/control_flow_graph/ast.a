import { panic } from 'adamic';
export const enum NodeIndex { None = -1, First = 0 }
export interface AstNode {
 readonly index: NodeIndex;
 readonly Parent: NodeIndex;
 readonly Kind: string;
 readonly Text: string;
 readonly Operator: string;
 readonly isStatement: boolean;
 readonly optionalChain: boolean;
 readonly outermostChain: boolean;
 readonly optionalRoot: boolean;
 readonly functionLike: boolean;
 readonly jsxTag: boolean;
 readonly Left: NodeIndex;
 readonly Right: NodeIndex;
 readonly Expression: NodeIndex;
 readonly Operand: NodeIndex;
 readonly Name: NodeIndex;
 readonly Body: NodeIndex;
 readonly Type: NodeIndex;
 readonly Initializer: NodeIndex;
 readonly Condition: NodeIndex;
 readonly Incrementor: NodeIndex;
 readonly Statement: NodeIndex;
 readonly ThenStatement: NodeIndex;
 readonly ElseStatement: NodeIndex;
 readonly TryBlock: NodeIndex;
 readonly FinallyBlock: NodeIndex;
 readonly CatchClause: NodeIndex;
 readonly VariableDeclaration: NodeIndex;
 readonly Block: NodeIndex;
 readonly Label: NodeIndex;
 readonly CaseBlock: NodeIndex;
 readonly DeclarationList: NodeIndex;
 readonly WhenTrue: NodeIndex;
 readonly WhenFalse: NodeIndex;
 readonly ArgumentExpression: NodeIndex;
 readonly Tag: NodeIndex;
 readonly Template: NodeIndex;
 readonly Constraint: NodeIndex;
 readonly DefaultType: NodeIndex;
 readonly PropertyName: NodeIndex;
 readonly ObjectAssignmentInitializer: NodeIndex;
 readonly DotDotDotToken: NodeIndex;
 readonly OperatorToken: NodeIndex;
 readonly Statements: readonly NodeIndex[] | undefined;
 readonly Parameters: readonly NodeIndex[] | undefined;
 readonly Arguments: readonly NodeIndex[] | undefined;
 readonly Declarations: readonly NodeIndex[] | undefined;
 readonly Elements: readonly NodeIndex[] | undefined;
 readonly Properties: readonly NodeIndex[] | undefined;
 readonly Clauses: readonly NodeIndex[] | undefined;
 readonly Members: readonly NodeIndex[] | undefined;
 readonly Types: readonly NodeIndex[] | undefined;
 readonly HeritageClauses: readonly NodeIndex[] | undefined;
 readonly TypeArguments: readonly NodeIndex[] | undefined;
 readonly TypeParameters: readonly NodeIndex[] | undefined;
 readonly Decorators: readonly NodeIndex[] | undefined;
 readonly children: readonly NodeIndex[] | undefined;
}
export class AstArena {
 readonly nodes: readonly AstNode[];
 maybe(i: NodeIndex): AstNode | undefined { return i === -1 ? undefined : this.read(i); }
 list(indices: readonly NodeIndex[] | undefined): readonly AstNode[] | undefined { if(indices === undefined) return undefined; const nodes: AstNode[]=[]; for(const index of indices) nodes.push(this.read(index)); return nodes; }
 constructor(nodes: readonly AstNode[]) { this.nodes = nodes; }
 read(i: NodeIndex): AstNode {
 if (i < 0 || i >= this.nodes.length || i !== Math.floor(i)) panic('invalid AST index');
 return this.nodes[i] ?? panic('missing AST index');
 }
}
