import { panic } from 'adamic';
import { BlockIndex } from './arena.a';
import { Graph } from './builder.a';
import { countFinalPaths } from './count_final_paths.a';
import { countToEnd } from './count_to_end.a';
export const pathFinal=1, pathThrown=2, pathExit=4, pathCyclic=8, pathOnEveryFinal=16, pathCounting=32, pathCountKnown=64;
export class PathAnalysis {
 readonly graph: Graph; readonly flags: number[]=[]; readonly paths: number[]=[]; readonly shortest: number[]=[];
 readonly active: number[]=[]; readonly cycleKnown: boolean[]=[]; readonly cycleEnd: boolean[]=[]; readonly path: BlockIndex[]=[];
 hasFinal=false;hasExit=false;shortestExit=0;finalPaths=0;
 constructor(graph: Graph) {this.graph=graph;for(let i=0;i<graph.arena.length;i++){this.flags.push(0);this.paths.push(0);this.shortest.push(0);this.active.push(-1);this.cycleKnown.push(false);this.cycleEnd.push(false);}}
 flag(index: BlockIndex): number {this.graph.arena.read(index);return this.flags[index] ?? panic('missing path state');}
 add(index: BlockIndex, flag: number): void {this.flags[index]=this.flag(index)|flag;}
 countFinalPaths(index: BlockIndex): number {return countFinalPaths(this,index);}
 countToEnd(index: BlockIndex): boolean {return countToEnd(this,index);}
}
