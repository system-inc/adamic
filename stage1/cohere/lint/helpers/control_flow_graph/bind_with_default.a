import { needNode, needList, at, filled, append } from './support.a';
import type { AstNode } from './ast.a';
import type { Builder, Graph, Hooks, TryFrame, JumpTarget } from './builder.a';
import { BlockIndex } from './arena.a';
export function bindWithDefault(b: Builder, target: AstNode | undefined, fallback: AstNode | undefined): void {
    if ((fallback !== undefined)) {
        let join = b.newBlock();
        b.link(b.cur, join);
        let withFallback = b.newBlock();
        b.link(b.cur, withFallback);
        b.enter(withFallback);
        b.expr(fallback);
        b.link(b.cur, join);
        b.enter(join);
    }
    b.patternBind(target);
}
