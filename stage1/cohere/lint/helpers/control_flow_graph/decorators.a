import { emptyNodes, needNode, needList, at, filled, append } from './support.a';
import type { AstNode } from './ast.a';
import type { Builder, Graph, Hooks, TryFrame, JumpTarget } from './builder.a';
import { CfgBlockIndex as BlockIndex } from '../../../arena/arena_index.a';
export function decorators(b: Builder, node: AstNode | undefined): void {
    for (const decorator of (b.ast.list(needNode(node).Decorators) ?? emptyNodes)) {
        b.expr(b.ast.maybe(needNode(decorator).Expression));
    }
}
