// Go big.Int.SetString(text, 0), with its invalid-input fallback, expressed as decimal digits.
export function normalizeBigIntLiteral(text: string): string {
    const digits = text.endsWith('n') ? text.slice(0, -1) : text;
    let position = 0;
    let negative = false;
    if(digits.startsWith('-') || digits.startsWith('+')) {
        negative = digits.startsWith('-');
        position++;
    }
    if(position === digits.length) { return digits; }
    let base = 10;
    let prefix = false;
    if(digits.charCodeAt(position) === 48 && position + 1 < digits.length) {
        const marker = digits.charCodeAt(position + 1);
        if(marker === 120 || marker === 88) { base = 16; position += 2; prefix = true; }
        else if(marker === 98 || marker === 66) { base = 2; position += 2; prefix = true; }
        else if(marker === 111 || marker === 79) { base = 8; position += 2; prefix = true; }
        else { base = 8; }
    }
    const decimal: number[] = [0];
    let previousDigit = prefix;
    let consumedDigit = false;
    for(; position < digits.length; position++) {
        const character = digits.charCodeAt(position);
        if(character === 95) {
            if(!previousDigit) { return digits; }
            previousDigit = false;
            continue;
        }
        let value = -1;
        if(character >= 48 && character <= 57) { value = character - 48; }
        else if(character >= 65 && character <= 70) { value = character - 65 + 10; }
        else if(character >= 97 && character <= 102) { value = character - 97 + 10; }
        if(value < 0 || value >= base) { return digits; }
        previousDigit = true;
        consumedDigit = true;
        let carry = value;
        for(let index = 0; index < decimal.length; index++) {
            const product = (decimal[index] ?? 0) * base + carry;
            decimal[index] = product % 10;
            carry = Math.floor(product / 10);
        }
        while(carry > 0) {
            decimal.push(carry % 10);
            carry = Math.floor(carry / 10);
        }
    }
    if(!consumedDigit || !previousDigit) { return digits; }
    let result = '';
    for(let index = decimal.length - 1; index >= 0; index--) { result += `${decimal[index] ?? 0}`; }
    return negative && result !== '0' ? '-' + result : result;
}
