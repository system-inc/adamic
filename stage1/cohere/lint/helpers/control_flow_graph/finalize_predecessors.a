import { BlockArena } from './arena.a';
import { CfgBlockIndex as BlockIndex } from '../../../arena/arena_index.a';
export function finalizePredecessors(arena: BlockArena): void {for(let i=0;i<arena.length;i++){const empty: BlockIndex[]=[];arena.read(arena.indexAtSlot(i)).Predecessors=empty;}for(let i=0;i<arena.length;i++){const from=arena.indexAtSlot(i);for(const successor of arena.read(from).Successors)if(successor!==undefined)arena.read(successor).Predecessors.push(from);}}
