import { RootOf } from './root_of.a';
import { IsRoot } from './is_root.a';
import { isAlwaysTruthyTest } from './is_always_truthy_test.a';
import { isDestructuringTarget } from './is_destructuring_target.a';
import { isThrowableIdentifier } from './is_throwable_identifier.a';
import { labelsOf } from './labels_of.a';
import { normalizeBigIntLiteral } from './normalize_big_int_literal.a';
import { Current } from './current.a';
import { Index } from './index.a';
import { BlockArena } from './arena.a';
import { Graph } from './builder.a';
import { AnalyzePaths } from './analyze_paths.a';
import { IsCyclic } from './is_cyclic.a';
import { IsOnEveryFinalPath } from './is_on_every_final_path.a';
import { IsExit } from './is_exit.a';
import { HasSingleFinalPath } from './has_single_final_path.a';
import { BlockIndex } from './arena.a';
const emptyBlocks: BlockIndex[]=[];
import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { AstArena, NodeIndex } from './ast.a';
import type { AstNode } from './ast.a';
import { Build } from './build.a';
import { IndexRoots } from './index_roots.a';
import type { Builder, Hooks } from './builder.a';
const input = readTextFile(programArguments()[0] ?? panic('CFG cases path'));
if(input.kind === 'Error') panic(input.message);
const json=new OptionsJson(input.text);const root=json.parse();if(root<0) panic(json.error);
function field(row: number,key: string): number { return json.field(row,key); }
function num(row: number,key: string): number {const f=field(row,key);return f<0?-1:json.node(f).number;}
function text(row: number,key: string): string {const f=field(row,key);return f<0?'':json.node(f).text;}
function flag(row: number,key: string): boolean {return text(row,key)==='true';}
function list(row: number,key: string): readonly number[] {const f=field(row,key);const empty: number[]=[];return f<0?empty:json.node(f).children;}
function items(row: number): readonly number[] {return json.node(row).children;}
function get(row: number,i: number): number {return items(row)[i] ?? panic('missing CFG field');}
function bit(value: boolean): string {return value?'true':'false';}
function numbers(row: number): string {let out='';for(const child of items(row)){if(out!=='')out+=',';out+=`${json.node(child).number}`;}return out;}
class Decoder {
 readonly rows: readonly number[];readonly cache: (AstNode | undefined)[]=[];
 constructor(rows: readonly number[]) {this.rows=rows;for(const row of rows)this.cache.push(undefined);}
 child(row: number,key: string): NodeIndex {const index: NodeIndex=num(row,key);if(index < -1 || index >= this.rows.length || index !== Math.floor(index))panic('bad AST edge');return index;}
 children(row: number,key: string): readonly NodeIndex[] | undefined {const f=field(row,key);if(f<0)return undefined;const result: NodeIndex[]=[];for(const index of items(f)){const value: NodeIndex=json.node(index).number;result.push(value);}return result;}
 read(index: number): AstNode {
 if(index<0||index>=this.rows.length||index!==Math.floor(index))panic('bad AST capture index');
 const found=this.cache[index];if(found!==undefined)return found;
 const row=this.rows[index] ?? panic('AST row');
 const nodeIndex: NodeIndex = index; const parentIndex: NodeIndex = num(row,'Parent');
 const node: AstNode={index:nodeIndex, Parent:parentIndex,Kind:text(row,'Kind'),Text:text(row,'Text'),Operator:text(row,'Operator'),isStatement:flag(row,'isStatement'),optionalChain:flag(row,'optionalChain'),outermostChain:flag(row,'outermostChain'),optionalRoot:flag(row,'optionalRoot'),functionLike:flag(row,'functionLike'),jsxTag:flag(row,'jsxTag'),
 Left: this.child(row,'Left'),
 Right: this.child(row,'Right'),
 Expression: this.child(row,'Expression'),
 Operand: this.child(row,'Operand'),
 Name: this.child(row,'Name'),
 Body: this.child(row,'Body'),
 Type: this.child(row,'Type'),
 Initializer: this.child(row,'Initializer'),
 Condition: this.child(row,'Condition'),
 Incrementor: this.child(row,'Incrementor'),
 Statement: this.child(row,'Statement'),
 ThenStatement: this.child(row,'ThenStatement'),
 ElseStatement: this.child(row,'ElseStatement'),
 TryBlock: this.child(row,'TryBlock'),
 FinallyBlock: this.child(row,'FinallyBlock'),
 CatchClause: this.child(row,'CatchClause'),
 VariableDeclaration: this.child(row,'VariableDeclaration'),
 Block: this.child(row,'Block'),
 Label: this.child(row,'Label'),
 CaseBlock: this.child(row,'CaseBlock'),
 DeclarationList: this.child(row,'DeclarationList'),
 WhenTrue: this.child(row,'WhenTrue'),
 WhenFalse: this.child(row,'WhenFalse'),
 ArgumentExpression: this.child(row,'ArgumentExpression'),
 Tag: this.child(row,'Tag'),
 Template: this.child(row,'Template'),
 Constraint: this.child(row,'Constraint'),
 DefaultType: this.child(row,'DefaultType'),
 PropertyName: this.child(row,'PropertyName'),
 ObjectAssignmentInitializer: this.child(row,'ObjectAssignmentInitializer'),
 DotDotDotToken: this.child(row,'DotDotDotToken'),
 OperatorToken: this.child(row,'OperatorToken'),
 Statements: this.children(row,'Statements'),
 Parameters: this.children(row,'Parameters'),
 Arguments: this.children(row,'Arguments'),
 Declarations: this.children(row,'Declarations'),
 Elements: this.children(row,'Elements'),
 Properties: this.children(row,'Properties'),
 Clauses: this.children(row,'Clauses'),
 Members: this.children(row,'Members'),
 Types: this.children(row,'Types'),
 HeritageClauses: this.children(row,'HeritageClauses'),
 TypeArguments: this.children(row,'TypeArguments'),
 TypeParameters: this.children(row,'TypeParameters'),
 Decorators: this.children(row,'Decorators'),
 children: this.children(row,'children'),
 };this.cache[index]=node;return node;
 }
 arena(): AstArena {const nodes: AstNode[]=[];for(let i=0;i<this.rows.length;i++)nodes.push(this.read(i));return new AstArena(nodes);}
}
class Recorder {
 readonly trace: readonly number[];position=0;
 constructor(trace: readonly number[]) {this.trace=trace;}
 hook(kind: string,b: Builder,node: AstNode | undefined): void {
 const expected=this.trace[this.position];this.position++;
 const emptyIds: number[]=[];const ids=expected===undefined?-1:get(expected,4);
 console.log(`trace:${kind}:${node===undefined?-1:node.index}:${Current(b)}:${bit(b.block(Current(b)).Reachable)}:${ids<0?'':numbers(ids)}`);
 for(const event of ids<0?emptyIds:items(ids)) {const location=b.Emit(json.node(event).number);console.log(`emit:${location.block}:${location.index}`);}
 }
}
function encoded(text: string): string {let out='';for(let i=0;i<text.length;i++){if(i>0)out+=',';out+=`${text.charCodeAt(i)}`;}return out;}
let caseIndex=0;
for(const row of items(root)) {
 console.log(`case:${caseIndex}:${text(row,'op')}`);caseIndex++;
 if(text(row,'op')==='paths') {
 const arena=new BlockArena();const blocks=list(row,'blocks');for(const block of blocks)arena.allocate();
 const finals: BlockIndex[]=[];const thrown: BlockIndex[]=[];
 for(const index of list(row,'finals'))finals.push(json.node(index).number);
 for(const index of list(row,'thrown'))thrown.push(json.node(index).number);
 for(let i=0;i<blocks.length;i++){
 const input=blocks[i] ?? panic('path block');const block=arena.read(i);
 if(json.node(get(input,0)).number!==i)panic('noncanonical Go block index');
 block.Reachable=json.node(get(input,1)).text==='true';
 for(const successor of items(get(input,2)))block.Successors.push(json.node(successor).number);
 const barriers=get(input,3);if(json.node(barriers).kind!=='null'){const values: boolean[]=[];for(const value of items(barriers))values.push(json.node(value).text==='true');block.cycleBarrier=values;}
 }
 const graph=new Graph(arena,finals,thrown,false);const a=AnalyzePaths(graph);
 for(let i=0;i<arena.length;i++){const cyclic=IsCyclic(a,i);const every=IsOnEveryFinalPath(a,i);const exit=IsExit(a,i);const distance=a.shortest[i] ?? panic('shortest');console.log(`path:${bit(cyclic)}:${bit(every)}:${bit(exit)}:${distance}:${bit(distance!==0)}`);}
 console.log(`exit:${a.shortestExit}:${bit(a.hasExit)}:${bit(HasSingleFinalPath(a))}`);
 arena.dispose();continue;
 }
 const decoder=new Decoder(list(row,'nodes'));const ast=decoder.arena();const node=ast.read(num(row,'root'));
 for(const current of ast.nodes){const owner=RootOf(ast,current);console.log(`node:${current.index}:${owner===undefined?-1:owner.index}:${bit(IsRoot(current))}:${bit(isAlwaysTruthyTest(ast,current))}:${bit(isDestructuringTarget(ast,current))}:${bit(isThrowableIdentifier(ast,current))}:${labelsOf(ast,current).map(encoded).join(';')}:${encoded(normalizeBigIntLiteral(current.Text))}`);}
 if(text(row,'op')==='roots') {
 for(const summary of IndexRoots(ast,node))console.log(`root:${summary.Node.index}:${bit(summary.BareReturn)}:${summary.Loops.join(',')}`);
 } else {
 const mask=list(row,'mask');const recorder=new Recorder(list(row,'trace'));
 const hooks: Hooks={Expression:undefined,Read:undefined,Write:undefined,Statement:undefined,Loop:undefined};
 if(json.node(mask[0] ?? panic('mask')).text==='true')hooks.Expression=(b: Builder,n: AstNode | undefined): void=>recorder.hook('Expression',b,n);
 if(json.node(mask[1] ?? panic('mask')).text==='true')hooks.Read=(b: Builder,n: AstNode | undefined): void=>recorder.hook('Read',b,n);
 if(json.node(mask[2] ?? panic('mask')).text==='true')hooks.Write=(b: Builder,n: AstNode | undefined): void=>recorder.hook('Write',b,n);
 if(json.node(mask[3] ?? panic('mask')).text==='true')hooks.Statement=(b: Builder,n: AstNode | undefined): void=>recorder.hook('Statement',b,n);
 if(json.node(mask[4] ?? panic('mask')).text==='true')hooks.Loop=(b: Builder,n: AstNode | undefined): void=>recorder.hook('Loop',b,n);
 const graph=Build(ast,node,hooks);
 console.log(`graph:${bit(graph.EndReachable)}:${graph.FinalBlocks.join(',')}:${graph.ThrownBlocks.join(',')}`);
 for(let i=0;i<graph.arena.length;i++){
 const block=graph.arena.read(i);let barriers='null';if(block.cycleBarrier!==undefined)barriers=block.cycleBarrier.map(bit).join(',');
 console.log(`block:${Index(graph.arena,i)}:${bit(block.Reachable)}:${bit(block.hasIncoming)}:${bit(block.final)}:${bit(block.thrown)}:${block.Successors.join(',')}:${block.Predecessors.join(',')}:${barriers}:${block.Events.length}`);
 }
 console.log(`hooks:${recorder.position}`);
 graph.arena.dispose();
 }
}
