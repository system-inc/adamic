import type { Builder, Graph, Hooks, TryFrame, JumpTarget } from './builder.a';
import { CfgBlockIndex as BlockIndex } from '../../../arena/arena_index.a';
export function throwFrame(b: Builder): number {
    for (let i = ((b.tryStack).length - 1); (i >= 0); i--) {
        let f = at(b.tryStack, i);
        if (((f.position === 'try') || ((f.hasFinally && (f.position === 'catch'))))) {
            return i;
        }
    }
    return -1;
}
