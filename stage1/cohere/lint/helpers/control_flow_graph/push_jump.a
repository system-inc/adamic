import { needNode, needList, at, filled, append } from './support.a';
import type { AstNode } from './ast.a';
import type { Builder, Graph, Hooks, TryFrame, JumpTarget } from './builder.a';
import { CfgBlockIndex as BlockIndex } from '../../../arena/arena_index.a';
import { labelsOf } from './labels_of.a';
export function pushJump(b: Builder, node: AstNode | undefined, breakTo: BlockIndex | undefined, continueTo: BlockIndex | undefined, loop: AstNode | undefined): void {
    b.jumps = append(b.jumps, {broken: false, labels: labelsOf(b.ast, node), breakTo: breakTo, continueTo: continueTo, loop: loop, breakable: true});
}
