import { emptyNodes } from './support.a';
import { Builder, Graph } from './builder.a';
import type { Hooks } from './builder.a';
import type { AstNode } from './ast.a';
import { AstArena } from './ast.a';
export function Build(ast: AstArena, root: AstNode, hooks: Hooks): Graph {
 const b = new Builder(ast, hooks); b.cur = b.newBlock(); b.block(b.cur).hasIncoming=true; b.block(b.cur).Reachable=true;
 switch(root.Kind) {
 case 'SourceFile': b.statements(ast.list(root.Statements)); break;
 case 'ClassStaticBlockDeclaration': b.statement(ast.maybe(root.Body)); break;
 case 'PropertyDeclaration': b.expr(ast.maybe(root.Initializer)); break;
 default: for(const parameter of ast.list(root.Parameters) ?? emptyNodes) b.parameter(parameter); b.expr(ast.maybe(root.Type)); if(root.Body !== -1) { if(ast.read(root.Body).Kind === 'Block') b.statement(ast.maybe(root.Body)); else b.expr(ast.maybe(root.Body)); } break;
 }
 const end=b.block(b.cur).Reachable; if(end) b.markFinal(b.cur);
 return new Graph(b.arena,b.finals,b.thrown,end);
}
