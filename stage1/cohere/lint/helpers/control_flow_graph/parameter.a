import { needNode, needList, at, filled, append } from './support.a';
import type { AstNode } from './ast.a';
import type { Builder, Graph, Hooks, TryFrame, JumpTarget } from './builder.a';
import { BlockIndex } from './arena.a';
export function parameter(b: Builder, node: AstNode | undefined): void {
    let parameter = node;
    if ((parameter === undefined)) {
        return;
    }
    b.expr(b.ast.maybe(needNode(parameter).Type));
