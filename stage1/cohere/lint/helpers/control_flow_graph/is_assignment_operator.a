export function IsAssignmentOperator(kind: string): boolean { return kind === 'EqualsToken' || kind === 'PlusEqualsToken' || kind === 'MinusEqualsToken' || kind === 'AsteriskEqualsToken' || kind === 'AsteriskAsteriskEqualsToken' || kind === 'SlashEqualsToken' || kind === 'PercentEqualsToken' || kind === 'LessThanLessThanEqualsToken' || kind === 'GreaterThanGreaterThanEqualsToken' || kind === 'GreaterThanGreaterThanGreaterThanEqualsToken' || kind === 'AmpersandEqualsToken' || kind === 'BarEqualsToken' || kind === 'CaretEqualsToken' || kind === 'AmpersandAmpersandEqualsToken' || kind === 'BarBarEqualsToken' || kind === 'QuestionQuestionEqualsToken'; }
