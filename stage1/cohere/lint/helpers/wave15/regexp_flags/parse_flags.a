import { printableRanges } from './printable_ranges.a';

export class RegexpFlags {
    ignoreCase = false;
    multiline = false;
    dotAll = false;
    unicode = false;
    sticky = false;
    error = '';
}

function printable(code: number): boolean {
    let low = 0;
    let high = printableRanges.length / 2;
    while(low < high) {
        const middle = Math.floor((low + high) / 2);
        const start = printableRanges[middle * 2] ?? -1;
        const end = printableRanges[middle * 2 + 1] ?? -1;
        if(code < start) { high = middle; }
        else if(code > end) { low = middle + 1; }
        else { return true; }
    }
    return false;
}

function quoted(code: number, text: string): string {
    if(code === 39 || code === 92) { return "'\\" + text + "'"; }
    if(code === 7) { return "'\\a'"; }
    if(code === 8) { return "'\\b'"; }
    if(code === 9) { return "'\\t'"; }
    if(code === 10) { return "'\\n'"; }
    if(code === 11) { return "'\\v'"; }
    if(code === 12) { return "'\\f'"; }
    if(code === 13) { return "'\\r'"; }
    if(printable(code)) { return "'" + text + "'"; }
    const byteEscape = code < 32 || code === 127;
    const width = byteEscape ? 2 : code < 65536 ? 4 : 8;
    const prefix = byteEscape ? '\\x' : code < 65536 ? '\\u' : '\\U';
    return "'" + prefix + code.toString(16).padStart(width, '0') + "'";
}

// Mirrors Go's partial flagSet on failure. Global and indices flags are ignored.
// Lone UTF-16 surrogates cross the Go string boundary as replacement runes.
export function parseFlags(flags: string): RegexpFlags {
    const result = new RegexpFlags();
    let seen = 0;
    for(let position = 0; position < flags.length; position++) {
        let code = flags.charCodeAt(position);
        let text = flags.slice(position, position + 1);
        if(code >= 55296 && code <= 56319) {
            const next = flags.charCodeAt(position + 1);
            if(next >= 56320 && next <= 57343) {
                code = 65536 + (code - 55296) * 1024 + next - 56320;
                text = flags.slice(position, position + 2);
                position++;
            } else { code = 65533; text = '\ufffd'; }
        } else if(code >= 56320 && code <= 57343) { code = 65533; text = '\ufffd'; }
        const bit = code === 105 ? 1 : code === 109 ? 2 : code === 115 ? 4 : code === 117 ? 8 : code === 121 ? 16 : code === 103 ? 32 : code === 100 ? 64 : 0;
        if(bit === 0) {
            result.error = 'unsupported regexp flag: ' + quoted(code, text);
            return result;
        }
        if((seen & bit) !== 0) {
            result.error = 'unsupported regexp flag: ' + quoted(code, text) + ' given twice';
            return result;
        }
        seen |= bit;
        if(code === 105) { result.ignoreCase = true; }
        else if(code === 109) { result.multiline = true; }
        else if(code === 115) { result.dotAll = true; }
        else if(code === 117) { result.unicode = true; }
        else if(code === 121) { result.sticky = true; }
    }
    return result;
}
