import { readTextFile, programArguments, panic } from 'adamic';
import { parseCssDeclaration } from './parse_css_declaration.a';
function bytes(text: string): number[] {
    const result: number[] = [];
    for(let position = 0; position < text.length; position += 2) { result.push(parseInt(text.slice(position, position + 2), 16)); }
    return result;
}
function hex(values: readonly number[]): string {
    let result = '';
    for(const value of values) { result += value.toString(16).padStart(2, '0'); }
    return result;
}
const input = readTextFile(programArguments()[0] ?? panic('missing cases'));
if(input.kind === 'Error') { panic(input.message); }
for(const line of input.text.split('\n')) {
    if(line === '') { continue; }
    const fields = line.split('\t');
    const result = parseCssDeclaration(bytes(fields[0] ?? ''), parseInt(fields[1] ?? '', 10));
    console.log(`${result.present}\t${result.kind}\t${result.valuePresent}\t${result.important}\t${hex(result.property)}.\t${hex(result.value)}.`);
}
