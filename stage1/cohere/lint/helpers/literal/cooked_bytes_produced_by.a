import { utf8At, utf8Length } from 'adamic';
// cohere/internal/lint/ecmascript/literal/offsets.go:161. Widths and comparison use UTF-8 bytes.
export function cookedBytesProducedBy(rawToken: string, remainingCooked: string): number {
    if(rawToken === '' || remainingCooked === '') { return 0; }
    const first = utf8At(remainingCooked, 0);
    let width = 1;
    if(first >= 240) { width = 4; }
    else if(first >= 224) { width = 3; }
    else if(first >= 192) { width = 2; }
    if(rawToken.charAt(0) !== '\\') {
        if(width > utf8Length(rawToken)) { return 0; }
        for(let index = 0; index < width; index++) {
            if(utf8At(rawToken, index) !== utf8At(remainingCooked, index)) { return 0; }
        }
    }
    return width;
}
