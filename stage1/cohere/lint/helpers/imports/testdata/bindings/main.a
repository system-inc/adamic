import { bindingsOf } from '../../bindings_of.a';
import type { HelperNode } from '../../nodes.a';
import { panic, readTextFile, programArguments } from 'adamic';
import { OptionsJson } from '../../../options_json.ts';
const input = readTextFile(programArguments()[0] ?? panic('missing cases'));
if(input.kind === 'Error') { panic(input.message); }
const json = new OptionsJson(input.text); const root = json.parse();
if(root < 0) { panic(json.error); }
function text(index: number, field: string): string { return json.node(json.field(index, field)).text; }
function number(index: number, field: string): number { return Number(text(index, field)); }
function indices(index: number, field: string): number[] { return json.node(json.field(index, field)).children.map(v => Number(json.node(v).text)); }
for(const file of json.node(root).children) {
    const nodes: HelperNode[] = [];
    const baseNames = json.node(json.field(file, 'baseNames')).children.map(child => json.node(child).text);
    for(const index of json.node(json.field(file, 'nodes')).children) {
        nodes.push({kind: text(index, 'kind'), text: text(index, 'text'), expression: number(index, 'expression'), name: number(index, 'name'), importClause: number(index, 'importClause'), namedBindings: number(index, 'namedBindings'), propertyName: -1, elements: json.node(json.field(index, 'elements')).children.map(child => json.node(child).number)});
    }
    for(const query of json.node(json.field(file, 'queries')).children) {
        const result = bindingsOf(nodes, number(query, 'node'));
        console.log(`${result.default}:${result.namespace}:${result.named.join(',')}`);
    }
}
