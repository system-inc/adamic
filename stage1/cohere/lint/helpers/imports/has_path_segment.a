export function hasPathSegment(path: readonly number[], segment: readonly number[]): boolean {
 if (segment.length === 0) { return false; }
 let start = 0;
 for (let index = 0; index <= path.length; index++) {
  const byte = path[index];
  if (index === path.length || byte === 47 || byte === 92) {
   if (index - start === segment.length) {
    let equal = true;
    for (let offset = 0; offset < segment.length; offset++) { if (path[start + offset] !== segment[offset]) { equal = false; break; } }
    if (equal) { return true; }
   }
   start = index + 1;
  }
 }
 return false;
}
