import type {RuleContext} from '../../context.ts';
export function sortDefaultPropsInitializerOf(context:RuleContext,index:number):number {if(index<0 || !['VariableDeclaration','PropertyAssignment','PropertyDeclaration'].includes(context.kind(index))){return -1;}const children=context.node(index).children;const name=context.name(index);const last=children[children.length-1] ?? -1;if(last<0 || last===name || context.kind(last)==='QuestionToken' || context.kind(last)==='ExclamationToken'){return -1;} if(context.kind(index)==='PropertyAssignment'){return last;}let pos=context.node(last).pos;while(pos>0 && ' \t\r\n'.includes(context.source[pos-1] ?? '')){pos--;}return context.source[pos-1]==='=' ? last : -1;}
