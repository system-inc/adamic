import type {RuleContext} from '../../context.ts';
import {skipParenthesesOptional} from './skip_parentheses_optional.a';
export function isCreateReactClassCall(context:RuleContext,index:number):boolean {
 if(context.kind(index)!=='CallExpression'){return false;}
 const callee=skipParenthesesOptional(context,context.node(index).children[0] ?? -1);if(callee<0){return false;}
 if(context.kind(callee)==='Identifier'){return context.node(callee).text==='createReactClass';}
 if(context.kind(callee)!=='PropertyAccessExpression'){return false;}
 const object=skipParenthesesOptional(context,context.node(callee).children[0] ?? -1);if(object<0 || context.kind(object)!=='Identifier' || context.node(object).text!=='React'){return false;}
 const name=context.property(callee);return name>=0 && context.node(name).text==='createReactClass';
}
