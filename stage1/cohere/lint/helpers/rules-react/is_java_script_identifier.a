export function isJavaScriptIdentifier(name: string): boolean {
    if (name.length === 0) { return false; }
    for (let i = 0; i < name.length; i++) {
        const c = name.charCodeAt(i);
        if (c === 95 || c === 36 || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (i > 0 && c >= 48 && c <= 57)) { continue; }
        return false;
    }
    return true;
}
