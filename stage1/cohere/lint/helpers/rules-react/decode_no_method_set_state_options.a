import {printable} from '../../unicode.ts';
import {OptionsJson} from '../options_json.ts';
export interface NoMethodSetStateOptions {readonly disallowInFunc:boolean;readonly error:string;}
export function decodeNoMethodSetStateOptions(raw:string):NoMethodSetStateOptions {
 if(raw.length===0){return {disallowInFunc:false,error:''};}
 const reader=new OptionsJson(raw);const root=reader.parse();
 if(root<0 || (reader.node(root).kind!=='string' && reader.node(root).kind!=='null')){return {disallowInFunc:false,error:`expected the mode string "disallow-in-func", got ${raw}`};}
 const mode=reader.node(root).kind==='null' ? '' : reader.node(root).text;
 if(mode!=='disallow-in-func'){return {disallowInFunc:false,error:`mode ${quote(mode)} is not "disallow-in-func", the only value upstream accepts`};}
 return {disallowInFunc:true,error:''};
}
function quote(s:string):string {
 let out='"';for(let i=0;i<s.length;i++){
  const c=s.codePointAt(i) ?? 0;const char=String.fromCodePoint(c);if(c>65535){i++;}
  if(c===34 || c===92){out+='\\'+char;}
  else if(c===7){out+='\\a';}else if(c===8){out+='\\b';}else if(c===9){out+='\\t';}else if(c===10){out+='\\n';}else if(c===11){out+='\\v';}else if(c===12){out+='\\f';}else if(c===13){out+='\\r';}
  else if(c<32 || c===127){out+='\\x'+c.toString(16).padStart(2,'0');}
  else if(!printable(c)){out+=c<65536 ? '\\u'+c.toString(16).padStart(4,'0') : '\\U'+c.toString(16).padStart(8,'0');}
  else{out+=char;}
 }return out+'"';
}
