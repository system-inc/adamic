import { panic, programArguments, readTextFile } from 'adamic';
import { ForkFrame, snapshotForks } from './snapshot_forks.a';
function bits(values: readonly boolean[]): string {
    let result = '';
    for (const value of values) result += value ? '1' : '0';
    return result;
}
function frameBits(frames: readonly ForkFrame[]): string {
    let result = '';
    for (const frame of frames) result += frame.thrownForked ? '1' : '0';
    return result;
}
const args = programArguments();
const file = readTextFile(args[0] ?? panic('missing alias trace'));
if (file.kind === 'Error') panic(file.message);
for (const row of file.text.split('\n')) {
    if (row.length === 0) continue;
    const seed = row.split('|')[0] ?? panic('missing seed');
    const frames: ForkFrame[] = [];
    for (let index = 0; index < seed.length; index++) frames.push(new ForkFrame(seed.charAt(index) === '1'));
    const first = snapshotForks(frames);
    const second = snapshotForks(frames);
    if (frames.length > 0) {
        const frame = frames[0] ?? panic('missing first frame');
        frame.thrownForked = !frame.thrownForked;
        const value = first[0] ?? panic('missing first snapshot bit');
        first[0] = !value;
    } else {
        first.push(true);
    }
    console.log(seed + '|' + bits(first) + '|' + bits(second) + '|' + frameBits(frames) + '|' + String(first.length) + '|' + String(second.length));
}
