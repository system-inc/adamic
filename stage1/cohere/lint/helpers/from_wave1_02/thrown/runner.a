import { panic, programArguments, readTextFile } from 'adamic';
import { markThrown, ThrownBlock, ThrownBuilder } from './mark_thrown.a';
function ids(blocks: number[]): string {
    let result = '';
    for (const block of blocks) {
        if (result.length > 0) result += ':';
        result += String(block);
    }
    return result;
}
const args = programArguments();
if (args.length !== 1) panic('expected trace file');
const file = readTextFile((args[0] ?? panic('missing trace argument')));
if (file.kind === 'Error') panic(file.message);
for (const row of file.text.split('\n')) {
    if (row.length === 0) continue;
    const parts = row.split(',');
    if (parts.length !== 13) panic('invalid Go trace row');
    const index = Number((parts[0] ?? panic('missing trace field')));
    const blocks: ThrownBlock[] = [];
    for (let i = 0; i <= index; i++) blocks.push(new ThrownBlock(false, false, false));
    if (index >= 0) {
        const target = blocks[index] ?? panic('missing target');
        target.reachable = parts[1] === 'true';
        target.thrown = parts[2] === 'true';
        target.final = parts[9] === 'true';
    }
    const thrown: number[] = [];
    const previousIds = parts[3] ?? panic('missing trace field');
    if (previousIds.length > 0) {
        for (const id of previousIds.split(':')) thrown.push(Number(id));
    }
    const finals: number[] = [];
    const finalIds = parts[11] ?? panic('missing final ids');
    if (finalIds.length > 0) for (const id of finalIds.split(':')) finals.push(Number(id));
    const builder = new ThrownBuilder(blocks, thrown, finals);
    markThrown(builder, index);
    const markedThrown = index >= 0 && (blocks[index] ?? panic('missing target')).thrown;
    const sameLast = index >= 0 && builder.thrown.length > 0 && builder.thrown[builder.thrown.length - 1] === index;
    console.log((parts[0] ?? panic('missing trace field')) + ',' + (parts[1] ?? panic('missing trace field')) + ',' + (parts[2] ?? panic('missing trace field')) + ',' + previousIds + ',' + String(markedThrown) + ',' + ids(builder.thrown) + ',' + String(sameLast) + ',' + (parts[7] ?? panic('missing trace field')) + ',' + (parts[7] ?? panic('missing trace field')) + ',' + (parts[9] ?? panic('missing final flag')) + ',' + String(index >= 0 && (blocks[index] ?? panic('missing target')).final) + ',' + finalIds + ',' + ids(builder.finals));
}
