import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { HasVariant } from './has_variant.a';
import { VariantKind } from './variant_kind.a';
import { VariantCompoundsWith } from './variant_compounds_with.a';
function observe(root: readonly number[], entries: readonly (readonly number[])[], kinds: readonly string[]): void {
    const variants = new Map<string,string>();
    for(let i = 0; i < entries.length; i++) { variants.set((entries[i] ?? panic('entry')).join(','),kinds[i] ?? panic('kind')); }
    const system = {variants};
    const name = root.join(',');
    console.log(`has ${HasVariant(system,name)}`);
    console.log(`kind ${VariantKind(system,name)}`);
    for(const kind of ['', 'arbitrary', 'static', 'functional', 'compound', 'foreign']) {
        console.log(`compound ${kind} ${VariantCompoundsWith(system,name,{kind,root:[255]})}`);
    }
    variants.delete(name);
    console.log(`deleted ${HasVariant(system,name)}|${VariantKind(system,name)}|${VariantCompoundsWith(system,name,{kind:'compound',root:[]})}`);
    variants.set(name,'');
    console.log(`empty ${HasVariant(system,name)}|${VariantKind(system,name)}|${VariantCompoundsWith(system,name,{kind:'arbitrary',root:[]})}`);
    variants.set(name,'compound');
    console.log(`added ${HasVariant(system,name)}|${VariantKind(system,name)}|${VariantCompoundsWith(system,name,{kind:'arbitrary',root:[]})}`);
    variants.set(name,'functional');
    console.log(`changed ${VariantCompoundsWith(system,name,{kind:'compound',root:[]})}`);
}
function raw(input: readonly number[]): void { observe(input,[input],['static']); }
function bytes(corpus: OptionsJson, index: number): number[] {
    const result: number[] = [];
    for(const value of corpus.node(index).children) { result.push(Number(corpus.node(value).text)); }
    return result;
}
function field(corpus: OptionsJson, row: number, name: string): number {
    const value = corpus.node(row);
    const index = value.keys.indexOf(name);
    if(index < 0) { panic('missing field'); }
    return value.children[index] ?? panic('field');
}
const argument = programArguments()[0] ?? panic('path');
if(argument === '--full') {
    raw([]);
    for(let first = 0; first <= 255; first++) {
        raw([first]);
        for(let last = 0; last <= 255; last++) { raw([first,last]); }
    }
} else {
    const input = readTextFile(argument);
    if(input.kind === 'Error') { panic(input.message); }
    const corpus = new OptionsJson(input.text);
    const root = corpus.parse();
    if(root < 0) { panic(corpus.error); }
    for(const row of corpus.node(root).children) {
        const entries: number[][] = [];
        const kinds: string[] = [];
        for(const entry of corpus.node(field(corpus,row,'Entries')).children) {
            entries.push(bytes(corpus,field(corpus,entry,'Key')));
            kinds.push(corpus.node(field(corpus,entry,'Kind')).text);
        }
        observe(bytes(corpus,field(corpus,row,'Root')),entries,kinds);
    }
}
