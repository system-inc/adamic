import { panic } from 'adamic';
export interface ReadClass<Body> { readonly body: Body; readonly negated: boolean; readonly width: number; readonly error: string; }
export function readClass<Body>(source: readonly number[],decodeSize: (index: number) => number,slice: (start: number,end: number) => Body): ReadClass<Body> {
 let index=1;let negated=false;
 if(index<source.length && source[index] === 94) {negated=true;index++;}
 const start=index;
 while(index<source.length) {
  const byte=source[index] ?? panic('missing class byte');
  if(byte === 92) {index+=1+decodeSize(index+1);}
  else if(byte === 93) {return {body:slice(start,index),negated,width:index+1,error:''};}
  else {index+=decodeSize(index);}
 }
 return {body:slice(0,0),negated:false,width:0,error:'unsupported regexp syntax: [ that no ] closes'};
}
