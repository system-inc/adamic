import { panic, readTextFile, programArguments } from 'adamic';
import { OptionsJson } from '../../options_json.ts';
import { parseRegexFlags } from './parse_regex_flags.a';
import { regexFlagsUV } from './regex_flags_uv.a';
import { patternAndFlags } from './pattern_and_flags.a';
const input = readTextFile(programArguments()[0] ?? panic('missing corpus'));
if (input.kind === 'Error') { panic(input.message); }
const json = new OptionsJson(input.text); const root = json.parse();
if (root < 0) { panic(json.error); }
function text(index: number, name: string): string { return json.node(json.field(index, name)).text; }
function hex(bytes: readonly number[]): string {
    let out = ''; for (const byte of bytes) { out += byte.toString(16).padStart(2, '0'); } return out;
}
const mode = text(root, 'mode');
for (const row of json.node(json.field(root, 'rows')).children) {
    const bytes: number[] = []; for (const value of json.node(json.field(row, 'bytes')).children) { bytes.push(Number(json.node(value).text)); }
    if (mode === 'pattern') {
        const result = patternAndFlags(bytes); console.log(hex(result.pattern) + '|' + hex(result.flags));
    } else if (mode === 'flags') {
        const flags = parseRegexFlags(bytes); console.log(`${flags.unicode}|${flags.unicodeSets}`);
    } else {
        console.log(`${regexFlagsUV({unicode: text(row, 'unicode') === 'true', unicodeSets: text(row, 'unicodeSets') === 'true'})}`);
    }
}
