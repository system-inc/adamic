import { panic } from 'adamic';
import type { JsxNode } from './model.a';
import { isJsxValue } from './is_jsx_value.a';
export function jsxAfterParentheses(nodes: readonly JsxNode[], index: number): boolean {
    if (index < 0) { return false; }
    let expression = index;
    while ((nodes[expression] ?? panic('missing AST node')).parenthesized) { expression = (nodes[expression] ?? panic('missing AST node')).expression; }
    return isJsxValue(nodes, expression);
}
