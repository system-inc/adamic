import { panic } from 'adamic';
import type { SurfaceNode, ClassValues } from './types.a';

// The matching dependency is the current reader variables.matches predicate.
// under receives the initializer with Variable origin and false outer edges.
export function variableValues(nodes: readonly SurfaceNode[], index: number, matches: (name: string) => boolean, under: (index: number) => ClassValues): ClassValues {
    const node = nodes[index];
    if(node === undefined || node.kind !== 'VariableDeclaration') { panic('variableValues requires VariableDeclaration'); }
    if(node.initializer < 0) { return {literals: [], templates: []}; }
    const name = nodes[node.name];
    if(name === undefined || name.kind !== 'Identifier') { return {literals: [], templates: []}; }
    if(!matches(name.text)) { return {literals: [], templates: []}; }
    return under(node.initializer);
}
