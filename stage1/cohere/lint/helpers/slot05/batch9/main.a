import { panic, readTextFile, programArguments } from 'adamic';
import { OptionsJson } from '../../options_json.ts';
import { importedNameOf } from './imported_name_of.a';
import type { HelperNode } from './nodes.a';
const input = readTextFile(programArguments()[0] ?? panic('missing corpus'));
if(input.kind === 'Error') { panic(input.message); }
const json = new OptionsJson(input.text); const root = json.parse();
if(root < 0) { panic(json.error); }
function text(index: number, field: string): string { return json.node(json.field(index, field)).text; }
function number(index: number, field: string): number { return Number(text(index, field)); }
for(const row of json.node(root).children) {
    const nodes: HelperNode[] = json.node(json.field(row, 'nodes')).children.map(n => ({kind: text(n, 'kind'), text: text(n, 'text'), expression: number(n, 'expression'), name: number(n, 'name'), propertyName: number(n, 'propertyName'), keywordToken: text(n, 'keywordToken'), argumentsPresent: text(n, 'argumentsPresent') === 'true', arguments: json.node(json.field(n, 'arguments')).children.map(a => Number(json.node(a).text)), propertiesPresent: text(n, 'propertiesPresent') === 'true', properties: json.node(json.field(n, 'properties')).children.map(a => Number(json.node(a).text))}));
    for(const query of json.node(json.field(row, 'queries')).children) {
        const mode = text(query, 'mode'); const index = number(query, 'node');
        if(mode !== 'imported') { panic('unsupported query'); }
        console.log(importedNameOf(nodes, index));
    }
}
