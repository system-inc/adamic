    "Identical": false,
    "OldText": "func (r *ClassLiteralReader) calleeValues(node *ast.Node) classValues {\n\tcall := node.AsCallExpression()\n\tif call == nil || call.Expression == nil {\n\t\treturn classValues{}\n\t}\n\n\tif call.Expression.Kind != ast.KindIdentifier {\n\t\treturn classValues{}\n\t}\n\tif !r.calleeNames[call.Expression.Text()] || call.Arguments == nil {\n\t\treturn classValues{}\n\t}\n\n\tvalues := classValues{}\n\tfor _, argument := range call.Arguments.Nodes {\n\t\tcollectClassValues(argument, ClassLiteralOriginCallee, classValueEdges{}, \u0026values)\n\t}\n\treturn values\n}",
    "NewText": "func (r *ClassLiteralReader) calleeValues(node *ast.Node) classValues {\n\tcall := node.AsCallExpression()\n\tif call == nil || call.Expression == nil {\n\t\treturn classValues{}\n\t}\n\n\tif call.Arguments == nil {\n\t\treturn classValues{}\n\t}\n\tif !r.readsCallee(call.Expression) {\n\t\treturn classValues{}\n\t}\n\n\tvalues := classValues{}\n\tfor _, argument := range call.Arguments.Nodes {\n\t\tcollectClassValues(argument, ClassLiteralOriginCallee, classValueEdges{}, \u0026values)\n\t}\n\treturn values\n}"
  },
  {
    "Symbol": "github.com/system-inc/cohere/internal/lint/rules/tailwind.*ClassLiteralReader.variableValues",
