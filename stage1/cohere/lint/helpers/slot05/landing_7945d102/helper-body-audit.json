    "Identical": false,
    "OldText": "func (r *ClassLiteralReader) variableValues(node *ast.Node) classValues {\n\tdeclaration := node.AsVariableDeclaration()\n\tif declaration == nil || declaration.Initializer == nil {\n\t\treturn classValues{}\n\t}\n\n\tname := declaration.Name()\n\tif name == nil || name.Kind != ast.KindIdentifier {\n\t\treturn classValues{}\n\t}\n\n\tmatches := false\n\tfor _, pattern := range r.variablePatterns {\n\t\tif pattern.MatchString(name.Text()) {\n\t\t\tmatches = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !matches {\n\t\treturn classValues{}\n\t}\n\n\treturn classValuesUnder(declaration.Initializer, ClassLiteralOriginVariable)\n}",
    "NewText": "func (r *ClassLiteralReader) variableValues(node *ast.Node) classValues {\n\tdeclaration := node.AsVariableDeclaration()\n\tif declaration == nil || declaration.Initializer == nil {\n\t\treturn classValues{}\n\t}\n\n\tname := declaration.Name()\n\tif name == nil || name.Kind != ast.KindIdentifier {\n\t\treturn classValues{}\n\t}\n\n\tif !r.variables.matches(name.Text()) {\n\t\treturn classValues{}\n\t}\n\n\treturn classValuesUnder(declaration.Initializer, ClassLiteralOriginVariable)\n}"
