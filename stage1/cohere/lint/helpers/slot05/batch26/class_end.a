import { skipPatternEscape } from './skip_pattern_escape.a';
import type { ScanResult } from './skip_pattern_escape.a';
import type { RegexFlags } from '../batch25/flags.a';
export function classEnd(bytes: readonly number[], start: number, flags: RegexFlags, decodeWidth: (index: number) => number): ScanResult {
    if (start >= bytes.length || bytes[start] !== 91) { return { value: start, ok: false }; }
    let index = start + 1;
    if (index < bytes.length && bytes[index] === 94) { index++; }
    let depth = 1;
    while (index < bytes.length) {
        const byte = bytes[index];
        if (byte === 92) {
            const step = skipPatternEscape(bytes, index, flags, decodeWidth);
            if (!step.ok) { return { value: start, ok: false }; }
            index += step.value;
        } else if (byte === 91 && flags.unicodeSets) {
            depth++; index++;
        } else if (byte === 93) {
            depth--; index++;
            if (depth === 0) { return { value: index, ok: true }; }
        } else {
            const width = decodeWidth(index);
            if (width === 0) { index++; } else { index += width; }
        }
    }
    return { value: start, ok: false };
}
