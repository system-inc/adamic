import { panic, readTextFile, programArguments } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import type { HelperNode } from './nodes.a';
import { isIdentifierNamed } from './react_identifier_named.a';
import { bindingsOf } from './import_bindings.a';
import { isComponentBase } from './react_component_base.a';

const input = readTextFile(programArguments()[0] ?? panic('missing cases path'));
if(input.kind === 'Error') { panic(input.message); }
const json = new OptionsJson(input.text);
const root = json.parse();
if(root < 0) { panic(json.error); }
function text(index: number, field: string): string {
    return json.node(json.field(index, field)).text;
}
function number(index: number, field: string): number {
    return json.node(json.field(index, field)).number;
}
for(const file of json.node(root).children) {
    const nodes: HelperNode[] = [];
    const baseNames = json.node(json.field(file, 'baseNames')).children.map(child => json.node(child).text);
    for(const index of json.node(json.field(file, 'nodes')).children) {
        nodes.push({kind: text(index, 'kind'), text: text(index, 'text'), expression: number(index, 'expression'), name: number(index, 'name'), importClause: number(index, 'importClause'), namedBindings: number(index, 'namedBindings'), elements: json.node(json.field(index, 'elements')).children.map(child => json.node(child).number)});
    }
    for(const query of json.node(json.field(file, 'queries')).children) {
        if(text(query, 'helper') === 'component') {
            console.log(`${isComponentBase(nodes, number(query, 'node'), name => baseNames.includes(name))}`);
        } else if(text(query, 'helper') === 'imports') {
            const result = bindingsOf(nodes, number(query, 'node'));
            console.log(`${result.default}:${result.namespace}:${result.named.join(',')}`);
        } else {
            console.log(`${isIdentifierNamed(nodes, number(query, 'node'), text(query, 'wanted'))}`);
        }
    }
}
