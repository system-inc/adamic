import { panic } from 'adamic';
import type { JumpBlock, JumpState } from './types.a';
export function makeBreak<N,B extends JumpBlock>(state: JumpState<N,B>,label: N | undefined,textOf: (node: N) => string,link: (from: B,to: B | undefined) => void,makeUnreachable: () => void): void {
 if(!state.cur.reachable) {return;}
 let name='';
 if(label !== undefined) {name=textOf(label);}
 for(let i=state.jumps.length - 1;i>=0;i-=1) {
  const target=state.jumps[i] ?? panic('missing jump target');
  if(name === '') {if(!target.breakable) {continue;}}
  else if(!target.labels.includes(name)) {continue;}
  target.broken=true;
  link(state.cur,target.breakTo);
  break;
 }
 makeUnreachable();
}
