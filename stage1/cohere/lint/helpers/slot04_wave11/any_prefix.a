export function hasAnyPrefix(value: readonly number[], prefixes: readonly (readonly number[])[]): boolean {
    for(const prefix of prefixes) {
        if(prefix.length > value.length) { continue; }
        let matches = true;
        for(let index = 0; index < prefix.length; index++) {
            if(value[index] !== prefix[index]) { matches = false; break; }
        }
        if(matches) { return true; }
    }
    return false;
}
