export interface OrderView { nil: boolean; values: number[]; }
export interface Reading { Order: OrderView; Count: number; }
export interface StaticReadingResult { reading: Reading; found: boolean; }

// Declaration conversion and sorting are separately owned helpers.
export function frameworkStaticReading<Declarations extends object, Nodes>(
  name: string,
  table: ReadonlyMap<string, Declarations>,
  nodesFromDeclarations: (declarations: Declarations) => Nodes,
  propertySort: (nodes: Nodes) => Reading,
): StaticReadingResult {
  if (!table.has(name)) { return { reading: { Order: { nil: true, values: [] }, Count: 0 }, found: false }; }
  const declarations = table.get(name);
  if (declarations === undefined) { return { reading: { Order: { nil: true, values: [] }, Count: 0 }, found: false }; }
  const sorted = propertySort(nodesFromDeclarations(declarations));
  return { reading: { Order: sorted.Order, Count: sorted.Count }, found: true };
}
