import { readTextFile, programArguments, panic } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { frameworkStaticReading, type Reading } from './framework_static_reading.a';
const args = programArguments();
const input = readTextFile(args[0] ?? '');
if (input.kind !== 'Ok') { panic(input.message); }
const json = new OptionsJson(input.text);
const root = json.parse();
if (root < 0) { panic(json.error); }
interface DeclarationIdentity { id: number; }
const table = new Map<string, DeclarationIdentity>();
const sortResults = new Map<number, Reading>();
for (const index of json.node(json.field(root, 'Definitions')).children) {
  const name = json.node(json.field(index, 'Name')).text;
  const id = json.node(json.field(index, 'Id')).number;
  const order: number[] = [];
  for (const value of json.node(json.field(index, 'Order')).children) { order.push(json.node(value).number); }
  table.set(name, { id });
  sortResults.set(id, { Order: { nil: json.node(json.field(index, 'OrderNil')).text === 'true', values: order }, Count: json.node(json.field(index, 'Count')).number });
}
for (const index of json.node(json.field(root, 'Cases')).children) {
  const name = json.node(index).text;
  const result = frameworkStaticReading(name, table, (declarations: DeclarationIdentity): number => declarations.id, (nodes: number): Reading => sortResults.get(nodes) ?? panic('missing real Go sort result'));
  const prefix = `${result.found} ${result.reading.Order.nil} ${result.reading.Count} ${result.reading.Order.values.join(',')}`;
  let sharedOrder = true;
  let independentRecord = true;
  const identity = table.get(name);
  if (identity !== undefined) {
    const original = sortResults.get(identity.id) ?? panic('missing sort result');
    const previousCount = original.Count;
    result.reading.Count += 100;
    independentRecord = original.Count === previousCount;
    original.Count = previousCount;
    if (result.reading.Order.values.length > 0) {
      const previous = original.Order.values[0] ?? 0;
      result.reading.Order.values[0] = previous + 100;
      sharedOrder = original.Order.values[0] === previous + 100;
      original.Order.values[0] = previous;
    }
  }
  console.log(`${prefix} ${sharedOrder} ${independentRecord}`);
}
