import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { modFloat } from './mod_float.a';
import { formatJavaScriptNumber } from './format_number.a';
import { isMultipleOf } from './multiple_of.a';
import type { FloatParse } from './multiple_of.a';
function field(c: OptionsJson, row: number, name: string): number {const n=c.node(row);const i=n.keys.indexOf(name);if(i<0){panic('field');}return n.children[i] ?? panic('value');}
function text(c: OptionsJson,row: number,name: string): string {return c.node(field(c,row,name)).text;}
const path=programArguments()[0] ?? panic('path');const input=readTextFile(path);if(input.kind==='Error'){panic(input.message);}
const c=new OptionsJson(input.text);const root=c.parse();if(root<0){panic(c.error);}
for(const row of c.node(root).children){
    const value=Number(text(c,row,'Number'));const divisor=Number(text(c,row,'Divisor'));
    const result: FloatParse={ok:text(c,row,'ParseOK')==='true',value:Number(text(c,row,'Parsed'))};
    console.log(formatJavaScriptNumber(value));console.log(formatJavaScriptNumber(modFloat(value,divisor)));
    console.log(`${isMultipleOf(text(c,row,'Source'),divisor,(_source: string): FloatParse => result)}`);
}
