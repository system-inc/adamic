import { panic, programArguments, readTextFile } from 'adamic';
import { Block, State, enter } from './enter.a';
const args = programArguments();
const input = readTextFile(args[0] ?? panic('missing input'));
if(input.kind === 'Error') { panic(input.message); }
for(const line of input.text.split('\n')) {
    if(line === '') { continue; }
    const fields = line.split('\t');
    const node = new Block(Number(fields[0]), fields[1] === '1', fields[2] === '1');
    const state = new State();
    const previous = Number(fields[3]);
    if(previous >= 0) { state.current = previous === node.index ? node : new Block(previous, false, false); }
    enter(node, state);
    console.log(`${node.incoming ? 1 : 0}\t${node.reachable ? 1 : 0}\t${state.current?.index ?? -1}\t${state.current === node ? 1 : 0}`);
}
