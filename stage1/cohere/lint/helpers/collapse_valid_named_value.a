export function collapseIsValidNamedValue(value: string): boolean {
    if (value === '') { return false; }
    for (let index = 0; index < value.length; index++) {
        const character = value.charCodeAt(index);
        if ((character >= 97 && character <= 122) || (character >= 65 && character <= 90) || (character >= 48 && character <= 57) || character === 95 || character === 46 || character === 37 || character === 45) { continue; }
        return false;
    }
    return true;
}
