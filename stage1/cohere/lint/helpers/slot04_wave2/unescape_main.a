import { panic, programArguments, readTextFile, utf8At, utf8Length } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { unescapeStringLiteralText, type EntityResult } from './unescape_string_literal_text.a';
function field(c: OptionsJson, row: number, name: string): string { return c.node(c.field(row, name)).text; }
const input = readTextFile(programArguments()[0] ?? panic('path'));
if(input.kind === 'Error') { panic(input.message); }
const c = new OptionsJson(input.text);
const root = c.parse();
if(root < 0) { panic(c.error); }
for(const row of c.node(root).children) {
    const results = new Map<string, EntityResult>();
    for(const raw of c.node(c.field(row, 'entities')).children) {
        results.set(field(c,raw,'body'), {text: field(c,raw,'text'), valid: field(c,raw,'valid') === 'true'});
    }
    const value = unescapeStringLiteralText(field(c,row,'text'), (body: string): EntityResult => results.get(body) ?? panic('missing Go dependency answer'));
    let line = '';
    for(let index = 0; index < utf8Length(value); index++) { line += `${utf8At(value,index)},`; }
    console.log(line);
}
