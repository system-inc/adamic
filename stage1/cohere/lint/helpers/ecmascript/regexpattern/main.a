import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../../options_json.ts';
import { consumeDigits } from './consume_digits.a';
import { braceQuantifierEnd } from './brace_quantifier_end.a';
import { isAsciiLetter } from './is_ascii_letter.a';
import { octalEscapeValue } from './octal_escape_value.a';
import { extendOctalEscape } from './extend_octal_escape.a';
import { groupPrologueEnd } from './group_prologue_end.a';
import { decodeRune } from './decode_rune.a';
import { quantifierAt } from './quantifier_at.a';
import { applyQuantifier } from './apply_quantifier.a';
import { kindFromSource } from './kind_from_source.a';
import { emit } from './emit.a';
import { emitAndQuantify } from './emit_and_quantify.a';
import { WalkerState, Character } from './state.a';
function numberField(json: OptionsJson, row: number, key: string): number { const f = json.field(row, key); return f < 0 ? 0 : Number(json.node(f).text); }
function boolField(json: OptionsJson, row: number, key: string): boolean { const f = json.field(row, key); return f >= 0 && json.node(f).text === 'true'; }
const args = programArguments(); const input = readTextFile(args[0] ?? panic('capture path'));
if(input.kind === 'Error') { panic(input.message); }
const json = new OptionsJson(input.text); const root = json.parse(); if(root < 0) { panic(json.error); }
for(const row of json.node(root).children) {
 const symbol = json.node(json.field(row, 'symbol')).text;
 const bytes: number[] = []; const af = json.field(row, 'arr'); if(af >= 0) { for(const a of json.node(af).children) { bytes.push(Number(json.node(a).text)); } }
 const n = numberField(json, row, 'n'); const m = numberField(json, row, 'm');
 let result = '';
 switch(symbol) {
 case 'consumeDigits': result = String(consumeDigits(bytes, n)); break;
 case 'braceQuantifierEnd': { const v = braceQuantifierEnd(bytes, n); result = String(v.end) + '|' + String(v.ok); break; }
 case 'isAsciiLetter': result = String(isAsciiLetter(n)); break;
 case 'octalEscapeValue': { const v = octalEscapeValue(bytes); result = String(v.value) + '|' + String(v.ok); break; }
 case 'extendOctalEscape': result = String(extendOctalEscape(bytes, n, m)); break;
 case 'groupPrologueEnd': result = String(groupPrologueEnd(bytes, n)); break;
 case 'decodeRune': { const v = decodeRune(bytes, n); result = String(v.value) + '|' + String(v.width); break; }
 case 'quantifierAt': { const v = quantifierAt(bytes, n); result = String(v.end) + '|' + String(v.ok); break; }
 case 'kindFromSource': result = String(kindFromSource(bytes, n, m)); break;
 case 'applyQuantifier': { const state = new WalkerState(bytes, 0, 0, () => true); result = String(applyQuantifier(state, n)); break; }
 case 'emit': case 'emitAndQuantify': {
  const calls: string[] = []; const response = boolField(json, row, 'response');
  const callback = (c: Character): boolean => { calls.push(String(c.value) + ':' + String(c.kind) + ':' + String(c.start) + ':' + String(c.end) + ':' + String(c.quantifierDepth) + ':' + String(c.classDepth)); return response; };
  const state = new WalkerState(bytes, n, m, callback); state.stopped = boolField(json, row, 'b');
  const c = new Character(numberField(json,row,'value'),numberField(json,row,'kind'),numberField(json,row,'start'),numberField(json,row,'end'),numberField(json,row,'qd'),numberField(json,row,'cd'));
  const value = symbol === 'emit' ? String(emit(state, c)) : String(emitAndQuantify(state, c));
  result = value + '|' + String(state.stopped) + '|' + String(state.quantifierDepth) + '|' + String(state.classDepth) + '|' + calls.join(';'); break;
 }
 default: panic('unknown regexpattern helper');
 }
 console.log(result);
}
