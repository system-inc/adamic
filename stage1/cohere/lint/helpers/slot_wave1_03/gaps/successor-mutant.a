import { panic } from 'adamic';
interface Block {
    successors: Block[];
    index: number;
}
function appendSuccessor(from: Block, to: Block): void {
    from.successors.push(to);
    to.index += 1;
}
const block: Block = { successors: [], index: 7 };
appendSuccessor(block, block);
const target = block.successors[0] ?? panic('missing successor');
console.log(`${block.successors.length},${target.index},${target === block}`);
