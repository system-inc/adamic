import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { errNothingToRepeat } from './nothing_to_repeat.a';
import { checkGroupQuantifier } from './group_quantifier.a';
import { checkGroupConstruct } from './group_construct.a';
function field(c: OptionsJson, row: number, name: string): number { const n=c.node(row);const i=n.keys.indexOf(name);if(i<0){panic('field');}return n.children[i] ?? panic('value'); }
function text(c: OptionsJson, row: number, name: string): string { return c.node(field(c,row,name)).text; }
const path=programArguments()[0] ?? panic('path');const input=readTextFile(path);if(input.kind==='Error'){panic(input.message);}
const c=new OptionsJson(input.text);const root=c.parse();if(root<0){panic(c.error);}
for(const row of c.node(root).children){
    const data: number[]=[];for(const id of c.node(field(c,row,'Data')).children){data.push(Number(c.node(id).text));}
    const span=Number(text(c,row,'Width'));
    const width=(_source: readonly number[]): number => span;
    console.log(errNothingToRepeat(data,width).join(','));
    console.log(checkGroupQuantifier(Number(text(c,row,'Kind')),data,text(c,row,'Unicode')==='true',width).join(','));
    console.log(checkGroupConstruct(data).join(','));
}
