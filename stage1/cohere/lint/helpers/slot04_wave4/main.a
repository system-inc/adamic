import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { topOfStack } from './top_of_stack.a';
import { peekByte } from './peek_byte.a';
function observe(input: readonly number[]): void {
    const stack: number[] = [];
    console.log(`top ${topOfStack(stack)}`);
    for(const index of [-2147483648, -1, input.length, input.length + 1, 2147483647]) {
        console.log(`peek ${index} ${peekByte(input,index)}`);
    }
    for(let index = 0; index < input.length; index++) {
        const byte = input[index] ?? panic('byte');
        console.log(`peek ${index} ${peekByte(input,index)}`);
        stack.push(byte);
        console.log(`top ${topOfStack(stack)}`);
    }
    if(stack.length > 0) { stack[stack.length - 1] = 137; console.log(`changed ${topOfStack(stack)}`); }
}
const argument = programArguments()[0] ?? panic('path or --full');
if(argument === '--full') {
    observe([]);
    for(let first = 0; first <= 255; first++) {
        observe([first]);
        for(let last = 0; last <= 255; last++) { observe([first,last]); }
    }
} else {
    const input = readTextFile(argument);
    if(input.kind === 'Error') { panic(input.message); }
    const corpus = new OptionsJson(input.text);
    const root = corpus.parse();
    if(root < 0) { panic(corpus.error); }
    for(const row of corpus.node(root).children) {
        const bytes: number[] = [];
        for(const value of corpus.node(row).children) { bytes.push(Number(corpus.node(value).text)); }
        observe(bytes);
    }
}
