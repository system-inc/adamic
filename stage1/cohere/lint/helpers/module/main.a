import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { IsExported } from './is_exported.a';
import { HasExportModifier } from './has_export_modifier.a';
import { IsExportedByName } from './is_exported_by_name.a';
function field(corpus: OptionsJson, row: number, name: string): number {
    const node = corpus.node(row);
    const index = node.keys.indexOf(name);
    if(index < 0) { panic('missing field'); }
    return node.children[index] ?? panic('field');
}
const path = programArguments()[0] ?? panic('path');
const input = readTextFile(path);
if(input.kind === 'Error') { panic(input.message); }
const corpus = new OptionsJson(input.text);
const root = corpus.parse();
if(root < 0) { panic(corpus.error); }
for(const row of corpus.node(root).children) {
    const tags: string[] = [];
    for(const child of corpus.node(field(corpus,row,'Tags')).children) { tags.push(corpus.node(child).text); }
    const modifiers = {present:corpus.node(field(corpus,row,'ListPresent')).text === 'true',tags};
    const node = {present:corpus.node(field(corpus,row,'Present')).text === 'true',modifiers};
    console.log(`${IsExported(node)}|${HasExportModifier(modifiers)}|${IsExportedByName(modifiers)}`);
}
