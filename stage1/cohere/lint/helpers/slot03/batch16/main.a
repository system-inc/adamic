import {panic, readTextFile, programArguments} from 'adamic';
import {OptionsJson} from '../../options_json.ts';
import {makeReturn, type ExitFrame, type ExitState} from './make_return.a';
import {makeThrow} from './make_throw.a';
import {makeYield} from './make_yield.a';
const file=readTextFile(programArguments()[0] ?? panic('missing cases'));if(file.kind==='Error'){panic(file.message);}
const json=new OptionsJson(file.text);const root=json.parse();if(root<0){panic(json.error);}
function num(node:number,key:string):number{return Number(json.node(json.field(node,key)).text);}
function bool(node:number,key:string):boolean{return json.node(json.field(node,key)).text==='true';}
const initialFrames:ExitFrame[]=[];
const initialState:ExitState={cur:{index:0,reachable:false},tryStack:initialFrames};
const adapter={row:0,trace:'',state:initialState};
function flags():string{let s='';for(const f of adapter.state.tryStack){s+=`${f.returnedAny}:${f.thrownAny},`;}return s;}
function record(text:string):void{adapter.trace+=`${text}/${flags()};`;}
function returnFrame():number{const i=num(adapter.row,'returnFrame');record(`return:${i}`);return i;}
function throwFrame():number{const i=num(adapter.row,'throwFrame');record(`throw:${i}`);return i;}
function throwTarget(f:ExitFrame):number{record(`target:${f.index}`);return f.target;}
function link(from:number,to:number):void{record(`link:${from}:${to}`);}
function markFinal(block:number):void{record(`final:${block}`);}
function markThrown(block:number):void{record(`thrown:${block}`);}
function makeUnreachable():void{record(`unreachable:${adapter.state.cur.index}`);adapter.state.cur={index:num(adapter.row,'afterIndex'),reachable:bool(adapter.row,'afterReachable')};}
function newBlock():number{record('new');return num(adapter.row,'freshIndex');}
function enter(block:number):void{record(`enter:${block}`);adapter.state.cur={index:block,reachable:bool(adapter.row,'afterReachable')};}
for(const row of json.node(root).children){adapter.row=row;adapter.trace='';const frames:ExitFrame[]=[];for(const f of json.node(json.field(row,'frames')).children){frames.push({index:num(f,'index'),finallyEntry:num(f,'finallyEntry'),target:num(f,'target'),returnedAny:bool(f,'returnedAny'),thrownAny:bool(f,'thrownAny')});}adapter.state={cur:{index:num(row,'curIndex'),reachable:bool(row,'reachable')},tryStack:frames};const op=json.node(json.field(row,'op')).text;
 if(op==='return'){makeReturn(adapter.state,{returnFrame:()=>returnFrame(),link:(from,to)=>link(from,to),markFinal:block=>markFinal(block),makeUnreachable:()=>makeUnreachable()});}
 else if(op==='throw'){makeThrow(adapter.state,{throwFrame:()=>throwFrame(),throwTarget:frame=>throwTarget(frame),link:(from,to)=>link(from,to),markThrown:block=>markThrown(block),makeUnreachable:()=>makeUnreachable()});}
 else{makeYield(adapter.state,{returnFrame:()=>returnFrame(),throwFrame:()=>throwFrame(),throwTarget:frame=>throwTarget(frame),link:(from,to)=>link(from,to),markFinal:block=>markFinal(block),markThrown:block=>markThrown(block),newBlock:()=>newBlock(),enter:block=>enter(block)});}
 console.log(`${adapter.state.cur.index}:${adapter.state.cur.reachable}/${flags()}/${adapter.trace}`);
}
