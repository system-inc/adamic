import {type CssNode, type ChildList} from './css_node.a';
export function atRule(name: string, params: string, nodes: ChildList): CssNode {
 return {kind: 'at-rule', selector: '', name, params, property: '', value: '', valuePresent: false, important: false, contextPresent: false, nodes: {values: nodes.values, length: nodes.length, capacity: nodes.capacity, present: nodes.present}};
}
