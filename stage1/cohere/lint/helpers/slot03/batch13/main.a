import {panic, readTextFile, programArguments} from 'adamic';
import {OptionsJson} from '../../options_json.ts';
import {inferDataType} from './infer_data_type.a';
import {matchesDataType} from './matches_data_type.a';
import {isFamilyName} from './is_family_name.a';
const file=readTextFile(programArguments()[0] ?? panic('missing cases'));if(file.kind==='Error') {panic(file.message);}
const json=new OptionsJson(file.text);const root=json.parse();if(root<0) {panic(json.error);}
const adapter={row:0,value:'',trace:''};
function check(input:string,predicate:number):boolean {
 adapter.trace+=`check:${predicate};`;if(input!==adapter.value) {adapter.trace+='wrong-value;';}
 const entries=json.node(json.field(adapter.row,'predicates')).children;const entry=entries[predicate] ?? panic('invalid predicate');return json.node(entry).text==='true';
}
function match(input:string,dataType:string):boolean {
 adapter.trace+=`type:${dataType};`;if(input!==adapter.value) {adapter.trace+='wrong-value;';}
 return matchesDataType(input,dataType,(value,predicate)=>check(value,predicate));
}
function segment(input:string,separator:string):string[] {
 adapter.trace+=`segment:${separator};`;if(input!==adapter.value) {adapter.trace+='wrong-value;';}
 const parts:string[]=[];for(const entry of json.node(json.field(adapter.row,'parts')).children) {parts.push(json.node(entry).text);}return parts;
}
for(const row of json.node(json.field(root,'rows')).children) {
 adapter.row=row;adapter.value=json.node(json.field(row,'value')).text;
 for(const entry of json.node(json.field(root,'kinds')).children) {
  const kind=json.node(entry).text;adapter.trace='';const result=matchesDataType(adapter.value,kind,(value,predicate)=>check(value,predicate));console.log(`${result}/${adapter.trace}`);
 }
 for(const order of json.node(json.field(root,'orders')).children) {
  const types:string[]=[];for(const entry of json.node(order).children) {types.push(json.node(entry).text);}
  adapter.trace='';const result=inferDataType(adapter.value,types,(value,kind)=>match(value,kind));console.log(`${result}/${adapter.trace}`);
 }
 adapter.trace='';const result=isFamilyName(adapter.value,(value,separator)=>segment(value,separator));console.log(`${result}/${adapter.trace}`);
}
