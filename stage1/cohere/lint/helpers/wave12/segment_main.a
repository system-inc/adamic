import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { segment } from './collapse_segment.a';
const argumentsList = programArguments();
const file = readTextFile(argumentsList[0] ?? panic('missing corpus'));
if(file.kind === 'Error') { panic(file.message); }
const json = new OptionsJson(file.text);
const root = json.parse();
if(root < 0) { panic(json.error); }
for(const item of json.node(root).children) {
    const input = json.node(json.field(item, 'input')).text;
    const separator = json.node(json.field(item, 'separator')).number;
    const result = segment(input, separator);
    let observation = `${result.length}:`;
    for(const part of result) {
        observation += '[';
        for(let index = 0; index < part.length; index++) { observation += `${part.charCodeAt(index)},`; }
        observation += ']';
    }
    console.log(observation);
}
