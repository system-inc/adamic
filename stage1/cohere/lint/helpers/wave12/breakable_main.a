import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { isBreakableStatement } from './control_flow_is_breakable_statement.a';
const file = readTextFile(programArguments()[0] ?? panic('missing corpus'));
if(file.kind === 'Error') { panic(file.message); }
const json = new OptionsJson(file.text);
const root = json.parse();
if(root < 0) { panic(json.error); }
for(const item of json.node(root).children) {
    const present = json.node(json.field(item, 'present')).text === 'true';
    const kind = json.node(json.field(item, 'kind')).number;
    console.log(`${isBreakableStatement({ present, kind })}`);
}
