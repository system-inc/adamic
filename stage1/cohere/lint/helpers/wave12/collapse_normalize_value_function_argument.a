// Literal translations from origin/codex/lint-regex table.json, pinned cohere 715ba94f.
// tailwind/collapse/utility_nodes.go:131
const escapedStarPattern = /\\\*/gu;
// tailwind/collapse/utility_nodes.go:138
const spacedNestedKeyPattern = /--([^\n]*?)[ \t\n\f\r]--([^\n]*?)/gu;
// tailwind/collapse/utility_nodes.go:140
const whitespacePattern = /[ \t\n\f\r]+/gu;
// tailwind/collapse/utility_nodes.go:142
const repeatedStarSuffixPattern = /(-\*){2,}/gu;
export function normalizeValueFunctionArgument(argument: string): string {
    argument = argument.replace(escapedStarPattern, '*');
    argument = argument.replace(spacedNestedKeyPattern, '--$1-*--$2');
    argument = argument.replace(whitespacePattern, '');
    argument = argument.replace(repeatedStarSuffixPattern, '-*');
    if(argument.startsWith('--') && !argument.includes('(') && !argument.includes('-*')) {
        argument += '-*';
    }
    return argument;
}
