import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from './options_json.ts';
import { collapseIsValidNamedValue } from './collapse_valid_named_value.a';
import { collapseIsValidArbitrary } from './collapse_valid_arbitrary.a';
import { collapseParseThemeOptions } from './collapse_parse_theme_options.a';
const args = programArguments();
const file = readTextFile(args[0] ?? panic('fixture path'));
if (file.kind === 'Error') { panic(file.message); }
for (const line of file.text.split('\n')) {
    if (line === '') { continue; }
    const json = new OptionsJson(line);
    const root = json.parse();
    if (root < 0) { panic(json.error); }
    if (args[1] === 'theme') {
        const fields = json.node(root).children;
        const params = json.node(fields[0] ?? panic('params')).text;
        const segments: string[] = [];
        for (const child of json.node(fields[1] ?? panic('segments')).children) { segments.push(json.node(child).text); }
        const result = collapseParseThemeOptions(params, observed => { if (observed !== params) { panic('params changed'); } return segments; });
        let output = `${result.options} ${result.prefix.length}:`;
        for (let index = 0; index < result.prefix.length; index++) { output += `${result.prefix.charCodeAt(index)},`; }
        console.log(output);
        continue;
    }
    const value = json.node(root).text;
    console.log(`${args[1] === 'arbitrary' ? collapseIsValidArbitrary(value) : collapseIsValidNamedValue(value)}`);
}
