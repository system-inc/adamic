import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { unescapeCSSIdentifier } from './css_identifier_unescape.a';
const argumentsList = programArguments();
const contents = readTextFile(argumentsList[0] ?? panic('cases path'));
if(contents.kind === 'Error') { panic(contents.message); }
const reader = new OptionsJson(contents.text);
const root = reader.parse();
if(root < 0) { panic(reader.error); }
for(const child of reader.node(root).children) { console.log(unescapeCSSIdentifier(reader.node(child).text)); }
