import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../options_json.ts';
import { simpleFold } from './regexp_simple_fold.a';
for(let r = 0; r <= 0x110000; r++) { console.log(String(simpleFold(r))); }
for(const r of [-2147483648, -1048576, -1, 1114113, 2097151, 2147483647]) { console.log(String(simpleFold(r))); }
const args = programArguments();
const input = readTextFile(args[0] ?? panic('fold cases path'));
if(input.kind === 'Error') { panic(input.message); }
const reader = new OptionsJson(input.text);
const root = reader.parse();
if(root < 0) { panic(reader.error); }
for(const child of reader.node(root).children) {
    const source = reader.node(child).text;
    for(let index = 0; index < source.length; index++) {
        let r = source.charCodeAt(index);
        if(r >= 0xD800 && r <= 0xDBFF && index + 1 < source.length) {
            const next = source.charCodeAt(index + 1);
            if(next >= 0xDC00 && next <= 0xDFFF) {
                r = 0x10000 + (r - 0xD800) * 1024 + next - 0xDC00;
                index++;
            }
        }
        console.log(String(simpleFold(r)));
    }
}
