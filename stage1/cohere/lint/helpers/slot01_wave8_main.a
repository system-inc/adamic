import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from './options_json.ts';
import { regexpDecimalEscape } from './regexp_decimal_escape.a';
import { regexpLegacyOctal } from './regexp_legacy_octal.a';
import { regexpClassAtomCovers } from './regexp_class_atom_covers.a';
const args = programArguments();
const file = readTextFile(args[0] ?? panic('fixture path'));
if (file.kind === 'Error') { panic(file.message); }
for (const line of file.text.split('\n')) {
    if (line === '') { continue; }
    const json = new OptionsJson(line);
    const root = json.parse();
    if (root < 0) { panic(json.error); }
    const row = json.node(root).children;
    if (args[1] === 'covers') {
        console.log(`${regexpClassAtomCovers(Number(json.node(row[0] ?? panic('kind')).text), Number(json.node(row[1] ?? panic('low')).text), Number(json.node(row[2] ?? panic('high')).text), Number(json.node(row[3] ?? panic('rune')).text))}`);
        continue;
    }
    const source: number[] = [];
    for (const item of json.node(row[0] ?? panic('bytes')).children) { source.push(Number(json.node(item).text)); }
    const offset = Number(json.node(row[1] ?? panic('offset')).text);
    if (args[1] === 'decimal') {
        const result = regexpDecimalEscape(source, offset);
        console.log(`${result.value}`); console.log(`${result.width}`);
    } else {
        const result = regexpLegacyOctal(source, offset);
        console.log(`${result.value}`); console.log(`${result.width}`);
    }
}
