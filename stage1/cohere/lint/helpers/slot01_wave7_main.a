import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from './options_json.ts';
import { collapseNewTable } from './collapse_new_table.a';
import type { CollapseTableReading } from './collapse_new_table.a';
import { collapseIngestThemeBlock } from './collapse_ingest_theme_block.a';
import type { CollapseThemeNode } from './collapse_ingest_theme_block.a';
import type { CollapseUtilitySlice } from './collapse_ingest_utility_block.a';
import { collapseIngestUtilityBlock } from './collapse_ingest_utility_block.a';
const args = programArguments();
const file = readTextFile(args[0] ?? panic('fixture path'));
if (file.kind === 'Error') { panic(file.message); }
function units(value: string): string {
    let output = `${value.length}:`;
    for (let index = 0; index < value.length; index++) { output += `${value.charCodeAt(index)},`; }
    return output;
}
function walkTheme(list: readonly number[], nodes: readonly CollapseThemeNode[], children: readonly number[][], visit: (index: number) => number, actions: number[]): boolean {
    for (const index of list) {
        const action = visit(index);
        actions.push(action);
        if (action === 2) { return false; }
        const node = nodes[index] ?? panic('node');
        if (action === 0 && ['rule', 'at-rule', 'context', 'at-root'].includes(node.kind)) {
            if (!walkTheme(children[index] ?? panic('children'), nodes, children, visit, actions)) { return false; }
        }
    }
    return true;
}
const baseNames: string[] = [];
const baseDescriptors = new Map<string, number>();
const frameworkNames: string[] = [];
const frameworkRows = new Map<string, { order: { values: number[]; length: number; capacity: number }; count: number }>();
const propertyOrder = new Map<string, number>();
function readingRow(json: OptionsJson, row: readonly number[]): { order: { values: number[]; length: number; capacity: number }; count: number } {
    const values: number[] = [];
    for (const index of json.node(row[1] ?? panic('order')).children) { values.push(Number(json.node(index).text)); }
    return { order: { values, length: Number(json.node(row[2] ?? panic('length')).text), capacity: Number(json.node(row[3] ?? panic('capacity')).text) }, count: Number(json.node(row[4] ?? panic('count')).text) };
}
for (const line of file.text.split('\n')) {
    if (line === '') { continue; }
    const json = new OptionsJson(line);
    const root = json.parse();
    if (root < 0) { panic(json.error); }
    const fields = json.node(root).children;
    if (args[1] === 'table') {
        if (json.node(fields[0] ?? panic('tag')).text === 'metadata') {
            for (const index of json.node(fields[1] ?? panic('base names')).children) {
                const name = json.node(index).text;
                baseDescriptors.set(name, baseNames.length);
                baseNames.push(name);
            }
            for (const index of json.node(fields[2] ?? panic('framework')).children) {
                const row = json.node(index).children;
                const name = json.node(row[0] ?? panic('name')).text;
                frameworkNames.push(name);
                frameworkRows.set(name, readingRow(json, row));
            }
            for (const index of json.node(fields[3] ?? panic('properties')).children) {
                const row = json.node(index).children;
                propertyOrder.set(json.node(row[0] ?? panic('property')).text, Number(json.node(row[1] ?? panic('position')).text));
            }
            continue;
        }
        const source = json.node(fields[0] ?? panic('source')).text;
        const bound = json.node(fields[1] ?? panic('bound')).text === 'true';
        const namespaces: string[] = [];
        for (const index of json.node(fields[2] ?? panic('namespaces')).children) { namespaces.push(json.node(index).text); }
        const keys = new Map<string, readonly string[]>();
        for (const index of json.node(fields[3] ?? panic('namespace keys')).children) {
            const row = json.node(index).children;
            const list: string[] = [];
            for (const key of json.node(row[1] ?? panic('keys')).children) { list.push(json.node(key).text); }
            keys.set(json.node(row[0] ?? panic('namespace')).text, list);
        }
        const repositoryStatics = new Map<string, CollapseTableReading>();
        for (const index of json.node(fields[4] ?? panic('statics')).children) {
            const row = json.node(index).children;
            repositoryStatics.set(json.node(row[0] ?? panic('static root')).text, readingRow(json, row));
        }
        const arena = baseNames.slice();
        const functionalNames: string[] = [];
        for (const index of json.node(fields[5] ?? panic('functional')).children) { functionalNames.push(json.node(index).text); }
        const first = json.node(fields[6] ?? panic('first')).text;
        const trace: string[] = [];
        const captured = new Map<string, { order: { values: number[]; length: number; capacity: number }; count: number }>();
        const table = collapseNewTable({ bound, tailwindVersion: 'test-version', theme: 7 }, {
            descriptorNames: baseNames, baseDescriptors, frameworkNames, propertyOrder,
            staticReading: name => {
                const original = frameworkRows.get(name) ?? panic('framework reading');
                const reading = { order: { values: original.order.values.slice(), length: original.order.length, capacity: original.order.capacity }, count: original.count };
                captured.set(name, reading);
                return { found: true, reading };
            },
            addThemeNamespaces: result => { trace.push('table.addThemeNamespaces(system.theme)'); result.namespaces = namespaces; result.keysByNamespace = keys; },
            addRepositoryStatics: result => { trace.push('table.addRepositoryStatics(system)'); for (const name of functionalNames) { const reading = repositoryStatics.get(name); if (reading !== undefined) { result.statics.set(name, reading); } } },
            addRepositoryFunctionalRoots: result => { trace.push('table.addRepositoryFunctionalRoots(system)'); for (const name of functionalNames) { result.descriptors.set(name, arena.length); arena.push(name); } }
        });
        const observe = () => {
            console.log(units(table.tailwindVersion));
            console.log(`${table.bound} ${table.descriptors.size} ${table.statics.size} ${table.propertyOrder.size} ${table.theme}`);
            console.log(trace.join(','));
            console.log(table.namespaces.join(','));
            for (const name of [first, 'block', source]) {
                const id = table.descriptors.get(name);
                if (id === undefined) { console.log('-1'); } else { console.log(`${units(arena[id] ?? panic('descriptor'))} ${id >= baseNames.length}`); }
                const reading = table.statics.get(name);
                if (reading === undefined) { console.log('-1'); } else {
                    let output = `${reading.count} ${reading.order.length} ${reading.order.capacity}`;
                    for (let index = 0; index < reading.order.length; index++) { output += ` ${reading.order.values[index] ?? panic('order element')}`; }
                    console.log(output);
                }
            }
            console.log(`${table.propertyOrder.get('color') ?? -1}`);
        };
        observe();
        if (bound) {
            const descriptor = baseDescriptors.get(first) ?? panic('original descriptor');
            baseDescriptors.delete(first);
            const color = propertyOrder.get('color') ?? panic('color');
            propertyOrder.set('color', 99999);
            const reading = captured.get('block');
            if (reading !== undefined) {
                if (reading.order.values.length > 0) { reading.order.values[0] = 99999; }
                reading.order.length = 0;
                reading.order.capacity = 0;
                reading.count = 99999;
            }
            observe();
            baseDescriptors.set(first, descriptor);
            propertyOrder.set('color', color);
        } else { observe(); }
        continue;
    }
    if (args[1] === 'theme') {
        const params = json.node(fields[0] ?? panic('params')).text;
        const options = Number(json.node(fields[1] ?? panic('options')).text);
        const prefix = json.node(fields[2] ?? panic('prefix')).text;
        const valid = json.node(fields[3] ?? panic('valid')).text === 'true';
        const quoted = new Map<string, string>();
        quoted.set(prefix, json.node(fields[4] ?? panic('quote prefix')).text);
        const nodes: CollapseThemeNode[] = [];
        const children: number[][] = [];
        const unescaped = new Map<string, string>();
        const addErrors = new Map<string, string>();
        for (const child of json.node(fields[5] ?? panic('nodes')).children) {
            const row = json.node(child).children;
            const property = json.node(row[2] ?? panic('property')).text;
            nodes.push({ kind: json.node(row[0] ?? panic('kind')).text, name: json.node(row[1] ?? panic('name')).text, property, value: json.node(row[3] ?? panic('value')).text });
            const list: number[] = [];
            for (const index of json.node(row[4] ?? panic('children')).children) { list.push(Number(json.node(index).text)); }
            children.push(list);
            const key = json.node(row[5] ?? panic('key')).text;
            unescaped.set(property, key);
            addErrors.set(key, json.node(row[6] ?? panic('error')).text);
            quoted.set(property, json.node(row[7] ?? panic('quote property')).text);
        }
        const roots: number[] = [];
        for (const index of json.node(fields[6] ?? panic('roots')).children) { roots.push(Number(json.node(index).text)); }
        const actions: number[] = [];
        const calls: string[] = [];
        const theme = { prefix: 'old' };
        const error = collapseIngestThemeBlock(theme, params, nodes, roots, 'fixture.css', {
            parseOptions: value => { if (value !== params) { panic('params changed'); } return { options, prefix }; },
            validPrefix: value => { if (value !== prefix) { panic('prefix changed'); } return valid; },
            quote: value => quoted.get(value) ?? panic('quote missing'),
            walk: (list, visit) => { walkTheme(list, nodes, children, visit, actions); },
            isContainer: node => ['rule', 'at-rule', 'context', 'at-root'].includes(node.kind),
            unescape: property => unescaped.get(property) ?? panic('unescape missing'),
            add: (key, value, bits) => { calls.push(`${units(key)} ${units(value)} ${bits}`); return addErrors.get(key) ?? ''; }
        });
        console.log(units(error));
        console.log(units(theme.prefix));
        console.log(actions.join(','));
        for (const call of calls) { console.log(call); }
        continue;
    }
    const state = { roots: new Map<string, number>(), definitions: [] as { readonly name: string; readonly nodes: CollapseUtilitySlice }[], statics: new Map<string, CollapseUtilitySlice>() };
    const bodies: { values: number[]; length: number; capacity: number }[] = [];
    const queries: string[] = [];
    for (const child of json.node(fields[1] ?? panic('queries')).children) { queries.push(json.node(child).text); }
    const observe = (error: string) => {
        console.log(units(error));
        console.log(`${state.roots.size} ${state.definitions.length}`);
        for (const query of queries) {
            const body = state.statics.get(query) ?? { values: [] as readonly number[], length: 0, capacity: 0 };
            let output = `${state.roots.get(query) ?? 0} ${body.length} ${body.capacity}`;
            for (let index = 0; index < body.length; index++) { output += ` ${body.values[index] ?? panic('body value')}`; }
            console.log(output);
        }
        for (const definition of state.definitions) {
            let output = `${units(definition.name)} ${definition.nodes.length} ${definition.nodes.capacity}`;
            for (let index = 0; index < definition.nodes.length; index++) { output += ` ${definition.nodes.values[index] ?? panic('definition value')}`; }
            console.log(output);
        }
    };
    for (const child of json.node(fields[0] ?? panic('rows')).children) {
        const row = json.node(child).children;
        const raw = json.node(row[0] ?? panic('raw')).text;
        const trimmed = json.node(row[1] ?? panic('trimmed')).text;
        const body: number[] = [];
        for (const value of json.node(row[2] ?? panic('body')).children) { body.push(Number(json.node(value).text)); }
        const header = { values: body, length: body.length, capacity: body.length };
        bodies.push(header);
        observe(collapseIngestUtilityBlock(state, raw, header, 'fixture.css', value => { if (value !== raw) { panic('trim argument'); } return trimmed; }));
    }
    for (const body of bodies) { body.values[0] = 99; body.length = 0; body.capacity = 0; }
    observe('');
}
