import { panic, programArguments, readTextFile, utf8At, utf8Length } from 'adamic';
import { OptionsJson } from './options_json.ts';
import { classLiteralSettingsKey } from './tailwind_settings_key.a';
function names(corpus: OptionsJson, row: number, field: string): string[] {
    const result: string[] = [];
    for(const index of corpus.node(corpus.field(row, field)).children) {
        result.push(corpus.node(index).text);
    }
    return result;
}
const input = readTextFile(programArguments()[0] ?? panic('corpus path'));
if(input.kind === 'Error') {
    panic(input.message);
}
const corpus = new OptionsJson(input.text);
const root = corpus.parse();
if(root < 0) {
    panic(corpus.error);
}
for(const row of corpus.node(root).children) {
    const key = classLiteralSettingsKey({
        attributeNames: names(corpus, row, 'AttributeNames'),
        calleeNames: names(corpus, row, 'CalleeNames'),
        variablePatterns: names(corpus, row, 'VariablePatterns'),
    });
    let bytes = '';
    for(let index = 0; index < utf8Length(key); index++) {
        bytes += `${utf8At(key, index)},`;
    }
    console.log(bytes);
}
