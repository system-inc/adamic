import { panic } from 'adamic';
// The input is Go's signed int32 rune. Go string(r) replaces invalid scalars.
export function escapeClassRune(rune: number): string {
    if (!Number.isInteger(rune) || rune < -2147483648 || rune > 2147483647) { panic('invalid Go rune adapter'); }
    const valid = rune >= 0 && rune <= 1114111 && !(rune >= 55296 && rune <= 57343);
    const text = String.fromCodePoint(valid ? rune : 65533);
    if (rune === 92 || rune === 93 || rune === 94 || rune === 45 || rune === 91) { return '\\' + text; }
    return text;
}
