// Only ASCII transformation boundaries split chunks, preserving Unicode pairs.
export function convertUnderscoresToWhitespace(input: string, skip: boolean): string {
    let output = '';
    let start = 0;
    for (let index = 0; index < input.length; index++) {
        const code = input.charCodeAt(index);
        if (code === 92 && input.charCodeAt(index + 1) === 95) {
            output += input.slice(start, index) + '_';
            index++;
            start = index + 1;
        } else if (code === 95 && !skip) {
            output += input.slice(start, index) + ' ';
            start = index + 1;
        }
    }
    return output + input.slice(start);
}
