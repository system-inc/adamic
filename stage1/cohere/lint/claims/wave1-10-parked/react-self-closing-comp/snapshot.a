import { utf8Length } from 'adamic';
import { written } from '../../../../typescript/parser/nodes.ts';
import { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { Parser } from '../../../../typescript/parser/parser.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { RuleContext } from '../../context.ts';
import { Settings } from '../../settings.ts';
import { Rule } from './rule.a';
function output(index: number, context: RuleContext): void {
    console.log(`case ${index}`);
    context.findings.sort((a, b) => a.start - b.start);
    for(const finding of context.findings) {
        console.log('finding ' + `${utf8Length(context.source.slice(0, finding.start))} ${utf8Length(context.source.slice(0, finding.end))} ${finding.id} ${finding.repair}\t${written(finding.replacement)}\t${finding.message}`);
        if(finding.repair !== '') { console.log(`edit ${utf8Length(context.source.slice(0, finding.editStart))} ${utf8Length(context.source.slice(0, finding.editEnd))}`); }
    }
    let fixed = context.source;
    for(const finding of context.findings.slice().reverse()) {
        if(finding.repair === 'fix') { fixed = fixed.slice(0, finding.editStart) + finding.replacement + fixed.slice(finding.editEnd); }
    }
    console.log('fixed\t' + written(fixed));
}
