// Upstream interpolated descriptions, verbatim.
export function baseMessage(name: string, certainty: string, join: boolean): string { return join ? `Using \`join()\` for ${name} ${certainty} use Object's default stringification format ('[object Object]') when stringified.` : `'${name}' ${certainty} use Object's default stringification format ('[object Object]') when stringified.`; }
