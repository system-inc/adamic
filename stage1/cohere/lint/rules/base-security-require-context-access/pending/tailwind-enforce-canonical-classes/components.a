import { panic, programArguments, readTextFile } from 'adamic';
import { OptionsJson } from '../../../../helpers/options_json.ts';
import { written } from '../../../../../../typescript/parser/nodes.ts';
import { Candidate, mergeOnce, message as collapseMessage } from './collapse.a';
import { Slot, lexical, slotFixes, message as orderMessage } from '../tailwind-enforce-consistent-class-order/ordering.a';
import { tokensIn } from '../tailwind-enforce-consistent-class-order/tokens.a';
const input = readTextFile(programArguments()[0] ?? panic('cases path'));
if(input.kind === 'Error') { panic(input.message); }
const data = new OptionsJson(input.text); const root = data.parse();
function field(row: number, key: string): string { const index = data.field(row, key); return index < 0 ? '' : data.node(index).text; }
function list(row: number, key: string): readonly number[] { const index = data.field(row, key); return index < 0 ? [] : data.node(index).children; }
let caseNumber = 0;
for(const row of data.node(root).children) {
    console.log(`case ${caseNumber}`); caseNumber++;
    if(field(row, 'mode') === 'tokens') {
        const tokens = tokensIn(field(row, 'source'), Number(field(row, 'start')), Number(field(row, 'end')), field(row, 'value'));
        console.log(`valid\t${tokens !== undefined}`);
        if(tokens !== undefined) {
            for(const token of tokens) { console.log(`token\t${token.start} ${token.end}\t${token.separator}\t${written(token.text)}`); }
        }
    } else if(field(row, 'mode') === 'collapse') {
        const candidates: Candidate[] = [];
        for(const raw of list(row, 'candidates')) { candidates.push(new Candidate(field(raw, 'ClassName'), field(raw, 'Prefix'), field(raw, 'Root'), field(raw, 'Value'), field(raw, 'SourceValue'), field(raw, 'Important') === 'true')); }
        const result = mergeOnce(candidates, field(row, 'logical') === 'true');
        console.log(`inputs\t${written(result.inputs.join('|'))}`);
        console.log(`output\t${written(result.output)}`);
        console.log(`message\t${written(result.output === '' ? '' : collapseMessage(result.inputs, result.output))}`);
    } else {
        const classes = list(row, 'classes').map(index => data.node(index).text);
        const ordered = lexical(classes, field(row, 'order'));
        console.log(`order\t${written(ordered.join('|'))}`);
        console.log(`message\t${written(orderMessage(ordered.join(' ')))}`);
        const slots: Slot[] = [];
        for(const raw of list(row, 'slots')) { slots.push(new Slot(field(raw, 'text'), Number(field(raw, 'start')), Number(field(raw, 'end')))); }
        for(const fix of slotFixes(slots, ordered)) { console.log(`fix\t${fix.start} ${fix.end}\t${written(fix.text)}`); }
    }
}
