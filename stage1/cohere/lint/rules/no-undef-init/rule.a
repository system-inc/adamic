import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { SuggestionEdit } from '../../suggestions.a';
import { SymbolDetails } from '../../checker_declarations.a';
import { Bindings, waveNode } from './bindings.a';
import { unnecessaryUndefinedInit } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    readonly bindings: Bindings;
    constructor(context: RuleContext) { this.context=context; this.bindings=new Bindings(context); }
    visit(node: ParseNode,index: number): void {
        const list=waveNode(this.context,this.context.parent(index));
        if(list.kind !== 'VariableDeclarationList' || ['2','4','6'].includes(list.semantic)) { return; }
        const initializer=this.context.initializer(index);
        const value=waveNode(this.context,initializer);
        if(value.kind !== 'Identifier' || value.text !== 'undefined') { return; }
        const answer=this.context.checker?.ask(initializer, 'node-symbol-details');
        if(answer === undefined || answer.value === undefined) { return; }
        if(new SymbolDetails(answer.value).declarations.some((declaration)=>!declaration.declarationFile)) { return; }
        const nameIndex=this.bindings.name(index);
        if(nameIndex < 0) { return; }
        const name=this.context.node(nameIndex);
        const edits: SuggestionEdit[]=[];
        if(list.semantic === '1' && name.kind === 'Identifier') {
            let removal=name.end;
            for(const child of node.children.slice(node.children.indexOf(nameIndex)+1)) {
                if(child === initializer) { break; }
                removal=this.context.node(child).end;
            }
            const text=this.context.source.slice(removal,node.end);
            if(!text.includes('/*') && !text.includes('//')) { edits.push(new SuggestionEdit(removal,node.end,'')); }
        }
        this.context.reportNode(index,'no-undef-init','unnecessaryUndefinedInit',unnecessaryUndefinedInit(this.context.raw(nameIndex)),edits);
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
