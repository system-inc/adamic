export const id = 'googleFontPreconnect';
export const message =
    'This <link> points at fonts.gstatic.com without `rel="preconnect"`. The browser only opens the connection to the font host once it has parsed the stylesheet that references it, so the DNS lookup, TCP handshake and TLS negotiation all happen on the critical path and the text waits on them. Add rel="preconnect".';
