export const id = 'noBeforeInteractiveScriptOutsideDocument';
export const message =
    "This loads a script with next/script's beforeInteractive strategy outside of pages/_document.js. That strategy only has a place to run before hydration when the framework injects it from the document, so anywhere else the script is either deferred until after hydration or evaluated twice, and code depending on it having already run sees a different order in development than in production. Move the script into pages/_document.js, or pick a strategy that does not promise to run first.";
