import { panic } from 'adamic';
import { Finding } from '../../../../finding.ts';
import { SuggestionEdit, Suggestion as SharedSuggestion } from '../../../../suggestions.a';
import type { RuleContext } from '../../../../context.ts';

export class Fix extends SuggestionEdit {
    constructor(start: number, end: number, text: string) { super(start, end, text); }
}
export class Suggestion extends SharedSuggestion {
    readonly fixes: readonly Fix[];
    constructor(id: string, message: string, fixes: readonly Fix[]) {
        super(id, message, fixes);
        this.fixes = fixes;
    }
}
export class SuggestedFinding extends Finding {
    constructor(rule: string, id: string, message: string, start: number, end: number, suggestions: readonly Suggestion[], repair = '', replacement = '') {
        super(rule, id, message, start, end, repair, replacement, '');
        for(const suggestion of suggestions) this.suggestions.push(suggestion);
    }
}
let detailedReporting = false;
export function enableDetailedReporting(): void { detailedReporting = true; }
export function requireDetailedReporting(context: RuleContext, name: string): void {
    if(context.enabled(name) && !detailedReporting) panic('non-null rules require a driver that reports complete suggestion edits');
}
