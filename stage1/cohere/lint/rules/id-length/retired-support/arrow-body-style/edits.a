import { Fix, SuggestedFinding } from '../typescript-no-non-null-assertion/suggestions.a';
export class FixedFinding extends SuggestedFinding {
    readonly fixes: readonly Fix[];
    constructor(rule: string, id: string, message: string, start: number, end: number, fixes: readonly Fix[]) {
        const first = fixes[0];
        super(rule, id, message, start, end, [], first === undefined ? '' : 'fix', first?.text ?? '');
        if(first !== undefined) {
            this.editStart = first.start;
            this.editEnd = first.end;
        }
        for(const fix of fixes.slice(1)) this.extraFixes.push(fix);
        this.fixes = fixes;
    }
}
