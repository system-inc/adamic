export const pageStateRemountsMessage = "State held in a page.tsx resets on every navigation. The App Router remounts the page component on router.push (vercel/next.js#48004), so a filter, a draft, or a scroll position kept here silently disappears when the user navigates and comes back. Nothing errors and nothing warns; the value is just gone. Host it in a context provider in the route's layout.tsx, which is not remounted, or disable this rule on the line if resetting on navigation is what you want.";
