import type { RuleContext } from '../../context.ts';
import { description } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    constructorTarget(index: number): boolean {
        const node = this.context.node(index);
        for(const child of node.children) {
            const kind = this.context.node(child).kind;
            if(kind === 'StaticKeyword' || kind === 'AsteriskToken') { return false; }
        }
        if(node.kind === 'Constructor') {
            // This parser also labels generator and accessor keys Constructor.
            // Accessor introducers have no child node, so read the header tokens.
            this.context.scanner.pos = this.context.start(index);
            while(this.context.scanner.scan() !== 'EndOfFile' && this.context.scanner.start < node.end) {
                if(this.context.scanner.kind === 'OpenParenToken') { break; }
                if(this.context.scanner.kind === 'GetKeyword' || this.context.scanner.kind === 'SetKeyword') { return false; }
            }
            return true;
        }
        if(node.kind !== 'MethodDeclaration') { return false; }
        const parent = this.context.parents[index] ?? -1;
        if(parent < 0 || !['ClassDeclaration', 'ClassExpression'].includes(this.context.node(parent).kind)) { return false; }
        // Go recognizes a string-named constructor; this parser calls it a method.
        for(const child of node.children) {
            const name = this.context.node(child);
            if(name.kind === 'StringLiteral') { return name.text === 'constructor'; }
            if(['Identifier', 'PrivateIdentifier', 'NumericLiteral', 'ComputedPropertyName'].includes(name.kind)) { return false; }
        }
        return false;
    }
    visit(index: number): void {
        if(this.context.node(index).children.length === 0) { return; }
        let ancestor = this.context.parents[index] ?? -1;
        while(ancestor >= 0) {
            const node = this.context.node(ancestor);
            if(this.constructorTarget(ancestor)) {
                this.context.report(index, 'no-constructor-return', 'noConstructorReturn', description, '', '', '');
                return;
            }
            // The nearest function-like ancestor owns the return, including methods
            // and accessors nested within a constructor body.
            if(['Constructor', 'FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration',
                'GetAccessor', 'SetAccessor', 'MethodSignature', 'CallSignature', 'ConstructSignature',
                'IndexSignature', 'FunctionType', 'ConstructorType'].includes(node.kind)) { return; }
            ancestor = this.context.parents[ancestor] ?? -1;
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
