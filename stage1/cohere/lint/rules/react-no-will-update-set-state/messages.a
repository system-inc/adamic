export const messageNoSetStateInComponentWillUpdate = "Updating state from `componentWillUpdate` runs while React is already partway through committing the update that called it, so the new state can be read by some of the tree and not the rest and the component settles on a value neither render chose. Derive the value in `render`, or move the update into `componentDidUpdate` guarded on a comparison of the previous props so it cannot run on its own output.";
