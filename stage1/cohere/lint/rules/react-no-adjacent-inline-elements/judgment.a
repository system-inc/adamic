import { edgeWhitespace } from './patterns.a';
import { Kind } from '../../../typeaware/rules/wave-22-sixth/common/kinds.a';
import type { Node } from '../../../typeaware/rules/wave-22-sixth/common/node.a';
import type { Context } from '../../../typeaware/rules/wave-22-sixth/common/context.a';
export class Rule {
    readonly context: Context;
    readonly inlineNames: readonly string[]=['a','b','big','i','small','tt','abbr','acronym','cite','code','dfn','em','kbd','strong','samp','time','var','bdo','br','img','map','object','q','script','span','sub','sup','button','input','label','select','textarea'];
    constructor(context: Context){this.context=context;}
    source(node: Node): boolean {
        const context=this.context;
        if(node.kind===Kind.Identifier){return node.text==='React';}
        if(node.kind===Kind.PropertyAccessExpression){const object=context.first(node);return (object.kind===Kind.Identifier&&object.text==='React')||context.requireReact(object);}
        return context.requireReact(node);
    }
    declaration(node: Node): boolean {
        const context=this.context;
        if(node.kind===Kind.ImportSpecifier){return context.importModule(node)==='react';}
        if(node.kind===Kind.BindingElement) {
            if(node.parent<0){return false;}const pattern=context.node(node.parent);
            if(pattern.kind!==Kind.ObjectBindingPattern||pattern.parent<0){return false;}
            const variable=context.node(pattern.parent);
            return variable.kind===Kind.VariableDeclaration&&variable.initializer>=0&&this.source(context.initializer(variable));
        }
        return node.kind===Kind.VariableDeclaration&&node.initializer>=0&&this.source(context.initializer(node));
    }
    createElement(node: Node): boolean {
        const context=this.context;const callee=context.skip(context.first(node));
        if(callee.kind===Kind.PropertyAccessExpression) {
            const object=context.first(callee);const name=context.last(callee);
            return object.kind===Kind.Identifier&&object.text==='React'&&name.kind===Kind.Identifier&&name.text==='createElement';
        }
        return callee.kind===Kind.Identifier&&callee.text==='createElement'&&context.declarations(callee).some((id)=>this.declaration(context.node(id)));
    }
    jsxInline(node: Node): boolean {
        if(node.kind!==Kind.JsxElement&&node.kind!==Kind.JsxSelfClosingElement){return false;}
        const tag=this.context.first(this.context.opening(node));return tag.kind===Kind.Identifier&&this.inlineNames.includes(tag.text);
    }
    arrayInline(node: Node): boolean {
        if([Kind.StringLiteral,Kind.NumericLiteral,Kind.BigIntLiteral,Kind.TrueKeyword,Kind.FalseKeyword,Kind.NullKeyword,Kind.RegularExpressionLiteral].includes(node.kind)) {
            if(node.kind!==Kind.StringLiteral){return true;}
            return !edgeWhitespace.test(node.text);
        }
        if(node.kind!==Kind.CallExpression||node.list<=0){return false;}
        const first=this.context.node(this.context.args(node)[0]??-1);return first.kind===Kind.StringLiteral&&this.inlineNames.includes(first.text);
    }
    visit(node: Node): void {
        const context=this.context;let children: readonly number[]=[];const jsx=node.kind===Kind.JsxElement;
        if(jsx){children=node.children.slice(1,node.children.length-1);}
        else {
            if(!this.createElement(node)||node.list<3){return;}
            const third=context.node(context.args(node)[2]??-1);if(third.kind!==Kind.ArrayLiteralExpression){return;}
            children=third.children;
        }
        let previous=false;
        for(const id of children) {
            const child=context.node(id);const current=jsx?this.jsxInline(child):this.arrayInline(child);
            if(previous&&current) {
                context.report(node,'no-adjacent-inline-elements','inlineElement','These two inline elements sit directly against each other with nothing between them, so the browser renders them as one run of text with no gap. What reads as two separate links or labels in the source arrives as a single unbroken word on the page, and the reader has no way to see where one ends. Put a space between them, or wrap them in block-level elements that separate themselves.');
                return;
            }
            previous=current;
        }
    }
}
export function create(context: Context): Rule { return new Rule(context); }
