export const message = "This `for-in` loop visits inherited properties as well as the object's own. `for-in` walks the whole prototype chain, so anything added to `Object.prototype` by a library, a polyfill, or older code shows up as another iteration, and the body runs on a key the object never declared. The usual symptom is a serializer emitting a phantom field or a counter that is one too high, on a machine where some other package loaded first. Guard the body with `if (Object.prototype.hasOwnProperty.call(o, key))`, or use `Object.keys(o)`, which returns own enumerable keys and needs no guard.";
