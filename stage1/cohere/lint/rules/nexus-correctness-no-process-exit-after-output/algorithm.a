import { panic } from 'adamic';
import type { Rules } from '../../../typeaware/rules.ts';
import { Bindings } from '../../../typeaware/bindings.ts';
import { Diagnostic } from '../../../typeaware/diagnostic.ts';
import { OutputCFG } from '../../../typeaware/wave_05_next/output_cfg.a';
import { OutputIdentity } from '../../../typeaware/wave_05_next/output_identity.a';
const message =
    'This calls `process.exit()` on a path that has already written to stdout or stderr in this function. `process.exit()` ends the process without waiting for writes still in flight, and a write to a pipe can be one: a reader piping this command (`| grep`, `execSync`, a spawned child) gets the output cut at 64 KB, with exit status 0 and no error. Set `process.exitCode = n` and return instead, so the process ends on its own once the output has drained.';
export function chainHolds(outer: string, inner: string): boolean {
    return inner.split(',').every((id) => id === '' || outer.includes(`,${id},`));
}
export function withChain(state: readonly string[], chain: string): string[] {
    const next: string[] = [];
    for(const held of state) {
        if(chainHolds(chain, held)) {
            return state.slice();
        }
        if(!chainHolds(held, chain)) {
            next.push(held);
        }
    }
    next.push(chain);
    next.sort((left, right) => (left < right ? -1 : left > right ? 1 : 0));
    return next;
}
export function writeChain(rules: Rules, root: number, write: number): string {
    const ids: number[] = [];
    let previous = write;
    let parent = rules.parents[write] ?? -1;
    while(parent >= 0 && parent !== root) {
        const node = rules.parser.node(parent);
        if(
            node.kind === 'TryStatement' &&
            node.children[0] === previous &&
            node.children.some((child) => rules.parser.node(child).kind === 'CatchClause')
        ) {
            ids.push(parent);
        }
        previous = parent;
        parent = rules.parents[parent] ?? -1;
    }
    ids.sort((left, right) => left - right);
    return `,${ids.map((id) => `${id}`).join(',')}${ids.length > 0 ? ',' : ''}`;
}
class Position {
    readonly block: number;
    readonly state: readonly string[];
    constructor(block: number, state: readonly string[]) {
        this.block = block;
        this.state = state;
    }
}
// Pinned typescript-go SyntaxKind values for the shared kind-indexed driver.
export const listenerKinds: readonly number[] = [307];
export class NoProcessExitAfterOutput {
    readonly rules: Rules;
    readonly bindings: Bindings;
    readonly identity: OutputIdentity;
    constructor(rules: Rules, bindings: Bindings, identity: OutputIdentity) {
        this.rules = rules;
        this.bindings = bindings;
        this.identity = identity;
    }
    analyze(root: number, exits: readonly number[], graph: OutputCFG): void {
        const reported: number[] = [];
        const visited = new Map<string, boolean>();
        visited.set('0:', true);
        const queue: Position[] = [new Position(0, [])];
        let at = 0;
        while(at < queue.length) {
            const position = queue[at] ?? panic('missing position');
            at++;
            const block = graph.blocks[position.block] ?? panic('missing graph block');
            let state = position.state;
            if(block.symbol === 0) {
                state = withChain(state, writeChain(this.rules, root, block.index));
            }
            else if(block.symbol === 2) {
                const clause = this.bindings.parent(block.index);
                const tried = this.bindings.parent(clause);
                state = state.filter((held) => !held.includes(`,${tried},`));
            }
            else if(block.symbol === 1) {
                if(state.length > 0 && !reported.includes(block.index)) {
                    reported.push(block.index);
                }
                continue;
            }
            const key = state.join('|');
            for(const next of block.successors) {
                if(!(graph.blocks[next]?.reachable ?? false)) {
                    continue;
                }
                const visit = `${next}:${key}`;
                if(visited.has(visit)) {
                    continue;
                }
                visited.set(visit, true);
                queue.push(new Position(next, state));
            }
        }
        for(const exit of exits) {
            if(!reported.includes(exit)) {
                continue;
            }
            const node = this.rules.parser.node(exit);
            this.rules.findings.push(
                new Diagnostic(
                    'nexus/correctness-no-process-exit-after-output',
                    'exitAfterOutput',
                    message,
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    '',
                ),
            );
        }
    }
    run(): void {
        const events = new Map<number, readonly number[]>();
        const graph = new OutputCFG(this.rules, this.bindings, events);
        const roots: number[] = [];
        const allExits: number[] = [];
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            if(this.rules.parser.node(at).kind !== 'CallExpression' || !this.identity.isExit(at)) {
                continue;
            }
            const root = graph.root(at);
            if(root >= 0) {
                allExits.push(at);
                if(!roots.includes(root)) {
                    roots.push(root);
                }
            }
        }
        for(const root of roots) {
            const exits = allExits.filter((exit) => graph.root(exit) === root);
            let hasWrite = false;
            let recorded = true;
            events.clear();
            for(let at = 0; at < this.rules.parser.nodes.length; at++) {
                const node = this.rules.parser.node(at);
                if(graph.root(at) !== root) {
                    continue;
                }
                if(node.kind === 'Block' && this.rules.parser.node(this.bindings.parent(at)).kind === 'CatchClause') {
                    events.set(at, [2]);
                }
                if(node.kind !== 'CallExpression') {
                    continue;
                }
                if(this.identity.inCatchBinding(at, root)) {
                    continue;
                }
                if(this.identity.isExit(at)) {
                    events.set(at, [1]);
                }
                else if(this.identity.writer(at)) {
                    hasWrite = true;
                    if(!this.identity.holdsExit(at)) {
                        events.set(at, [0]);
                    }
                }
            }
            if(!hasWrite) {
                continue;
            }
            graph.analyze(root);
            for(const exit of exits) {
                if(!graph.blocks.some((block) => block.index === exit && block.symbol === 1)) {
                    recorded = false;
                }
            }
            if(recorded) {
                this.analyze(root, exits, graph);
            }
        }
    }
}
