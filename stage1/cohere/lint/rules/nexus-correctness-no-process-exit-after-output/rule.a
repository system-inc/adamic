import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { legacy, publish } from '../require-await/compatibility.a';
import type { Rules } from '../../../typeaware/rules.ts';
import { NoProcessExitAfterOutput } from './algorithm.a';
import { Bindings } from '../../../typeaware/bindings.ts';
import { OutputIdentity } from '../../../typeaware/wave_05_next/output_identity.a';
export class Rule {
    readonly context: RuleContext;
    view: Rules | undefined = undefined;
    rule: NoProcessExitAfterOutput | undefined = undefined;
