export const message = 'A `let`, `const`, `class`, or `function` declared directly in a case clause is scoped to the whole switch, not to this arm. Every other arm can see the binding, but only this arm initializes it, so a sibling arm that reaches it throws on a binding that appears to be in scope. Wrap this clause\'s body in braces to scope the binding to the arm that declares it.';
export const suggestion = 'Wrap the clause body in braces.';
