import type { RuleContext } from '../../context.ts';
import { Diagnostic, Edit, Suggestion, report, refuseShared } from '../typescript-eslint-prefer-as-const/repairs.a';
import { message } from './messages.a';

function scanAfter(context: RuleContext, position: number): string {
    context.scanner.pos = position;
    context.scanner.scan();
    return context.scanner.kind;
}

export class Rule {
    readonly context: RuleContext;
    readonly diagnostics: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    visit(index: number): void {
        const node = this.context.node(index);
        if(node.kind !== 'TypeParameter') { return; }
        let name = -1; let constraint = -1;
        for(let i = 0; i < node.children.length; i++) {
            const child = node.children[i];
            if(child !== undefined && this.context.node(child).kind === 'Identifier') {
                name = child; constraint = node.children[i + 1] ?? -1; break;
            }
        }
        if(name < 0 || constraint < 0) { return; }
        this.context.scanner.pos = this.context.node(name).end;
        this.context.scanner.scan();
        if(this.context.scanner.kind !== 'ExtendsKeyword' && this.context.scanner.kind !== 'InKeyword') { return; }
        const kind = this.context.node(constraint).kind;
        if(kind !== 'AnyKeyword' && kind !== 'UnknownKeyword') { return; }
        let replacement = '';
        const parent = this.context.parents[index] ?? -1;
        if(parent >= 0 && this.context.node(parent).kind === 'ArrowFunction') {
            let count = 0;
            for(const child of this.context.node(parent).children) {
                if(this.context.node(child).kind === 'TypeParameter') { count++; }
            }
            const after = scanAfter(this.context, this.context.node(constraint).end);
            const path = this.context.parser.path;
            if(count === 1 && after !== 'EqualsToken' && after !== 'CommaToken' && (path.endsWith('.tsx') || path.endsWith('.mts') || path.endsWith('.cts'))) { replacement = ','; }
        }
        this.diagnostics.push(report(this.context, name, 'noUnnecessaryTypeConstraint', message, [], [new Suggestion('removeTheConstraint', 'Remove the constraint that does nothing.', [new Edit(this.context.node(name).end, this.context.node(constraint).end, replacement)])]));
    }
}
export function create(context: RuleContext): Rule {
    refuseShared(context, '@typescript-eslint/no-unnecessary-type-constraint');
    return new Rule(context);
}
