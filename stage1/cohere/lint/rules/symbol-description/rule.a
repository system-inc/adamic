import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { outputDeclarationFiles } from '../../checker_output_symbol.a';
import { messageSymbolDescription } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        if(node.list > 0 || this.context.checker === undefined) { return; }
        const calleeIndex = this.context.unwrap(node.children[0] ?? -1);
        const callee = this.context.node(calleeIndex);
        if(callee.kind !== 'Identifier' || callee.text !== 'Symbol') { return; }
        const declarations = this.origins(callee);
        if(declarations.length === 0 || declarations[0] !== true) { return; }
        this.context.reportNode(index, 'symbol-description', 'expected', messageSymbolDescription);
    }
    origins(node: ParseNode): boolean[] {
        const checker = this.context.checker;
        if(checker === undefined) { return []; }
        return outputDeclarationFiles(checker, node);
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
