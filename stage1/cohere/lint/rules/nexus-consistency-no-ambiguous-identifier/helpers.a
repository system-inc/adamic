import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { RuleContext } from '../../context.ts';
// Shared regex table rows nexus/consistency_no_ambiguous_identifier.go:17-19.
// MatchString asks only for existence; no global iteration state is needed.
export const singleLowercaseLetter = /^[a-z](?![\s\S])/u;
const handlerNamePattern = /handle|on[A-Z]|event/iu;
const eventHandlerKeyPattern = /^on[A-Z]/u;
// Reads as isAmbiguousDeclarationName and ast.IsDeclarationName: a declaration's name,
// except shorthand reads, plus the label where it is chosen and a first JavaScript this property.
export function ambiguousDeclarationName(context: RuleContext, index: number): boolean {
    const owner = context.parent(index);
    if(owner < 0) { return false; }
    const kind = context.kind(owner);
    if(kind === 'ShorthandPropertyAssignment') { return false; }
    if(kind === 'BindingElement') {
        const parts = context.node(owner).children.filter((child) => context.kind(child) !== 'DotDotDotToken');
        const first = parts[0] ?? -1;
        const renamed = first >= 0 && context.scanAt(context.node(first).end) === 'ColonToken';
        return (renamed ? parts[1] ?? -1 : first) === index;
    }
    if(kind === 'LabeledStatement') { return context.child(owner, 0) === index; }
    if([
        'VariableDeclaration', 'Parameter', 'FunctionDeclaration',
        'FunctionExpression', 'ClassDeclaration', 'ClassExpression', 'PropertyDeclaration',
        'PropertySignature', 'MethodDeclaration', 'MethodSignature', 'GetAccessor', 'SetAccessor',
        'EnumDeclaration', 'EnumMember', 'InterfaceDeclaration', 'TypeAliasDeclaration',
        'TypeParameter', 'ModuleDeclaration', 'ImportClause', 'NamespaceImport', 'ImportSpecifier',
        'ExportSpecifier', 'ImportEqualsDeclaration', 'NamespaceExport', 'NamespaceExportDeclaration',
        'NamedTupleMember', 'PropertyAssignment',
        'JsxAttribute',
    ].includes(kind) && context.name(owner) === index) { return true; }
    return firstThisPropertyDeclaration(context, index);
}
// Reads as thisPropertyDeclarationOwner, ast.GetAssignmentDeclarationKind and ast.GetThisContainer.
// A class member owns this across arrows, but not across ordinary functions or nested containers.
function thisPropertyOwner(context: RuleContext, index: number): number {
    if(!context.parser.javascript) { return -1; }
    const access = context.parent(index);
    if(context.kind(access) !== 'PropertyAccessExpression' || context.property(access) !== index ||
        context.kind(context.child(access, 0)) !== 'ThisKeyword') { return -1; }
    const assignment = context.parent(access);
    if(context.kind(assignment) !== 'BinaryExpression' || context.child(assignment, 0) !== access ||
        context.kind(context.child(assignment, 1)) !== 'EqualsToken') { return -1; }
    for(let cursor = context.parent(assignment); cursor >= 0; cursor = context.parent(cursor)) {
        const kind = context.kind(cursor);
        if(kind === 'ComputedPropertyName') { cursor = context.parent(cursor); continue; }
        if(kind === 'Decorator') {
            const decorated = context.parent(cursor);
            if(context.kind(decorated) === 'Parameter' && classMember(context.kind(context.parent(decorated)))) {
                cursor = context.parent(decorated);
            }
            else if(classMember(context.kind(decorated))) { cursor = decorated; }
            continue;
        }
        if(classMember(kind)) {
            const owner = context.parent(cursor);
            return ['ClassDeclaration', 'ClassExpression'].includes(context.kind(owner)) ? cursor : -1;
        }
        if(['FunctionDeclaration', 'FunctionExpression', 'ModuleDeclaration', 'PropertySignature',
            'MethodSignature', 'CallSignature', 'ConstructSignature', 'IndexSignature',
            'EnumDeclaration', 'SourceFile'].includes(kind)) { return -1; }
    }
    return -1;
}
function classMember(kind: string): boolean {
    return ['Constructor', 'PropertyDeclaration', 'MethodDeclaration', 'GetAccessor',
        'SetAccessor', 'ClassStaticBlockDeclaration'].includes(kind);
}
function staticMember(context: RuleContext, index: number): boolean {
    return context.kind(index) === 'ClassStaticBlockDeclaration' || context.has(index, 'StaticKeyword');
}
// Reads as isFirstThisPropertyDeclaration: an explicit member wins, otherwise source order wins,
// keeping instance and static property tables separate as the binder does.
function firstThisPropertyDeclaration(context: RuleContext, index: number): boolean {
    const owner = thisPropertyOwner(context, index);
    if(owner < 0) { return false; }
    const classIndex = context.parent(owner);
    const isStatic = staticMember(context, owner);
    const name = context.node(index).text;
    for(const member of context.members(classIndex)) {
        const key = context.name(member);
        if(key >= 0 && ['Identifier', 'StringLiteral'].includes(context.kind(key)) &&
            context.node(key).text === name && staticMember(context, member) === isStatic) { return false; }
    }
    return firstThisPropertyIn(context, classIndex, classIndex, isStatic, name) === index;
}
function firstThisPropertyIn(context: RuleContext, index: number, classIndex: number, isStatic: boolean, name: string): number {
    const node = context.node(index);
    if(node.kind === 'Identifier' && node.text === name) {
        const owner = thisPropertyOwner(context, index);
        if(owner >= 0 && context.parent(owner) === classIndex && staticMember(context, owner) === isStatic) { return index; }
    }
    for(const child of node.children) {
        const found = firstThisPropertyIn(context, child, classIndex, isStatic, name);
        if(found >= 0) { return found; }
    }
    return -1;
}
export function eventContext(context: RuleContext, index: number): string {
    const declaration = context.parent(index);
    if(context.kind(declaration) === 'VariableDeclaration' && context.kind(context.parent(declaration)) === 'CatchClause' && context.name(declaration) === index) { return 'error'; }
    for(let cursor = context.parent(index); cursor >= 0; cursor = context.parent(cursor)) {
        const owner = context.parent(cursor);
        if(owner < 0) { break; }
        const node = context.node(owner);
        const last = node.children[node.children.length - 1] ?? -1;
        if(node.kind === 'PropertyAssignment' && last === cursor) {
            const key = context.name(owner);
            if(key >= 0 && eventHandlerKeyPattern.test(context.node(key).text)) { return 'event'; }
        }
        if(node.kind === 'JsxExpression') {
            const attribute = context.parent(owner);
            if(context.kind(attribute) === 'JsxAttribute') {
                const key = context.child(attribute, 0);
                if(eventHandlerKeyPattern.test(context.node(key).text)) { return 'event'; }
            }
        }
        if(node.kind === 'VariableDeclaration' && last === cursor) {
            const binding = context.name(owner);
            if(binding >= 0 && context.kind(binding) === 'Identifier' && handlerNamePattern.test(context.node(binding).text)) { return 'event'; }
        }
        if(context.kind(cursor) === 'FunctionDeclaration') {
            const binding = context.name(cursor);
            if(binding >= 0 && handlerNamePattern.test(context.node(binding).text)) { return 'event'; }
        }
    }
    return 'unclear';
}

// foreignName is whether an identifier names something this file does not declare here: a property read
// through another object, a property or binding key, an import or export name, a qualified or type name
// part, or a JSX tag or attribute. The rule judges only names the file chose.
export function foreignName(context: RuleContext, index: number, node: ParseNode): boolean {
    const owner = context.parent(index);
    if(owner < 0) { return false; }
    const parent = context.node(owner);
    const first = parent.children[0] ?? -1;
    const last = parent.children[parent.children.length - 1] ?? -1;
    switch(parent.kind) {
        case 'PropertyAccessExpression': return last === index && context.kind(first) !== 'ThisKeyword';
        case 'PropertyAssignment':
        case 'PropertySignature': return context.name(owner) === index;
        case 'BindingElement':
            if(first !== index || parent.children.length < 2) { return false; }
            return context.scanAt(node.end) === 'ColonToken';
        case 'ImportSpecifier':
        case 'ExportSpecifier':
        case 'NamespaceImport':
        case 'ImportClause': return true;
        case 'QualifiedName': return last === index;
        case 'TypeReference': return first === index;
        case 'JsxOpeningElement':
        case 'JsxClosingElement':
        case 'JsxSelfClosingElement':
        case 'JsxAttribute': return true;
        default: return false;
    }
}
