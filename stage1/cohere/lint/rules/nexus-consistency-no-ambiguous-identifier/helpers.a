import type { RuleContext } from '../../context.ts';
// Shared regex table rows nexus/consistency_no_ambiguous_identifier.go:17-19.
// MatchString asks only for existence; no global iteration state is needed.
export const singleLowercaseLetter = /^[a-z](?![\s\S])/u;
const handlerNamePattern = /handle|on[A-Z]|event/iu;
const eventHandlerKeyPattern = /^on[A-Z]/u;
export function comparator(context: RuleContext, index: number): boolean {
    for(let cursor = context.parent(index); cursor >= 0; cursor = context.parent(cursor)) {
        const kind = context.kind(cursor);
        if(kind !== 'ArrowFunction' && kind !== 'FunctionExpression') { continue; }
        const call = context.parent(cursor);
        if(context.kind(call) !== 'CallExpression' || context.arguments(call)[0] !== cursor) { return false; }
        const callee = context.child(call, 0);
        return context.kind(callee) === 'PropertyAccessExpression' && context.node(context.property(callee)).text === 'sort';
    }
    return false;
}
export function eventContext(context: RuleContext, index: number): string {
    const declaration = context.parent(index);
    if(context.kind(declaration) === 'VariableDeclaration' && context.kind(context.parent(declaration)) === 'CatchClause' && context.name(declaration) === index) { return 'error'; }
    for(let cursor = context.parent(index); cursor >= 0; cursor = context.parent(cursor)) {
        const owner = context.parent(cursor);
        if(owner < 0) { break; }
        const node = context.node(owner);
        const last = node.children[node.children.length - 1] ?? -1;
        if(node.kind === 'PropertyAssignment' && last === cursor) {
            const key = context.name(owner);
            if(key >= 0 && eventHandlerKeyPattern.test(context.node(key).text)) { return 'event'; }
        }
        if(node.kind === 'JsxExpression') {
            const attribute = context.parent(owner);
            if(context.kind(attribute) === 'JsxAttribute') {
                const key = context.child(attribute, 0);
                if(eventHandlerKeyPattern.test(context.node(key).text)) { return 'event'; }
            }
        }
        if(node.kind === 'VariableDeclaration' && last === cursor) {
            const binding = context.name(owner);
            if(binding >= 0 && context.kind(binding) === 'Identifier' && handlerNamePattern.test(context.node(binding).text)) { return 'event'; }
        }
        if(context.kind(cursor) === 'FunctionDeclaration') {
            const binding = context.name(cursor);
            if(binding >= 0 && handlerNamePattern.test(context.node(binding).text)) { return 'event'; }
        }
    }
    return 'unclear';
}
