import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { exceedMessage } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    readonly maximum: number;
    readonly checkConstructorCallCallbacks: boolean;
    readonly depths = new Map<number, number>();
    constructor(context: RuleContext) {
        this.context = context;
        const maximum = context.settings.read('maximum', '');
        const max = context.settings.read('max', '');
        const option = context.settings.read('option', '');
        // Upstream resolves maximum || max: an explicit zero falls through to a nonzero max.
        this.maximum = maximum !== '' && Number(maximum) !== 0 ? Number(maximum) :
            max !== '' ? Number(max) : maximum !== '' ? Number(maximum) :
            option !== '' ? Number(option) : 10;
        this.checkConstructorCallCallbacks = context.settings.read('checkconstructorcallcallbacks', 'false') === 'true';
    }
    visit(node: ParseNode, index: number): void {
        let depth = 0;
        let ancestor = this.context.parent(index);
        while(ancestor >= 0) {
            const inherited = this.depths.get(ancestor);
            if(inherited !== undefined) {
                depth = inherited;
                break;
            }
            ancestor = this.context.parent(ancestor);
        }
        const parent = this.context.parent(index);
        if(parent >= 0) {
            const owner = this.context.node(parent);
            if(owner.children[0] !== index && (owner.kind === 'CallExpression' ||
                (owner.kind === 'NewExpression' && this.checkConstructorCallCallbacks))) {
                depth++;
                this.depths.set(index, depth);
                if(depth <= this.maximum) {
                    return;
                }
                this.reportHead(node, index, depth);
                return;
            }
        }
        // A stored function does not increase depth, but a callback inside it inherits the outer chain.
        this.depths.set(index, depth);
    }
    reportHead(node: ParseNode, index: number, depth: number): void {
        let start = this.context.start(index);
        let end = node.end;
        if(node.kind === 'ArrowFunction') {
            for(const part of node.children) {
                const child = this.context.node(part);
                if(child.kind === 'EqualsGreaterThanToken') {
                    start = this.context.start(part);
                    end = child.end;
                }
            }
        }
        else {
            let cursor = start;
            for(const part of node.children) {
                const child = this.context.node(part);
                if(child.kind === 'TypeParameter') {
                    cursor = child.end;
                }
                if(child.kind === 'Parameter') {
                    end = child.pos - 1;
                    break;
                }
            }
            let token = this.context.scanAt(cursor);
            while(token !== 'EndOfFile' && this.context.scanStart() < end) {
                if(token === 'OpenParenToken') {
                    end = this.context.scanStart();
                    break;
                }
                token = this.context.scanner.scan();
            }
        }
        this.context.reportRange(start, end, 'max-nested-callbacks', 'exceed', exceedMessage(depth, this.maximum));
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
