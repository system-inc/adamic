import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { initializer, enabled, commentsInside } from './helpers.a';
import { explanation } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        const context = this.context;
        const declarator = node.kind === 'VariableDeclaration';
        let left: number;
        let right: number;
        if(declarator) {
            const list = context.parent(index);
            if(list >= 0 && ['4', '6'].includes(context.node(list).semantic)) return;
            // Variable declarations put their binding first, including binding patterns.
            left = node.children[0] ?? -1;
            right = initializer(context, node, left);
        }
        else {
            if(context.node(node.children[1] ?? panic('operator')).kind !== 'EqualsToken') return;
            left = node.children[0] ?? -1;
            right = node.children[2] ?? -1;
        }
        if(right < 0) return;
        right = context.unwrap(right);
        const member = context.node(right);
        if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(member.kind) || context.has(right, 'QuestionDotToken')) return;
        const computed = member.kind === 'ElementAccessExpression';
        const property = member.children[member.children.length - 1] ?? panic('property');
        const receiver = member.children[0] ?? panic('receiver');
        if(context.kind(receiver) === 'SuperKeyword' || context.kind(property) === 'PrivateIdentifier') return;
        const key = context.node(property);
        // The scanner canonicalizes numeric text, just as typescript-go does.
        let array = computed && key.kind === 'NumericLiteral' && key.text !== '';
        if(array) {
            for(const character of key.text.split('')) {
                if(character < '0' || character > '9') array = false;
            }
        }
        if(!enabled(context, declarator, array)) return;
        if(!array && context.settings.read('enforceforrenamedproperties', 'false') !== 'true') {
            if(left < 0 || context.kind(left) !== 'Identifier' || context.node(left).text !== key.text ||
                (computed ? key.kind !== 'StringLiteral' : key.kind !== 'Identifier')) return;
        }
        let replacement = '';
        let repair = '';
        if(declarator && !computed && left >= 0 && context.kind(left) === 'Identifier' && key.kind === 'Identifier' && context.node(left).text === key.text) {
            const object = context.unwrap(receiver);
            if(commentsInside(context, context.start(index), node.end) <= commentsInside(context, context.start(object), context.node(object).end)) {
                let text = context.raw(object);
                const objectNode = context.node(object);
                if(objectNode.kind === 'BinaryExpression' && context.kind(objectNode.children[1] ?? -1) === 'CommaToken') text = `(${text})`;
                replacement = `{${key.text}} = ${text}`;
                repair = 'fix';
            }
        }
        context.report(index, 'prefer-destructuring', 'preferDestructuring', `Use ${array ? 'array' : 'object'} destructuring. ${explanation}`, repair, replacement, '');
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
