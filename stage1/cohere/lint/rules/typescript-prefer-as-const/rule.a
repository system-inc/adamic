import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';
import { Edit, Result, emptyResults, publish } from '../typescript-no-unnecessary-type-constraint/results.a';

export class Rule {
    readonly context: RuleContext;
    results: readonly Result[] = emptyResults();
    constructor(context: RuleContext) { this.context = context; }
    restates(type: number, initializer: number): boolean {
        if(type < 0 || initializer < 0 || this.context.node(type).kind !== 'LiteralType') { return false; }
        const literal = this.context.node(type).children[0] ?? -1;
        if(literal < 0) { return false; }
        const node = this.context.node(literal);
        return (node.kind === 'StringLiteral' || node.kind === 'NumericLiteral') && node.kind === this.context.node(initializer).kind && node.text === this.context.node(initializer).text;
    }
    evaluate(index: number): void {
        const node = this.context.node(index);
        const children = node.children;
        if(node.kind === 'AsExpression') {
            const initializer = children[0] ?? -1;
            const type = children[1] ?? -1;
            if(this.restates(type, initializer)) {
                const result = new Result(type, '@typescript-eslint/prefer-as-const', 'preferAsConst', message, [new Edit(this.context.start(type), this.context.node(type).end, 'const')]);
                this.results = [...this.results, result];
            }
            return;
        }
        if(node.kind !== 'VariableDeclaration' && node.kind !== 'PropertyDeclaration') { return; }
        for(const child of children) {
            if(this.context.node(child).kind === 'ExclamationToken' || this.context.node(child).kind === 'QuestionToken') { return; }
        }
        if(children.length < 3) { return; }
        const initializer = children[children.length - 1] ?? -1;
        const type = children[children.length - 2] ?? -1;
        const name = children[children.length - 3] ?? -1;
        if(!this.restates(type, initializer)) { return; }
        const edits: Edit[] = [];
        if(node.kind === 'PropertyDeclaration' || this.context.node(name).kind === 'Identifier') {
            const scanner = this.context.scanner;
            scanner.pos = this.context.node(name).end;
            scanner.scan();
            edits.push(new Edit(scanner.start, this.context.node(type).end, ''));
            edits.push(new Edit(this.context.node(initializer).end, this.context.node(initializer).end, ' as const'));
        }
        this.results = [...this.results, new Result(type, '@typescript-eslint/prefer-as-const', 'preferAsConst', message, edits)];
    }
    visit(index: number): void {
        const before = this.results.length;
        this.evaluate(index);
        for(let position = before; position < this.results.length; position++) {
            const result = this.results[position];
            if(result !== undefined) { publish(this.context, result); }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
