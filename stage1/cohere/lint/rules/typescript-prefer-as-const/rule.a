import type { RuleContext } from '../../context.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { Diagnostic, Edit, publish, requireRepairs } from '../typescript-no-unnecessary-type-constraint/records.a';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    readonly records: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    matches(type: number, value: number): boolean {
        if(type < 0 || value < 0 || this.context.node(type).kind !== 'LiteralType') { return false; }
        const literal = this.context.node(type).children[0] ?? -1;
        if(literal < 0) { return false; }
        const node = this.context.node(literal);
        return (node.kind === 'StringLiteral' || node.kind === 'NumericLiteral') && node.kind === this.context.node(value).kind && node.text === this.context.node(value).text;
    }
    visit(index: number): void {
        const node = this.context.node(index);
        if(node.kind === 'AsExpression') {
            const value = node.children[0] ?? -1;
            const type = node.children[1] ?? -1;
            if(!this.matches(type, value)) { return; }
            const record = new Diagnostic(this.context, type, '@typescript-eslint/prefer-as-const', 'preferAsConst', message);
            record.fixes.push(new Edit(record.start, record.end, 'const'));
            this.records.push(record);
            publish(this.context, type, record);
            return;
        }
        if(node.kind !== 'VariableDeclaration' && node.kind !== 'PropertyDeclaration') { return; }
        let name = -1;
        let type = -1;
        let value = -1;
        const scanner = new Scanner(this.context.source);
        for(const child of node.children) {
            const kind = this.context.node(child).kind;
            if(kind === 'QuestionToken' || kind === 'ExclamationToken') { return; }
            if(kind.endsWith('Keyword') && name < 0) { continue; }
            if(name < 0) { name = child; continue; }
            scanner.pos = this.context.node(name).end;
            if(type < 0 && scanner.scan() === 'ColonToken') { type = child; }
            else { value = child; }
        }
        if(!this.matches(type, value) || name < 0) { return; }
        const record = new Diagnostic(this.context, type, '@typescript-eslint/prefer-as-const', 'preferAsConst', message);
        if(node.kind === 'PropertyDeclaration' || this.context.node(name).kind === 'Identifier') {
            scanner.pos = this.context.node(name).end;
            scanner.scan();
            record.fixes.push(new Edit(scanner.start, this.context.node(type).end, ''));
            const end = this.context.node(value).end;
            record.fixes.push(new Edit(end, end, ' as const'));
        }
        this.records.push(record);
        publish(this.context, type, record);
    }
    finish(root: number): void { requireRepairs(this.records); }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
