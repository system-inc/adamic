import type { RuleContext } from '../../context.ts';
import { structureFileContext } from '../../helpers/structure_file_context.a';
import { noDirectFetchMessage } from './messages.a';
export class Rule {
 readonly context: RuleContext;
 readonly exempt: boolean;
 constructor(context: RuleContext) { this.context=context; this.exempt=structureFileContext(context.parser.path).isNetworkServiceFile; }
 visit(index: number): void {
  if(this.exempt) { return; }
  const callee=this.context.unwrap(this.context.child(index,0));
  let fetch=false;
  if(this.context.kind(callee) === 'Identifier') { fetch=this.context.node(callee).text === 'fetch'; }
  else if(this.context.kind(callee) === 'PropertyAccessExpression') {
   const name=this.context.property(callee);
   const object=this.context.unwrap(this.context.child(callee,0));
   fetch=this.context.node(name).text === 'fetch' && this.context.kind(object) === 'Identifier' && ['window','globalThis'].includes(this.context.node(object).text);
  }
  if(fetch) { this.context.report(index,'structure/network-no-direct-fetch','noDirectFetch',noDirectFetchMessage,'','',''); }
 }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
