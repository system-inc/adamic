export const hookResultNamingBadSuffix = "This hook result ends in a suffix that adds nothing. Result, Data, Value, State, and Hook describe the fact that it is a variable rather than what is in it. A hook's result carries its origin in its name or it carries nothing: twenty lines down, `data` says only that something was fetched, while `accountQuery` says which call produced it and where to look when it is wrong.";
export const hookResultNamingGeneric = "This hook result is named something generic. A hook's result carries its origin in its name or it carries nothing: twenty lines down, `data` says only that something was fetched, while `accountQuery` says which call produced it and where to look when it is wrong. Name it after the hook, or after what it holds.";
export const hookResultNamingMismatch = "This hook result's name has no relation to the hook that produced it. A hook's result carries its origin in its name or it carries nothing: twenty lines down, `data` says only that something was fetched, while `accountQuery` says which call produced it and where to look when it is wrong.";
