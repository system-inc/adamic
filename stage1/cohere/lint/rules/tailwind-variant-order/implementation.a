import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { OptionsJson } from '../../helpers/options_json.ts';
import { Surface, classes, prefix, segments, report } from '../tailwind-important-position/surface.a';
let completeFacts = false;
export function enableCompleteVariantFacts(): void { completeFacts = true; }
export function compare(left: number, right: number): number {
    if(left === right) { return 0; }
    if(left < 65536 && right < 65536) { return 0; }
    return right > left ? 1 : -1;
}
// The provider supplies resolved candidate ranks in written order, including
// Go's global flag. It supplies neither a sorted spelling nor a finding.
export function corrected(text: string, orders: readonly number[]): string {
    const parts = prefix(text); const before = parts[0] ?? ''; const root = parts[1] ?? '';
    if(before === '') { return ''; }
    const written = segments(before);
    if(written.length < 2 || written.length !== orders.length) { return ''; }
    const sorted = written.slice(); const ranks = orders.slice();
    for(let outer = 1; outer < sorted.length; outer++) {
        const variant = sorted[outer] ?? panic('missing variant'); const order = ranks[outer] ?? panic('missing rank');
        let inner = outer - 1;
        while(inner >= 0 && compare(ranks[inner] ?? panic('missing rank'),order) > 0) {
            sorted[inner + 1] = sorted[inner] ?? ''; ranks[inner + 1] = ranks[inner] ?? 0; inner--;
        }
        sorted[inner + 1] = variant; ranks[inner + 1] = order;
    }
    const result = sorted.join(':') + ':' + root;
    return result === text ? '' : result;
}
export class Listener {
    readonly context: RuleContext; readonly surface: Surface;
    readonly ranks = new Map<string,number[]>();
    readonly ready: boolean;
    constructor(context: RuleContext) {
        this.context = context; this.surface = new Surface(context);
        const json = new OptionsJson(context.settings.text === '' || context.settings.text === 'null' ? '{}' : context.settings.text);
        const root = json.parse(); const facts = json.field(root,'adamicVariantFacts');
        this.ready = completeFacts && facts >= 0;
        if(facts >= 0) {
            for(const fact of json.node(facts).children) {
                const name = json.node(json.field(fact,'class')).text;
                const orders: number[] = [];
                for(const order of json.node(json.field(fact,'orders')).children) { orders.push(Number(json.node(order).text)); }
                this.ranks.set(name,orders);
            }
        }
    }
    visit(index: number, parent: number): void {
        if(!this.ready) { panic('NotYet: shared Tailwind ProgramReads and resolved design-system adapter'); }
        for(const literal of this.surface.literals(index)) {
            for(const text of classes(this.context.node(literal).text)) {
                const orders = this.ranks.get(text);
                if(orders === undefined) { panic('NotYet: missing resolved Tailwind candidate'); }
                const replacement = corrected(text,orders); if(replacement === '') { continue; }
                const message = `The variants on "${text}" are written in an order Tailwind does not emit them in; it compiles to the same CSS as "${replacement}", which is the spelling the engine's own sort produces. Nothing breaks either way, and that is why the two spellings accumulate side by side until a reader cannot tell whether a difference between two class lists is meaningful. Write it as "${replacement}".`;
                report(this.context,literal,'better-tailwindcss/enforce-consistent-variant-order','variantOrder',message);
            }
        }
    }
}
