import { panic } from 'adamic';
import { RuleContext } from '../../context.ts';
const unsafe = 'This optional chain can evaluate to `undefined`, and the code around it then reaches into that `undefined` rather than short-circuiting with it. The `?.` protects only the links inside its own chain: once the chain ends, the result is an ordinary value and the next access, call, spread, or destructuring throws a TypeError. Either extend the chain so the whole expression short-circuits, or supply a fallback with `??`.';
const arithmeticMessage = 'This optional chain can evaluate to `undefined`, and arithmetic on `undefined` produces NaN rather than throwing. So this does not fail where the value is missing, it silently poisons every number computed from it, and the NaN surfaces somewhere far from the cause. Supply a fallback with `??` before doing arithmetic on it.';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    pattern(index: number): boolean { return index >= 0 && ['ObjectBindingPattern', 'ArrayBindingPattern', 'ObjectLiteralExpression', 'ArrayLiteralExpression'].includes(this.context.node(index).kind); }
    reaching(index: number, arithmetic: boolean): void {
        if(index < 0) { return; }
        const node = this.context.node(index);
        if(node.kind === 'TypeAssertionExpression') { this.reaching(node.children[1] ?? -1, arithmetic); return; }
        if(['ParenthesizedExpression','AsExpression','SatisfiesExpression','NonNullExpression','ExpressionWithTypeArguments','AwaitExpression'].includes(node.kind)) { this.reaching(node.children[0] ?? -1, arithmetic); return; }
        if(node.kind === 'ConditionalExpression') { this.reaching(node.children[2] ?? -1, arithmetic); this.reaching(node.children[4] ?? -1, arithmetic); return; }
        if(node.kind === 'BinaryExpression') {
            const operator = this.context.node(node.children[1] ?? panic('operator')).kind;
            if(operator === 'AmpersandAmpersandToken') { this.reaching(node.children[0] ?? -1, arithmetic); }
            if(['AmpersandAmpersandToken','BarBarToken','QuestionQuestionToken','CommaToken'].includes(operator)) { this.reaching(node.children[2] ?? -1, arithmetic); }
            return;
        }
        if(!node.optional) { return; }
        const parent = this.context.parents[index] ?? -1;
        if(parent >= 0) {
            const outer = this.context.node(parent);
            if(outer.optional && ['PropertyAccessExpression','ElementAccessExpression','CallExpression','NonNullExpression'].includes(outer.kind) && outer.children[0] === index) { return; }
        }
        this.context.report(index, 'no-unsafe-optional-chaining', arithmetic ? 'unsafeArithmetic' : 'unsafeOptionalChain', arithmetic ? arithmeticMessage : unsafe, '', '', '');
    }
    visit(index: number): void {
        const node = this.context.node(index);
        const first = node.children[0] ?? -1;
        const arithmetic = this.context.settings.read('disallowarithmeticoperators', 'false') === 'true';
        if(['PropertyAccessExpression','ElementAccessExpression','CallExpression'].includes(node.kind)) {
            for(const child of node.children) { if(this.context.node(child).kind === 'QuestionDotToken') { return; } }
            this.reaching(first, false); return;
        }
        if(['NewExpression','TaggedTemplateExpression','WithStatement','SpreadElement'].includes(node.kind)) { this.reaching(first, false); return; }
        if(node.kind === 'ForOfStatement') {
            const offset = first >= 0 && this.context.node(first).kind === 'AwaitKeyword' ? 2 : 1;
            this.reaching(node.children[offset] ?? -1, false); return;
        }
        if(node.kind === 'ClassDeclaration' || node.kind === 'ClassExpression') {
            for(const child of node.children) {
                const heritage = this.context.node(child);
                if(heritage.kind === 'HeritageClause' && heritage.operator === 'ExtendsKeyword') { this.reaching(heritage.children[0] ?? -1, false); return; }
            }
            return;
        }
        if(['VariableDeclaration','Parameter','BindingElement'].includes(node.kind)) {
            for(const child of node.children) {
                if(this.pattern(child)) {
                    const last = node.children[node.children.length - 1] ?? -1;
                    if(last !== child) { this.reaching(last, false); }
                    return;
                }
            }
            return;
        }
        if(node.kind === 'PrefixUnaryExpression') { if(arithmetic && ['PlusToken','MinusToken'].includes(node.operator)) { this.reaching(first, true); } return; }
        if(node.kind !== 'BinaryExpression') { return; }
        const operator = this.context.node(node.children[1] ?? panic('binary operator')).kind;
        const right = node.children[2] ?? -1;
        if(['InKeyword','InstanceOfKeyword'].includes(operator)) { this.reaching(right, false); }
        if(operator === 'EqualsToken' && this.pattern(first)) { this.reaching(right, false); return; }
        if(!arithmetic) { return; }
        if(['PlusToken','MinusToken','SlashToken','AsteriskToken','PercentToken','AsteriskAsteriskToken'].includes(operator)) { this.reaching(right, true); this.reaching(first, true); return; }
        if(['PlusEqualsToken','MinusEqualsToken','SlashEqualsToken','AsteriskEqualsToken','PercentEqualsToken','AsteriskAsteriskEqualsToken'].includes(operator)) { this.reaching(right, true); }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
