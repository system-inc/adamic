export function message(name: string): string { return `Expected \`this\` to be used by class ${name}. A method that never touches the instance is not really a method: it is a plain function that has been given privileged access it does not use, and every caller now needs an instance to reach it. Either use the instance, make it \`static\`, or move it out of the class entirely so its independence is visible at the call site.`; }
