import { panic } from 'adamic';
import type { Rules } from '../../../typeaware/rules.ts';
import { Bindings } from '../../../typeaware/bindings.ts';
import { Diagnostic } from '../../../typeaware/diagnostic.ts';
import { OutputCFG } from '../../../typeaware/wave_05_next/output_cfg.a';
import { OutputIdentity, loadRules } from '../../../typeaware/wave_05_next/output_identity.a';
import type { OutputDeclaration } from '../../../typeaware/wave_05_next/output_symbol.a';
import { RuntimeModules, streamSuffixes } from '../../../typeaware/wave_05_next/runtime_modules.a';
import { withChain, writeChain } from '../../../typeaware/wave_05_next/no_process_exit_after_output.a';
const emptyEdges: readonly string[] = [];
const functionKinds = [
    'FunctionDeclaration',
    'FunctionExpression',
    'ArrowFunction',
    'MethodDeclaration',
    'Constructor',
    'GetAccessor',
    'SetAccessor',
];
const callKinds = ['CallExpression', 'NewExpression', 'TaggedTemplateExpression'];
class Started {
    readonly runs: number[] = [];
    readonly handsOn: number[] = [];
    argumentsMayBlock = false;
}
class Position {
    readonly block: number;
    readonly state: readonly string[];
    constructor(block: number, state: readonly string[]) {
        this.block = block;
        this.state = state;
    }
}
class RootResult {
    readonly exits: number[] = [];
    readonly started: number[] = [];
}
// Pinned typescript-go SyntaxKind values for the shared kind-indexed driver.
export const listenerKinds: readonly number[] = [307];
export class RequireBlockingStandardStreams {
    readonly rules: Rules;
    readonly bindings: Bindings;
    readonly identity: OutputIdentity;
    readonly modules: RuntimeModules;
    readonly functionMayBlock = new Map<string, number>();
    readonly foreign = new Map<string, Rules>();
    readonly ordered: boolean;
    constructor(rules: Rules, bindings: Bindings, identity: OutputIdentity, modules: RuntimeModules) {
        this.rules = rules;
        this.bindings = bindings;
        this.identity = identity;
        this.modules = modules;
        this.ordered = modules.canBlock.has(rules.path);
    }
    body(index: number, identity: OutputIdentity): number {
        const node = identity.rules.parser.node(index);
        if(!functionKinds.includes(node.kind)) {
            return -1;
        }
        const block = node.children.find((child) => identity.rules.parser.node(child).kind === 'Block') ?? -1;
        if(block >= 0) {
            return block;
        }
        if(node.kind === 'ArrowFunction') {
            return node.children[node.children.length - 1] ?? -1;
        }
        return -1;
    }
    functionWithBody(index: number, identity: OutputIdentity): boolean {
        return this.body(index, identity) >= 0;
    }
    arguments(index: number, identity: OutputIdentity): number[] {
        const node = identity.rules.parser.node(index);
        return ['CallExpression', 'NewExpression'].includes(node.kind) && node.list > 0
            ? node.children.slice(node.children.length - node.list)
            : [];
    }
    declarationIndex(d: OutputDeclaration, rules: Rules): number {
        for(let at = 0; at < rules.parser.nodes.length; at++) {
            const node = rules.parser.node(at);
            if(node.kind === d.kind && rules.byte(node.pos) === d.start && rules.byte(node.end) === d.end) {
                return at;
            }
        }
        panic('blocking declaration absent from native tree');
    }
    foreignIdentity(file: string): OutputIdentity {
        let rules = this.rules;
        if(file !== rules.path) {
            if(!this.foreign.has(file)) {
                this.foreign.set(file, loadRules(rules.program, file, rules));
            }
            rules = this.foreign.get(file) ?? panic('missing foreign blocking source');
        }
        const bindings = new Bindings(rules);
        return new OutputIdentity(rules, bindings);
    }
    callMayBlock(index: number, identity: OutputIdentity): boolean {
        const node = identity.rules.parser.node(index);
        if(!callKinds.includes(node.kind)) {
            return false;
        }
        const callee = identity.rules.skip(node.children[0] ?? -1);
        const expression = identity.rules.parser.node(callee);
        if(node.kind === 'CallExpression' && expression.kind === 'ImportKeyword') {
            return true;
        }
        for(const argument of this.arguments(index, identity)) {
            if(this.handsOnMayBlock(argument, identity)) {
                return true;
            }
        }
        if(['FunctionExpression', 'ArrowFunction'].includes(expression.kind)) {
            return this.mayBlockWhenRun(callee, identity);
        }
        let name = -1;
        if(expression.kind === 'Identifier') {
            name = callee;
        }
        else if(expression.kind === 'PropertyAccessExpression') {
            name = expression.children[expression.children.length - 1] ?? -1;
        }
        else {
            return true;
        }
        return this.symbolMayBlock(name, identity);
    }
    handsOnMayBlock(index: number, identity: OutputIdentity): boolean {
        const value = identity.rules.skip(index);
        const node = identity.rules.parser.node(value);
        if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) {
            return this.mayBlockWhenRun(value, identity);
        }
        if(node.kind !== 'Identifier') {
            return false;
        }
        const symbol = identity.symbol(value);
        return symbol.present && (symbol.flags & 16) !== 0 && this.symbolMayBlock(value, identity);
    }
    symbolMayBlock(name: number, identity: OutputIdentity): boolean {
        const symbol = identity.symbol(name);
        if(!symbol.present || symbol.declarations.length === 0) {
            return true;
        }
        return symbol.declarations.some((d) => this.declarationMayBlock(d, name, identity));
    }
    declarationMayBlock(d: OutputDeclaration, name: number, identity: OutputIdentity): boolean {
        if(!this.modules.canBlock.has(d.file)) {
            return d.declarationFile && identity.rules.parser.node(name).text === 'require';
        }
        if(d.declarationFile) {
            return true;
        }
        const target = this.foreignIdentity(d.file);
        const index = this.declarationIndex(d, target.rules);
        const node = target.rules.parser.node(index);
        if(
            node.kind === 'FunctionDeclaration' &&
            target.rules.parser.node(target.bindings.shape.name(index)).text === 'blockStandardStreams' &&
            streamSuffixes.some((suffix) => d.file.endsWith(suffix))
        ) {
            return true;
        }
        if(
            ['FunctionDeclaration', 'MethodDeclaration', 'Constructor', 'GetAccessor', 'SetAccessor'].includes(
                node.kind,
            )
        ) {
            if(this.body(index, target) < 0) {
                return node.kind !== 'FunctionDeclaration' || (d.flags & 8388608) !== 0;
            }
            return this.mayBlockWhenRun(index, target);
        }
        if(node.kind === 'VariableDeclaration') {
            const initial = target.bindings.shape.initializer(index);
            if(initial >= 0) {
                const value = target.rules.skip(initial);
                if(['FunctionExpression', 'ArrowFunction'].includes(target.rules.parser.node(value).kind)) {
                    return this.mayBlockWhenRun(value, target);
                }
            }
        }
        if(['ClassDeclaration', 'ClassExpression'].includes(node.kind)) {
            return this.mayBlockWhenRun(index, target);
        }
        return true;
    }
    scanMayBlock(index: number, identity: OutputIdentity): boolean {
        if(callKinds.includes(identity.rules.parser.node(index).kind) && this.callMayBlock(index, identity)) {
            return true;
        }
        return identity.rules.parser.node(index).children.some((child) => this.scanMayBlock(child, identity));
    }
    mayBlockWhenRun(index: number, identity: OutputIdentity): boolean {
        const key = `${identity.rules.path}:${index}`;
        const cached = this.functionMayBlock.get(key) ?? 0;
        if(cached !== 0) {
            return cached === 1;
        }
        this.functionMayBlock.set(key, 3);
        const answer = identity.rules.parser.node(index).children.some((child) => this.scanMayBlock(child, identity));
        this.functionMayBlock.set(key, answer ? 1 : 2);
        return answer;
    }
    localFunction(index: number): number {
        const value = this.rules.skip(index);
        const node = this.rules.parser.node(value);
        if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) {
            return value;
        }
        if(node.kind !== 'Identifier') {
            return -1;
        }
        const symbol = this.identity.symbol(value, false);
        for(const d of symbol.declarations) {
            if(d.file !== this.rules.path) {
                continue;
            }
            const declaration = this.declarationIndex(d, this.rules);
            if(d.kind === 'FunctionDeclaration' && this.body(declaration, this.identity) >= 0) {
                return declaration;
            }
            if(d.kind === 'VariableDeclaration') {
                const list = this.rules.parser.node(this.bindings.parent(declaration));
                const initial = this.bindings.shape.initializer(declaration);
                if(
                    list.kind !== 'VariableDeclarationList' ||
                    (Number.parseInt(list.semantic, 10) & 2) === 0 ||
                    initial < 0
                ) {
                    continue;
                }
                const function_ = this.rules.skip(initial);
                if(['FunctionExpression', 'ArrowFunction'].includes(this.rules.parser.node(function_).kind)) {
                    return function_;
                }
            }
        }
        return -1;
    }
    startedFunctions(index: number): Started {
        const node = this.rules.parser.node(index);
        const result = new Started();
        if(node.kind !== 'NewExpression') {
            const function_ = this.localFunction(node.children[0] ?? -1);
            if(function_ >= 0) {
                if(
                    this.rules.parser
                        .node(function_)
                        .children.some((child) => this.rules.parser.node(child).kind === 'AsteriskToken')
                ) {
                    result.handsOn.push(function_);
                }
                else {
                    result.runs.push(function_);
                }
            }
        }
        for(const argument of this.arguments(index, this.identity)) {
            const function_ = this.localFunction(argument);
            if(function_ >= 0) {
                result.handsOn.push(function_);
            }
        }
        result.argumentsMayBlock =
            this.ordered &&
            result.runs.length > 0 &&
            this.arguments(index, this.identity).some((argument) => this.argumentBlocks(argument));
        return result;
    }
    argumentBlocks(index: number): boolean {
        if(this.functionWithBody(index, this.identity)) {
            return false;
        }
        const node = this.rules.parser.node(index);
        if(
            node.kind === 'AwaitExpression' ||
            (callKinds.includes(node.kind) && this.callMayBlock(index, this.identity))
        ) {
            return true;
        }
        return node.children.some((child) => this.argumentBlocks(child));
    }
    inRunOf(index: number, root: number): boolean {
        let parent = this.bindings.parent(index);
        while(parent >= 0 && parent !== root) {
            if(this.functionWithBody(parent, this.identity)) {
                return false;
            }
            parent = this.bindings.parent(parent);
        }
        return true;
    }
    topLevelMayBlock(index: number, identity: OutputIdentity): boolean {
        if(this.functionWithBody(index, identity)) {
            return false;
        }
        const node = identity.rules.parser.node(index);
        if(callKinds.includes(node.kind) && this.callMayBlock(index, identity)) {
            return true;
        }
        return node.children.some((child) => this.topLevelMayBlock(child, identity));
    }
    importsBlockAtLoad(): boolean {
        const queue: string[] = [this.rules.path];
        const seen: string[] = [this.rules.path];
        let at = 0;
        while(at < queue.length) {
            const file = queue[at] ?? panic('missing module');
            at++;
            for(const next of this.modules.edges.get(file) ?? emptyEdges) {
                if(seen.includes(next)) {
                    continue;
                }
                seen.push(next);
                queue.push(next);
                if(!this.modules.canBlock.has(next)) {
                    continue;
                }
                if(this.modules.declarationFiles.get(next) ?? true) {
                    return true;
                }
                const identity = this.foreignIdentity(next);
                const root = identity.rules.parser.nodes.length - 1;
                if(this.topLevelMayBlock(root, identity)) {
                    return true;
                }
            }
        }
        return false;
    }
    analyzeRoot(root: number): RootResult {
        const result = new RootResult();
        const events = new Map<number, readonly number[]>();
        const starts = new Map<number, Started>();
        const recorded: number[] = [];
        const graph = new OutputCFG(this.rules, this.bindings, events);
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at);
            if(graph.root(at) !== root) {
                continue;
            }
            const kinds: number[] = [];
            if(node.kind === 'Block' && this.rules.parser.node(this.bindings.parent(at)).kind === 'CatchClause') {
                kinds.push(2);
            }
            if(this.ordered) {
                const forAwait =
                    node.kind === 'ForOfStatement' &&
                    node.children.some((child) => this.rules.parser.node(child).kind === 'AwaitKeyword');
                const awaitUsing =
                    node.kind === 'VariableStatement' &&
                    node.children.some(
                        (child) =>
                            this.rules.parser.node(child).kind === 'VariableDeclarationList' &&
                            (Number.parseInt(this.rules.parser.node(child).semantic, 10) & 6) === 6,
                    );
                if(forAwait || awaitUsing) {
                    kinds.push(4);
                }
            }
            if(!this.identity.inCatchBinding(at, root)) {
                if(node.kind === 'AwaitExpression' && this.ordered) {
                    recorded.push(at);
                    kinds.push(4);
                }
                else if(callKinds.includes(node.kind)) {
                    if(node.kind === 'CallExpression' && this.identity.isExit(at)) {
                        recorded.push(at);
                        kinds.push(1);
                    }
                    else {
                        if(
                            node.kind === 'CallExpression' &&
                            this.identity.isWrite(at) &&
                            !this.identity.holdsExit(at)
                        ) {
                            kinds.push(0);
                        }
                        const started = this.startedFunctions(at);
                        if(started.runs.length > 0 || started.handsOn.length > 0) {
                            starts.set(at, started);
                            kinds.push(3);
                        }
                        if(this.ordered && this.callMayBlock(at, this.identity)) {
                            recorded.push(at);
                            kinds.push(4);
                        }
                    }
                }
            }
            if(kinds.length > 0) {
                events.set(at, kinds);
            }
        }
        graph.analyze(root);
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at);
            if(
                node.kind === 'CallExpression' &&
                graph.root(at) === root &&
                this.identity.isExit(at) &&
                !graph.blocks.some((block) => block.index === at && block.symbol === 1)
            ) {
                return result;
            }
            if(
                this.ordered &&
                this.inRunOf(at, root) &&
                this.bindings.contains(root, at) &&
                (node.kind === 'AwaitExpression' ||
                    (callKinds.includes(node.kind) && this.callMayBlock(at, this.identity))) &&
                !graph.blocks.some((block) => block.index === at && (block.symbol === 1 || block.symbol === 4))
            ) {
                return result;
            }
        }
        const visited = new Map<string, boolean>();
        visited.set('0:', true);
        const queue: Position[] = [new Position(0, [])];
        let at = 0;
        while(at < queue.length) {
            const position = queue[at] ?? panic('missing stream position');
            at++;
            const block = graph.blocks[position.block] ?? panic('missing stream block');
            let state = position.state;
            if(block.symbol === 0) {
                state = withChain(state, writeChain(this.rules, root, block.index));
            }
            else if(block.symbol === 2) {
                const tried = this.bindings.parent(this.bindings.parent(block.index));
                state = state.filter((held) => !held.includes(`,${tried},`));
            }
            else if(block.symbol === 3) {
                const started = starts.get(block.index) ?? panic('missing started functions');
                if(!started.argumentsMayBlock) {
                    for(const function_ of started.runs) {
                        if(!result.started.includes(function_)) {
                            result.started.push(function_);
                        }
                    }
                }
                if(!this.ordered) {
                    for(const function_ of started.handsOn) {
                        if(!result.started.includes(function_)) {
                            result.started.push(function_);
                        }
                    }
                }
            }
            else if(block.symbol === 1) {
                if(state.length > 0 && !result.exits.includes(block.index)) {
                    result.exits.push(block.index);
                }
                continue;
            }
            else if(block.symbol === 4) {
                continue;
            }
            const key = state.join('|');
            for(const next of block.successors) {
                const visit = `${next}:${key}`;
                if(!(graph.blocks[next]?.reachable ?? false) || visited.has(visit)) {
                    continue;
                }
                visited.set(visit, true);
                queue.push(new Position(next, state));
            }
        }
        return result;
    }
    run(root: number): void {
        const shebang = this.rules.scanner.text.startsWith('#!');
        if(!shebang && this.modules.imported.has(this.rules.path)) {
            return;
        }
        if(this.ordered && this.importsBlockAtLoad()) {
            return;
        }
        const queue: number[] = [root];
        const queued: number[] = [root];
        const exits: number[] = [];
        let at = 0;
        while(at < queue.length) {
            const next = queue[at] ?? panic('missing started root');
            at++;
            const result = this.analyzeRoot(next);
            for(const exit of result.exits) {
                if(!exits.includes(exit)) {
                    exits.push(exit);
                }
            }
            for(const function_ of result.started) {
                if(!queued.includes(function_)) {
                    queued.push(function_);
                    queue.push(function_);
                }
            }
        }
        if(exits.length === 0) {
            return;
        }
        exits.sort((left, right) => this.rules.parser.node(left).pos - this.rules.parser.node(right).pos);
        const reason = shebang ? 'it starts with `#!`' : 'nothing in the program imports it';
        const count = exits.length > 1 ? `, the first of ${exits.length} such exits in this file` : '';
        const message = `This file runs as a process (${reason}), and this \`process.exit()\` runs after a write to stdout or stderr before the process has called \`blockStandardStreams()\`${count}. Node writes to a pipe asynchronously, and \`process.exit()\` does not wait: a reader piping this process gets the output cut off (measured: 65,536 of 1 MiB), with exit status 0 and no error. Call Nexus's \`blockStandardStreams()\` (\`source/system/StandardStreams\`) before anything that can exit: first in the module, or first in the main it runs.`;
        const node = this.rules.parser.node(exits[0] ?? -1);
        this.rules.findings.push(
            new Diagnostic(
                'nexus/correctness-require-blocking-standard-streams',
                'exitBeforeBlockingStandardStreams',
                message,
                this.rules.byte(this.rules.start(node)),
                this.rules.byte(node.end),
                '',
            ),
        );
    }
}
export function blockingCandidate(rules: Rules, bindings: Bindings, identity: OutputIdentity): boolean {
    if(!rules.scanner.text.includes('exit')) {
        return false;
    }
    const events = new Map<number, readonly number[]>();
    const graph = new OutputCFG(rules, bindings, events);
    const exits: number[] = [];
    const writes: number[] = [];
    for(let at = 0; at < rules.parser.nodes.length; at++) {
        if(rules.parser.node(at).kind !== 'CallExpression') {
            continue;
        }
        const root = graph.root(at);
        if(identity.isExit(at)) {
            exits.push(root);
            if(writes.includes(root)) {
                return true;
            }
        }
        else if(identity.isWrite(at)) {
            writes.push(root);
            if(exits.includes(root)) {
                return true;
            }
        }
    }
    return false;
}
