import { isDocumentFile } from '../../helpers/nextjs/is_document_file.a';
import { exportNodeView } from '../../helpers/module/node_view.a';
import { IsExported } from '../../helpers/module/is_exported.a';
import { stringAttributeValue } from '../../helpers/jsx/string_attribute_value.a';
import type { JsxValueNode } from '../../helpers/jsx/string_attribute_value.a';
import { matchExactly } from '../../helpers/jsx/match_exactly.a';
import type { RuleContext } from '../../context.ts';
import { JsxArena } from '../../helpers/jsx/ast.a';
import { elementParts } from '../../helpers/jsx/element_parts.a';
import { isIntrinsicElementNamed } from '../../helpers/jsx/intrinsic_element_named.a';
import { messageNoPageCustomFontNotInDocument, messageNoPageCustomFontOutsideDefaultExport } from './messages.a';

export class Rule {
 readonly context: RuleContext;
 readonly defaultNames: string[] = [];
 readonly nodes: JsxValueNode[] = [];
 readonly arena: JsxArena;
 constructor(context: RuleContext) { this.context = context; this.arena = new JsxArena(this.nodes); }
 prepare(root: number): void {
  for (const statement of this.context.node(root).children) {
   if (this.context.kind(statement) !== 'ExportAssignment' || this.context.node(statement).semantic === '1') { continue; }
   const expression = this.context.unwrap(this.context.child(statement,0));
   if (this.context.kind(expression) === 'Identifier') { this.defaultNames.push(this.context.node(expression).text); }
  }
  // Project structural parser facts once. Node identities remain the parser's numeric indices.
  for (const node of this.context.parser.nodes) {
   let attributes = -1;
   if (node.kind === 'JsxOpeningElement' || node.kind === 'JsxSelfClosingElement') {
    for (const child of node.children) {
     if (this.context.node(child).kind === 'JsxAttributes') { attributes = child; }
    }
   }
   this.nodes.push({kind:node.kind,text:node.text,initializer:node.kind === 'JsxAttribute' ? node.children[1] ?? -1 : -1,name:node.kind === 'JsxAttribute' ? node.children[0] ?? -1 : -1,
    tagName:node.kind === 'JsxOpeningElement' || node.kind === 'JsxSelfClosingElement' ? node.children[0] ?? -1 : -1,
    attributes:attributes,properties:node.kind === 'JsxAttributes' ? node.children : [],propertiesPresent:node.kind === 'JsxAttributes'});
  }
 }
 visit(index: number): void {
  const parts = elementParts(this.arena,index);
  const tag = parts.tagName < 0 ? undefined : this.nodes[parts.tagName];
  if (tag === undefined || !isIntrinsicElementNamed(parts.tagName,tag.kind,tag.text,'link')) { return; }
  const href = stringAttributeValue(this.nodes,parts.attributes,'href',matchExactly);
  if (!href.found) { return; }
  if (!href.value.startsWith('https://fonts.googleapis.com/css')) { return; }
  if (!isDocumentFile(this.context.parser.path)) {
   this.context.report(index,'@next/next/no-page-custom-font','noPageCustomFontNotInDocument',messageNoPageCustomFontNotInDocument,'','','');
   return;
  }
  for (let ancestor = this.context.parent(index); ancestor >= 0; ancestor = this.context.parent(ancestor)) {
   const node = this.context.node(ancestor);
   if (node.kind === 'ExportAssignment' && node.semantic !== '1') { return; }
   const view = exportNodeView(this.context.parser,ancestor);
   if (IsExported(view) && view.modifiers.tags.includes('default-keyword')) { return; }
   if (!['FunctionDeclaration','FunctionExpression','ClassDeclaration','ClassExpression','ArrowFunction'].includes(node.kind)) { continue; }
   let name = node.kind === 'ArrowFunction' ? -1 : this.context.name(ancestor);
   if (name < 0) {
    const parent = this.context.parent(ancestor);
    if (this.context.kind(parent) === 'VariableDeclaration') { name = this.context.child(parent,0); }
   }
   if (this.context.kind(name) === 'Identifier' && this.defaultNames.includes(this.context.node(name).text)) { return; }
  }
  this.context.report(index,'@next/next/no-page-custom-font','noPageCustomFontOutsideDefaultExport',messageNoPageCustomFontOutsideDefaultExport,'','','');
 }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
