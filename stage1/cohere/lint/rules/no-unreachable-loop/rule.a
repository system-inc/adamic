import type { RuleContext } from '../../context.ts';
import { Build } from '../../helpers/control_flow_graph/build.a';
import { IndexRoots } from '../../helpers/control_flow_graph/index_roots.a';
import type { Builder,Hooks } from '../../helpers/control_flow_graph/builder.a';
import type { AstNode } from '../../helpers/control_flow_graph/ast.a';
import { fromContext } from './adapter.a';
import { message } from './messages.a';
const emptyIgnore: string[]=[];
function loopName(kind: string): string {if(kind==='DoStatement')return 'DoWhileStatement';if(kind==='WhileStatement'||kind==='ForStatement'||kind==='ForInStatement'||kind==='ForOfStatement')return kind;return '';}
class LoopStates {
 readonly context: RuleContext;readonly ignore: readonly string[];readonly reachable: boolean[]=[];readonly iterates: boolean[]=[];
 constructor(context: RuleContext) {this.context=context;this.ignore=context.settings.list('ignore',emptyIgnore);for(const node of context.parser.nodes){this.reachable.push(false);this.iterates.push(false);}}
 statement(b: Builder,node: AstNode | undefined): void {if(node===undefined)return;const name=loopName(node.Kind);if(name===''||this.ignore.includes(name))return;if(b.block(b.Current()).Reachable)this.reachable[node.index]=true;}
 loop(b: Builder,node: AstNode | undefined): void {if(node!==undefined&&b.block(b.Current()).Reachable)this.iterates[node.index]=true;}
}
export class Rule {
 readonly context: RuleContext;
 constructor(context: RuleContext){this.context=context;}
 visit(index: number): void {
 const ast=fromContext(this.context);const states=new LoopStates(this.context);
 const hooks: Hooks={Expression:undefined,Read:undefined,Write:undefined,Statement:(b: Builder,node: AstNode | undefined): void=>states.statement(b,node),Loop:(b: Builder,node: AstNode | undefined): void=>states.loop(b,node)};
 for(const summary of IndexRoots(ast,ast.read(index))){if(!summary.Loops.some((kind)=>!states.ignore.includes(loopName(kind))))continue;const graph=Build(ast,summary.Node,hooks);graph.arena.dispose();}
 const findings: number[]=[];for(let i=0;i<states.reachable.length;i++)if((states.reachable[i] ?? false)&&!(states.iterates[i] ?? false))findings.push(i);
 findings.sort((a,b)=>this.context.node(a).pos-this.context.node(b).pos);
 for(const loop of findings)this.context.report(loop,'no-unreachable-loop','invalid',message,'','','');
 }
}
export function create(context: RuleContext): Rule {return new Rule(context);}
