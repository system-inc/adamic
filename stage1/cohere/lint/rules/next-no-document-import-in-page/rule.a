import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    readonly document: boolean;
    constructor(context: RuleContext) {
        this.context = context;
        const path = context.parser.path;
        const last = path.lastIndexOf('pages');
        const page = last < 0 ? path : path.slice(last + 5);
        this.document = page.startsWith('/_document') || page.startsWith('\\_document');
    }
    visit(index: number): void {
        if(this.document) { return; }
        const context = this.context;
        for(const child of context.node(index).children) {
            const node = context.node(child);
            if(node.kind === 'StringLiteral' && node.text === 'next/document') {
                context.report(index, '@next/next/no-document-import-in-page', 'noDocumentImportInPage', message, '', '', '');
                return;
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
