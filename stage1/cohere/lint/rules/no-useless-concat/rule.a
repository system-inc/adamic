import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { messageUnexpectedConcat } from './messages.a';

// Only descendant expressions need a kind check; the driver hands visit a binary expression.
function concatenation(context: RuleContext, index: number): boolean {
    const node = context.node(index);
    return node.kind === 'BinaryExpression' && context.node(node.children[1] ?? panic('binary expression without operator')).kind === 'PlusToken';
}
function literal(context: RuleContext, index: number): boolean {
    const node = context.node(index);
    return node.kind === 'StringLiteral' || node.kind === 'NoSubstitutionTemplateLiteral' || node.kind === 'TemplateExpression';
}
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        const context = this.context;
        const operator = node.children[1] ?? panic('binary expression without operator');
        const operatorNode = context.node(operator);
        if(operatorNode.kind !== 'PlusToken') { return; }
        let left = context.unwrap(node.children[0] ?? panic('binary expression without left operand'));
        let right = context.unwrap(node.children[2] ?? panic('binary expression without right operand'));
        while(concatenation(context, left)) { left = context.unwrap(context.child(left, 2)); }
        while(concatenation(context, right)) { right = context.unwrap(context.child(right, 0)); }
        if(!literal(context, left) || !literal(context, right)) { return; }
        const gap = context.source.slice(context.node(left).end, context.start(right));
        if(gap.includes('\n') || gap.includes('\r')) { return; }
        context.reportRange(context.start(operator), operatorNode.end, 'no-useless-concat', 'unexpectedConcat', messageUnexpectedConcat);
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
