import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { legacy, publish } from '../require-await/compatibility.a';
import type { Rules } from '../../../typeaware/rules.ts';
import { NoUnnecessaryTypeParameters } from './algorithm.a';
export class Rule {
    readonly context: RuleContext;
    view: Rules | undefined = undefined;
    rule: NoUnnecessaryTypeParameters | undefined = undefined;
    constructor(context: RuleContext) { this.context = context; }
    prepare(root: number): void {
        const rules = legacy(this.context); this.view = rules;
        this.rule = new NoUnnecessaryTypeParameters(rules);
    }
    visit(node: ParseNode, index: number): void { if(this.rule !== undefined) { this.rule.check(index, node); } }
