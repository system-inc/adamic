import { Tree } from './tree.a';
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { RegexStructure, Group } from './regex_structure.a';
import { RegExpReferences } from './regexp_references.a';
import { panic } from 'adamic';
export class Rule {
 readonly tree: Tree;readonly references: RegExpReferences;
 constructor(context: RuleContext){const tree=new Tree(context);this.tree=tree;this.references=new RegExpReferences(tree);}
 reason(id: string): string{
  if(id==='nested'){return 'encloses the reference and so has captured nothing yet when it is reached';}
  if(id==='disjunctive'){return 'sits in a different branch of the same disjunction, and only one branch ever runs';}
  if(id==='forward'){return 'appears later in the pattern, and matching runs left to right';}
  if(id==='backward'){return 'appears earlier in a lookbehind, which matches right to left';}
  return 'sits in a negative lookaround, so it only runs on a path that then fails';
 }
 pattern(index: number,pattern: string,flags: string): void{
  const structure=new RegexStructure(pattern,flags);if(!structure.scan() || !structure.wellFormed()){return;}
  for(const ref of structure.references){const groups=structure.resolve(ref);if(groups.length===0){continue;}const all: Group[]=[];const same: Group[]=[];let reachable=false;
   for(const group of groups){const id=structure.classify(ref,group);if(id===''){reachable=true;break;}all.push(group);if(id!=='disjunctive'){same.push(group);}}
   if(reachable){continue;}const report=same.length>0?same:all;const first=report[0]??panic('missing backreference group');const id=structure.classify(ref,first);const others=report.length-1;const also=others===1?' (and so does one other group of that name)':others>1?` (and so do ${others} other groups of that name)`:'';
   const message=`The backreference ${pattern.slice(ref.start,ref.end)} can never match, because ${pattern.slice(first.start,first.end)} ${this.reason(id)}${also}. It matches the empty string instead of failing, so the pattern quietly matches more than it looks like it does.`;
   const t=this.tree;const node=t.rules.parser.node(index);t.rules.context.reportNode(index,'no-useless-backreference',id,message);
  }
 }
 visit(node: ParseNode,index: number): void{
  const t=this.tree;
  for(let at=0;at<t.rules.parser.nodes.length;at++){if(t.parent(at)<0 || t.kind(at)!=='RegularExpressionLiteral'){continue;}const text=t.rules.parser.node(at).text;const slash=text.lastIndexOf('/');const pattern=slash<1?text.slice(1):text.slice(1,slash);if(pattern!==''){this.pattern(at,pattern,slash<1?'':text.slice(slash+1));}}
  if(!t.rules.parser.scanner.text.includes('RegExp')){return;}
  for(const call of this.references.calls()){const args=t.args(call);const pattern=this.references.constant(args[0]??-1);if(!pattern.valid){continue;}const flags=this.references.constant(args[1]??-1);this.pattern(call,pattern.text,flags.valid?flags.text:'');}
 }
}

export function create(context: RuleContext): Rule {return new Rule(context);}
