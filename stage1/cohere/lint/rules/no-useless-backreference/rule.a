import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { CheckedJudgments } from '../no-global-assign/context.a';
import { NoUselessBackreference } from '../../../typeaware/no_useless_backreference.a';
import { Bindings } from '../../../typeaware/bindings.ts';
import { NexusFacts } from '../../../typeaware/nexus_facts.a';
import { Reassign } from '../../../typeaware/reassign.ts';
import { FourthFacts } from '../../../typeaware/fourth_facts.a';
import { RegexpReferences } from '../../../typeaware/regexp_references.a';
export class Rule {
    readonly context: RuleContext;
    checked: CheckedJudgments | undefined = undefined;
