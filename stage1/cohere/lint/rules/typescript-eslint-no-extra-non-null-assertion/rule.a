import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { RuleContext } from '../../context.ts';
import { Diagnostic, Edit, report } from '../typescript-eslint-no-extra-non-null-assertion/repairs.a';
function optionalRoot(context: RuleContext, receiver: number): boolean {
    context.scanner.pos = context.node(receiver).end;
    context.scanner.scan();
    return context.scanner.kind === 'QuestionDotToken';
}
const message = 'This non-null assertion is redundant: the value it asserts on has already been asserted non-null, or is about to be checked at runtime by the `?.` that follows it. Either way the second `!` narrows nothing the first one did not, so it is noise that reads as a claim. Remove it.';
export class Rule {
    readonly context: RuleContext;
    readonly diagnostics: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        let outer = index;
        let parent = this.context.parents[outer] ?? -1;
        while(parent >= 0 && this.context.node(parent).kind === 'ParenthesizedExpression') {
            outer = parent; parent = this.context.parents[outer] ?? -1;
        }
        if(parent < 0) { return; }
        const above = this.context.node(parent);
        const optional = optionalRoot(this.context, outer) && above.children[0] === outer && (above.kind === 'PropertyAccessExpression' || above.kind === 'ElementAccessExpression' || above.kind === 'CallExpression');
        if(above.kind === 'NonNullExpression' || optional) {
            this.diagnostics.push(report(this.context, node, 'noExtraNonNullAssertion', message, [new Edit(node.end - 1, node.end, '')], [], '@typescript-eslint/no-extra-non-null-assertion'));
        }
    }
}
export function create(context: RuleContext): Rule {
    return new Rule(context);
}
