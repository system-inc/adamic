import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    classification(index: number): number {
        const context = this.context;
        let optional = false;
        let rest = false;
        let initialized = false;
        for(const child of context.node(index).children) {
            const node = context.node(child);
            if(node.kind === 'QuestionToken') optional = true;
            if(node.kind === 'DotDotDotToken') rest = true;
            context.scanner.pos = node.end;
            if(context.scanner.scan() === 'EqualsToken') initialized = true;
        }
        // A defaulted rest parameter is reportable under Go's recovery behavior.
        if(optional || initialized) return 1;
        return rest ? 2 : 0;
    }
    visit(index: number): void {
        const context = this.context;
        const children = context.node(index).children;
        const body = children[children.length - 1] ?? -1;
        if(body < 0) return;
        if(context.node(index).kind !== 'ArrowFunction' && context.node(body).kind !== 'Block') return;
        const parameters: number[] = [];
        let lastPlain = -1;
        for(const child of children) {
            if(context.node(child).kind !== 'Parameter') continue;
            parameters.push(child);
            if(this.classification(child) === 0) lastPlain = parameters.length - 1;
        }
        for(let position = 0; position < lastPlain; position++) {
            const parameter = parameters[position] ?? -1;
            if(parameter >= 0 && this.classification(parameter) === 1) {
                context.report(parameter, '@typescript-eslint/default-param-last', 'shouldBeLast', message, '', '', '');
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
