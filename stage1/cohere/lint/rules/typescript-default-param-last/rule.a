import type { RuleContext } from '../../context.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    classification(index: number): number {
        // The parser stores parameter children in source order. Inspect the
        // punctuation before each child, so defaults and question marks inside
        // a binding pattern or a conditional type cannot classify the parameter.
        const scanner = new Scanner(this.context.source);
        let previous = this.context.start(index);
        let optional = false;
        let rest = false;
        for(const child of this.context.node(index).children) {
            const node = this.context.node(child);
            if(node.kind === 'QuestionToken') { optional = true; }
            if(node.kind === 'DotDotDotToken') { rest = true; }
            scanner.pos = previous;
            if(scanner.scan() === 'EqualsToken') { return 1; }
            previous = node.end;
        }
        return optional ? 1 : rest ? 2 : 0;
    }
    visit(index: number): void {
        const node = this.context.node(index);
        let body = node.kind === 'ArrowFunction';
        const parameters: number[] = [];
        for(const child of node.children) {
            const kind = this.context.node(child).kind;
            if(kind === 'Block') { body = true; }
            if(kind === 'Parameter') { parameters.push(child); }
        }
        if(!body) { return; }
        let lastPlain = -1;
        const classes: number[] = [];
        for(let position = 0; position < parameters.length; position++) {
            const parameter = parameters[position] ?? -1;
            const category = this.classification(parameter);
            classes.push(category);
            if(category === 0) { lastPlain = position; }
        }
        for(let position = 0; position < lastPlain; position++) {
            if(classes[position] === 1) {
                this.context.report(parameters[position] ?? -1, '@typescript-eslint/default-param-last', 'shouldBeLast', message, '', '', '');
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
