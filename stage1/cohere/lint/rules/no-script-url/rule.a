import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { messageScriptUrl } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number, parent: number): void {
        if(node.text.slice(0, 11).toLowerCase() !== ['javascript', ':'].join('')) {
            return;
        }
        if(parent >= 0) {
            const owner = this.context.node(parent);
            // The final child is the template, not the tag. A string used as the tag still reports.
            if(owner.kind === 'TaggedTemplateExpression' && owner.children[owner.children.length - 1] === index) {
                return;
            }
        }
        this.context.report(index, 'no-script-url', 'unexpectedScriptURL', messageScriptUrl, '', '', '');
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
