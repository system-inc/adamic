import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';
import { message, suggestion } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(index: number, parent: number): void {
        const node = this.context.node(index);
        const name =
            node.children.find((child) => this.context.node(child).kind === 'Identifier') ??
            panic('type parameter name');
        this.context.scanner.pos = this.context.node(name).end;
        if(this.context.scanner.scan() !== 'ExtendsKeyword') {
            return;
        }
        const constraint = node.children[node.children.indexOf(name) + 1] ?? panic('type parameter constraint');
        const bound = this.context.node(constraint);
        if(bound.kind !== 'AnyKeyword' && bound.kind !== 'UnknownKeyword') {
            return;
        }
        let replacement = '';
        if(
            parent >= 0 &&
            this.context.node(parent).kind === 'ArrowFunction' &&
            node.children.length === node.children.indexOf(name) + 2 &&
            ['.tsx', '.mts', '.cts'].some((extension) => this.context.parser.path.endsWith(extension))
        ) {
            const parameters = this.context
                .node(parent)
                .children.filter((child) => this.context.node(child).kind === 'TypeParameter');
            this.context.scanner.pos = node.end;
            if(parameters.length === 1 && this.context.scanner.scan() !== 'CommaToken') {
                replacement = ',';
            }
        }
        const finding = this.context.report(
            name,
            '@typescript-eslint/no-unnecessary-type-constraint',
            'noUnnecessaryTypeConstraint',
            message,
            '',
            '',
            '',
        );
        finding.suggestions.push(
            new Suggestion('removeTheConstraint', suggestion, [
                new SuggestionEdit(this.context.node(name).end, bound.end, replacement),
            ]),
        );
    }
}
export function create(context: RuleContext): Rule {
    return new Rule(context);
}
