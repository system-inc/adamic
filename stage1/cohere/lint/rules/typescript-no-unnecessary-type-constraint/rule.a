import type { RuleContext } from '../../context.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { Diagnostic, Edit, Suggestion, publish, requireRepairs } from './records.a';
import { message, suggestion } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    readonly records: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    comma(index: number, hasDefault: boolean): string {
        const parent = this.context.parents[index] ?? -1;
        if(parent < 0 || this.context.node(parent).kind !== 'ArrowFunction' || hasDefault) { return ''; }
        let count = 0;
        for(const child of this.context.node(parent).children) {
            if(this.context.node(child).kind === 'TypeParameter') { count++; }
        }
        const path = this.context.parser.path;
        if(count !== 1 || (!path.endsWith('.tsx') && !path.endsWith('.mts') && !path.endsWith('.cts'))) { return ''; }
        const scanner = new Scanner(this.context.source);
        scanner.pos = this.context.node(index).end;
        return scanner.scan() === 'CommaToken' ? '' : ',';
    }
    visit(index: number): void {
        const node = this.context.node(index);
        if(node.kind !== 'TypeParameter') { return; }
        let name = -1;
        let constraint = -1;
        let hasDefault = false;
        const scanner = new Scanner(this.context.source);
        for(const child of node.children) {
            const kind = this.context.node(child).kind;
            if(name < 0) {
                if(kind === 'Identifier') { name = child; }
                continue;
            }
            scanner.pos = this.context.node(name).end;
            if(scanner.scan() !== 'ExtendsKeyword') { return; }
            if(constraint < 0) { constraint = child; }
            else { hasDefault = true; }
        }
        if(name < 0 || constraint < 0) { return; }
        const kind = this.context.node(constraint).kind;
        if(kind !== 'AnyKeyword' && kind !== 'UnknownKeyword') { return; }
        const record = new Diagnostic(this.context, name, '@typescript-eslint/no-unnecessary-type-constraint', 'noUnnecessaryTypeConstraint', message);
        const repair = new Suggestion('removeTheConstraint', suggestion);
        repair.edits.push(new Edit(this.context.node(name).end, this.context.node(constraint).end, this.comma(index, hasDefault)));
        record.suggestions.push(repair);
        this.records.push(record);
        publish(this.context, name, record);
    }
    finish(root: number): void { requireRepairs(this.records); }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
