import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';
import { Edit, Suggestion, Result, emptyEdits, emptyResults, publish } from './results.a';

// Numeric SyntaxKind values from the pinned Go parser: TypeParameter.
export const syntaxKinds: readonly number[] = [169];

export class Rule {
    readonly context: RuleContext;
    results: readonly Result[] = emptyResults();
    constructor(context: RuleContext) { this.context = context; }
    evaluate(index: number): void {
        if(this.context.node(index).kind !== 'TypeParameter') { return; }
        const children = this.context.node(index).children;
        let namePosition = -1;
        for(let position = 0; position < children.length; position++) {
            if(this.context.node(children[position] ?? -1).kind === 'Identifier') {
                namePosition = position;
                break;
            }
        }
        if(namePosition < 0 || namePosition + 1 >= children.length) { return; }
        const name = children[namePosition] ?? -1;
        const constraint = children[namePosition + 1] ?? -1;
        const scanner = this.context.scanner;
        scanner.pos = this.context.node(name).end;
        if(scanner.scan() !== 'ExtendsKeyword') { return; }
        const kind = this.context.node(constraint).kind;
        if(kind !== 'AnyKeyword' && kind !== 'UnknownKeyword') { return; }
        let replacement = '';
        const parent = this.context.parents[index] ?? -1;
        if(parent >= 0 && this.context.node(parent).kind === 'ArrowFunction' && namePosition + 2 === children.length) {
            let parameters = 0;
            for(const child of this.context.node(parent).children) {
                if(this.context.node(child).kind === 'TypeParameter') { parameters++; }
            }
            const path = this.context.parser.path;
            scanner.pos = this.context.node(index).end;
            const comma = scanner.scan() === 'CommaToken';
            if(parameters === 1 && !comma && (path.endsWith('.tsx') || path.endsWith('.mts') || path.endsWith('.cts'))) {
                replacement = ',';
            }
        }
        const result = new Result(name, '@typescript-eslint/no-unnecessary-type-constraint', 'noUnnecessaryTypeConstraint', message, emptyEdits(), [new Suggestion('removeTheConstraint', 'Remove the constraint that does nothing.', [new Edit(this.context.node(name).end, this.context.node(constraint).end, replacement)])]);
        this.results = [...this.results, result];
    }
    visit(index: number): void {
        const before = this.results.length;
        this.evaluate(index);
        for(let position = before; position < this.results.length; position++) {
            const result = this.results[position];
            if(result !== undefined) { publish(this.context, result); }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
