import type { RuleContext } from '../../context.ts';
import { Suggestion as ReportSuggestion, SuggestionEdit } from '../../suggestions.a';
import type { Finding } from '../../finding.ts';
export interface Edit {
    readonly start: number;
    readonly end: number;
    readonly text: string;
}
export interface Suggestion {
    readonly id: string;
    readonly message: string;
    readonly edits: readonly Edit[];
}
export interface Repairs {
    readonly fixes: readonly Edit[];
    readonly suggestions: readonly Suggestion[];
}
// Comparison transport scoped to one synchronous parsed file. The old finding
// destination has no edit-list field; this retains every proposed edit.
const details = new Map<string, Repairs>();
export function clearRepairs(): void { details.clear(); }
export function saveRepairs(rule: string, start: number, repairs: Repairs): void {
    details.set(rule + ':' + String(start), repairs);
}
export function readRepairs(finding: Finding): Repairs | undefined {
    return details.get(finding.rule + ':' + String(finding.start));
}

// Use the integrated finding transport. Its single automatic edit limit remains
// an explicit refusal for callers whose actual Go repair has multiple edits.
export function reportRepairs(
    context: RuleContext, index: number, rule: string, id: string, message: string, repairs: Repairs,
): void {
    const edits: SuggestionEdit[] = [];
    for(const edit of repairs.fixes) {
        edits.push(new SuggestionEdit(edit.start, edit.end, edit.text));
    }
    const suggestions: ReportSuggestion[] = [];
    for(const suggestion of repairs.suggestions) {
        const proposed: SuggestionEdit[] = [];
        for(const edit of suggestion.edits) {
            proposed.push(new SuggestionEdit(edit.start, edit.end, edit.text));
        }
        suggestions.push(new ReportSuggestion(suggestion.id, suggestion.message, proposed));
    }
    context.reportNode(index, rule, id, message, edits, suggestions);
}
