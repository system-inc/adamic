import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { globalBinding } from './global-facts.a';
import { timerMessage, scriptMessage } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    global(index: number): boolean {
        const facts = globalBinding(this.context, index); if(facts === undefined || !facts.symbol.present) { return false; }
        const declarations = facts.local.declarations.length > facts.symbol.declarations.length ? facts.local : facts.symbol;
        for(let at = 0; at < declarations.files.length; at++) { if(declarations.files[at] === true && declarations.declarations[at] !== true) { return false; } }
        return true;
    }
    kind(index: number): string { return index < 0 ? '' : this.context.node(index).kind; }
    objects(name: string): boolean { return ['global', 'window', 'globalThis', 'self'].includes(name); }
    property(index: number): string {
        const context = this.context; const node = context.node(index);
        if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(node.kind)) { return ''; }
        const key = context.unwrap(node.children[node.children.length - 1] ?? -1); if(key < 0) { return ''; }
        const name = context.node(key);
        if(node.kind === 'ElementAccessExpression' && ['Identifier', 'PrivateIdentifier'].includes(name.kind)) { return ''; }
        return ['Identifier', 'StringLiteral', 'NoSubstitutionTemplateLiteral', 'NumericLiteral'].includes(name.kind) ? name.text : '';
    }
    callee(index: number): string {
        const context = this.context; index = context.unwrap(index); if(index < 0) { return ''; }
        const node = context.node(index);
        if(node.kind === 'Identifier') { return this.global(index) ? node.text : ''; }
        const name = this.property(index); if(name === '') { return ''; } let receiver = node.children[0] ?? -1;
        while(receiver >= 0) {
            receiver = context.unwrap(receiver); const root = context.node(receiver);
            if(root.kind === 'Identifier') { return this.objects(root.text) && this.global(receiver) ? name : ''; }
            if(!this.objects(this.property(receiver))) { return ''; } receiver = root.children[0] ?? -1;
        }
        return '';
    }
    string(index: number): boolean {
        if(index < 0) { return false; } const context = this.context; index = context.unwrap(index); const node = context.node(index);
        if(['StringLiteral', 'NoSubstitutionTemplateLiteral', 'TemplateExpression'].includes(node.kind)) { return true; }
        return node.kind === 'BinaryExpression' && this.kind(node.children[1] ?? -1) === 'PlusToken' &&
            (this.string(node.children[0] ?? -1) || this.string(node.children[node.children.length - 1] ?? -1));
    }
    visit(node: ParseNode, index: number): void {
        const context = this.context;
        const callee = context.unwrap(node.children[0] ?? -1); const target = context.node(callee);
        const candidate = target.kind === 'Identifier' ? target.text : this.property(callee);
        if(!['setTimeout', 'setInterval', 'execScript'].includes(candidate)) { return; }
        const name = this.callee(callee);
        if(!['setTimeout', 'setInterval', 'execScript'].includes(name) || !this.string(node.list <= 0 ? -1 : node.children[node.children.length - node.list] ?? -1)) { return; }
        context.report(index, 'no-implied-eval', name === 'execScript' ? 'execScript' : 'impliedEval', name === 'execScript' ? scriptMessage : timerMessage, '', '', '');
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
