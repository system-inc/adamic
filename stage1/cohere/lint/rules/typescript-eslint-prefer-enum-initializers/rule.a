import type { RuleContext } from '../../context.ts';
import { Diagnostic, Edit, Suggestion, report, refuseShared } from '../typescript-eslint-prefer-as-const/repairs.a';

export class Rule {
    readonly context: RuleContext;
    readonly diagnostics: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    visit(index: number): void {
        if(this.context.node(index).kind !== 'EnumDeclaration') { return; }
        let position = 0;
        for(const member of this.context.node(index).children) {
            const node = this.context.node(member);
            if(node.kind !== 'EnumMember') { continue; }
            if(node.children.length < 2) {
                const start = this.context.start(member);
                const name = this.context.source.slice(start, node.end);
                const suggestions: Suggestion[] = [];
                for(const value of [`${position}`, `${position + 1}`, `'${name}'`]) {
                    suggestions.push(new Suggestion('defineInitializerSuggestion', `Can be fixed to ${name} = ${value}`, [new Edit(start, node.end, `${name} = ${value}`)]));
                }
                this.diagnostics.push(report(this.context, member, 'defineInitializer', `The value of the member '${name}' should be explicitly defined.`, [], suggestions));
            }
            position++;
        }
    }
}
export function create(context: RuleContext): Rule {
    refuseShared(context, '@typescript-eslint/prefer-enum-initializers');
    return new Rule(context);
}
