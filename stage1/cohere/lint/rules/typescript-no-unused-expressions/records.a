import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { SuggestionEdit, Suggestion as WireSuggestion } from '../../suggestions.a';

export class Edit {
    readonly start: number;
    readonly end: number;
    readonly text: string;
    constructor(start: number, end: number, text: string) {
        this.start = start;
        this.end = end;
        this.text = text;
    }
}
export class Suggestion {
    readonly id: string;
    readonly message: string;
    readonly edits: Edit[] = [];
    constructor(id: string, message: string, start = -1) {
        this.id = id;
        this.message = message;
    }
}
export class Diagnostic {
    readonly rule: string;
    readonly id: string;
    readonly message: string;
    readonly start: number;
    readonly end: number;
    readonly fixes: Edit[] = [];
    readonly suggestions: Suggestion[] = [];
    constructor(context: RuleContext, index: number, rule: string, id: string, message: string, start = -1) {
        this.rule = rule;
        this.id = id;
        this.message = message;
        this.start = start < 0 ? context.start(index) : start;
        this.end = context.node(index).end;
    }
}
export function publish(context: RuleContext, index: number, record: Diagnostic): void {
    const edits: SuggestionEdit[] = [];
    for(const edit of record.fixes) { edits.push(new SuggestionEdit(edit.start, edit.end, edit.text)); }
    const suggestions: WireSuggestion[] = [];
    for(const suggestion of record.suggestions) {
        const changes: SuggestionEdit[] = [];
        for(const edit of suggestion.edits) { changes.push(new SuggestionEdit(edit.start, edit.end, edit.text)); }
        suggestions.push(new WireSuggestion(suggestion.id, suggestion.message, changes));
    }
    context.reportRange(record.start, record.end, record.rule, record.id, record.message, edits, suggestions);
}
export function requireRepairs(records: readonly Diagnostic[]): void {
    for(const record of records) {
        if(record.fixes.length > 1) { panic(`${record.rule}: shared finding serialization cannot carry multiple automatic edits`); }
    }
}
