import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { CheckedJudgments } from '../no-global-assign/context.a';
import { NoImplicitGlobals } from '../../../typeaware/no_implicit_globals.a';
import { Bindings } from '../../../typeaware/bindings.ts';
import { NexusFacts } from '../../../typeaware/nexus_facts.a';
import { GlobalSourceFacts } from '../../../typeaware/global_source_facts.a';
export class Rule {
    readonly context: RuleContext;
    checked: CheckedJudgments | undefined = undefined;
    judgment: NoImplicitGlobals | undefined = undefined;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        if(this.judgment === undefined) {
            const context = this.context;
            this.checked = new CheckedJudgments(context);
            const rules = this.checked.rules;
            this.judgment = new NoImplicitGlobals(rules, new Bindings(rules), new GlobalSourceFacts(rules, context.root), new NexusFacts(rules), context.settings.read('lexicalbindings', 'false') === 'true');
        }
        const judgment = this.judgment ?? panic('missing judgment');
        const checked = this.checked ?? panic('missing checker view');
        judgment.run(index);
        checked.flush();
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
