import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { messageNoProto } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        const keyIndex = node.children[node.children.length - 1];
        if(keyIndex === undefined) { return; }
        let key = this.context.node(keyIndex);
        if(node.kind === 'ElementAccessExpression') {
            while(key.kind === 'ParenthesizedExpression') {
                const inner = key.children[0];
                if(inner === undefined) { return; }
                key = this.context.node(inner);
            }
        }
        const staticKey = node.kind === 'PropertyAccessExpression'
            ? key.kind === 'Identifier' || key.kind === 'PrivateIdentifier'
            : key.kind === 'StringLiteral' || key.kind === 'NoSubstitutionTemplateLiteral' || key.kind === 'NumericLiteral';
        if(staticKey && key.text === '__proto__') {
            this.context.scanner.pos = node.pos;
            this.context.scanner.scan();
            this.context.reportRange(this.context.scanner.start, node.end, 'no-proto', 'unexpectedProto', messageNoProto);
        }
    }
}

export function create(context: RuleContext): Rule { return new Rule(context); }
