import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Finding } from '../../finding.ts';
import { Reader } from '../better-tailwindcss-no-deprecated-classes/reader.a';
import { duplicates,templateDuplicates,message } from './core.a';
import type { Diagnostic } from './core.a';
export class Rule {
    readonly context: RuleContext;readonly reader: Reader;
    constructor(context: RuleContext) { this.context=context;this.reader=new Reader(context); }
    emit(report: Diagnostic): void {
        if(report.edits.length>1) { panic('NotYet: multiple automatic edits per diagnostic in shared Finding'); }
        const edit=report.edits[0];const found=new Finding('better-tailwindcss/no-duplicate-classes','duplicateClass',message(report.name),report.start,report.end,edit===undefined ? '' : 'fix',edit===undefined ? '' : edit.text,'');
        if(edit!==undefined) { found.editStart=edit.start;found.editEnd=edit.end; }
        this.context.findings.push(found);
    }
    visit(index: number): void {
        const values=this.reader.read(index);
        for(const literal of values.literals) { for(const report of duplicates(this.context.source,literal.text,literal.start,literal.end)) { this.emit(report); } }
        for(const template of values.templates) { for(const report of templateDuplicates(this.context.source,this.reader.segments(template))) { this.emit(report); } }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
