// Full per-literal duplicate decision and disjoint-edit core.
export class Edit { readonly start: number; readonly end: number; readonly text: string; constructor(start: number, end: number, text: string) { this.start=start; this.end=end; this.text=text; } }
export class Diagnostic { readonly edits: Edit[]=[]; readonly name: string; readonly start: number; readonly end: number; constructor(name: string, start: number, end: number) { this.name=name; this.start=start; this.end=end; } }
export class Token { readonly text: string; readonly start: number; readonly end: number; readonly separator: boolean; constructor(text: string, start: number, end: number, separator: boolean) { this.text=text; this.start=start; this.end=end; this.separator=separator; } }
function space(code: number): boolean { return code===32 || (code>=9 && code<=13); }
export function fields(text: string): string[] {
    return text.split(/[\t\n\v\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+/).map(value=>value ?? '').filter(value=>value!=='' && !value.includes('${'));
}
export function tokens(text: string,start: number): Token[] {
    const result: Token[]=[];
    let index=0;
    while(index<text.length) { const begin=index; const separator=space(text.charCodeAt(index)); while(index<text.length && space(text.charCodeAt(index))===separator) { index++; } result.push(new Token(text.slice(begin,index),start+begin,start+index,separator)); }
    return result;
}
export function deletions(items: readonly Token[],name: string): Edit[] {
    const result: Edit[]=[]; let seen=false;
    for(let index=0;index<items.length;index++) {
        const token=items[index]; if(token===undefined || token.separator || token.text!==name) { continue; }
        if(!seen) { seen=true; continue; }
        const separator=items[index-1]; if(separator===undefined) { continue; }
        if(separator.end===separator.start+1) { result.push(new Edit(separator.start,token.end,'')); }
        else { result.push(new Edit(separator.start,separator.start+1,'')); result.push(new Edit(token.start,token.end,'')); }
    }
    return result;
}
export function duplicates(source: string,value: string,start: number,end: number): Diagnostic[] {
    const classes=fields(value); const seen: string[]=[]; const repeats: string[]=[]; const result: Diagnostic[]=[];
    for(const name of classes) { if(seen.includes(name)) { if(!repeats.includes(name)) { repeats.push(name); } } else { seen.push(name); } }
    const canFix=!value.includes('${') && start>=0 && end<=source.length && start<=end && source.slice(start,end)===value;
    const items: Token[]=canFix ? tokens(value,start) : [];
    for(const name of repeats) { const found=new Diagnostic(name,start,end); if(canFix) { for(const edit of deletions(items,name)) { found.edits.push(edit); } } result.push(found); }
    return result;
}
export class Segment { readonly text: string; readonly start: number; readonly end: number; constructor(text: string, start: number, end: number) { this.text=text; this.start=start; this.end=end; } }
export function templateDuplicates(source: string,segments: readonly Segment[]): Diagnostic[] {
    const seenTemplate: string[]=[]; const names: string[]=[]; const results: Diagnostic[]=[]; const fixable: boolean[]=[];
    for(let index=0;index<segments.length;index++) {
        const segment=segments[index]; if(segment===undefined || segment.text.includes('${')) { continue; }
        const valid=segment.start>=0 && segment.end<=source.length && segment.start<=segment.end && source.slice(segment.start,segment.end)===segment.text;
        const items=tokens(segment.text,valid ? segment.start : 0); if(items.length===0) { continue; }
        const first=index>0 && !(items[0]?.separator ?? true) ? 1 : 0;
        const last=index<segments.length-1 && !(items[items.length-1]?.separator ?? true) ? items.length-1 : items.length;
        const seenRun: string[]=[];
        for(let position=first;position<last;position++) {
            const token=items[position]; if(token===undefined || token.separator) { continue; }
            const name=token.text;
            if(!seenRun.includes(name) && !seenTemplate.includes(name)) { seenRun.push(name); seenTemplate.push(name); continue; }
            let found=names.indexOf(name); if(found<0) { found=names.length; names.push(name); results.push(new Diagnostic(name,segment.start,segment.end)); fixable.push(true); }
            if(!seenRun.includes(name) || !valid) { fixable[found]=false; seenRun.push(name); continue; }
            const separator=items[position-1]; const report=results[found]; if(separator===undefined || report===undefined) { continue; }
            if(separator.end===separator.start+1) { report.edits.push(new Edit(separator.start,token.end,'')); }
            else { report.edits.push(new Edit(separator.start,separator.start+1,'')); report.edits.push(new Edit(token.start,token.end,'')); }
        }
    }
    for(let index=0;index<results.length;index++) { if(fixable[index]===false) { const found=results[index]; if(found!==undefined) { while(found.edits.length>0) { found.edits.pop(); } } } }
    return results;
}
export function message(name: string): string { return `The class "${name}" is listed more than once. The repeat has no effect, so it is either a leftover from an edit or a sign that two people added the same class from different ends of the string. Remove the later one.`; }
