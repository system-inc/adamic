import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Finding } from '../../finding.ts';
import { Diagnostic, diagnostics } from '../typescript-no-non-null-asserted-optional-chain/diagnostic.ts';
import { fields } from '../tailwind-no-physical-direction/rule.ts';
export function classes(text: string): string[] { return fields(text).filter((part) => !part.includes('${')); }
export function segments(text: string): string[] {
    const result: string[] = []; let depth = 0; let start = 0;
    for(let i = 0; i < text.length; i++) {
        const character = text[i] ?? '';
        if(character === '[' || character === '(') { depth++; }
        else if(character === ']' || character === ')') { depth--; }
        else if(character === ':' && depth === 0) { result.push(text.slice(start,i)); start = i + 1; }
    }
    result.push(text.slice(start)); return result;
}
export function prefix(text: string): string[] {
    const parts = segments(text);
    const root = parts[parts.length - 1] ?? '';
    const before = parts.slice(0,-1).join(':');
    return before === '' || root === '' ? ['',text] : [before,root];
}
export function report(context: RuleContext, index: number, name: string, id: string, message: string): void {
    let start = context.start(index); let end = context.node(index).end;
    if(end - start >= 2) { start++; end--; }
    context.findings.push(new Finding(name,id,message,start,end,'','',''));
    diagnostics.push(new Diagnostic(name,id,message,start,end,[]));
}
export class Surface {
    readonly context: RuleContext;
    readonly attributes: string[];
    readonly callees: string[];
    readonly variables: string[];
    constructor(context: RuleContext) {
        this.context = context;
        const attributes = context.settings.list('attributes',[]);
        const callees = context.settings.list('callees',[]);
        const variables = context.settings.list('variables',[]);
        this.attributes = attributes.length === 0 ? ['class','className'] : attributes;
        this.callees = callees.length === 0 ? ['mergeClassNames','createVariantClassNames'] : callees;
        this.variables = variables.length === 0 ? ['.*[Cc]lassName$','.*[Cc]lassNames$'] : variables;
    }
    collect(index: number, literals: number[]): void {
        if(index < 0) { return; }
        const node = this.context.node(index); const children = node.children;
        if(['StringLiteral','NoSubstitutionTemplateLiteral'].includes(node.kind)) { literals.push(index); }
        else if(['JsxExpression','ParenthesizedExpression','AsExpression','SatisfiesExpression'].includes(node.kind)) { this.collect(children[0] ?? -1,literals); }
        else if(node.kind === 'ConditionalExpression') { this.collect(children[2] ?? -1,literals); this.collect(children[4] ?? -1,literals); }
        else if(node.kind === 'BinaryExpression') {
            const operator = this.context.node(children[1] ?? panic('missing operator')).kind;
            if(operator === 'AmpersandAmpersandToken') { this.collect(children[2] ?? -1,literals); }
            else if(operator === 'BarBarToken' || operator === 'QuestionQuestionToken') { this.collect(children[0] ?? -1,literals); this.collect(children[2] ?? -1,literals); }
        }
        else if(node.kind === 'ArrayLiteralExpression') { for(const child of children) { this.collect(child,literals); } }
        else if(node.kind === 'TemplateExpression') {
            for(const child of children) { const span = this.context.node(child); if(span.kind === 'TemplateSpan') { this.collect(span.children[0] ?? -1,literals); } }
        }
    }
    literals(index: number): number[] {
        const result: number[] = []; const node = this.context.node(index); const children = node.children;
        if(node.kind === 'JsxAttribute') {
            const name = this.context.node(children[0] ?? panic('missing attribute name'));
            if(this.attributes.includes(name.text)) { this.collect(children[1] ?? -1,result); }
        }
        else if(node.kind === 'CallExpression') {
            const callee = this.context.node(children[0] ?? panic('missing callee'));
            if(callee.kind === 'Identifier' && this.callees.includes(callee.text)) {
                // Independent parser preserves the argument count; a projected Go
                // arena supplies list through the owned adapter.
                const start = node.list >= 0 ? children.length - node.list : 1;
                for(let i = start; i < children.length; i++) { this.collect(children[i] ?? -1,result); }
            }
        }
        else if(node.kind === 'VariableDeclaration') {
            const name = this.context.node(children[0] ?? panic('missing variable name'));
            const value = children[children.length - 1] ?? -1;
            if(name.kind !== 'Identifier' || value < 0 || value === children[0] || !this.context.source.slice(name.end,this.context.node(value).pos).includes('=')) { return result; }
            let matches = false;
            for(const pattern of this.variables) {
                if(pattern === '.*[Cc]lassName$') { matches = name.text.endsWith('className') || name.text.endsWith('ClassName'); }
                else if(pattern === '.*[Cc]lassNames$') { matches = name.text.endsWith('classNames') || name.text.endsWith('ClassNames'); }
                else { panic('NotYet: nonconstant Go variable-pattern regexp provider'); }
                if(matches) { break; }
            }
            if(matches) { this.collect(value,result); }
        }
        return result;
    }
}
