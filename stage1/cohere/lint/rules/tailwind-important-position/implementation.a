import type { RuleContext } from '../../context.ts';
import { Surface, classes, prefix, report } from './surface.a';
export function corrected(text: string, position: string): string {
    const parts = prefix(text); const variant = parts[0] ?? ''; const utility = parts[1] ?? '';
    if(utility === '') { return ''; }
    const negative = utility.startsWith('-'); let base = negative ? utility.slice(1) : utility;
    const atStart = base.startsWith('!'); if(atStart) { base = base.slice(1); }
    const atEnd = base.endsWith('!'); if(atEnd) { base = base.slice(0,-1); }
    if(base === '' || !atStart && !atEnd || position === 'legacy' && atStart || position !== 'legacy' && atEnd) { return ''; }
    let rebuilt = negative ? '-' + base : base;
    rebuilt = position === 'legacy' ? '!' + rebuilt : rebuilt + '!';
    if(variant !== '') { rebuilt = variant + ':' + rebuilt; }
    return rebuilt === text ? '' : rebuilt;
}
export class Listener {
    readonly context: RuleContext; readonly surface: Surface; readonly position: string;
    constructor(context: RuleContext) { this.context = context; this.surface = new Surface(context); this.position = context.settings.read('position','recommended'); }
    visit(index: number, parent: number): void {
        for(const literal of this.surface.literals(index)) {
            for(const text of classes(this.context.node(literal).text)) {
                const replacement = corrected(text,this.position);
                if(replacement === '') { continue; }
                const message = `The important marker on "${text}" is written where Tailwind v3 put it. Tailwind v4 moved it to the end of the utility, so this is spelled "${replacement}" now. Both still compile, which is exactly why a v3 habit survives a paste and then sits next to the v4 spelling with nothing to say which one the file means. Write it as "${replacement}".`;
                report(this.context,literal,'better-tailwindcss/enforce-consistent-important-position','importantPosition',message);
            }
        }
    }
}
