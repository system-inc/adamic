export const message = "The return value of `ReactDOM.render` is being consumed. It is a legacy escape hatch that only ever worked for a class component rendered synchronously at the root, and it returns null for a function component, so code holding it is reading an instance that may not exist. React 18's concurrent root removed the guarantee entirely and React 19 removed `ReactDOM.render` itself. Attach a ref to the thing you wanted a handle on, or run the work in an effect, so nothing depends on a value the renderer stopped promising.";
