import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { firstDeclarationIsFile, symbolIdentity } from '../../checker_local_symbols.a';
import { Finding } from '../../finding.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';
import { Settings } from '../../settings.ts';
const messageMissingCatchErrorParam = "This throws a new error out of a catch clause that declares no parameter, so the error it caught cannot be reached at all. Nothing in the block can log it, inspect it, or attach it as the `cause` of what is thrown here, and the information is gone before the first statement runs. Name the parameter so the caught error stays available.";
const messageMissingCause = "This throws a new error out of a catch block without attaching the error that was caught. The original stack, the original message, and whatever the underlying library said about what actually went wrong are all discarded at this line, and what reaches the log is a sentence somebody wrote by hand months ago. The failure that matters is the one you can no longer see. Pass the caught error as the `cause` option so both halves survive.";
const messageIncorrectCause = "This error is thrown out of a catch block with a `cause`, but the cause is not the error that was caught. A property of it, a copy made earlier, or an unrelated value each loses something the original carried, usually its stack, and the reader of the log has no way to tell that the chain was cut here. Attach the caught error itself.";
const messagePartiallyLostError = "This catch clause destructures the error it caught, so only the parts it names survive. The stack, and whatever else the pattern does not pick out, is gone before the block runs, and an error thrown from here cannot attach the original as its `cause`. Bind the whole error to a name and destructure it inside the block where that is still useful.";
const messageCaughtErrorShadowed = "This attaches a `cause` spelled like the caught error, but a closer declaration of the same name shadows the catch parameter, so what is attached is that other value. The line reads as preserving the original and does not. Rename the inner declaration so the caught error is the one attached.";
const messageIncludeCause = "Attach the caught error as the `cause` option. This changes what the thrown error carries, so it is offered rather than applied.";

export class Rule {
    readonly context: RuleContext;
    readonly customPositions = new Map<string,number>();
    constructor(context: RuleContext) {
        this.context = context;
        const empty: string[] = [];
        for(const entry of context.settings.values.get('errorclassnames') ?? empty) {
            if(entry.startsWith('{')) {
                const options = new Settings(); options.load(entry);
                this.customPositions.set(options.read('name',''),Number(options.read('argumentposition','2')));
            } else { this.customPositions.set(entry,2); }
        }
    }
    unwrap(index: number): number {
        while(this.context.kind(index) === 'ParenthesizedExpression') { index = this.context.node(index).children[0] ?? -1; }
        return index;
    }
    global(index: number): boolean {
        const checker = this.context.checker;
        return checker !== undefined && firstDeclarationIsFile(checker,this.context.node(index));
    }
    identity(index: number): number {
        const checker = this.context.checker; if(checker === undefined) { return 0; }
        const shorthand = this.context.kind(this.context.parent(index)) === 'ShorthandPropertyAssignment';
        return symbolIdentity(checker, this.context.node(index), shorthand);
    }
    kind(index: number): string { return index < 0 ? '' : this.context.parser.node(index).kind; }
    enclosing(index: number): number {
        let current = this.context.parent(index);
        while(current >= 0) {
            const kind = this.kind(current);
            if(kind === 'CatchClause') { return current; }
            if(['FunctionDeclaration','FunctionExpression','ArrowFunction','MethodDeclaration','GetAccessor','SetAccessor','Constructor'].includes(kind) || kind === 'ClassStaticBlockDeclaration') { return -1; }
            current = this.context.parent(current);
        }
        return -1;
    }
    report(index: number, id: string, message: string): Finding {
        const rules = this.context; const node = rules.parser.node(index);
        return rules.reportRange(rules.startNode(node),node.end,'preserve-caught-error',id,message);
    }
    suggest(finding: Finding, start: number, end: number, text: string): void {
        const rules = this.context;
        finding.suggestions.push(new Suggestion('includeCause', messageIncludeCause, [new SuggestionEdit(start, end, text)]));
    }
    key(index: number): string {
        const rules = this.context;
        let node = rules.parser.node(index);
        if(node.kind === 'ComputedPropertyName') {
            node = rules.parser.node(this.unwrap(node.children[0] ?? -1));
            if(node.kind === 'Identifier' || node.kind === 'PrivateIdentifier') { return ''; }
        }
        return ['Identifier', 'StringLiteral', 'NoSubstitutionTemplateLiteral', 'NumericLiteral'].includes(node.kind) ? node.text : '';
    }
    emptyCallPosition(index: number): number {
        const rules = this.context; const node = rules.parser.node(index);
        const scanner = rules.scanner; scanner.pos = rules.startNode(node);
        if(rules.parser.node(node.children[0] ?? -1).end === node.end) { return -1; }
        const opens: number[] = []; let last = -1;
        while(scanner.pos < node.end) {
            const token = scanner.scan();
            if(token === 'OpenParenToken') { opens.push(scanner.pos); }
            if(token === 'CloseParenToken') { last = opens.pop() ?? -1; }
            if(token === 'EndOfFileToken') { break; }
        }
        // A parenthesized callee has a close token too, but its end precedes
        // the end of a call with an argument list.
        return rules.scanner.text.slice(node.end - 1, node.end) === ')' ? last : -1;
    }
    missing(index: number, args: readonly number[], optionsIndex: number, name: string, builtIn: boolean): void {
        const rules = this.context;
        const finding = this.report(index,'missingCause',messageMissingCause);
        const thrown = this.unwrap(rules.node(index).children[0] ?? -1);
        const cause = `{ cause: ${name} }`;
        const leading = optionsIndex === 2 ? ['[]','""'] : ['""'];
        let addition = cause;
        if(builtIn && args.length < leading.length) { addition = leading.slice(args.length).concat([cause]).join(', '); }
        else if(!builtIn && args.length < optionsIndex) { return; }
        if(args.length <= optionsIndex) {
            if(args.length === 0) {
                const position = this.emptyCallPosition(thrown); const end = rules.node(thrown).end;
                this.suggest(finding,position < 0 ? end : position,position < 0 ? end : position,position < 0 ? `(${addition})` : addition);
            } else { const end = rules.node(args[args.length-1] ?? -1).end; this.suggest(finding,end,end,`, ${addition}`); }
        } else {
            const options = rules.node(this.unwrap(args[optionsIndex] ?? -1));
            const last = options.children[options.children.length-1] ?? -1;
            const position = last < 0 ? rules.startNode(options)+1 : rules.node(last).end;
            this.suggest(finding,position,position,`${last < 0 ? '' : ', '}cause: ${name}`);
        }
    }
    incorrect(property: number, value: number, multiple: boolean, name: string): void {
        const rules = this.context; const member = rules.parser.node(property);
        let finding: Finding;
        if(value >= 0) { finding = this.report(value, 'incorrectCause', messageIncorrectCause); }
        else {
            const key = member.children.find((child) => !rules.parser.node(child).kind.endsWith('Keyword') && rules.parser.node(child).kind !== 'Decorator' && rules.parser.node(child).kind !== 'AsteriskToken') ?? -1;
            const scanner = rules.scanner; scanner.pos = key < 0 ? rules.startNode(member) : rules.parser.node(key).end;
            let first = scanner.pos;
            while(scanner.pos < member.end) {
                const token = scanner.scan();
                if(token === 'LessThanToken' || token === 'OpenParenToken') { first = scanner.start; break; }
                if(token === 'EndOfFileToken') { break; }
            }
            finding = rules.reportRange(first,member.end,'preserve-caught-error','incorrectCause',messageIncorrectCause);
        }
        if(multiple) { return; }
        const replaceMember = value < 0 || member.kind === 'ShorthandPropertyAssignment';
        const target = replaceMember ? member : rules.parser.node(value);
        this.suggest(finding, rules.startNode(target), target.end, replaceMember ? `cause: ${name}` : name);
    }
    visit(node: ParseNode, index: number): void {
        const rules = this.context;
        const catchIndex = this.enclosing(index); if(catchIndex < 0) { return; }
        const expression = this.unwrap(node.children[0] ?? -1); const construction = rules.parser.node(expression);
        if(!['NewExpression', 'CallExpression'].includes(construction.kind) || construction.children.some((child) => this.kind(child) === 'QuestionDotToken')) { return; }
        const callee = this.unwrap(construction.children[0] ?? -1); const called = rules.parser.node(callee);
        const className = called.kind === 'Identifier' ? called.text : called.kind === 'PropertyAccessExpression' && this.kind(called.children[1] ?? -1) === 'Identifier' ? rules.node(called.children[1] ?? -1).text : '';
        const builtIn = called.kind === 'Identifier' && ['Error','EvalError','RangeError','ReferenceError','SyntaxError','TypeError','URIError','AggregateError'].includes(className) && this.global(callee);
        const custom = this.customPositions.get(className);
        if(!builtIn && custom === undefined) { return; }
        const caught = rules.parser.node(catchIndex);
        const declaration = caught.children.find((child) => this.kind(child) === 'VariableDeclaration') ?? -1;
        if(declaration < 0) { if(rules.settings.read('requirecatchparameter','false') === 'true') { this.report(index,'missingCatchErrorParam',messageMissingCatchErrorParam); } return; }
        const binding = this.context.name(declaration);
        if(this.kind(binding) !== 'Identifier') { this.report(catchIndex, 'partiallyLostError', messagePartiallyLostError); return; }
        const name = rules.parser.node(binding).text; const optionsIndex = builtIn ? (className === 'AggregateError' ? 2 : 1) : (custom ?? 2)-1;
        let args: number[] = [];
        if(construction.list > 0) { args = construction.children.slice(construction.children.length - construction.list); }
        if(args.some((argument, at) => at <= optionsIndex && this.kind(argument) === 'SpreadElement')) { return; }
        let property = -1; let count = 0;
        if(args.length > optionsIndex) {
            const options = rules.parser.node(this.unwrap(args[optionsIndex] ?? -1));
            if(options.kind !== 'ObjectLiteralExpression' || options.children.some((child) => this.kind(child) === 'SpreadAssignment')) { return; }
            for(const memberIndex of options.children) {
                const member = rules.parser.node(memberIndex);
                const key = member.children.find((child) => !this.kind(child).endsWith('Keyword') && this.kind(child) !== 'Decorator' && this.kind(child) !== 'AsteriskToken') ?? -1;
                if(key >= 0 && this.key(key) === 'cause') { property = memberIndex; count++; }
            }
        }
        if(property < 0) { this.missing(index, args, optionsIndex, name, builtIn); return; }
        const member = rules.parser.node(property); let value = -1;
        if(member.kind === 'PropertyAssignment') { value = this.unwrap(member.children[member.children.length - 1] ?? -1); }
        if(member.kind === 'ShorthandPropertyAssignment') { value = member.children[0] ?? -1; }
        if(this.kind(value) !== 'Identifier' || rules.parser.node(value).text !== name) { this.incorrect(property, value, count > 1, name); return; }
        const valueSymbol = this.identity(value);
        if(valueSymbol !== 0 && valueSymbol !== this.identity(binding)) { this.report(index, 'caughtErrorShadowed', messageCaughtErrorShadowed); }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
