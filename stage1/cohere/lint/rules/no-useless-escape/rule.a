   const bytes = new Bytes(raw); const quote = raw[0] ?? ''; let i = 1;
   while(i < bytes.values.length-1) {
    if(bytes.values[i] !== 92) { i++; continue; }
    if(i+1 >= bytes.values.length-1) { break; }
    const rune = decode(bytes.values,i+1); const size = rune[1] ?? 0;
    const a = bytes.positions[i+1] ?? 0; const b = bytes.positions[i+1+size] ?? raw.length;
    const escaped = raw.slice(a,b); const cp = rune[0] ?? 0;
    if(escaped !== quote && !(cp >= 48 && cp <= 57) && !validString.includes(escaped)) { this.report(start+(bytes.positions[i] ?? 0),start+b,escaped); }
    i += 1+size;
   }
   return;
  }
  let template = index;
  if(kind === 'TemplateHead') { template = parent; }
  else if(kind === 'TemplateMiddle' || kind === 'TemplateTail') { template = parent < 0 ? -1 : (ctx.parents[parent] ?? -1); }
  if(template < 0) { return; }
  const enclosing = ctx.parents[template] ?? -1;
  if(enclosing >= 0 && ctx.node(enclosing).kind === 'TaggedTemplateExpression') {
   const children = ctx.node(enclosing).children;
   if(children[children.length-1] === template) { return; }
  }
  // Template type chunks have no runtime string surface.
  if(kind !== 'NoSubstitutionTemplateLiteral' && ctx.node(template).kind !== 'TemplateExpression') { return; }
  const bytes = new Bytes(raw); let previous = 96; let i = 1;
  while(i < bytes.values.length-1) {
   const rune = decode(bytes.values,i); const cp = rune[0] ?? 0; const size = rune[1] ?? 0;
   if(cp !== 92) { previous = cp; i += size; continue; }
   if(i+size >= bytes.values.length-1) { break; }
   const next = decode(bytes.values,i+size); const escapedCp = next[0] ?? 0; const escapedSize = next[1] ?? 0;
   const a = bytes.positions[i+size] ?? 0; const b = bytes.positions[i+size+escapedSize] ?? raw.length;
   const escaped = raw.slice(a,b); let useless = false;
   if(escapedCp >= 48 && escapedCp <= 57 || escapedCp === 96) { }
   else if(escapedCp === 123) { useless = previous !== 36; }
   else if(escapedCp === 36) { useless = (decode(bytes.values,i+size+escapedSize)[0] ?? 0) !== 123; }
   else { useless = !validString.includes(escaped); }
   if(useless) { this.report(start+(bytes.positions[i] ?? 0),start+b,escaped); }
   previous = escapedCp; i += size+escapedSize;
  }
 }
 report(start: number, end: number, escaped: string): void {
