 }
 scan(bytes: readonly number[], flags: RegexFlags, classStart: number, classFinish: number, negative: boolean, offsets: number[]): void {
  let i = classStart < 0 ? 0 : classStart+1+(negative ? 1 : 0); const end = classStart < 0 ? bytes.length : classFinish-1;
  while(i < end) {
   if(bytes[i] === 92) {
    const step = skipPatternEscape(bytes,i,flags,(at: number): number => decode(bytes,at)[1] ?? 0);
    if(!step.ok) { return; }
