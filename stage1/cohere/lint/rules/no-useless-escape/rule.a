    if(!finish.ok) { return; }
    this.scan(bytes,flags,i,finish.value,i+1 < finish.value && bytes[i+1] === 94,offsets); i = finish.value;
   }
   else { const width = decode(bytes,i)[1] ?? 0; i += width === 0 ? 1 : width; }
  }
 }
 useless(bytes: readonly number[], i: number, flags: RegexFlags, classStart: number, classFinish: number, negative: boolean): boolean {
  if(i+1 >= bytes.length) { return false; }
  const rune = decode(bytes,i+1); const cp = rune[0] ?? 0; const size = rune[1] ?? 0;
  const character = cp < 128 ? String.fromCharCode(cp) : '';
  const needed = classStart < 0 ? nonClass : flags.unicodeSets ? classSet : general;
  if(character !== '' && needed.includes(character)) { return false; }
  if(classStart < 0) { return true; }
  if(cp === 94 && classStart+1 === i) { return false; }
  if(flags.unicodeSets) {
   if(character === '' || !reserved.includes(character)) { return true; }
   if((decode(bytes,i+1+size)[0] ?? 0) === cp) { return false; }
   // Reserved punctuators are ASCII, hence their preceding twin has width one.
   if(i === 0 || bytes[i-1] !== cp) { return true; }
   if(cp !== 94 || !negative) { return false; }
   return !(classStart+1 < i-1);
  }
  if(cp === 45 && classStart+1 !== i && i+1+size !== classFinish-1) { return false; }
  return true;
 }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
