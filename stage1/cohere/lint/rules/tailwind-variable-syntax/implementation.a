import type { RuleContext } from '../../context.ts';
import { Surface, classes, prefix, report } from '../tailwind-important-position/surface.a';
import { trimGo } from '../tailwind-important-position/spaces.a';
function balanced(text: string, open: string, close: string): string[] {
    const start = text.indexOf(open); if(start < 0) { return []; }
    let depth = 0;
    for(let i = start; i < text.length; i++) {
        if(text[i] === open) { depth++; }
        else if(text[i] === close) { depth--; if(depth === 0) { return [text.slice(0,start),text.slice(start + 1,i),text.slice(i + 1)]; } }
    }
    return [];
}
function shorthand(text: string): boolean {
    let rest = text; while(rest.startsWith('_')) { rest = rest.slice(1); }
    if(!rest.startsWith('--')) { return false; }
    for(let i = 2; i < rest.length; i++) {
        const character = rest[i] ?? '';
        if(character === '(') { return false; }
        if(!/[a-zA-Z0-9_-]/.test(character)) { return true; }
    }
    return true;
}
function variable(text: string): boolean {
    let rest = text; while(rest.startsWith('_')) { rest = rest.slice(1); }
    if(!rest.startsWith('var(')) { return false; } rest = rest.slice(4);
    while(rest.startsWith('_')) { rest = rest.slice(1); }
    return rest.startsWith('--');
}
function rewrite(base: string, syntax: string): string {
    const bracket = balanced(base,'[',']'); const contents = bracket[1] ?? '';
    if(syntax !== 'variable') {
        if(bracket.length === 0) { return ''; }
        if(variable(contents)) {
            const inner = balanced(contents,'(',')');
            if(inner.length === 0 || trimGo((inner[2] ?? '').replaceAll('_',' ')) !== '') { return ''; }
            return (bracket[0] ?? '') + '(' + (inner[1] ?? '') + ')' + (bracket[2] ?? '');
        }
        if(shorthand(contents)) { return (bracket[0] ?? '') + '(' + contents + ')' + (bracket[2] ?? ''); }
        return '';
    }
    if(bracket.length > 0 && variable(contents)) { return ''; }
    if(bracket.length > 0 && shorthand(contents)) { return (bracket[0] ?? '') + '[var(' + contents + ')]' + (bracket[2] ?? ''); }
    const paren = balanced(base,'(',')');
    if(paren.length > 0 && shorthand(paren[1] ?? '')) { return (paren[0] ?? '') + '[var(' + (paren[1] ?? '') + ')]' + (paren[2] ?? ''); }
    return '';
}
export function corrected(text: string, syntax: string): string {
    const parts = prefix(text); const variant = parts[0] ?? ''; const utility = parts[1] ?? '';
    let slash = -1; let depth = 0;
    for(let i = utility.length - 1; i >= 0; i--) {
        const character = utility[i] ?? '';
        if(character === ']' || character === ')') { depth++; }
        else if(character === '[' || character === '(') { depth--; }
        else if(character === '/' && depth === 0) { slash = i; break; }
    }
    const base = slash < 0 ? utility : utility.slice(0,slash);
    if(base.includes(':')) { return ''; }
    let replacement = rewrite(base,syntax); if(replacement === '') { return ''; }
    if(slash >= 0) { replacement += utility.slice(slash); }
    if(variant !== '') { replacement = variant + ':' + replacement; }
    return replacement === text ? '' : replacement;
}
export class Listener {
    readonly context: RuleContext; readonly surface: Surface; readonly syntax: string;
    constructor(context: RuleContext) { this.context = context; this.surface = new Surface(context); this.syntax = context.settings.read('syntax','shorthand'); }
    visit(index: number, parent: number): void {
        for(const literal of this.surface.literals(index)) {
            for(const text of classes(this.context.node(literal).text)) {
                const replacement = corrected(text,this.syntax); if(replacement === '') { continue; }
                const message = `The custom property in "${text}" is written as an arbitrary value. Tailwind v4 reads parentheses as a custom property and square brackets as an arbitrary value that happens to look like one, so "${replacement}" is the spelling that says what this means. Both resolve today, which is why the two forms accumulate side by side until a reader cannot tell whether a difference between two classes is deliberate. Write it as "${replacement}".`;
                report(this.context,literal,'better-tailwindcss/enforce-consistent-variable-syntax','variableSyntax',message);
            }
        }
    }
}
