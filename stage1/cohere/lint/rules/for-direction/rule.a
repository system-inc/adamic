import type { RuleContext } from '../../context.ts';
import { description } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    named(index: number, name: string): boolean {
        const node = this.context.node(this.context.unwrap(index));
        return node.kind === 'Identifier' && node.text === name;
    }
    modifications(index: number, name: string): number[] {
        const cursor = this.context.unwrap(index);
        const node = this.context.node(cursor);
        const left = node.children[0] ?? -1;
        const right = node.children[node.children.length - 1] ?? -1;
        if(node.kind === 'BinaryExpression') {
            const operator = this.context.node(node.children[1] ?? cursor).kind;
            if(operator === 'CommaToken' && left >= 0 && right >= 0) {
                return this.modifications(left, name).concat(this.modifications(right, name));
            }
            const assignments = ['EqualsToken', 'PlusEqualsToken', 'MinusEqualsToken', 'AsteriskEqualsToken',
                'AsteriskAsteriskEqualsToken', 'SlashEqualsToken', 'PercentEqualsToken', 'LessThanLessThanEqualsToken',
                'GreaterThanGreaterThanEqualsToken', 'GreaterThanGreaterThanGreaterThanEqualsToken',
                'AmpersandEqualsToken', 'BarEqualsToken', 'CaretEqualsToken', 'BarBarEqualsToken',
                'AmpersandAmpersandEqualsToken', 'QuestionQuestionEqualsToken'];
            if(assignments.includes(operator) && left >= 0 && this.named(left, name)) { return [cursor]; }
        }
        if((node.kind === 'PostfixUnaryExpression' || node.kind === 'PrefixUnaryExpression') &&
            (node.operator === 'PlusPlusToken' || node.operator === 'MinusMinusToken') &&
            left >= 0 && this.named(left, name)) { return [cursor]; }
        return [];
    }
    sign(index: number): number {
        const node = this.context.node(this.context.unwrap(index));
        if(node.kind === 'TrueKeyword') { return 1; }
        if(node.kind === 'NumericLiteral' || node.kind === 'BigIntLiteral') {
            for(const character of node.text) {
                if(character !== '0' && character !== '.') { return 1; }
            }
            return 0;
        }
        if(node.kind === 'PrefixUnaryExpression') {
            const operand = node.children[0] ?? -1;
            if(operand >= 0 && node.operator === 'MinusToken') { return -this.sign(operand); }
            if(operand >= 0 && node.operator === 'PlusToken') { return this.sign(operand); }
        }
        return 0;
    }
    direction(index: number): number {
        const node = this.context.node(index);
        if(node.kind === 'PrefixUnaryExpression' || node.kind === 'PostfixUnaryExpression') {
            return node.operator === 'PlusPlusToken' ? 1 : node.operator === 'MinusMinusToken' ? -1 : 0;
        }
        if(node.kind === 'BinaryExpression') {
            const operator = this.context.node(node.children[1] ?? index).kind;
            const right = node.children[2] ?? -1;
            if(right >= 0 && operator === 'PlusEqualsToken') { return this.sign(right); }
            if(right >= 0 && operator === 'MinusEqualsToken') { return -this.sign(right); }
        }
        return 0;
    }
    visit(index: number): void {
        // Missing for clauses have no placeholder nodes. Only scan gaps between
        // direct children, so semicolons inside an initializer never count.
        const children = this.context.node(index).children;
        let previous = this.context.start(index);
        let segment = 0;
        let condition = -1;
        let update = -1;
        for(let position = 0; position < children.length - 1; position++) {
            const child = children[position] ?? -1;
            if(child < 0) { continue; }
            const end = this.context.start(child);
            this.context.scanner.pos = previous;
            while(this.context.scanner.scan() !== 'EndOfFile' && this.context.scanner.start < end) {
                if(this.context.scanner.kind === 'SemicolonToken') { segment++; }
            }
            if(segment === 1) { condition = child; }
            if(segment === 2) { update = child; }
            previous = this.context.node(child).end;
        }
        if(condition < 0 || update < 0) { return; }
        const binary = this.context.node(this.context.unwrap(condition));
        if(binary.kind !== 'BinaryExpression') { return; }
        const operator = this.context.node(binary.children[1] ?? condition).kind;
        let wrongLeft = 0;
        if(operator === 'LessThanToken' || operator === 'LessThanEqualsToken') { wrongLeft = -1; }
        if(operator === 'GreaterThanToken' || operator === 'GreaterThanEqualsToken') { wrongLeft = 1; }
        if(wrongLeft === 0) { return; }
        for(let side = 0; side < 2; side++) {
            const operand = binary.children[side === 0 ? 0 : 2] ?? -1;
            if(operand < 0) { continue; }
            const node = this.context.node(this.context.unwrap(operand));
            if(node.kind !== 'Identifier') { continue; }
            const modifications = this.modifications(update, node.text);
            if(modifications.length !== 1) { continue; }
            const direction = this.direction(modifications[0] ?? update);
            const wrong = side === 0 ? wrongLeft : -wrongLeft;
            if(direction === wrong) {
                this.context.report(index, 'for-direction', 'incorrectDirection', description, '', '', '');
                return;
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
