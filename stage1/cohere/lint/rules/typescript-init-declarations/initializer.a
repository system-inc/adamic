import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';

// Scan between children so whitespace, comments and a preceding type annotation do not hide '='.
export function hasInitializer(context: RuleContext, declaration: ParseNode): boolean {
    let previous = declaration.pos;
    for(const index of declaration.children) {
        const child = context.node(index);
        if(context.scanAt(previous) === 'EqualsToken') {
            return true;
        }
        previous = child.end;
    }
    return false;
}
