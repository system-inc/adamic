import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { hasInitializer } from './initializer.a';
import { initializedMessage, notInitializedMessage } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    readonly mode: string;
    readonly ignoreForLoopInit: boolean;
    constructor(context: RuleContext) {
        this.context = context;
        this.mode = context.settings.read('mode', '');
        this.ignoreForLoopInit = context.settings.read('ignoreforloopinit', 'false') === 'true';
    }
    visit(node: ParseNode, index: number): void {
        if(this.mode !== 'always' && this.mode !== 'never') {
            return;
        }
        const parent = this.context.parent(index);
        // The stage 1 tree retains declare modifiers rather than propagating ambient flags.
        for(let ancestor = parent; ancestor >= 0; ancestor = this.context.parent(ancestor)) {
            if(this.context.has(ancestor, 'DeclareKeyword')) {
                return;
            }
        }
        const parentKind = parent < 0 ? '' : this.context.node(parent).kind;
        const loop =
            parentKind === 'ForStatement' || parentKind === 'ForInStatement' || parentKind === 'ForOfStatement';
        const constant = (Number(node.semantic) & 6) !== 0;
        for(const declarationIndex of node.children) {
            const declaration = this.context.node(declarationIndex);
            const nameIndex = declaration.children[0] ?? -1;
            if(nameIndex < 0) {
                continue;
            }
            const name = this.context.node(nameIndex);
            if(name.kind !== 'Identifier') {
                continue;
            }
            const initialized = loop || hasInitializer(this.context, declaration);
            if(this.mode === 'always' && !initialized) {
                this.context.report(
                    nameIndex,
                    '@typescript-eslint/init-declarations',
                    'initialized',
                    initializedMessage(name.text),
                    '',
                    '',
                    '',
                );
            }
            if(this.mode === 'never' && initialized && !constant && !(loop && this.ignoreForLoopInit)) {
                this.context.report(
                    declarationIndex,
                    '@typescript-eslint/init-declarations',
                    'notInitialized',
                    notInitializedMessage(name.text),
                    '',
                    '',
                    '',
                );
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
