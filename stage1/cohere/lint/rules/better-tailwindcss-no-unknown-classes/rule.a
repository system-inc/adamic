import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Finding } from '../../finding.ts';
import { Reader } from '../better-tailwindcss-no-deprecated-classes/reader.a';
import { fields } from '../better-tailwindcss-no-duplicate-classes/core.a';
import { classExistsIn,message } from './core.a';
export class Rule {
    readonly context: RuleContext;readonly reader: Reader;
    systemPresent=false;
    resolve: (name: string)=>boolean = name=>panic('NotYet: live Tailwind candidate resolver');
    ignored: (name: string)=>boolean = name=>false;
    constructor(context: RuleContext) { this.context=context;this.reader=new Reader(context); }
    bind(resolve: (name: string)=>boolean,ignored: (name: string)=>boolean): void {
        this.resolve=resolve;this.ignored=ignored;this.systemPresent=true;
    }
    visit(index: number): void {
        if(!this.systemPresent) { panic('NotYet: live Tailwind design-system and program adapter'); }
        for(const literal of this.reader.read(index).literals) {
            for(const name of fields(literal.text)) {
                if(this.ignored(name) || classExistsIn(name,true,this.resolve)) { continue; }
                this.context.findings.push(new Finding('better-tailwindcss/no-unknown-classes','unknownClass',message(name),literal.start,literal.end,'','',''));
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
