{
  "command": [
    "go",
    "test",
    "-json",
    "-count=1",
    "-timeout",
    "3h",
    "./stage1/cohere/lint"
  ],
  "environment": {
    "ADAMIC_TYPESCRIPT_SOURCE": "/workspace/wave19-typescript",
    "ADAMIC_LINT_BENCH": "1",
    "ADAMIC_LINT_PROFILE_DIR": "/tmp/wave19-facts-full/profiles",
    "ADAMIC_LINT_PROFILE_SNAPSHOTS": "/tmp/wave19-facts-full/profiles",
    "GOCACHE": "/tmp/wave19-unpark-cache/go-build",
    "XDG_CACHE_HOME": "/tmp/wave19-unpark-cache",
    "TMPDIR": "/tmp/adamic-gate",
    "GOMAXPROCS": "4"
  }
}
