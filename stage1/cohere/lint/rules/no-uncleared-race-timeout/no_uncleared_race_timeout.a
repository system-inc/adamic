import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { Rules } from './context.a';
import { Bindings } from './bindings.a';
import { RuntimeContext } from './runtime_context.a';
import { Diagnostic } from '../../../typeaware/diagnostic.ts';

const message =
    'This `setTimeout` arms the losing side of a `Promise.race`, and its handle is thrown away, so nothing can ever clear it. When the work wins the race, the timer stays armed for its whole duration: in Node it holds the process open (a batch that finished its last item sits until the timeout elapses), and its callback still runs, rejecting a promise nobody is waiting on. Keep the handle (`timer = setTimeout(...)`) and `clearTimeout(timer)` in a `finally` around the race.';
export class NoUnclearedRaceTimeout {
    readonly discriminator = 'race-timeout';
    readonly rules: Rules;
    readonly bindings: Bindings;
    readonly context: RuntimeContext;
    constructor(rules: Rules) {
        this.rules = rules;
        this.bindings = new Bindings(rules);
        this.context = new RuntimeContext(rules);
    }
    parent(index: number): number {
        return this.rules.parents[index] ?? -1;
    }
    outer(index: number): number {
        let current = index;
        while(
            this.parent(current) >= 0 &&
            this.rules.parser.node(this.parent(current)).kind === 'ParenthesizedExpression'
        ) {
            current = this.parent(current);
        }
        return current;
    }
    assignment(index: number): boolean {
        const outer = this.outer(index);
        const parent = this.rules.parser.node(this.parent(outer));
        return (
            parent.kind === 'BinaryExpression' &&
            parent.children[0] === outer &&
            this.rules.parser.node(parent.children[1] ?? -1).kind === 'EqualsToken'
        );
    }
    neverRead(index: number): boolean {
        const declarations = this.bindings.declarations(index);
        if(declarations.length !== 1) {
            return false;
        }
        const declaration = declarations[0] ?? -1;
        if(this.rules.parser.node(declaration).kind !== 'VariableDeclaration') {
            return false;
        }
        const name = this.bindings.shape.name(declaration);
        const text = this.rules.parser.node(name).text;
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at);
            if(at === name || this.parent(at) < 0 || node.kind !== 'Identifier' || node.text !== text) {
                continue;
            }
            if(this.bindings.declarations(at).includes(declaration) && !this.assignment(at)) {
                return false;
            }
        }
        return true;
    }
    lost(executor: number, index: number): boolean {
        const outer = this.outer(index);
        const above = this.parent(outer);
        const parent = this.rules.parser.node(above);
        if(['ExpressionStatement', 'VoidExpression'].includes(parent.kind) || above === executor) {
            return true;
        }
        if(parent.kind === 'VariableDeclaration' && parent.children[parent.children.length - 1] === outer) {
            const name = this.bindings.shape.name(above);
            return this.rules.parser.node(name).kind === 'Identifier' && this.neverRead(name);
        }
        if(
            parent.kind !== 'BinaryExpression' ||
            parent.children[2] !== outer ||
            this.rules.parser.node(parent.children[1] ?? -1).kind !== 'EqualsToken'
        ) {
            return false;
        }
        const target = this.rules.skip(parent.children[0] ?? -1);
        if(this.rules.parser.node(target).kind !== 'Identifier') {
            return false;
        }
        return (
            this.rules.parser.node(this.parent(this.outer(above))).kind === 'ExpressionStatement' &&
            this.neverRead(target)
        );
    }
    globalTimer(index: number): boolean {
        const node = this.rules.parser.node(index);
        let name = this.rules.skip(node.children[0] ?? -1);
        const callee = this.rules.parser.node(name);
        if(callee.kind === 'PropertyAccessExpression') {
            const receiver = this.rules.parser.node(this.rules.skip(callee.children[0] ?? -1));
            if(receiver.kind !== 'Identifier' || !['globalThis', 'window'].includes(receiver.text)) {
                return false;
            }
            name = callee.children[callee.children.length - 1] ?? -1;
        }
        const target = this.rules.parser.node(name);
        return target.kind === 'Identifier' && target.text === 'setTimeout' && this.context.timer(name);
    }
    visit(index: number, executor: number): void {
        const node = this.rules.parser.node(index);
        if(this.bindings.functionKind(node.kind) || ['ClassDeclaration', 'ClassExpression'].includes(node.kind)) {
            return;
        }
        if(node.kind === 'CallExpression' && this.globalTimer(index) && this.lost(executor, index)) {
            this.rules.findings.push(
                new Diagnostic(
                    'nexus/correctness-no-uncleared-race-timeout',
                    'unclearedRaceTimeout',
                    message,
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    '',
                ),
            );
        }
        for(const child of node.children) {
            this.visit(child, executor);
        }
    }
    promise(index: number): number {
        let current = this.rules.skip(index);
        let node = this.rules.parser.node(current);
        if(node.kind === 'Identifier') {
            const declarations = this.bindings.declarations(current);
            if(declarations.length !== 1) {
                return -1;
            }
            const declared = declarations[0] ?? -1;
            const declaration = this.rules.parser.node(declared);
            const list = this.rules.parser.node(this.parent(declared));
            if(
                declaration.kind !== 'VariableDeclaration' ||
                list.kind !== 'VariableDeclarationList' ||
                !this.rules.text(list).startsWith('const') ||
                declaration.children.length < 2
            ) {
                return -1;
            }
            current = this.rules.skip(declaration.children[declaration.children.length - 1] ?? -1);
            node = this.rules.parser.node(current);
        }
        if(node.kind !== 'NewExpression') {
            return -1;
        }
        const constructor = this.rules.skip(node.children[0] ?? -1);
        const callee = this.rules.parser.node(constructor);
        if(
            callee.kind !== 'Identifier' ||
            callee.text !== 'Promise' ||
            !this.context.symbol(constructor).declarations.some((declaration) => declaration.library)
        ) {
            return -1;
        }
        return current;
    }
    race(index: number, supplied: ParseNode | undefined = undefined): void {
        const call = supplied ?? this.rules.parser.node(index);
        const callee = this.rules.parser.node(this.rules.skip(call.children[0] ?? -1));
        if(callee.kind !== 'PropertyAccessExpression' || call.list < 1) {
            return;
        }
        const name = callee.children[callee.children.length - 1] ?? -1;
        if(this.rules.parser.node(name).text !== 'race' || !this.context.libraryMember(name, 'PromiseConstructor')) {
            return;
        }
        const argument = call.children[call.children.length - call.list] ?? -1;
        const array = this.rules.parser.node(this.rules.skip(argument));
        if(array.kind !== 'ArrayLiteralExpression') {
            return;
        }
        for(const element of array.children) {
            const promise = this.promise(element);
            if(promise < 0) {
                continue;
            }
            const construction = this.rules.parser.node(promise);
            if(construction.list < 1) {
                continue;
            }
            const executor = this.rules.skip(
                construction.children[construction.children.length - construction.list] ?? -1,
            );
            const functionNode = this.rules.parser.node(executor);
            if(!['ArrowFunction', 'FunctionExpression'].includes(functionNode.kind)) {
                continue;
            }
            this.visit(functionNode.children[functionNode.children.length - 1] ?? -1, executor);
        }
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if(this.parent(index) >= 0 && this.rules.parser.node(index).kind === 'CallExpression') {
                this.race(index);
            }
        }
    }
}
