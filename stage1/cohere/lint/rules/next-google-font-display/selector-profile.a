import { panic, programArguments, readTextFile } from 'adamic';
import { evaluate, description } from './rule.a';
import { written } from '../../../../typescript/parser/nodes.ts';
const args = programArguments();
const read = readTextFile(args[0] ?? panic('manifest'));
if(read.kind === 'Error') { panic(read.message); }
let count = 0;
for(const row of read.text.split('\n')) {
    if(row === '') { continue; }
    const columns = row.split('\t');
    const id = evaluate(columns[1] ?? '', columns[2] ?? '', columns[3] === 'literal', columns[4] ?? '');
    if(id !== '') { count++; }
    if(!args.includes('--count')) { console.log(`${id}\t${written(description(id))}`); }
}
if(args.includes('--count')) { console.log(`${count}`); }
