import { panic, programArguments, readTextFile } from 'adamic';
import { diagnostic } from '../decision.ts';
import { missing, discouraged } from '../messages.ts';
const file = readTextFile(programArguments()[0] ?? panic('missing corpus'));
if(file.kind === 'Error') { panic(file.message); }
let index = 0;
for(const href of file.text.split('\n')) {
    if(href === '') { continue; }
    const id = diagnostic(href);
    console.log(`${index}\t${id}\t${id === '' ? '' : id === 'googleFontDisplayMissing' ? missing : discouraged}`);
    index++;
}
