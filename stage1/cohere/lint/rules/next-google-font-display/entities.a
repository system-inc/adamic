function named(item: string): string {
    const value0 = named0(item);
    if(value0 !== '') { return value0; }
    const value1 = named1(item);
    if(value1 !== '') { return value1; }
    const value2 = named2(item);
    if(value2 !== '') { return value2; }
    const value3 = named3(item);
    if(value3 !== '') { return value3; }
    const value4 = named4(item);
    if(value4 !== '') { return value4; }
    const value5 = named5(item);
    if(value5 !== '') { return value5; }
    const value6 = named6(item);
    if(value6 !== '') { return value6; }
    const value7 = named7(item);
    if(value7 !== '') { return value7; }
    return `&${item};`;
}
function decoded(item: string): string {
    if(!item.startsWith('#')) { return named(item); }
    const hex = item.startsWith('#x');
    const digits = item.slice(hex ? 2 : 1);
    if(digits.length === 0) { return `&${item};`; }
    let value = 0;
    for(const character of digits) {
        const digit = (hex ? '0123456789abcdef' : '0123456789').indexOf(character.toLowerCase());
        if(digit < 0) { return `&${item};`; }
        value = Math.min(1114112, value * (hex ? 16 : 10) + digit);
    }
    if(value > 1114111) { return `&${item};`; }
    return String.fromCodePoint(value >= 55296 && value <= 57343 ? 65533 : value);
}
export function unescape(text: string): string {
    let result = '';
    let index = 0;
    while(index < text.length) {
        if(text[index] !== '&') { result += text[index] ?? ''; index++; continue; }
        const semicolon = text.indexOf(';', index);
        if(semicolon < index + 2) { result += '&'; index++; continue; }
        const item = text.slice(index + 1, semicolon);
        const replacement = decoded(item);
        if(replacement === `&${item};`) { result += '&'; index++; }
        else { result += replacement; index = semicolon + 1; }
    }
    return result;
}
