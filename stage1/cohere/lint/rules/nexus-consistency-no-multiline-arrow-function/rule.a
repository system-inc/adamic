import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { Finding } from '../../finding.ts';
import { message } from './messages.a';
import { first, last, trim } from './helpers.a';

function claimed(context: RuleContext, node: ParseNode): string {
    if(node.kind !== 'CallExpression') {
        return '';
    }
    const callee = node.children[0] ?? -1;
    if(callee < 0 || context.node(callee).kind !== 'PropertyAccessExpression') {
        return '';
    }
    const property = context.node(last(context, callee)).text;
    const receiver = context.node(first(context, callee));
    if(
        receiver.kind === 'Identifier' &&
        receiver.text === 'React' &&
        (property === 'forwardRef' || property.startsWith('use'))
    ) {
        return property;
    }
    return property === 'addEventListener' ? property : '';
}
function inherited(context: RuleContext, index: number, onlyThis: boolean): boolean {
    const node = context.node(index);
    if(node.kind === 'ThisKeyword') {
        return true;
    }
    if(
        !onlyThis &&
        (node.kind === 'SuperKeyword' || (node.kind === 'MetaProperty' && node.operator === 'NewKeyword'))
    ) {
        return true;
    }
    if(!onlyThis && node.kind === 'Identifier' && node.text === 'arguments') {
        const owner = context.parent(index);
        if(owner < 0) {
            return true;
        }
        const kind = context.node(owner).kind;
        if(kind === 'PropertyAccessExpression' && last(context, owner) === index) {
            return false;
        }
        if(
            [
                'PropertyAssignment',
                'PropertyDeclaration',
                'PropertySignature',
                'MethodDeclaration',
                'MethodSignature',
            ].includes(kind) &&
            context.name(owner) === index
        ) {
            return false;
        }
        return true;
    }
    if(
        ['FunctionDeclaration', 'FunctionExpression', 'MethodDeclaration'].includes(node.kind) ||
        (onlyThis
            ? ['ClassDeclaration', 'ClassExpression'].includes(node.kind)
            : ['Constructor', 'GetAccessor', 'SetAccessor'].includes(node.kind))
    ) {
        return false;
    }
    for(const child of node.children) {
        if(inherited(context, child, onlyThis)) {
            return true;
        }
    }
    return false;
}
function report(context: RuleContext, node: ParseNode, index: number, id: string, fields: string[]): void {
    let safe = true;
    for(const child of node.children) {
        if(inherited(context, child, false)) {
            safe = false;
        }
    }
    let signatureStart = context.start(index);
    let async = '';
    let arrowStart = -1;
    let genericEnd = -1;
    for(const child of node.children) {
        const part = context.node(child);
        if(part.kind === 'AsyncKeyword') {
            async = 'async ';
            context.scanAt(part.end);
            signatureStart = context.scanStart();
        }
        if(part.kind === 'TypeParameter') {
            genericEnd = part.end;
        }
        if(part.kind === 'EqualsGreaterThanToken') {
            arrowStart = context.start(child);
        }
    }
    let generics = '';
    let parametersStart = signatureStart;
    if(genericEnd >= 0) {
        context.scanAt(genericEnd);
        if(context.scanner.kind === 'CommaToken') {
            context.scanAt(context.scanEnd());
        }
        const angle = context.scanStart();
        if(angle >= arrowStart || context.source[angle] !== '>') {
            safe = false;
        }
        generics = trim(context.source.slice(signatureStart, angle + 1));
        parametersStart = angle + 1;
    }
    if(arrowStart < parametersStart) {
        safe = false;
    }
    let signature = trim(context.source.slice(parametersStart, arrowStart));
    if(!signature.startsWith('(')) {
        signature = `(${signature})`;
    }
    let body = node.children[node.children.length - 1] ?? -1;
    const block = context.node(body).kind === 'Block';
    if(!block) {
        body = context.unwrap(body);
    }
    const bodyText = block ? context.raw(body) : `{ return ${context.raw(body)}; }`;
    let replacement = `${async}function${generics}${signature} ${bodyText}`;
    for(let cursor = index; context.parent(cursor) >= 0;) {
        cursor = context.parent(cursor);
        if(context.start(cursor) !== context.start(index)) {
            break;
        }
        if(context.node(cursor).kind === 'ExpressionStatement') {
            replacement = `(${replacement})`;
            break;
        }
    }
    const rule = 'nexus/consistency-no-multiline-arrow-function';
    context.findings.push(
        new Finding(
            rule,
            id,
            message(id, fields),
            context.start(index),
            node.end,
            safe ? 'fix' : '',
            safe ? replacement : '',
            '',
        ),
    );
}
function noMultilineArrowFunction(context: RuleContext, node: ParseNode, index: number): void {
    if(node.kind === 'CallExpression') {
        const kind = claimed(context, node);
        if(kind === '') {
            return;
        }
        const argumentsStart = node.children.length - Math.max(0, node.list);
        const argument = node.children[argumentsStart + (kind === 'addEventListener' ? 1 : 0)] ?? -1;
        if(argument < 0) {
            return;
        }
        const arrow = context.node(argument);
        if(arrow.kind === 'ArrowFunction') {
            report(
                context,
                arrow,
                argument,
                kind === 'addEventListener' ? 'addEventListenerArrow' : 'reactHookArrow',
                kind === 'addEventListener' ? [] : ['hookName', kind],
            );
        }
        return;
    }
    const body = node.children[node.children.length - 1] ?? -1;
    if(body < 0 || context.node(body).kind !== 'Block' || inherited(context, body, true)) {
        return;
    }
    if(context.line(context.start(index)) === context.line(node.end)) {
        return;
    }
    const owner = context.parent(index);
    if(owner >= 0 && claimed(context, context.node(owner)) !== '') {
        return;
    }
    report(context, node, index, 'multilineArrow', []);
}

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        noMultilineArrowFunction(this.context, node, index);
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
