import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';
import { precedence, wrapped } from './precedence.a';

const name = '@typescript-eslint/consistent-type-assertions';
function setting(value: string, values: readonly string[], fallback: string): string {
    return values.includes(value) ? value : fallback;
}
export class Rule {
    readonly context: RuleContext;
    readonly style: string;
    readonly object: string;
    readonly array: string;
    constructor(context: RuleContext) {
        this.context = context;
        this.style = setting(context.settings.read('assertionstyle', 'as'), ['as', 'angle-bracket', 'never'], 'as');
        this.object = setting(context.settings.read('objectliteraltypeassertions', 'allow'), ['allow', 'allow-as-parameter', 'never'], 'allow');
        this.array = setting(context.settings.read('arrayliteraltypeassertions', 'allow'), ['allow', 'allow-as-parameter', 'never'], 'allow');
    }
    parent(index: number): number { return this.context.parents[index] ?? -1; }
    text(index: number): string { return this.context.source.slice(this.context.start(index), this.context.node(index).end); }
    constant(type: number): boolean {
        const node = this.context.node(type);
        if(node.kind !== 'TypeReference') { return false; }
        const identifier = node.children[0] ?? -1;
        return identifier >= 0 && this.context.node(identifier).kind === 'Identifier' && this.context.node(identifier).text === 'const';
    }
    parameter(index: number): boolean {
        const parent = this.parent(index);
        if(parent < 0) { return false; }
        const node = this.context.node(parent);
        if(['NewExpression', 'CallExpression', 'ThrowStatement', 'JsxExpression'].includes(node.kind)) { return true; }
        if(['Parameter', 'BindingElement'].includes(node.kind)) { return node.children[node.children.length - 1] === index; }
        if(node.kind === 'TemplateSpan') {
            const template = this.parent(parent);
            const tag = template < 0 ? -1 : this.parent(template);
            return tag >= 0 && this.context.node(tag).kind === 'TaggedTemplateExpression';
        }
        return false;
    }
    precedence(index: number, parent: boolean): number {
        const node = this.context.node(index);
        const operator = node.kind === 'BinaryExpression' ? this.context.node(node.children[1] ?? panic('missing binary operator')).kind : node.operator;
        return precedence(node, parent, operator);
    }
    visit(index: number): void {
        const node = this.context.node(index);
        if(!['AsExpression', 'TypeAssertionExpression'].includes(node.kind)) { return; }
        const angle = node.kind === 'TypeAssertionExpression';
        const expression = node.children[angle ? 1 : 0] ?? panic('NotYet: assertion expression child');
        const type = node.children[angle ? 0 : 1] ?? panic('NotYet: assertion type child');
        const cast = this.text(type);
        if(this.style !== (angle ? 'angle-bracket' : 'as')) {
            if(this.style === 'never') {
                if(!this.constant(type)) { this.context.report(index, name, 'never', 'Do not use any type assertions.', '', '', ''); }
                return;
            }
            if(this.style === 'angle-bracket') {
                this.context.report(index, name, 'angle-bracket', `Use '<${cast}>' instead of 'as ${cast}'.`, '', '', '');
                return;
            }
            const operand = this.context.node(expression);
            const operandPrecedence = operand.kind === 'ExpressionWithTypeArguments' ? 0 : this.precedence(expression, false);
            let replacement = `${wrapped(this.text(expression), operandPrecedence, 11)} as ${cast}`;
            const parent = this.parent(index);
            if(parent < 0 || this.context.node(parent).kind !== 'ParenthesizedExpression') {
                const ancestor = parent < 0 ? -1 : this.precedence(parent, true);
                const arrowBody = parent >= 0 && this.context.node(parent).kind === 'ArrowFunction' && this.context.node(parent).children[this.context.node(parent).children.length - 1] === index;
                replacement = wrapped(replacement, 11, arrowBody ? 21 : ancestor);
            }
            this.context.report(index, name, 'as', `Use 'as ${cast}' instead of '<${cast}>'.`, 'fix', replacement, '');
            return;
        }
        const literal = this.context.node(expression).kind;
        if(!['ObjectLiteralExpression', 'ArrayLiteralExpression'].includes(literal)) { return; }
        const object = literal === 'ObjectLiteralExpression';
        const policy = object ? this.object : this.array;
        if(policy === 'allow' || (policy === 'allow-as-parameter' && this.parameter(index))) { return; }
        if(['AnyKeyword', 'UnknownKeyword'].includes(this.context.node(type).kind) || this.constant(type)) { return; }
        const prefix = object ? 'Object' : 'Array';
        const pattern = object ? '{ ... }' : '[ ... ]';
        const report = this.context.report(index, name, `unexpected${prefix}TypeAssertion`, object ? 'Always prefer const x: T = { ... }.' : 'Always prefer const x: T[] = [ ... ].', '', '', '');
        const start = this.context.start(index);
        const end = node.end;
        const parent = this.parent(index);
        if(parent >= 0) {
            const declaration = this.context.node(parent);
            if(declaration.kind === 'VariableDeclaration' && declaration.children.length === 2 && declaration.children[1] === index) {
                const binding = declaration.children[0] ?? panic('missing binding');
                const position = this.context.node(binding).end;
                report.suggestions.push(new Suggestion(`replace${prefix}TypeAssertionWithAnnotation`, `Use const x: ${cast} = ${pattern} instead.`, [new SuggestionEdit(position, position, `: ${cast}`), new SuggestionEdit(start, end, this.text(expression))]));
            }
        }
        report.suggestions.push(new Suggestion(`replace${prefix}TypeAssertionWithSatisfies`, `Use const x = ${pattern} satisfies ${cast} instead.`, [new SuggestionEdit(start, end, `${this.text(expression)} satisfies ${cast}`)]));
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
