import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { Bindings } from './bindings.a';
import type { RuleContext } from '../../context.ts';
import { abbreviation } from './abbreviation_vocabulary.a';
import { betweenToken, emit, foreign, last, name, parent } from './helpers.a';

function binding(context: RuleContext, index: number): number {
    const node = context.node(index);
    if(node.kind === 'PropertyAccessExpression' || node.kind === 'ImportSpecifier' || node.kind === 'ExportSpecifier') {
        return last(context, index);
    }
    if(node.kind === 'BindingElement') {
        const parts = node.children.filter((child) => context.node(child).kind !== 'DotDotDotToken');
        const one = parts[0] ?? -1;
        const two = parts[1] ?? -1;
        if(one >= 0 && two >= 0 && betweenToken(context, context.node(one).end, context.start(two), 'ColonToken')) {
            return two;
        }
        return one;
    }
    if(
        [
            'VariableDeclaration',
            'Parameter',
            'ImportClause',
            'NamespaceImport',
            'ImportEqualsDeclaration',
            'FunctionDeclaration',
            'FunctionExpression',
            'ClassDeclaration',
            'ClassExpression',
            'TypeParameter',
            'InterfaceDeclaration',
            'TypeAliasDeclaration',
            'PropertyAssignment',
            'ShorthandPropertyAssignment',
            'PropertySignature',
            'PropertyDeclaration',
            'MethodDeclaration',
            'MethodSignature',
            'GetAccessor',
            'SetAccessor',
            'EnumMember',
            'ModuleDeclaration',
        ].includes(node.kind)
    ) {
        return name(context, index);
    }
    return -1;
}
function nonbinding(kind: string): boolean {
    return [
        'PropertyAssignment',
        'ShorthandPropertyAssignment',
        'PropertyAccessExpression',
        'PropertySignature',
        'PropertyDeclaration',
        'MethodDeclaration',
        'MethodSignature',
        'GetAccessor',
        'SetAccessor',
        'ExportSpecifier',
        'EnumMember',
        'JsxAttribute',
    ].includes(kind);
}
function rest(context: RuleContext, index: number): boolean {
    const owner = parent(context, index);
    return (
        owner >= 0 &&
        ['Parameter', 'BindingElement'].includes(context.node(owner).kind) &&
        binding(context, owner) === index &&
        context.has(owner, 'DotDotDotToken')
    );
}
function prepareBindings(context: RuleContext, state: Bindings): void {
    if(state.bindingsReady) {
        return;
    }
    for(let index = 0; index < context.parser.nodes.length; index++) {
        const node = context.node(index);
        if(node.kind !== 'Identifier') {
            continue;
        }
        const owner = parent(context, index);
        if(owner < 0 || binding(context, owner) !== index) {
            continue;
        }
        const kind = context.node(owner).kind;
        const importBinding = [
            'ImportClause',
            'NamespaceImport',
            'ImportSpecifier',
            'ImportEqualsDeclaration',
        ].includes(kind);
        if(importBinding || !nonbinding(kind)) {
            state.recordBinding(node.text, importBinding, rest(context, index));
        }
    }
    state.completeBindings();
}
function imported(context: RuleContext, text: string, state: Bindings): boolean {
    prepareBindings(context, state);
    return state.importedNames.has(text);
}
function onlyRest(context: RuleContext, state: Bindings): boolean {
    prepareBindings(context, state);
    return state.argsBound && !state.argsNonRest;
}
function nested(context: RuleContext, index: number): boolean {
    const owner = parent(context, index);
    if(owner < 0 || binding(context, owner) !== index) {
        return false;
    }
    const kind = context.node(owner).kind;
    if(['Parameter', 'BindingElement'].includes(kind)) {
        return true;
    }
    if(['FunctionDeclaration', 'ClassDeclaration'].includes(kind)) {
        const ancestor = parent(context, owner);
        return ancestor < 0 || context.node(ancestor).kind !== 'SourceFile';
    }
    if(kind === 'VariableDeclaration') {
        const ancestor = parent(context, parent(context, parent(context, owner)));
        return ancestor < 0 || context.node(ancestor).kind !== 'SourceFile';
    }
    return false;
}
function routeContract(path: string, text: string): boolean {
    const segments = path.split('\\').join('/').split('/');
    const base = segments[segments.length - 1] ?? '';
    if(!segments.slice(0, -1).includes('app')) {
        return false;
    }
    let stem = '';
    for(const extension of ['.tsx', '.ts', '.jsx', '.js']) {
        if(base.endsWith(extension)) {
            stem = base.slice(0, -extension.length);
            break;
        }
    }
    let numberless = stem;
    while(
        numberless !== '' &&
        (numberless[numberless.length - 1] ?? '') >= '0' &&
        (numberless[numberless.length - 1] ?? '') <= '9'
    ) {
        numberless = numberless.slice(0, -1);
    }
    if(['icon', 'apple-icon', 'opengraph-image', 'twitter-image'].includes(numberless)) {
        stem = numberless;
    }
    if(
        ![
            'page',
            'layout',
            'route',
            'icon',
            'apple-icon',
            'opengraph-image',
            'twitter-image',
            'sitemap',
            'robots',
            'manifest',
        ].includes(stem)
    ) {
        return false;
    }
    if(
        [
            'config',
            'generateStaticParams',
            'unstable_instant',
            'unstable_dynamicStaleTime',
            'revalidate',
            'dynamic',
            'dynamicParams',
            'fetchCache',
            'preferredRegion',
            'runtime',
            'maxDuration',
        ].includes(text)
    ) {
        return true;
    }
    if(
        ['page', 'layout'].includes(stem) &&
        ['metadata', 'generateMetadata', 'viewport', 'generateViewport'].includes(text)
    ) {
        return true;
    }
    if(stem === 'route' && ['GET', 'HEAD', 'OPTIONS', 'POST', 'PUT', 'DELETE', 'PATCH'].includes(text)) {
        return true;
    }
    if(
        ['icon', 'apple-icon', 'opengraph-image', 'twitter-image'].includes(stem) &&
        ['alt', 'size', 'contentType', 'generateImageMetadata'].includes(text)
    ) {
        return true;
    }
    return stem === 'sitemap' && text === 'generateSitemaps';
}
function filePattern(context: RuleContext, option: string): boolean {
    for(const pattern of context.settings.list(option, [])) {
        if(pattern !== '' && context.parser.path.split('\\').join('/').includes(pattern)) {
            return true;
        }
    }
    return false;
}
function frameworkName(context: RuleContext, text: string): boolean {
    if(context.settings.list('frameworkparameterscopenames', []).includes(text)) {
        return true;
    }
    let base = text;
    for(const suffix of ['Properties', 'Interface', 'Options', 'Type']) {
        if(base.endsWith(suffix)) {
            base = base.slice(0, -suffix.length);
        }
    }
    for(const suffix of context.settings.list('frameworkparameterscopesuffixes', [])) {
        if(text.endsWith(suffix) || base.endsWith(suffix)) {
            return true;
        }
    }
    return false;
}
function frameworkScope(context: RuleContext, index: number): boolean {
    let sawFunction = false;
    let sawType = false;
    for(let cursor = parent(context, index); cursor >= 0; cursor = parent(context, cursor)) {
        const kind = context.node(cursor).kind;
        let candidate = -1;
        if(!sawFunction && ['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction'].includes(kind)) {
            sawFunction = true;
            candidate =
                kind === 'FunctionDeclaration'
                    ? name(context, cursor)
                    : parent(context, cursor) >= 0 &&
                        context.node(parent(context, cursor)).kind === 'VariableDeclaration'
                      ? name(context, parent(context, cursor))
                      : -1;
        }
        if(!sawType && ['InterfaceDeclaration', 'TypeAliasDeclaration'].includes(kind)) {
            sawType = true;
            candidate = name(context, cursor);
        }
        if(candidate >= 0 && frameworkName(context, context.node(candidate).text)) {
            return true;
        }
    }
    return false;
}
function referenceProperty(context: RuleContext, index: number): boolean {
    const owner = parent(context, index);
    if(owner < 0) {
        return false;
    }
    const kind = context.node(owner).kind;
    if(
        kind === 'PropertySignature' ||
        kind === 'ShorthandPropertyAssignment' ||
        (kind === 'BindingElement' && binding(context, owner) === index)
    ) {
        return true;
    }
    for(let cursor = owner; cursor >= 0; cursor = parent(context, cursor)) {
        if(!['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction'].includes(context.node(cursor).kind)) {
            continue;
        }
        for(const parameter of context.node(cursor).children) {
            if(context.node(parameter).kind !== 'Parameter') {
                continue;
            }
            const pattern = name(context, parameter);
            if(pattern < 0 || context.node(pattern).kind !== 'ObjectBindingPattern') {
                continue;
            }
            for(const element of context.node(pattern).children) {
                const bound = binding(context, element);
                if(bound >= 0 && context.node(bound).kind === 'Identifier' && context.node(bound).text === 'ref') {
                    return true;
                }
            }
        }
    }
    return false;
}
function noAbbreviatedIdentifier(context: RuleContext, node: ParseNode, index: number, state: Bindings): void {
    const text = node.text;
    const finding = abbreviation(text);
    if(finding === undefined) {
        return;
    }
    const owner = parent(context, index);
    const typeKey =
        owner >= 0 &&
        ['PropertySignature', 'MethodSignature'].includes(context.node(owner).kind) &&
        name(context, owner) === index;
    if(foreign(context, index) && !typeKey) {
        return;
    }
    if(imported(context, text, state) || (routeContract(context.parser.path, text) && !nested(context, index))) {
        return;
    }
    if(
        finding.word === 'params' &&
        ['whole', 'suffix'].includes(finding.form) &&
        (filePattern(context, 'frameworkparameterfilepatterns') || frameworkScope(context, index))
    ) {
        return;
    }
    if(finding.form === 'whole') {
        if(finding.word === 'ref' && referenceProperty(context, index)) {
            return;
        }
        if(finding.word === 'config' && filePattern(context, 'frameworkconstantfilepatterns')) {
            return;
        }
        if(finding.word === 'args' && (rest(context, index) || onlyRest(context, state))) {
            return;
        }
    }
    emit(context, index, 'nexus/consistency-no-abbreviated-identifier', finding.id, finding.fields);
}

export class Rule {
    readonly context: RuleContext;
    readonly bindings: Bindings = new Bindings();
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        noAbbreviatedIdentifier(this.context, node, index, this.bindings);
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
