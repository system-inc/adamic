import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { RuleContext } from '../../context.ts';
import { abbreviation } from './abbreviation_vocabulary.a';
import { betweenToken, emit, foreign, last, name, parent } from './helpers.a';

function binding(context: RuleContext, index: number): number {
    const node = context.node(index);
    if(node.kind === 'PropertyAccessExpression' || node.kind === 'ImportSpecifier' || node.kind === 'ExportSpecifier') {
        return last(context, index);
    }
    if(node.kind === 'BindingElement') {
        const parts = node.children.filter((child) => context.node(child).kind !== 'DotDotDotToken');
        const one = parts[0] ?? -1;
        const two = parts[1] ?? -1;
        if(one >= 0 && two >= 0 && betweenToken(context, context.node(one).end, context.start(two), 'ColonToken')) {
            return two;
        }
        return one;
    }
    if(
        [
            'VariableDeclaration',
            'Parameter',
            'ImportClause',
            'NamespaceImport',
            'ImportEqualsDeclaration',
            'FunctionDeclaration',
            'FunctionExpression',
            'ClassDeclaration',
            'ClassExpression',
            'TypeParameter',
            'InterfaceDeclaration',
            'TypeAliasDeclaration',
            'PropertyAssignment',
            'ShorthandPropertyAssignment',
            'PropertySignature',
            'PropertyDeclaration',
            'MethodDeclaration',
            'MethodSignature',
            'GetAccessor',
            'SetAccessor',
            'EnumDeclaration',
            'EnumMember',
            'NamedTupleMember',
            'NamespaceExport',
            'NamespaceExportDeclaration',
            'JsxAttribute',
            'ModuleDeclaration',
        ].includes(node.kind)
    ) {
        return name(context, index);
    }
    return -1;
}
function nested(context: RuleContext, index: number): boolean {
    const owner = parent(context, index);
    if(owner < 0 || binding(context, owner) !== index) {
        return false;
    }
    const kind = context.node(owner).kind;
    if(['Parameter', 'BindingElement'].includes(kind)) {
        return true;
    }
    if(['FunctionDeclaration', 'ClassDeclaration'].includes(kind)) {
        const ancestor = parent(context, owner);
        return ancestor < 0 || context.node(ancestor).kind !== 'SourceFile';
    }
    if(kind === 'VariableDeclaration') {
        const ancestor = parent(context, parent(context, parent(context, owner)));
        return ancestor < 0 || context.node(ancestor).kind !== 'SourceFile';
    }
    return false;
}
function routeContract(path: string, text: string): boolean {
    const segments = path.split('\\').join('/').split('/');
    const base = segments[segments.length - 1] ?? '';
    if(!segments.slice(0, -1).includes('app')) {
        return false;
    }
    let stem = '';
    for(const extension of ['.tsx', '.ts', '.jsx', '.js']) {
        if(base.endsWith(extension)) {
            stem = base.slice(0, -extension.length);
            break;
        }
    }
    let numberless = stem;
    while(
        numberless !== '' &&
        (numberless[numberless.length - 1] ?? '') >= '0' &&
        (numberless[numberless.length - 1] ?? '') <= '9'
    ) {
        numberless = numberless.slice(0, -1);
    }
    if(['icon', 'apple-icon', 'opengraph-image', 'twitter-image'].includes(numberless)) {
        stem = numberless;
    }
    if(
        ![
            'page',
            'layout',
            'route',
            'icon',
            'apple-icon',
            'opengraph-image',
            'twitter-image',
            'sitemap',
            'robots',
            'manifest',
        ].includes(stem)
    ) {
        return false;
    }
    if(
        [
            'config',
            'generateStaticParams',
            'unstable_instant',
            'unstable_dynamicStaleTime',
            'revalidate',
            'dynamic',
            'dynamicParams',
            'fetchCache',
            'preferredRegion',
            'runtime',
            'maxDuration',
        ].includes(text)
    ) {
        return true;
    }
    if(
        ['page', 'layout'].includes(stem) &&
        ['metadata', 'generateMetadata', 'viewport', 'generateViewport'].includes(text)
    ) {
        return true;
    }
    if(stem === 'route' && ['GET', 'HEAD', 'OPTIONS', 'POST', 'PUT', 'DELETE', 'PATCH'].includes(text)) {
        return true;
    }
    if(
        ['icon', 'apple-icon', 'opengraph-image', 'twitter-image'].includes(stem) &&
        ['alt', 'size', 'contentType', 'generateImageMetadata'].includes(text)
    ) {
        return true;
    }
    return stem === 'sitemap' && text === 'generateSitemaps';
}
function filePattern(context: RuleContext, option: string): boolean {
    for(const pattern of context.settings.list(option, [])) {
        if(pattern !== '' && context.parser.path.split('\\').join('/').includes(pattern)) {
            return true;
        }
    }
    return false;
}
function frameworkName(context: RuleContext, text: string): boolean {
    if(context.settings.list('frameworkparameterscopenames', []).includes(text)) {
        return true;
    }
    let base = text;
    for(const suffix of ['Properties', 'Interface', 'Options', 'Type']) {
        if(base.endsWith(suffix)) {
            base = base.slice(0, -suffix.length);
        }
    }
    for(const suffix of context.settings.list('frameworkparameterscopesuffixes', [])) {
        if(text.endsWith(suffix) || base.endsWith(suffix)) {
            return true;
        }
    }
    return false;
}
function frameworkScope(context: RuleContext, index: number): boolean {
    let sawFunction = false;
    let sawType = false;
    for(let cursor = parent(context, index); cursor >= 0; cursor = parent(context, cursor)) {
        const kind = context.node(cursor).kind;
        let candidate = -1;
        if(!sawFunction && ['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction'].includes(kind)) {
            sawFunction = true;
            candidate =
                kind === 'FunctionDeclaration'
                    ? name(context, cursor)
                    : parent(context, cursor) >= 0 &&
                        context.node(parent(context, cursor)).kind === 'VariableDeclaration'
                      ? name(context, parent(context, cursor))
                      : -1;
        }
        if(!sawType && ['InterfaceDeclaration', 'TypeAliasDeclaration'].includes(kind)) {
            sawType = true;
            candidate = name(context, cursor);
        }
        if(candidate >= 0 && frameworkName(context, context.node(candidate).text)) {
            return true;
        }
    }
    return false;
}
function referenceProperty(context: RuleContext, index: number): boolean {
    const owner = parent(context, index);
    if(owner < 0) {
        return false;
    }
    const kind = context.node(owner).kind;
    if(
        kind === 'PropertySignature' ||
        kind === 'ShorthandPropertyAssignment' ||
        (kind === 'BindingElement' && binding(context, owner) === index)
    ) {
        return true;
    }
    for(let cursor = owner; cursor >= 0; cursor = parent(context, cursor)) {
        if(!['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction'].includes(context.node(cursor).kind)) {
            continue;
        }
        for(const parameter of context.node(cursor).children) {
            if(context.node(parameter).kind !== 'Parameter') {
                continue;
            }
            const pattern = name(context, parameter);
            if(pattern < 0 || context.node(pattern).kind !== 'ObjectBindingPattern') {
                continue;
            }
            for(const element of context.node(pattern).children) {
                const bound = binding(context, element);
                if(bound >= 0 && context.node(bound).kind === 'Identifier' && context.node(bound).text === 'ref') {
                    return true;
                }
            }
        }
    }
    return false;
}
// Reads as declaresName and ast.IsDeclarationName, with a label added and import-equals excluded.
function declaresName(context: RuleContext, index: number): boolean {
    const owner = parent(context, index);
    if(owner < 0) { return false; }
    const kind = context.kind(owner);
    if(kind === 'LabeledStatement') { return context.child(owner, 0) === index; }
    if(kind === 'ImportEqualsDeclaration') { return false; }
    return [
        'VariableDeclaration', 'Parameter', 'BindingElement', 'FunctionDeclaration', 'FunctionExpression',
        'ClassDeclaration', 'ClassExpression', 'InterfaceDeclaration', 'TypeAliasDeclaration',
        'TypeParameter', 'EnumDeclaration', 'EnumMember', 'ModuleDeclaration', 'ImportClause',
        'NamespaceImport', 'ImportSpecifier', 'ExportSpecifier', 'NamespaceExport',
        'NamespaceExportDeclaration', 'NamedTupleMember', 'JsxAttribute',
    ].includes(kind) && binding(context, owner) === index;
}
// Reads as abbreviatedPropertyMember. A computed string is a key; other computed names are reads.
function propertyMember(context: RuleContext, index: number): number {
    let key = index;
    let owner = parent(context, key);
    if(context.kind(owner) === 'ComputedPropertyName' && context.kind(index) === 'StringLiteral') {
        key = owner;
        owner = parent(context, key);
    }
    if(owner < 0 || name(context, owner) !== key) { return -1; }
    return ['PropertySignature', 'MethodSignature', 'PropertyDeclaration', 'MethodDeclaration',
        'GetAccessor', 'SetAccessor', 'PropertyAssignment', 'ShorthandPropertyAssignment',
    ].includes(context.kind(owner)) ? owner : -1;
}
// Reads as abbreviatedOwnsProperty with TypeChecker == nil, the context this syntax port supplies.
// Contextual, inherited, combined and merged-symbol ownership need checker facts; none are guessed here.
function ownsProperty(context: RuleContext, member: number): boolean {
    const owner = parent(context, member);
    if(owner < 0) { return false; }
    if(context.kind(owner) === 'ObjectLiteralExpression') { return true; }
    const path = context.parser.path.split('\\').join('/');
    if(path.endsWith('.d.ts') || path.endsWith('.d.mts') || path.endsWith('.d.cts') || path.includes('/node_modules/')) { return false; }
    for(let cursor = member; cursor >= 0; cursor = parent(context, cursor)) {
        if(context.kind(cursor) !== 'ModuleDeclaration') { continue; }
        const key = name(context, cursor);
        if(context.node(cursor).operator === 'GlobalKeyword' || context.kind(key) === 'StringLiteral') { return false; }
    }
    return true;
}
// Reads as ConsistencyNoAbbreviatedIdentifier.Run's judge, without a rename or any fixes.
function noAbbreviatedIdentifier(context: RuleContext, node: ParseNode, index: number): void {
    const text = node.kind === 'PrivateIdentifier' && node.text.startsWith('#') ? node.text.slice(1) : node.text;
    const member = propertyMember(context, index);
    const property = member >= 0;
    if(property) {
        if(!ownsProperty(context, member)) { return; }
    }
    else if(node.kind !== 'Identifier' || !declaresName(context, index) || foreign(context, index)) { return; }
    if(!property && routeContract(context.parser.path, text) && !nested(context, index)) { return; }
    const finding = abbreviation(text, !property);
    if(finding === undefined) { return; }
    if(!property && finding.word === 'params' && ['whole', 'suffix'].includes(finding.form) &&
        (filePattern(context, 'frameworkparameterfilepatterns') || frameworkScope(context, index))) { return; }
    if(!property && finding.form === 'whole') {
        if(finding.word === 'ref' && referenceProperty(context, index)) { return; }
        if(finding.word === 'config' && filePattern(context, 'frameworkconstantfilepatterns')) { return; }
    }
    emit(context, index, 'nexus/consistency-no-abbreviated-identifier', finding.id, finding.fields);
}
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void { noAbbreviatedIdentifier(this.context, node, index); }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
