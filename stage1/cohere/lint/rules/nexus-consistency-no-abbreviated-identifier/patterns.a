// Go patterns expanded once against the pinned policy vocabulary.
export function prefixMatches(word: string, text: string): boolean {
    switch(word) {
        case 'prop': return /^prop[A-Z]/u.test(text);
        case 'props': return /^props[A-Z]/u.test(text);
        case 'param': return /^param[A-Z]/u.test(text);
        case 'params': return /^params[A-Z]/u.test(text);
        case 'ref': return /^ref[A-Z]/u.test(text);
        case 'config': return /^config[A-Z]/u.test(text);
        case 'idx': return /^idx[A-Z]/u.test(text);
        case 'arg': return /^arg[A-Z]/u.test(text);
        case 'args': return /^args[A-Z]/u.test(text);
        case 'char': return /^char[A-Z]/u.test(text);
        case 'fn': return /^fn[A-Z]/u.test(text);
        case 'str': return /^str[A-Z]/u.test(text);
        case 'val': return /^val[A-Z]/u.test(text);
        case 'arr': return /^arr[A-Z]/u.test(text);
        case 'obj': return /^obj[A-Z]/u.test(text);
        case 'num': return /^num[A-Z]/u.test(text);
        case 'res': return /^res[A-Z]/u.test(text);
        case 'err': return /^err[A-Z]/u.test(text);
        case 'req': return /^req[A-Z]/u.test(text);
        case 'msg': return /^msg[A-Z]/u.test(text);
        case 'min': return /^min[A-Z]/u.test(text);
        case 'max': return /^max[A-Z]/u.test(text);
        case 'ctx': return /^ctx[A-Z]/u.test(text);
        case 'db': return /^db[A-Z]/u.test(text);
        case 'tx': return /^tx[A-Z]/u.test(text);
        case 'opts': return /^opts[A-Z]/u.test(text);
        case 'cur': return /^cur[A-Z]/u.test(text);
        case 'pct': return /^pct[A-Z]/u.test(text);
        case 'prev': return /^prev[A-Z]/u.test(text);
        default: return false;
    }
}
export function segmentMatches(word: string, text: string): boolean {
    switch(word) {
        case 'cwd': return /(^|[^a-zA-Z])Cwd((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Cwd((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'dir': return /(^|[^a-zA-Z])Dir((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Dir((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'env': return /(^|[^a-zA-Z])Env((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Env((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'cli': return /(^|[^a-zA-Z])Cli((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Cli((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'len': return /(^|[^a-zA-Z])Len((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Len((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'seq': return /(^|[^a-zA-Z])Seq((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Seq((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'db': return /(^|[^a-zA-Z])Db((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Db((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'tx': return /(^|[^a-zA-Z])Tx((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Tx((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'vars': return /(^|[^a-zA-Z])Vars((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Vars((?![\s\S])|[A-Z0-9])/u.test(text);
        case 'var': return /(^|[^a-zA-Z])Var((?![\s\S])|[A-Z0-9])/u.test(text) || /[a-z0-9]Var((?![\s\S])|[A-Z0-9])/u.test(text);
        default: return false;
    }
}
export function replaceSegment(word: string, text: string, replacement: string): string {
    switch(word) {
        case 'cwd': return text.replace(/Cwd((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'dir': return text.replace(/Dir((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'env': return text.replace(/Env((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'cli': return text.replace(/Cli((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'len': return text.replace(/Len((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'seq': return text.replace(/Seq((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'db': return text.replace(/Db((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'tx': return text.replace(/Tx((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'vars': return text.replace(/Vars((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        case 'var': return text.replace(/Var((?![\s\S])|[A-Z0-9])/u, replacement + '$1');
        default: return text;
    }
}
