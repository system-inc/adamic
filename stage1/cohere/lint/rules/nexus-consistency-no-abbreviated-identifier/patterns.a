// Fixed, non-global patterns are constructed once; the walk only tests them.
const prefixMatchesProp1 = /^prop[A-Z]/u;
const prefixMatchesProps1 = /^props[A-Z]/u;
const prefixMatchesParam1 = /^param[A-Z]/u;
const prefixMatchesParams1 = /^params[A-Z]/u;
const prefixMatchesRef1 = /^ref[A-Z]/u;
const prefixMatchesConfig1 = /^config[A-Z]/u;
const prefixMatchesIdx1 = /^idx[A-Z]/u;
const prefixMatchesArg1 = /^arg[A-Z]/u;
const prefixMatchesArgs1 = /^args[A-Z]/u;
const prefixMatchesChar1 = /^char[A-Z]/u;
const prefixMatchesFn1 = /^fn[A-Z]/u;
const prefixMatchesStr1 = /^str[A-Z]/u;
const prefixMatchesVal1 = /^val[A-Z]/u;
const prefixMatchesArr1 = /^arr[A-Z]/u;
const prefixMatchesObj1 = /^obj[A-Z]/u;
const prefixMatchesNum1 = /^num[A-Z]/u;
const prefixMatchesRes1 = /^res[A-Z]/u;
const prefixMatchesErr1 = /^err[A-Z]/u;
const prefixMatchesReq1 = /^req[A-Z]/u;
const prefixMatchesMsg1 = /^msg[A-Z]/u;
const prefixMatchesMin1 = /^min[A-Z]/u;
const prefixMatchesMax1 = /^max[A-Z]/u;
const prefixMatchesCtx1 = /^ctx[A-Z]/u;
const prefixMatchesDb1 = /^db[A-Z]/u;
const prefixMatchesTx1 = /^tx[A-Z]/u;
const prefixMatchesOpts1 = /^opts[A-Z]/u;
const prefixMatchesCur1 = /^cur[A-Z]/u;
const prefixMatchesPct1 = /^pct[A-Z]/u;
const prefixMatchesPrev1 = /^prev[A-Z]/u;
const segmentMatchesCwd1 = /(^|[^a-zA-Z])Cwd((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesCwd2 = /[a-z0-9]Cwd((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesDir1 = /(^|[^a-zA-Z])Dir((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesDir2 = /[a-z0-9]Dir((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesEnv1 = /(^|[^a-zA-Z])Env((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesEnv2 = /[a-z0-9]Env((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesCli1 = /(^|[^a-zA-Z])Cli((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesCli2 = /[a-z0-9]Cli((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesLen1 = /(^|[^a-zA-Z])Len((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesLen2 = /[a-z0-9]Len((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesSeq1 = /(^|[^a-zA-Z])Seq((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesSeq2 = /[a-z0-9]Seq((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesDb1 = /(^|[^a-zA-Z])Db((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesDb2 = /[a-z0-9]Db((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesTx1 = /(^|[^a-zA-Z])Tx((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesTx2 = /[a-z0-9]Tx((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesVars1 = /(^|[^a-zA-Z])Vars((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesVars2 = /[a-z0-9]Vars((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesVar1 = /(^|[^a-zA-Z])Var((?![\s\S])|[A-Z0-9])/u;
const segmentMatchesVar2 = /[a-z0-9]Var((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentCwd1 = /Cwd((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentDir1 = /Dir((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentEnv1 = /Env((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentCli1 = /Cli((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentLen1 = /Len((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentSeq1 = /Seq((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentDb1 = /Db((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentTx1 = /Tx((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentVars1 = /Vars((?![\s\S])|[A-Z0-9])/u;
const replaceSegmentVar1 = /Var((?![\s\S])|[A-Z0-9])/u;

// Go patterns expanded once against the pinned policy vocabulary.
export function prefixMatches(word: string, text: string): boolean {
    switch(word) {
        case 'prop': return text.startsWith('prop') && (prefixMatchesProp1.test(text));
        case 'props': return text.startsWith('props') && (prefixMatchesProps1.test(text));
        case 'param': return text.startsWith('param') && (prefixMatchesParam1.test(text));
        case 'params': return text.startsWith('params') && (prefixMatchesParams1.test(text));
        case 'ref': return text.startsWith('ref') && (prefixMatchesRef1.test(text));
        case 'config': return text.startsWith('config') && (prefixMatchesConfig1.test(text));
        case 'idx': return text.startsWith('idx') && (prefixMatchesIdx1.test(text));
        case 'arg': return text.startsWith('arg') && (prefixMatchesArg1.test(text));
        case 'args': return text.startsWith('args') && (prefixMatchesArgs1.test(text));
        case 'char': return text.startsWith('char') && (prefixMatchesChar1.test(text));
        case 'fn': return text.startsWith('fn') && (prefixMatchesFn1.test(text));
        case 'str': return text.startsWith('str') && (prefixMatchesStr1.test(text));
        case 'val': return text.startsWith('val') && (prefixMatchesVal1.test(text));
        case 'arr': return text.startsWith('arr') && (prefixMatchesArr1.test(text));
        case 'obj': return text.startsWith('obj') && (prefixMatchesObj1.test(text));
        case 'num': return text.startsWith('num') && (prefixMatchesNum1.test(text));
        case 'res': return text.startsWith('res') && (prefixMatchesRes1.test(text));
        case 'err': return text.startsWith('err') && (prefixMatchesErr1.test(text));
        case 'req': return text.startsWith('req') && (prefixMatchesReq1.test(text));
        case 'msg': return text.startsWith('msg') && (prefixMatchesMsg1.test(text));
        case 'min': return text.startsWith('min') && (prefixMatchesMin1.test(text));
        case 'max': return text.startsWith('max') && (prefixMatchesMax1.test(text));
        case 'ctx': return text.startsWith('ctx') && (prefixMatchesCtx1.test(text));
        case 'db': return text.startsWith('db') && (prefixMatchesDb1.test(text));
        case 'tx': return text.startsWith('tx') && (prefixMatchesTx1.test(text));
        case 'opts': return text.startsWith('opts') && (prefixMatchesOpts1.test(text));
        case 'cur': return text.startsWith('cur') && (prefixMatchesCur1.test(text));
        case 'pct': return text.startsWith('pct') && (prefixMatchesPct1.test(text));
        case 'prev': return text.startsWith('prev') && (prefixMatchesPrev1.test(text));
        default: return false;
    }
}
export function segmentMatches(word: string, text: string): boolean {
    switch(word) {
        case 'cwd': return text.includes('Cwd') && (segmentMatchesCwd1.test(text) || segmentMatchesCwd2.test(text));
        case 'dir': return text.includes('Dir') && (segmentMatchesDir1.test(text) || segmentMatchesDir2.test(text));
        case 'env': return text.includes('Env') && (segmentMatchesEnv1.test(text) || segmentMatchesEnv2.test(text));
        case 'cli': return text.includes('Cli') && (segmentMatchesCli1.test(text) || segmentMatchesCli2.test(text));
        case 'len': return text.includes('Len') && (segmentMatchesLen1.test(text) || segmentMatchesLen2.test(text));
        case 'seq': return text.includes('Seq') && (segmentMatchesSeq1.test(text) || segmentMatchesSeq2.test(text));
        case 'db': return text.includes('Db') && (segmentMatchesDb1.test(text) || segmentMatchesDb2.test(text));
        case 'tx': return text.includes('Tx') && (segmentMatchesTx1.test(text) || segmentMatchesTx2.test(text));
        case 'vars': return text.includes('Vars') && (segmentMatchesVars1.test(text) || segmentMatchesVars2.test(text));
        case 'var': return text.includes('Var') && (segmentMatchesVar1.test(text) || segmentMatchesVar2.test(text));
        default: return false;
    }
}
export function replaceSegment(word: string, text: string, replacement: string): string {
    switch(word) {
        case 'cwd': return text.includes('Cwd') ? text.replace(replaceSegmentCwd1, replacement + '$1') : text;
        case 'dir': return text.includes('Dir') ? text.replace(replaceSegmentDir1, replacement + '$1') : text;
        case 'env': return text.includes('Env') ? text.replace(replaceSegmentEnv1, replacement + '$1') : text;
        case 'cli': return text.includes('Cli') ? text.replace(replaceSegmentCli1, replacement + '$1') : text;
        case 'len': return text.includes('Len') ? text.replace(replaceSegmentLen1, replacement + '$1') : text;
        case 'seq': return text.includes('Seq') ? text.replace(replaceSegmentSeq1, replacement + '$1') : text;
        case 'db': return text.includes('Db') ? text.replace(replaceSegmentDb1, replacement + '$1') : text;
        case 'tx': return text.includes('Tx') ? text.replace(replaceSegmentTx1, replacement + '$1') : text;
        case 'vars': return text.includes('Vars') ? text.replace(replaceSegmentVars1, replacement + '$1') : text;
        case 'var': return text.includes('Var') ? text.replace(replaceSegmentVar1, replacement + '$1') : text;
        default: return text;
    }
}
