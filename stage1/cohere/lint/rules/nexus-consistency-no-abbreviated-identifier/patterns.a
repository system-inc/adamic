// Reads as internal/naming/abbreviation.beginsWithPrefix, with fixed patterns for Load's word segments.
const cwdBoundary = /(^|[^a-zA-Z])Cwd((?![\s\S])|[A-Z0-9])/u;
const cwdCamel = /[a-z0-9]Cwd((?![\s\S])|[A-Z0-9])/u;
const cwdReplace = /Cwd((?![\s\S])|[A-Z0-9])/u;
const dirBoundary = /(^|[^a-zA-Z])Dir((?![\s\S])|[A-Z0-9])/u;
const dirCamel = /[a-z0-9]Dir((?![\s\S])|[A-Z0-9])/u;
const dirReplace = /Dir((?![\s\S])|[A-Z0-9])/u;
const envBoundary = /(^|[^a-zA-Z])Env((?![\s\S])|[A-Z0-9])/u;
const envCamel = /[a-z0-9]Env((?![\s\S])|[A-Z0-9])/u;
const envReplace = /Env((?![\s\S])|[A-Z0-9])/u;
const cliBoundary = /(^|[^a-zA-Z])Cli((?![\s\S])|[A-Z0-9])/u;
const cliCamel = /[a-z0-9]Cli((?![\s\S])|[A-Z0-9])/u;
const cliReplace = /Cli((?![\s\S])|[A-Z0-9])/u;
const lenBoundary = /(^|[^a-zA-Z])Len((?![\s\S])|[A-Z0-9])/u;
const lenCamel = /[a-z0-9]Len((?![\s\S])|[A-Z0-9])/u;
const lenReplace = /Len((?![\s\S])|[A-Z0-9])/u;
const seqBoundary = /(^|[^a-zA-Z])Seq((?![\s\S])|[A-Z0-9])/u;
const seqCamel = /[a-z0-9]Seq((?![\s\S])|[A-Z0-9])/u;
const seqReplace = /Seq((?![\s\S])|[A-Z0-9])/u;
const dbBoundary = /(^|[^a-zA-Z])Db((?![\s\S])|[A-Z0-9])/u;
const dbCamel = /[a-z0-9]Db((?![\s\S])|[A-Z0-9])/u;
const dbReplace = /Db((?![\s\S])|[A-Z0-9])/u;
const txBoundary = /(^|[^a-zA-Z])Tx((?![\s\S])|[A-Z0-9])/u;
const txCamel = /[a-z0-9]Tx((?![\s\S])|[A-Z0-9])/u;
const txReplace = /Tx((?![\s\S])|[A-Z0-9])/u;
const varsBoundary = /(^|[^a-zA-Z])Vars((?![\s\S])|[A-Z0-9])/u;
const varsCamel = /[a-z0-9]Vars((?![\s\S])|[A-Z0-9])/u;
const varsReplace = /Vars((?![\s\S])|[A-Z0-9])/u;
const varBoundary = /(^|[^a-zA-Z])Var((?![\s\S])|[A-Z0-9])/u;
const varCamel = /[a-z0-9]Var((?![\s\S])|[A-Z0-9])/u;
const varReplace = /Var((?![\s\S])|[A-Z0-9])/u;
const bufBoundary = /(^|[^a-zA-Z])Buf((?![\s\S])|[A-Z0-9])/u;
const bufCamel = /[a-z0-9]Buf((?![\s\S])|[A-Z0-9])/u;
const bufReplace = /Buf((?![\s\S])|[A-Z0-9])/u;
const tmpBoundary = /(^|[^a-zA-Z])Tmp((?![\s\S])|[A-Z0-9])/u;
const tmpCamel = /[a-z0-9]Tmp((?![\s\S])|[A-Z0-9])/u;
const tmpReplace = /Tmp((?![\s\S])|[A-Z0-9])/u;
const pkgBoundary = /(^|[^a-zA-Z])Pkg((?![\s\S])|[A-Z0-9])/u;
const pkgCamel = /[a-z0-9]Pkg((?![\s\S])|[A-Z0-9])/u;
const pkgReplace = /Pkg((?![\s\S])|[A-Z0-9])/u;
const srcBoundary = /(^|[^a-zA-Z])Src((?![\s\S])|[A-Z0-9])/u;
const srcCamel = /[a-z0-9]Src((?![\s\S])|[A-Z0-9])/u;
const srcReplace = /Src((?![\s\S])|[A-Z0-9])/u;
const dstBoundary = /(^|[^a-zA-Z])Dst((?![\s\S])|[A-Z0-9])/u;
const dstCamel = /[a-z0-9]Dst((?![\s\S])|[A-Z0-9])/u;
const dstReplace = /Dst((?![\s\S])|[A-Z0-9])/u;
const connBoundary = /(^|[^a-zA-Z])Conn((?![\s\S])|[A-Z0-9])/u;
const connCamel = /[a-z0-9]Conn((?![\s\S])|[A-Z0-9])/u;
const connReplace = /Conn((?![\s\S])|[A-Z0-9])/u;
const cmdBoundary = /(^|[^a-zA-Z])Cmd((?![\s\S])|[A-Z0-9])/u;
const cmdCamel = /[a-z0-9]Cmd((?![\s\S])|[A-Z0-9])/u;
const cmdReplace = /Cmd((?![\s\S])|[A-Z0-9])/u;
const cfgBoundary = /(^|[^a-zA-Z])Cfg((?![\s\S])|[A-Z0-9])/u;
const cfgCamel = /[a-z0-9]Cfg((?![\s\S])|[A-Z0-9])/u;
const cfgReplace = /Cfg((?![\s\S])|[A-Z0-9])/u;
const posBoundary = /(^|[^a-zA-Z])Pos((?![\s\S])|[A-Z0-9])/u;
const posCamel = /[a-z0-9]Pos((?![\s\S])|[A-Z0-9])/u;
const posReplace = /Pos((?![\s\S])|[A-Z0-9])/u;
const wgBoundary = /(^|[^a-zA-Z])Wg((?![\s\S])|[A-Z0-9])/u;
const wgCamel = /[a-z0-9]Wg((?![\s\S])|[A-Z0-9])/u;
const wgReplace = /Wg((?![\s\S])|[A-Z0-9])/u;
const muBoundary = /(^|[^a-zA-Z])Mu((?![\s\S])|[A-Z0-9])/u;
const muCamel = /[a-z0-9]Mu((?![\s\S])|[A-Z0-9])/u;
const muReplace = /Mu((?![\s\S])|[A-Z0-9])/u;
const chBoundary = /(^|[^a-zA-Z])Ch((?![\s\S])|[A-Z0-9])/u;
const chCamel = /[a-z0-9]Ch((?![\s\S])|[A-Z0-9])/u;
const chReplace = /Ch((?![\s\S])|[A-Z0-9])/u;
const sbBoundary = /(^|[^a-zA-Z])Sb((?![\s\S])|[A-Z0-9])/u;
const sbCamel = /[a-z0-9]Sb((?![\s\S])|[A-Z0-9])/u;
const sbReplace = /Sb((?![\s\S])|[A-Z0-9])/u;
export function prefixMatches(word: string, text: string): boolean {
    const next = text.slice(word.length, word.length + 1);
    return text.startsWith(word) && next !== '' && next >= 'A' && next <= 'Z';
}
export function segmentMatches(word: string, text: string): boolean {
    switch(word) {
        case 'cwd': return cwdBoundary.test(text) || cwdCamel.test(text);
        case 'dir': return dirBoundary.test(text) || dirCamel.test(text);
        case 'env': return envBoundary.test(text) || envCamel.test(text);
        case 'cli': return cliBoundary.test(text) || cliCamel.test(text);
        case 'len': return lenBoundary.test(text) || lenCamel.test(text);
        case 'seq': return seqBoundary.test(text) || seqCamel.test(text);
        case 'db': return dbBoundary.test(text) || dbCamel.test(text);
        case 'tx': return txBoundary.test(text) || txCamel.test(text);
        case 'vars': return varsBoundary.test(text) || varsCamel.test(text);
        case 'var': return varBoundary.test(text) || varCamel.test(text);
        case 'buf': return bufBoundary.test(text) || bufCamel.test(text);
        case 'tmp': return tmpBoundary.test(text) || tmpCamel.test(text);
        case 'pkg': return pkgBoundary.test(text) || pkgCamel.test(text);
        case 'src': return srcBoundary.test(text) || srcCamel.test(text);
        case 'dst': return dstBoundary.test(text) || dstCamel.test(text);
        case 'conn': return connBoundary.test(text) || connCamel.test(text);
        case 'cmd': return cmdBoundary.test(text) || cmdCamel.test(text);
        case 'cfg': return cfgBoundary.test(text) || cfgCamel.test(text);
        case 'pos': return posBoundary.test(text) || posCamel.test(text);
        case 'wg': return wgBoundary.test(text) || wgCamel.test(text);
        case 'mu': return muBoundary.test(text) || muCamel.test(text);
        case 'ch': return chBoundary.test(text) || chCamel.test(text);
        case 'sb': return sbBoundary.test(text) || sbCamel.test(text);
        default: return false;
    }
}
export function replaceSegment(word: string, text: string, replacement: string): string {
    switch(word) {
        case 'cwd': return text.replace(cwdReplace, replacement + '$1');
        case 'dir': return text.replace(dirReplace, replacement + '$1');
        case 'env': return text.replace(envReplace, replacement + '$1');
        case 'cli': return text.replace(cliReplace, replacement + '$1');
        case 'len': return text.replace(lenReplace, replacement + '$1');
        case 'seq': return text.replace(seqReplace, replacement + '$1');
        case 'db': return text.replace(dbReplace, replacement + '$1');
        case 'tx': return text.replace(txReplace, replacement + '$1');
        case 'vars': return text.replace(varsReplace, replacement + '$1');
        case 'var': return text.replace(varReplace, replacement + '$1');
        case 'buf': return text.replace(bufReplace, replacement + '$1');
        case 'tmp': return text.replace(tmpReplace, replacement + '$1');
        case 'pkg': return text.replace(pkgReplace, replacement + '$1');
        case 'src': return text.replace(srcReplace, replacement + '$1');
        case 'dst': return text.replace(dstReplace, replacement + '$1');
        case 'conn': return text.replace(connReplace, replacement + '$1');
        case 'cmd': return text.replace(cmdReplace, replacement + '$1');
        case 'cfg': return text.replace(cfgReplace, replacement + '$1');
        case 'pos': return text.replace(posReplace, replacement + '$1');
        case 'wg': return text.replace(wgReplace, replacement + '$1');
        case 'mu': return text.replace(muReplace, replacement + '$1');
        case 'ch': return text.replace(chReplace, replacement + '$1');
        case 'sb': return text.replace(sbReplace, replacement + '$1');
        default: return text;
    }
}
