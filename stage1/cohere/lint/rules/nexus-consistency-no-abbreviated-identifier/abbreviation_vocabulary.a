import { prefixMatches, segmentMatches, replaceSegment } from './patterns.a';
import { panic } from 'adamic';
import { allowedNames, allowedSegments, vocabulary } from './policy_data.a';

export class Abbreviation {
    readonly form: string;
    readonly word: string;
    readonly id: string;
    readonly fields: string[];
    constructor(form: string, word: string, id: string, fields: string[]) {
        this.form = form;
        this.word = word;
        this.id = id;
        this.fields = fields;
    }
}
function capitalized(value: string): string {
    return value.slice(0, 1).toUpperCase() + value.slice(1);
}
function prefixFinding(text: string, entry: readonly string[]): Abbreviation {
    const word = entry[0] ?? panic('word');
    const expansion = entry[1] ?? '';
    const advisory = entry[5] === 'advice';
    return new Abbreviation('prefix', word, 'abbreviatedIdentifier', [
        'name',
        advisory ? word : text,
        'advice',
        advisory ? (entry[2] ?? '') : `Use "${expansion + text.slice(word.length)}".`,
    ]);
}
// The policy is prepared in vocabulary order once, never mutated by a walk.
class Word {
    readonly entry: string[];
    readonly word: string;
    readonly capitalizedWord: string;
    readonly replacement: string;
    constructor(entry: string[]) {
        this.entry = entry;
        this.word = entry[0] ?? panic('word');
        this.capitalizedWord = capitalized(this.word);
        this.replacement = entry[8] === '' ? capitalized(entry[1] ?? '') : (entry[8] ?? '');
    }
}
class Policy {
    readonly allowed: Set<string> = new Set<string>();
    readonly whole: Map<string, Word> = new Map<string, Word>();
    readonly early: Word[] = [];
    readonly suffix: Word[] = [];
    readonly late: Word[] = [];
    readonly segment: Word[] = [];
    constructor() {
        for(const text of allowedNames) {
            this.allowed.add(text);
        }
        for(const entry of vocabulary) {
            const item = new Word(entry);
            if(entry[3] !== '') {
                this.whole.set(item.word, item);
            }
            if(entry[4] === 'early') {
                this.early.push(item);
            }
            if(entry[6] === 'true') {
                this.suffix.push(item);
            }
            if(entry[4] === 'late') {
                this.late.push(item);
            }
            if(entry[10] === 'true') {
                this.segment.push(item);
            }
        }
    }
}
const policy = new Policy();
const millisecondWord = /([a-z])Ms((?![\s\S])|[A-Z])/u;

export function abbreviation(text: string): Abbreviation | undefined {
    if(policy.allowed.has(text)) {
        return undefined;
    }
    const whole = policy.whole.get(text);
    if(whole !== undefined) {
        const entry = whole.entry;
        const word = whole.word;
        const expansion = entry[1] ?? '';
        if(text === word && entry[3] !== '') {
            const style = entry[3];
            const advice =
                style === 'advice'
                    ? (entry[2] ?? '')
                    : `Use "${expansion}"${style === 'plain' ? '.' : ' or a more descriptive name.'}`;
            return new Abbreviation('whole', word, 'abbreviatedIdentifier', ['name', text, 'advice', advice]);
        }
    }
    for(const item of policy.early) {
        const word = item.word;
        if(!prefixMatches(word, text)) {
            continue;
        }
        let allowed = false;
        for(const segment of allowedSegments) {
            if(text.includes(segment) && segment.toLowerCase().includes(word)) {
                allowed = true;
            }
        }
        if(!allowed) {
            return prefixFinding(text, item.entry);
        }
    }
    for(const item of policy.suffix) {
        const entry = item.entry;
        const word = item.word;
        if(entry[7] === 'millisecondWord') {
            if(text.includes('Ms') && millisecondWord.test(text)) {
                return new Abbreviation('suffix', word, 'millisecondSuffix', [
                    'name', text, 'suggestion',
                    text.replace(millisecondWord, '$1' + (entry[8] ?? '') + '$2'),
                ]);
            }
        }
        else {
            const suffix = item.capitalizedWord;
            if(text.endsWith(suffix)) {
                const advice =
                    entry[9] === ''
                        ? `Use "${text.slice(0, text.length - suffix.length) + item.replacement}".`
                        : (entry[9] ?? '');
                return new Abbreviation('suffix', word, 'abbreviatedSuffix', [
                    'name', text, 'suffix', suffix, 'advice', advice,
                ]);
            }
        }
    }
    for(const item of policy.late) {
        if(prefixMatches(item.word, text)) {
            return prefixFinding(text, item.entry);
        }
    }
    for(const segment of allowedSegments) {
        if(text.includes(segment)) {
            return undefined;
        }
    }
    for(const item of policy.segment) {
        const word = item.word;
        if(!segmentMatches(word, text)) {
            continue;
        }
        // Go replaces the first right-bounded occurrence, which can precede the
        // left-bounded occurrence that established a segment match.
        const suggestion = replaceSegment(word, text, item.replacement);
        if(suggestion !== text) {
            return new Abbreviation('segment', word, 'abbreviatedWordSegment', [
                'name', text, 'word', item.capitalizedWord, 'suggestion', suggestion,
            ]);
        }
    }
    return undefined;
}
