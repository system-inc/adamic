import { prefixMatches, segmentMatches, replaceSegment } from './patterns.a';
import { panic } from 'adamic';
import { allowedNames, allowedSegments, vocabulary } from './policy_data.a';

export class Abbreviation {
    readonly form: string;
    readonly word: string;
    readonly id: string;
    readonly fields: string[];
    constructor(form: string, word: string, id: string, fields: string[]) {
        this.form = form;
        this.word = word;
        this.id = id;
        this.fields = fields;
    }
}
function capitalized(value: string): string {
    return value.slice(0, 1).toUpperCase() + value.slice(1);
}
// Each word capitalized, made once: the suffix and segment phases read it for every entry of every
// identifier, and building it there was most of the rule's cost.
const capitals: string[] = vocabulary.map((entry) => capitalized(entry[0] ?? panic('word')));
function prefixFinding(text: string, entry: readonly string[]): Abbreviation {
    const word = entry[0] ?? panic('word');
    const expansion = entry[1] ?? '';
    const advisory = entry[5] === 'advice';
    return new Abbreviation('prefix', word, 'abbreviatedIdentifier', [
        'name',
        advisory ? word : text,
        'advice',
        advisory ? (entry[2] ?? '') : `Use "${expansion + text.slice(word.length)}".`,
    ]);
}
export function abbreviation(text: string): Abbreviation | undefined {
    if(allowedNames.includes(text)) {
        return undefined;
    }
    for(const entry of vocabulary) {
        const word = entry[0] ?? panic('word');
        const expansion = entry[1] ?? '';
        if(text === word && entry[3] !== '') {
            const style = entry[3];
            const advice =
                style === 'advice'
                    ? (entry[2] ?? '')
                    : `Use "${expansion}"${style === 'plain' ? '.' : ' or a more descriptive name.'}`;
            return new Abbreviation('whole', word, 'abbreviatedIdentifier', ['name', text, 'advice', advice]);
        }
    }
    // Every identifier in a file reaches this loop, and most hold no vocabulary word at all, so each
    // regex below sits behind a substring test it cannot match without: a prefix pattern needs the
    // word at the start, the millisecond pattern needs 'Ms', and a segment pattern needs the
    // capitalized word. Skipping a test that cannot match changes no finding. The segment phase's
    // allowed-segment check can sit behind its gate too: the phase is the last one and the function
    // ends in undefined, so where that check returns undefined changes nothing. Measured on Sun2 over
    // TypeScript's 77 compiler files, the gates and the precomputed capitals take this rule from 86.6G
    // instructions to 18.4G over the parse floor, with its output byte-identical (#tj6d455).
    for(const phase of ['early', 'suffix', 'late', 'segment']) {
        for(let index = 0; index < vocabulary.length; index++) {
            const entry = vocabulary[index] ?? panic('entry');
            const capital = capitals[index] ?? panic('capital');
            const word = entry[0] ?? panic('word');
            const expansion = entry[1] ?? '';
            if(phase === 'early' || phase === 'late') {
                if(entry[4] !== phase || !text.startsWith(word) || !prefixMatches(word, text)) {
                    continue;
                }
                let allowed = false;
                for(const segment of allowedSegments) {
                    if(text.includes(segment) && segment.toLowerCase().includes(word)) {
                        allowed = true;
                    }
                }
                if(phase === 'late' || !allowed) {
                    return prefixFinding(text, entry);
                }
            }
            if(phase === 'suffix' && entry[6] === 'true') {
                if(entry[7] === 'millisecondWord') {
                    if(text.includes('Ms') && /([a-z])Ms((?![\s\S])|[A-Z])/u.test(text)) {
                        return new Abbreviation('suffix', word, 'millisecondSuffix', [
                            'name', text, 'suggestion',
                            text.replace(/([a-z])Ms((?![\s\S])|[A-Z])/u, '$1' + (entry[8] ?? '') + '$2'),
                        ]);
                    }
                }
                else {
                    const suffix = capital;
                    if(text.endsWith(suffix)) {
                        const replacement = entry[8] === '' ? capitalized(expansion) : (entry[8] ?? '');
                        const advice =
                            entry[9] === ''
                                ? `Use "${text.slice(0, text.length - suffix.length) + replacement}".`
                                : (entry[9] ?? '');
                        return new Abbreviation('suffix', word, 'abbreviatedSuffix', [
                            'name',
                            text,
                            'suffix',
                            suffix,
                            'advice',
                            advice,
                        ]);
                    }
                }
            }
            if(phase === 'segment' && entry[10] === 'true') {
                if(!text.includes(capital)) {
                    continue;
                }
                let allowed = false;
                for(const segment of allowedSegments) {
                    if(text.includes(segment)) {
                        allowed = true;
                    }
                }
                if(allowed) {
                    return undefined;
                }
                const suggestion = replaceSegment(word, text, capitalized(expansion));
                if(segmentMatches(word, text) && suggestion !== text) {
                    return new Abbreviation('segment', word, 'abbreviatedWordSegment', [
                        'name',
                        text,
                        'word',
                        capital,
                        'suggestion',
                        suggestion,
                    ]);
                }
            }
        }
    }
    return undefined;
}
