import { panic, programArguments, readTextFile } from 'adamic';
import { Element, evaluate } from './rule.a';
import { message } from './messages.a';
const input = readTextFile(programArguments()[0] ?? panic('missing JSX adapter data'));
if(input.kind === 'Error') panic(input.message);
let count = 0;
const countOnly = programArguments().includes('--count');
for(const row of input.text.split('\n')) {
    if(row === '') continue;
    const fields = row.split('\t');
    const id = evaluate(new Element(fields[3] ?? '', fields[5] ?? '', fields[4] === 'true'));
    if(id !== '') {
        count++;
        if(!countOnly) console.log(`${fields[0]}\t${fields[1]} ${fields[2]}\t${id}\t${message(id)}`);
    }
}
if(countOnly) console.log(`${count}`);
