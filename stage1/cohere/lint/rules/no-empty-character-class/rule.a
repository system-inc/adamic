// Port of batch2:no_empty_character_class.ts against pinned Go cohere.
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { escapeEnd } from './escapes.a';
import { messageEmptyCharacterClass } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, _index: number): void {
        const text = node.text;
        if(text.length < 2 || text[0] !== '/') return;
        const slash = text.lastIndexOf('/');
        const pattern = slash === 0 ? text.slice(1) : text.slice(1, slash);
        const flags = slash === 0 ? '' : text.slice(slash + 1);
        const nested = flags.includes('v');
        const unicode = nested || flags.includes('u');
        const stack: number[] = [];
        let empty: number[] = [];
        // These are regex syntax boundaries, not a pattern matcher. Buffer nested
        // spans until their outer class closes, as Go's ClassEnd does before callbacks.
        for(let cursor = 0; cursor < pattern.length;) {
            const character = pattern[cursor];
            if(character === '\\') {
                cursor = escapeEnd(pattern, cursor, unicode);
                if(cursor < 0) return;
                continue;
            }
            if(character === '[' && (nested || stack.length === 0)) stack.push(cursor);
            if(character === ']' && stack.length > 0) {
                const opening = stack.pop() ?? -1;
                if(cursor === opening + 1) empty.push(opening);
                if(stack.length === 0) {
                    for(const position of empty) {
                        // node.end and string positions are UTF-16. Go computes the
                        // equivalent byte range; the wire encoder maps this range to bytes.
                        const start = node.end - text.length + 1 + position;
                        this.context.reportRange(start, start + 2, 'no-empty-character-class',
                            'unexpectedEmptyCharacterClass', messageEmptyCharacterClass);
                    }
                    empty = [];
                }
            }
            cursor++;
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
