import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';

// Go's canonical regexp surrounds the exact AST operand text. Match its two
// boundaries with literals so operand spelling is compared by the source ranges,
// rather than interpreted as pattern syntax. Go \s is ASCII; its $ is absolute.
function canonicalBoundaries(prefix: string, suffix: string): boolean {
    return /^return[ \t\n\f\r]+void[ \t\n\f\r]+(?![\s\S])/u.test(prefix) &&
        /^[ \t\n\f\r]*;(?![\s\S])/u.test(suffix);
}
function identifierStart(code: number): boolean {
    return code === 95 || code === 36 || (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
}


export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(index: number, parent: number): void {
        const context = this.context;
        const expression = context.node(index).children[0] ?? -1;
        if(expression < 0) return;
        const unary = context.unwrap(expression);
        if(context.node(unary).kind !== 'VoidExpression') return;
        const operand = context.node(unary).children[0] ?? -1;
        let replacement = '';
        if(operand >= 0) {
            const start = context.start(index);
            const operandStart = context.start(operand);
            const operandEnd = context.node(operand).end;
            const operandText = context.source.slice(operandStart, operandEnd);
            const prefix = context.source.slice(start, operandStart);
            const suffix = context.source.slice(operandEnd, context.node(index).end);
            const canonical = canonicalBoundaries(prefix, suffix);
            // codex/lint-regex table: nexus/consistency_no_return_void.go:100.
            // A fresh literal avoids keeping the translated global match state.
            const unsafe = /^(function|class|let|async)\b/gu.test(operandText);
            if(canonical && identifierStart(operandText.charCodeAt(0)) && !unsafe) {
                const parentKind = parent < 0 ? '' : context.node(parent).kind;
                if(['Block', 'CaseClause', 'DefaultClause'].includes(parentKind)) {
                    const lineStart = context.source.slice(0, start).lastIndexOf('\n') + 1;
                    const indentation = context.source.slice(lineStart, start);
                    let indented = true;
                    for(let offset = 0; offset < indentation.length; offset++) {
                        if(indentation.charCodeAt(offset) !== 32 && indentation.charCodeAt(offset) !== 9) indented = false;
                    }
                    replacement = indented ? `${operandText};\n${indentation}return;` : `${operandText}; return;`;
                }
                else replacement = `{ ${operandText}; return; }`;
            }
        }
        context.report(index, 'nexus/consistency-no-return-void', 'returnVoid', message,
            replacement === '' ? '' : 'fix', replacement, '');
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
