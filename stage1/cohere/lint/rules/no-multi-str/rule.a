import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Diagnostic } from '../typescript-prefer-as-const/records.a';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext; readonly records: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    analyze(index: number): void {
        const context = this.context; const node = context.node(index);
        if(node.kind !== 'StringLiteral') return;
        // In JSX files the parser can misread an element as a forbidden type assertion.
        // Refuse that ancestry before it can produce a false positive on JSX expression content.
        if(context.parser.path.endsWith('.tsx') || context.parser.path.endsWith('.jsx')) {
            let ancestor = context.parents[index] ?? -1;
            while(ancestor >= 0) {
                if(context.node(ancestor).kind === 'TypeAssertionExpression') panic('parser slice has no JSX string ancestry adapter');
                ancestor = context.parents[ancestor] ?? -1;
            }
        }
        const parent = context.parents[index] ?? -1;
        if(parent >= 0 && context.node(parent).kind.startsWith('Jsx')) return;
        const start = context.start(index); const raw = context.source.slice(start, node.end);
        for(let position = 0; position < raw.length; position++) {
            const code = raw.charCodeAt(position);
            if(code === 10 || code === 13 || code === 8232 || code === 8233) {
                this.records.push(new Diagnostic('no-multi-str', 'multilineString', message, start, node.end)); return;
            }
        }
    }
    visit(index: number): void {
        const previous = this.records.length; this.analyze(index);
        if(this.records.length !== previous) this.context.report(index, 'no-multi-str', 'multilineString', message, '', '', '');
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
