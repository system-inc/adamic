fixed	import { panic, readTextFile, programArguments } from 'adamic';\u000aimport { Parser } from '../../../../typescript/parser/parser.ts';\u000aimport { written } from '../../../../typescript/parser/nodes.ts';\u000aimport { Scanner } from '../../../../typescript/scanner/scanner.ts';\u000aimport { RuleContext } from '../../context.ts';\u000aimport { Settings } from '../../settings.ts';\u000aimport { Rule as ModuleRule } from '../next-no-assign-module-variable/rule.a';\u000aimport { Rule as ParameterRule } from '../typescript-default-param-last/rule.a';\u000aimport { Rule as DirectionRule } from './rule.a';\u000a\u000afunction walk(context: RuleContext, index: number, moduleRule: ModuleRule, parameterRule: ParameterRule, directionRule: DirectionRule): void {\u000a    const kind = context.node(index).kind;\u000a    if(context.selected === '@next/next/no-assign-module-variable' && kind === 'VariableStatement') {\u000a        moduleRule.visit(index);\u000a    }\u000a    if(context.selected === '@typescript-eslint/default-param-last' && ['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration', 'Constructor', 'GetAccessor', 'SetAccessor'].includes(kind)) {\u000a        parameterRule.visit(index);\u000a    }\u000a    if(context.selected === 'structure/tailwind-no-physical-direction' && ['StringLiteral', 'NoSubstitutionTemplateLiteral', 'TemplateExpression'].includes(kind)) {\u000a        directionRule.visit(index);\u000a    }\u000a    for(const child of context.node(index).children) {\u000a        walk(context, child, moduleRule, parameterRule, directionRule);\u000a    }\u000a}\u000afunction byteOffset(source: string, end: number): number {\u000a    let bytes = 0;\u000a    for(let position = 0; position < end; position++) {\u000a        const code = source.codePointAt(position) ?? 0;\u000a        bytes += code < 128 ? 1 : code < 2048 ? 2 : code < 65536 ? 3 : 4;\u000a        if(code > 65535) { position++; }\u000a    }\u000a    return bytes;\u000a}\u000afunction run(path: string, selected: string, count: boolean): number {\u000a    const source = readTextFile(path);\u000a    if(source.kind === 'Error') { panic(source.message); }\u000a    const parser = new Parser(source.text, path);\u000a    const root = parser.file();\u000a    const parents: number[] = [];\u000a    for(const node of parser.nodes) { parents.push(-1); }\u000a    const context = new RuleContext(source.text, parser, new Scanner(source.text), selected, '', '', false, parents, new Settings());\u000a    walk(context, root, new ModuleRule(context), new ParameterRule(context), new DirectionRule(context));\u000a    context.findings.sort((left, right) => left.start - right.start);\u000a    if(count) { return context.findings.length; }\u000a    for(const finding of context.findings) {\u000a        // These rules supply no fixes. Refuse a future repair rather than lose it.\u000a        if(finding.repair !== '' || finding.replacement !== '' || finding.suggestion !== '') {\u000a            panic('standalone no-repair rule changed its finding shape');\u000a        }\u000a        console.log(`finding ${byteOffset(source.text, finding.start)} ${byteOffset(source.text, finding.end)} ${finding.id}\u005ct${written(finding.message)}`);\u000a    }\u000a    console.log(`fixed\u005ct${written(source.text)}`);\u000a    return context.findings.length;\u000a}\u000aconst args = programArguments();\u000aconst manifest = readTextFile(args[0] ?? panic('missing manifest'));\u000aif(manifest.kind === 'Error') { panic(manifest.message); }\u000alet cases = 0;\u000alet findings = 0;\u000afor(const row of manifest.text.split('\u005cn')) {\u000a    if(row === '') { continue; }\u000a    const fields = row.split('\u005ct');\u000a    if(!args.includes('--count')) { console.log(`case ${cases}`); }\u000a    findings += run(fields[0] ?? '', fields[1] ?? '', args.includes('--count'));\u000a    cases++;\u000a}\u000aif(args.includes('--count')) { console.log(`${findings}`); }\u000a
