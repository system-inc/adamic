import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { CheckedJudgments } from '../no-global-assign/context.a';
import { NoScriptComponentInHead } from '../../../typeaware/no_script_component_in_head.a';
import { Bindings } from '../../../typeaware/bindings.ts';
import { HeadComponents } from '../../../typeaware/head_components.a';
export class Rule {
    readonly context: RuleContext;
    checked: CheckedJudgments | undefined = undefined;
    judgment: NoScriptComponentInHead | undefined = undefined;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        if(this.judgment === undefined) {
            const context = this.context;
            this.checked = new CheckedJudgments(context);
            const rules = this.checked.rules;
            this.judgment = new NoScriptComponentInHead(new HeadComponents(rules, new Bindings(rules)));
        }
        const judgment = this.judgment ?? panic('missing judgment');
        const checked = this.checked ?? panic('missing checker view');
        judgment.visitNode(node, index);
        checked.flush();
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
