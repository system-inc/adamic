import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { bindingsOf } from '../../helpers/imports/bindings_of.a';
import { importedNameOf } from '../../helpers/imports/imported_name_of.a';
import type { HelperNode as ImportNode } from '../../helpers/imports/nodes.a';
import { isNamespacedMember } from '../../helpers/react/namespaced_member.a';
import type { HelperNode } from '../../helpers/react/nodes.a';
import { project } from '../../helpers/react/projection.a';
import { callMessage, importMessage } from './messages.a';

export class Rule {
    imports: readonly ImportNode[] = [];
    members: readonly HelperNode[] = [];
    readonly contextValue: RuleContext | undefined = undefined;
    constructor(context: RuleContext) {
        this.contextValue = context;
    }
    ruleContext(): RuleContext { return this.contextValue ?? panic('rule context not initialized'); }
    prepare(root: number): void {
        const context = this.ruleContext();
        const imports: ImportNode[] = [];
        const members: readonly HelperNode[] = project(context.parser.nodes);
        for(let cursor = 0; cursor < context.parser.nodes.length; cursor++) {
            const node = context.node(cursor);
            const clause = node.kind === 'ImportDeclaration' ? context.children(cursor, 'ImportClause')[0] ?? -1 : -1;
            const named = node.kind === 'ImportClause' ? node.children.find(child => context.kind(child) === 'NamedImports' || context.kind(child) === 'NamespaceImport') ?? -1 : -1;
            const name = node.kind === 'ImportSpecifier' ? node.children[node.children.length - 1] ?? -1 : node.kind === 'ImportClause' ? node.children.find(child => context.kind(child) === 'Identifier') ?? -1 : -1;
            const propertyName = node.kind === 'ImportSpecifier' && node.children.length > 1 ? node.children[0] ?? -1 : -1;
            imports.push({kind: node.kind, text: node.text, expression: -1, name, importClause: clause, namedBindings: named, propertyName, elements: node.children});
        }
        this.imports = imports;
        this.members = members;
    }
    visit(index: number): void {
        const context = this.ruleContext();
        const kind = context.kind(index);
        if(kind === 'ImportDeclaration') {
            const children = context.node(index).children;
            let module = -1;
            for(const child of children) {
                if(context.kind(child) === 'StringLiteral' || context.kind(child) === 'NoSubstitutionTemplateLiteral') { module = child; }
            }
            if(module < 0 || context.node(module).text !== 'react') { return; }
            for(const element of bindingsOf(this.imports, index).named) {
                if(importedNameOf(this.imports, element) === 'forwardRef') {
                    context.report(element, 'structure/react-component-no-forward-ref', 'noForwardRefImport', importMessage, '', '', '');
                }
            }
        }
        else if(kind === 'CallExpression') {
            const callee = context.unwrap(context.child(index, 0));
            const bare = context.kind(callee) === 'Identifier' && context.node(callee).text === 'forwardRef';
            if(bare || isNamespacedMember(this.members, callee, (name: string): boolean => name === 'forwardRef')) {
                context.report(callee, 'structure/react-component-no-forward-ref', 'noForwardRefCall', callMessage, '', '', '');
            }
        }
        else if(kind === 'QualifiedName') {
            const left = context.child(index, 0);
            const right = context.child(index, 1);
            if(context.kind(left) === 'Identifier' && context.node(left).text === 'React' &&
                context.kind(right) === 'Identifier' && ['ForwardRefExoticComponent', 'ForwardedRef'].includes(context.node(right).text)) {
                context.report(index, 'structure/react-component-no-forward-ref', 'noForwardRefCall', callMessage, '', '', '');
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
