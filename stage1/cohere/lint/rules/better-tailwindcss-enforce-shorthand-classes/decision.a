// Decision kernel only: caller must supply class literals and design-system membership.
class PatternRule {
    readonly longhands: readonly string[];
    readonly shorthands: readonly string[];
    constructor(longhands: readonly string[], shorthands: readonly string[]) { this.longhands = longhands; this.shorthands = shorthands; }
}
class Parts {
    readonly name: string;
    readonly variants: string;
    readonly base: string;
    readonly negative: boolean;
    readonly important: boolean;
    readonly markerEnd: boolean;
    constructor(name: string) {
        this.name = name;
        let depth = 0;
        let colon = -1;
        for (let i = 0; i < name.length; i++) {
            const c = name[i];
            if (c === '[' || c === '(') depth++;
            else if (c === ']' || c === ')') depth--;
            else if (c === ':' && depth === 0) colon = i;
        }
        const hasVariants = colon > 0 && colon < name.length - 1;
        this.variants = hasVariants ? name.slice(0, colon) : '';
        let utility = hasVariants ? name.slice(colon + 1) : name;
        this.negative = utility.startsWith('-');
        if (this.negative) utility = utility.slice(1);
        const leading = utility.startsWith('!');
        if (leading) utility = utility.slice(1);
        this.markerEnd = utility.endsWith('!');
        if (this.markerEnd) utility = utility.slice(0, -1);
        this.important = leading || this.markerEnd;
        this.base = utility;
    }
}
