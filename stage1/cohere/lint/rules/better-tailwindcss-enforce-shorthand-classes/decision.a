export class Collapse {
    readonly longhands: readonly string[];
    readonly shorthands: readonly string[];
    constructor(longhands: readonly string[], shorthands: readonly string[]) { this.longhands = longhands; this.shorthands = shorthands; }
}
export function collapses(names: readonly string[]): readonly Collapse[] {
    const classes: Parts[] = [];
    const variants: string[] = [];
    for (const name of names) {
        const part = new Parts(name);
        classes.push(part);
        if (!variants.includes(part.variants)) variants.push(part.variants);
    }
    const result: Collapse[] = [];
    for (const family of families) {
        let found = false;
        for (const rule of family) {
            for (const variant of variants) {
                const matched: Parts[] = [];
                let captured = '';
                let capturing = false;
                let first = true;
                for (const pattern of rule.longhands) {
                    const captures = pattern.endsWith('(.*)');
                    const prefix = captures ? pattern.slice(0, -4) : pattern;
                    for (const part of classes) {
                        if (part.variants !== variant) continue;
                        if (captures ? !part.base.startsWith(prefix) : part.base !== prefix) continue;
                        const value = captures ? part.base.slice(prefix.length) : '';
                        if (first) { captured = value; capturing = captures; first = false; }
                        else if (value !== captured || capturing !== captures) continue;
                        matched.push(part);
                        break;
                    }
                }
                if (matched.length !== rule.longhands.length) continue;
                let markerEnd = false;
                let important = false;
                let negative = false;
                for (const part of matched) {
                    markerEnd = markerEnd || part.markerEnd;
                    important = important || part.important;
                    negative = negative || part.negative;
                }
                let agrees = true;
                for (const part of matched) {
                    if (part.important !== important || part.negative !== negative) agrees = false;
                }
                if (!agrees) continue;
                const longhands: string[] = [];
                for (const part of matched) longhands.push(part.name);
                const shorthands: string[] = [];
                let allPresent = true;
                for (const substitute of rule.shorthands) {
                    let name = capturing ? substitute.split('$1').join(captured) : substitute;
                    if (negative) name = '-' + name;
                    if (important) name = markerEnd ? name + '!' : '!' + name;
                    if (variant !== '') name = variant + ':' + name;
                    shorthands.push(name);
                    if (!names.includes(name)) allPresent = false;
                }
                if (allPresent) continue;
                result.push(new Collapse(longhands, shorthands));
                found = true;
                break;
            }
            if (found) break;
        }
    }
    return result;
}
export function message(longhands: string, shorthands: string): string {
    return '"' + longhands + '" is the longhand spelling of "' + shorthands + '", which sets the same declarations in one class. The pair carries no information the single class does not, and it costs the next reader a moment working out whether the two halves were meant to move together or drifted apart. Write it as "' + shorthands + '".';
}
