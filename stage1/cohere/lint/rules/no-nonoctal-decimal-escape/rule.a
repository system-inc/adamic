import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Diagnostic, Edit, Suggestion } from '../typescript-prefer-as-const/records.a';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext; readonly records: Diagnostic[] = [];
    constructor(context: RuleContext) { this.context = context; }
    suggestion(record: Diagnostic, description: string, start: number, end: number, text: string): void {
        const suggestion = new Suggestion('nonoctalDecimalEscape', description);
        suggestion.edits.push(new Edit(start, end, text)); record.suggestions.push(suggestion);
    }
    analyze(index: number): void {
        const context = this.context; const node = context.node(index);
        if(node.kind !== 'StringLiteral') return;
        const start = context.start(index); const raw = context.source.slice(start, node.end);
        let previousNull = false; let position = 0;
        while(position < raw.length) {
            if(raw.charCodeAt(position) !== 92 || position + 1 >= raw.length) {
                previousNull = false; position++; continue;
            }
            const digit = raw.slice(position + 1, position + 2);
            if(digit !== '8' && digit !== '9') {
                previousNull = digit === '0'; position += 2; continue;
            }
            const escapeStart = start + position; const escapeEnd = escapeStart + 2;
            const escapeText = raw.slice(position, position + 2);
            const record = new Diagnostic('no-nonoctal-decimal-escape', 'nonoctalDecimalEscape', message, escapeStart, escapeEnd);
            if(previousNull) {
                this.suggestion(record, `Replace \`\\0${escapeText}\` with \`\\u0000${digit}\`, which matches the same characters without turning the repair into a legacy octal escape.`, escapeStart - 2, escapeEnd, '\\u0000' + digit);
                this.suggestion(record, `Replace \`${escapeText}\` with \`\\u003${digit}\`, keeping the digit and leaving the null escape before it alone.`, escapeStart, escapeEnd, '\\u003' + digit);
            }
            else {
                this.suggestion(record, `Replace \`${escapeText}\` with \`${digit}\` if the digit is what was meant. The escape already means exactly that, so this changes nothing at runtime.`, escapeStart, escapeEnd, digit);
            }
            this.suggestion(record, `Replace \`${escapeText}\` with \`\\${escapeText}\` if a literal backslash before the digit is what was meant. This one does change the string.`, escapeStart, escapeEnd, '\\' + escapeText);
            this.records.push(record); previousNull = false; position += 2;
        }
    }
    visit(index: number): void {
        const previous = this.records.length; this.analyze(index);
        if(this.records.length !== previous) panic('no-nonoctal-decimal-escape requires complete suggestion renderer');
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
