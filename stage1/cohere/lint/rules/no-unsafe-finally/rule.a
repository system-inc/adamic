import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import {
    messageUnsafeFinallyReturn,
    messageUnsafeFinallyThrow,
    messageUnsafeFinallyBreak,
    messageUnsafeFinallyContinue,
} from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        const isBreak = node.kind === 'BreakStatement';
        const isContinue = node.kind === 'ContinueStatement';
        const label = isBreak || isContinue ? (node.children[0] ?? -1) : -1;
        for(let parent = this.context.parent(index); parent >= 0; parent = this.context.parent(parent)) {
            const owner = this.context.node(parent);
            if(this.context.functionLike(parent) || owner.kind === 'ClassDeclaration' || owner.kind === 'ClassExpression') {
                return;
            }
            const loop = ['WhileStatement', 'DoStatement', 'ForStatement', 'ForInStatement', 'ForOfStatement'].includes(owner.kind);
            // Go also stops labeled continues at an intervening loop.
            if((isContinue || (isBreak && label < 0)) && loop) {
                return;
            }
            if(isBreak && label < 0 && owner.kind === 'SwitchStatement') {
                return;
            }
            if(label >= 0 && owner.kind === 'LabeledStatement' &&
                this.context.node(owner.children[0] ?? -1).text === this.context.node(label).text) {
                return;
            }
            const grandparent = this.context.parent(parent);
            if(grandparent >= 0 && owner.kind === 'Block') {
                const enclosing = this.context.node(grandparent);
                if(enclosing.kind === 'TryStatement' && enclosing.children.length > 1 && enclosing.children[0] !== parent &&
                    enclosing.children[enclosing.children.length - 1] === parent) {
                    const id = isBreak ? 'unsafeBreak' : isContinue ? 'unsafeContinue' :
                        node.kind === 'ReturnStatement' ? 'unsafeReturn' : 'unsafeThrow';
                    const message = isBreak ? messageUnsafeFinallyBreak : isContinue ? messageUnsafeFinallyContinue :
                        node.kind === 'ReturnStatement' ? messageUnsafeFinallyReturn : messageUnsafeFinallyThrow;
                    this.context.report(index, 'no-unsafe-finally', id, message, '', '', '');
                    return;
                }
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
