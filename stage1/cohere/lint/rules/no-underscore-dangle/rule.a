import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { panic } from 'adamic';
import { RuleContext } from '../../context.ts';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    flag(name: string, fallback: string): boolean { return this.context.settings.read(name, fallback) === 'true'; }
    reportable(name: string): boolean { return name !== '' && name !== '_' && (name.startsWith('_') || name.endsWith('_')) && !this.context.settings.list('allow', []).includes(name); }
    report(index: number, name: string): void {
        this.context.report(index, 'no-underscore-dangle', 'unexpectedUnderscore', `Unexpected dangling '_' in '${name}'. A leading or trailing underscore is a convention for privacy that the language does not enforce, so it tells a reader something is off limits while doing nothing to keep them out. Where privacy is real, \`#private\` or a closure says so and is checked.`, '', '', '');
    }
    name(index: number): number {
        const node = this.context.node(index);
        for(const child of node.children) {
            const kind = this.context.node(child).kind;
            if(['DotDotDotToken','AsteriskToken','AtToken','Decorator'].includes(kind) || kind.endsWith('Keyword')) { continue; }
            return child;
        }
        return -1;
    }
    bindingName(index: number): number {
        const children = this.context.node(index).children;
        const offset = children.length > 0 && this.context.node(children[0] ?? -1).kind === 'DotDotDotToken' ? 1 : 0;
        const first = children[offset] ?? -1;
        if(first < 0) { return -1; }
        this.context.scanner.pos = this.context.node(first).end;
        if(this.context.scanner.scan() === 'ColonToken') { return children[offset + 1] ?? -1; }
        return first;
    }
    bindings(index: number, declaration: number, pattern: string): void {
        if(index < 0) { return; }
        const node = this.context.node(index);
        if(node.kind === 'Identifier') {
            if(pattern === 'ArrayBindingPattern' && this.flag('allowinarraydestructuring','true')) { return; }
            if(pattern === 'ObjectBindingPattern' && this.flag('allowinobjectdestructuring','true')) { return; }
            if(this.reportable(node.text)) { this.report(declaration,node.text); }
            return;
        }
        if(node.kind === 'ObjectBindingPattern' || node.kind === 'ArrayBindingPattern') {
            for(const element of node.children) { this.bindings(this.bindingName(element), declaration, node.kind); }
        }
    }
    visit(node: ParseNode, index: number): void {
        if(node.kind === 'VariableDeclaration') { this.bindings(node.children[0] ?? -1,index,''); return; }
        if(node.kind === 'PropertyAccessExpression') {
            const name = node.children[node.children.length - 1] ?? panic('member name');
            const member = this.context.node(name);
            if(member.kind !== 'Identifier' || member.text === '__proto__' || !this.reportable(member.text)) { return; }
            const receiver = this.context.node(node.children[0] ?? panic('receiver'));
            if(receiver.kind === 'ThisKeyword' && this.flag('allowafterthis','false')) { return; }
            if(receiver.kind === 'SuperKeyword' && this.flag('allowaftersuper','false')) { return; }
            if(receiver.kind === 'PropertyAccessExpression' && this.flag('allowafterthisconstructor','false')) {
                const innerName = receiver.children[receiver.children.length - 1] ?? panic('inner name');
                const inner = receiver.children[0] ?? panic('inner receiver');
                if(this.context.node(innerName).text === 'constructor' && this.context.node(inner).kind === 'ThisKeyword') { return; }
            }
            this.report(index,member.text); return;
        }
        const name = this.name(index);
        if(name >= 0) {
            const named = this.context.node(name);
            if(node.kind === 'FunctionDeclaration' && named.kind === 'Identifier' && this.reportable(named.text)) { this.report(index,named.text); }
            const gated = node.kind === 'MethodDeclaration' && this.flag('enforceinmethodnames','false') || node.kind === 'PropertyDeclaration' && this.flag('enforceinclassfields','false');
            if(gated && (named.kind === 'Identifier' || named.kind === 'PrivateIdentifier')) {
                const bare = named.kind === 'PrivateIdentifier' ? named.text.slice(1) : named.text;
                if(this.reportable(bare)) { this.report(index,named.text); }
            }
        }
        if(node.kind === 'PropertyDeclaration' || this.flag('allowfunctionparams','true')) { return; }
        for(const child of node.children) {
            if(this.context.node(child).kind !== 'Parameter') { continue; }
            const parameterName = this.name(child);
            if(parameterName >= 0) {
                const named = this.context.node(parameterName);
                if(named.kind === 'Identifier' && this.reportable(named.text)) { this.report(child,named.text); }
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
