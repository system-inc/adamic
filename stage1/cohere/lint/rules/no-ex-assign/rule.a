import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { messageUnexpectedExceptionAssignment } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        const declaration = node.children[0] ?? -1;
        const block = node.children[1] ?? -1;
        if(declaration < 0 || block < 0 || this.context.node(declaration).kind !== 'VariableDeclaration') { return; }
        const name = this.context.node(declaration).children[0] ?? -1;
        if(name < 0 || this.context.node(name).kind !== 'Identifier') { return; }
        this.assignments(block, this.context.node(name).text);
    }
    assignments(index: number, name: string): void {
        const node = this.context.node(index);
        let target = -1;
        if(node.kind === 'BinaryExpression' && [
            'EqualsToken', 'PlusEqualsToken', 'MinusEqualsToken', 'AsteriskEqualsToken',
            'AsteriskAsteriskEqualsToken', 'SlashEqualsToken', 'PercentEqualsToken',
            'LessThanLessThanEqualsToken', 'GreaterThanGreaterThanEqualsToken',
            'GreaterThanGreaterThanGreaterThanEqualsToken', 'AmpersandEqualsToken',
            'BarEqualsToken', 'CaretEqualsToken', 'BarBarEqualsToken',
            'AmpersandAmpersandEqualsToken', 'QuestionQuestionEqualsToken',
        ].includes(this.context.node(node.children[1] ?? -1).kind)) {
            target = this.context.unwrap(node.children[0] ?? -1);
        }
        if((node.kind === 'PrefixUnaryExpression' || node.kind === 'PostfixUnaryExpression') &&
            (node.operator === 'PlusPlusToken' || node.operator === 'MinusMinusToken')) {
            target = this.context.unwrap(node.children[0] ?? -1);
        }
        if(target >= 0 && this.context.node(target).kind === 'Identifier' && this.context.node(target).text === name) {
            this.context.report(target, 'no-ex-assign', 'unexpectedExceptionAssignment', messageUnexpectedExceptionAssignment, '', '', '');
        }
        for(const child of node.children) { this.assignments(child, name); }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
