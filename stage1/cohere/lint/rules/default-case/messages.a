export const ids: readonly string[] = ["missingDefaultCase"];
export const messages: readonly string[] = ["This `switch` has no `default` case, so a value matching none of its cases falls through silently and the statement does nothing. That is occasionally what the author meant and is far more often an unhandled case that was added to the type later and never added here. The two readings are indistinguishable from the code, which is the problem: a reader cannot tell a deliberate omission from a forgotten branch. Add a `default`, even one that throws, or write a `// no default` comment after the last case to say the omission is intended."];
