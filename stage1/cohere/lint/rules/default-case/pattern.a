import { panic } from 'adamic';
import { fixedDefaultPattern } from './fixed_pattern.a';
// Runtime options use the required constructor. Go option-dialect parity remains blocked.
export class Pattern {
    readonly source: string;
    readonly ignoreCase: boolean;
    readonly valid: boolean;
    private readonly expression: RegExp;
    private readonly fixed: boolean;
    constructor(source: string, ignoreCase: boolean, fixed: boolean = false) {
        this.source = source; this.ignoreCase = ignoreCase; this.valid = true;
        this.fixed = fixed;
        this.expression = fixed ? fixedDefaultPattern() : source === '' ? /(?:)/u : new RegExp(source, 'u');
    }
    match(text: string): boolean {
        if(!this.fixed) { panic('NotYet: Go commentPattern option parity with new RegExp(pattern, u) is unresolved'); }
        this.expression.lastIndex = 0;
        return this.expression.test(text);
    }
}
