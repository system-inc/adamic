import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { ParseNode as MissingNode } from '../../../../typescript/parser/nodes.ts';
export function waveNode(context: RuleContext, index: number): ParseNode { return index < 0 ? new MissingNode('Missing', 0, 0, []) : context.node(index); }
