+import type { RuleContext } from '../../context.ts';
+import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
+import { SymbolDetails } from '../../checker_declarations.a';
+import { objectMessage, undefinedMessage } from './messages.a';
+export class Rule {
+    readonly context: RuleContext;
+    constructor(context: RuleContext) {
+        this.context = context;
+    }
+    couldBeError(index: number): boolean {
+        if(index < 0) {
+            return false;
+        }
+        const node = this.context.node(index);
+        if(
+            [
+                'Identifier',
+                'CallExpression',
+                'NewExpression',
+                'PropertyAccessExpression',
+                'ElementAccessExpression',
+                'TaggedTemplateExpression',
+                'YieldExpression',
+                'AwaitExpression',
+            ].includes(node.kind)
+        ) {
+            return true;
+        }
+        if(node.kind === 'BinaryExpression') {
+            const left = node.children[0] ?? -1;
+            const operator = this.context.node(node.children[1] ?? -1).kind;
+            const right = node.children[2] ?? -1;
+            if(
+                ['EqualsToken', 'AmpersandAmpersandEqualsToken', 'AmpersandAmpersandToken', 'CommaToken'].includes(
+                    operator,
+                )
+            ) {
+                return this.couldBeError(right);
+            }
+            if(
+                ['BarBarEqualsToken', 'QuestionQuestionEqualsToken', 'BarBarToken', 'QuestionQuestionToken'].includes(
+                    operator,
+                )
+            ) {
+                return this.couldBeError(left) || this.couldBeError(right);
+            }
+        }
+        if(node.kind === 'ConditionalExpression') {
+            return this.couldBeError(node.children[2] ?? -1) || this.couldBeError(node.children[4] ?? -1);
+        }
+        return false;
+    }
+    globalUndefined(index: number): boolean {
+        const checker = this.context.checker;
+        if(checker === undefined) { return false; }
+        // Same-node GetSymbolAtLocation, matching cohere's zero ProgramReads.
+        const answer = checker.ask(index, 'node-symbol-details');
+        if(answer.value === undefined) { return false; }
+        const symbol = new SymbolDetails(answer.value);
+        return !symbol.declarations.some((declaration) => !declaration.declarationFile);
+    }
+    visit(node: ParseNode, index: number): void {
+        if(this.context.checker === undefined) { return; }
+        const argument = node.children[0] ?? -1;
+        if(argument < 0) { return; }
+        const expression = this.context.node(argument);
+        if(!this.couldBeError(argument)) {
+            this.context.reportNode(index, 'no-throw-literal', 'object', objectMessage);
+        }
+        else if(expression.kind === 'Identifier' && expression.text === 'undefined' && this.globalUndefined(argument)) {
+            this.context.reportNode(index, 'no-throw-literal', 'undef', undefinedMessage);
+        }
+    }
+}
+export function create(context: RuleContext): Rule { return new Rule(context); }
