import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { RuleFacts } from './facts.a';
import { Bindings } from '../../../typeaware/bindings.ts';
import { CallbackSymbols } from '../../../typeaware/callback_symbol_facts.a';
import { PreferArrowCallback } from './engine.a';
export class Rule {
    readonly facts: RuleFacts;
    readonly engine: PreferArrowCallback;
    constructor(context: RuleContext) {
        const facts = new RuleFacts(context);
        this.facts = facts;
        this.engine = new PreferArrowCallback(facts, new Bindings(facts), new CallbackSymbols(facts), context.settings.read('allownamedfunctions', 'false') === 'true', context.settings.read('allowunboundthis', 'true') === 'true');
    }
    visit(node: ParseNode, index: number): void {
        this.engine.run(index);
        this.facts.flush();
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
