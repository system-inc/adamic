export function standardName(name: string): string {
 for (const row of domAttributeNames) { if (row[0] === name) { return row[1] ?? ''; } }
 for (const row of svgDomAttributeNames) { if (row[0] === name) { return row[1] ?? ''; } }
 for (const candidate of names) { if (matchIgnoringCase(candidate,name)) { return candidate; } }
 return '';
}
