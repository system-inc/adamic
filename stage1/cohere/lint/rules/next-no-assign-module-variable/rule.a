import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';


export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        for(const list of node.children) {
            if(this.context.node(list).kind !== 'VariableDeclarationList') {
                continue;
            }
            for(const declaration of this.context.node(list).children) {
                const name = this.context.node(declaration).children[0] ?? -1;
                if(name >= 0 && this.context.node(name).kind === 'Identifier' && this.context.node(name).text === 'module') {
                    this.context.report(index, '@next/next/no-assign-module-variable', 'noAssignModuleVariable', message, '', '', '');
                    return;
                }
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
