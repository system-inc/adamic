import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(index: number): void {
        const context = this.context;
        for(const child of context.node(index).children) {
            if(context.node(child).kind !== 'VariableDeclarationList') continue;
            for(const declaration of context.node(child).children) {
                const name = context.node(declaration).children[0] ?? -1;
                if(name < 0 || context.node(name).kind !== 'Identifier') continue;
                if(context.node(name).text !== 'module') continue;
                context.report(index, '@next/next/no-assign-module-variable', 'noAssignModuleVariable', message, '', '', '');
                return;
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
