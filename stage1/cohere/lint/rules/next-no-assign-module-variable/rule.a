import type { RuleContext } from '../../context.ts';
import { description } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(index: number): void {
        for(const child of this.context.node(index).children) {
            if(this.context.node(child).kind !== 'VariableDeclarationList') {
                continue;
            }
            for(const declaration of this.context.node(child).children) {
                const nameIndex = this.context.node(declaration).children[0] ?? -1;
                if(nameIndex < 0) {
                    continue;
                }
                const name = this.context.node(nameIndex);
                if(name.kind === 'Identifier' && name.text === 'module') {
                    this.context.report(index, '@next/next/no-assign-module-variable', 'noAssignModuleVariable', description, '', '', '');
                    return;
                }
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
