import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';

const prefixes = ['ml-', 'mr-', 'pl-', 'pr-', 'text-left', 'text-right', 'left-', 'right-', 'border-l', 'border-l-', 'border-r', 'border-r-', 'rounded-l', 'rounded-l-', 'rounded-r', 'rounded-r-', 'scroll-ml-', 'scroll-mr-', 'scroll-pl-', 'scroll-pr-'];
const replacements = ['ms-', 'me-', 'ps-', 'pe-', 'text-start', 'text-end', 'start-', 'end-', 'border-s', 'border-s-', 'border-e', 'border-e-', 'rounded-s', 'rounded-s-', 'rounded-e', 'rounded-e-', 'scroll-ms-', 'scroll-me-', 'scroll-ps-', 'scroll-pe-'];
const exact = [false, false, false, false, true, true, false, false, true, false, true, false, true, false, true, false, false, false, false, false];
const negatable = [true, true, true, true, false, false, true, true, false, false, false, false, false, false, false, false, false, false, false, false];
// Go strings.Fields uses Unicode White_Space, which differs from ECMAScript \s.
const whitespace = /[\t\n\v\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+/;
const shape = /^-?(?:[a-z]+:)*(?:[a-z]+-)?[a-z]+(?:-[a-z0-9.\[\]/]+)?$/;

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    replacement(base: string): string {
        const negative = base.startsWith('-') ? '-' : '';
        const body = negative === '' ? base : base.slice(1);
        for(let index = 0; index < prefixes.length; index++) {
            const prefix = prefixes[index] ?? '';
            const replacement = replacements[index] ?? '';
            if(exact[index] === true) {
                if(body === prefix && negative === '') { return replacement; }
            }
            else if(body.startsWith(prefix) && body.length > prefix.length && (negative === '' || negatable[index] === true)) {
                return negative + replacement + body.slice(prefix.length);
            }
        }
        return '';
    }
    report(index: number): void {
        const tokens = this.context.node(index).text.split(whitespace);
        let qualifies = false;
        for(const token of tokens) {
            if(token !== undefined && shape.test(token)) { qualifies = true; }
        }
        if(!qualifies) { return; }
        for(const token of tokens) {
            if(token === undefined || token === '') { continue; }
            const parts = token.split(':');
            const base = parts[parts.length - 1] ?? '';
            let directionAware = false;
            let variants = '';
            for(let position = 0; position < parts.length - 1; position++) {
                const part = parts[position] ?? '';
                if(part === 'rtl' || part === 'ltr') { directionAware = true; }
                variants += part + ':';
            }
            if(directionAware) { continue; }
            const replacement = this.replacement(base);
            if(replacement !== '') {
                this.context.report(index, 'structure/tailwind-no-physical-direction', 'useLogicalClass', message(token, variants + replacement), '', '', '');
            }
        }
    }
    visit(index: number): void {
        const path = this.context.parser.path;
        if(!path.endsWith('.ts') && !path.endsWith('.tsx')) { return; }
        const node = this.context.node(index);
        if(node.kind !== 'TemplateExpression') { this.report(index); return; }
        for(const child of node.children) {
            const kind = this.context.node(child).kind;
            if(kind === 'TemplateHead') { this.report(child); }
            if(kind === 'TemplateSpan') {
                for(const piece of this.context.node(child).children) {
                    const pieceKind = this.context.node(piece).kind;
                    if(pieceKind === 'TemplateMiddle' || pieceKind === 'TemplateTail') { this.report(piece); }
                }
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
