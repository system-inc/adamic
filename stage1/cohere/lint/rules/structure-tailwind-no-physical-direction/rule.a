import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    replacement(base: string): string {
        const negative = base.startsWith('-');
        const body = negative ? base.slice(1) : base;
        const prefixes = ['ml-', 'mr-', 'pl-', 'pr-', 'left-', 'right-', 'border-l-', 'border-r-', 'rounded-l-', 'rounded-r-', 'scroll-ml-', 'scroll-mr-', 'scroll-pl-', 'scroll-pr-'];
        const targets = ['ms-', 'me-', 'ps-', 'pe-', 'start-', 'end-', 'border-s-', 'border-e-', 'rounded-s-', 'rounded-e-', 'scroll-ms-', 'scroll-me-', 'scroll-ps-', 'scroll-pe-'];
        if(!negative) {
            const exact = ['text-left', 'text-right', 'border-l', 'border-r', 'rounded-l', 'rounded-r'];
            const logical = ['text-start', 'text-end', 'border-s', 'border-e', 'rounded-s', 'rounded-e'];
            const at = exact.indexOf(body);
            if(at >= 0) { return logical[at] ?? ''; }
        }
        for(let at = 0; at < prefixes.length; at++) {
            const prefix = prefixes[at] ?? '';
            if(body.startsWith(prefix) && body.length > prefix.length && (!negative || at < 6)) {
                return `${negative ? '-' : ''}${targets[at] ?? ''}${body.slice(prefix.length)}`;
            }
        }
        return '';
    }
    report(index: number): void {
        const tokens = this.context.node(index).text.split(/[\t\n\v\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+/).map(token => token ?? '').filter(token => token !== '');
        if(!tokens.some(token => /^-?(?:[a-z]+:)*(?:[a-z]+-)?[a-z]+(?:-[a-z0-9.\[\]/]+)?$/.test(token))) { return; }
        for(const token of tokens) {
            const parts = token.split(':');
            const base = parts.pop() ?? '';
            if(parts.includes('rtl') || parts.includes('ltr')) { continue; }
            const replaced = this.replacement(base);
            if(replaced === '') { continue; }
            const replacement = parts.length === 0 ? replaced : `${parts.join(':')}:${replaced}`;
            this.context.report(index, 'structure/tailwind-no-physical-direction', 'useLogicalClass', message(token, replacement), '', '', '');
        }
    }
    visit(index: number): void {
        // Parser retains the source filename; the Go rule is offered only .ts/.tsx.
        const filename = this.context.parser.path;
        if(!filename.endsWith('.ts') && !filename.endsWith('.tsx')) { return; }
        if(this.context.node(index).kind !== 'TemplateExpression') { this.report(index); return; }
        for(const child of this.context.node(index).children) {
            if(this.context.node(child).kind === 'TemplateHead') { this.report(child); }
            if(this.context.node(child).kind === 'TemplateSpan') {
                for(const literal of this.context.node(child).children) {
                    if(['TemplateMiddle', 'TemplateTail'].includes(this.context.node(literal).kind)) { this.report(literal); }
                }
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
