import { panic, programArguments, readTextFile } from 'adamic';
import { Parser } from '../../../../typescript/parser/parser.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { written } from '../../../../typescript/parser/nodes.ts';
import { RuleContext } from '../../context.ts';
import { Settings } from '../../settings.ts';
import { Rule as ConstRule } from './rule.a';
import { Rule as ConstraintRule } from '../typescript-eslint-no-unnecessary-type-constraint/rule.a';
import { Rule as EnumRule } from '../typescript-eslint-prefer-enum-initializers/rule.a';
import { Diagnostic, Edit } from './repairs.a';

function ancestry(context: RuleContext, parents: number[], index: number, parent: number): void {
    parents[index] = parent;
    for(const child of context.node(index).children) { ancestry(context, parents, child, index); }
}
function walk(context: RuleContext, index: number, selected: string, constant: ConstRule, constraint: ConstraintRule, enumeration: EnumRule): void {
    if(selected === '@typescript-eslint/prefer-as-const') { constant.visit(index); }
    else if(selected === '@typescript-eslint/no-unnecessary-type-constraint') { constraint.visit(index); }
    else if(selected === '@typescript-eslint/prefer-enum-initializers') { enumeration.visit(index); }
    else { panic('unknown owned rule'); }
    for(const child of context.node(index).children) { walk(context, child, selected, constant, constraint, enumeration); }
}
function byteOffset(source: string, end: number): number {
    let bytes = 0;
    for(let i = 0; i < end; i++) {
        const code = source.codePointAt(i) ?? 0;
        if(code > 65535) { i++; }
        bytes += code < 128 ? 1 : code < 2048 ? 2 : code < 65536 ? 3 : 4;
    }
    return bytes;
}
function apply(source: string, edits: readonly Edit[]): string {
    const ordered = edits.slice();
    ordered.sort((left, right) => right.start - left.start);
    let text = source;
    let previous = source.length;
    for(const edit of ordered) {
        if(edit.end > previous || edit.end < edit.start) { panic('overlapping owned edits'); }
        text = text.slice(0, edit.start) + edit.text + text.slice(edit.end);
        previous = edit.start;
    }
    return text;
}
function printEdit(source: string, edit: Edit, kind: string): void {
    console.log(`${kind} ${byteOffset(source, edit.start)} ${byteOffset(source, edit.end)}\t${written(edit.text)}`);
}
function run(row: string, countOnly: boolean): number {
    const fields = row.split('\t');
    const path = fields[0] ?? panic('missing source path');
    const selected = fields[1] ?? panic('missing selection');
    const read = readTextFile(path);
    if(read.kind === 'Error') { panic(read.message); }
    const parser = new Parser(read.text, fields[2] ?? path);
    const scanner = new Scanner(read.text);
    const parents: number[] = [];
    const context = new RuleContext(read.text, parser, scanner, selected, '', '', false, parents, new Settings());
    const root = parser.file();
    for(const node of parser.nodes) { parents.push(-1); }
    ancestry(context, parents, root, -1);
    const constant = new ConstRule(context);
    const constraint = new ConstraintRule(context);
    const enumeration = new EnumRule(context);
    walk(context, root, selected, constant, constraint, enumeration);
    const diagnostics = selected === '@typescript-eslint/prefer-as-const' ? constant.diagnostics : selected === '@typescript-eslint/no-unnecessary-type-constraint' ? constraint.diagnostics : enumeration.diagnostics;
    diagnostics.sort((left, right) => left.start - right.start);
    if(countOnly) { return diagnostics.length; }
    const fixes: Edit[] = [];
    for(const diagnostic of diagnostics) {
        console.log(`range ${byteOffset(read.text, diagnostic.start)} ${byteOffset(read.text, diagnostic.end)} ${diagnostic.id}\t${written(diagnostic.message)}`);
        for(const fix of diagnostic.fixes) { printEdit(read.text, fix, 'fix'); fixes.push(fix); }
        for(const suggestion of diagnostic.suggestions) {
            console.log(`suggestion ${suggestion.id}\t${written(suggestion.message)}`);
            for(const edit of suggestion.edits) { printEdit(read.text, edit, 'edit'); }
            console.log(`suggested\t${written(apply(read.text, suggestion.edits))}`);
        }
    }
    console.log(`fixed\t${written(apply(read.text, fixes))}`);
    return diagnostics.length;
}
const args = programArguments();
const manifest = readTextFile(args[0] ?? panic('missing manifest'));
if(manifest.kind === 'Error') { panic(manifest.message); }
let count = 0; let index = 0;
const countOnly = args.includes('--count');
for(const row of manifest.text.split('\n')) {
    if(row === '') { continue; }
    if(!countOnly) { console.log(`case ${index}`); }
    count += run(row, countOnly); index++;
}
if(countOnly) { console.log(`${count}`); }
