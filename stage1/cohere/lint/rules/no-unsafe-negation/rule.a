import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { panic } from 'adamic';
import { RuleContext } from '../../context.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        const left = node.children[0] ?? panic('binary left');
        const operator = this.context.node(node.children[1] ?? panic('binary operator')).kind;
        const right = node.children[2] ?? panic('binary right');
        let text = operator === 'InKeyword' ? 'in' : operator === 'InstanceOfKeyword' ? 'instanceof' : '';
        if(text === '' && this.context.settings.read('enforcefororderingrelations', 'false') === 'true') {
            text = operator === 'LessThanToken' ? '<' : operator === 'LessThanEqualsToken' ? '<=' : operator === 'GreaterThanToken' ? '>' : operator === 'GreaterThanEqualsToken' ? '>=' : '';
        }
        if(text === '' || this.context.node(left).kind !== 'PrefixUnaryExpression' || this.context.node(left).operator !== 'ExclamationToken') { return; }
        const operand = this.context.node(left).children[0] ?? panic('negation operand');
        const message = `The \`!\` binds tighter than the \`${text}\` after it, so this negates the left operand and then compares the resulting boolean, rather than negating the comparison. \`!key ${text} object\` runs the \`!\` first and hands \`${text}\` a \`true\` or a \`false\`, which is almost never the question being asked, and it is a valid expression either way so nothing else reports it.`;
        const finding = this.context.report(left, 'no-unsafe-negation', 'unexpected', message, '', '', '');
        const operandText = this.context.source.slice(this.context.start(operand), this.context.node(operand).end);
        const rightText = this.context.source.slice(this.context.start(right), this.context.node(right).end);
        const negationText = this.context.source.slice(this.context.start(left), this.context.node(left).end);
        finding.suggestions.push(new Suggestion('negateTheComparison', `Negate the whole \`${text}\` comparison, which is what the parentheses in \`!(a ${text} b)\` say and is almost certainly the intent. This changes what the code does.`, [new SuggestionEdit(this.context.start(index), node.end, `!(${operandText} ${text} ${rightText})`)]));
        finding.suggestions.push(new Suggestion('parenthesiseTheNegation', 'Wrap the negation in parentheses to say the `!` was meant to apply to the left operand alone. This preserves what the code does today and only makes it explicit.', [new SuggestionEdit(this.context.start(left), this.context.node(left).end, `(${negationText})`)]));
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
