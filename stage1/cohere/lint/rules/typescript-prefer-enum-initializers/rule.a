import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { RuleContext } from '../../context.ts';
import { noEdits } from '../../context.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';
import { description } from './messages.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        let position = 0;
        for(const member of node.children) {
            if(this.context.node(member).kind !== 'EnumMember') { continue; }
            if(this.context.node(member).children.length === 1) {
                const start = this.context.start(member);
                const end = this.context.node(member).end;
                const name = this.context.source.slice(start, end);
                const suggestions: Suggestion[] = [];
                for(const value of [String(position), String(position + 1), "'" + name + "'"]) {
                    const text = name + ' = ' + value;
                    suggestions.push(new Suggestion('defineInitializerSuggestion', 'Can be fixed to ' + text,
                        [new SuggestionEdit(start, end, text)]));
                }
                const rule = '@typescript-eslint/prefer-enum-initializers';
                this.context.reportNode(member, rule, 'defineInitializer', description(name), noEdits, suggestions);
            }
            position++;
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
