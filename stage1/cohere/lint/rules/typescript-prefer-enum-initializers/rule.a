import type { RuleContext } from '../../context.ts';
import { Edit, Result, Suggestion, emptyEdits, emptyResults, publish } from '../typescript-no-unnecessary-type-constraint/results.a';

// Numeric SyntaxKind values from the pinned Go parser: EnumDeclaration.
export const syntaxKinds: readonly number[] = [267];

export class Rule {
    readonly context: RuleContext;
    results: readonly Result[] = emptyResults();
    constructor(context: RuleContext) { this.context = context; }
    evaluate(index: number): void {
        if(this.context.node(index).kind !== 'EnumDeclaration') { return; }
        let position = 0;
        for(const child of this.context.node(index).children) {
            const member = this.context.node(child);
            if(member.kind !== 'EnumMember') { continue; }
            if(member.children.length === 1) {
                const start = this.context.start(child);
                const name = this.context.source.slice(start, member.end);
                const suggestions: Suggestion[] = [];
                for(const value of [`${position}`, `${position + 1}`, `'${name}'`]) {
                    suggestions.push(new Suggestion('defineInitializerSuggestion', `Can be fixed to ${name} = ${value}`, [new Edit(start, member.end, `${name} = ${value}`)]));
                }
                this.results = [...this.results, new Result(child, '@typescript-eslint/prefer-enum-initializers', 'defineInitializer', `The value of the member '${name}' should be explicitly defined.`, emptyEdits(), suggestions)];
            }
            position++;
        }
    }
    visit(index: number): void {
        const before = this.results.length;
        this.evaluate(index);
        for(let position = before; position < this.results.length; position++) {
            const result = this.results[position];
            if(result !== undefined) { publish(this.context, result); }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
