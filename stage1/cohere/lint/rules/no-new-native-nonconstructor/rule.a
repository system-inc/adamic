import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { firstDeclarationIsFile } from '../../checker_local_symbols.a';
export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(node: ParseNode, index: number): void {
        const context = this.context;
        const checker = context.checker;
        if(checker === undefined) { return; }
        let callee = node.children[0] ?? -1;
        if(callee < 0) { return; }
        const target = context.node(callee);
        if(target.kind !== 'Identifier' || !["Symbol", "BigInt"].includes(target.text)) { return; }
        if(!firstDeclarationIsFile(checker, target)) { return; }
        const name = target.text;
        context.reportRange(context.start(callee), target.end, 'no-new-native-nonconstructor', 'noNewNativeNonconstructor', `This calls \`new ${name}()\`. ${name} is a function that returns a primitive and throws a TypeError when constructed, so this line fails at runtime every time it is reached. Call it without \`new\`.`);
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
