import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { message } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(index: number): void {
        const context = this.context;
        if(context.node(index).kind !== 'SwitchStatement') return;
        const block = context.node(index).children[1] ?? panic('switch without case block');
        const clauses = context.node(block).children;
        for(let position = 0; position < clauses.length; position++) {
            const clause = clauses[position] ?? panic('missing switch clause');
            if(context.node(clause).kind !== 'DefaultClause') continue;
            if(position !== clauses.length - 1) context.report(clause, 'default-case-last', 'notLast', message, '', '', '');
            return;
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
