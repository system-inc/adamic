export function message(created: string): string {
 const where = created === '' ? 'in this render' : 'at `' + created + '`';
 return 'This component is created during render, ' + where + ', so it gets a new identity every time this function runs. React compares components by identity, so it unmounts the previous one and mounts this as a fresh component rather than updating it, discarding all of its state and re-rendering its whole subtree on every render. The usual symptom is an input that loses what was typed into it. Move the component to module scope, or pass the value that varies as a prop.';
}
