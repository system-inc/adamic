import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { messageTooDeeply } from './messages.a';
import { integer } from './options.a';

export class Rule {
    readonly context: RuleContext;
    readonly maximum: number;
    readonly disabled: boolean;
    constructor(context: RuleContext) {
        this.context = context;
        this.maximum = integer(context.settings.read('maximum', '4'));
        this.disabled = context.settings.read('disabled', 'false') === 'true';
    }
    elseIf(node: ParseNode, index: number): boolean {
        if(node.kind !== 'IfStatement') {
            return false;
        }
        const parent = this.context.parent(index);
        if(parent < 0) {
            return false;
        }
        const ancestor = this.context.node(parent);
        return ancestor.kind === 'IfStatement' && ancestor.children[2] === index;
    }
    counted(node: ParseNode, index: number): boolean {
        switch(node.kind) {
            case 'IfStatement':
                return !this.elseIf(node, index);
            case 'SwitchStatement':
            case 'TryStatement':
            case 'DoStatement':
            case 'WhileStatement':
            case 'WithStatement':
            case 'ForStatement':
            case 'ForInStatement':
            case 'ForOfStatement':
                return true;
            default:
                return false;
        }
    }
    visit(node: ParseNode, index: number): void {
        // The registry hands only counted statement kinds to this listener.
        if(this.disabled || this.elseIf(node, index)) {
            return;
        }
        let depth = 1;
        let cursor = this.context.parent(index);
        while(cursor >= 0) {
            const ancestor = this.context.node(cursor);
            if(this.context.functionLike(cursor) || ancestor.kind === 'ClassStaticBlockDeclaration') {
                break;
            }
            if(this.counted(ancestor, cursor)) {
                depth++;
            }
            cursor = this.context.parent(cursor);
        }
        if(depth <= this.maximum) {
            return;
        }
        this.context.scanAt(node.pos);
        const start = this.context.scanStart();
        const end = this.context.scanEnd();
        this.context.reportRange(start, end, 'max-depth', 'tooDeeply',
            `Blocks are nested too deeply (${depth}). Maximum allowed is ${this.maximum}. ${messageTooDeeply}`);
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
