import { utf8Length } from 'adamic';
import { fencedBlock, inlineBackticks, doubleQuoted, singleQuotedToken,
    singleQuotedCapitalPhrase, jsDocGutter, blockCommentGutter,
    exampleTag, anyJsDocTag, promptLine, commandWordLine, lowercaseWord, dotBetweenLetters, uppercaseToken } from './patterns.a';

// MatchString has no persistent cursor in Go. Reset JS global literals for each predicate.
export function accepts(pattern: RegExp, text: string): boolean {
    pattern.lastIndex = 0;
    return pattern.test(text);
}

function blank(text: string, pattern: RegExp, keepNewlines: boolean): string {
    pattern.lastIndex = 0;
    let result = '';
    let cursor = 0;
    for(;;) {
        const match = pattern.exec(text);
        if(match === null) {
            break;
        }
        const value = match[0] ?? '';
        const blanked: string[] = [];
        for(const line of value.split('\n')) {
            blanked.push(' '.repeat(utf8Length(line)));
        }
        const replacement = keepNewlines ? blanked.join('\n') : ' '.repeat(utf8Length(value));
        result += text.slice(cursor, match.index) + replacement;
        cursor = match.index + value.length;
    }
    return result + text.slice(cursor);
}

function asciiLetterOrDigit(character: string): boolean {
    return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') ||
        (character >= '0' && character <= '9');
}

function capitalPhrases(text: string): string {
    singleQuotedCapitalPhrase.lastIndex = 0;
    let result = '';
    let cursor = 0;
    for(;;) {
        const match = singleQuotedCapitalPhrase.exec(text);
        if(match === null) {
            break;
        }
        const value = match[0] ?? '';
        const start = match.index;
        const end = start + value.length;
        if((start > 0 && asciiLetterOrDigit(text[start - 1] ?? '')) ||
            (end < text.length && asciiLetterOrDigit(text[end] ?? ''))) {
            continue;
        }
        result += text.slice(cursor, start) + ' '.repeat(utf8Length(value));
        cursor = end;
    }
    return result + text.slice(cursor);
}

function wrappedDoubleQuotes(text: string): string {
    const lines = text.split('\n');
    for(let index = 0; index + 1 < lines.length; index++) {
        const first = lines[index] ?? '';
        const second = lines[index + 1] ?? '';
        const opening = first.indexOf('"');
        const closing = second.indexOf('"');
        if(opening < 0 || closing < 0) {
            continue;
        }
        lines[index] = first.slice(0, opening) + ' '.repeat(utf8Length(first.slice(opening)));
        lines[index + 1] = ' '.repeat(utf8Length(second.slice(0, closing + 1))) + second.slice(closing + 1);
    }
    return lines.join('\n');
}

function indentedBlocks(text: string): string {
    const lines = text.split('\n');
    let previousIsBlank = true;
    let insideBlock = false;
    for(let index = 0; index < lines.length; index++) {
        const line = lines[index] ?? '';
        const content = line.replace(blockCommentGutter, '');
        // Reads: text.TrimWhitespace, the ECMAScript whitespace set.
        if(content.trim() === '') {
            previousIsBlank = true;
            continue;
        }
        const indented = content.startsWith('    ') || content.startsWith('\t');
        insideBlock = indented && (insideBlock || previousIsBlank);
        previousIsBlank = false;
        if(insideBlock) {
            lines[index] = ' '.repeat(utf8Length(line));
        }
    }
    return lines.join('\n');
}

function jsDocExamples(text: string): string {
    const lines = text.split('\n');
    let insideExample = false;
    for(let index = 0; index < lines.length; index++) {
        const line = lines[index] ?? '';
        const content = line.replace(jsDocGutter, '');
        if(accepts(exampleTag, content)) {
            insideExample = true;
            lines[index] = ' '.repeat(utf8Length(line));
            continue;
        }
        if(insideExample && accepts(anyJsDocTag, content)) {
            insideExample = false;
        }
        if(insideExample) {
            lines[index] = ' '.repeat(utf8Length(line));
        }
    }
    return lines.join('\n');
}

// Reads: shouting.indentation, after blockCommentGutter, in spaces or tabs.
function indentation(line: string): number {
    const body = line.replace(blockCommentGutter, '');
    let index = 0;
    while(index < body.length && (body[index] === ' ' || body[index] === '\t')) {
        index++;
    }
    return index;
}

// Reads: shouting.isCommandShaped.
function isCommandShaped(word: string): boolean {
    if('-<["\'`+/~.'.includes(word.slice(0, 1)) || word.includes('/') || word.includes('=') ||
        accepts(dotBetweenLetters, word) || word.endsWith(':')) {
        return true;
    }
    uppercaseToken.lastIndex = 0;
    const match = uppercaseToken.exec(word);
    return match !== null && match[0] === word;
}

// Reads: shouting.commandWordReadsAsProse. strings.Fields uses Go's whitespace set.
function commandWordReadsAsProse(previousLine: string, line: string, afterWord: string): boolean {
    let previous = previousLine.replace(jsDocGutter, '').trim();
    if(previous.startsWith('/*')) {
        previous = previous.slice(2);
    }
    while(previous.startsWith('*')) {
        previous = previous.slice(1);
    }
    previous = previous.trim();
    if(previous === '' || '.:!?;'.includes(previous.slice(-1)) || indentation(line) > indentation(previousLine)) {
        return false;
    }
    const words = afterWord.split(/[\t-\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+/u).filter(word => word !== '');
    for(let index = 0; index < 3; index++) {
        const word = words[index];
        if(word === undefined || isCommandShaped(word)) {
            return false;
        }
        if(!accepts(lowercaseWord, word)) {
            return true;
        }
    }
    return true;
}

// Reads: shouting.blankCommandLines. Each line sees the previous line already masked.
function commandLines(text: string): string {
    const lines = text.split('\n');
    for(let index = 0; index < lines.length; index++) {
        const line = lines[index] ?? '';
        const content = line.replace(jsDocGutter, '');
        let isCommand = accepts(promptLine, content);
        commandWordLine.lastIndex = 0;
        const starter = commandWordLine.exec(content);
        if(starter !== null) {
            isCommand = !commandWordReadsAsProse(lines[index - 1] ?? '', line, content.slice((starter[0] ?? '').length));
        }
        if(isCommand) {
            lines[index] = ' '.repeat(utf8Length(line));
        }
    }
    return lines.join('\n');
}

// Reads: shouting.MaskCodeAndCommands, in the same order. Every mask blanks one
// space per byte, as Go does, including indentation later read by commandWordReadsAsProse.
export function maskCodeAndCommands(text: string): string {
    let masked = blank(text, fencedBlock, true);
    masked = indentedBlocks(masked);
    masked = blank(masked, inlineBackticks, true);
    masked = blank(masked, doubleQuoted, false);
    masked = wrappedDoubleQuotes(masked);
    masked = blank(masked, singleQuotedToken, false);
    masked = capitalPhrases(masked);
    masked = jsDocExamples(masked);
    return commandLines(masked);
}
