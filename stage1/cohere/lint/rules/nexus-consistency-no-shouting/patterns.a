// Reads: cohere internal/shouting/shouting.go. Go RE2 whitespace is ASCII, unlike JS \s.
export const digitOrUnderscore = /[0-9_]/gu;
export const vowel = /[AEIOUY]/gu;
export const uppercaseToken = /\b[A-Z][A-Z0-9_]*\b/gu;
export const fencedBlock = /```[\s\S]*?```/gu;
export const inlineBackticks = /`[^`]*`/gu;
export const doubleQuoted = /"[^"\n]*"/gu;
export const singleQuotedToken = /'[A-Za-z0-9_.\-\/]+'/gu;
export const singleQuotedCapitalPhrase = /'[A-Z0-9_][A-Z0-9_ .,:=\-\/]*[A-Z0-9_]'/gu;
export const jsDocGutter = /^[ \t\n\f\r]*\*?[ \t\n\f\r]?/gu;
export const blockCommentGutter = /^[ \t]*\*(?: |\t|(?![\s\S]))/gu;
export const exampleTag = /^@example\b/gu;
export const anyJsDocTag = /^@\w+/gu;
export const promptLine = /^[ \t\n\f\r]*(\$|s[ \t\n\f\r]+c\b)/gu;
export const commandWordLine = /^[ \t\n\f\r]*(ahra|git|pnpm|npm|sqlite3|curl)[ \t\n\f\r]/gu;
export const lowercaseWord = /^[a-z][a-z-]*(?![\s\S])/gu;
export const dotBetweenLetters = /[A-Za-z]\.[A-Za-z]/gu;
export const generatedMarker = /^\/\/ Code generated [^\n]* DO NOT EDIT\.(?![\s\S])/gu;
