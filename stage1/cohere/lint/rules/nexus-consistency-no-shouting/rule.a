import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { fileComments } from './comments.a';
import { maskCodeAndCommands, accepts } from './masking.a';
import { digitOrUnderscore, vowel, uppercaseToken } from './patterns.a';
import { allowedUppercaseTokens, currencyCodes, shoutedTwoLetterWords } from './policy_data.a';
import { shoutingMessage } from './messages.a';

function isShoutedToken(token: string): boolean {
    if(allowedUppercaseTokens.includes(token) || currencyCodes.includes(token)) {
        return false;
    }
    if(accepts(digitOrUnderscore(), token) || token.length < 2) {
        return false;
    }
    return token.length === 2 ? shoutedTwoLetterWords.includes(token) : accepts(vowel(), token);
}

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        const context = this.context;
        const additionalAllowed = context.settings.list('allow', []);
        for(const comment of fileComments(context, node)) {
            const masked = maskCodeAndCommands(comment.text);
            const seen = new Set<string>();
            const tokens: string[] = [];
            const expression = uppercaseToken();
            for(;;) {
                const match = expression.exec(masked);
                if(match === null) {
                    break;
                }
                const token = match[0] ?? '';
                if(seen.has(token) || !isShoutedToken(token)) {
                    continue;
                }
                seen.add(token);
                if(!additionalAllowed.includes(token)) {
                    tokens.push(token);
                }
            }
            if(tokens.length > 0) {
                context.reportRange(comment.start, comment.end, 'nexus/consistency-no-shouting',
                    'shoutingInComment', shoutingMessage(tokens));
            }
        }
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
