import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { isSpace } from '../../../../typescript/scanner/characters.ts';
import { utf8Length } from 'adamic';
import { isLineBreak } from '../../../../typescript/scanner/characters.ts';

function lineIndex(lines: readonly number[], position: number): number {
    let left = 0;
    let right = lines.length;
    while(left < right) {
        const middle = Math.floor((left + right) / 2);
        if((lines[middle] ?? 0) <= position) {
            left = middle + 1;
        }
        else {
            right = middle;
        }
    }
    return left - 1;
}
export class CommentRange {
    readonly start: number;
    readonly end: number;
    readonly text: string;
    readonly line: number;
    readonly endLine: number;
    readonly column: number;
    readonly prefix: string;
    constructor(source: string, start: number, end: number, lines: readonly number[]) {
        this.start = start;
        this.end = end;
        this.text = source.slice(start, end);
        this.line = lineIndex(lines, start);
        this.endLine = lineIndex(lines, end);
        this.prefix = source.slice(lines[this.line] ?? 0, start);
        this.column = utf8Length(this.prefix);
    }
}
export function comments(
    source: string,
    literalEnds: readonly number[],
    reachable: readonly boolean[],
): CommentRange[] {
    const lines: number[] = [0];
    for(let cursor = 0; cursor < source.length; cursor++) {
        const code = source.charCodeAt(cursor);
        if(code === 13 && source.charCodeAt(cursor + 1) === 10) {
            cursor++;
        }
        if(isLineBreak(code)) {
            lines.push(cursor + 1);
        }
    }
    const result: CommentRange[] = [];
    for(let cursor = 0; cursor < source.length;) {
        const literalEnd = literalEnds[cursor] ?? -1;
        if(literalEnd >= 0) {
            cursor = literalEnd;
            continue;
        }
        if(cursor === 0 && source.startsWith('#!')) {
            while(cursor < source.length && !isLineBreak(source.charCodeAt(cursor))) {
                cursor++;
            }
            continue;
        }
        const opening = source.charCodeAt(cursor) === 47 ? source.slice(cursor, cursor + 2) : '';
        if(opening !== '//' && opening !== '/*') {
            cursor++;
            continue;
        }
        const start = cursor;
        cursor += 2;
        if(opening === '//') {
            while(cursor < source.length && !isLineBreak(source.charCodeAt(cursor))) {
                cursor++;
            }
        }
        else {
            const close = source.indexOf('*/', cursor);
            cursor = close < 0 ? source.length : close + 2;
        }
        if(reachable[start] === true) {
            result.push(new CommentRange(source, start, cursor, lines));
        }
    }
    return result;
}

function isParameterListKind(kind: string): boolean {
    switch(kind) {
        case 'FunctionDeclaration':
        case 'FunctionExpression':
        case 'ArrowFunction':
        case 'MethodDeclaration':
        case 'Constructor':
        case 'GetAccessor':
        case 'SetAccessor':
        case 'FunctionType':
        case 'ConstructorType':
        case 'CallSignature':
        case 'ConstructSignature':
        case 'MethodSignature':
        case 'IndexSignature':
            return true;
        default:
            return false;
    }
}
function isBracedListKind(kind: string): boolean {
    switch(kind) {
        case 'ClassDeclaration':
        case 'ClassExpression':
        case 'Block':
        case 'CaseBlock':
        case 'ModuleBlock':
        case 'InterfaceDeclaration':
        case 'EnumDeclaration':
        case 'TypeLiteral':
        case 'ObjectLiteralExpression':
        case 'ObjectBindingPattern':
        case 'NamedImports':
        case 'NamedExports':
            return true;
        default:
            return false;
    }
}
function commentAnchors(context: RuleContext, node: ParseNode, anchors: boolean[]): void {
        anchors[node.pos] = true;
        anchors[node.end] = true;
        const parameterList = isParameterListKind(node.kind);
        const argumentsList = node.kind === 'CallExpression' || node.kind === 'NewExpression';
        const bracedList = isBracedListKind(node.kind);
        const arrayList = node.kind === 'ArrayLiteralExpression' || node.kind === 'ArrayBindingPattern';
        const caseList = node.kind === 'CaseClause' || node.kind === 'DefaultClause';
        if(parameterList || argumentsList || bracedList || arrayList || caseList) {
            const children = new Map<number, number>();
            context.scanAt(node.pos);
            const start = context.scanStart();
            for(const child of node.children) {
                const childStart = Math.max(start, context.node(child).pos);
                children.set(childStart, Math.max(children.get(childStart) ?? 0, context.node(child).end));
            }
            let depth = 0;
            for(let position = start; position < node.end; position++) {
                const childEnd = children.get(position);
                if(childEnd !== undefined && childEnd > position) {
                    position = childEnd - 1;
                    continue;
                }
                const code = context.source.charCodeAt(position);
                if(code === 47) {
                    const next = context.source.charCodeAt(position + 1);
                    if(next === 47) {
                        while(position < node.end && !isLineBreak(context.source.charCodeAt(position))) {
                            position++;
                        }
                        continue;
                    }
                    if(next === 42) {
                        const close = context.source.indexOf('*/', position + 2);
                        position = close < 0 ? node.end : close + 1;
                        continue;
                    }
                }
                const opening =
                    parameterList || argumentsList ? (node.kind === 'IndexSignature' ? 91 : 40) : arrayList ? 91 : 123;
                const closing = opening === 40 ? 41 : opening === 91 ? 93 : 125;
                if(code === opening) {
                    depth++;
                    if(depth === 1) {
                        anchors[position + 1] = true;
                    }
                }
                if(code === closing) {
                    depth--;
                }
                if(code === 44 && depth === 1) {
                    anchors[position + 1] = true;
                }
                if(caseList && code === 58) {
                    anchors[position + 1] = true;
                }
            }
        }
        for(const child of node.children) {
            commentAnchors(context, context.node(child), anchors);
        }
    }

function reachableComments(source: string, anchors: readonly boolean[]): boolean[] {
        const reachable = new Array<boolean>(source.length + 1).fill(false);
        for(let anchor = 0; anchor < anchors.length; anchor++) {
            if(anchors[anchor] !== true) {
                continue;
            }
            let position = anchor;
            while(
                position < source.length &&
                (source.charCodeAt(position) === 32 ||
                    (source.charCodeAt(position) >= 9 && source.charCodeAt(position) <= 13))
            ) {
                position++;
            }
            if(anchor === 0 && source.startsWith('#!')) {
                while(position < source.length && !isLineBreak(source.charCodeAt(position))) {
                    position++;
                }
            }
            if(source.charCodeAt(position) !== 47) {
                continue;
            }
            for(;;) {
                while(
                    position < source.length &&
                    (isSpace(source.charCodeAt(position)) || isLineBreak(source.charCodeAt(position)))
                ) {
                    position++;
                }
                const opening =
                    source.charCodeAt(position) === 47 ? source.slice(position, position + 2) : '';
                if(opening !== '//' && opening !== '/*') {
                    break;
                }
                reachable[position] = true;
                if(opening === '//') {
                    while(position < source.length && !isLineBreak(source.charCodeAt(position))) {
                        position++;
                    }
                }
                else {
                    const close = source.indexOf('*/', position + 2);
                    position = close < 0 ? source.length : close + 2;
                }
            }
        }
        return reachable;
    }

// The comment collector is private to this rule; no shared context or harness is changed.
export function fileComments(context: RuleContext, root: ParseNode): CommentRange[] {
    const anchors = new Array<boolean>(context.source.length + 1).fill(false);
    commentAnchors(context, root, anchors);
    anchors[0] = true;
    return comments(context.source, context.literalEnds(), reachableComments(context.source, anchors));
}
