import type { RuleContext } from '../../context.ts';
import { Finding } from '../../finding.ts';
import { Reader } from './reader.a';
import { deprecationFor, message } from './core.a';
import { fields,tokens } from '../better-tailwindcss-no-duplicate-classes/core.a';
export class Rule {
    readonly context: RuleContext;readonly reader: Reader;
    constructor(context: RuleContext) { this.context=context;this.reader=new Reader(context); }
    visit(index: number): void {
        for(const literal of this.reader.read(index).literals) {
            const classes=fields(literal.text);const items=tokens(literal.text,literal.start).filter(token=>!token.separator);
            let valid=this.context.source.slice(literal.start,literal.end)===literal.text && items.length===classes.length;
            for(let i=0;i<items.length;i++) { if(items[i]?.text!==classes[i]) { valid=false; } }
            const seen: string[]=[];
            for(let i=0;i<classes.length;i++) {
                const name=classes[i] ?? '';const result=deprecationFor(name,'4.3.3');const replacement=result[1] ?? '';
                if(result[0]==='true') {
                    const token=items[i];const fix=valid && !literal.text.includes('${') && replacement!=='' && !seen.includes(name) && token!==undefined;
                    const found=new Finding('better-tailwindcss/no-deprecated-classes',replacement==='' ? 'deprecatedClassIrreplaceable' : 'deprecatedClassReplaceable',message(name,replacement),literal.start,literal.end,fix ? 'fix' : '',fix ? replacement : '','');
                    if(fix && token!==undefined) { found.editStart=token.start;found.editEnd=token.end; }
                    this.context.findings.push(found);
                }
                seen.push(name);
            }
        }
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
