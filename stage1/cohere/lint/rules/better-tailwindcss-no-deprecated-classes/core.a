// Decision core; the class reader and program adapter are separate prerequisites.
export class Deprecation { readonly pattern: string; readonly replacement: string; readonly major: number; readonly minor: number; constructor(pattern: string, replacement: string, major: number, minor: number) { this.pattern=pattern; this.replacement=replacement; this.major=major; this.minor=minor; } }
const entries: readonly Deprecation[] = [
    new Deprecation('shadow', 'shadow-sm', 4, 0),
    new Deprecation('inset-shadow', 'inset-shadow-sm', 4, 0),
    new Deprecation('drop-shadow', 'drop-shadow-sm', 4, 0),
    new Deprecation('blur', 'blur-sm', 4, 0),
    new Deprecation('backdrop-blur', 'backdrop-blur-sm', 4, 0),
    new Deprecation('rounded', 'rounded-sm', 4, 0),
    new Deprecation('bg-opacity-(.*)', '', 4, 0),
    new Deprecation('text-opacity-(.*)', '', 4, 0),
    new Deprecation('border-opacity-(.*)', '', 4, 0),
    new Deprecation('divide-opacity-(.*)', '', 4, 0),
    new Deprecation('ring-opacity-(.*)', '', 4, 0),
    new Deprecation('placeholder-opacity-(.*)', '', 4, 0),
    new Deprecation('flex-shrink', 'shrink', 4, 0),
    new Deprecation('flex-shrink-(.*)', 'shrink-$1', 4, 0),
    new Deprecation('flex-grow', 'grow', 4, 0),
    new Deprecation('flex-grow-(.*)', 'grow-$1', 4, 0),
    new Deprecation('overflow-ellipsis', 'text-ellipsis', 4, 0),
    new Deprecation('decoration-slice', 'box-decoration-slice', 4, 0),
    new Deprecation('decoration-clone', 'box-decoration-clone', 4, 0),
    new Deprecation('bg-left-top', 'bg-top-left', 4, 1),
    new Deprecation('bg-left-bottom', 'bg-bottom-left', 4, 1),
    new Deprecation('bg-right-top', 'bg-top-right', 4, 1),
    new Deprecation('bg-right-bottom', 'bg-bottom-right', 4, 1),
    new Deprecation('object-left-top', 'object-top-left', 4, 1),
    new Deprecation('object-left-bottom', 'object-bottom-left', 4, 1),
    new Deprecation('object-right-top', 'object-top-right', 4, 1),
    new Deprecation('object-right-bottom', 'object-bottom-right', 4, 1),
 ];
export function dissect(className: string): string[] {
    const index = className.lastIndexOf(':');
    const variants = index < 0 ? '' : className.slice(0,index+1);
    let base = className.slice(index+1);
    const important = base.endsWith('!');
    if(important) { base = base.slice(0,-1); }
    return [variants,base,important ? '!' : ''];
}
function integer(text: string): number {
    if(text === '') { return -1; }
    let value = 0;
    for(let index=0;index<text.length;index++) { const code=text.charCodeAt(index); if(code<48 || code>57) { return -1; } value=value*10+code-48; }
    return value;
}
export function versionParts(version: string): number[] {
    const dot=version.indexOf('.');
    if(dot<0) { return [0,0]; }
    const rest=version.slice(dot+1); const next=rest.indexOf('.');
    const major=integer(version.slice(0,dot)); const minor=integer(next<0 ? rest : rest.slice(0,next));
    return major<0 || minor<0 ? [0,0] : [major,minor];
}
export function deprecationFor(className: string, version: string): string[] {
    const parts=dissect(className); const base=parts[1] ?? ''; const installed=versionParts(version);
    for(const entry of entries) {
        const major=installed[0] ?? 0; const minor=installed[1] ?? 0;
        if(major<entry.major || (major===entry.major && minor<entry.minor)) { continue; }
        const wildcard=entry.pattern.endsWith('(.*)'); const prefix=wildcard ? entry.pattern.slice(0,-4) : entry.pattern;
        if(wildcard ? !base.startsWith(prefix) : base!==prefix) { continue; }
        // Go regexp dot excludes newline, including in the captured suffix.
        const captured=wildcard ? base.slice(prefix.length) : '';
        if(captured.includes('\n')) { continue; }
        if(entry.replacement==='') { return ['true','']; }
        const captureAt=entry.replacement.indexOf('$1');
        const replacement=captureAt<0 ? entry.replacement : entry.replacement.slice(0,captureAt)+captured+entry.replacement.slice(captureAt+2);
        return ['true',(parts[0] ?? '')+replacement+(parts[2] ?? '')];
    }
    return ['false',''];
}
export function message(className: string,replacement: string): string {
    return replacement === ''
        ? `The class "${className}" is deprecated and has no direct replacement. The opacity utilities were removed in favour of writing the opacity into the color itself, such as \`bg-black/50\` instead of \`bg-black bg-opacity-50\`, so this needs a small rewrite rather than a rename.`
        : `The class "${className}" was renamed in a Tailwind release and "${replacement}" is the current spelling. Both work today, which is the problem: the old name keeps compiling until the release that removes it, and by then it is spread across files nobody is looking at. Rename it while the two are still equivalent.`;
}
