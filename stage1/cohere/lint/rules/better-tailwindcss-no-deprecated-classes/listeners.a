// Owned differential driver; projected trees certify semantics separately from the frontend.
import { panic, programArguments, readTextFile, utf8Length } from 'adamic';
import { Parser } from '../../../../typescript/parser/parser.ts';
import { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { OptionsJson } from '../../helpers/options_json.ts';
import { Settings } from '../../settings.ts';
import { RuleContext } from '../../context.ts';
import type { Finding } from '../../finding.ts';
import type { SuggestionEdit } from '../../suggestions.a';
import { Rule as Deprecations } from './rule.a';
import { Rule as Duplicates } from '../better-tailwindcss-no-duplicate-classes/rule.a';
import { Rule as Unknown } from '../better-tailwindcss-no-unknown-classes/rule.a';
function written(text: string): string {
    const chunks: string[] = [];
    for(let start = 0; start < text.length; start += 1024) {
        let chunk = '';
        for(let index = start; index < Math.min(start + 1024, text.length); index++) {
            const code = text.charCodeAt(index);
            chunk += code >= 32 && code <= 126 && code !== 92 ? text.slice(index, index + 1) : `\\u${code.toString(16).padStart(4, '0')}`;
        }
        chunks.push(chunk);
    }
    return chunks.join('');
}
function context(source: string, parser: Parser, root: number, settings: Settings, selected: string): RuleContext {
    const parents: number[] = [];
    for(const node of parser.nodes) { parents.push(-1); }
    for(let index = 0; index < parser.nodes.length; index++) {
        for(const child of parser.node(index).children) { parents[child] = index; }
    }
    const result = new RuleContext(source, parser, new Scanner(source), selected, '', '', false, parents, settings, root);
    const deprecated = new Deprecations(result);
    const duplicate = new Duplicates(result);
    const unknown = new Unknown(result);
    const pending = [root];
    while(pending.length > 0) {
        const index = pending.pop() ?? panic('missing node');
        if(selected==='better-tailwindcss/no-deprecated-classes') { deprecated.visit(index); } else if(selected==='better-tailwindcss/no-unknown-classes') { unknown.visit(index); } else { duplicate.visit(index); }
        const children = parser.node(index).children;
        for(let child = children.length - 1; child >= 0; child--) { pending.push(children[child] ?? panic('missing child')); }
    }
    result.findings.sort((left, right) => left.start - right.start);
    return result;
}
function suggested(source: string, edits: readonly SuggestionEdit[]): string {
    const ordered = edits.slice().sort((left, right) => right.start - left.start);
    let result = source;
    for(const edit of ordered) { result = result.slice(0, edit.start) + edit.text + result.slice(edit.end); }
    return result;
}
function fixed(initial: RuleContext, rejected: string[]): string {
    let state = initial;
    for(let pass = 0; pass < 1; pass++) {
        const proposals = state.findings.filter(finding => finding.repair === 'fix').sort((left, right) => left.editStart !== right.editStart ? left.editStart - right.editStart : left.editEnd - right.editEnd);
        const applied: Finding[] = [];
        let previous = -1;
        for(const finding of proposals) {
            if(finding.editStart < previous) {
                rejected.push(`rejected ${finding.rule} ${utf8Length(state.source.slice(0, finding.editStart))} ${utf8Length(state.source.slice(0, finding.editEnd))} ${finding.rule} overlaps another fix`);
            }
            else { applied.push(finding); previous = finding.editEnd; }
        }
        if(applied.length === 0) { return state.source; }
        let result = state.source;
        for(let index = applied.length - 1; index >= 0; index--) {
            const finding = applied[index] ?? panic('missing fix');
            result = result.slice(0, finding.editStart) + finding.replacement + result.slice(finding.editEnd);
        }
        return result;
    }
    return state.source;
}
const args = programArguments();
const input = readTextFile(args[0] ?? panic('corpus path'));
if(input.kind === 'Error') { panic(input.message); }
const corpus = new OptionsJson(input.text);
const corpusRoot = corpus.parse();
let count = 0;
for(const row of corpus.node(corpusRoot).children) {
    const name = corpus.node(corpus.field(row, 'file')).text;
    const chunks: string[] = [];
    for(const chunk of corpus.node(corpus.field(row, 'sourceChunks')).children) { chunks.push(corpus.node(chunk).text); }
    const source = chunks.length > 0 ? chunks.join('') : corpus.node(corpus.field(row, 'source')).text;
    const parser = new Parser(source, name);
    let root: number;
    if(args.includes('--source')) {
        if(name.endsWith('.tsx')) { panic('NotYet: assertion JSX parser'); }
        root = parser.file();
    }
    else {
        for(const raw of corpus.node(corpus.field(row, 'ast')).children) {
            const children: number[] = [];
            for(const child of corpus.node(corpus.field(raw, 'children')).children) { children.push(Number(corpus.node(child).text)); }
            const node = new ParseNode(corpus.node(corpus.field(raw, 'kind')).text, Number(corpus.node(corpus.field(raw, 'pos')).text), Number(corpus.node(corpus.field(raw, 'end')).text), children);
            node.text = corpus.node(corpus.field(raw, 'text')).text;
            node.operator = corpus.node(corpus.field(raw, 'operator')).text;
            node.literalFlags = Number(corpus.node(corpus.field(raw, 'newFlags')).text);
            parser.nodes.push(node);
        }
        root = Number(corpus.node(corpus.field(row, 'root')).text);
    }
    const settings = new Settings();
    settings.load(corpus.node(corpus.field(row, 'options')).text);
    const selected=corpus.node(corpus.field(row,'rule')).text;
    const state = context(source, parser, root, settings,selected);
    count += state.findings.length;
    if(args.includes('--count')) { continue; }
    console.log(`case ${written(name)} ${selected}`);
    for(const finding of state.findings) {
        console.log(`${utf8Length(source.slice(0, finding.start))} ${utf8Length(source.slice(0, finding.end))} ${finding.id}\t${written(finding.message)}\t${finding.repair}\t${written(finding.replacement)}\t`);
        if(finding.repair === 'fix') { console.log(`fix ${utf8Length(source.slice(0, finding.editStart))} ${utf8Length(source.slice(0, finding.editEnd))}\t${written(finding.replacement)}`); }
        for(const suggestion of finding.suggestions) {
            console.log(`suggestion ${suggestion.id}\t${written(suggestion.message)}`);
            for(const edit of suggestion.edits) { console.log(`suggestion-edit ${utf8Length(source.slice(0, edit.start))} ${utf8Length(source.slice(0, edit.end))}\t${written(edit.text)}`); }
            console.log(`suggestion-fixed\t${written(suggested(source, suggestion.edits))}`);
        }
    }
    const rejected: string[] = [];
    const result = fixed(state, rejected);
    for(const rejection of rejected) { console.log(rejection); }
    console.log(`fixed\t${written(result)}`);
}
if(args.includes('--count')) { console.log(`${count}`); }
