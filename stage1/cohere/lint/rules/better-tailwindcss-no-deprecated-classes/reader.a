import { panic } from 'adamic';
import type { RuleContext } from '../../context.ts';
import { Segment } from '../better-tailwindcss-no-duplicate-classes/core.a';
export class Literal {
    readonly text: string; readonly start: number; readonly end: number;
    constructor(text: string,start: number,end: number) { this.text=text;this.start=start;this.end=end; }
}
export class Values { readonly literals: Literal[]=[]; readonly templates: number[]=[]; }
export class Reader {
    readonly context: RuleContext; readonly attributes: string[]; readonly callees: string[]; readonly variables: string[];
    constructor(context: RuleContext) {
        this.context=context;
        const attributes=context.settings.list('attributes',[]); const callees=context.settings.list('callees',[]); const variables=context.settings.list('variables',[]);
        this.attributes=attributes.length===0 ? ['class','className'] : attributes;
        this.callees=callees.length===0 ? ['mergeClassNames','createVariantClassNames'] : callees;
        this.variables=variables.length===0 ? ['.*[Cc]lassName$','.*[Cc]lassNames$'] : variables;
    }
    collect(index: number,result: Values): void {
        const node=this.context.node(index); const children=node.children;
        if(['StringLiteral','NoSubstitutionTemplateLiteral'].includes(node.kind)) {
            const start=this.context.start(index); const end=node.end; const quoted=end-start>=2;
            result.literals.push(new Literal(node.text,quoted ? start+1 : start,quoted ? end-1 : end));
        }
        else if(['JsxExpression','ParenthesizedExpression','AsExpression','SatisfiesExpression'].includes(node.kind)) { const child=children[0]; if(child!==undefined) { this.collect(child,result); } }
        else if(node.kind==='ConditionalExpression') { const yes=children[2];const no=children[4];if(yes!==undefined) { this.collect(yes,result); } if(no!==undefined) { this.collect(no,result); } }
        else if(node.kind==='BinaryExpression') {
            const operator=children[1];if(operator===undefined) { return; } const kind=this.context.node(operator).kind;
            if(kind==='BarBarToken' || kind==='QuestionQuestionToken') { const left=children[0];if(left!==undefined) { this.collect(left,result); } }
            if(['AmpersandAmpersandToken','BarBarToken','QuestionQuestionToken'].includes(kind)) { const right=children[2];if(right!==undefined) { this.collect(right,result); } }
        }
        else if(node.kind==='ArrayLiteralExpression') { for(const child of children) { this.collect(child,result); } }
        else if(node.kind==='TemplateExpression') {
            result.templates.push(index);
            for(const child of children) { const span=this.context.node(child);if(span.kind==='TemplateSpan') { const expression=span.children[0];if(expression!==undefined) { this.collect(expression,result); } } }
        }
    }
    read(index: number): Values {
        const result=new Values();const node=this.context.node(index);const children=node.children;const first=children[0];
        if(first===undefined) { return result; }
        const name=this.context.node(first);
        if(node.kind==='JsxAttribute') { if(this.attributes.includes(name.text)) { const value=children[1];if(value!==undefined) { this.collect(value,result); } } }
        else if(node.kind==='CallExpression') {
            if(name.kind!=='Identifier' || !this.callees.includes(name.text)) { return result; }
            for(let child=1;child<children.length;child++) { this.collect(children[child] ?? panic('missing argument'),result); }
        }
        else if(node.kind==='VariableDeclaration') {
            if(name.kind!=='Identifier') { return result; }
            let matched=false;
            for(const pattern of this.variables) {
                if(pattern==='.*[Cc]lassName$') { if(name.text.endsWith('className') || name.text.endsWith('ClassName')) { matched=true; } }
                else if(pattern==='.*[Cc]lassNames$') { if(name.text.endsWith('classNames') || name.text.endsWith('ClassNames')) { matched=true; } }
                else { panic('NotYet: Go-equivalent configured variable regex provider'); }
            }
            if(matched && children.length>1) { this.collect(children[children.length-1] ?? panic('missing initializer'),result); }
        }
        return result;
    }
    segments(index: number): Segment[] {
        const result: Segment[]=[];const node=this.context.node(index);
        for(const child of node.children) {
            const part=this.context.node(child);
            if(part.kind==='TemplateHead') { result.push(this.segment(child,2)); }
            else if(part.kind==='TemplateSpan') { const literal=part.children[part.children.length-1];if(literal!==undefined) { result.push(this.segment(literal,this.context.node(literal).kind==='TemplateTail' ? 1 : 2)); } }
        }
        return result;
    }
    segment(index: number,trailing: number): Segment {
        const node=this.context.node(index);const start=this.context.start(index);const trimmed=start+1<=node.end-trailing;
        return new Segment(node.text,trimmed ? start+1 : start,trimmed ? node.end-trailing : node.end);
    }
}
