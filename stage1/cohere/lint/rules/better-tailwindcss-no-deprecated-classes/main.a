import { panic, programArguments, readTextFile, utf8Length } from 'adamic';
import { OptionsJson } from '../../helpers/options_json.ts';
import { deprecationFor, message as deprecatedMessage } from './core.a';
import { duplicates, templateDuplicates, Segment, message as duplicateMessage } from '../better-tailwindcss-no-duplicate-classes/core.a';
import type { Diagnostic } from '../better-tailwindcss-no-duplicate-classes/core.a';
import { classExistsIn } from '../better-tailwindcss-no-unknown-classes/core.a';
function written(text: string): string { let result=''; for(let index=0;index<text.length;index++) { const code=text.charCodeAt(index); result+=code>=32 && code<=126 && code!==92 ? text.slice(index,index+1) : `\\u${code.toString(16).padStart(4,'0')}`; } return result; }
const args=programArguments(); const input=readTextFile(args[0] ?? panic('input')); if(input.kind==='Error') { panic(input.message); }
const data=new OptionsJson(input.text); const root=data.parse(); let count=0;
for(const row of data.node(root).children) {
    console.log(`case ${count}`); count++;
    const kind=data.node(data.field(row,'kind')).text;
    const name=kind==='deprecated' || kind==='unknown' ? data.node(data.field(row,'name')).text : '';
    if(kind==='deprecated') {
        const result=deprecationFor(name,data.node(data.field(row,'version')).text); const found=result[0] ?? 'false'; const replacement=result[1] ?? '';
        console.log(`deprecated ${found}\t${written(replacement)}`);
        if(found==='true') { console.log(`${replacement==='' ? 'deprecatedClassIrreplaceable' : 'deprecatedClassReplaceable'}\t${written(deprecatedMessage(name,replacement))}`); }
    }
    else if(kind==='unknown') {
        const present=data.node(data.field(row,'present')).kind==='TrueKeyword';
        console.log(`exists ${classExistsIn(name,present, candidate=>false)}`);
    }
    else {
        const source=data.node(data.field(row,'source')).text; let reports: Diagnostic[];
        if(kind==='duplicate') { reports=duplicates(source,data.node(data.field(row,'value')).text,Number(data.node(data.field(row,'start')).text),Number(data.node(data.field(row,'end')).text)); }
        else {
            const segments: Segment[]=[];
            for(const item of data.node(data.field(row,'segments')).children) { segments.push(new Segment(data.node(data.field(item,'text')).text,Number(data.node(data.field(item,'start')).text),Number(data.node(data.field(item,'end')).text))); }
            reports=templateDuplicates(source,segments);
        }
        for(const report of reports) {
            console.log(`${utf8Length(source.slice(0,report.start))} ${utf8Length(source.slice(0,report.end))} duplicateClass\t${written(duplicateMessage(report.name))}`);
            for(const edit of report.edits) { console.log(`fix ${utf8Length(source.slice(0,edit.start))} ${utf8Length(source.slice(0,edit.end))}\t${written(edit.text)}`); }
        }
    }
}
