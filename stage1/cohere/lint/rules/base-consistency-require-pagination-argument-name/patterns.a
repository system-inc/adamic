// codex/lint-regex table: base/consistency_require_pagination_argument_name.go:27,30.
export function paginationType(text: string): boolean {
    const expression = /PaginationInput(?![\s\S])/gu;
    expression.lastIndex = 0;
    return expression.test(text);
}
export function paginationName(text: string): boolean {
    const expression = /Pagination(?![\s\S])/gu;
    expression.lastIndex = 0;
    return expression.test(text);
}
