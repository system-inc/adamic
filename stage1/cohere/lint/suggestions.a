// Suggestion ranges use source UTF-16 positions, like findings. The driver writes byte offsets.
export class SuggestionEdit {
    readonly start: number;
    readonly end: number;
    readonly text: string;
    constructor(start: number, end: number, text: string) {
        this.start = start;
        this.end = end;
        this.text = text;
    }
}
export class Suggestion {
    readonly id: string;
    readonly message: string;
    readonly edits: readonly SuggestionEdit[];
    constructor(id: string, message: string, edits: readonly SuggestionEdit[]) {
        this.id = id;
        this.message = message;
        this.edits = edits;
    }
}
