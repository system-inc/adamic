import { panic, programArguments, readTextFile } from 'adamic';
import { Parser } from '../../../../../typescript/parser/parser.ts';
import { Scanner } from '../../../../../typescript/scanner/scanner.ts';
import { written } from '../../../../../typescript/parser/nodes.ts';
import { RuleContext } from '../../../context.ts';
import { Settings } from '../../../settings.ts';
import { Rule as WhitespaceRule, type Report } from '../rule.ts';
import { Edit } from '../whitespace.a';

function ancestry(parser: Parser, parents: number[], index: number, parent: number): void {
    parents[index] = parent;
    for(const child of parser.node(index).children) { ancestry(parser, parents, child, index); }
}
class Analysis {
    readonly context: RuleContext;
    readonly rule: WhitespaceRule;
    constructor(context: RuleContext, rule: WhitespaceRule) { this.context = context; this.rule = rule; }
}
function visit(rule: WhitespaceRule, index: number, parent: number): void {
    const node = rule.context.node(index);
    if(['JsxAttribute', 'CallExpression', 'VariableDeclaration'].includes(node.kind)) { rule.visit(index, parent); }
    for(const child of node.children) { visit(rule, child, index); }
}
function analyze(source: string, path: string, selected: string, settings: Settings): Analysis {
    const parser = new Parser(source, path); const root = parser.file();
    const parents = parser.nodes.map(() => -1); ancestry(parser, parents, root, -1);
    const context = new RuleContext(source, parser, new Scanner(source), selected, '', '', false, parents, settings);
    const rule = new WhitespaceRule(context); visit(rule, root, -1);
    rule.reports.sort((left, right) => left.finding.start - right.finding.start);
    return new Analysis(context, rule);
}
function offsets(source: string): number[] {
    const result = [0]; let bytes = 0;
    for(let index = 0; index < source.length; index++) {
        const code = source.codePointAt(index) ?? 0;
        if(code > 65535) { result.push(bytes); index++; }
        bytes += code < 128 ? 1 : code < 2048 ? 2 : code < 65536 ? 3 : 4;
        result.push(bytes);
    }
    return result;
}
function fixed(analysis: Analysis, path: string, settings: Settings): string {
    let current = analysis;
    for(let pass = 0; pass < 10; pass++) {
        const edits: Edit[] = []; for(const report of current.rule.reports) { for(const edit of report.edits) { edits.push(edit); } }
        edits.sort((left, right) => left.start - right.start);
        let result = current.context.source; let previous = result.length;
        for(let index = edits.length - 1; index >= 0; index--) {
            const edit = edits[index] ?? panic('missing whitespace edit');
            if(edit.end > previous) { panic('overlapping whitespace edits'); }
            result = result.slice(0, edit.start) + edit.text + result.slice(edit.end); previous = edit.start;
        }
        if(result === current.context.source) { return result; }
        current = analyze(result, path, current.context.selected, settings);
    }
    panic('whitespace fixes did not converge');
}
const args = programArguments();
const manifest = readTextFile(args[0] ?? panic('missing manifest'));
if(manifest.kind === 'Error') { panic(manifest.message); }
const countOnly = args.includes('--count');
let count = 0;
let caseNumber = 0;
for(const row of manifest.text.split('\n')) {
    if(row === '') { continue; }
    const fields = row.split('\t');
    const path = fields[0] ?? panic('missing source');
    const source = readTextFile(path);
    if(source.kind === 'Error') { panic(source.message); }
    const settings = new Settings(); settings.load(fields[2] ?? 'null');
    const analysis = analyze(source.text, path, fields[1] ?? panic('missing rule'), settings);
    const context = analysis.context;
    count += context.findings.length;
    if(countOnly) { continue; }
    console.log(`case ${caseNumber}`); caseNumber++;
    const bytes = offsets(source.text);
    for(const report of analysis.rule.reports) {
        const finding = report.finding;
        const start = bytes[finding.start] ?? panic('range outside source');
        const end = bytes[finding.end] ?? panic('range end outside source');
        const lines = source.text.slice(0, finding.start).split(/\r\n|[\n\r\u2028\u2029]/);
        const column = offsets(lines[lines.length - 1] ?? '').pop() ?? 0;
        console.log(`${path}:${lines.length}:${column + 1}\n  ${finding.rule}  ${finding.message}\n`);
        const repair = report.edits.length > 0 ? 'fix' : '';
        console.log(`range ${start} ${end} ${finding.id} ${repair}\t\t`);
        for(const edit of report.edits) { console.log(`fix-edit ${bytes[edit.start] ?? panic('edit outside source')} ${bytes[edit.end] ?? panic('edit end outside source')}\t${written(edit.text)}`); }
    }
    console.log(`fixed\t${written(fixed(analysis, path, settings))}`);
}
if(countOnly) { console.log(`${count}`); }
