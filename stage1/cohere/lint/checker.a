// One file view of the run's checker. Facts retain the bridge's exact selector and grammar.
import { panic } from 'adamic';
import { openBridge as tsgoProgram, inspectBridge as tsgoInspect, releaseBridge as tsgoRelease } from './checker_bridge.a';
import type { Parser } from '../../typescript/parser/parser.ts';
import { Frames } from '../typeaware/frames.ts';
import type { ParseNode } from '../../typescript/parser/nodes.ts';

export type TSGoError = { readonly kind: 'Error'; readonly message: string };
export type ProgramResult = { readonly kind: 'Ok'; readonly value: number } | TSGoError;
export type InspectResult = { readonly kind: 'Ok'; readonly value: string } | TSGoError;
export type ReleaseResult = { readonly kind: 'Ok' } | TSGoError;
export function openProgram(config: string, files: readonly string[]): ProgramResult { return tsgoProgram(config, files); }
export function releaseProgram(program: number): ReleaseResult { return tsgoRelease(program); }
function inspect(program: number, path: string, start: number, end: number, kind: string, question: string): InspectResult {
    return tsgoInspect(program, path, start, end, kind, question);
}
export class FileQuestion {
    readonly kind: string;
    readonly text: string;
    constructor(kind: string, text: string) { this.kind = kind; this.text = text; }
}
export class Answer {
    readonly value: string | undefined;
    readonly reason: string;
    constructor(value: string | undefined, reason: string) { this.value = value; this.reason = reason; }
}
export class Refusal {
    readonly rule: string;
    readonly start: number;
    readonly end: number;
    readonly reason: string;
    constructor(rule: string, start: number, end: number, reason: string) {
        this.rule = rule; this.start = start; this.end = end; this.reason = reason;
    }
}
function frame(value: string): string { return `${value.length}\n${value}`; }
export class Checker {
    readonly program: number;
    readonly path: string;
    readonly parser: Parser;
    readonly offsets: number[] = [0];
    readonly refusals: Refusal[] = [];
    readonly recorded: string[] = [];
    readonly replay: Frames | undefined;
    readonly record: boolean;
    readonly localLocations = new Map<string, number>();
    locationsReady = false;
    root = -1;
    rule = '';
    reads: readonly string[] = [];
    constructor(program: number, path: string, parser: Parser, source: string, replay: string | undefined, record: boolean) {
        this.program = program; this.path = path; this.parser = parser; this.record = record;
        this.replay = replay === undefined ? undefined : new Frames(replay);
        let bytes = 0;
        for(let index = 0; index < source.length; index++) {
            const code = source.codePointAt(index) ?? 0;
            if(code > 65535) { this.offsets.push(bytes); index++; }
            bytes += code < 128 ? 1 : code < 2048 ? 2 : code < 65536 ? 3 : 4;
            this.offsets.push(bytes);
        }
    }
    localNode(start: number, end: number, kind: string): number {
        if(!this.locationsReady) {
            this.indexLocations(this.root); this.locationsReady = true;
        }
        return this.localLocations.get(`${start}\n${end}\n${kind}`) ?? -1;
    }
    indexLocations(index: number): void {
        if(index < 0) { return; }
        const node = this.parser.node(index);
        const first = this.offsets[node.pos] ?? panic('local start outside source');
        const last = this.offsets[node.end] ?? panic('local end outside source');
        const key = `${first}\n${last}\n${node.kind}`;
        if(!this.localLocations.has(key)) { this.localLocations.set(key, index); }
        for(const child of node.children) { this.indexLocations(child); }
    }
    enter(rule: string, reads: readonly string[]): void { this.rule = rule; this.reads = reads; }
    refuse(start: number, end: number, reason: string): Answer {
        this.refusals.push(new Refusal(this.rule, start, end, reason));
        return new Answer(undefined, reason);
    }
    askFile(question: FileQuestion): Answer {
        if(!this.reads.includes(question.kind)) {
            return this.refuse(0, this.offsets[this.parser.scanner.text.length] ?? 0, `undeclared program read ${question.kind}`);
        }
        if(this.root < 0) { panic('checker asked before parsing'); }
        return this.ask(this.root, question.text);
    }
    ask(index: number, question: string): Answer {
        return this.askNode(this.parser.node(index), question);
    }
    askNode(node: ParseNode, question: string): Answer {
        const mode = question.split('\n')[0] ?? '';
        if(['node-symbol-details', 'type-symbol-details', 'property-declarations', 'binding-declarations', 'alias-declarations', 'symbol-provenance', 'symbol-provenance-alias'].includes(mode) || (mode === 'output-symbol' && question !== 'output-symbol\nfiles')) {
            if(!this.reads.includes('ReadsOtherFiles')) {
                return this.refuse(0, this.offsets[this.parser.scanner.text.length] ?? 0, 'undeclared program read ReadsOtherFiles');
            }
        }
        const libraryRead = ['library-member-provenance', 'symbol-default-library', 'node-symbol-details', 'type-symbol-details', 'property-declarations', 'symbol-provenance', 'symbol-provenance-alias'].includes(mode) || (mode === 'output-symbol' && question !== 'output-symbol\nfiles');
        if(libraryRead && !this.reads.includes('ReadsDefaultLibrary')) {
            return this.refuse(0, this.offsets[this.parser.scanner.text.length] ?? 0, 'undeclared program read ReadsDefaultLibrary');
        }
        if(['options', 'emit-module-kind', 'symbol-default-library'].includes(mode) && !this.reads.includes('ReadsCompilerOptions')) {
            return this.refuse(0, this.offsets[this.parser.scanner.text.length] ?? 0, 'undeclared program read ReadsCompilerOptions');
        }
        const start = this.offsets[node.pos] ?? panic('checker span outside source');
        const end = this.offsets[node.end] ?? panic('checker span outside source');
        const key = this.record || this.replay !== undefined ? frame(this.path) + frame(`${start}`) + frame(`${end}`) + frame(node.kind) + frame(question) : '';
        let value = '';
        if(this.replay !== undefined) {
            if(this.replay.cursor === this.replay.text.length) { return this.refuse(start, end, 'missing transcript entry'); }
            const expected = this.replay.field();
            const outcome = this.replay.field();
            value = this.replay.field();
            if(expected !== key) { return this.refuse(start, end, 'transcript ask mismatch'); }
            if(outcome === 'Error') { return this.refuse(start, end, value); }
            if(outcome !== 'Value') { return this.refuse(start, end, 'invalid transcript outcome'); }
        }
        else {
            // Library's result envelope preserves the C error buffer verbatim.
            const inspected = inspect(this.program, this.path, start, end, node.kind, question);
            if(inspected.kind === 'Error') {
                if(this.record) { this.recorded.push(frame(key) + frame('Error') + frame(inspected.message)); }
                return this.refuse(start, end, inspected.message);
            }
            value = inspected.value;
        }
        if(this.record) { this.recorded.push(frame(key) + frame('Value') + frame(value)); }
        return new Answer(value, '');
    }
    finish(): void {
        if(this.replay !== undefined && this.replay.cursor !== this.replay.text.length) {
            this.refuse(0, 0, 'unasked transcript entry');
        }
    }
    transcript(): string { return this.recorded.join(''); }
}
