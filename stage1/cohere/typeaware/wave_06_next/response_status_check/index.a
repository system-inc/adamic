import {Tools} from '../tools.a';
import type {Rules} from '../../rules.ts';
import {ResponseGraph} from './graph.a';
export class ResponseBinding {
    readonly name:number;readonly id:number;readonly root:number;readonly producer:number;
    readonly references:number[]=[];dropped=false;
    constructor(name:number,id:number,root:number,producer:number){this.name=name;this.id=id;this.root=root;this.producer=producer;}
}
export class ResponseStatusCheck {
    readonly tools:Tools;
    constructor(rules:Rules){this.tools=new Tools(rules);}
    readonly tracked:ResponseBinding[]=[];
    producer(index:number):boolean {
        if(this.tools.kind(index)!=='CallExpression')return false;const callee=this.tools.skip(this.tools.child(index));
        const name=this.tools.kind(callee)==='Identifier'?callee:this.tools.kind(callee)==='PropertyAccessExpression'?this.tools.last(callee):-1;if(name<0)return false;
        const text=this.tools.text(name),ds=this.tools.symbol(name).items;if(ds.length===0)return false;
        if(text==='fetch')return ds.every(d=>d.kind==='FunctionDeclaration'&&d.ambient&&(d.parents[0]==='SourceFile'&&!d.external||d.parents[0]==='ModuleBlock'&&(d.globals[1]??false)));
        if(!['request','baseApiRequest'].includes(text)||this.tools.kind(callee)!=='PropertyAccessExpression')return false;
        return ds.every(d=>d.kind==='MethodDeclaration'&&d.parents[0]==='ClassDeclaration'&&((d.names[0]==='NetworkService'&&d.file.endsWith('/source/services/network/NetworkService.ts'))||(d.names[0]==='NetworkServiceRequestExecutor'&&d.file.endsWith('/source/services/network/internal/NetworkServiceRequestExecutor.ts'))));
    }
    classify(index:number):number[] {
        const outer=this.tools.outer(index),parent=this.tools.parent(outer);if(!['PropertyAccessExpression','ElementAccessExpression'].includes(this.tools.kind(parent))||this.tools.child(parent)!==outer)return [3,-1];
        const member=this.tools.member(parent);if(['ok','status','statusText'].includes(member))return [2,-1];if(member==='body')return [1,parent];
        if(['json','text','arrayBuffer','blob','formData','bytes'].includes(member)){const call=this.tools.parent(parent);return this.tools.kind(call)==='CallExpression'&&this.tools.child(call)===parent?[1,call]:[3,-1];}
        return ['headers','url','redirected','type','bodyUsed'].includes(member)?[0,-1]:[3,-1];
    }
    track(name:number,root:number,producer:number):void{if(name<0||this.tools.kind(name)!=='Identifier'||root<0)return;const id=this.tools.symbol(name).id;if(id!==0)this.tracked.push(new ResponseBinding(name,id,root,producer));}
    scan():void {
        for(let index=0;index<this.tools.rules.parser.nodes.length;index++) {
            const kind=this.tools.kind(index);
            if(kind==='ExpressionStatement'){const awaitIndex=this.tools.skip(this.tools.child(index));if(this.tools.kind(awaitIndex)==='AwaitExpression'&&this.producer(this.tools.skip(this.tools.child(awaitIndex))))this.discard(index);}
            if(kind==='AwaitExpression'&&this.producer(this.tools.skip(this.tools.child(index)))) {
                let outer=index;while(this.tools.kind(this.tools.parent(outer))==='ParenthesizedExpression')outer=this.tools.parent(outer);const d=this.tools.parent(outer),list=this.tools.parent(d);
                if(this.tools.kind(d)==='VariableDeclaration'&&this.tools.last(d)===outer&&this.tools.kind(list)==='VariableDeclarationList'&&this.tools.text(list).trimStart().startsWith('const '))this.track(this.tools.child(d),this.tools.root(d),index);
                else {const use=this.classify(index);if(use[0]===1)this.bodyRead(use[1]??-1);}
            }
            if(kind==='CallExpression') {
                const callee=this.tools.skip(this.tools.child(index));if(this.tools.kind(callee)!=='PropertyAccessExpression'||this.tools.member(callee)!=='then'||!this.producer(this.tools.skip(this.tools.child(callee))))continue;
                const callback=this.tools.skip(this.tools.child(index,1));if(!['ArrowFunction','FunctionExpression'].includes(this.tools.kind(callback)))continue;
                const parameter=this.tools.children(callback).find(at=>this.tools.kind(at)==='Parameter')??-1;
                if(parameter<0||this.tools.children(parameter).some(at=>['EqualsToken','DotDotDotToken'].includes(this.tools.kind(at)))||this.tools.text(parameter).includes('='))continue;
                this.track(this.tools.child(parameter),callback,index);
            }
        }
    }
    bodyRead(index:number):void{if(index>=0)this.tools.report('nexus/correctness-require-response-status-check','bodyReadWithoutStatusCheck',"This reads the body of a fetch Response on a path where neither `.ok` nor `.status` is read. fetch does not throw on an HTTP error, so a 401 or 500 body is parsed here and used as data (an error object returned as a task list, a failure cached as a success). Check `response.ok` before trusting the body, and throw or return the failure when it is false.",index);}
    discard(index:number):void{this.tools.report('nexus/correctness-require-response-status-check','responseDiscarded',"This awaits a fetch Response and drops it. fetch does not throw on an HTTP error, so a request that fails with a 400 or 500 runs on as if it succeeded. Keep the Response and check `response.ok`, and throw or return the failure when it is false.",index);}
    walk(graph:ResponseGraph,starts:readonly number[],binding:ResponseBinding,forward:boolean):number[] {
        const queue=starts.slice(),entered:number[]=[],candidates:number[]=[];
        for(let q=0;q<queue.length;q+=2) {
            const block=queue[q]??-1,start=queue[q+1]??0;if(block<0)continue;const events=graph.block(block).events;let stopped=false;
            for(let at=start;at<events.length;at++) {
                const index=events[at]??-1;if(index===binding.name){if(!forward){candidates.push(-1);return candidates;}stopped=true;break;}
                if(!binding.references.includes(index))continue;const use=this.classify(index);
                if(use[0]===0)continue;if(use[0]!==1){stopped=true;break;}
                if(forward){candidates.push(block);candidates.push(at);}else continue;
            }
            if(stopped)continue;
            if(!forward&&graph.finals.includes(block)){candidates.push(-1);return candidates;}
            for(const next of graph.block(block).successors){if(graph.block(next).reachable&&!entered.includes(next)){entered.push(next);queue.push(next);queue.push(0);}}
        }
        return candidates;
    }
    analyze(root:number):void {
        const bs=this.tracked.filter(binding=>binding.root===root);
        for(const index of this.tools.descendants(root)) {
            if(this.tools.kind(index)!=='Identifier'||this.tools.typePosition(index))continue;
            for(const b of bs){if(index===b.name||this.tools.text(index)!==this.tools.text(b.name)||this.tools.symbol(index).id!==b.id)continue;if(this.tools.root(index)!==root)b.dropped=true;else if(!this.tools.nameOnly(index))b.references.push(index);}
        }
        for(const b of bs){if(!b.dropped&&b.references.length===0){this.discard(b.producer);b.dropped=true;}}
        if(bs.every(b=>b.dropped))return;
        const graph=new ResponseGraph(this.tools.rules);graph.build(root);
        for(const b of bs) {
            if(b.dropped||b.references.some(reference=>!graph.blocks.some(block=>block.events.includes(reference))))continue;
            const starts:number[]=[];
            for(let block=0;block<graph.blocks.length;block++){const subject=graph.block(block);if(!subject.reachable)continue;for(let at=0;at<subject.events.length;at++){if(subject.events[at]===b.name){starts.push(block);starts.push(at+1);}}}
            if(this.tools.kind(this.tools.parent(b.name))==='Parameter'){starts.push(0);starts.push(0);}
            const candidates=this.walk(graph,starts,b,true),reported:number[]=[];
            for(let at=0;at<candidates.length;at+=2){const block=candidates[at]??-1,event=candidates[at+1]??-1;if(block<0||event<0)continue;const index=graph.block(block).events[event]??-1,report=this.classify(index)[1]??-1;if(report<0||reported.includes(report))continue;if(this.walk(graph,[block,event+1],b,false).includes(-1)){reported.push(report);this.bodyRead(report);}}
        }
    }
    run():void{this.scan();const roots:number[]=[];for(const binding of this.tracked){if(!roots.includes(binding.root))roots.push(binding.root);}for(const root of roots)this.analyze(root);}
}
