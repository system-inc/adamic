    taint(index:number):boolean {if(index<0||this.tools.boundary(index))return false;if(this.tools.kind(index)==='AwaitExpression')return true;if(this.tools.kind(index)==='Identifier'&&!this.tools.nameOnly(index)&&this.tainted.includes(this.tools.symbol(index).id))return true;return this.tools.children(index).some(child=>this.taint(child));}
