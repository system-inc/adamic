    sinkMethod(name:string):boolean{return ['push','unshift','set','add','append','delete'].includes(name)||['add','append','insert'].some(prefix=>name.startsWith(prefix)&&name.slice(prefix.length,prefix.length+1)>='A'&&name.slice(prefix.length,prefix.length+1)<='Z');}
    propertyTarget(index:number):number {index=this.tools.skip(index);if(this.tools.kind(index)==='ElementAccessExpression')index=this.tools.child(index);return this.tools.kind(index)==='PropertyAccessExpression'||['Identifier','ThisKeyword'].includes(this.tools.kind(index))?this.outerBinding(this.base(index))?index:-1:-1;}
    carries():boolean {
