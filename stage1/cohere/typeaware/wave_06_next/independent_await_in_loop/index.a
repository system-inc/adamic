        for(const index of this.tools.descendants(this.body)) {
            const kind=this.tools.kind(index);
            if(kind==='VariableDeclarationList'&&this.tools.text(index).trimStart().startsWith('var ')){let parent=this.tools.parent(index),nested=false;while(parent>=0&&parent!==this.body){if(this.tools.boundary(parent))nested=true;parent=this.tools.parent(parent);}if(!nested)return true;}
            if(kind==='BinaryExpression'&&this.tools.assignment(this.tools.kind(this.tools.child(index,1)))) {const left=this.tools.child(index),target=['PropertyAccessExpression','ElementAccessExpression'].includes(this.tools.kind(this.tools.skip(left)))?this.propertyTarget(left):-1;if(target>=0){if(this.tools.kind(this.tools.child(index,1))!=='EqualsToken')return true;sinks.push(target);sinkRoots.push(this.base(target));}}
            if(['PrefixUnaryExpression','PostfixUnaryExpression'].includes(kind)&&['PlusPlusToken','MinusMinusToken'].includes(this.tools.rules.parser.node(index).operator)&&this.tools.children(index).some(child=>['PropertyAccessExpression','ElementAccessExpression'].includes(this.tools.kind(this.tools.skip(child)))&&this.propertyTarget(child)>=0))return true;
            if(kind==='DeleteExpression'){const target=this.propertyTarget(this.tools.child(index));if(target>=0){sinks.push(target);sinkRoots.push(this.base(target));}}
            if(kind==='CallExpression') {const callee=this.tools.skip(this.tools.child(index));if(this.tools.kind(callee)==='PropertyAccessExpression'){const receiver=this.tools.child(callee),name=this.tools.member(callee);if(this.outerBinding(this.base(receiver))){if(['pop','shift','splice','next','read','sort','reverse'].includes(name))return true;if(this.sinkMethod(name)){sinks.push(receiver);sinkRoots.push(this.base(receiver));}}if(name==='assign'&&this.segments(receiver).join('.')==='Object'){const target=this.tools.child(index,1);if(this.outerBinding(this.base(target))){sinks.push(target);sinkRoots.push(this.base(target));}}}}
            if(kind==='Identifier'&&!this.tools.nameOnly(index)){if(this.tools.writes(index)){if(this.outerBinding(index)||(this.index>=0&&this.tools.same(index,this.index)))return true;}else if(this.outerBinding(index))reads.push(index);}
