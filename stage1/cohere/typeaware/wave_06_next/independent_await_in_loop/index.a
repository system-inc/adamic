        for(const d of declarations(this.tools.rules,name,'alias').items) {
            if(d.body==='')continue;const parser=new Parser(d.body,d.file);const root=parser.file();const parents:number[]=[];for(let at=0;at<parser.nodes.length;at++)parents.push(-1);
            const queue=[root];for(let q=0;q<queue.length;q++){const at=queue[q]??-1;for(const child of parser.node(at).children){parents[child]=at;queue.push(child);}}
            for(let at=0;at<parser.nodes.length;at++) {
                const node=parser.node(at);if(node.kind!=='CallExpression')continue;let parent=parents[at]??-1,catching=false;while(parent>=0){if(parser.node(parent).kind==='CatchClause'){catching=true;break;}parent=parents[parent]??-1;}if(catching)continue;
                let callee=node.children[0]??-1;while(['ParenthesizedExpression','NonNullExpression'].includes(parser.node(callee).kind))callee=parser.node(callee).children[0]??-1;
