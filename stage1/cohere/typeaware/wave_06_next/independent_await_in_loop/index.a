    }
    ordered(index:number,narrow=false):boolean {index=this.tools.skip(index);if(this.tools.kind(index)==='Identifier')return this.orderedName(this.tools.text(index),[],narrow);if(this.tools.kind(index)==='PropertyAccessExpression')return this.orderedName(this.tools.member(index),this.segments(this.tools.child(index)),narrow);return false;}
