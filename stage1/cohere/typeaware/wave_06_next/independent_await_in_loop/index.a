            if(siblings&&['Block','CaseClause','DefaultClause'].includes(kind)){for(const sibling of this.tools.children(parent)){if(sibling===child||this.tools.rules.parser.node(sibling).pos>=this.tools.rules.parser.node(child).pos)break;for(const event of this.tools.descendants(sibling,true)){if(['BreakStatement','ContinueStatement','ReturnStatement','ThrowStatement'].includes(this.tools.kind(event))&&this.guarded(event,sibling,false))return true;}}}
