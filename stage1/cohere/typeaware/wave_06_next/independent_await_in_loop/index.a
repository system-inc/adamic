        if(kind==='ThrowStatement'){let child=index;for(let parent=this.tools.parent(child);parent>=0&&child!==this.body;parent=this.tools.parent(parent)){if(this.tools.kind(parent)==='TryStatement'&&this.tools.child(parent)===child&&this.tools.children(parent).some(at=>this.tools.kind(at)==='CatchClause'))return false;child=parent;}return true;}
        if(['BreakStatement','ContinueStatement'].includes(kind)){const target=this.tools.flow.jump(index,kind==='ContinueStatement');return kind==='BreakStatement'?target===this.loop||target>=0&&!this.tools.inside(target,this.loop):target>=0&&target!==this.loop&&!this.tools.inside(target,this.loop);}
        return false;
