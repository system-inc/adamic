import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { written } from '../../../typescript/parser/nodes.ts';
import { byteOffsets } from '../unary_minus.ts';
import { Context, Node } from './context.a';
import {
    ArrowFunction,
    BinaryExpression,
    CallExpression,
    Constructor,
    FunctionDeclaration,
    FunctionExpression,
    GetAccessor,
    MethodDeclaration,
    SetAccessor,
} from './kinds.a';
import { visit as symbolDescription } from './symbol_description/rule.a';
import { visit as validTypeof } from './valid_typeof/rule.a';
import { visit as requireAwait } from './require_await/rule.a';

type Listener = (context: Context, node: Node) => void;
const emptyListeners: readonly Listener[] = [];
const listeners = new Map<number, readonly Listener[]>([
    [CallExpression, [symbolDescription]],
    [BinaryExpression, [validTypeof]],
    [FunctionDeclaration, [requireAwait]],
    [FunctionExpression, [requireAwait]],
    [ArrowFunction, [requireAwait]],
    [MethodDeclaration, [requireAwait]],
    [GetAccessor, [requireAwait]],
    [SetAccessor, [requireAwait]],
    [Constructor, [requireAwait]],
]);
const args = programArguments();
const config = args[0] ?? panic('missing config');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
let findings = 0;
for(const path of paths) {
    const source = readTextFile(path);
    if(source.kind === 'Error') {
        panic(source.message);
    }
    const parser = new Parser(source.text, path);
    parser.file();
    const scanner = new Scanner(source.text);
    const nodes: Node[] = [];
    const parents: number[] = [];
    for(const raw of parser.nodes) {
        scanner.pos = raw.pos;
        scanner.scan();
        nodes.push(new Node(nodes.length, raw, scanner.start));
        parents.push(-1);
    }
    for(const node of nodes) {
        for(const child of node.children) {
            parents[child] = node.index;
        }
    }
    const context = new Context(scanner, program, path, source.text, nodes, parents, byteOffsets(source.text));
    for(const node of nodes) {
        for(const visit of listeners.get(node.kind) ?? emptyListeners) {
            visit(context, node);
        }
    }
    for(const finding of context.findings) {
        finding.sortKey = finding.written();
    }
    context.findings.sort((a, b) => (a.sortKey < b.sortKey ? -1 : a.sortKey > b.sortKey ? 1 : 0));
    findings += context.findings.length;
    if(!args.includes('--count')) {
        console.log(`file\t${written(path)}`);
        for(const finding of context.findings) {
            console.log(finding.written());
        }
    }
}
console.log(`findings ${findings}`);
tsgoRelease(program);
