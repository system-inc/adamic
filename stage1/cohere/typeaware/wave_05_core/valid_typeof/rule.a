import type { Context, Node } from '../context.a';
import {
    StringLiteral,
    NoSubstitutionTemplateLiteral,
    NumericLiteral,
    BigIntLiteral,
    RegularExpressionLiteral,
    NullKeyword,
    TrueKeyword,
    FalseKeyword,
    Identifier,
    TypeOfExpression,
    EqualsEqualsToken,
    EqualsEqualsEqualsToken,
    ExclamationEqualsToken,
    ExclamationEqualsEqualsToken,
} from '../kinds.a';
import { Suggestion } from '../../suggestion.ts';
import { Repair } from '../../repair.ts';
const results = ['undefined', 'object', 'boolean', 'number', 'string', 'function', 'symbol', 'bigint'];
function nonString(found: string): string {
    return `A typeof expression always produces a string, and \`${found}\` is not one, so this comparison is always false (always true for != and !==) and the branch behind it is dead or unconditional. Compare against the string instead: \`typeof value === "undefined"\`, not \`typeof value === undefined\`.`;
}
export function visit(context: Context, node: Node): void {
    const op = context.node(node.children[1] ?? -1);
    if(
        ![EqualsEqualsToken, EqualsEqualsEqualsToken, ExclamationEqualsToken, ExclamationEqualsEqualsToken].includes(
            op.kind,
        )
    ) {
        return;
    }
    const left = context.skip(context.node(node.children[0] ?? -1));
    const right = context.skip(context.node(node.children[2] ?? -1));
    const operand = left.kind === TypeOfExpression ? right : right.kind === TypeOfExpression ? left : undefined;
    if(operand === undefined) {
        return;
    }
    if([StringLiteral, NoSubstitutionTemplateLiteral].includes(operand.kind)) {
        if(!results.includes(operand.text)) {
            context.add(
                'valid-typeof',
                'invalidTypeofValue',
                `A typeof expression can only produce one of eight strings, and "${operand.text}" is not among them, so this comparison is always false and the branch behind it is dead. The eight are undefined, object, boolean, number, string, function, symbol and bigint. Almost every finding here is a typo or a guess at a type name that the language does not report: typeof null is "object", an array is "object", and there is no "array", "null" or "date".`,
                operand,
            );
        }
    }
    else if(
        [NumericLiteral, BigIntLiteral, RegularExpressionLiteral, NullKeyword, TrueKeyword, FalseKeyword].includes(
            operand.kind,
        )
    ) {
        context.add('valid-typeof', 'invalidTypeofValue', nonString(context.source(operand)), operand);
    }
    else if(
        operand.kind === Identifier &&
        operand.text === 'undefined' &&
        !context.declarations(operand).some((ambient) => !ambient)
    ) {
        const finding = context.add('valid-typeof', context.requireStringLiterals ? 'notString' : 'invalidTypeofValue', context.requireStringLiterals ? 'Typeof comparisons should be to string literals. A literal is the one operand the rule can check against the eight strings typeof produces, so with requireStringLiterals on, anything else, a variable or a template with substitutions, is reported rather than trusted.' : nonString('undefined'), operand);
        finding.suggestions.push(
            new Suggestion('suggestString', 'Use `"undefined"` instead of `undefined`.', [
                new Repair(context.byte(operand.start), context.byte(operand.end), '"undefined"'),
            ]),
        );
    }
    else if(context.requireStringLiterals && operand.kind !== TypeOfExpression) {
        context.add('valid-typeof', 'notString', 'Typeof comparisons should be to string literals. A literal is the one operand the rule can check against the eight strings typeof produces, so with requireStringLiterals on, anything else, a variable or a template with substitutions, is reported rather than trusted.', operand);
    }
}
