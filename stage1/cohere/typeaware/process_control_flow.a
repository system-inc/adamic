    readPattern(index: number): void {
        if(index < 0) { return; } const node = this.bindings.rules.parser.node(index);
        if(node.kind === 'Identifier') { if(this.throwableIdentifier(index)) { this.throwable(); } }
        else if(['ParenthesizedExpression', 'NonNullExpression', 'AsExpression', 'SatisfiesExpression', 'TypeAssertionExpression'].includes(node.kind)) { this.readPattern(node.children[node.kind === 'TypeAssertionExpression' ? 1 : 0] ?? -1); }
        else { this.expr(index); }
    }
    defaultBind(target: number, fallback: number): void {
        if(fallback >= 0) { const join = this.fresh(); this.link(this.current, join); const body = this.fresh(); this.link(this.current, body); this.enter(body); this.expr(fallback); this.link(this.current, join); this.enter(join); }
        this.bind(target);
    }
    bind(index: number): void {
        if(index < 0) { return; } const rules = this.bindings.rules; const node = rules.parser.node(index);
        if(node.kind === 'Identifier') { if(this.throwableIdentifier(index)) { this.throwable(); } }
        else if(node.kind === 'OmittedExpression') { return; }
        else if(['ParenthesizedExpression', 'NonNullExpression', 'AsExpression', 'SatisfiesExpression', 'TypeAssertionExpression', 'SpreadElement', 'SpreadAssignment'].includes(node.kind)) { this.bind(node.children[node.kind === 'TypeAssertionExpression' ? 1 : 0] ?? -1); }
        else if(['ObjectBindingPattern', 'ArrayBindingPattern'].includes(node.kind)) {
            for(const child of node.children) { if(rules.parser.node(child).kind !== 'BindingElement') { continue; }
                const fields = this.fields(child); for(const part of rules.parser.node(child).children) { if(rules.parser.node(part).kind === 'ComputedPropertyName') { this.expr(rules.parser.node(part).children[0] ?? -1); } }
                this.defaultBind(fields.get(0), fields.get(3)); }
        } else if(node.kind === 'ObjectLiteralExpression') {
            for(const child of node.children) { const property = rules.parser.node(child);
                if(property.kind === 'PropertyAssignment') { const name = property.children[0] ?? -1; if(rules.parser.node(name).kind === 'ComputedPropertyName') { this.expr(rules.parser.node(name).children[0] ?? -1); } this.bind(property.children[1] ?? -1); }
                else if(property.kind === 'ShorthandPropertyAssignment') { this.defaultBind(property.children[0] ?? -1, property.children[property.children.length - 1] === property.children[0] ? -1 : property.children[property.children.length - 1] ?? -1); }
                else if(property.kind === 'SpreadAssignment') { this.bind(property.children[0] ?? -1); }
            }
        } else if(node.kind === 'ArrayLiteralExpression') { for(const child of node.children) { this.bind(child); } }
        else if(node.kind === 'BinaryExpression' && rules.parser.node(node.children[1] ?? -1).kind === 'EqualsToken') { this.defaultBind(node.children[0] ?? -1, node.children[2] ?? -1); }
        else { this.expr(index); }
    }
    memberHeader(index: number): void {
        const rules = this.bindings.rules; const node = rules.parser.node(index);
        for(const child of node.children) { if(rules.parser.node(child).kind === 'Decorator') { this.expr(rules.parser.node(child).children[0] ?? -1); }
            if(rules.parser.node(child).kind === 'Parameter') { for(const part of rules.parser.node(child).children) { if(rules.parser.node(part).kind === 'Decorator') { this.expr(rules.parser.node(part).children[0] ?? -1); } } } }
        const name = this.fields(index).get(0); if(name >= 0 && rules.parser.node(name).kind === 'ComputedPropertyName') { this.expr(rules.parser.node(name).children[0] ?? -1); }
        if(node.kind === 'PropertyDeclaration') { this.expr(this.fields(index).get(1)); }
        if(node.kind === 'IndexSignature') { const fields = this.fields(index); for(const parameter of fields.parameters) { this.expr(this.fields(parameter).get(1)); } this.expr(fields.get(1)); }
    }
    classLike(index: number): void {
        const rules = this.bindings.rules;
        for(const child of rules.parser.node(index).children) {
            const kind = rules.parser.node(child).kind;
            if(kind === 'Decorator') { this.expr(rules.parser.node(child).children[0] ?? -1); }
            else if(kind === 'HeritageClause') { for(const type of rules.parser.node(child).children) { this.expr(type); } }
            else if(kind === 'TypeParameter') { for(const part of rules.parser.node(child).children.slice(1)) { this.expr(part); } }
            else if(['PropertyDeclaration', 'MethodDeclaration', 'Constructor', 'GetAccessor', 'SetAccessor', 'ClassStaticBlockDeclaration', 'IndexSignature', 'SemicolonClassElement'].includes(kind)) { this.memberHeader(child); }
        }
    }
}

export function processIndexRoots(bindings: Bindings, root: number, roots: number[]): void {
    if(processIsRoot(bindings, root)) { roots.push(root); }
    for(const child of bindings.rules.parser.node(root).children) { processIndexRoots(bindings, child, roots); }
}

export function processDeclarationName(bindings: Bindings, index: number): number {
    if(['ArrowFunction', 'Constructor', 'ClassStaticBlockDeclaration', 'IndexSignature'].includes(bindings.rules.parser.node(index).kind)) { return -1; }
    for(const child of bindings.rules.parser.node(index).children) {
        if(['Identifier', 'ThisKeyword', 'ArrayBindingPattern', 'ObjectBindingPattern', 'ComputedPropertyName', 'PrivateIdentifier', 'StringLiteral', 'NumericLiteral', 'BigIntLiteral', 'NoSubstitutionTemplateLiteral'].includes(bindings.rules.parser.node(child).kind)) { return child; }
    }
    return -1;
}
