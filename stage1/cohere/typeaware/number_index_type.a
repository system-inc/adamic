import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export function hasNumberIndex(rules: Rules, index: number, identity: number): boolean {
    const frames = new Frames(rules.ask(index, `number-index-type\n${identity}`));
    header(frames, 'number-index-type');
    const present = frames.yes();
    if(present) { frames.natural(); }
    frames.end();
    return present;
}
