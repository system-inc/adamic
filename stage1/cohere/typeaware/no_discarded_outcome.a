import type { ParseNode } from './rules.ts';
import type { Rules } from './rules.ts';
import { NexusFacts } from './nexus_facts.a';
import { typeDeclarationAncestry } from './type_declaration_ancestry.a';
const names: readonly string[] = [
    'JsonParseOutcomeType',
    'JsoncParseOutcomeType',
    'JsonFileReadOutcomeType',
    'JsonFileWriteOutcomeType',
    'PackageJsonReadOutcomeType',
];
const files: readonly string[] = [
    '/nexus/source/structured-text/json/Json.ts',
    '/nexus/source/structured-text/json/Jsonc.ts',
    '/nexus/source/structured-text/json/JsonFile.ts',
    '/nexus/source/structured-text/json/JsonFile.ts',
    '/nexus/source/system/PackageJson.ts',
];
export class NoDiscardedOutcome {
    readonly wave17NoDiscardedOutcomeTag = true;
    readonly rules: Rules;
    readonly facts: NexusFacts;
    constructor(rules: Rules, facts: NexusFacts) {
        this.rules = rules;
        this.facts = facts;
    }
    typeName(index: number, awaited: boolean): string {
        const graph = this.facts.shape(index, false);
        if(!graph.present) {
            return '';
        }
        const declarations = typeDeclarationAncestry(this.rules, index, graph.root().id, awaited);
        const seen = new Map<string, string[]>();
        const counts = new Map<string, number>();
        const aliases = new Map<string, string>();
        for(const d of declarations) {
            const arm = d.ancestors[0];
            if(arm === undefined || arm.kind !== 'TypeLiteral') {
                continue;
            }
            let at = 1;
            while(d.ancestors[at]?.kind === 'ParenthesizedType') {
                at++;
            }
            const union = d.ancestors[at];
            if(union === undefined || union.kind !== 'UnionType') {
                continue;
            }
            at++;
            let inner = union;
            while(d.ancestors[at]?.kind === 'ParenthesizedType') {
                inner = d.ancestors[at] ?? inner;
                at++;
            }
            const alias = d.ancestors[at];
            if(
                alias === undefined ||
                alias.kind !== 'TypeAliasDeclaration' ||
                d.ancestors[at + 1]?.kind !== 'SourceFile' ||
                !alias.children.includes(inner.identity())
            ) {
                continue;
            }
            const known = names.indexOf(alias.name);
            if(known < 0 || !d.file.endsWith(files[known] ?? '')) {
                continue;
            }
            const key = `${d.file}:${union.identity()}`;
            const empty: string[] = [];
            const arms = seen.get(key) ?? empty;
            if(!arms.includes(arm.identity())) {
                arms.push(arm.identity());
            }
            seen.set(key, arms);
            counts.set(key, union.children.length);
            aliases.set(key, alias.name);
        }
        for(const name of names) {
            for(const key of seen.keys()) {
                if(aliases.get(key) === name && (seen.get(key)?.length ?? 0) === counts.get(key)) {
                    return name;
                }
            }
        }
        return '';
    }
    visitNode(statement: ParseNode, index: number): void {
        let expression = this.rules.skip(statement.children[0] ?? -1);
        let awaited = false;
        if(this.rules.parser.node(expression).kind === 'AwaitExpression') {
            expression = this.rules.skip(this.rules.parser.node(expression).children[0] ?? -1);
            awaited = true;
        }
        if(this.rules.parser.node(expression).kind !== 'CallExpression') {
            return;
        }
        const name = this.typeName(expression, awaited);
        if(name === '') {
            return;
        }
        this.facts.report(
            'nexus/correctness-no-discarded-outcome',
            'outcomeDiscarded',
            `This call returns a \`${name}\` and the statement throws it away, so the arm that says it failed (a write that never landed, a file that would not parse) is never read and the code runs on as if it succeeded. Keep the outcome and handle its failure arm, or return it to a caller that will. If ignoring it is the intent, say so with \`void\`.`,
            index,
        );
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(node.kind === 'ExpressionStatement') { this.visitNode(node, index); }
        }
    }
}
