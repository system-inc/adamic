import {panic} from 'adamic';
import {Diagnostic} from '../../diagnostic.ts';

// Reporting helper. The source validator is in rule.a; this legacy no-input API refuses.
export class SetStateInEffect {
 render(start:number,end:number):Diagnostic{return new Diagnostic('react-hooks/set-state-in-effect','setStateInEffect',"This effect calls a state setter synchronously in its body, so every time the effect runs React starts another render, which runs the effect's dependencies again. Effects are for synchronizing React with something outside it, such as the document title, a subscription, or a network request, and a setter called straight from the body is usually a value that could have been computed during render instead. Derive the value while rendering, pass the initial value to `useState`, or set it from the event that actually caused the change. Calling the setter from a callback the effect registers, such as a subscription or a timer, is fine and is not reported.",start,end,'');}
 analyze():void{panic('NotYet: this reporting helper has no source inputs; use SetStateInEffectRule in rule.a');}
}
