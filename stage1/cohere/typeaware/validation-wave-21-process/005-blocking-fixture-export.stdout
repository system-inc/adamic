[{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport function runStatement(commandArguments: string[]): void {\n    use(commandArguments);\n    for(const line of result.lines) console.log(line);\n    process.exit(result.exitCode);\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport function runStatement(commandArguments: string[]): void {\n    use(commandArguments);\n    for(const line of result.lines) console.log(line);\n    process.exitCode = result.exitCode;\n    return;\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport async function runSync(commandArguments: string[]): Promise\u003cvoid\u003e {\n    use(commandArguments);\n    for(const source of result.sources) {\n        if(source.ok) {\n            console.log(`  ${source.label}: synced`);\n        }\n        else {\n            console.error(`RETRYABLE: ${source.label}`.trimEnd());\n        }\n    }\n    if(result.sources.length === 0) {\n        console.log('  No connected sources.');\n    }\n    process.exit(result.allOk ? 0 : 1);\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport async function runSync(commandArguments: string[]): Promise\u003cvoid\u003e {\n    use(commandArguments);\n    for(const source of result.sources) {\n        if(source.ok) {\n            console.log(`  ${source.label}: synced`);\n        }\n        else {\n            console.error(`RETRYABLE: ${source.label}`.trimEnd());\n        }\n    }\n    if(result.sources.length === 0) {\n        console.log('  No connected sources.');\n    }\n    process.exitCode = result.allOk ? 0 : 1;\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport async function runQuickBooksCardBalances(): Promise\u003cvoid\u003e {\n    console.log('');\n    if(!report.authorized) {\n        console.log('  QuickBooks NOT linked. No balance captured, nothing written.');\n        console.log('');\n        process.exit(0);\n    }\n    for(const line of report.lines) console.log(`    ${line}`);\n    console.log('');\n    process.exit(0);\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport async function runQuickBooksCardBalances(): Promise\u003cvoid\u003e {\n    console.log('');\n    if(!report.authorized) {\n        console.log('  QuickBooks NOT linked. No balance captured, nothing written.');\n        console.log('');\n        return;\n    }\n    for(const line of report.lines) console.log(`    ${line}`);\n    console.log('');\n\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport function godwordRequireInteractiveTerminal(): void {\n    if(!NodeProcess.stdin.isTTY) {\n        console.error('godword needs a human at a keyboard.');\n        console.error('Run it in an interactive terminal.');\n        NodeProcess.exit(1);\n    }\n}\n"},{"/repository/source/CorrectnessNoProcessExitAfterOutput.ts":"/// \u003creference lib=\"dom\" /\u003e\nimport * as NodeProcess from 'node:process';\ndeclare const flag: boolean;\ndeclare const output: string;\ndeclare const rows: string[];\ndeclare const report: { authorized: boolean; lines: string[] };\ndeclare const result: { lines: string[]; exitCode: number; allOk: boolean; sources: { ok: boolean; label: string }[] };\ndeclare const fileConsole: Console;\ndeclare const streams: { stdout: { write(text: string): void } };\ndeclare const runner: { exit(code: number): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function printReport(): void;\ndeclare function runLinkCommand(commandArguments: string[]): Promise\u003cnumber\u003e;\n\nexport function godwordRequireInteractiveTerminal(): void {\n    if(!NodeProcess.stdin.isTTY) {\n        console.error('godword needs a human at a keyboard.');\n        console.error('Run it in an interactive terminal.');\n        NodeProcess.exitCode = 1;\n        return;\n    }\n}\n"},{"/repository/source/CorrectnessNoUnclearedRaceTimeout.ts":"declare function generateImage(prompt: string): Promise\u003c{ path: string }\u003e;\ndeclare function work(): Promise\u003cstring\u003e;\ndeclare function timeoutAfter(milliseconds: number): Promise\u003cnever\u003e;\ndeclare function use(value: unknown): void;\ndeclare const milliseconds: number;\nexport async function renderImage(prompt: string) {\n    const imageTimeoutInMilliseconds = 10 * 60 * 1000;\n\n    let imageResult;\n    try {\n        imageResult = await Promise.race([\n            generateImage(prompt),\n            new Promise\u003cnever\u003e(function rejectAfterTimeout(_resolve, reject) {\n                setTimeout(function fireTimeout() {\n                    reject(new Error(`image-render-timeout after ${Math.round(imageTimeoutInMilliseconds / 1000)}s`));\n                }, imageTimeoutInMilliseconds);\n            }),\n        ]);\n    }\n    catch(error) {\n        use(error);\n        return null;\n    }\n\n    return imageResult;\n}\n"},{"/repository/source/CorrectnessNoUnclearedRaceTimeout.ts":"declare function generateImage(prompt: string): Promise\u003c{ path: string }\u003e;\ndeclare function work(): Promise\u003cstring\u003e;\ndeclare function timeoutAfter(milliseconds: number): Promise\u003cnever\u003e;\ndeclare function use(value: unknown): void;\ndeclare const milliseconds: number;\nexport async function renderImage(prompt: string) {\n    const imageTimeoutInMilliseconds = 10 * 60 * 1000;\n    let imageTimer: NodeJS.Timeout | undefined;\n    let imageResult;\n    try {\n        imageResult = await Promise.race([\n            generateImage(prompt),\n            new Promise\u003cnever\u003e(function rejectAfterTimeout(_resolve, reject) {\n                imageTimer = setTimeout(function fireTimeout() {\n                    reject(new Error(`image-render-timeout after ${Math.round(imageTimeoutInMilliseconds / 1000)}s`));\n                }, imageTimeoutInMilliseconds);\n            }),\n        ]);\n    }\n    catch(error) {\n        use(error);\n        return null;\n    }\n    finally {\n        clearTimeout(imageTimer);\n    }\n    return imageResult;\n}\n"},{"/repository/libraries/nexus/source/command-line/CommandLineInterface.ts":"import { blockStandardStreams } from '../system/StandardStreams';\nexport abstract class CommandLineInterface {\n    abstract run(): Promise\u003cvoid\u003e;\n}\nexport function runCommandLineInterface(commandLineInterface: CommandLineInterface): void {\n    blockStandardStreams();\n    commandLineInterface.run().catch(function(error: unknown) {\n        console.error('Error:', error instanceof Error ? error.message : String(error));\n        process.exit(1);\n    });\n}\n","/repository/libraries/nexus/source/system/StandardStreams.ts":"export function blockStandardStreams(): void {\n    Reflect.get(process.stdout, '_handle');\n}\n","/repository/modules/subject/Subject.ts":"#!/usr/bin/env tsx\nfunction showHelp(): void {\n    console.log('facets - Domain-specific memory extraction from conversations');\n}\nasync function main(): Promise\u003cvoid\u003e {\n    const commandLineArguments = argumentsList.slice(2);\n    if(commandLineArguments.length === 0) {\n        showHelp();\n        return;\n    }\n    const [facetName, command] = commandLineArguments;\n    if(!facetName || !command) {\n        console.error('Usage: node facets/index.js \u003cfacet\u003e \u003cupdate|build\u003e');\n        process.exit(1);\n    }\n    if(command === 'update') {\n        console.log('Faceted Memory Extraction');\n        await run();\n        return;\n    }\n    console.error(`Unknown command: ${command}`);\n    process.exit(1);\n}\nmain().catch(function(error: unknown) {\n    console.error('Error:', error);\n    process.exit(1);\n});\n","/repository/types/node.d.ts":"declare var process: NodeJS.Process;\ndeclare module \"node:process\" {\n    global {\n        var process: NodeJS.Process;\n        namespace NodeJS {\n            interface WritableStream { write(chunk: string | Uint8Array, callback?: (error?: Error | null) =\u003e void): boolean }\n            interface WriteStream extends WritableStream { columns: number }\n            interface ReadStream { isTTY?: boolean; setRawMode(mode: boolean): this; resume(): this; pause(): this }\n            interface Process {\n                stdout: WriteStream \u0026 { fd: 1 };\n                stderr: WriteStream \u0026 { fd: 2 };\n                stdin: ReadStream \u0026 { fd: 0 };\n                exitCode: number | string | null | undefined;\n                exit(code?: number | string | null): never;\n                on(event: string, listener: (...args: any[]) =\u003e void): this;\n            }\n        }\n    }\n    export = process;\n}\ndeclare module \"process\" {\n    import process = require(\"node:process\");\n    export = process;\n}\ndeclare module \"node:console\" {\n    namespace console {\n        interface Console {\n            log(...data: any[]): void;\n            info(...data: any[]): void;\n            debug(...data: any[]): void;\n            warn(...data: any[]): void;\n            error(...data: any[]): void;\n            trace(...data: any[]): void;\n            table(tabularData?: any, properties?: string[]): void;\n            dir(item?: any): void;\n            dirxml(...data: any[]): void;\n            group(...data: any[]): void;\n            time(label?: string): void;\n        }\n    }\n    var console: console.Console;\n    export = console;\n}\n","/repository/types/prelude.d.ts":"declare const argumentsList: string[];\ndeclare const output: string;\ndeclare const flag: boolean;\ndeclare const results: unknown;\ndeclare const socketServer: { on(event: string, listener: (error: Error) =\u003e void): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function onEvent(listener: () =\u003e void): void;\ndeclare function sendResults(value: unknown): void;\n","/repository/types/web-console.d.ts":"export {};\nimport * as console from \"node:console\";\ndeclare global {\n    interface Console extends console.Console {}\n    var console: Console;\n}\n"},{"/repository/libraries/nexus/source/command-line/CommandLineInterface.ts":"import { blockStandardStreams } from '../system/StandardStreams';\nexport abstract class CommandLineInterface {\n    abstract run(): Promise\u003cvoid\u003e;\n}\nexport function runCommandLineInterface(commandLineInterface: CommandLineInterface): void {\n    blockStandardStreams();\n    commandLineInterface.run().catch(function(error: unknown) {\n        console.error('Error:', error instanceof Error ? error.message : String(error));\n        process.exit(1);\n    });\n}\n","/repository/libraries/nexus/source/system/StandardStreams.ts":"export function blockStandardStreams(): void {\n    Reflect.get(process.stdout, '_handle');\n}\n","/repository/modules/subject/Subject.ts":"#!/usr/bin/env tsx\nimport { blockStandardStreams } from '../../libraries/nexus/source/system/StandardStreams';\nfunction showHelp(): void {\n    console.log('facets - Domain-specific memory extraction from conversations');\n}\nasync function main(): Promise\u003cvoid\u003e {\n    blockStandardStreams();\n    const commandLineArguments = argumentsList.slice(2);\n    if(commandLineArguments.length === 0) {\n        showHelp();\n        return;\n    }\n    const [facetName, command] = commandLineArguments;\n    if(!facetName || !command) {\n        console.error('Usage: node facets/index.js \u003cfacet\u003e \u003cupdate|build\u003e');\n        process.exit(1);\n    }\n    if(command === 'update') {\n        console.log('Faceted Memory Extraction');\n        await run();\n        return;\n    }\n    console.error(`Unknown command: ${command}`);\n    process.exit(1);\n}\nmain().catch(function(error: unknown) {\n    console.error('Error:', error);\n    process.exit(1);\n});\n","/repository/types/node.d.ts":"declare var process: NodeJS.Process;\ndeclare module \"node:process\" {\n    global {\n        var process: NodeJS.Process;\n        namespace NodeJS {\n            interface WritableStream { write(chunk: string | Uint8Array, callback?: (error?: Error | null) =\u003e void): boolean }\n            interface WriteStream extends WritableStream { columns: number }\n            interface ReadStream { isTTY?: boolean; setRawMode(mode: boolean): this; resume(): this; pause(): this }\n            interface Process {\n                stdout: WriteStream \u0026 { fd: 1 };\n                stderr: WriteStream \u0026 { fd: 2 };\n                stdin: ReadStream \u0026 { fd: 0 };\n                exitCode: number | string | null | undefined;\n                exit(code?: number | string | null): never;\n                on(event: string, listener: (...args: any[]) =\u003e void): this;\n            }\n        }\n    }\n    export = process;\n}\ndeclare module \"process\" {\n    import process = require(\"node:process\");\n    export = process;\n}\ndeclare module \"node:console\" {\n    namespace console {\n        interface Console {\n            log(...data: any[]): void;\n            info(...data: any[]): void;\n            debug(...data: any[]): void;\n            warn(...data: any[]): void;\n            error(...data: any[]): void;\n            trace(...data: any[]): void;\n            table(tabularData?: any, properties?: string[]): void;\n            dir(item?: any): void;\n            dirxml(...data: any[]): void;\n            group(...data: any[]): void;\n            time(label?: string): void;\n        }\n    }\n    var console: console.Console;\n    export = console;\n}\n","/repository/types/prelude.d.ts":"declare const argumentsList: string[];\ndeclare const output: string;\ndeclare const flag: boolean;\ndeclare const results: unknown;\ndeclare const socketServer: { on(event: string, listener: (error: Error) =\u003e void): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function onEvent(listener: () =\u003e void): void;\ndeclare function sendResults(value: unknown): void;\n","/repository/types/web-console.d.ts":"export {};\nimport * as console from \"node:console\";\ndeclare global {\n    interface Console extends console.Console {}\n    var console: Console;\n}\n"},{"/repository/libraries/nexus/source/command-line/CommandLineInterface.ts":"import { blockStandardStreams } from '../system/StandardStreams';\nexport abstract class CommandLineInterface {\n    abstract run(): Promise\u003cvoid\u003e;\n}\nexport function runCommandLineInterface(commandLineInterface: CommandLineInterface): void {\n    blockStandardStreams();\n    commandLineInterface.run().catch(function(error: unknown) {\n        console.error('Error:', error instanceof Error ? error.message : String(error));\n        process.exit(1);\n    });\n}\n","/repository/libraries/nexus/source/system/StandardStreams.ts":"export function blockStandardStreams(): void {\n    Reflect.get(process.stdout, '_handle');\n}\n","/repository/modules/subject/Subject.ts":"const specFilePath = argumentsList[2];\nif(!specFilePath) {\n    console.error('Usage: DataConversionShardWorker.ts \u003cshard-spec.json\u003e');\n    process.exit(2);\n}\nsendResults(results);\nprocess.exit(0);\n","/repository/types/node.d.ts":"declare var process: NodeJS.Process;\ndeclare module \"node:process\" {\n    global {\n        var process: NodeJS.Process;\n        namespace NodeJS {\n            interface WritableStream { write(chunk: string | Uint8Array, callback?: (error?: Error | null) =\u003e void): boolean }\n            interface WriteStream extends WritableStream { columns: number }\n            interface ReadStream { isTTY?: boolean; setRawMode(mode: boolean): this; resume(): this; pause(): this }\n            interface Process {\n                stdout: WriteStream \u0026 { fd: 1 };\n                stderr: WriteStream \u0026 { fd: 2 };\n                stdin: ReadStream \u0026 { fd: 0 };\n                exitCode: number | string | null | undefined;\n                exit(code?: number | string | null): never;\n                on(event: string, listener: (...args: any[]) =\u003e void): this;\n            }\n        }\n    }\n    export = process;\n}\ndeclare module \"process\" {\n    import process = require(\"node:process\");\n    export = process;\n}\ndeclare module \"node:console\" {\n    namespace console {\n        interface Console {\n            log(...data: any[]): void;\n            info(...data: any[]): void;\n            debug(...data: any[]): void;\n            warn(...data: any[]): void;\n            error(...data: any[]): void;\n            trace(...data: any[]): void;\n            table(tabularData?: any, properties?: string[]): void;\n            dir(item?: any): void;\n            dirxml(...data: any[]): void;\n            group(...data: any[]): void;\n            time(label?: string): void;\n        }\n    }\n    var console: console.Console;\n    export = console;\n}\n","/repository/types/prelude.d.ts":"declare const argumentsList: string[];\ndeclare const output: string;\ndeclare const flag: boolean;\ndeclare const results: unknown;\ndeclare const socketServer: { on(event: string, listener: (error: Error) =\u003e void): void };\ndeclare function run(): Promise\u003cvoid\u003e;\ndeclare function use(value: unknown): void;\ndeclare function onEvent(listener: () =\u003e void): void;\ndeclare function sendResults(value: unknown): void;\n","/repository/types/web-console.d.ts":"export {};\nimport * as console from \"node:console\";\ndeclare global {\n    interface Console extends console.Console {}\n    var console: Console;\n}\n"},{"/repository/libraries/nexus/source/command-line/CommandLineInterface.ts":"import { blockStandardStreams } from '../system/StandardStreams';\nexport abstract class CommandLineInterface {\n    abstract run(): Promise\u003cvoid\u003e;\n}\nexport function runCommandLineInterface(commandLineInterface: CommandLineInterface): void {\n    blockStandardStreams();\n    commandLineInterface.run().catch(function(error: unknown) {\n        console.error('Error:', error instanceof Error ? error.message : String(error));\n        process.exit(1);\n    });\n}\n","/repository/libraries/nexus/source/system/StandardStreams.ts":"export function blockStandardStreams(): void {\n    Reflect.get(process.stdout, '_handle');\n}\n","/repository/modules/subject/Subject.ts":"import { blockStandardStreams } from '../../libraries/nexus/source/system/StandardStreams';\nblockStandardStreams();\nconst specFilePath = argumentsList[2];\nif(!specFilePath) {\n    console.error('Usage: DataConversionShardWorker.ts \u003cshard-spec.json\u003e');\n    process.exit(2);\n}\nsendResults(results);\nprocess.exit(0);\n","/re