import { quoted } from '../unicode.a';
import { Frames, header } from '../../frames.ts';
import { Context } from '../context.a';
import { Node } from '../node.a';
import { K } from '../syntax_kinds.a';
import { resolvedSignatureDeclaration } from './resolved_signature_declaration.a';
import type { ConstructionCore } from './construction.a';

class Instability {
    readonly dependency: number;
    readonly origin: number;
    readonly reason: string;
    constructor(dependency: number, origin: number, reason: string) {
        this.dependency = dependency; this.origin = origin; this.reason = reason;
    }
}
class Evaluation {
    readonly fresh: Instability | undefined;
    readonly other: boolean;
    readonly holders: number[];
    constructor(fresh: Instability | undefined, other: boolean, holders: number[]) {
        this.fresh = fresh; this.other = other; this.holders = holders;
    }
}
export class Stability {
    readonly rule: ConstructionCore;
    readonly context: Context;
    readonly active = new Set<number>();
    render = -1;
    constructor(rule: ConstructionCore) { this.rule = rule; this.context = rule.context; }
    hook(index: number): string {
        const c = this.context;
        if(c.kind(index) !== K.CallExpression) return '';
        const callee = c.skip(c.node(index).children[0] ?? -1);
        if(c.kind(callee) === K.Identifier) {
            const name = c.node(callee).text;
            return ['useMemo', 'useCallback'].includes(name) ? name : '';
        }
        if(c.kind(callee) !== K.PropertyAccessExpression) return '';
        const receiver = c.skip(c.node(callee).children[0] ?? -1), name = c.last(c.node(callee));
        if(c.kind(receiver) !== K.Identifier || c.node(receiver).text !== 'React' || c.kind(name) !== K.Identifier) return '';
        return ['useMemo', 'useCallback'].includes(c.node(name).text) ? c.node(name).text : '';
    }
    args(index: number): readonly number[] {
        const node = this.context.node(index);
        return node.list > 0 ? node.children.slice(node.children.length - node.list) : [];
    }
    runsWith(owner: number, scope: number): boolean {
        if(owner < 0) return false;
        if(owner === scope) return true;
        const c = this.context;
        const chain: number[] = [];
        let at = scope;
        while(at >= 0) {chain.push(at); if(at === this.render) break; at = c.nearest(at);}
        return chain[chain.length - 1] === this.render && chain.includes(owner);
    }
    renderConst(index: number, scope: number): number {
        const c = this.context;
        if(c.kind(index) !== K.Identifier) return -1;
        const declaration = c.binding(c.node(index)).local[0] ?? -1;
        if(declaration < 0 || !this.runsWith(c.nearest(declaration), scope)) return -1;
        if(c.kind(declaration) === K.FunctionDeclaration) return declaration;
        const parent = c.parent(declaration);
        return c.kind(declaration) === K.VariableDeclaration && c.kind(parent) === K.VariableDeclarationList &&
            (Number(c.node(parent).semantic) & 2) !== 0 ? declaration : -1;
    }
    primitive(node: Node): boolean {
        const c = this.context;
        const f = new Frames(c.ask(node, 'render-type-facts'));
        header(f, 'render-type-facts');
        const root = f.natural(), count = f.natural();
        const flags = new Map<number, number>(), parts = new Map<number, number[]>();
        for(let at = 0; at < count; at++) {
            const id = f.natural(); flags.set(id, f.natural()); f.yes(); f.field(); f.natural(); parts.set(id, f.ids());
        }
        f.end();
        if(root === 0) return false;
        const absent: number[] = [];
        const roots = ((flags.get(root) ?? 0) & 134217728) !== 0 ? parts.get(root) ?? absent : [root];
        const mask = 4 | 8 | 16 | 32 | 64 | 128 | 256 | 512 | 1024 | 2048 | 4096 | 8192 | 16384 | 32768 | 65536 | 4194304 | 8388608;
        for(const id of roots) if(((flags.get(id) ?? 0) & mask) === 0) return false;
        return true;
    }
    unknown(): Evaluation { return new Evaluation(undefined, true, []); }
    empty(): Evaluation { return new Evaluation(undefined, false, []); }
    combine(a: Evaluation, b: Evaluation): Evaluation {
        return new Evaluation(a.fresh ?? b.fresh, a.other || b.other, [...a.holders, ...b.holders]);
    }
    memoOf(index: number, scope: number): number {
        const c = this.context;
        const value = c.unwrap(index);
        if(this.hook(value) !== '') return value;
        const declaration = this.renderConst(value, scope);
        if(c.kind(declaration) !== K.VariableDeclaration) return -1;
        const initialized = c.unwrap(this.rule.declarations.initializer(c.node(declaration)));
        return this.hook(initialized) === '' ? -1 : initialized;
    }
    memo(index: number, scope: number, depth: number): Evaluation {
        if(depth > 8 || this.active.has(index)) return this.unknown();
        this.active.add(index);
        const result = this.memoInner(index, scope, depth);
        this.active.delete(index);
        return result;
    }
    memoInner(index: number, scope: number, depth: number): Evaluation {
        const c = this.context, args = this.args(index);
        if(args.length === 0) return this.unknown();
        let finding: Instability | undefined;
        if(args.length === 1) finding = new Instability(-1, index, '');
        else {
            const dependencies = c.unwrap(args[1] ?? -1);
            if(c.kind(dependencies) !== K.ArrayLiteralExpression) return this.unknown();
            for(const dependency of c.node(dependencies).children) {
                const evaluated = this.evaluate(dependency, scope, depth + 1);
                if(evaluated.fresh === undefined || (evaluated.other && this.escapes(evaluated.holders, true))) continue;
                finding = new Instability(dependency, evaluated.fresh.origin, evaluated.fresh.reason);
                break;
            }
        }
        if(finding === undefined) return this.unknown();
        if(this.hook(index) === 'useCallback') return new Evaluation(finding, false, []);
        const factory = c.unwrap(args[0] ?? -1);
        if(![K.ArrowFunction, K.FunctionExpression].includes(c.kind(factory))) return this.unknown();
        const result = this.functionEvaluation(factory, depth + 1);
        return result.fresh === undefined ? this.unknown() : new Evaluation(finding, result.other, []);
    }
    evaluate(index: number, scope: number, depth: number): Evaluation {
        const c = this.context;
        index = c.unwrap(index);
        if(index < 0) return this.empty();
        if(depth > 8) return this.unknown();
        const node = c.node(index);
        if(this.primitive(node)) return this.empty();
        const direct = this.rule.constructionLabel(node.kind);
        if(direct !== '') return new Evaluation(new Instability(-1, index, `is a new ${direct} built during render`), false, []);
        if(node.kind === K.ConditionalExpression)
            return this.combine(this.evaluate(node.children[2] ?? -1, scope, depth + 1), this.evaluate(node.children[4] ?? -1, scope, depth + 1));
        if(node.kind === K.BinaryExpression) {
            const operator = c.kind(node.children[1] ?? -1);
            if([K.AmpersandAmpersandToken, K.BarBarToken, K.QuestionQuestionToken].includes(operator))
                return this.combine(this.evaluate(node.children[0] ?? -1, scope, depth + 1), this.evaluate(node.children[2] ?? -1, scope, depth + 1));
            if(operator === K.CommaToken) return this.evaluate(node.children[2] ?? -1, scope, depth + 1);
            if(operator !== K.EqualsToken) return this.unknown();
            const declaration = this.local(node.children[0] ?? -1, scope);
            if(declaration < 0) return this.unknown();
            const result = this.evaluate(node.children[2] ?? -1, scope, depth + 1);
            if(result.fresh !== undefined) result.holders.push(declaration);
            return result;
        }
        if(node.kind === K.CallExpression) {
            const hook = this.hook(index);
            if(hook === '') return this.callEvaluation(index, depth + 1);
            const result = this.memo(index, scope, depth + 1);
            if(result.fresh === undefined) return this.unknown();
            const found = result.fresh;
            const reason = found.dependency < 0 ? `comes from a ${hook} with no dependency list` :
                `comes from a ${hook} whose own dependency ${this.quoted(c.source(c.node(found.dependency)))} ${found.reason}`;
            return new Evaluation(new Instability(-1, found.origin, reason), result.other, []);
        }
        if(node.kind !== K.Identifier) return this.unknown();
        const declaration = this.renderConst(index, scope);
        if(declaration < 0 || this.active.has(declaration)) return this.unknown();
        if(c.kind(declaration) === K.FunctionDeclaration)
            return new Evaluation(new Instability(-1, declaration, 'is a function declared during render'), false, [declaration]);
        this.active.add(declaration);
        const result = this.evaluate(this.rule.declarations.initializer(c.node(declaration)), scope, depth + 1);
        this.active.delete(declaration);
        if(result.fresh !== undefined) result.holders.push(declaration);
        return result;
    }
    callEvaluation(index: number, depth: number): Evaluation {
        const c = this.context, signature = resolvedSignatureDeclaration(c, c.node(index));
        if(signature.index < 0) return this.unknown();
        const callee = c.unwrap(c.node(index).children[0] ?? -1);
        let name = 'the call';
        if(c.kind(callee) === K.Identifier) name = c.node(callee).text;
        else if(c.kind(callee) === K.PropertyAccessExpression) name = c.node(c.last(c.node(callee))).text;
        if(signature.asynchronous) return new Evaluation(new Instability(-1, signature.index,
            `is the result of \`${name}(...)\`, an async function, which returns a new promise on every call`), false, []);
        if(signature.generator) return new Evaluation(new Instability(-1, signature.index,
            `is the result of \`${name}(...)\`, a generator, which returns a new iterator on every call`), false, []);
        const result = this.functionEvaluation(signature.index, depth + 1);
        return result.fresh === undefined ? result : new Evaluation(new Instability(-1, result.fresh.origin,
            `is the result of \`${name}(...)\`, which can return a new value on every call`), result.other, result.holders);
    }
    body(index: number): number {
        const c = this.context, node = c.node(index);
        const last = c.last(node);
        return c.kind(last) === K.Block || node.kind === K.ArrowFunction ? last : -1;
    }
    returns(index: number, scope: number, depth: number): Evaluation {
        const c = this.context, node = c.node(index);
        if(node.kind === K.ReturnStatement) return this.evaluate(node.children[0] ?? -1, scope, depth + 1);
        if(c.functionKind(node.kind) || [K.ClassDeclaration, K.ClassExpression].includes(node.kind)) return this.empty();
        let result = this.empty();
        for(const child of node.children) result = this.combine(result, this.returns(child, scope, depth));
        return result;
    }
    functionEvaluation(index: number, depth: number): Evaluation {
        const c = this.context;
        if(depth > 8 || this.active.has(index)) return this.unknown();
        const body = this.body(index);
        if(body < 0) return this.unknown();
        this.active.add(index);
        let result = c.kind(body) === K.Block ? this.returns(body, index, depth) : this.evaluate(body, index, depth + 1);
        const own = result.holders.filter((holder) => c.nearest(holder) === index);
        const enclosing = result.holders.filter((holder) => c.nearest(holder) !== index);
        if(result.fresh !== undefined && result.other && this.escapes(own, false)) result = this.unknown();
        this.active.delete(index);
        return new Evaluation(result.fresh, result.other, enclosing);
    }
    local(index: number, scope: number): number {
        const c = this.context;
        index = c.unwrap(index);
        if(c.kind(index) !== K.Identifier) return -1;
        const declaration = c.binding(c.node(index)).local[0] ?? -1;
        return c.kind(declaration) === K.VariableDeclaration && c.nearest(declaration) === scope ? declaration : -1;
    }
    symbol(index: number, read: boolean): number {
        const c = this.context, f = new Frames(c.ask(c.node(index), 'symbol-identities'));
        header(f, 'symbol-identities');
        const id = f.natural(); f.natural(); f.yes(); f.natural(); const shorthand = f.natural(); f.end();
        return read && c.kind(c.parent(index)) === K.ShorthandPropertyAssignment ? shorthand : id;
    }
    factory(index: number): boolean {
        const c = this.context, parent = c.parent(index);
        return this.hook(parent) !== '' && (this.args(parent)[0] ?? -1) === index;
    }
    memoResult(index: number): boolean {
        const c = this.context;
        let at = index;
        while(c.kind(c.parent(at)) === K.ParenthesizedExpression) at = c.parent(at);
        const parent = c.parent(at);
        return (c.kind(parent) === K.ArrowFunction && this.body(parent) === at && this.factory(parent)) ||
            (c.kind(parent) === K.ReturnStatement && this.factory(c.nearest(parent)));
    }
    home(index: number, scope: number, render: boolean): boolean {
        const c = this.context;
        let at = index;
        while([K.ParenthesizedExpression, K.AsExpression, K.SatisfiesExpression, K.NonNullExpression].includes(c.kind(c.parent(at)))) at = c.parent(at);
        const parent = c.parent(at);
        if(parent < 0) return false;
        const node = c.node(parent);
        if(node.kind === K.ReturnStatement) return c.nearest(at) === scope || (render && this.factory(c.nearest(at)));
        if(node.kind === K.ArrowFunction) return this.body(parent) === at && (parent === scope || (render && this.factory(parent)));
        if([K.PropertyAccessExpression, K.ElementAccessExpression].includes(node.kind)) {
            const enclosing = c.parent(parent);
            return node.children[0] === at && !(c.kind(enclosing) === K.CallExpression && c.node(enclosing).children[0] === parent);
        }
        if(node.kind === K.BinaryExpression) {
            const operator = c.kind(node.children[1] ?? -1);
            return operator === K.EqualsToken ? node.children[0] === at :
                [K.EqualsEqualsToken, K.EqualsEqualsEqualsToken, K.ExclamationEqualsToken, K.ExclamationEqualsEqualsToken, K.InstanceOfKeyword].includes(operator);
        }
        if(node.kind === K.PrefixUnaryExpression) return node.operator === K.ExclamationToken;
        if(node.kind === K.TypeOfExpression) return true;
        if(node.kind === K.IfStatement) return node.children[0] === at;
        if(node.kind === K.ArrayLiteralExpression) {
            const call = c.parent(parent);
            return render && this.hook(call) !== '' && this.args(call)[1] === parent;
        }
        if(node.kind === K.ShorthandPropertyAssignment) return render && this.memoResult(c.parent(parent));
        if(node.kind === K.PropertyAssignment) return render && c.last(node) === at && this.memoResult(c.parent(parent));
        return false;
    }
    escapeWalk(index: number, name: number, symbol: number, scope: number, render: boolean): boolean {
        const c = this.context, node = c.node(index);
        if(node.kind === K.Identifier && index !== name && this.symbol(index, true) === symbol && !this.home(index, scope, render)) return true;
        for(const child of node.children) if(this.escapeWalk(child, name, symbol, scope, render)) return true;
        return false;
    }
    escapes(holders: readonly number[], render: boolean): boolean {
        const c = this.context;
        for(const holder of holders) {
            const scope = c.nearest(holder);
            if(scope < 0) return true;
            const body = this.body(scope);
            const name = c.node(holder).children.find((child) => c.kind(child) === K.Identifier) ?? -1;
            if(body < 0 || name < 0) return true;
            const id = this.symbol(name, false);
            if(id === 0 || this.escapeWalk(body, name, id, scope, render)) return true;
        }
        return false;
    }
    quoted(text: string): string {return quoted(text);}
    check(value: number, provider: Node): void {
        const c = this.context;
        this.render = c.nearest(provider.index);
        const memo = this.memoOf(value, this.render);
        if(memo < 0) return;
        const result = this.memo(memo, this.render, 0), finding = result.fresh;
        if(finding === undefined) return;
        const hook = this.hook(memo), line = this.rule.line(c.node(memo));
        if(finding.dependency < 0) {
            const callee = c.node(memo).children[0] ?? -1;
            c.report(c.node(callee), 'jsx-no-constructed-context-values', 'memoWithoutDependenciesMsg',
                `The ${hook} that builds the Context provider's value (at line ${line}) has no dependency list, so it recomputes on every render and every consumer of this context re-renders on every render of this component, exactly as if it were not memoized. Pass the dependency list.`);
            return;
        }
        const dependency = c.node(finding.dependency), text = this.quoted(c.source(dependency));
        const origin = c.node(finding.origin);
        const location = ` (at line ${this.rule.line(origin)})`;
        c.report(dependency, 'jsx-no-constructed-context-values', 'unstableDependencyMsg',
            `The ${text} dependency of the ${hook} that builds the Context provider's value (at line ${line}) ${finding.reason}${location}, so the ${hook} recomputes on every render and every consumer of this context re-renders on every render of this component, exactly as if it were not memoized. A memoized value is only stable when every input is: make ${text} stable too, by memoizing it or by building it outside the component.`);
    }
}
