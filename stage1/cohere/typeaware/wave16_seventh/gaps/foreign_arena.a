import { programArguments, readTextFile, tsgoProgram, tsgoRelease, panic } from 'adamic';
import { Parser as JsxParser } from '../../wave16_jsx_parser.a';
import { Parser } from '../../../../typescript/parser/parser.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { UnaryMinus, byteOffsets } from '../../unary_minus.ts';
import { Rules } from '../../rules.ts';
import { Context } from '../context_foreign_gap.a';
const args=programArguments(), path=args[1]??panic('missing source');
const source=readTextFile(path);if(source.kind==='Error')panic(source.message);
const program=tsgoProgram(args[0]??'', [path]);
const jsx=new JsxParser(source.text,path), root=jsx.file();
const parser=new Parser(source.text,path);
for(const node of jsx.nodes)parser.nodes.push(node);
const scanner=new Scanner(source.text), offsets=byteOffsets(source.text);
const rules=new Rules(program,path,parser,scanner,offsets,new UnaryMinus(program,path,parser,scanner,offsets));
for(const node of parser.nodes)rules.parents.push(-1);
rules.links(root,-1);
const context=new Context(rules);context.load(args[2]??'');
console.log(`${context.nodes.length}`);tsgoRelease(program);
