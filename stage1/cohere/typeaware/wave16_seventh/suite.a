import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { Parser as JsxParser } from '../wave16_jsx_parser.a';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { UnaryMinus, byteOffsets } from '../unary_minus.ts';
import { Rules } from '../rules.ts';

import { Context } from './context.a';
import { K } from './syntax_kinds.a';
import { JsxFragments } from './jsx_fragments/rule.a';
import { JsxNoConstructedContextValues } from './jsx_no_constructed_context_values/rule.a';
import { JsxNoUndef } from './jsx_no_undef/rule.a';

const args = programArguments();
const config = args[0] ?? panic('usage: wave16_suite.a tsconfig manifest [--count]');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
let findings = 0;
for(const path of paths) {
    const source = readTextFile(path);
    if(source.kind === 'Error') {
        panic(source.message);
    }
    const jsx = new JsxParser(source.text, path);
    const root = jsx.file();
    // Shared analyses consume the node arena, not the parser's token state.
    // Retain a nominal Parser instance rather than asserting structural ancestry.
    const parser = new Parser(source.text, path);
    for(const node of jsx.nodes) {
        parser.nodes.push(node);
    }
    for(const index of jsx.roots) {
        parser.roots.push(index);
    }
    const scanner = new Scanner(source.text);
    const offsets = byteOffsets(source.text);
    const unary = new UnaryMinus(program, path, parser, scanner, offsets);
    const linter = new Rules(program, path, parser, scanner, offsets, unary);
    for(let at = 0; at < parser.nodes.length; at++) {
        linter.parents.push(-1);
    }
    linter.links(root, -1);
    const context = new Context(linter);
    const fragments = new JsxFragments(context, args.includes('--element'));
    const constructed = new JsxNoConstructedContextValues(context);
    const undef = new JsxNoUndef(context, args.includes('--allow-globals'));
    const count = context.nodes.length;
    for(let at = 0; at < count; at++) {
        const node = context.node(at);
        switch(node.kind) {
            case 286: // JsxSelfClosingElement
                fragments.visit(node);
                undef.visit(node);
                if(args.includes('--context')) constructed.visit(node);
                break;
            case 287: // JsxOpeningElement
                undef.visit(node);
                if(args.includes('--context')) constructed.visit(node);
                break;
            case 285: // JsxElement
            case 289: // JsxFragment
                fragments.visit(node);
                break;
        }
    }

    for(const finding of linter.findings) {
        finding.sortKey = finding.written();
    }
    linter.findings.sort((left, right) => (left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0));
    findings += linter.findings.length;
    if(!args.includes('--count')) {
        console.log(`file\t${written(path)}`);
        for(const finding of linter.findings) {
            console.log(finding.written());
        }
    }
}
console.log(`findings ${findings}`);
tsgoRelease(program);
