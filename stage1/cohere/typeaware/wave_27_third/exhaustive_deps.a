                    if(!['ArrowFunction', 'FunctionExpression'].includes(this.kind(callback))) {
                        this.report(array, 'exhaustiveDepsMissing');
                        continue;
                    }
                }
                else {
                    this.report(index, 'exhaustiveDepsUnknownDependencies');
                    continue;
                }
            }
            else if(!['ArrowFunction', 'FunctionExpression'].includes(this.kind(callback))) {
                this.report(index, 'exhaustiveDepsUnknownDependencies');
                continue;
            }
            this.callback(callback, array, index, component, effect);
        }
    }
}
