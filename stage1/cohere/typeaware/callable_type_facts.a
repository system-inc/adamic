import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export class CallablePart {
    readonly calls: number;
    readonly constructs: number;
    readonly returnFlags: readonly number[];
    readonly partFlags: readonly number[];
    readonly propertyPresence: readonly boolean[];
    constructor(calls: number, constructs: number, returns: readonly number[], parts: readonly number[], properties: readonly boolean[]) {
        this.calls = calls; this.constructs = constructs; this.returnFlags = returns; this.partFlags = parts; this.propertyPresence = properties;
    }
}
export class CallableTypeFacts {
    readonly parts: readonly CallablePart[];
    constructor(rules: Rules, index: number) {
        const frames = new Frames(rules.ask(index, 'callable-type-facts')); header(frames, 'callable-type-facts');
        const count = frames.natural(); const parts: CallablePart[] = [];
        for(let at = 0; at < count; at++) {
            const calls = frames.natural(); const constructs = frames.natural(); const returns: number[] = []; const flags: number[] = []; const properties: boolean[] = [];
            for(let call = 0; call < calls; call++) {
                returns.push(frames.natural()); const length = frames.natural();
                for(let part = 0; part < length; part++) { flags.push(frames.natural()); properties.push(frames.yes()); properties.push(frames.yes()); properties.push(frames.yes()); }
            }
            parts.push(new CallablePart(calls, constructs, returns, flags, properties));
        }
        frames.end(); this.parts = parts;
    }
    holdsFunction(): boolean {
        for(const part of this.parts) {
            if(part.calls === 0 || part.constructs > 0 || part.returnFlags.some((flags) => (flags & 3) !== 0)) { return false; }
            for(let at = 0; at < part.partFlags.length; at++) {
                if(((part.partFlags[at] ?? 0) & 269484032) !== 0 &&
                    part.propertyPresence[at * 3] === true && part.propertyPresence[at * 3 + 1] === true && part.propertyPresence[at * 3 + 2] === true) { return false; }
            }
        }
        return true;
    }
}
