import type { Rules } from './rules.ts';
import { panic } from 'adamic';

// Production defaults contain no denied names. Options require a separate port;
// refuse them instead of silently using the defaults for configured input.
export class IdDenylist {
    readonly rules: Rules;
    constructor(rules: Rules) { this.rules = rules; }
    run(names: readonly string[] = []): void {
        if(names.length !== 0) { panic('id-denylist configured options are not yet ported'); }
        if(names.length === 0) { return; }
    }
}
