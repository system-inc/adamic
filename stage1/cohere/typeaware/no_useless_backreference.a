        if(this.uv) { for(let at = 0; at < this.pattern.length;) { const char = this.pattern[at]; if(char === '\\') { at = this.skip(at); if(at < 0) { return false; } } else if(char === '[') { at = this.classEnd(at); if(at < 0) { return false; } } else if(char === '{' && !this.quantifier(at)) { return false; } else { at++; } } } return true;
