    quantifier(start: number): boolean { const p = this.pattern; let at = start + 1; let digits = 0; while(at < p.length && this.digit(p[at] ?? '')) { at++; digits++; } if(digits === 0) { return false; } if(p[at] === ',') { at++; while(at < p.length && this.digit(p[at] ?? '')) { at++; } } return p[at] === '}'; }
