import { panic } from 'adamic';
import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
export class BackreferenceNode {
    readonly kind: number;
    readonly negative: boolean;
    constructor(kind: number, negative: boolean) {
        this.kind = kind;
        this.negative = negative;
    }
}
export class BackreferencePart {
    readonly name: string;
    readonly number: number;
    readonly start: number;
    end: number;
    readonly path: readonly number[];
    constructor(name: string, number: number, start: number, end: number, path: readonly number[]) {
        this.name = name;
        this.number = number;
        this.start = start;
        this.end = end;
        this.path = path;
    }
}
export class BackreferenceStructure {
    readonly nodes: BackreferenceNode[] = [];
    readonly groups: BackreferencePart[] = [];
    readonly references: BackreferencePart[] = [];
    readonly stack: number[] = [];
    readonly opened: number[] = [];
    push(kind: number, negative: boolean): void {
        this.nodes.push(new BackreferenceNode(kind, negative));
        this.stack.push(this.nodes.length - 1);
    }
    scan(pattern: string): boolean {
        this.push(2, false);
        this.push(0, false);
        for(let at = 0; at < pattern.length;) {
            const text = pattern[at] ?? '';
            if(text === '[') {
                panic('no-useless-backreference requires shared RegexSyntax.ClassEnd');
            }
            if(text === String.fromCharCode(92)) {
                if(at + 1 >= pattern.length) {
                    return false;
                }
                const next = pattern[at + 1] ?? '';
                if(next >= '1' && next <= '9') {
                    let end = at + 1;
                    let value = 0;
                    while(end < pattern.length && (pattern[end] ?? '') >= '0' && (pattern[end] ?? '') <= '9') {
                        value = value * 10 + (pattern.charCodeAt(end) - 48);
                        end++;
                    }
                    this.references.push(new BackreferencePart('', value, at, end, this.stack.slice()));
                    at = end;
                    continue;
                }
                if(next === 'k' && pattern[at + 2] === '<') {
                    const end = pattern.indexOf('>', at + 3);
                    if(end >= 0) {
                        this.references.push(
                            new BackreferencePart(pattern.slice(at + 3, end), 0, at, end + 1, this.stack.slice()),
                        );
                        at = end + 1;
                        continue;
                    }
                }
                panic('no-useless-backreference requires shared RegexSyntax.SkipPatternEscape');
            }
            if(text === '(') {
                let kind = 1;
                let negative = false;
                let name = '';
                let next = at + 1;
                if(pattern[next] === '?') {
                    const prefix = pattern.slice(next + 1, next + 3);
                    if(pattern[next + 1] === ':') {
                        kind = 2;
                        next += 2;
                    }
                    else if(pattern[next + 1] === '=') {
                        kind = 3;
                        next += 2;
                    }
                    else if(pattern[next + 1] === '!') {
                        kind = 3;
                        negative = true;
                        next += 2;
                    }
                    else if(prefix === '<=') {
                        kind = 4;
                        next += 3;
                    }
                    else if(prefix === '<!') {
                        kind = 4;
                        negative = true;
                        next += 3;
                    }
                    else if(pattern[next + 1] === '<') {
                        const close = pattern.indexOf('>', next + 2);
                        if(close < 0) {
                            kind = 2;
                            next += 2;
                        }
                        else {
                            name = pattern.slice(next + 2, close);
                            next = close + 1;
                        }
                    }
                    else {
                        kind = 2;
                        next += 2;
                    }
                }
                this.push(kind, negative);
                if(kind === 1) {
                    this.groups.push(new BackreferencePart(name, 0, at, 0, this.stack.slice()));
                    this.opened.push(this.groups.length - 1);
                }
                else {
                    this.opened.push(-1);
                }
                this.push(0, false);
                at = next;
                continue;
            }
            if(text === ')') {
                if(this.opened.length === 0) {
                    return false;
                }
                this.stack.pop();
                const group = this.opened.pop() ?? -1;
                if(group >= 0) {
                    const part = this.groups[group];
                    if(part !== undefined) {
                        part.end = at + 1;
                    }
                }
                this.stack.pop();
                at++;
                continue;
            }
            if(text === '|') {
                this.stack.pop();
                this.push(0, false);
            }
            at++;
        }
        return this.opened.length === 0;
    }
    classify(reference: BackreferencePart, group: BackreferencePart): string {
        if(group.start <= reference.start && reference.end <= group.end) {
            return 'nested';
        }
        let common = 1;
        while(
            common < reference.path.length &&
            common < group.path.length &&
            reference.path[common] === group.path[common]
        ) {
            common++;
        }
        const cut = group.path.slice(common);
        let backwards = false;
        for(let at = common - 1; at >= 0; at--) {
            const kind = this.nodes[reference.path[at] ?? -1]?.kind ?? -1;
            if(kind === 3 || kind === 4) {
                backwards = kind === 4;
                break;
            }
        }
        if(cut.length > 0 && this.nodes[cut[0] ?? -1]?.kind === 0) {
            return 'disjunctive';
        }
        if(!backwards && reference.end <= group.start) {
            return 'forward';
        }
        if(backwards && group.end <= reference.start) {
            return 'backward';
        }
        for(const at of cut) {
            const node = this.nodes[at];
            if(node !== undefined && node.negative && (node.kind === 3 || node.kind === 4)) {
                return 'intoNegativeLookaround';
            }
        }
        return '';
    }
    wellFormed(pattern: string, flags: string): boolean {
        const unicode = flags.includes('u') || flags.includes('v');
        const named = this.groups.some((group) => group.name !== '');
        for(const reference of this.references) {
            if(reference.name !== '') {
                if(!this.groups.some((group) => group.name === reference.name) && (named || unicode)) {
                    return false;
                }
            }
            else if(unicode && reference.number > this.groups.length) {
                return false;
            }
        }
        if(unicode) {
            for(let at = 0; at < pattern.length; at++) {
                if(pattern[at] !== '{') {
                    continue;
                }
                let cursor = at + 1;
                while(cursor < pattern.length && (pattern[cursor] ?? '') >= '0' && (pattern[cursor] ?? '') <= '9') {
                    cursor++;
                }
                if(cursor === at + 1) {
                    return false;
                }
                if(pattern[cursor] === ',') {
                    cursor++;
                    while(cursor < pattern.length && (pattern[cursor] ?? '') >= '0' && (pattern[cursor] ?? '') <= '9') {
                        cursor++;
                    }
                }
                if(pattern[cursor] !== '}') {
                    return false;
                }
            }
        }
        return true;
    }
}
export class NoUselessBackreference {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    reason(id: string): string {
        if(id === 'nested') {
            return 'encloses the reference and so has captured nothing yet when it is reached';
        }
        if(id === 'disjunctive') {
            return 'sits in a different branch of the same disjunction, and only one branch ever runs';
        }
        if(id === 'forward') {
            return 'appears later in the pattern, and matching runs left to right';
        }
        if(id === 'backward') {
            return 'appears earlier in a lookbehind, which matches right to left';
        }
        return 'sits in a negative lookaround, so it only runs on a path that then fails';
    }
    pattern(index: number, pattern: string, flags: string): void {
        const structure = new BackreferenceStructure();
        if(!structure.scan(pattern) || !structure.wellFormed(pattern, flags)) {
            return;
        }
        for(const reference of structure.references) {
            const groups =
                reference.name !== ''
                    ? structure.groups.filter((group) => group.name === reference.name)
                    : structure.groups.filter((_group, at) => at === reference.number - 1);
            if(groups.length === 0) {
                continue;
            }
            const ids = groups.map((group) => structure.classify(reference, group));
            if(ids.includes('')) {
                continue;
            }
            const own = groups.filter((_group, at) => (ids[at] ?? '') !== 'disjunctive');
            const chosen = own.length > 0 ? own : groups;
            const group = chosen[0];
            if(group === undefined) {
                continue;
            }
            const id = structure.classify(reference, group);
            const count = chosen.length - 1;
            const also =
                count === 1
                    ? ' (and so does one other group of that name)'
                    : count > 1
                      ? ` (and so do ${count} other groups of that name)`
                      : '';
            const message = `The backreference ${pattern.slice(reference.start, reference.end)} can never match, because ${pattern.slice(group.start, group.end)} ${this.reason(id)}${also}. It matches the empty string instead of failing, so the pattern quietly matches more than it looks like it does.`;
            const node = this.rules.parser.node(index);
            this.rules.findings.push(
                new Diagnostic(
                    'no-useless-backreference',
                    id,
                    message,
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    '',
                ),
            );
        }
    }
    run(): void {
        if(this.rules.scanner.text.includes('RegExp')) {
            panic('no-useless-backreference requires shared ReferenceTracker and ConstantStringIn');
        }
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at);
            if(node.kind !== 'RegularExpressionLiteral') {
                continue;
            }
            const text = this.rules.text(node);
            const slash = text.lastIndexOf('/');
            const pattern = text.slice(1, slash);
            if(pattern !== '') {
                this.pattern(at, pattern, text.slice(slash + 1));
            }
        }
    }
}
