import { panic, readTextFile, tsgoInspect } from 'adamic';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { Rules } from '../rules.ts';
import { UnaryMinus, byteOffsets } from '../unary_minus.ts';
import { Frames, header } from '../frames.ts';
import { Bindings } from '../bindings.ts';

export class SourceFiles {
    readonly program: number; readonly files = new Map<string, Bindings>();
    constructor(program: number) { this.program = program; }
    file(path: string): Bindings {
        const cached = this.files.get(path); if(cached !== undefined) { return cached; }
        const source = readTextFile(path); if(source.kind === 'Error') { panic(source.message); }
        const parser = new Parser(source.text, path); const scanner = new Scanner(source.text); const offsets = byteOffsets(source.text);
        const unary = new UnaryMinus(this.program, path, parser, scanner, offsets); const rules = new Rules(this.program, path, parser, scanner, offsets, unary);
        const metadata = new Frames(tsgoInspect(this.program, path, 0, offsets[source.text.length] ?? 0, 'SourceFile', 'scope-metadata')); header(metadata, 'scope-metadata');
        parser.awaitContext = metadata.yes(); const scopes = metadata.natural();
        for(let at = 0; at < scopes; at++) { metadata.field(); metadata.natural(); metadata.natural(); } metadata.end();
        const root = parser.file(); for(let at = 0; at < parser.nodes.length; at++) { rules.parents.push(-1); } rules.links(root, -1);
        const result = new Bindings(rules); this.files.set(path, result); return result;
    }
}
