import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { byteOffsets } from '../unary_minus.ts';
import { Driver } from './driver.a';
import { numericSyntaxBindings } from './numeric_syntax_bindings.a';

const args = programArguments(); const config = args[0] ?? panic('missing tsconfig');
const manifest = readTextFile(args[1] ?? panic('missing manifest')); if(manifest.kind === 'Error') { panic(manifest.message); }
const paths = manifest.text.split('\n').filter((path) => path !== ''); const program = tsgoProgram(config, paths); let findings = 0;
for(const path of paths) {
    const source = readTextFile(path); if(source.kind === 'Error') { panic(source.message); }
    const offsets = byteOffsets(source.text);
    const context = numericSyntaxBindings(program, path, offsets[source.text.length] ?? panic('source byte length missing'));
    const driver = new Driver(context); driver.visit(context.node(1));
    for(const finding of context.findings) { finding.sortKey = finding.written(); }
    context.findings.sort((left, right) => left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0);
    findings += context.findings.length;
    if(!args.includes('--count')) { console.log(`file\t${written(path)}`); for(const finding of context.findings) { console.log(finding.written()); } }
}
console.log(`findings ${findings}`); tsgoRelease(program);
