import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export class HandlerParameter {
    readonly count: number;
    readonly present: boolean;
    readonly flags: number;
    readonly rest: boolean;
    readonly arrayOrTuple: boolean;
    readonly arguments: number;
    readonly firstFlags: number;
    constructor(frames: Frames) {
        this.count = frames.natural(); this.present = frames.yes(); this.flags = frames.natural();
        this.rest = frames.yes(); this.arrayOrTuple = frames.yes(); this.arguments = frames.natural(); this.firstFlags = frames.natural();
    }
}
export function handlerParameterTypes(rules: Rules, index: number): readonly HandlerParameter[] {
    const frames = new Frames(rules.ask(index, 'handler-parameter-types'));
    header(frames, 'handler-parameter-types');
    const count = frames.natural(); const result: HandlerParameter[] = [];
    for(let at = 0; at < count; at++) { result.push(new HandlerParameter(frames)); }
    frames.end(); return result;
}
