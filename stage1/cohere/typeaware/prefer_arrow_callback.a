import type { Rules } from './rules.ts';
import { Bindings } from './bindings.ts';
import { CallbackSymbol } from './callback_symbol.a';
import { Diagnostic } from './diagnostic.ts';
import { Repair } from './repair.ts';
// Numeric SyntaxKind values from the pinned TypeScript parser: FunctionExpression.
export const listenerKinds: readonly number[] = [218];

export class ArrowCallbackFrame {
    usesThis = false;
    usesSuper = false;
    usesNewTarget = false;
    usesArguments = false;
}
export class ArrowCallbackInfo {
    callback = false;
    lexical = false;
    member = -1;
    call = -1;
}
export class PreferArrowCallback {
    readonly rules: Rules;
    readonly bindings: Bindings;
    readonly allowNamed: boolean;
    readonly allowUnbound: boolean;
    constructor(rules: Rules, allowNamed = false, allowUnbound = true) {
        this.rules = rules;
        this.bindings = new Bindings(rules);
        this.allowNamed = allowNamed;
        this.allowUnbound = allowUnbound;
    }
    callback(index: number): ArrowCallbackInfo {
        const info = new ArrowCallbackInfo();
        let current = index;
        let bound = false;
        while(current >= 0) {
            const parent = this.rules.parents[current] ?? -1;
            if(parent < 0) {
                return info;
            }
            const node = this.rules.parser.node(parent);
            if(['ConditionalExpression', 'ParenthesizedExpression'].includes(node.kind)) {
                current = parent;
                continue;
            }
            if(node.kind === 'BinaryExpression') {
                if(
                    !['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken'].includes(
                        this.rules.parser.node(node.children[1] ?? -1).kind,
                    )
                ) {
                    return info;
                }
                current = parent;
                continue;
            }
            if(node.kind === 'PropertyAccessExpression') {
                const name = this.rules.parser.node(node.children[node.children.length - 1] ?? -1);
                if(node.children[0] !== current || name.kind !== 'Identifier' || name.text !== 'bind') {
                    return info;
                }
                let callee = parent;
                while(
                    (this.rules.parents[callee] ?? -1) >= 0 &&
                    this.rules.parser.node(this.rules.parents[callee] ?? -1).kind === 'ParenthesizedExpression'
                ) {
                    callee = this.rules.parents[callee] ?? -1;
                }
                const call = this.rules.parents[callee] ?? -1;
                if(call < 0) {
                    return info;
                }
                const application = this.rules.parser.node(call);
                if(application.kind !== 'CallExpression' || application.children[0] !== callee) {
                    return info;
                }
                if(!bound) {
                    bound = true;
                    const args = application.children.slice(application.children.length - application.list);
                    info.lexical = args.length === 1 && this.rules.parser.node(args[0] ?? -1).kind === 'ThisKeyword';
                    info.member = parent;
                    info.call = call;
                }
                current = call;
                continue;
            }
            if(['CallExpression', 'NewExpression'].includes(node.kind)) {
                info.callback = node.children[0] !== current;
                return info;
            }
            return info;
        }
        return info;
    }
    selfReference(index: number): boolean {
        const name = this.bindings.shape.name(index);
        if(name < 0) {
            return false;
        }
        const declared = new CallbackSymbol(this.rules, name).identity;
        if(declared === 0) {
            return false;
        }
        const node = this.rules.parser.node(index);
        const spelling = this.rules.parser.node(name).text;
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const inner = this.rules.parser.node(at);
            if(
                at !== name &&
                inner.kind === 'Identifier' &&
                inner.text === spelling &&
                inner.pos >= node.pos &&
                inner.end <= node.end &&
                new CallbackSymbol(this.rules, at).identity === declared
            ) {
                return true;
            }
        }
        return false;
    }
    declarationName(index: number): boolean {
        const parent = this.rules.parents[index] ?? -1;
        if(parent < 0) {
            return false;
        }
        return (
            [
                'VariableDeclaration',
                'Parameter',
                'FunctionDeclaration',
                'FunctionExpression',
                'ClassDeclaration',
                'BindingElement',
            ].includes(this.rules.parser.node(parent).kind) && this.bindings.shape.name(parent) === index
        );
    }
    walk(index: number, owner: ArrowCallbackFrame): void {
        const node = this.rules.parser.node(index);
        if(node.kind === 'ThisKeyword') {
            owner.usesThis = true;
        }
        if(node.kind === 'SuperKeyword') {
            owner.usesSuper = true;
        }
        if(node.kind === 'MetaProperty' && this.rules.text(node).startsWith('new')) {
            owner.usesNewTarget = true;
        }
        if(
            node.kind === 'Identifier' &&
            node.text === 'arguments' &&
            !this.declarationName(index) &&
            new CallbackSymbol(this.rules, index).declarations === 0
        ) {
            owner.usesArguments = true;
        }
        const opens = [
            'FunctionDeclaration',
            'FunctionExpression',
            'MethodDeclaration',
            'GetAccessor',
            'SetAccessor',
            'Constructor',
            'ClassStaticBlockDeclaration',
        ].includes(node.kind);
        const next = opens ? new ArrowCallbackFrame() : owner;
        for(const child of node.children) {
            this.walk(child, next);
        }
        if(opens && node.kind === 'FunctionExpression') {
            this.judge(index, next);
        }
    }
    judge(index: number, frame: ArrowCallbackFrame): void {
        const node = this.rules.parser.node(index);
        if(this.allowNamed && this.bindings.shape.name(index) >= 0) {
            return;
        }
        if(
            node.children.some((child) => this.rules.parser.node(child).kind === 'AsteriskToken') ||
            this.selfReference(index) ||
            frame.usesArguments
        ) {
            return;
        }
        const info = this.callback(index);
        if(
            !info.callback ||
            (this.allowUnbound && frame.usesThis && !info.lexical) ||
            frame.usesSuper ||
            frame.usesNewTarget
        ) {
            return;
        }
        const finding = new Diagnostic(
            'prefer-arrow-callback',
            'preferArrowCallback',
            'An arrow function inherits `this` from where it is written instead of from how it is called, which is what a callback almost always wants. Writing it as a function expression leaves the binding up to the caller.',
            this.rules.byte(this.rules.start(node)),
            this.rules.byte(node.end),
            '',
        );
        for(const repair of this.fix(index, frame, info)) {
            finding.repairs.push(repair);
        }
        this.rules.findings.push(finding);
    }
    comment(start: number, end: number): boolean {
        const text = this.rules.scanner.text;
        if(start < 0 || end > text.length || start >= end) {
            return false;
        }
        for(let at = start; at < end - 1; at++) {
            const quote = text[at] ?? '';
            if(["'", '"', '`'].includes(quote)) {
                at++;
                while(at < end && text[at] !== quote) {
                    if(text.charCodeAt(at) === 92) {
                        at++;
                    }
                    at++;
                }
            }
            else if(quote === '/' && (text[at + 1] === '/' || text[at + 1] === '*')) {
                return true;
            }
        }
        return false;
    }
    repair(start: number, end: number, text: string): Repair {
        return new Repair(this.rules.byte(start), this.rules.byte(end), text);
    }
    wrapped(index: number): boolean {
        const node = this.rules.parser.node(index);
        const parent = this.rules.parents[index] ?? -1;
        if(parent >= 0 && this.rules.parser.node(parent).kind === 'ParenthesizedExpression') {
            return true;
        }
        const text = this.rules.scanner.text;
        let before = node.pos - 1;
        while(before >= 0 && [' ', '\t', '\n', '\r'].includes(text[before] ?? '')) {
            before--;
        }
        let after = node.end;
        while(after < text.length && [' ', '\t', '\n', '\r'].includes(text[after] ?? '')) {
            after++;
        }
        return before >= 0 && after < text.length && text[before] === '(' && text[after] === ')';
    }
    fix(index: number, frame: ArrowCallbackFrame, info: ArrowCallbackInfo): Repair[] {
        const empty: Repair[] = [];
        if(!info.lexical && frame.usesThis) {
            return empty;
        }
        const node = this.rules.parser.node(index);
        const parameters = node.children.filter((child) => this.rules.parser.node(child).kind === 'Parameter');
        const seen: string[] = [];
        let identifiers = true;
        let duplicate = false;
        for(const parameter of parameters) {
            const name = this.bindings.shape.name(parameter);
            if(name < 0 || this.rules.parser.node(name).kind !== 'Identifier') {
                identifiers = false;
                break;
            }
            const text = this.rules.parser.node(name).text;
            if(seen.includes(text)) {
                duplicate = true;
            }
            seen.push(text);
        }
        if(identifiers && duplicate) {
            return empty;
        }
        const first = parameters[0] ?? -1;
        if(first >= 0 && this.rules.parser.node(this.bindings.shape.name(first)).text === 'this') {
            return empty;
        }
        const text = this.rules.scanner.text;
        const keyword = text.indexOf('function', node.pos);
        const body = node.children[node.children.length - 1] ?? -1;
        if(keyword < 0 || keyword + 8 > node.end || body < 0) {
            return empty;
        }
        const block = this.rules.parser.node(body);
        const paren = text.indexOf('(', node.pos);
        if(paren < keyword + 8 || paren >= block.pos) {
            return empty;
        }
        const async = node.children.some((child) => this.rules.parser.node(child).kind === 'AsyncKeyword');
        if(async && text.slice(keyword + 8, paren).includes('\n')) {
            return empty;
        }
        const repairs: Repair[] = [];
        if(info.lexical) {
            if(
                info.member < 0 ||
                info.call < 0 ||
                this.rules.parents[index] !== info.member ||
                this.rules.parents[info.member] !== info.call
            ) {
                return empty;
            }
            const member = this.rules.parser.node(info.member);
            const start = this.rules.parser.node(member.children[0] ?? -1).end;
            const end = this.rules.parser.node(info.call).end;
            if(end <= start || this.comment(start, end)) {
                return empty;
            }
            repairs.push(this.repair(start, end, ''));
        }
        if(this.comment(keyword + 8, paren)) {
            repairs.push(this.repair(keyword, keyword + 8, ''));
            const name = this.bindings.shape.name(index);
            if(name >= 0) {
                const named = this.rules.parser.node(name);
                repairs.push(this.repair(this.rules.start(named), named.end, ''));
            }
        }
        else {
            repairs.push(this.repair(keyword, paren, ''));
        }
        let insertion = block.pos;
        while(insertion > 0 && [' ', '\t', '\n', '\r'].includes(text[insertion - 1] ?? '')) {
            insertion--;
        }
        repairs.push(this.repair(insertion, insertion, ' =>'));
        const replaced = info.lexical && info.call >= 0 ? info.call : index;
        const parent = this.rules.parents[replaced] ?? -1;
        const kind = parent >= 0 ? this.rules.parser.node(parent).kind : '';
        if(
            parent >= 0 &&
            !['CallExpression', 'NewExpression', 'ConditionalExpression'].includes(kind) &&
            !this.wrapped(replaced) &&
            !this.wrapped(index)
        ) {
            const span = this.rules.parser.node(replaced);
            repairs.push(this.repair(this.rules.start(span), this.rules.start(span), '('));
            repairs.push(this.repair(span.end, span.end, ')'));
        }
        return repairs;
    }
    run(): void {
        const root = this.rules.parser.nodes.length - 1;
        this.walk(root, new ArrowCallbackFrame());
    }
}
