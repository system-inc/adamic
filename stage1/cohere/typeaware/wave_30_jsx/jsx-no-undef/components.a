// Name classification from Go cohere's isComponentName. Symbol scope is not supplied here.
export class ComponentNameNode {
    readonly text: string;
    constructor(text: string) { this.text = text; }
}
export function componentName(node: ComponentNameNode): boolean {
    const name = node.text;
    if(name.length === 0 || name.includes('-')) { return false; }
    const first = name.charCodeAt(0);
    return first >= 128 || first < 97 || first > 122;
}
