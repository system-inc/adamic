            c.rules().findings.push(new Diagnostic('correctness-no-uncleared-race-timeout', 'unclearedRaceTimeout', "This `setTimeout` arms the losing side of a `Promise.race`, and its handle is thrown away, so nothing can ever clear it. When the work wins the race, the timer stays armed for its whole duration: in Node it holds the process open (a batch that finished its last item sits until the timeout elapses), and its callback still runs, rejecting a promise nobody is waiting on. Keep the handle (`timer = setTimeout(...)`) and `clearTimeout(timer)` in a `finally` around the race.", c.rules().byte(c.rules().start(node)), c.rules().byte(node.end), 'nexus/'));
        }
        for(const child of c.rules().parser.node(index).children) { this.visit(child, executor); }
    }
    run(): void {
        const c = this.context;
        for(let index = 0; index < c.rules().parser.nodes.length; index++) {
            if(c.node(index) !== 'CallExpression') { continue; }
            const callee = c.skip(c.child(index, 0)); if(c.node(callee) !== 'PropertyAccessExpression') { continue; }
            const name = c.last(callee); if(c.node(name) !== 'Identifier' || c.rules().parser.node(name).text !== 'race') { continue; }
            const declarations = c.symbol(name).direct.declarations;
            if(declarations.length === 0 || !declarations.every((d) => d.library && d.kinds[1] === 'InterfaceDeclaration' && d.names[1] === 'PromiseConstructor')) { continue; }
            const array = c.skip(c.child(index, c.rules().parser.node(index).children.length - c.rules().parser.node(index).list));
            if(array < 0 || c.node(array) !== 'ArrayLiteralExpression') { continue; }
            for(const element of c.rules().parser.node(array).children) {
                const promise = this.promise(element); if(promise < 0) { continue; }
                const node = c.rules().parser.node(promise); if(node.list === 0) { continue; }
                const executor = c.skip(node.children[node.children.length - node.list] ?? -1);
                if(!['ArrowFunction', 'FunctionExpression'].includes(c.node(executor))) { continue; }
                const body = c.last(executor); if(body >= 0) { this.visit(body, executor); }
            }
        }
    }
}
