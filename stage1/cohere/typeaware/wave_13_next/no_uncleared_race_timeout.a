        const constructor = c.skip(c.child(at, 0));
        if(c.node(constructor) !== 'Identifier' || c.rules().parser.node(constructor).text !== 'Promise') { return -1; }
        const declarations = c.symbol(constructor).direct.declarations;
        // IsSymbolFromDefaultLibrary asks whether at least one declaration is a
