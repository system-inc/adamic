import { Frames, header } from '../frames.ts';
import { Diagnostic } from '../diagnostic.ts';
import type { OutputContext } from './output_context.a';
export class NoUnclearedRaceTimeout {
    // Pinned parser SyntaxKind values for the incoming shared driver.
    readonly listenerKinds: number[] = [214];
    readonly context: OutputContext;
    constructor(context: OutputContext) { this.context = context; }
    promise(index: number): number {
        const c = this.context; let at = c.skip(index);
        if(c.node(at) === 'Identifier') {
            const symbol = c.symbol(at).direct; if(symbol.declarations.length !== 1) { return -1; }
            const declaration = symbol.declarations[0]; if(declaration === undefined || declaration.path !== c.rules().path || declaration.kinds[0] !== 'VariableDeclaration') { return -1; }
            const declared = c.locate(declaration); const list = c.parent(declared);
            if(list < 0 || c.node(list) !== 'VariableDeclarationList' || !['2', '6'].includes(c.rules().parser.node(list).semantic)) { return -1; }
            at = c.skip(c.bindings.shape.initializer(declared));
        }
