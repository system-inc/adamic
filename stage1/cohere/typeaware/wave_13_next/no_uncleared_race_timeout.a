    }
    timer(index: number): boolean {
        const c = this.context; const callee = c.skip(c.child(index, 0)); let name = -1;
        if(c.node(callee) === 'Identifier') { name = callee; }
        else if(c.node(callee) === 'PropertyAccessExpression') {
            const receiver = c.skip(c.child(callee, 0));
            if(c.node(receiver) !== 'Identifier' || !['globalThis', 'window'].includes(c.rules().parser.node(receiver).text)) { return false; }
            name = c.last(callee);
        }
        if(name < 0 || c.node(name) !== 'Identifier' || c.rules().parser.node(name).text !== 'setTimeout') { return false; }
        const declarations = c.symbol(name).direct.declarations;
        return declarations.length > 0 && declarations.every((d) => d.declarationFile && ((d.kinds[1] === 'SourceFile' && !d.external) || (d.kinds[1] === 'ModuleBlock' && (d.globals[2] ?? false)) || (d.kinds[1] === 'InterfaceDeclaration' && d.names[1] === 'WindowOrWorkerGlobalScope' && d.library)));
    }
    plainTarget(index: number): boolean {
        const c = this.context; const outer = c.outer(index); const parent = c.parent(outer);
        return parent >= 0 && c.node(parent) === 'BinaryExpression' && c.child(parent, 0) === outer && c.node(c.child(parent, 1)) === 'EqualsToken';
    }
    neverRead(index: number): boolean {
        const c = this.context; const symbol = c.symbol(index).direct;
        if(symbol.declarations.length !== 1) { return false; }
        const declaration = symbol.declarations[0]; if(declaration === undefined || declaration.kinds[0] !== 'VariableDeclaration' || declaration.path !== c.rules().path) { return false; }
        const name = c.bindings.shape.name(c.locate(declaration)); const text = c.rules().parser.node(name).text;
        for(let at = 0; at < c.rules().parser.nodes.length; at++) {
            const node = c.rules().parser.node(at);
            if(node.kind !== 'Identifier' || node.text !== text || at === name) { continue; }
            let id = c.symbol(at).direct.id;
            if(c.parent(at) >= 0 && c.node(c.parent(at)) === 'ShorthandPropertyAssignment') {
                const frames = new Frames(c.rules().ask(at, 'symbol-identities')); header(frames, 'symbol-identities');
                frames.natural(); frames.natural(); frames.yes(); frames.natural(); const shorthand = frames.natural(); frames.end(); if(shorthand !== 0) { id = shorthand; }
            }
            if(id === symbol.id && !this.plainTarget(at)) { return false; }
        }
        return true;
    }
    lost(executor: number, call: number): boolean {
        const c = this.context; const outer = c.outer(call); const parent = c.parent(outer); if(parent < 0) { return false; }
        if(['ExpressionStatement', 'VoidExpression'].includes(c.node(parent)) || parent === executor) { return true; }
        if(c.node(parent) === 'VariableDeclaration' && c.bindings.shape.initializer(parent) === outer) {
            const name = c.bindings.shape.name(parent); return name >= 0 && c.node(name) === 'Identifier' && this.neverRead(name);
        }
        if(c.node(parent) === 'BinaryExpression' && c.node(c.child(parent, 1)) === 'EqualsToken' && c.child(parent, 2) === outer) {
            const target = c.skip(c.child(parent, 0)); const assignment = c.outer(parent);
            return c.node(target) === 'Identifier' && c.parent(assignment) >= 0 && c.node(c.parent(assignment)) === 'ExpressionStatement' && this.neverRead(target);
        }
        return false;
    }
    visit(index: number, executor: number): void {
        const c = this.context;
        if(c.bindings.functionKind(c.node(index)) || ['ClassDeclaration', 'ClassExpression', 'MethodSignature', 'CallSignature', 'ConstructSignature', 'FunctionType', 'ConstructorType'].includes(c.node(index))) { return; }
        if(c.node(index) === 'CallExpression' && this.timer(index) && this.lost(executor, index)) {
