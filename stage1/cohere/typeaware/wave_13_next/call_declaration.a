import { Frames, header } from '../frames.ts';
import type { Rules } from '../rules.ts';
import { PlatformDeclaration } from './platform_symbol.a';
export class CallDeclaration {
    readonly declaration: PlatformDeclaration | undefined; readonly returnFlags: number;
