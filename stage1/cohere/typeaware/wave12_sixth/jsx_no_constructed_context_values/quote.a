import { panic } from 'adamic';
// Go %q keeps printable Unicode and escapes controls. Source names are Unicode scalar values.
export function quote(name: string): string {
    let result = '"';
    for(let at = 0; at < name.length; at++) {
        const code = name.codePointAt(at) ?? panic('missing quoted code point');
        const width = code > 65535 ? 2 : 1;
        const character = name.slice(at, at + width);
        if(code >= 55296 && code <= 57343) { panic('quoted name contains an unpaired surrogate'); }
        if(code === 34 || code === 92) { result += `\\${character}`; }
        else if(code === 7) { result += '\\a'; }
        else if(code === 8) { result += '\\b'; }
        else if(code === 9) { result += '\\t'; }
        else if(code === 10) { result += '\\n'; }
        else if(code === 11) { result += '\\v'; }
        else if(code === 12) { result += '\\f'; }
        else if(code === 13) { result += '\\r'; }
        else if(code >= 32 && code < 127 || /[\p{L}\p{M}\p{N}\p{P}\p{S}]/u.test(character)) { result += character; }
        else if(code < 128) { result += `\\x${code.toString(16).padStart(2, '0')}`; }
        else if(code <= 65535) { result += `\\u${code.toString(16).padStart(4, '0')}`; }
        else { result += `\\U${code.toString(16).padStart(8, '0')}`; }
        at += width - 1;
    }
    return `${result}"`;
}
