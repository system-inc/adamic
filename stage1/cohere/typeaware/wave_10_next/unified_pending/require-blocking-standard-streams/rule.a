import type { RuleContext } from '../../../../lint/context.ts';
import type { ParseNode } from '../../../../../typescript/parser/nodes.ts';
import { Rules } from './context.a';
import { RequireBlockingStandardStreams } from './require_blocking_standard_streams.a';
import { NoProcessExitAfterOutput } from './no_process_exit_after_output.a';
export class Rule {
    readonly context: Rules;
    readonly port: RequireBlockingStandardStreams;
    constructor(shared: RuleContext) { this.context = new Rules(shared); this.port = new RequireBlockingStandardStreams(this.context, new NoProcessExitAfterOutput(this.context)); }
    visit(node: ParseNode, index: number): void { this.port.run(); this.context.emit(); }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
