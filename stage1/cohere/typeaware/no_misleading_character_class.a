import { panic } from 'adamic';
import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
import { Suggestion } from './suggestion.ts';
import { NoInvalidRegexp } from './no_invalid_regexp.a';
import { SymbolContext } from './symbol_context.a';
import { Shadow } from './shadow.ts';

class ClassMember {
    readonly value: number;
    readonly start: number;
    readonly end: number;
    readonly brace: boolean;
    constructor(value: number, start: number, end: number, brace = false) {
        this.value = value;
        this.start = start;
        this.end = end;
        this.brace = brace;
    }
}
class ClassFinding {
    readonly id: string;
    readonly start: number;
    readonly end: number;
    constructor(id: string, start: number, end: number) {
        this.id = id;
        this.start = start;
        this.end = end;
    }
}
// Complete literal sequence judgments. Constructor reference tracking is an
// explicit NotYet path until the native reference shelf is available.
export class NoMisleadingCharacterClass {
    readonly rules: Rules;
    readonly found: ClassFinding[] = [];
    pattern = '';
    unicode = false;
    sets = false;
    valid = true;
    cursor = 0;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    constant(index: number, seen: readonly number[]): boolean {
        index = this.rules.skip(index);
        if(seen.includes(index)) {
            return false;
        }
        const node = this.rules.parser.node(index);
        if(['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(node.kind)) {
            return true;
        }
        const next = seen.slice();
        next.push(index);
        if(node.kind === 'BinaryExpression' && node.operator === 'PlusToken') {
            return this.constant(node.children[0] ?? -1, next) && this.constant(node.children[1] ?? -1, next);
        }
        if(node.kind !== 'Identifier') {
            return false;
        }
        const binding = new SymbolContext(this.rules, index);
        if(
            binding.kinds.length !== 1 ||
            binding.kinds[0] !== 'VariableDeclaration' ||
            binding.paths[0] !== this.rules.path ||
            ((binding.parentFlags[0] ?? 0) & 2) === 0
        ) {
            return false;
        }
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const declaration = this.rules.parser.node(at);
            if(
                declaration.kind === 'VariableDeclaration' &&
                this.rules.byte(declaration.pos) === binding.starts[0] &&
                this.rules.byte(declaration.end) === binding.ends[0]
            ) {
                const initializer = new Shadow(this.rules).initializer(at);
                return initializer >= 0 && this.constant(initializer, next);
            }
        }
        return false;
    }
    message(id: string): string {
        if(id === 'surrogatePair') {
            return 'This character class holds a surrogate pair spelled partly as a code point escape, so what looks like one astral character is two independent class members. The class matches either half on its own and never the character the author wrote, which is a match that silently succeeds on the wrong input rather than an error anybody sees.';
        }
        if(id === 'surrogatePairWithoutUFlag') {
            return 'This character class holds an astral character while the pattern has neither the u nor the v flag, so the engine reads it as its two UTF-16 halves and the class matches either half alone. `/[👍]/` matches the two lone surrogates that spell it and never the emoji; adding the flag is what makes the class mean the character it looks like.';
        }
        if(id === 'combiningClass') {
            return 'This character class holds a base character followed by a combining mark, which renders as one glyph and is two code points. The class matches the base or the mark separately, so `/[Á]/` accepts a bare `A` and accepts a stray accent, and rejects the accented letter it appears to name.';
        }
        if(id === 'emojiModifier') {
            return 'This character class holds an emoji followed by a skin tone modifier, which is one glyph made of two code points. The class matches the unmodified emoji or the bare modifier, so it accepts inputs nobody meant to accept and rejects the modified emoji itself.';
        }
        if(id === 'regionalIndicatorSymbol') {
            return 'This character class holds a pair of regional indicator symbols, which render as one flag and are two code points. The class matches either letter alone, so a flag class built this way accepts every other flag that shares a letter with it.';
        }
        if(id === 'zwj') {
            return 'This character class holds characters spliced by a zero width joiner, which renders as one glyph and is three or more code points. The class matches each piece on its own, so a family emoji written this way matches the individual people in it and never the family.';
        }
        return panic('unknown character-class finding');
    }
    hex(first: number, last: number): number {
        if(first === last || last > this.pattern.length) {
            return -1;
        }
        let value = 0;
        for(let at = first; at < last; at++) {
            const digit = '0123456789abcdef'.indexOf(this.pattern.slice(at, at + 1).toLowerCase());
            if(digit < 0) {
                return -1;
            }
            value = value * 16 + digit;
        }
        return value;
    }
    point(at: number): number {
        const high = this.pattern.charCodeAt(at);
        const low = this.pattern.charCodeAt(at + 1);
        return high >= 0xd800 && high <= 0xdbff && low >= 0xdc00 && low <= 0xdfff
            ? 0x10000 + (high - 0xd800) * 1024 + low - 0xdc00
            : high;
    }
    skipEscape(at: number): number {
        if(at + 1 >= this.pattern.length) {
            return -1;
        }
        const next = this.pattern.slice(at + 1, at + 2);
        if(next === 'x' && this.hex(at + 2, at + 4) >= 0) {
            return at + 4;
        }
        if(next === 'u' && this.hex(at + 2, at + 6) >= 0) {
            return at + 6;
        }
        if(this.unicode && 'upPq'.includes(next) && this.pattern[at + 2] === '{') {
            const end = this.pattern.indexOf('}', at + 3);
            if(end >= 0) {
                return end + 1;
            }
        }
        if(next === 'c' && at + 2 < this.pattern.length) {
            return at + 3;
        }
        return at + 1 + (this.point(at + 1) > 65535 ? 2 : 1);
    }
    member(): ClassMember {
        const start = this.cursor;
        if(this.pattern[start] !== '\\') {
            const value = this.point(start);
            this.cursor += value > 65535 ? 2 : 1;
            return new ClassMember(value, start, this.cursor);
        }
        if(start + 1 >= this.pattern.length) {
            this.valid = false;
            this.cursor++;
            return new ClassMember(-1, start, this.cursor);
        }
        const next = this.pattern.slice(start + 1, start + 2);
        this.cursor = start + 2;
        if('dDwWsS'.includes(next)) {
            return new ClassMember(-1, start, this.cursor);
        }
        if(next === 'B' && this.unicode) {
            this.valid = false;
        }
        if(this.unicode && 'pPqu'.includes(next) && this.pattern[start + 2] === '{') {
            const end = this.pattern.indexOf('}', start + 3);
            if(end < 0) {
                this.valid = false;
                return new ClassMember(-1, start, this.cursor);
            }
            this.cursor = end + 1;
            const value = next === 'u' ? this.hex(start + 3, end) : -1;
            if(next === 'u' && value < 0) {
                this.valid = false;
            }
            return new ClassMember(value, start, this.cursor, next === 'u');
        }
        if(next === 'x' || next === 'u') {
            const end = start + (next === 'x' ? 4 : 6);
            let value = this.hex(start + 2, end);
            if(value >= 0) {
                this.cursor = end;
                if(
                    this.unicode &&
                    next === 'u' &&
                    value >= 0xd800 &&
                    value <= 0xdbff &&
                    this.pattern.slice(end, end + 2) === '\\u'
                ) {
                    const low = this.hex(end + 2, end + 6);
                    if(low >= 0xdc00 && low <= 0xdfff) {
                        value = 0x10000 + (value - 0xd800) * 1024 + low - 0xdc00;
                        this.cursor = end + 6;
                    }
                }
                return new ClassMember(value, start, this.cursor);
            }
        }
        if(next === 'c') {
            if(start + 2 >= this.pattern.length) {
                this.valid = false;
            }
            else {
                this.cursor++;
                return new ClassMember(this.pattern.charCodeAt(start + 2) & 31, start, this.cursor);
            }
        }
        const escapes = 'bntrvf0';
        const values = [8, 10, 9, 13, 11, 12, 0];
        const named = escapes.indexOf(next);
        if(named >= 0) {
            return new ClassMember(values[named] ?? 0, start, this.cursor);
        }
        const value = this.point(start + 1);
        this.cursor = start + 1 + (value > 65535 ? 2 : 1);
        return new ClassMember(value, start, this.cursor);
    }
    append(sequence: ClassMember[], member: ClassMember): void {
        if(!this.unicode && member.value > 65535 && !member.brace) {
            sequence.push(new ClassMember(0xd800 + ((member.value - 0x10000) >> 10), member.start, member.start));
            sequence.push(new ClassMember(0xdc00 + ((member.value - 0x10000) & 1023), member.start, member.end));
        }
        else {
            sequence.push(member);
        }
    }
    combining(value: number): boolean {
        return (
            (value >= 0x300 && value <= 0x36f) ||
            (value >= 0x1ab0 && value <= 0x1aff) ||
            (value >= 0x1dc0 && value <= 0x1dff) ||
            (value >= 0x20d0 && value <= 0x20ff) ||
            (value >= 0xfe00 && value <= 0xfe0f) ||
            (value >= 0xfe20 && value <= 0xfe2f) ||
            (value >= 0xe0100 && value <= 0xe01ef)
        );
    }
    regional(value: number): boolean {
        return value >= 0x1f1e6 && value <= 0x1f1ff;
    }
    modifier(value: number): boolean {
        return value >= 0x1f3fb && value <= 0x1f3ff;
    }
    report(id: string, first: ClassMember, last: ClassMember): void {
        this.found.push(new ClassFinding(id, first.start, last.end));
    }
    sequence(members: readonly ClassMember[]): void {
        for(let at = 1; at < members.length; at++) {
            const previous = members[at - 1] ?? panic('missing class member');
            const current = members[at] ?? panic('missing class member');
            if(this.combining(current.value) && !this.combining(previous.value)) {
                this.report('combiningClass', previous, current);
            }
            if(this.regional(previous.value) && this.regional(current.value)) {
                this.report('regionalIndicatorSymbol', previous, current);
            }
            if(this.modifier(current.value) && !this.modifier(previous.value)) {
                this.report('emojiModifier', previous, current);
            }
        }
        let joinStart = -1;
        let joinEnd = -1;
        for(let at = 1; at + 1 < members.length; at++) {
            const left = members[at - 1] ?? panic('missing class member');
            const middle = members[at] ?? panic('missing class member');
            const right = members[at + 1] ?? panic('missing class member');
            if(middle.value !== 0x200d || left.value === 0x200d || right.value === 0x200d) {
                continue;
            }
            if(joinStart >= 0 && joinEnd === at - 1) {
                joinEnd = at + 1;
                continue;
            }
            if(joinStart >= 0) {
                this.report('zwj', members[joinStart] ?? left, members[joinEnd] ?? right);
            }
            joinStart = at - 1;
            joinEnd = at + 1;
        }
        if(joinStart >= 0) {
            this.report('zwj', members[joinStart] ?? panic('missing join'), members[joinEnd] ?? panic('missing join'));
        }
        for(let at = 1; at < members.length; at++) {
            const previous = members[at - 1] ?? panic('missing class member');
            const current = members[at] ?? panic('missing class member');
            if(
                previous.value >= 0xd800 &&
                previous.value <= 0xdbff &&
                current.value >= 0xdc00 &&
                current.value <= 0xdfff
            ) {
                this.report(
                    previous.brace || current.brace ? 'surrogatePair' : 'surrogatePairWithoutUFlag',
                    previous,
                    current,
                );
            }
        }
    }
    classEnd(start: number): number {
        let depth = 1;
        let at = start + 1;
        while(at < this.pattern.length) {
            const text = this.pattern[at] ?? '';
            if(text === '\\') {
                const next = this.skipEscape(at);
                if(next < 0) {
                    return -1;
                }
                at = next;
                continue;
            }
            if(text === '[' && this.sets) {
                depth++;
            }
            if(text === ']') {
                depth--;
                if(depth === 0) {
                    return at + 1;
                }
            }
            at++;
        }
        return -1;
    }
    characterClass(): void {
        const expectedEnd = this.classEnd(this.cursor);
        if(expectedEnd < 0) {
            this.valid = false;
            this.cursor = this.pattern.length;
            return;
        }
        this.cursor++;
        if(this.pattern[this.cursor] === '^') {
            this.cursor++;
        }
        const sequence: ClassMember[] = [];
        let pending: ClassMember | undefined;
        while(this.cursor < this.pattern.length) {
            const text = this.pattern.slice(this.cursor, this.cursor + 1);
            if(text === ']') {
                this.cursor++;
                if(this.cursor !== expectedEnd) {
                    this.valid = false;
                }
                this.sequence(sequence);
                return;
            }
            if(this.sets && text === '[') {
                this.sequence(sequence);
                sequence.splice(0, sequence.length);
                pending = undefined;
                this.characterClass();
                continue;
            }
            if(this.sets && (text === '-' || text === '&') && this.pattern[this.cursor + 1] === text) {
                this.sequence(sequence);
                sequence.splice(0, sequence.length);
                pending = undefined;
                this.cursor += 2;
                continue;
            }
            if(
                text === '-' &&
                pending !== undefined &&
                this.cursor + 1 < this.pattern.length &&
                this.pattern[this.cursor + 1] !== ']'
            ) {
                this.cursor++;
                const maximum = this.member();
                if(maximum.value < 0) {
                    this.valid = false;
                    return;
                }
                this.sequence(sequence);
                sequence.splice(0, sequence.length);
                this.append(sequence, maximum);
                pending = undefined;
                continue;
            }
            const member = this.member();
            if(member.value < 0) {
                this.sequence(sequence);
                sequence.splice(0, sequence.length);
                pending = undefined;
            }
            else {
                this.append(sequence, member);
                pending = member;
            }
        }
        this.valid = false;
    }
    changesUnderUnicode(): boolean {
        const safe = '^$\\.*+?()[]{}|/dDsSwWbBnrtvf0123456789xuck<>=!:,-';
        for(let at = 0; at < this.pattern.length; at++) {
            const text = this.pattern[at] ?? '';
            if(text === '{' || text === '}') {
                return true;
            }
            if(text !== '\\' || at + 1 >= this.pattern.length) {
                continue;
            }
            if(this.pattern.slice(at + 1, at + 3) === 'u{') {
                const end = this.pattern.indexOf('}', at + 3);
                if(end < 0) {
                    return true;
                }
                at = end;
                continue;
            }
            if(!safe.includes(this.pattern[at + 1] ?? '')) {
                return true;
            }
            at++;
        }
        return false;
    }
    scan(): void {
        this.cursor = 0;
        this.valid = true;
        this.found.splice(0, this.found.length);
        while(this.cursor < this.pattern.length) {
            const text = this.pattern[this.cursor] ?? '';
            if(text === '[') {
                this.characterClass();
            }
            else if(text === '\\') {
                const next = this.skipEscape(this.cursor);
                if(next < 0) {
                    this.valid = false;
                    return;
                }
                this.cursor = next;
            }
            else if(text === '{' && this.unicode) {
                let at = this.cursor + 1;
                const first = at;
                while(at < this.pattern.length && '0123456789'.includes(this.pattern[at] ?? '')) {
                    at++;
                }
                if(at === first) {
                    this.valid = false;
                    return;
                }
                if(this.pattern[at] === ',') {
                    at++;
                    while(at < this.pattern.length && '0123456789'.includes(this.pattern[at] ?? '')) {
                        at++;
                    }
                }
                if(this.pattern[at] !== '}') {
                    this.valid = false;
                    return;
                }
                this.cursor++;
            }
            else {
                this.cursor++;
            }
        }
    }
    run(): void {
        const constructor = new NoInvalidRegexp(this.rules);
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at);
            if(node.kind === 'Identifier' && node.text === 'RegExp' && constructor.global(at)) {
                const parent = this.rules.parser.node(this.rules.parents[at] ?? -1);
                if(['VariableDeclaration', 'PropertyAssignment', 'ShorthandPropertyAssignment'].includes(parent.kind)) {
                    panic(
                        'NotYet: no-misleading-character-class needs native constructor reference tracking and cooked-to-raw mapping',
                    );
                }
            }
            if(['CallExpression', 'NewExpression'].includes(node.kind) && node.list > 0) {
                const callee = this.rules.skip(node.children[0] ?? -1);
                const name = this.rules.parser.node(callee);
                if(name.kind === 'Identifier' && name.text === 'RegExp' && constructor.global(callee)) {
                    const pattern = this.rules.parser.node(
                        this.rules.skip(node.children[node.children.length - node.list] ?? -1),
                    );
                    if(
                        this.constant(this.rules.skip(node.children[node.children.length - node.list] ?? -1), []) ||
                        (pattern.kind === 'RegularExpressionLiteral' && node.list > 1)
                    ) {
                        panic(
                            'NotYet: no-misleading-character-class needs native constructor reference tracking and cooked-to-raw mapping',
                        );
                    }
                }
            }
            if(node.kind !== 'RegularExpressionLiteral') {
                continue;
            }
            const raw = node.text;
            const end = raw.lastIndexOf('/');
            if(end < 1) {
                continue;
            }
            this.pattern = raw.slice(1, end);
            const flags = raw.slice(end + 1);
            this.unicode = flags.includes('u') || flags.includes('v');
            this.sets = flags.includes('v');
            this.scan();
            if(!this.valid) {
                continue;
            }
            const base = node.end - raw.length + 1;
            for(const item of this.found) {
                const finding = new Diagnostic(
                    'no-misleading-character-class',
                    item.id,
                    this.message(item.id),
                    this.rules.byte(base + item.start),
                    this.rules.byte(base + item.end),
                    '',
                );
                if(item.id === 'surrogatePairWithoutUFlag' && !this.changesUnderUnicode()) {
                    const position = this.rules.byte(node.end);
                    finding.suggestions.push(
                        new Suggestion(
                            'suggestUnicodeFlag',
                            'Add the u flag so the class matches the character rather than its parts. The flag changes how the whole pattern parses, so this is offered rather than applied.',
                            [{ start: position, end: position, text: 'u' }],
                        ),
                    );
                }
                this.rules.findings.push(finding);
            }
        }
    }
}
