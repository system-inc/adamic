import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { SourceSyntaxForest } from './source_syntax_forest.a';
import { ComponentInference } from './component_inference.a';
import { UnsupportedSyntax } from './unsupported_syntax.a';
import { useMemo } from './use_memo.a';
import { ComponentDetection } from './component_detection.a';
import { BooleanPropNaming } from './boolean_prop_naming.a';
import { reactBooleanOptions } from './boolean_options.a';
const args = programArguments(); const options = reactBooleanOptions(args); const config = args[0] ?? panic('usage: main.a config manifest');
const manifest = readTextFile(args[1] ?? panic('missing manifest')); if(manifest.kind === 'Error') { panic(manifest.message); }
const paths = manifest.text.split('\n').filter(path => path !== ''); const program = tsgoProgram(config, paths); const forest = new SourceSyntaxForest(program); let findings = 0;
for(const path of paths) {
    const tree = forest.file(path); const inference = new ComponentInference(tree);
    new UnsupportedSyntax(tree, inference).run(); useMemo(tree, inference).run();
    if(options.enabled) { const detection = new ComponentDetection(tree); new BooleanPropNaming(tree, forest, detection, options.pattern, options.typeNames, options.nested, options.message).run(); }
    for(const finding of tree.findings) { finding.sortKey = finding.written(); }
    tree.findings.sort((left, right) => left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0); findings += tree.findings.length;
    if(!args.includes('--count')) { console.log(`file\t${written(path)}`); for(const finding of tree.findings) { console.log(finding.written()); } }
}
console.log(`findings ${findings}`); tsgoRelease(program);
