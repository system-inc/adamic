import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export class ClassThisTypes {
    readonly instance: number;
    readonly receiver: number;
    constructor(rules: Rules, index: number) {
        const frames = new Frames(rules.ask(index, 'class-this-types'));
        header(frames, 'class-this-types');
        this.instance = frames.natural();
        this.receiver = frames.natural();
        frames.end();
    }
}
