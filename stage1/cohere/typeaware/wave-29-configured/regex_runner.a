import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { UnaryMinus, byteOffsets } from '../unary_minus.ts';
import { Rules } from '../rules.ts';
import { IdDenylist } from '../id_denylist.a';
import { IdMatch } from '../id_match.a';


import { Frames } from '../frames.ts';
import { RegexpProgram } from '../regexp_program.a';

const args = programArguments();
const config = args[0] ?? panic('missing config');
const path = args[1] ?? panic('missing source');
const input = readTextFile(args[2] ?? panic('missing regex inputs'));
const source = readTextFile(path);
if(input.kind === 'Error' || source.kind === 'Error') { panic('cannot read regex input'); }
const program = tsgoProgram(config, [path]);
const parser = new Parser(source.text, path);
const scanner = new Scanner(source.text);
const offsets = byteOffsets(source.text);
const unary = new UnaryMinus(program, path, parser, scanner, offsets);
const linter = new Rules(program, path, parser, scanner, offsets, unary);
const root = parser.file();
for(let at = 0; at < parser.nodes.length; at++) { linter.parents.push(-1); }
linter.links(root, -1);
const frames = new Frames(input.text);
const count = frames.natural();
for(let at = 0; at < count; at++) {
    const pattern = frames.field();
    const text = frames.field();
    const expression = new RegexpProgram(linter, pattern);
    console.log(`${at} ${expression.matches(text) ? 1 : 0}`);
}
frames.end();
tsgoRelease(program);
