import type { Rules } from './rules.ts';
import { types } from './facts.ts';
import { Frames, header } from './frames.ts';
import { nodeSymbol } from './library_declarations.a';
import { Diagnostic } from './diagnostic.ts';

const stringMethods = [
    'at',
    'charAt',
    'charCodeAt',
    'codePointAt',
    'concat',
    'endsWith',
    'includes',
    'indexOf',
    'isWellFormed',
    'lastIndexOf',
    'match',
    'matchAll',
    'padEnd',
    'padStart',
    'replace',
    'replaceAll',
    'search',
    'slice',
    'split',
    'startsWith',
    'substr',
    'substring',
    'toLocaleLowerCase',
    'toLocaleUpperCase',
    'toLowerCase',
    'toString',
    'toUpperCase',
    'toWellFormed',
    'trim',
    'trimEnd',
    'trimLeft',
    'trimRight',
    'trimStart',
    'valueOf',
];
const arrayMethods = [
    'at',
    'concat',
    'entries',
    'flat',
    'includes',
    'indexOf',
    'join',
    'keys',
    'lastIndexOf',
    'slice',
    'toReversed',
    'toSorted',
    'toSpliced',
    'values',
    'with',
];
const pureMessage =
    'This call computes a new value and changes nothing, and its result is thrown away, so the statement does nothing. Strings are immutable (`name.trim()` returns a trimmed copy and leaves `name` as it was), and these array methods return a new array or a value without touching the original (`list.concat(more)` does not add to `list`). Assign the result (`name = name.trim()`, `list = list.concat(more)`), use the mutating form (`list.push(...more)`), or delete the statement.';

export class NoDiscardedPureResult {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    callable(index: number): boolean {
        const value = this.rules.skip(index);
        const node = this.rules.parser.node(value);
        if(['ArrowFunction', 'FunctionExpression'].includes(node.kind)) {
            return true;
        }
        const facts = types(this.rules.ask(value, 'raw-shape'), 'raw-shape');
        if(!facts.present) {
            return true;
        }
        for(const id of facts.parts(facts.root())) {
            if((facts.type(id).flags & 3) !== 0) {
                return true;
            }
            const frames = new Frames(this.rules.ask(value, `call-count\n${id}`));
            header(frames, 'call-count');
            const count = frames.natural();
            frames.end();
            if(count > 0) {
                return true;
            }
        }
        return false;
    }
    pure(index: number): boolean {
        const node = this.rules.parser.node(index);
        const symbol = nodeSymbol(this.rules, index);
        if(!symbol.present || symbol.declarations.length === 0) {
            return false;
        }
        for(const declaration of symbol.declarations) {
            if(
                declaration.kind !== 'MethodSignature' ||
                declaration.parentKind !== 'InterfaceDeclaration' ||
                !declaration.defaultLibrary
            ) {
                return false;
            }
            if(declaration.parentName === 'String') {
                if(!stringMethods.includes(node.text)) {
                    return false;
                }
            }
            else if(!['Array', 'ReadonlyArray'].includes(declaration.parentName) || !arrayMethods.includes(node.text)) {
                return false;
            }
        }
        return true;
    }

    check(index: number): void {
        const statement = this.rules.parser.node(index);
        const callIndex = this.rules.skip(statement.children[0] ?? -1);
        const call = this.rules.parser.node(callIndex);
        if(call.kind !== 'CallExpression') {
            return;
        }
        const callee = this.rules.parser.node(this.rules.skip(call.children[0] ?? -1));
        if(callee.kind !== 'PropertyAccessExpression') {
            return;
        }
        const name = callee.children[callee.children.length - 1] ?? -1;
        if(this.rules.parser.node(name).kind !== 'Identifier' || !this.pure(name)) {
            return;
        }
        for(let at = call.children.length - call.list; at < call.children.length; at++) {
            const argument = call.children[at] ?? -1;
            if(this.callable(argument)) {
                return;
            }
        }
        this.rules.findings.push(
            new Diagnostic(
                'correctness-no-discarded-pure-result',
                'discardedPureResult',
                pureMessage,
                this.rules.byte(this.rules.start(call)),
                this.rules.byte(call.end),
                'nexus/',
            ),
        );
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if(this.rules.parser.node(index).kind === 'ExpressionStatement') {
                this.check(index);
            }
        }
    }
}
