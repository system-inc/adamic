import { Frames, header } from './frames.ts';
import type { Rules } from './rules.ts';
export class SignatureAncestor {
    readonly kind: string;
    readonly name: string;
    readonly nameKind: string;
    constructor(kind: string, name: string, nameKind: string) {
        this.kind = kind;
        this.name = name;
        this.nameKind = nameKind;
    }
}
export function signatureAncestry(rules: Rules, index: number): SignatureAncestor[] {
    const frames = new Frames(rules.ask(index, 'signature-ancestry'));
    header(frames, 'signature-ancestry');
    const result: SignatureAncestor[] = [];
    if(frames.yes()) {
        const count = frames.natural();
        for(let i = 0; i < count; i++) {
            result.push(new SignatureAncestor(frames.field(), frames.field(), frames.field()));
        }
    }
    frames.end();
    return result;
}
