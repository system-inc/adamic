            for(const signature of packet.rows) {
                saw=true;
                for(const returned of this.expand([signature.returns],substitutions)) {if(!this.thenable(returned)) {return false;}}
            }
        }
        return saw;
    }
    name(node: Node): Node | undefined {
        for(const index of node.children) {const child=at(this.context.nodes,index);if([Identifier,PrivateIdentifier,StringLiteral,NumericLiteral,NoSubstitutionTemplateLiteral].includes(child.kind)) {return child;}}
