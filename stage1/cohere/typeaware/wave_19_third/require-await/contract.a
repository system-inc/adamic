export class Contract {
    readonly context: Context;readonly node: Node;readonly records=new Map<number,TypeFact>();
    constructor(context: Context,node: Node) {this.context=context;this.node=node;}
    accept(graph: Types): Types {for(const record of graph.records) {this.records.set(record.id,record);}return graph;}
    payload(text: string): void {this.accept(types(text,'wave19-contract-types'));}
    query(question: string): Types {return this.accept(types(this.context.ask(this.node,question),question.split('\n')[0] ?? panic('missing question')));}
    type(id: number): TypeFact {return this.records.get(id) ?? panic('missing contract type');}
    parts(id: number): readonly number[] {const type=this.type(id);return (type.flags & 134217728)!==0?type.parts:[id];}
    expand(roots: readonly number[],substitutions: Map<number,number[]>): number[] {
        const result: number[]=[];
        for(const id of roots) {for(const part of this.parts(id)) {
            const replacement=substitutions.get(part);
            if(replacement===undefined) {result.push(part);} else {for(const standIn of replacement) {for(const leaf of this.parts(standIn)) {result.push(leaf);}}}
        }}
        return result;
    }
    callable(id: number): boolean {
        const apparent=this.query(`apparent-shape\n${id}`);
        for(const root of apparent.roots) {for(const part of this.parts(root)) {const packet=signatures(this.context,this.node,part);this.payload(packet.graph);if(packet.rows.length>0) {return true;}}}
        return false;
    }
    thenable(id: number): boolean {
        const apparent=this.query(`apparent-shape\n${id}`);
        for(const root of apparent.roots) {for(const part of this.parts(root)) {
            const then=this.query(`property-shape\n${part}\nthen`);if(!then.present) {continue;}
            for(const thenRoot of then.roots) {for(const thenPart of this.parts(thenRoot)) {
                const packet=signatures(this.context,this.node,thenPart);this.payload(packet.graph);
                for(const signature of packet.rows) {
                    if(signature.parameters.length===0) {continue;}
                    const parameter=signature.rest?signature.element:(signature.parameters[0] ?? 0);
                    if(parameter!==0 && this.callable(parameter)) {return true;}
                }
            }}
        }}
        return false;
