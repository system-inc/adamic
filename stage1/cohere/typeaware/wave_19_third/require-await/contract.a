import { FunctionExpression,ArrowFunction,MethodDeclaration,ClassDeclaration,ClassExpression,AsyncKeyword,AsteriskToken,Identifier,PrivateIdentifier,StringLiteral,NumericLiteral,NoSubstitutionTemplateLiteral,ObjectLiteralExpression,PropertyAssignment,ArrayLiteralExpression,ConditionalExpression,BinaryExpression,ParenthesizedExpression,ReturnStatement,CallExpression,NewExpression,SpreadElement,StaticKeyword,BarBarToken,QuestionQuestionToken,AnyKeyword,UnknownKeyword,NumberKeyword,BigIntKeyword,BooleanKeyword,StringKeyword,SymbolKeyword,ObjectKeyword,UndefinedKeyword,NeverKeyword,VoidKeyword,IntrinsicKeyword,EqualsGreaterThanToken } from './kinds.a';
class Step {
    readonly operation: number;readonly name: string;readonly index: number;
