        const primitives=[AnyKeyword,UnknownKeyword,NumberKeyword,BigIntKeyword,BooleanKeyword,StringKeyword,SymbolKeyword,ObjectKeyword,UndefinedKeyword,NeverKeyword,VoidKeyword,IntrinsicKeyword];
        for(const index of node.children.slice(0,-1)) {
            const child=at(this.context.nodes,index);
            if(child.kind===AsyncKeyword || child.kind===AsteriskToken || (child.kind>=182 && child.kind<=211) || primitives.includes(child.kind)) {return false;}
        }
        return true;
