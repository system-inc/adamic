    apply(roots: readonly number[],step: Step): number[] {
        const next: number[]=[];
        for(const part of roots) {
            if(step.operation===2) {
                const packet=signatures(this.context,this.node,part);this.payload(packet.graph);
                for(const signature of packet.rows) {next.push(signature.returns);}
            }
            else {
                const packet=members(this.context,this.node,part,step.name);this.payload(packet.graph);
                let selected=0;
                if(step.operation===0) {selected=packet.property!==0?packet.property:packet.stringIndex;}
                else {selected=packet.tuple?(packet.elements[step.index] ?? 0):packet.numberIndex;}
                if(selected!==0) {next.push(selected);}
            }
        }
        return next;
    }
    fromCall(call: Node,argument: Node,steps: readonly Step[]): Demand {
        const substitutions=new Map<number,number[]>();const empty: number[]=[];const fallback=new Demand(false,empty,substitutions);
        const first=call.children.length-call.count;let position=-1;
        for(let index=first;index<call.children.length;index++) {
            const child=at(this.context.nodes,call.children[index] ?? -1);
            if(child.index===argument.index) {position=index-first;break;}
            if(child.kind===SpreadElement) {return fallback;}
        }
        if(position<0) {return fallback;}
        const packet=genericCall(this.context,call);this.payload(packet.graph);
        if(packet.explicit || packet.typeParameters.length===0) {return fallback;}
        const parameter=packet.rest && position>=packet.declared.length-1?packet.element:(packet.declared[position] ?? 0);
        if(parameter===0) {return fallback;}
        for(let index=0;index<call.count;index++) {
            if(index===position || index>=packet.declared.length || index>=packet.resolved.length || (packet.rest && index>=packet.declared.length-1)) {continue;}
            const declared=packet.declared[index] ?? 0;
            if(!packet.typeParameters.includes(declared)) {continue;}
            const emptyReplacement: number[]=[];const replacement=substitutions.get(declared) ?? emptyReplacement;replacement.push(packet.resolved[index] ?? panic('missing resolved parameter'));substitutions.set(declared,replacement);
        }
        if(packet.typeParameters.includes(packet.returns) && packet.contextual!==0) {
            const emptyReplacement: number[]=[];const replacement=substitutions.get(packet.returns) ?? emptyReplacement;replacement.push(packet.contextual);substitutions.set(packet.returns,replacement);
        }
        let roots: number[]=[parameter];
        for(let index=steps.length-1;index>=0;index--) {roots=this.apply(this.expand(roots,substitutions),steps[index] ?? panic('missing context step'));}
        return new Demand(true,roots,substitutions);
    }
    generic(): Demand {
        const empty: number[]=[];const fallback=new Demand(false,empty,new Map<number,number[]>());const steps: Step[]=[];let current=this.node;
        if(current.kind===MethodDeclaration) {
            const parent=at(this.context.nodes,this.context.parents[current.index] ?? -1);const name=this.name(current);
            if(parent.kind!==ObjectLiteralExpression || name===undefined) {return fallback;}
            steps.push(new Step(0,name.text));current=parent;
        }
        while((this.context.parents[current.index] ?? -1)>=0) {
            let parent=at(this.context.nodes,this.context.parents[current.index] ?? -1);
            if(parent.kind===ParenthesizedExpression) {}
            else if(parent.kind===ConditionalExpression) {
                if((parent.children[2] ?? -1)!==current.index && (parent.children[parent.children.length-1] ?? -1)!==current.index) {return fallback;}
            }
            else if(parent.kind===BinaryExpression) {
                const operator=at(this.context.nodes,parent.children[1] ?? -1);
                if(operator.kind!==BarBarToken && operator.kind!==QuestionQuestionToken) {return fallback;}
            }
            else if(parent.kind===PropertyAssignment) {
                if((parent.children[parent.children.length-1] ?? -1)!==current.index) {return fallback;}
                const name=this.name(parent);if(name===undefined) {return fallback;}
                steps.push(new Step(0,name.text));const above=this.context.parents[parent.index] ?? -1;if(above<0) {return fallback;}parent=at(this.context.nodes,above);
            }
            else if(parent.kind===ArrayLiteralExpression) {
                let position=-1;
                for(let index=0;index<parent.children.length;index++) {
                    const child=at(this.context.nodes,parent.children[index] ?? -1);
                    if(child.index===current.index) {position=index;break;}
                    if(child.kind===SpreadElement) {return fallback;}
                }
                if(position<0) {return fallback;}steps.push(new Step(1,'',position));
            }
            else if(parent.kind===ReturnStatement) {
                let index=this.context.parents[parent.index] ?? -1;
                while(index>=0) {const candidate=at(this.context.nodes,index);if([263,219,220,175,178,179,177].includes(candidate.kind)) {break;}index=this.context.parents[index] ?? -1;}
                if(index<0) {return fallback;}const functionNode=at(this.context.nodes,index);if(!this.returnContext(functionNode)) {return fallback;}
                steps.push(new Step(2));parent=functionNode;
            }
            else if(parent.kind===ArrowFunction) {
                if((parent.children[parent.children.length-1] ?? -1)!==current.index || !this.returnContext(parent)) {return fallback;}
                steps.push(new Step(2));
            }
            else if(parent.kind===CallExpression || parent.kind===NewExpression) {return this.fromCall(parent,current,steps);}
            else {return fallback;}
            current=parent;
        }
        return fallback;
    }
    required(): boolean {
        const declared=this.generic();if(declared.generic) {return this.demands(declared.roots,declared.substitutions);}
        let contextual=this.query('contextual-shape');
        if(!contextual.present && this.node.kind===MethodDeclaration) {
            const name=this.name(this.node);let staticMember=false;for(const index of this.node.children) {if(at(this.context.nodes,index).kind===StaticKeyword) {staticMember=true;}}
            const parentIndex=this.context.parents[this.node.index] ?? -1;
            if(!staticMember && name!==undefined && name.kind===Identifier && parentIndex>=0) {
                const parent=at(this.context.nodes,parentIndex);
                if(parent.kind===ClassDeclaration || parent.kind===ClassExpression) {
                    const heritage=this.accept(heritageMembers(this.context,this.node));
                    contextual=heritage;
