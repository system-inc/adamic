import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { written } from '../../../typescript/parser/nodes.ts';
import { byteOffsets } from '../unary_minus.ts';
import { Node, at } from './node.a';
import { Context } from './context.a';
import { kindId } from './kinds.a';
import { Rule as AwaitRule } from './require-await/rule.a';
const args=programArguments();const config=args[0] ?? panic('missing config');
const input=readTextFile(args[1] ?? panic('missing manifest'));if(input.kind==='Error') {panic(input.message);}
const paths=input.text.split('\n').filter((path)=>path!=='');const program=tsgoProgram(config,paths);let total=0;
for(const path of paths) {
    const input=readTextFile(path);if(input.kind==='Error') {panic(input.message);}
    const parser=new Parser(input.text,path);const root=parser.file();const scanner=new Scanner(input.text);
    const nodes: Node[]=[];const parents: number[]=[];const flags: number[]=[];
    // Compatibility conversion is outside every rule and happens once per parser node.
    for(let index=0;index<parser.nodes.length;index++) {
        const raw=parser.nodes[index] ?? panic('missing parser node');scanner.pos=raw.pos;scanner.scan();
        nodes.push(new Node(index,kindId(raw.kind),raw.pos,scanner.start,raw.end,raw.text,raw.operator,raw.children,raw.list));parents.push(-1);flags.push(Number(raw.semantic));
        if((nodes[index] ?? panic('missing converted node')).kind===173 && raw.children.length>0) {
            const last=parser.nodes[raw.children[raw.children.length-1] ?? -1] ?? panic('missing property child');
            scanner.pos=raw.pos;let initialized=false;
            while(scanner.pos<last.pos) {scanner.scan();if(kindId(scanner.kind)===63) {initialized=true;}}
            flags[index]=initialized?1:0;
        }
    }
    const pending=[root];
    while(pending.length>0) {
        const index=pending.pop() ?? -1;const node=at(nodes,index);
        for(const child of node.children) {parents[child]=index;pending.push(child);}
    }
    const context=new Context(program,path,input.text,byteOffsets(input.text),nodes,parents,flags);
    const awaitRule=new AwaitRule();
    // One shared kind-indexed walk. Each listener gets the already fetched node.
    const work=[root];
    while(work.length>0) {
        const node=at(nodes,work.pop() ?? -1);
        if([263,219,220,175,178,179,177].includes(node.kind)) {awaitRule.visit(node,context);}
        
        for(const child of node.children) {work.push(child);}
    }
    for(const finding of context.findings) {finding.sortKey=finding.written();}
    context.findings.sort((a,b)=>a.sortKey<b.sortKey?-1:a.sortKey>b.sortKey?1:0);total+=context.findings.length;
    if(!args.includes('--count')) {console.log(`file\t${written(path)}`);for(const finding of context.findings) {console.log(finding.written());}}
}
console.log(`findings ${total}`);tsgoRelease(program);
