// Production default Base validation parity. The checker supplies types only.
import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
import { types } from './facts.ts';

export class VerifyOptionalParity {
    readonly rules: Rules;
    constructor(rules: Rules) { this.rules = rules; }
    add(rule: string, id: string, message: string, index: number): void {
        const node = this.rules.parser.node(index);
        this.rules.findings.push(new Diagnostic(rule, id, message,
            this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), ''));
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            // Speculative parser nodes are not members of the final source tree.
            if((this.rules.parents[index] ?? -1) < 0) { continue; }
            const node = this.rules.parser.node(index);
            if(node.kind !== 'PropertyDeclaration' && node.kind !== 'Parameter') { continue; }
            if(node.kind === 'Parameter' && !node.children.some((child) =>
                ['PublicKeyword', 'PrivateKeyword', 'ProtectedKeyword', 'ReadonlyKeyword'].includes(this.rules.parser.node(child).kind))) { continue; }
            const key = node.children.find((child) => !['Decorator', 'QuestionToken', 'ExclamationToken'].includes(this.rules.parser.node(child).kind) &&
                !this.rules.parser.node(child).kind.endsWith('Keyword')) ?? -1;
            if(key < 0 || this.rules.parser.node(key).kind !== 'Identifier') { continue; }
            let sentinel = false; let other = false;
            for(const child of node.children) {
                const decorator = this.rules.parser.node(child);
                if(decorator.kind !== 'Decorator') { continue; }
                const call = this.rules.parser.node(decorator.children[0] ?? -1);
                if(call.kind !== 'CallExpression') { continue; }
                const callee = this.rules.parser.node(call.children[0] ?? -1);
                if(callee.kind !== 'Identifier' || !callee.text.startsWith('Verify')) { continue; }
                if(callee.text === 'VerifyIsOptional') { sentinel = true; } else { other = true; }
            }
            if(!sentinel && !other) { continue; }
            const facts = types(this.rules.ask(key, 'raw-type'), 'raw-type');
            const nullable = facts.has(facts.root(), 1 | 2 | 4 | 8 | 16);
            const text = facts.root().name;
            if(sentinel && !nullable) {
                this.add('base/correctness-require-verify-optional-parity', 'optionalButTypeNot',
                    `@VerifyIsOptional() is present but type '${text}' does not include null/undefined. The validator is configured to tolerate a missing value here and the type is not, so TypeScript forbids the very values the validation would have let through. One of the two is wrong and a reader cannot tell which.`, key);
            } else if(nullable && !sentinel && other) {
                this.add('base/correctness-require-verify-optional-parity', 'typeOptionalButNoVerify',
                    `Type '${text}' is nullable but @VerifyIsOptional() is missing. The type says this value may be missing and the validator does not, so passing undefined fails validation at runtime while the compiler was happy with it. That gap only shows up in production data.`, key);
            }
        }
    }
}
