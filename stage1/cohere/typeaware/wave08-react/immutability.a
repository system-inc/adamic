        this.reasons = reasons;
    }
}
export class Immutability {
    // Mutable 0, Frozen 1, Primitive 2, MaybeFrozen 3, Global 4, Context 5.
    merge(a: number, b: number): number {
        if(a === b) {
            return a;
        }
        if(a === 3 || b === 3) {
            return 3;
        }
        if(a === 0 || b === 0) {
            if(a === 1 || b === 1) {
                return 3;
