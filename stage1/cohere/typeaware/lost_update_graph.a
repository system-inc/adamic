                const clause = rules.parser.node(clauses[at] ?? -1); for(const child of clause.children.slice(clause.kind === 'CaseClause' ? 1 : 0)) { this.statement(child); } previous = this.current;
            }
            this.link(previous, after); this.jumps.pop(); this.enter(after);
        } else if(kind === 'LabeledStatement') {
            const body = node.children[node.children.length - 1] ?? -1;
            if(['SwitchStatement', 'WhileStatement', 'DoStatement', 'ForStatement', 'ForOfStatement', 'ForInStatement'].includes(this.kind(body))) { this.statement(body); }
            else { const after = this.newBlock(); this.jumps.push(new LostJump([rules.parser.node(node.children[0] ?? -1).text], after, -1, false)); this.statement(body); this.jumps.pop(); this.link(this.current, after); this.enter(after); }
        } else if(kind === 'ClassDeclaration') { this.expr(index); }
        else if(!['EmptyStatement', 'DebuggerStatement', 'ImportDeclaration', 'ImportEqualsDeclaration', 'FunctionDeclaration', 'ExportDeclaration'].includes(kind)) { for(const child of node.children) { this.unknown(child); } }
    }
    tryStatement(index: number): void {
        const rules = this.bindings.rules; const children = rules.parser.node(index).children; const caught = children.find((child) => this.kind(child) === 'CatchClause') ?? -1;
        const final = children.length > 1 && this.kind(children[children.length - 1] ?? -1) === 'Block' ? children[children.length - 1] ?? -1 : -1;
        const frame = new LostTry(caught < 0 ? -1 : this.newBlock(), final < 0 ? -1 : this.newBlock()); this.tries.push(frame);
        this.statement(children[0] ?? -1); const ends: number[] = [];
        if(caught >= 0) { this.link(this.current, frame.caught); ends.push(this.current); frame.position = 1; frame.forked = false; this.enter(frame.caught);
            const clause = rules.parser.node(caught); for(const child of clause.children) { if(this.kind(child) === 'VariableDeclaration') { this.patternBind(this.bindings.shape.name(child)); } else { this.statement(child); } }
        }
        ends.push(this.current); this.tries.pop(); const after = this.newBlock();
        if(final < 0) { for(const end of ends) { this.link(end, after); } this.enter(after); return; }
        const snapshot = this.tries.map((entry) => entry.forked); const normal = this.newBlock(); for(const end of ends) { this.link(end, normal); }
        this.enter(normal); this.statement(final); this.link(this.current, after);
        if(this.block(frame.final).incoming) {
            for(let at = 0; at < snapshot.length; at++) { const outer = this.tries[at] ?? panic('missing try'); outer.forked = snapshot[at] ?? false; }
            this.enter(frame.final); this.statement(final);
            if(this.block(this.current).reachable) {
                if(frame.returned) { const at = this.returnFrame(); if(at >= 0) { const outer = this.tries[at] ?? panic('missing try'); outer.returned = true; this.link(this.current, outer.final); } }
                if(frame.thrown) { const at = this.throwFrame(); if(at >= 0) { const outer = this.tries[at] ?? panic('missing try'); outer.thrown = true; this.link(this.current, this.throwTarget(outer)); } }
            }
        }
        this.enter(after);
    }
    unknown(index: number): void {
        if(index < 0) { return; } const kind = this.kind(index);
        if(kind.endsWith('Statement') || ['Block', 'VariableDeclaration', 'VariableDeclarationList', 'SourceFile', 'ClassDeclaration', 'FunctionDeclaration'].includes(kind)) { this.statement(index); }
        else { this.expr(index); }
    }
    build(root: number): void {
        this.current = this.newBlock(); this.block(this.current).incoming = true; this.block(this.current).reachable = true;
        const node = this.bindings.rules.parser.node(root);
        for(const parameter of node.children.filter((child) => this.kind(child) === 'Parameter')) {
            const name = this.bindings.shape.name(parameter); const initializer = this.bindings.shape.initializer(parameter);
            for(const child of this.bindings.rules.parser.node(parameter).children) { if(child !== name && child !== initializer) { this.expr(child); } }
            this.defaultBind(name, initializer);
        }
        const body = node.children[node.children.length - 1] ?? -1; this.unknown(body);
    }
}
