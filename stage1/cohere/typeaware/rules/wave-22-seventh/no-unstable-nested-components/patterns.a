// Shared table row react/no_unstable_nested_components.go:450, ab70's companion
// origin/codex/lint-regex. Go dot excludes LF; the final assertion is absolute end.
export const hookName=/^use[A-Z0-9][^\n]*(?![\s\S])/u;
// Default expansion of Go buildPropNamePattern("render*").
export const defaultPropName=/^render[^\n]*(?![\s\S])/u;
