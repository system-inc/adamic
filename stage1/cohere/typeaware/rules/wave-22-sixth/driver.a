import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { Parser } from '../../../../typescript/parser/parser.ts';
import { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { written } from '../../../../typescript/parser/nodes.ts';
import { UnaryMinus, byteOffsets } from '../../unary_minus.ts';
import { Rules } from '../../rules.ts';
import { Bindings } from '../../bindings.ts';
import { Kind } from './common/kinds.a';
import { Context } from './common/context.a';
import { Rule as Fragments } from './jsx-fragments/rule.a';
import { Rule as Undef } from './jsx-no-undef/rule.a';
import { Rule as Adjacent } from './no-adjacent-inline-elements/rule.a';
const args=programArguments();const config=args[0]??panic('missing config');const manifest=readTextFile(args[1]??panic('missing manifest'));
if(manifest.kind==='Error'){panic(manifest.message);}const paths=manifest.text.split('\n').filter((path)=>path!=='');
const program=tsgoProgram(config,paths);let total=0;
for(const path of paths) {
    const source=readTextFile(path);if(source.kind==='Error'){panic(source.message);}
    const parser=new Parser(source.text,path);const scanner=new Scanner(source.text);const offsets=byteOffsets(source.text);
    const unary=new UnaryMinus(program,path,parser,scanner,offsets);const rules=new Rules(program,path,parser,scanner,offsets,unary);
    const root=parser.file();for(let at=0;at<parser.nodes.length;at++){rules.parents.push(-1);}rules.links(root,-1);
    const bindings=new Bindings(rules);const context=new Context(bindings,args.includes('--element'),args.includes('--allow-globals'));
    const fragments=new Fragments(context);const undef=new Undef(context);const adjacent=new Adjacent(context);
    // Only declared subscribers receive a cached node. No visitor rereads its subject.
    for(let index=0;index<context.sourceCount;index++) {
        const node=context.node(index);if(node.parent<0){continue;}
        switch(node.kind) {
            case 289: // JsxFragment
 fragments.visit(node);break;
            case 285: // JsxElement
 fragments.visit(node);adjacent.visit(node);break;
            case 287: // JsxOpeningElement
 undef.visit(node);break;
            case 286: // JsxSelfClosingElement
 fragments.visit(node);undef.visit(node);break;
            case 214: // CallExpression
 adjacent.visit(node);break;
        }
    }
    for(const finding of rules.findings){finding.sortKey=finding.written();}
    rules.findings.sort((left,right)=>left.sortKey<right.sortKey?-1:left.sortKey>right.sortKey?1:0);
    total+=rules.findings.length;
    if(!args.includes('--count')){console.log(`file\t${written(path)}`);for(const finding of rules.findings){console.log(finding.written());}}
}
console.log(`findings ${total}`);tsgoRelease(program);
