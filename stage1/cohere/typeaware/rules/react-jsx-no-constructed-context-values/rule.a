import { panic } from 'adamic';
import { Diagnostic } from '../../diagnostic.ts';

const componentCapital = /^\p{Lu}/u;
import { Value, constructionOf, resolvesToCreateContext, isComponentClass } from './numeric_constructions.a';

export class Input {
    kind = 0;
    tagKind = 0;
    propertyKind = 0;
    propertyName = '';
    nearestFunctionKind = 0;
    nearestFunctionName = '';
    bindingName = '';
    valueKind = 0;
    valueStart = 0;
    valueEnd = 0;
    valueLine = 1;
    values: Value[] = [];
    valueIndex = -1;
    tagIndex = -1;
    nearestFunctionParentKind = 0;
    classFactsReady = false;
    classIndex = -1;
}
export class Rule {
    component(node: Input): boolean {
        if(node.nearestFunctionKind === 0) { return false; }
        if([174, 177, 178, 176, 172].includes(node.nearestFunctionKind) ||
            ([218, 219].includes(node.nearestFunctionKind) && node.nearestFunctionParentKind === 172)) {
            if(!node.classFactsReady) { panic('jsx-no-constructed-context-values requires shared numeric class ancestry'); }
            return isComponentClass(node.values, node.classIndex);
        }
        if(![262, 218, 219].includes(node.nearestFunctionKind)) {
            panic('jsx-no-constructed-context-values requires shared numeric class ancestry');
        }
        const name = node.nearestFunctionKind === 262 ? node.nearestFunctionName : node.bindingName;
        if(name === '') { return false; }
        return componentCapital.test(name);
    }
    construction(kind: number): string {
        const kinds = [210, 209, 218, 219, 231, 214, 13, 284, 285, 288];
        const names = ['object', 'array', 'function expression', 'function expression', 'class expression',
            'new expression', 'regular expression', 'JSX element', 'JSX element', 'JSX fragment'];
        const at = kinds.indexOf(kind);
        if(at >= 0) { return names[at] ?? ''; }
        if([8, 9, 10, 14, 96, 105, 111].includes(kind) || kind === 0) { return ''; }
        panic('jsx-no-constructed-context-values requires numeric value-tree, binding and memo stability adapters');
    }
    visit(node: Input): Diagnostic | undefined {
        if(node.tagKind === 79) {
            if(node.tagIndex < 0) { panic('jsx-no-constructed-context-values requires resolved createContext initializer facts'); }
            if(!resolvesToCreateContext(node.values, node.tagIndex)) { return undefined; }
        }
        if(node.tagKind !== 79 && (node.tagKind !== 211 || node.propertyKind !== 79 || node.propertyName !== 'Provider')) {
            return undefined;
        }
        if(node.valueIndex >= 0) {
            const found = constructionOf(node.values, node.valueIndex);
            if(found === undefined) {
                if(this.component(node)) { panic('constructed-context requires memo stability facts for unresolved construction'); }
                return undefined;
            }
            if(!this.component(node)) { return undefined; }
            const value = node.values[found.index] ?? panic('missing construction');
            const usage = node.values[found.usage];
            const label = found.label === '' ? (found.kind === 262 ? 'function declaration' : this.construction(found.kind)) : found.label;
            const functionKind = label === 'function expression' || label === 'function declaration';
            const remedy = functionKind ? 'useCallback' : 'useMemo';
            const suffix = functionKind ? 'Func' : '';
            const id = (usage === undefined ? 'defaultMsg' : 'withIdentifierMsg') + suffix;
            let prefix = `The ${label} passed as the value prop to the Context provider (at line ${value.line})`;
            if(usage !== undefined) {
                const name = usage.kind === 79 ? usage.name : '';
                for(let index = 0; index < name.length; index++) {
                    if(name.charCodeAt(index) < 32 || name.charCodeAt(index) >= 127 || name.charCodeAt(index) === 34 || name.charCodeAt(index) === 92) {
                        panic('constructed-context requires Go quoted identifier rendering');
                    }
                }
                prefix = `The "${name}" ${label} (at line ${value.line}) passed as the value prop to the Context provider (at line ${usage.line})`;
            }
            return new Diagnostic('jsx-no-constructed-context-values', id,
                `${prefix} changes every render, so every consumer of this context re-renders on every render of this component even when nothing it reads has changed. Wrap it in a ${remedy} hook so the identity is stable between renders.`,
                value.start, value.end, 'react/');
        }
        const construction = this.construction(node.valueKind);
        if(construction === '' || !this.component(node)) { return undefined; }
        const functionKind = [218, 219].includes(node.valueKind);
        const remedy = functionKind ? 'useCallback' : 'useMemo';
        const id = functionKind ? 'defaultMsgFunc' : 'defaultMsg';
        return new Diagnostic('jsx-no-constructed-context-values', id,
            `The ${construction} passed as the value prop to the Context provider (at line ${node.valueLine}) changes every render, so every consumer of this context re-renders on every render of this component even when nothing it reads has changed. Wrap it in a ${remedy} hook so the identity is stable between renders.`,
            node.valueStart, node.valueEnd, 'react/');
    }
}
export function create(): Rule { return new Rule(); }
