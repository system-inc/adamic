import { panic } from 'adamic';

// strconv.IsPrint accepts these Unicode categories and ASCII space only.
const printable = /^[\p{L}\p{M}\p{N}\p{P}\p{S} ]$/u;
function hex(point: number, digits: number): string {
    const alphabet = '0123456789abcdef';
    let result = '';
    for(let shift = (digits - 1) * 4; shift >= 0; shift -= 4) {
        result += alphabet.charAt((point >>> shift) & 15);
    }
    return result;
}
export function quotedName(name: string): string {
    let result = '"';
    for(let index = 0; index < name.length;) {
        const point = name.codePointAt(index) ?? panic('missing quoted name code point');
        if(point >= 55296 && point <= 57343) {
            panic('constructed-context identifier contains an unpaired surrogate');
        }
        const character = String.fromCodePoint(point);
        index += point > 65535 ? 2 : 1;
        if(point === 34 || point === 92) { result += '\\' + character; }
        else if(printable.test(character)) { result += character; }
        else if(point === 7) { result += '\\a'; }
        else if(point === 8) { result += '\\b'; }
        else if(point === 9) { result += '\\t'; }
        else if(point === 10) { result += '\\n'; }
        else if(point === 11) { result += '\\v'; }
        else if(point === 12) { result += '\\f'; }
        else if(point === 13) { result += '\\r'; }
        else if(point < 32 || point === 127) { result += '\\x' + hex(point, 2); }
        else if(point < 65536) { result += '\\u' + hex(point, 4); }
        else { result += '\\U' + hex(point, 8); }
    }
    return result + '"';
}
