import type { Rules } from './rules.ts';
import type { SyntaxProjection } from './syntax_projection.a';
import { ReactCompilationGate } from './react_compilation_gate.a';
import { ProcessSymbols } from './process_symbol_details.a';
import { Diagnostic } from './diagnostic.ts';
import { reactWave25Message } from './react_wave_25_messages.a';
export class UseMemo {
 readonly rules: Rules; readonly syntax: SyntaxProjection; readonly symbols: ProcessSymbols; readonly gate: ReactCompilationGate;
 constructor(rules: Rules, syntax: SyntaxProjection) { this.rules = rules; this.syntax = syntax; this.symbols = new ProcessSymbols(syntax); this.gate = new ReactCompilationGate(syntax); }
 report(index: number, id: string): void { const node = this.syntax.node(index); this.rules.findings.push(new Diagnostic('react-hooks/use-memo', id, reactWave25Message(id), node.start, node.end, '')); }
 binding(index: number, receiver: boolean): string {
  const syntax = this.syntax; const node = syntax.node(index); if(node.kind !== 'Identifier') { return ''; } const symbol = this.symbols.get(index); if(symbol.identity === 0) { return node.text; }
  if(receiver) { return symbol.declarations.some((decl) => ['ImportClause', 'NamespaceImport'].includes(decl.kind)) ? node.text : ''; }
  for(const declaration of symbol.declarations) { if(declaration.kind !== 'ImportSpecifier' || declaration.file !== syntax.path) { continue; } const specifier = syntax.locate(declaration.kind, declaration.pos, declaration.end); let imported = syntax.node(specifier).name; const first = syntax.node(specifier).children[0] ?? 0; if(first !== 0 && first !== imported && syntax.node(first).kind === 'Identifier') { imported = first; }
   let at = specifier; for(let steps = 0; at !== 0 && steps < 5; steps++) { const part = syntax.node(at); if(part.kind === 'ImportDeclaration') { const module = part.children.find((child) => ['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(syntax.node(child).kind)); if(module !== undefined && ['react', 'react-dom'].includes(syntax.node(module).text.toLowerCase())) { return imported !== 0 && syntax.node(imported).kind === 'Identifier' ? syntax.node(imported).text : ''; } return ''; } at = part.parent; }
  } return '';
 }
 kind(index: number): string { const node = this.syntax.node(index); if(node.kind === 'Identifier') { const name = this.binding(index, false); return ['useMemo', 'useCallback'].includes(name) ? name : ''; } if(node.kind === 'PropertyAccessExpression' && node.name !== 0 && node.expression !== 0) { const property = this.syntax.node(node.name); if(property.kind === 'Identifier' && ['useMemo', 'useCallback'].includes(property.text) && this.binding(node.expression, true) === 'React') { return property.text; } } return ''; }
 simple(index: number): boolean { const syntax = this.syntax; let at = index; while(at !== 0) { const node = syntax.node(at); if(node.kind === 'Identifier') { return true; } if(['PropertyAccessExpression', 'NonNullExpression'].includes(node.kind)) { at = node.expression; } else if(node.kind === 'ElementAccessExpression' && syntax.node(node.children[node.children.length - 1] ?? 0).kind === 'NumericLiteral') { at = node.expression; } else { return false; } } return false; }
 deps(index: number): void { const node = this.syntax.node(index); if(node.kind !== 'ArrayLiteralExpression' || node.children.some((child) => ['SpreadElement', 'OmittedExpression'].includes(this.syntax.node(child).kind))) { this.report(index, 'useMemoDependencyListNotArrayLiteral'); return; } for(const child of node.children) { if(!this.simple(child)) { this.report(child, 'useMemoDependencyNotSimple'); } } }
 within(index: number, ancestor: number): boolean { for(let at = index; at !== 0; at = this.syntax.node(at).parent) { if(at === ancestor) { return true; } } return false; }
 writes(index: number, callback: number): void { const syntax = this.syntax; const node = syntax.node(index); if(index !== callback && ['FunctionDeclaration','FunctionExpression','ArrowFunction','MethodDeclaration','GetAccessor','SetAccessor','Constructor'].includes(node.kind)) { return; }
  if(node.kind === 'BinaryExpression' && ['EqualsToken','PlusEqualsToken','MinusEqualsToken','AsteriskEqualsToken','AsteriskAsteriskEqualsToken','SlashEqualsToken','PercentEqualsToken','LessThanLessThanEqualsToken','GreaterThanGreaterThanEqualsToken','GreaterThanGreaterThanGreaterThanEqualsToken','AmpersandEqualsToken','BarEqualsToken','CaretEqualsToken','AmpersandAmpersandEqualsToken','BarBarEqualsToken','QuestionQuestionEqualsToken'].includes(node.operator)) { const target = node.children[0] ?? 0; if(target !== 0 && syntax.node(target).kind === 'Identifier') { const declarations = this.symbols.get(target).declarations; if(declarations.length > 0 && !declarations.some((decl) => decl.file === syntax.path && this.within(syntax.locate(decl.kind, decl.pos, decl.end), callback))) { this.report(target, 'useMemoCallbackReassignsOuterVariable'); } } }
  for(const child of node.children) { this.writes(child, callback); }
 }
 run(): void { const syntax = this.syntax; for(let at = 1; at <= syntax.nodes.length; at++) { const node = syntax.node(at); if(node.kind !== 'CallExpression' || node.expression === 0) { continue; } const kind = this.kind(node.expression); if(kind === '' || !this.gate.inside(at)) { continue; } const args = node.arguments; if(args.length === 0) { this.report(at, 'useMemoMissingCallback'); continue; } const callback = args[0] ?? 0; const fn = syntax.node(callback); const inline = ['ArrowFunction', 'FunctionExpression'].includes(fn.kind); if(!inline) { if(fn.kind === 'SpreadElement') { continue; } this.report(callback, 'useMemoCallbackNotInline'); } if(args.length > 1) { this.deps(args[1] ?? 0); } if(inline && kind === 'useMemo') { const params = this.gate.parameters(callback); const first = params[0]; if(first !== undefined) { this.report(first, 'useMemoCallbackHasParameters'); } if((fn.functionFlags & 3) !== 0) { this.report(callback, 'useMemoCallbackAsyncOrGenerator'); } if(fn.body !== 0) { for(const child of syntax.node(fn.body).children) { this.writes(child, callback); } } }
 } }
}
