import { panic } from 'adamic';
import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export function importRuntimeNames(rules: Rules, root: number): readonly string[] {
    const frames = new Frames(rules.ask(root, 'import-runtime-options'));
    header(frames, 'import-runtime-options');
    const metadata = frames.yes();
    const factory = frames.field();
    const fragment = frames.field();
    frames.end();
    if(metadata) { panic('wave 03 requires emitDecoratorMetadata disabled; metadata imports are not yet ported'); }
    return [factory === '' ? 'React' : (factory.split('.')[0] ?? '').trim(), (fragment.split('.')[0] ?? '').trim()];
}
