import type { Bindings } from './bindings.ts';
import { SymbolLineage, symbolIdentity } from './symbol_lineage.a';
import { Diagnostic } from './diagnostic.ts';

const message = "This `setTimeout` arms the losing side of a `Promise.race`, and its handle is thrown away, so nothing can ever clear it. When the work wins the race, the timer stays armed for its whole duration: in Node it holds the process open (a batch that finished its last item sits until the timeout elapses), and its callback still runs, rejecting a promise nobody is waiting on. Keep the handle (`timer = setTimeout(...)`) and `clearTimeout(timer)` in a `finally` around the race.";
// Numeric TypeScript SyntaxKind listeners, matching the pinned Go cohere registry.
export const unclearedRaceTimeoutSyntaxKinds: readonly number[] = [214];

export class UnclearedRaceTimeout {
    readonly syntaxKinds = unclearedRaceTimeoutSyntaxKinds;
    readonly bindings: Bindings;
    constructor(bindings: Bindings) { this.bindings = bindings; }
    outer(index: number): number {
        while(this.bindings.parent(index) >= 0 && this.bindings.rules.parser.node(this.bindings.parent(index)).kind === 'ParenthesizedExpression') { index = this.bindings.parent(index); }
        return index;
    }
    plainTarget(index: number): boolean {
        const outer = this.outer(index); const parent = this.bindings.rules.parser.node(this.bindings.parent(outer));
        return parent.kind === 'BinaryExpression' && this.bindings.rules.parser.node(parent.children[1] ?? -1).kind === 'EqualsToken' && parent.children[0] === outer;
    }
    neverRead(index: number): boolean {
        const rules = this.bindings.rules; const symbol = new SymbolLineage(rules, index, false);
        if(symbol.declarations.length !== 1 || symbol.declarations[0]?.kind !== 'VariableDeclaration' || symbol.declarations[0]?.file !== rules.path) { return false; }
        const declarations = this.bindings.list(index, 'binding-declarations', false);
        if(declarations.length !== 1) { return false; }
        const declared = this.bindings.shape.name(declarations[0] ?? -1); const name = rules.parser.node(declared).text;
        for(let at = 0; at < rules.parser.nodes.length; at++) {
            const node = rules.parser.node(at);
            if(this.bindings.parent(at) >= 0 && at !== declared && node.kind === 'Identifier' && node.text === name &&
                symbolIdentity(rules, at) === symbol.identity && !this.plainTarget(at)) { return false; }
        }
        return true;
    }
    lost(executor: number, call: number): boolean {
        const rules = this.bindings.rules; const outer = this.outer(call); const parentIndex = this.bindings.parent(outer); const parent = rules.parser.node(parentIndex);
        if(['ExpressionStatement', 'VoidExpression'].includes(parent.kind) || parentIndex === executor) { return true; }
        if(parent.kind === 'VariableDeclaration' && this.bindings.shape.initializer(parentIndex) === outer) {
            const name = this.bindings.shape.name(parentIndex);
            return rules.parser.node(name).kind === 'Identifier' && this.neverRead(name);
        }
        if(parent.kind !== 'BinaryExpression' || rules.parser.node(parent.children[1] ?? -1).kind !== 'EqualsToken' || parent.children[2] !== outer) { return false; }
        const target = rules.skip(parent.children[0] ?? -1);
        return rules.parser.node(target).kind === 'Identifier' && rules.parser.node(this.bindings.parent(this.outer(parentIndex))).kind === 'ExpressionStatement' && this.neverRead(target);
    }
    timer(index: number): boolean {
        const rules = this.bindings.rules; const callee = rules.parser.node(rules.skip(rules.parser.node(index).children[0] ?? -1));
        let name = rules.skip(rules.parser.node(index).children[0] ?? -1);
        if(callee.kind === 'PropertyAccessExpression') {
            const receiver = rules.parser.node(rules.skip(callee.children[0] ?? -1));
            if(receiver.kind !== 'Identifier' || !['globalThis', 'window'].includes(receiver.text)) { return false; }
            name = callee.children[callee.children.length - 1] ?? -1;
        } else if(callee.kind !== 'Identifier') { return false; }
        if(rules.parser.node(name).kind !== 'Identifier' || rules.parser.node(name).text !== 'setTimeout') { return false; }
        const declarations = new SymbolLineage(rules, name, false).declarations;
        return declarations.length > 0 && declarations.every((declaration) => declaration.declarationFile &&
            ((declaration.parentKind === 'SourceFile' && declaration.external[0] === false) ||
                (declaration.parentKind === 'ModuleBlock' && declaration.augmentation[1] === true) ||
                (declaration.parentKind === 'InterfaceDeclaration' && declaration.parentName === 'WindowOrWorkerGlobalScope' && declaration.defaultLibrary)));
    }
    visit(index: number, executor: number): void {
        const rules = this.bindings.rules; const node = rules.parser.node(index);
        if(this.bindings.functionKind(node.kind) || ['ClassDeclaration', 'ClassExpression'].includes(node.kind)) { return; }
        if(node.kind === 'CallExpression' && this.timer(index) && this.lost(executor, index)) {
            rules.findings.push(new Diagnostic('nexus/correctness-no-uncleared-race-timeout', 'unclearedRaceTimeout', message,
                rules.byte(rules.start(node)), rules.byte(node.end), ''));
        }
        for(const child of node.children) { this.visit(child, executor); }
    }
    promise(index: number): number {
        const rules = this.bindings.rules;
        if(rules.parser.node(index).kind === 'Identifier') {
            const symbol = new SymbolLineage(rules, index, false);
            if(symbol.declarations.length !== 1 || symbol.declarations[0]?.kind !== 'VariableDeclaration' || symbol.declarations[0]?.file !== rules.path) { return -1; }
            const declarations = this.bindings.list(index, 'binding-declarations', false); const declaration = declarations[0] ?? -1;
            if(declarations.length !== 1 || rules.parser.node(this.bindings.parent(declaration)).semantic !== '2') { return -1; }
            const initializer = this.bindings.shape.initializer(declaration);
            if(initializer < 0) { return -1; }
            index = rules.skip(initializer);
        }
        const node = rules.parser.node(index);
        if(node.kind !== 'NewExpression') { return -1; }
        const constructor = rules.skip(node.children[0] ?? -1); const name = rules.parser.node(constructor);
        return name.kind === 'Identifier' && name.text === 'Promise' && new SymbolLineage(rules, constructor, false).declarations.some((declaration) => declaration.defaultLibrary) ? index : -1;
    }
    check(index: number): void {
        const rules = this.bindings.rules; const call = rules.parser.node(index); const callee = rules.parser.node(rules.skip(call.children[0] ?? -1));
        if(callee.kind !== 'PropertyAccessExpression' || call.list === 0) { return; }
        const name = callee.children[callee.children.length - 1] ?? -1;
        if(rules.parser.node(name).kind !== 'Identifier' || rules.parser.node(name).text !== 'race') { return; }
        const declarations = new SymbolLineage(rules, name, false).declarations;
        if(declarations.length === 0 || !declarations.every((declaration) => declaration.defaultLibrary && declaration.parentKind === 'InterfaceDeclaration' && declaration.parentName === 'PromiseConstructor')) { return; }
        const array = rules.parser.node(rules.skip(call.children[call.children.length - call.list] ?? -1));
        if(array.kind !== 'ArrayLiteralExpression') { return; }
        for(const element of array.children) {
            const promiseIndex = this.promise(rules.skip(element));
            if(promiseIndex < 0) { continue; }
            const promise = rules.parser.node(promiseIndex);
            if(promise.kind !== 'NewExpression' || promise.list === 0) { continue; }
            const executor = rules.skip(promise.children[promise.children.length - promise.list] ?? -1); const functionNode = rules.parser.node(executor);
            if(!['ArrowFunction', 'FunctionExpression'].includes(functionNode.kind)) { continue; }
            this.visit(functionNode.children[functionNode.children.length - 1] ?? -1, executor);
        }
    }
    run(): void {
        const rules = this.bindings.rules;
        for(let index = 0; index < rules.parser.nodes.length; index++) {
            if(this.bindings.parent(index) >= 0 && rules.parser.node(index).kind === 'CallExpression') { this.check(index); }
        }
    }
}
