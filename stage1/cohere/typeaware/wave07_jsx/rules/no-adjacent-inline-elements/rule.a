import type { Document } from '../../document.a';
import type { Node } from '../../node.a';
import type { Pragma } from '../../pragma.a';
export const listenerKinds: readonly number[] = [214, 285];
const inlineNames = [
    'a',
    'b',
    'big',
    'i',
    'small',
    'tt',
    'abbr',
    'acronym',
    'cite',
    'code',
    'dfn',
    'em',
    'kbd',
    'strong',
    'samp',
    'time',
    'var',
    'bdo',
    'br',
    'img',
    'map',
    'object',
    'q',
    'script',
    'span',
    'sub',
    'sup',
    'button',
    'input',
    'label',
    'select',
    'textarea',
];
// Go unicode.IsSpace, including `U+0085` and excluding `U+FEFF`.
function space(code: number): boolean {
    return (
        (code >= 9 && code <= 13) ||
        [32, 133, 160, 5760, 8232, 8233, 8239, 8287, 12288].includes(code) ||
        (code >= 8192 && code <= 8202)
    );
}
export class Rule {
    readonly document: Document;
    readonly pragma: Pragma;
    constructor(document: Document, pragma: Pragma) {
        this.document = document;
        this.pragma = pragma;
    }
    jsx(child: Node): boolean {
        if(child.kind !== 285 && child.kind !== 286) {
            return false;
        }
        const name = this.document.tag(child);
        return name.kind === 79 && inlineNames.includes(name.text);
    }
    call(child: Node): boolean {
        if([8, 9, 10, 13, 96, 105, 111].includes(child.kind)) {
            return (
                child.kind !== 10 ||
                child.text === '' ||
                (!space(child.text.charCodeAt(0)) && !space(child.text.charCodeAt(child.text.length - 1)))
            );
        }
        if(child.kind !== 214) {
            return false;
        }
        const args = this.document.args(child);
        if(args.length === 0) {
            return false;
        }
        const first = this.document.node(args[0] ?? -1);
        return first.kind === 10 && inlineNames.includes(first.text);
    }
    visit(node: Node): void {
        let children: number[];
        const jsx = node.kind === 285;
        if(jsx) {
            children = node.children.slice(1, node.children.length - 1);
        }
        else {
            if(!this.pragma.createElement(node)) {
                return;
            }
            const args = this.document.args(node);
            if(args.length < 3) {
                return;
            }
            const third = this.document.node(args[2] ?? -1);
            if(third.kind !== 210) {
                return;
            }
            children = third.children;
        }
        let previous = false;
        for(const index of children) {
            const child = this.document.node(index);
            const current = jsx ? this.jsx(child) : this.call(child);
            if(previous && current) {
                this.document.report(
                    node,
                    'no-adjacent-inline-elements',
                    'inlineElement',
                    'These two inline elements sit directly against each other with nothing between them, so the browser renders them as one run of text with no gap. What reads as two separate links or labels in the source arrives as a single unbroken word on the page, and the reader has no way to see where one ends. Put a space between them, or wrap them in block-level elements that separate themselves.',
                );
                return;
            }
            previous = current;
        }
    }
}
