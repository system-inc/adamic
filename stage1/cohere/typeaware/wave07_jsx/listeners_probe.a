import { listenerKinds as fragments } from './rules/jsx-fragments/rule.a';
import { listenerKinds as undef } from './rules/jsx-no-undef/rule.a';
import { listenerKinds as adjacent } from './rules/no-adjacent-inline-elements/rule.a';
