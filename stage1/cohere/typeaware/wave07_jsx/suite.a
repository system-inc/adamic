import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { loadDocument } from './document.a';
import type { Document } from './document.a';
import type { Node } from './node.a';
import { Symbols } from './symbols.a';
import { Pragma } from './pragma.a';
import { numericKind } from './kinds.a';
import { Rule as Fragments, listenerKinds as fragmentKinds } from './rules/jsx-fragments/rule.a';
import { Rule as Undef, listenerKinds as undefKinds } from './rules/jsx-no-undef/rule.a';
import { Rule as Adjacent, listenerKinds as adjacentKinds } from './rules/no-adjacent-inline-elements/rule.a';

const routes = new Map<number, number[]>();
function listen(kinds: readonly string[], rule: number): void {
    for(const name of kinds) {
        const kind = numericKind(name);
        const previous = routes.get(kind);
        if(previous === undefined) {
            routes.set(kind, [rule]);
        }
        else {
            previous.push(rule);
        }
    }
}
listen(fragmentKinds, 0);
listen(undefKinds, 1);
listen(adjacentKinds, 2);
function dispatch(
    document: Document,
    node: Node,
    fragments: Fragments,
    undef: Undef,
    adjacent: Adjacent,
    selected: string,
): void {
    const listeners = routes.get(node.kind);
    if(listeners !== undefined) {
        for(const rule of listeners) {
            if(rule === 0 && (selected === '' || selected === 'fragments')) {
                fragments.visit(node);
            }
            else if(rule === 1 && (selected === '' || selected === 'undef')) {
                undef.visit(node);
            }
            else if(rule === 2 && (selected === '' || selected === 'adjacent')) {
                adjacent.visit(node);
            }
        }
    }
    for(const child of node.children) {
        dispatch(document, document.node(child), fragments, undef, adjacent, selected);
    }
}
const args = programArguments();
const config = args[0] ?? panic('missing tsconfig');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
const selected = args[2] ?? '';
let findings = 0;
for(const path of paths) {
    const document = loadDocument(program, path);
    const symbols = new Symbols(document);
    const pragma = new Pragma(document, symbols);
    const fragments = new Fragments(document, pragma, args.includes('--element'));
    const undef = new Undef(document, symbols, args.includes('--allow-globals'));
    const adjacent = new Adjacent(document, pragma);
    dispatch(document, document.node(document.root), fragments, undef, adjacent, selected);
    const lines = document.findings
        .map((finding) => finding.written())
        .sort((left, right) => (left < right ? -1 : left > right ? 1 : 0));
    findings += lines.length;
    console.log(`file\t${written(path)}`);
    for(const line of lines) {
        console.log(line);
    }
}
console.log(`findings ${findings}`);
tsgoRelease(program);
