// Numeric SyntaxKind listeners for the shared kind-indexed driver.
export const listenerKinds: readonly string[] = ["SourceFile"];
import { panic } from 'adamic';
import { Diagnostic } from '../diagnostic.ts';

// Reporting portion only. Analysis requires the native React compiler IR.
export class Refs {
    render(id: string, start: number, end: number): Diagnostic {
        let message = '';
        if(id === "refValueAccess") { message = "Cannot access ref value during render. A ref is deliberately outside React's data flow: writing one does not schedule a render, and during render the ref may not yet point at the element it will point at once the tree commits. Reading it here therefore gives a value that is stale or not yet attached, and because the read creates no subscription nothing re-renders when it changes. Move the access into an event handler or an effect, where the ref is attached and a stale read cannot be observed."; }
        if(id === "refPassedToFunction") { message = "Passing a ref to a function may read its value during render. A ref is deliberately outside React's data flow: writing one does not schedule a render, and during render the ref may not yet point at the element it will point at once the tree commits. Reading it here therefore gives a value that is stale or not yet attached, and because the read creates no subscription nothing re-renders when it changes. Move the access into an event handler or an effect, where the ref is attached and a stale read cannot be observed."; }
        if(id === "refUpdate") { message = "Cannot update ref during render. A ref is deliberately outside React's data flow: writing one does not schedule a render, and during render the ref may not yet point at the element it will point at once the tree commits. Reading it here therefore gives a value that is stale or not yet attached, and because the read creates no subscription nothing re-renders when it changes. Move the access into an event handler or an effect, where the ref is attached and a stale read cannot be observed."; }
        if(id === "functionAccessesRef") { message = "This function accesses a ref value, and calling it during render reads the ref. A ref is deliberately outside React's data flow: writing one does not schedule a render, and during render the ref may not yet point at the element it will point at once the tree commits. Reading it here therefore gives a value that is stale or not yet attached, and because the read creates no subscription nothing re-renders when it changes. Move the access into an event handler or an effect, where the ref is attached and a stale read cannot be observed."; }
        if(id === "refTypeEnvironmentDidNotConverge") { message = "The ref analysis did not settle after ten passes over this function, so its result is not trustworthy and no ref finding is reported for it. This is an internal invariant rather than a problem with the code, and it reproduces upstream's own bound."; }
        if(message === '') { panic('unknown ref finding kind'); }
        return new Diagnostic('react-hooks/refs', id, message, start, end, '');
    }
    analyze(): void { panic('NotYet: refs needs native React HIR, SSA/phi values and its ten-round ref lattice'); }
}
