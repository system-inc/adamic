import type { SyntaxProjection } from './syntax_projection.a';
import { DeclaredSyntaxTypes } from './declared_syntax_type.a';
export class ReactCompilationGate {
 readonly syntax: SyntaxProjection; readonly types: DeclaredSyntaxTypes; readonly roots = new Map<number, boolean>();
 constructor(syntax: SyntaxProjection) { this.syntax = syntax; this.types = new DeclaredSyntaxTypes(syntax); }
 function(index: number): boolean { return ['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction'].includes(this.syntax.node(index).kind); }
 upper(text: string): boolean { const char = text[0] ?? ''; return char >= 'A' && char <= 'Z'; }
 hook(text: string): boolean { const char = text[3] ?? ''; return text.startsWith('use') && ((char >= 'A' && char <= 'Z') || (char >= '0' && char <= '9')); }
 parent(index: number): number { let parent = this.syntax.node(index).parent; while(parent !== 0 && this.syntax.node(parent).kind === 'ParenthesizedExpression') { parent = this.syntax.node(parent).parent; } return parent; }
 name(index: number): string { const syntax = this.syntax; const node = syntax.node(index); let name = 0;
  if(node.kind === 'FunctionDeclaration') { name = node.name; }
  else if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) { const parent = this.parent(index); if(parent !== 0 && syntax.node(parent).kind === 'VariableDeclaration' && syntax.skip(syntax.node(parent).initializer) === index) { name = syntax.node(parent).name; } }
  return name !== 0 && syntax.node(name).kind === 'Identifier' ? syntax.node(name).text : '';
 }
 named(index: number): boolean { const name = this.name(index); return this.upper(name) || this.hook(name); }
 parameters(index: number): readonly number[] { return this.syntax.node(index).children.filter((child) => this.syntax.node(child).kind === 'Parameter'); }
 hookCall(index: number): boolean { const syntax = this.syntax; const node = syntax.node(index); if(node.kind === 'Identifier') { return this.hook(node.text); } return node.kind === 'PropertyAccessExpression' && node.name !== 0 && syntax.node(node.name).kind === 'Identifier' && this.hook(syntax.node(node.name).text) && node.expression !== 0 && syntax.node(node.expression).kind === 'Identifier' && this.upper(syntax.node(node.expression).text); }
 evidence(index: number): boolean { const syntax = this.syntax; const node = syntax.node(index); if(['JsxElement','JsxSelfClosingElement','JsxFragment','JsxOpeningElement','JsxOpeningFragment','JsxExpression','JsxText','JsxAttribute','JsxAttributes','JsxSpreadAttribute'].includes(node.kind)) { return true; } if(node.kind === 'CallExpression' && node.expression !== 0 && this.hookCall(node.expression)) { return true; } if(this.function(index)) { return false; } return node.children.some((child) => this.evidence(child)); }
 props(index: number): boolean { const syntax = this.syntax; const parameters = this.parameters(index); if(parameters.length === 0) { return true; } if(parameters.length > 2) { return false; } const first = parameters[0] ?? 0; if(syntax.node(first).children.some((child) => syntax.node(child).kind === 'DotDotDotToken')) { return false; } const type = this.types.get(first); if(type !== 0 && ['ArrayType','BigIntKeyword','BooleanKeyword','ConstructorType','FunctionType','LiteralType','NeverKeyword','NumberKeyword','StringKeyword','SymbolKeyword','TupleType'].includes(syntax.node(type).kind)) { return false; } if(parameters.length === 1) { return true; } const name = syntax.node(parameters[1] ?? 0).name; return name !== 0 && syntax.node(name).kind === 'Identifier' && (syntax.node(name).text.includes('ref') || syntax.node(name).text.includes('Ref')); }
 like(index: number): boolean { const node = this.syntax.node(index); const name = this.name(index); if(!this.hook(name) && !(this.upper(name) && this.props(index))) { return false; } if(node.body === 0) { return false; } const body = this.syntax.node(node.body); return body.children.some((child) => this.evidence(child)) || (body.kind !== 'Block' && this.evidence(node.body)); }
 reachable(index: number): boolean { const syntax = this.syntax; for(let at = syntax.node(index).parent; at !== 0; at = syntax.node(at).parent) { const node = syntax.node(at); if(node.kind === 'SourceFile') { return true; } if(['VariableDeclaration','VariableDeclarationList','VariableStatement','ExportAssignment','ExportDeclaration','ParenthesizedExpression'].includes(node.kind)) { continue; } if(this.function(at)) { if(!this.named(at)) { return false; } continue; } if(node.kind === 'Block' && node.parent !== 0 && this.function(node.parent)) { continue; } return false; } return false; }
 inside(index: number): boolean { const cached = this.roots.get(index); if(cached !== undefined) { return cached; } let found = false; for(let at = this.syntax.node(index).parent; at !== 0; at = this.syntax.node(at).parent) { if(this.like(at) && this.reachable(at)) { found = true; break; } } this.roots.set(index, found); return found; }
}
