                this.expr(node.children[0] ?? -1); const join = this.make(); const right = this.make(); this.link(this.current, join); this.link(this.current, right); this.enter(right); this.expr(node.children[2] ?? -1); this.link(this.current, join); this.enter(join); return;
            }
