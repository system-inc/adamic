            this.condition(node.children[0] ?? -1, yes, no); this.enter(yes); this.statement(node.children[1] ?? -1); this.link(this.current, after);
            if(no !== after) { this.enter(no); this.statement(node.children[2] ?? -1); this.link(this.current, after); } this.enter(after); return;
