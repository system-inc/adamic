    enter(index: number): void { this.block(index).reachable = this.block(index).incoming; this.current = index; }
    unreachable(): void { const next = this.make(); this.block(this.current).successors.push(next); this.current = next; }
    emit(kind: number, node: number): void { const event = new CodeEvent(kind, node); this.block(this.current).events.push(event); this.events.push(event); }
    rootKind(index: number): boolean { return this.bindings.functionKind(this.kind(index)) || ['SourceFile', 'ClassStaticBlockDeclaration'].includes(this.kind(index)) || (this.kind(index) === 'PropertyDeclaration' && this.bindings.shape.initializer(index) >= 0); }
    rootOf(index: number): number {
