                else if(node.kind === 'ClassStaticBlockDeclaration') { if(node.children[node.children.length - 1] === previous) { return current; } }
                else if(this.bindings.shape.name(current) !== previous && !(decorator >= 0 && [current, previous].includes(this.bindings.parent(decorator)))) { return current; }
