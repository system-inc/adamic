// Private port of cohere's syntax-only control_flow_graph builder.
// Event hooks run before expressions/statements, including unreachable blocks.
import { panic } from 'adamic';
import type { Rules } from '../rules.ts';
import type { Bindings } from '../bindings.ts';
import { Returns } from '../returns.ts';

export class CodeEvent { readonly kind: number; readonly node: number; constructor(kind: number, node: number) { this.kind = kind; this.node = node; } }
export class CodeBlock { readonly events: CodeEvent[] = []; readonly successors: number[] = []; incoming = false; reachable = false; }
class CodeTry { position = 0; catchEntry = -1; finallyEntry = -1; forked = false; thrown = false; returned = false; }
class CodeJump {
    readonly labels: readonly string[]; readonly breakTo: number; readonly continueTo: number; readonly breakable: boolean;
    constructor(labels: readonly string[], breakTo: number, continueTo: number, breakable: boolean) { this.labels = labels; this.breakTo = breakTo; this.continueTo = continueTo; this.breakable = breakable; }
}
export class CodeGraph {
    readonly rules: Rules; readonly bindings: Bindings; readonly syntax: Returns; readonly root: number;
    readonly events: CodeEvent[] = []; readonly blocks: CodeBlock[] = []; readonly tries: CodeTry[] = []; readonly jumps: CodeJump[] = []; readonly chainJoins: number[] = [];
    current = 0;
    constructor(rules: Rules, bindings: Bindings, syntax: Returns, root: number) { this.rules = rules; this.bindings = bindings; this.syntax = syntax; this.root = root; }
    kind(index: number): string { return index < 0 ? '' : this.rules.parser.node(index).kind; }
    block(index: number): CodeBlock { return this.blocks[index] ?? panic('missing control-flow block'); }
    make(): number { const index = this.blocks.length; this.blocks.push(new CodeBlock()); return index; }
    link(from: number, to: number): void {
        if(from < 0 || to < 0) { return; } this.block(from).successors.push(to);
        if(this.block(from).reachable) { this.block(to).incoming = true; }
