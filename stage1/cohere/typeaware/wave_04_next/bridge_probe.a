import {programArguments, tsgoProgram, tsgoInspect, tsgoRelease} from 'adamic';
const args = programArguments();
const path = args[1] ?? '';
const handle = tsgoProgram(args[0] ?? '', [path]);
const result = tsgoInspect(handle, path, 0, 2, 'SourceFile', args[2] ?? 'declaration-details');
tsgoRelease(handle);
console.log(result);
