import {panic, programArguments, readTextFile, tsgoProgram, tsgoRelease} from 'adamic';
import {Scanner} from '../../../typescript/scanner/scanner.ts';
import {Parser} from '../../../typescript/parser/parser.ts';
import {Rules} from '../rules.ts';
import {UnaryMinus, byteOffsets} from '../unary_minus.ts';
import {SymbolDeclarationContext} from './declaration_context.a';
import {ResolvedSignatureDeclaration} from './resolved_signature_declaration.a';
const args = programArguments(); const path = args[1] ?? ''; const source = readTextFile(path);
if(source.kind === 'Error') { panic(source.message); }
const parser = new Parser(source.text, path); const scanner = new Scanner(source.text);
const program = tsgoProgram(args[0] ?? '', [path]); const offsets = byteOffsets(source.text);
const unary = new UnaryMinus(program, path, parser, scanner, offsets);
const rules = new Rules(program, path, parser, scanner, offsets, unary); parser.file();
const call = parser.nodes.findIndex((node) => node.kind === 'CallExpression');
console.log(new SymbolDeclarationContext(rules, parser.node(call).children[0] ?? -1).name);
console.log(`${new ResolvedSignatureDeclaration(rules, call).returnFlags}`);
tsgoRelease(program);
