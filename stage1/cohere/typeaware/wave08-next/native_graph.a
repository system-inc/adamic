            kind.endsWith('Statement') ||
            [
                'Block',
                'VariableStatement',
                'ClassDeclaration',
                'FunctionDeclaration',
                'ImportDeclaration',
                'ImportEqualsDeclaration',
                'ExportAssignment',
                'ExportDeclaration',
                'InterfaceDeclaration',
                'TypeAliasDeclaration',
                'EnumDeclaration',
                'ModuleDeclaration',
            ].includes(kind)
        ) {
            this.statement(index);
        }
        else {
            this.expr(index);
