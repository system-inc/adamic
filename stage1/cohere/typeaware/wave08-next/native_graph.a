            return this.node(this.parent(parent)).kind === 'ObjectBindingPattern';
        }
        if(
            [
                'FunctionDeclaration',
                'FunctionExpression',
                'ArrowFunction',
                'ClassDeclaration',
                'ClassExpression',
                'VariableDeclaration',
                'PropertyAssignment',
                'PropertyDeclaration',
                'MethodDeclaration',
                'GetAccessor',
                'SetAccessor',
                'EnumDeclaration',
                'ModuleDeclaration',
                'InterfaceDeclaration',
