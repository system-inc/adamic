            }
            else if(
                [
                    'PropertyDeclaration',
                    'MethodDeclaration',
                    'GetAccessor',
                    'SetAccessor',
                    'Constructor',
                    'IndexSignature',
                    'ClassStaticBlockDeclaration',
                ].includes(kind)
            ) {
