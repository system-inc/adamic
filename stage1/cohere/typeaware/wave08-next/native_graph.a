            [
                'LabeledStatement',
                'BreakStatement',
                'ContinueStatement',
                'ArrayBindingPattern',
                'ImportSpecifier',
                'ExportSpecifier',
                'ImportClause',
                'NamespaceImport',
                'NamespaceExport',
                'JsxAttribute',
                'JsxNamespacedName',
                'CatchClause',
            ].includes(kind)
        ) {
