            }
            return;
        }
        if(kind === 'ExpressionStatement') {
            this.expr(this.child(index, 0));
            return;
        }
        if(kind === 'IfStatement') {
            const after = this.fresh();
            const yes = this.fresh();
            const elseNode = this.child(index, 2);
            const no = elseNode >= 0 ? this.fresh() : after;
            this.condition(this.child(index, 0), yes, no);
            this.enter(yes);
            this.statement(this.child(index, 1));
            this.link(this.current, after);
            if(elseNode >= 0) {
                this.enter(no);
                this.statement(elseNode);
                this.link(this.current, after);
            }
            this.enter(after);
            return;
        }
        if(['WhileStatement', 'DoStatement', 'ForStatement', 'ForInStatement', 'ForOfStatement'].includes(kind)) {
            this.loop(index);
            return;
        }
        if(kind === 'SwitchStatement') {
            this.switchStatement(index);
            return;
        }
        if(kind === 'TryStatement') {
            this.tryStatement(index);
            return;
        }
        if(kind === 'LabeledStatement') {
            const body = this.last(index);
            if(this.breakable(body)) {
                this.statement(body);
                return;
            }
            const after = this.fresh();
            this.jumps.push(new Jump([this.node(this.child(index, 0)).text], after, -1, false));
            this.statement(body);
            this.jumps.pop();
            this.link(this.current, after);
            this.enter(after);
            return;
        }
        if(kind === 'ReturnStatement' || kind === 'ThrowStatement') {
