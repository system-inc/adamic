import { ParseNode } from '../../../typescript/parser/nodes.ts';
// Control-flow shape ported from cohere's pinned control_flow_graph builders.
// Event hooks run before evaluation. Read/write hooks are unnecessary here.
import type { Rules } from '../rules.ts';
import { Bindings } from '../bindings.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { ProcessGraph, ProcessBlock, ProcessEvent } from './process_flow.a';
import { panic } from 'adamic';
class TryFrame {
