            this.abrupt(kind === 'ReturnStatement');
            return;
        }
        if(kind === 'BreakStatement' || kind === 'ContinueStatement') {
            if(!this.block(this.current).reachable) {
                return;
            }
            const label = this.node(this.child(index, 0)).text;
            for(let at = this.jumps.length - 1; at >= 0; at--) {
                const jump = this.jumps[at];
                if(jump === undefined) {
