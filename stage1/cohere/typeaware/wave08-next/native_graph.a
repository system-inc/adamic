                }
                const target = kind === 'ContinueStatement' ? jump.continueTo : jump.breakTo;
                if(
                    target < 0 ||
                    (label !== '' && !jump.labels.includes(label)) ||
                    (label === '' && kind === 'BreakStatement' && !jump.breakable)
