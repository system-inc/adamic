import type { Rules } from '../rules.ts';
import { Diagnostic } from '../diagnostic.ts';
import { ProcessGraph, walkProcess } from './process_flow.a';
import { ResolvedCallee } from './resolved_callee.a';
import { ProcessPool, ProcessFile, TryChains } from './process_context.a';
import { NativeGraph } from './native_graph.a';
import { ProcessEvent } from './process_flow.a';
import { panic } from 'adamic';
// Pinned parser SyntaxKind listener declaration for the shared kind-indexed driver.
export const listenerKinds: readonly number[] = [307];
const message =
    'This calls `process.exit()` on a path that has already written to stdout or stderr in this function. `process.exit()` ends the process without waiting for writes still in flight, and a write to a pipe can be one: a reader piping this command (`| grep`, `execSync`, a spawned child) gets the output cut at 64 KB, with exit status 0 and no error. Set `process.exitCode = n` and return instead, so the process ends on its own once the output has drained.';
export class NoProcessExitAfterOutput {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    // One-level callee eligibility is native. The raw question supplies the
    // actual overload declaration, not an arbitrarily selected symbol declaration.
    followedCallee(call: number): ResolvedCallee | undefined {
        const fact = new ResolvedCallee(this.rules, call);
        if(
            !fact.present ||
            !['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration'].includes(fact.kind) ||
            !fact.hasBody
        ) {
            return undefined;
        }
        if(fact.path !== this.rules.path && !fact.externalModule) {
            return undefined;
        }
        if((fact.functionFlags & 1) !== 0) {
            return undefined;
        }
        let outer = call;
        while(this.rules.parser.node(this.rules.parents[outer] ?? -1).kind === 'ParenthesizedExpression') {
            outer = this.rules.parents[outer] ?? -1;
        }
        if(
            (fact.functionFlags & 2) !== 0 &&
            this.rules.parser.node(this.rules.parents[outer] ?? -1).kind !== 'AwaitExpression'
        ) {
            return undefined;
        }
        if((fact.returnFlags & 262144) !== 0) {
            return undefined;
        }
        return fact;
    }
    reportGraph(graph: ProcessGraph, exitOrder: readonly number[]): void {
        const found = walkProcess(graph, false, false).exits;
        for(const exit of exitOrder) {
            if(!found.includes(exit)) {
                continue;
            }
            const node = this.rules.parser.node(exit);
            this.rules.findings.push(
                new Diagnostic(
                    'nexus/correctness-no-process-exit-after-output',
                    'exitAfterOutput',
                    message,
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    '',
                ),
            );
        }
    }
    run(pool: ProcessPool, root: number): void {
        const file = pool.remember(this.rules, root);
        const roots = new Map<number, number[]>();
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            if(file.parent(at) < 0 || !file.isExit(at)) {
                continue;
            }
            const own = file.rootOf(at);
            if(own < 0) {
                continue;
            }
            if(!roots.has(own)) {
                const values: number[] = [];
                roots.set(own, values);
            }
            const found = roots.get(own);
            if(found !== undefined) {
                found.push(at);
            }
        }
        const writers = new Map<string, boolean>();
        for(const [own, exits] of roots) {
            const calls = file.ownCalls(own);
            const writes = new Set<number>();
            for(const call of calls) {
                if(file.isWrite(call)) {
                    writes.add(call);
                    continue;
                }
                const callee = this.followedCallee(call);
                if(callee === undefined) {
                    continue;
                }
                const key = `${callee.path}:${callee.start}:${callee.end}`;
                if(!writers.has(key)) {
                    const target = pool.get(callee.path);
                    writers.set(key, target.ownBodyWrites(target.find(callee.kind, callee.start, callee.end)));
                }
                if(writers.get(key) ?? false) {
                    writes.add(call);
                }
            }
            if(writes.size === 0) {
                continue;
            }
            const chains = new TryChains(file, own);
            const events = new Map<number, ProcessEvent[]>();
            for(const call of calls) {
                if(file.catchBinding(call, own)) {
                    continue;
                }
                if(exits.includes(call)) {
                    events.set(call, [new ProcessEvent('exit', call)]);
                }
                else if(writes.has(call) && !file.holdsExit(call)) {
                    events.set(call, [new ProcessEvent('write', call, chains.chain(call))]);
                }
            }
            const builder = new NativeGraph(this.rules, events, chains.catches(), file.bindings);
            const graph = builder.build(own);
            graph.unrecordable = exits.some((exit) => !builder.recorded.has(exit));
            this.reportGraph(graph, exits);
        }
    }
}
