import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease, tsgoInspect } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { UnaryMinus, byteOffsets } from '../unary_minus.ts';
import { Rules } from '../rules.ts';
import { Bindings } from '../bindings.ts';
import { BlockingIndex } from './blocking_index.a';
import { ProgramLoads } from './program_loads.a';
import { ProcessFile, ProcessPool } from './process_context.a';
import { NoProcessExitAfterOutput } from './no_process_exit_after_output.a';
import { RequireBlockingStandardStreams } from './require_blocking_standard_streams.a';
import { NoUnclearedRaceTimeout } from './no_uncleared_race_timeout.a';

const args = programArguments();
const config = args[0] ?? panic('usage: coverage_suite.ts tsconfig manifest [--count]');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
let findings = 0;
let processPool: ProcessPool | undefined;
let loads: ProgramLoads | undefined;
let blockingIndex: BlockingIndex | undefined;

for(const path of paths) {
    const source = readTextFile(path);
    if(source.kind === 'Error') {
        panic(source.message);
    }
    const parser = new Parser(source.text, path);
    const scanner = new Scanner(source.text);
    const offsets = byteOffsets(source.text);
    const unary = new UnaryMinus(program, path, parser, scanner, offsets);
    const linter = new Rules(program, path, parser, scanner, offsets, unary);
    if(args.includes('--process') || args.includes('--blocking') || args.includes('--all')) {
        if(loads === undefined) {
            loads = new ProgramLoads(
                linter,
                0,
                tsgoInspect(program, path, 0, offsets[offsets.length - 1] ?? 0, 'SourceFile', 'wave08-program-loads'),
            );
        }
        const file = loads.files.find((file) => file.path === path);
        parser.awaitContext = file?.external ?? false;
    }
    const root = parser.file();
    for(let at = 0; at < parser.nodes.length; at++) {
        linter.parents.push(-1);
    }
    linter.links(root, -1);
    if(args.includes('--process') || args.includes('--blocking') || args.includes('--all')) {
        if(processPool === undefined) {
            processPool = new ProcessPool(
                linter,
                root,
                loads ?? panic('program loads absent'),
                new ProcessFile(linter, root, new Bindings(linter)),
            );
        }
        if(args.includes('--process') || args.includes('--all')) {
            new NoProcessExitAfterOutput(linter).run(processPool, root);
        }
        if(args.includes('--blocking') || args.includes('--all')) {
            if(blockingIndex === undefined) {
                blockingIndex = new BlockingIndex(processPool);
            }
            new RequireBlockingStandardStreams(linter).run(processPool, root, blockingIndex);
        }
    }
    new NoUnclearedRaceTimeout(linter).run();
    for(const finding of linter.findings) {
        finding.sortKey = finding.written();
    }
    linter.findings.sort((left, right) => (left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0));
    findings += linter.findings.length;
    if(!args.includes('--count')) {
        console.log(`file\t${written(path)}`);
        for(const finding of linter.findings) {
            console.log(finding.written());
        }
    }
}
console.log(`findings ${findings}`);
tsgoRelease(program);
