class Instability {
    readonly origin: ContextNode; readonly reason: string; readonly dependency: ContextNode | undefined;
    constructor(origin: ContextNode,reason: string,dependency?: ContextNode) { this.origin=origin;this.reason=reason;this.dependency=dependency; }
}
class Evaluation {
