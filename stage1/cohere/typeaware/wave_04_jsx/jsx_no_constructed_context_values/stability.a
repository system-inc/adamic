        const result=this.functionEvaluation(s.reference(factory),depth+1);return result.fresh===undefined?new MemoResult():new MemoResult(finding,result.other);
    }
    dependency(node: ContextNode,scope: ContextNode,depth: number): Instability | undefined {
        const result=this.evaluate(node,scope,depth);if(result.fresh===undefined||result.other&&this.anyEscapes(result.holders,true)) { return undefined; }
