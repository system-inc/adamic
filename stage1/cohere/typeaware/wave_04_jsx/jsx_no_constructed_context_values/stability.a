    callEvaluation(call: ContextNode,depth: number): Evaluation {
        const s=call.source;const signature=new ResolvedSignatureDeclaration(s.rules,call.index);const declaration=signature.declaration;
        if(declaration===undefined||!signature.hasBody) { return this.unknown(); }
        const foreign=s.foreign(declaration.file);const head=declaration.ancestors[0]??panic('missing callee declaration');const index=foreign.bindings.spans.get(`${head.kind}:${head.start}:${head.end}`)??panic('callee absent from native tree');const function_=foreign.reference(index);
        const callee=s.unwrap(s.child(call.index,0),true);let name='the call';if(s.kind(callee)==='Identifier') { name=s.node(callee).text; }else if(s.kind(callee)==='PropertyAccessExpression') { name=s.node(s.last(callee)).text; }
        if((signature.functionFlags&2)!==0) { return new Evaluation(new Instability(function_,`is the result of \`${name}(...)\`, an async function, which returns a new promise on every call`)); }
        if((signature.functionFlags&1)!==0) { return new Evaluation(new Instability(function_,`is the result of \`${name}(...)\`, a generator, which returns a new iterator on every call`)); }
        const result=this.functionEvaluation(function_,depth+1);if(result.fresh!==undefined) { result.fresh=new Instability(result.fresh.origin,`is the result of \`${name}(...)\`, which can return a new value on every call`); }return result;
    }
    functionEvaluation(function_: ContextNode,depth: number): Evaluation {
        const key=this.key(function_);if(depth>8||this.active.has(key)||function_.source.body(function_.index)<0) { return this.unknown(); }
        this.active.add(key);const result=this.functionBody(function_,depth);this.active.delete(key);return result;
    }
    functionBody(function_: ContextNode,depth: number): Evaluation {
        const s=function_.source;const body=s.body(function_.index);let result=new Evaluation();
        if(s.kind(body)!=='Block') { result=this.evaluate(s.reference(body),function_,depth+1); }
        else {
            const pending=s.node(body).children.slice().reverse();
            while(pending.length>0) {
                const at=pending.pop()??-1;if(at<0) { continue; }
                if(s.kind(at)==='ReturnStatement') { result=result.combine(this.evaluate(s.reference(s.child(at,0)),function_,depth+1));continue; }
                if(s.functionKind(s.kind(at))||['ClassDeclaration','ClassExpression'].includes(s.kind(at))) { continue; }
                for(const child of s.node(at).children.slice().reverse()) { pending.push(child); }
            }
        }
        const own=result.holders.filter((holder)=>this.nearest(holder).same(function_));const outer=result.holders.filter((holder)=>!this.nearest(holder).same(function_));
        if(result.fresh!==undefined&&result.other&&this.anyEscapes(own,false)) { result.fresh=undefined; }result.holders=outer;return result;
    }
    sameSymbol(a: ContextNode,b: ContextNode): boolean {
        const first=a.source.declarations(a.index)[0];const second=b.source.declarations(b.index)[0];return first!==undefined&&second!==undefined&&first.same(second);
    }
    anyEscapes(holders: readonly ContextNode[],render: boolean): boolean {
        for(const holder of holders) {
            const scope=this.nearest(holder);const s=holder.source;if(scope.index<0||s.body(scope.index)<0) { return true; }
            const name=s.bindings.shape.name(holder.index);if(name<0||s.declarations(name).length===0) { return true; }
            const pending=s.node(s.body(scope.index)).children.slice();
            while(pending.length>0) {
                const at=pending.pop()??-1;if(at<0) { continue; }
                if(at!==name&&s.kind(at)==='Identifier'&&s.node(at).text===s.node(name).text&&this.sameSymbol(s.reference(at),s.reference(name))&&!this.staysHome(s.reference(at),scope,render)) { return true; }
                for(const child of s.node(at).children) { pending.push(child); }
            }
        }
        return false;
    }
    memoFactory(node: ContextNode): boolean { const s=node.source;const parent=s.parent(node.index);return parent>=0&&s.hook(parent)!==''&&s.arguments(parent)[0]===node.index; }
    dependencyList(node: ContextNode): boolean { const s=node.source;const parent=s.parent(node.index);return parent>=0&&s.hook(parent)!==''&&s.arguments(parent)[1]===node.index; }
    memoResult(node: ContextNode): boolean {
        const s=node.source;let index=node.index;while(s.kind(s.parent(index))==='ParenthesizedExpression') { index=s.parent(index); }const parent=s.parent(index);
        if(s.kind(parent)==='ArrowFunction') { return s.body(parent)===index&&this.memoFactory(s.reference(parent)); }
        return s.kind(parent)==='ReturnStatement'&&this.memoFactory(this.nearest(s.reference(parent)));
    }
    ownFunction(node: ContextNode,scope: ContextNode,render: boolean): boolean { return node.same(scope)||render&&this.memoFactory(node); }
    isCallee(s: ContextSource,index: number): boolean { const parent=s.parent(index);return s.kind(parent)==='CallExpression'&&s.child(parent,0)===index; }
    staysHome(node: ContextNode,scope: ContextNode,render: boolean): boolean {
        const s=node.source;let expression=node.index;while(['ParenthesizedExpression','AsExpression','SatisfiesExpression','NonNullExpression'].includes(s.kind(s.parent(expression)))) { expression=s.parent(expression); }
        const parent=s.parent(expression);switch(s.kind(parent)) {
            case 'ReturnStatement': return this.ownFunction(this.nearest(s.reference(expression)),scope,render);
            case 'ArrowFunction': return s.body(parent)===expression&&this.ownFunction(s.reference(parent),scope,render);
            case 'PropertyAccessExpression': case 'ElementAccessExpression': return s.child(parent,0)===expression&&!this.isCallee(s,parent);
            case 'BinaryExpression': { const op=s.kind(s.child(parent,1));return op==='EqualsToken'?s.child(parent,0)===expression:['EqualsEqualsEqualsToken','ExclamationEqualsEqualsToken','EqualsEqualsToken','ExclamationEqualsToken','InstanceOfKeyword'].includes(op); }
            case 'PrefixUnaryExpression': return s.node(parent).operator==='ExclamationToken';
            case 'TypeOfExpression': return true;
            case 'IfStatement': return s.child(parent,0)===expression;
            case 'ArrayLiteralExpression': return render&&this.dependencyList(s.reference(parent));
            case 'ShorthandPropertyAssignment': return render&&this.memoResult(s.reference(s.parent(parent)));
            case 'PropertyAssignment': return render&&s.bindings.shape.initializer(parent)===expression&&this.memoResult(s.reference(s.parent(parent)));
        }
