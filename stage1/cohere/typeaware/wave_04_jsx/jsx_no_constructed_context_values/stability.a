    evaluate(input: ContextNode,scope: ContextNode,depth: number): Evaluation {
        const s=input.source;const index=s.unwrap(input.index,true);if(index<0) { return new Evaluation(); }if(depth>8) { return this.unknown(); }
        const node=s.reference(index);if(this.primitive(node)) { return new Evaluation(); }
        const label=s.constructionKind(index);if(label!=='') { return new Evaluation(new Instability(node,`is a new ${label} built during render`)); }
        switch(s.kind(index)) {
            case 'ConditionalExpression': return this.evaluate(s.reference(s.child(index,2)),scope,depth+1).combine(this.evaluate(s.reference(s.child(index,4)),scope,depth+1));
            case 'BinaryExpression': {
                const op=s.kind(s.child(index,1));if(['AmpersandAmpersandToken','BarBarToken','QuestionQuestionToken'].includes(op)) { return this.evaluate(s.reference(s.child(index,0)),scope,depth+1).combine(this.evaluate(s.reference(s.child(index,2)),scope,depth+1)); }
                if(op==='CommaToken') { return this.evaluate(s.reference(s.child(index,2)),scope,depth+1); }
                if(op==='EqualsToken') {
                    const target=s.unwrap(s.child(index,0),true);if(s.kind(target)!=='Identifier') { return this.unknown(); }
                    const local=s.declarations(target)[0];if(local===undefined||local.source.kind(local.index)!=='VariableDeclaration'||!this.nearest(local).same(scope)) { return this.unknown(); }
                    const result=this.evaluate(s.reference(s.child(index,2)),scope,depth+1);if(result.fresh!==undefined) { result.holders.push(local); }return result;
                }
                return this.unknown();
            }
            case 'CallExpression': {
                const hook=s.hook(index);if(hook==='') { return this.callEvaluation(node,depth+1); }
                const result=this.memo(node,scope,depth+1);if(result.fresh===undefined) { return this.unknown(); }
                const inner=result.fresh;let reason=`comes from a ${hook} with no dependency list`;
                if(inner.dependency!==undefined) { reason=`comes from a ${hook} whose own dependency ${quote(this.text(inner.dependency))} ${inner.reason}`; }
                return new Evaluation(new Instability(inner.origin,reason),result.other);
            }
            case 'Identifier': {
                const declaration=this.renderConst(node,scope);if(declaration===undefined||this.active.has(this.key(declaration))) { return this.unknown(); }
                if(declaration.source.kind(declaration.index)==='FunctionDeclaration') { return new Evaluation(new Instability(declaration,'is a function declared during render'),false,[declaration]); }
                const key=this.key(declaration);this.active.add(key);const result=this.evaluate(declaration.source.reference(declaration.source.bindings.shape.initializer(declaration.index)),scope,depth+1);this.active.delete(key);if(result.fresh!==undefined) { result.holders.push(declaration); }return result;
            }
