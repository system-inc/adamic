    }
    text(node: ContextNode): string { const s=node.source;return s.rules.scanner.text.slice(s.rules.start(s.node(node.index)),s.node(node.index).end); }
    check(value: ContextNode): void {
        const s=value.source;let memo=s.unwrap(value.index,true);
        if(s.hook(memo)==='') {
            if(s.kind(memo)!=='Identifier') { return; }const declaration=this.renderConst(s.reference(memo),this.render);
            if(declaration===undefined||declaration.source.kind(declaration.index)!=='VariableDeclaration') { return; }
            memo=declaration.source.unwrap(declaration.source.bindings.shape.initializer(declaration.index),true);if(declaration.source.rules.path!==s.rules.path) { panic('render-scoped memo changed source file'); }
        }
        const hook=s.hook(memo);if(hook==='') { return; }const found=this.memo(s.reference(memo),this.render,0).fresh;if(found===undefined) { return; }
        let target=s.reference(s.child(memo,0));let id='memoWithoutDependenciesMsg';let message=`The ${hook} that builds the Context provider's value (at line ${s.line(memo)}) has no dependency list, so it recomputes on every render and every consumer of this context re-renders on every render of this component, exactly as if it were not memoized. Pass the dependency list.`;
        if(found.dependency!==undefined) {
            target=found.dependency;id='unstableDependencyMsg';const dependency=quote(this.text(target));const location=found.origin.source.rules.path===s.rules.path?` (at line ${found.origin.source.line(found.origin.index)})`:'';
            message=`The ${dependency} dependency of the ${hook} that builds the Context provider's value (at line ${s.line(memo)}) ${found.reason}${location}, so the ${hook} recomputes on every render and every consumer of this context re-renders on every render of this component, exactly as if it were not memoized. A memoized value is only stable when every input is: make ${dependency} stable too, by memoizing it or by building it outside the component.`;
        }
        const range=target.source; s.rules.findings.push(new Diagnostic('react/jsx-no-constructed-context-values',id,message,range.rules.byte(range.rules.start(range.node(target.index))),range.rules.byte(range.node(target.index).end),''));
    }
}
