export class ContextNode {
    readonly source: ContextSource; readonly index: number;
    constructor(source: ContextSource,index: number) { this.source=source; this.index=index; }
    same(other: ContextNode): boolean { return this.index===other.index && this.source.rules.path===other.source.rules.path; }
}
export class Construction {
    readonly kind: string; readonly origin: ContextNode; readonly usage: ContextNode | undefined;
    constructor(kind: string,origin: ContextNode,usage?: ContextNode) { this.kind=kind; this.origin=origin; this.usage=usage; }
}
export class ContextSource {
    readonly rules: Rules; readonly bindings: Bindings; readonly graph: Map<string,Rules>;
    constructor(rules: Rules,graph?: Map<string,Rules>) {
        this.rules=rules; this.bindings=new Bindings(rules); this.graph=graph??new Map<string,Rules>(); this.graph.set(rules.path,rules);
    }
    kind(index: number): string { return index < 0 ? '' : this.rules.parser.node(index).kind; }
    node(index: number): ParseNode { return this.rules.parser.node(index); }
    parent(index: number): number { return this.bindings.parent(index); }
    reference(index: number): ContextNode { return new ContextNode(this,index); }
    child(index: number,offset: number): number { return this.node(index).children[offset]??-1; }
    last(index: number): number { const children=this.node(index).children; return children[children.length-1]??-1; }
    unwrap(index: number,identity=false): number {
