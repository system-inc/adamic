import { panic } from 'adamic';
import { Diagnostic } from '../../diagnostic.ts';
import type { SyntaxNodeInterface } from '../syntax_node.a';
export const listenerKinds: readonly number[] = [286,287];
export class JsxNoUndef {
    componentName(name: string): boolean {
        if(name.length === 0 || name.includes('-')) { return false; }
        const first = name.charCodeAt(0);
        return first < 97 || first > 122;
    }
    report(node: SyntaxNodeInterface): Diagnostic {
        return new Diagnostic('react/jsx-no-undef', 'jsxIdentifierNotDefined', "This JSX tag names a component that has no declaration in scope, so React receives `undefined` where a component was meant and throws at render rather than at build. Almost always a misspelling or a missing import. Import the component, or fix the spelling to match the binding you meant.", node.start, node.end, '');
    }
    run(node: SyntaxNodeInterface): void { panic(`NotYet: jsx-no-undef node ${node.start} needs shared numeric JSX nodes and symbol declaration file facts`); }
}
