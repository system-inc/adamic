import type { Rules } from './rules.ts';
import type { Types } from './types.ts';
import type { TypeFact } from './type_fact.ts';
import { types } from './facts.ts';
import { NumericLiteral } from './numeric_literal.a';
import { baseConstraintShape } from './base_constraint_shape.a';
import { Diagnostic } from './diagnostic.ts';

// Verdicts are decline=0, silent=1, leaks=2, decided entirely in Adamic.
export class NoLeakedNumberRender {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    classify(index: number, graph: Types, part: TypeFact, depth: number): number {
        if((part.flags & (4 | 8 | 16 | 262144 | 8192)) !== 0) {
            return 1;
        }
        if((part.flags & (64 | 128)) !== 0) {
            return 2;
        }
        if((part.flags & (2048 | 4096)) !== 0) {
            const value = new NumericLiteral(this.rules, index, part.id);
            return value.held && ['0', '-0', 'NaN'].includes(value.value) ? 2 : 1;
        }
        if((part.flags & 268435456) !== 0) {
            return part.parts.some((id) => (graph.type(id).flags & (64 | 128)) !== 0) ? 2 : 0;
        }
        if((part.flags & (524288 | 33554432 | 67108864 | 16777216 | 2097152 | 4194304 | 8388608)) !== 0) {
            if(depth > 4) {
                return 0;
            }
            const constraint = baseConstraintShape(this.rules, index, part.id);
            if(!constraint.present || constraint.root().id === part.id) {
                return 0;
            }
            let verdict = 1;
            for(const id of constraint.parts(constraint.root())) {
                const next = this.classify(index, constraint, constraint.type(id), depth + 1);
                if(next === 0) {
                    return 0;
                }
                if(next === 2) {
                    verdict = 2;
                }
            }
            return verdict;
        }
        return 0;
    }
    canLeak(index: number): boolean {
        const graph = types(this.rules.ask(index, 'raw-shape'), 'raw-shape');
        let leaks = false;
        for(const id of graph.parts(graph.root())) {
            const verdict = this.classify(index, graph, graph.type(id), 0);
            if(verdict === 0) {
                return false;
            }
            if(verdict === 2) {
                leaks = true;
            }
        }
        return leaks;
    }
    falsy(index: number): void {
        const current = this.rules.skip(index);
        const node = this.rules.parser.node(current);
        if(node.kind === 'ConditionalExpression') {
            this.falsy(node.children[2] ?? -1);
            this.falsy(node.children[4] ?? -1);
            return;
        }
        if(node.kind === 'BinaryExpression') {
            const operator = this.rules.parser.node(node.children[1] ?? -1).kind;
            if(['AmpersandAmpersandToken', 'QuestionQuestionToken'].includes(operator)) {
                this.falsy(node.children[0] ?? -1);
                this.falsy(node.children[2] ?? -1);
                return;
            }
            if(operator === 'BarBarToken') {
                this.falsy(node.children[2] ?? -1);
                return;
            }
        }
        if(this.canLeak(current)) {
            this.rules.findings.push(
                new Diagnostic(
                    'correctness-no-leaked-number-render',
                    'leakedNumberRender',
                    'This operand is a number, and `&&` hands back its own value when it is falsy, so when it is `0` (or `NaN`) React renders that number as text where nothing was meant to appear. Test the condition you mean instead, such as `count > 0 &&` or `count !== undefined &&`, so the operand is a boolean.',
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    'nexus/',
                ),
            );
        }
    }
    rendered(index: number): void {
        const current = this.rules.skip(index);
        const node = this.rules.parser.node(current);
        if(node.kind === 'ConditionalExpression') {
            this.rendered(node.children[2] ?? -1);
            this.rendered(node.children[4] ?? -1);
            return;
        }
        if(node.kind !== 'BinaryExpression') {
            return;
        }
        const operator = this.rules.parser.node(node.children[1] ?? -1).kind;
        if(operator === 'AmpersandAmpersandToken') {
            this.falsy(node.children[0] ?? -1);
            this.rendered(node.children[2] ?? -1);
        }
        else if(operator === 'BarBarToken') {
            this.rendered(node.children[2] ?? -1);
        }
        else if(operator === 'QuestionQuestionToken') {
            this.rendered(node.children[0] ?? -1);
            this.rendered(node.children[2] ?? -1);
        }
    }
    run(): void {
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at);
            if(
                node.kind !== 'JsxExpression' ||
                node.children.length === 0 ||
                node.children.some((child) => this.rules.parser.node(child).kind === 'DotDotDotToken')
            ) {
                continue;
            }
            const parent = this.rules.parents[at] ?? -1;
            if(parent < 0 || !['JsxElement', 'JsxFragment'].includes(this.rules.parser.node(parent).kind)) {
                continue;
            }
            this.rendered(node.children[node.children.length - 1] ?? -1);
        }
    }
}
