import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export function regexpBinding(rules: Rules, index: number): boolean {
    const frames = new Frames(rules.ask(index, 'node-symbol-details'));
    header(frames, 'node-symbol-details');
    let eligible = frames.yes();
    if(eligible) {
        frames.natural();
        frames.natural();
        frames.field();
        const count = frames.natural();
        eligible = count > 0;
        for(let at = 0; at < count; at++) {
            frames.field();
            frames.field();
            frames.natural();
            frames.natural();
            const declaration = frames.yes();
            if(!declaration) {
                eligible = false;
            }
            frames.yes();
            frames.field();
            frames.field();
            frames.natural();
            frames.natural();
            const tags = frames.natural();
            for(let t = 0; t < tags; t++) {
                frames.field();
                frames.field();
                frames.natural();
                frames.natural();
                frames.field();
            }
            const parameters = frames.natural();
            for(let p = 0; p < parameters; p++) {
                frames.field();
            }
        }
    }
    frames.end();
    return eligible;
}
