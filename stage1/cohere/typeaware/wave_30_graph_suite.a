import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../typescript/parser/nodes.ts';
import { Parser } from '../../typescript/parser/parser.ts';
import { Scanner } from '../../typescript/scanner/scanner.ts';
import { UnaryMinus, byteOffsets } from './unary_minus.ts';
import { Rules } from './rules.ts';
import { Bindings } from './bindings.ts';
import { sourceParseContext } from './source_parse_context.a';
import { ProcessControlFlow, processIndexRoots } from './process_control_flow.a';

const args = programArguments();
const config = args[0] ?? panic('usage: coverage_suite.ts tsconfig manifest [--count]');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
let findings = 0;
for(const path of paths) {
    const source = readTextFile(path);
    if(source.kind === 'Error') {
        panic(source.message);
    }
    const parser = new Parser(source.text, path);
    const scanner = new Scanner(source.text);
    const offsets = byteOffsets(source.text);
    const unary = new UnaryMinus(program, path, parser, scanner, offsets);
    const linter = new Rules(program, path, parser, scanner, offsets, unary);
    parser.awaitContext = sourceParseContext(program, path, offsets[source.text.length] ?? panic('missing source byte length'));
    const root = parser.file();
    for(let at = 0; at < parser.nodes.length; at++) {
        linter.parents.push(-1);
    }
    linter.links(root, -1);
    const bindings = new Bindings(linter);
    console.log(`file\t${written(path)}`);
    const roots: number[] = []; processIndexRoots(bindings, root, roots);
    for(const index of roots) {
        const node = parser.node(index); console.log(`root ${node.kind} ${linter.byte(node.pos)} ${linter.byte(node.end)}`);
        const graph = new ProcessControlFlow(bindings); graph.build(index);
        for(let at = 0; at < graph.blocks.length; at++) {
            const block = graph.block(at); console.log(`block ${at} ${block.reachable ? 1 : 0} ${block.successors.join(',')}`);
            for(const event of block.events) { const child = parser.node(event.node); if(!event.statement && child.kind !== 'CallExpression') { continue; } console.log(`${event.statement ? 'S' : 'C'} ${child.kind} ${linter.byte(child.pos)} ${linter.byte(child.end)}`); }
        }
    }

}

tsgoRelease(program);
