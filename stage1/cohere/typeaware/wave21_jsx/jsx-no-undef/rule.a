import { Syntax,Node } from '../syntax.a';
import { Identifier as K_Identifier, PropertyAccessExpression as K_PropertyAccessExpression } from '../kinds.a';
export const syntaxKinds:readonly number[]=[287,286];
function componentName(text:string):boolean{if(text.length===0||text.includes('-')){return false;}const first=text.charCodeAt(0);return first<97||first>122;}
export function check(s:Syntax,node:Node,allowGlobals:boolean):void{
 if(!s.hasChecker||node.tag===0){return;}let reference=s.get(node.tag);
 if(reference.kind===K_Identifier){if(!componentName(reference.text)){return;}}
 else if(reference.kind===K_PropertyAccessExpression){while(reference.kind===K_PropertyAccessExpression){reference=s.get(reference.expression);}if(reference.kind!==K_Identifier){return;}}
 else{return;}
 if(reference.symbol!==0){if(allowGlobals||s.file.endsWith('.cjs')){return;}for(const d of reference.declarations){if(s.get(d).file===s.file){return;}}}
 s.add('jsx-no-undef','jsxIdentifierNotDefined','This JSX tag names a component that has no declaration in scope, so React receives `undefined` where a component was meant and throws at render rather than at build. Almost always a misspelling or a missing import. Import the component, or fix the spelling to match the binding you meant.',reference);
}
