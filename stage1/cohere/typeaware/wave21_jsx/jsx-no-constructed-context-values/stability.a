import { Syntax,Node,constructionKind,functionLike,logical,wrapper,quote } from '../syntax.a';
import { ArrayLiteralExpression as K_ArrayLiteralExpression, ArrowFunction as K_ArrowFunction, BinaryExpression as K_BinaryExpression, Block as K_Block, CallExpression as K_CallExpression, ClassDeclaration as K_ClassDeclaration, ClassExpression as K_ClassExpression, CommaToken as K_CommaToken, ConditionalExpression as K_ConditionalExpression, ElementAccessExpression as K_ElementAccessExpression, EqualsEqualsEqualsToken as K_EqualsEqualsEqualsToken, EqualsEqualsToken as K_EqualsEqualsToken, EqualsToken as K_EqualsToken, ExclamationEqualsEqualsToken as K_ExclamationEqualsEqualsToken, ExclamationEqualsToken as K_ExclamationEqualsToken, ExclamationToken as K_ExclamationToken, FunctionDeclaration as K_FunctionDeclaration, FunctionExpression as K_FunctionExpression, Identifier as K_Identifier, IfStatement as K_IfStatement, InstanceOfKeyword as K_InstanceOfKeyword, ParenthesizedExpression as K_ParenthesizedExpression, PrefixUnaryExpression as K_PrefixUnaryExpression, PropertyAccessExpression as K_PropertyAccessExpression, PropertyAssignment as K_PropertyAssignment, ReturnStatement as K_ReturnStatement, ShorthandPropertyAssignment as K_ShorthandPropertyAssignment, TypeOfExpression as K_TypeOfExpression, VariableDeclaration as K_VariableDeclaration } from '../kinds.a';
import { stringLike,numberLike,bigintLike,booleanLike,nullish } from '../../flags.ts';
class Instability {
 readonly dependency:number;readonly origin:number;readonly reason:string;
 constructor(dependency:number,origin:number,reason:string){this.dependency=dependency;this.origin=origin;this.reason=reason;}
}
class Evaluation {
 fresh:Instability|undefined;readonly other:boolean;holders:number[];
 constructor(fresh:Instability|undefined,other:boolean,holders:number[]=[]){this.fresh=fresh;this.other=other;this.holders=holders;}
 combine(other:Evaluation):Evaluation{const holders:number[]=[];for(const h of this.holders){holders.push(h);}for(const h of other.holders){holders.push(h);}return new Evaluation(this.fresh??other.fresh,this.other||other.other,holders);}
}
function unknown():Evaluation{return new Evaluation(undefined,true);}
function hook(s:Syntax,id:number):string{if(id===0){return '';}const call=s.get(id);if(call.kind!==K_CallExpression){return '';}const idCallee=s.parens(call.expression);if(idCallee===0){return '';}const callee=s.get(idCallee);let name='';if(callee.kind===K_Identifier){name=callee.text;}else if(callee.kind===K_PropertyAccessExpression&&s.named(s.parens(callee.expression),'React')&&callee.name!==0){name=s.get(callee.name).text;}return name==='useMemo'||name==='useCallback'?name:'';}
function runsWith(s:Syntax,owner:number,scope:number,render:number):boolean{if(owner===0){return false;}if(owner===scope){return true;}let found=false;let current=scope;while(current!==0){if(current===owner){found=true;}if(current===render){return found;}current=s.nearest(s.get(current));}return false;}
function renderConst(s:Syntax,n:Node,scope:number,render:number):number{if(n.declarations.length===0){return 0;}const d=s.get(n.declarations[0]??0);if(!runsWith(s,s.nearest(d),scope,render)){return 0;}return d.kind===K_FunctionDeclaration||(d.kind===K_VariableDeclaration&&d.isConst)?d.id:0;}
function memoOf(s:Syntax,id:number,scope:number):number{id=s.unwrap(id);if(id===0){return 0;}if(hook(s,id)!==''){return id;}const n=s.get(id);if(n.kind!==K_Identifier){return 0;}const d=renderConst(s,n,scope,scope);if(d===0||s.get(d).kind!==K_VariableDeclaration){return 0;}const init=s.unwrap(s.get(d).initializer);return hook(s,init)===''?0:init;}
function memoFactory(s:Syntax,id:number):boolean{if(id===0){return false;}const fn=s.get(id);if(hook(s,fn.parent)===''){return false;}return (s.get(fn.parent).args[0]??0)===id;}
function dependencyList(s:Syntax,n:Node):boolean{return hook(s,n.parent)!==''&&(s.get(n.parent).args[1]??0)===n.id;}
function memoResult(s:Syntax,id:number):boolean{if(id===0){return false;}let n=s.get(id);while(n.parent!==0&&s.get(n.parent).kind===K_ParenthesizedExpression){n=s.get(n.parent);}if(n.parent===0){return false;}const p=s.get(n.parent);if(p.kind===K_ArrowFunction){return p.body===n.id&&memoFactory(s,p.id);}return p.kind===K_ReturnStatement&&memoFactory(s,s.nearest(p));}
function staysHome(s:Syntax,reference:Node,scope:number,render:boolean):boolean{
 let n=reference;while(n.parent!==0&&wrapper(s.get(n.parent).kind)){n=s.get(n.parent);}if(n.parent===0){return false;}const p=s.get(n.parent);
 if(p.kind===K_ReturnStatement){const fn=s.nearest(n);return fn===scope||(render&&memoFactory(s,fn));}
 if(p.kind===K_ArrowFunction){return p.body===n.id&&(p.id===scope||(render&&memoFactory(s,p.id)));}
 if(p.kind===K_PropertyAccessExpression||p.kind===K_ElementAccessExpression){if(p.expression!==n.id){return false;}if(p.parent===0){return true;}const parent=s.get(p.parent);return parent.kind!==K_CallExpression||parent.expression!==p.id;}
 if(p.kind===K_BinaryExpression){if(p.operator===K_EqualsToken){return p.left===n.id;}return p.operator===K_EqualsEqualsEqualsToken||p.operator===K_ExclamationEqualsEqualsToken||p.operator===K_EqualsEqualsToken||p.operator===K_ExclamationEqualsToken||p.operator===K_InstanceOfKeyword;}
 if(p.kind===K_PrefixUnaryExpression){return p.operator===K_ExclamationToken;}if(p.kind===K_TypeOfExpression){return true;}if(p.kind===K_IfStatement){return p.expression===n.id;}
 if(p.kind===K_ArrayLiteralExpression){return render&&dependencyList(s,p);}if(p.kind===K_ShorthandPropertyAssignment){return render&&memoResult(s,p.parent);}if(p.kind===K_PropertyAssignment){return render&&p.initializer===n.id&&memoResult(s,p.parent);}return false;
}
class Walk {
 readonly s:Syntax;readonly render:number;readonly active=new Set<number>();
 constructor(s:Syntax,render:number){this.s=s;this.render=render;}
 primitive(n:Node):boolean{if(n.typeFlags.length===0){return false;}const mask=stringLike|numberLike|bigintLike|booleanLike|nullish|16|32768|65536|512|16384;for(const flags of n.typeFlags){if((flags&mask)===0){return false;}}return true;}
 memoFinding(id:number,scope:number,depth:number):Evaluation{
  if(depth>8||this.active.has(id)){return unknown();}this.active.add(id);const result=this.memoBody(id,scope,depth);this.active.delete(id);return result;
 }
 memoBody(id:number,scope:number,depth:number):Evaluation{
  const s=this.s;const call=s.get(id);if(call.args.length===0){return unknown();}let finding:Instability|undefined;
  if(call.args.length===1){finding=new Instability(0,id,'');}else{const list=s.unwrap(call.args[1]??0);if(list===0||s.get(list).kind!==K_ArrayLiteralExpression){return unknown();}for(const element of s.get(list).elements){const found=this.dependencyFinding(element,scope,depth+1);if(found!==undefined){finding=found;break;}}if(finding===undefined){return unknown();}}
  if(hook(s,id)==='useCallback'){return new Evaluation(finding,false);}const factory=s.unwrap(call.args[0]??0);if(factory===0||(s.get(factory).kind!==K_ArrowFunction&&s.get(factory).kind!==K_FunctionExpression)){return unknown();}const result=this.functionEvaluation(factory,depth+1);return result.fresh===undefined?unknown():new Evaluation(finding,result.other);
 }
 dependencyFinding(id:number,scope:number,depth:number):Instability|undefined{const result=this.evaluate(id,scope,depth);if(result.fresh===undefined||(result.other&&this.anyEscapes(result.holders,true))){return undefined;}return new Instability(id,result.fresh.origin,result.fresh.reason);}
 evaluate(id:number,scope:number,depth:number):Evaluation{
  const s=this.s;id=s.unwrap(id);if(id===0){return new Evaluation(undefined,false);}if(depth>8){return unknown();}const n=s.get(id);if(this.primitive(n)){return new Evaluation(undefined,false);}const kind=constructionKind(n.kind);if(kind!==''){return new Evaluation(new Instability(0,id,`is a new ${kind} built during render`),false);}
  if(n.kind===K_ConditionalExpression){return this.evaluate(n.whenTrue,scope,depth+1).combine(this.evaluate(n.whenFalse,scope,depth+1));}
  if(n.kind===K_BinaryExpression){if(logical(n.operator)){return this.evaluate(n.left,scope,depth+1).combine(this.evaluate(n.right,scope,depth+1));}if(n.operator===K_CommaToken){return this.evaluate(n.right,scope,depth+1);}if(n.operator===K_EqualsToken){const target=s.unwrap(n.left);if(target===0){return unknown();}const t=s.get(target);if(t.kind!==K_Identifier||t.declarations.length===0){return unknown();}const local=s.get(t.declarations[0]??0);if(local.kind!==K_VariableDeclaration||s.nearest(local)!==scope){return unknown();}const result=this.evaluate(n.right,scope,depth+1);if(result.fresh!==undefined){result.holders.push(local.id);}return result;}return unknown();}
  if(n.kind===K_CallExpression){const name=hook(s,id);if(name!==''){const inner=this.memoFinding(id,scope,depth+1);if(inner.fresh===undefined){return unknown();}let reason=`comes from a ${name} with no dependency list`;if(inner.fresh.dependency!==0){reason=`comes from a ${name} whose own dependency ${quote(s.get(inner.fresh.dependency).raw)} ${inner.fresh.reason}`;}return new Evaluation(new Instability(0,inner.fresh.origin,reason),inner.other);}return this.callEvaluation(n,depth+1);}
  if(n.kind===K_Identifier){const declaration=renderConst(s,n,scope,this.render);if(declaration===0||this.active.has(declaration)){return unknown();}const d=s.get(declaration);if(d.kind===K_FunctionDeclaration){return new Evaluation(new Instability(0,declaration,'is a function declared during render'),false,[declaration]);}this.active.add(declaration);const result=this.evaluate(d.initializer,scope,depth+1);this.active.delete(declaration);if(result.fresh!==undefined){result.holders.push(declaration);}return result;}
  return unknown();
 }
 callEvaluation(call:Node,depth:number):Evaluation{
  const s=this.s;if(call.signature===0){return unknown();}const callee=s.get(call.signature);if(callee.body===0){return unknown();}let name='the call';const expression=s.unwrap(call.expression);if(expression!==0){const e=s.get(expression);if(e.kind===K_Identifier){name=e.text;}else if(e.kind===K_PropertyAccessExpression&&e.name!==0){name=s.get(e.name).text;}}
  if(callee.isAsync){return new Evaluation(new Instability(0,callee.id,`is the result of \`${name}(...)\`, an async function, which returns a new promise on every call`),false);}if(callee.isGenerator){return new Evaluation(new Instability(0,callee.id,`is the result of \`${name}(...)\`, a generator, which returns a new iterator on every call`),false);}
  const result=this.functionEvaluation(callee.id,depth+1);if(result.fresh!==undefined){result.fresh=new Instability(0,result.fresh.origin,`is the result of \`${name}(...)\`, which can return a new value on every call`);}return result;
 }
 returns(id:number,scope:number,depth:number):Evaluation{const n=this.s.get(id);if(n.kind===K_ReturnStatement){return this.evaluate(n.expression,scope,depth+1);}if(functionLike(n.kind)||n.kind===K_ClassDeclaration||n.kind===K_ClassExpression){return new Evaluation(undefined,false);}let result=new Evaluation(undefined,false);for(const child of n.children){result=result.combine(this.returns(child,scope,depth));}return result;}
 functionEvaluation(id:number,depth:number):Evaluation{
  const s=this.s;if(depth>8||this.active.has(id)){return unknown();}const fn=s.get(id);if(fn.body===0){return unknown();}this.active.add(id);const body=s.get(fn.body);let result=new Evaluation(undefined,false);if(body.kind!==K_Block){result=this.evaluate(body.id,id,depth+1);}else{for(const child of body.children){result=result.combine(this.returns(child,id,depth));}}
  const own:number[]=[];const enclosing:number[]=[];for(const holder of result.holders){if(s.nearest(s.get(holder))===id){own.push(holder);}else{enclosing.push(holder);}}if(result.fresh!==undefined&&result.other&&this.anyEscapes(own,false)){result.fresh=undefined;}result.holders=enclosing;this.active.delete(id);return result;
 }
 escapes(id:number,name:number,symbol:number,scope:number,render:boolean):boolean{const s=this.s;const n=s.get(id);if(n.kind===K_Identifier&&id!==name){let reference=n.symbol;if(n.parent!==0&&s.get(n.parent).kind===K_ShorthandPropertyAssignment){reference=s.get(n.parent).shorthandSymbol;}if(reference===symbol&&!staysHome(s,n,scope,render)){return true;}}for(const child of n.children){if(this.escapes(child,name,symbol,scope,render)){return true;}}return false;}
 anyEscapes(holders:readonly number[],render:boolean):boolean{const s=this.s;for(const h of holders){const holder=s.get(h);const scope=s.nearest(holder);if(scope===0||s.get(scope).body===0||holder.name===0){return true;}const symbol=s.get(holder.name).symbol;if(symbol===0){return true;}for(const child of s.get(s.get(scope).body).children){if(this.escapes(child,holder.name,symbol,scope,render)){return true;}}}return false;}
}
export function checkMemo(s:Syntax,value:number,provider:Node):void{
 const scope=s.nearest(provider);const id=memoOf(s,value,scope);if(id===0){return;}const memo=s.get(id);const name=hook(s,id);const walk=new Walk(s,scope);const result=walk.memoFinding(id,scope,0);const found=result.fresh;if(found===undefined){return;}
 if(found.dependency===0){s.add('jsx-no-constructed-context-values','memoWithoutDependenciesMsg',`The ${name} that builds the Context provider's value (at line ${memo.line}) has no dependency list, so it recomputes on every render and every consumer of this context re-renders on every render of this component, exactly as if it were not memoized. Pass the dependency list.`,s.get(memo.expression));return;}
 const dependency=s.get(found.dependency);const origin=s.get(found.origin);const location=origin.file===s.file?` (at line ${origin.line})`:'';const text=quote(dependency.raw);
 s.add('jsx-no-constructed-context-values','unstableDependencyMsg',`The ${text} dependency of the ${name} that builds the Context provider's value (at line ${memo.line}) ${found.reason}${location}, so the ${name} recomputes on every render and every consumer of this context re-renders on every render of this component, exactly as if it were not memoized. A memoized value is only stable when every input is: make ${text} stable too, by memoizing it or by building it outside the component.`,dependency);
}
