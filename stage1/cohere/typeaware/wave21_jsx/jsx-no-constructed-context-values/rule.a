import { Syntax,Node,constructionKind,logical,quote } from '../syntax.a';
import { ArrowFunction as K_ArrowFunction, AsExpression as K_AsExpression, BinaryExpression as K_BinaryExpression, CallExpression as K_CallExpression, CaretEqualsToken as K_CaretEqualsToken, ClassDeclaration as K_ClassDeclaration, ClassExpression as K_ClassExpression, ConditionalExpression as K_ConditionalExpression, Constructor as K_Constructor, EqualsToken as K_EqualsToken, FunctionDeclaration as K_FunctionDeclaration, FunctionExpression as K_FunctionExpression, GetAccessor as K_GetAccessor, Identifier as K_Identifier, JsxAttribute as K_JsxAttribute, JsxAttributes as K_JsxAttributes, JsxExpression as K_JsxExpression, MethodDeclaration as K_MethodDeclaration, ParenthesizedExpression as K_ParenthesizedExpression, PropertyAccessExpression as K_PropertyAccessExpression, PropertyDeclaration as K_PropertyDeclaration, SatisfiesExpression as K_SatisfiesExpression, SetAccessor as K_SetAccessor, VariableDeclaration as K_VariableDeclaration } from '../kinds.a';
import { checkMemo } from './stability.a';
export const syntaxKinds:readonly number[]=[287,286];
export class Construction {
 readonly kind:string;readonly origin:number;readonly usage:number;
 constructor(kind:string,origin:number,usage=0){this.kind=kind;this.origin=origin;this.usage=usage;}
}
export function constructionOf(s:Syntax,id:number,depth=0):Construction|undefined{
 if(id===0||depth>16){return undefined;}const n=s.get(id);const kind=constructionKind(n.kind);if(kind!==''){return new Construction(kind,id);}
 if(n.kind===K_ParenthesizedExpression||n.kind===K_AsExpression||n.kind===K_SatisfiesExpression){return constructionOf(s,n.expression,depth+1);}
 if(n.kind===K_ConditionalExpression){return constructionOf(s,n.whenTrue,depth+1)??constructionOf(s,n.whenFalse,depth+1);}
 if(n.kind===K_BinaryExpression){if(n.operator>=K_EqualsToken&&n.operator<=K_CaretEqualsToken){const found=constructionOf(s,n.right,depth+1);return found===undefined?undefined:new Construction('assignment expression',found.origin,id);}if(logical(n.operator)){return constructionOf(s,n.left,depth+1)??constructionOf(s,n.right,depth+1);}return undefined;}
 if(n.kind===K_PropertyAccessExpression){const found=constructionOf(s,n.expression,depth+1);return found===undefined?undefined:new Construction(found.kind,found.origin,n.expression);}
 if(n.kind===K_Identifier&&n.declarations.length>0){const d=s.get(n.declarations[n.declarations.length-1]??0);if(s.nearest(d)!==s.nearest(n)){return undefined;}if(d.kind===K_FunctionDeclaration){return new Construction('function declaration',d.id,id);}if(d.kind===K_VariableDeclaration){const found=constructionOf(s,d.initializer,depth+1);return found===undefined?undefined:new Construction(found.kind,found.origin,id);}}
 return undefined;
}
function createContextCallee(s:Syntax,id:number):boolean{id=s.parens(id);if(id===0){return false;}const n=s.get(id);return (n.kind===K_Identifier&&n.text==='createContext')||(n.kind===K_PropertyAccessExpression&&s.named(s.parens(n.expression),'React')&&s.named(n.name,'createContext'));}
function provider(s:Syntax,id:number):boolean{if(id===0){return false;}const tag=s.get(id);if(tag.kind===K_PropertyAccessExpression){return s.named(tag.name,'Provider');}if(tag.kind!==K_Identifier){return false;}for(const d of tag.declarations){const n=s.get(d);if(n.kind!==K_VariableDeclaration){continue;}const init=s.parens(n.initializer);if(init!==0&&s.get(init).kind===K_CallExpression&&createContextCallee(s,s.get(init).expression)){return true;}}return false;}
function classComponent(s:Syntax,node:Node):boolean{let id=node.parent;while(id!==0){const n=s.get(id);if(n.kind===K_ClassDeclaration||n.kind===K_ClassExpression){for(const h of n.heritage){const base=s.get(h);if(base.kind===K_Identifier&&(base.text==='Component'||base.text==='PureComponent')){return true;}if(base.kind===K_PropertyAccessExpression&&s.named(base.expression,'React')&&(s.named(base.name,'Component')||s.named(base.name,'PureComponent'))){return true;}}return false;}id=n.parent;}return false;}
function bindingComponent(s:Syntax,node:Node):boolean{if(node.parent===0){return false;}const p=s.get(node.parent);if(p.kind===K_VariableDeclaration){return p.name!==0&&s.get(p.name).kind===K_Identifier&&s.get(p.name).uppercase;}if(p.kind===K_CallExpression){return bindingComponent(s,p);}return false;}
function inComponent(s:Syntax,node:Node):boolean{let id=node.parent;while(id!==0){const n=s.get(id);if(n.kind===K_FunctionDeclaration){return n.name!==0&&s.get(n.name).uppercase;}if(n.kind===K_FunctionExpression||n.kind===K_ArrowFunction){return n.parent!==0&&s.get(n.parent).kind===K_PropertyDeclaration?classComponent(s,s.get(n.parent)):bindingComponent(s,n);}if(n.kind===K_MethodDeclaration||n.kind===K_GetAccessor||n.kind===K_SetAccessor||n.kind===K_Constructor||n.kind===K_PropertyDeclaration){return classComponent(s,n);}id=n.parent;}return false;}
function valueExpression(s:Syntax,id:number):number{if(id===0||s.get(id).kind!==K_JsxAttributes){return 0;}for(const a of s.get(id).elements){const n=s.get(a);if(n.kind!==K_JsxAttribute||!s.named(n.name,'value')){continue;}return n.initializer!==0&&s.get(n.initializer).kind===K_JsxExpression?s.get(n.initializer).expression:0;}return 0;}
export function check(s:Syntax,node:Node):void{
 if(!s.hasChecker||!provider(s,node.tag)){return;}const value=valueExpression(s,node.attributes);if(value===0){return;}
 const found=constructionOf(s,value);if(found===undefined){if(inComponent(s,node)){checkMemo(s,value,node);}return;}if(!inComponent(s,node)){return;}
 const origin=s.get(found.origin);const isFunction=found.kind==='function expression'||found.kind==='function declaration';const remedy=isFunction?'useCallback':'useMemo';let id=found.usage===0?'defaultMsg':'withIdentifierMsg';if(isFunction){id+='Func';}
 let message='';if(found.usage===0){message=`The ${found.kind} passed as the value prop to the Context provider (at line ${origin.line}) changes every render, so every consumer of this context re-renders on every render of this component even when nothing it reads has changed. Wrap it in a ${remedy} hook so the identity is stable between renders.`;}else{const usage=s.get(found.usage);const name=usage.kind===K_Identifier?usage.text:'';message=`The ${quote(name)} ${found.kind} (at line ${origin.line}) passed as the value prop to the Context provider (at line ${usage.line}) changes every render, so every consumer of this context re-renders on every render of this component even when nothing it reads has changed. Wrap it in a ${remedy} hook so the identity is stable between renders.`;}
 s.add('jsx-no-constructed-context-values',id,message,origin);
}
