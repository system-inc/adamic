import { setStateInEffectKinds, setStateInRenderKinds, staticComponentsKinds } from './react_listener_declarations.a';
export class ListenerDeclaration {
    readonly rule: string;
    readonly kinds: readonly number[];
    constructor(rule: string, kinds: readonly number[]) { this.rule = rule; this.kinds = kinds; }
}
