import type { Rules } from './rules.ts';
import { ConstructorBindingFacts } from './constructor_binding_facts.a';
const message =
    'This builds a function by compiling a string at runtime, which is eval wearing a different name. The body is invisible to the type checker, to the bundler, and to every tool that would otherwise catch a mistake in it, it cannot close over anything in the surrounding scope, and if any part of the string came from input it is a code injection. Write a real function, or take one as a parameter.';
export class NoNewFunc {
    readonly rules: Rules;
    readonly facts: ConstructorBindingFacts;
    constructor(rules: Rules) {
        this.rules = rules;
        this.facts = new ConstructorBindingFacts(rules);
    }
    method(index: number): string {
        const node = this.rules.parser.node(index);
        if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(node.kind)) {
            return '';
        }
        const member = this.rules.skip(node.children[node.children.length - 1] ?? -1);
        const name = this.rules.parser.node(member);
        const accepted =
            node.kind === 'PropertyAccessExpression'
                ? [
                      'Identifier',
                      'PrivateIdentifier',
                      'StringLiteral',
                      'NumericLiteral',
                      'NoSubstitutionTemplateLiteral',
                  ]
                : ['StringLiteral', 'NumericLiteral', 'NoSubstitutionTemplateLiteral'];
        return accepted.includes(name.kind) ? name.text : '';
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if((this.rules.parents[index] ?? -1) < 0) {
                continue;
            }
            const node = this.rules.parser.node(index);
            if(!['NewExpression', 'CallExpression'].includes(node.kind)) {
                continue;
            }
            const callee = this.rules.skip(node.children[0] ?? -1);
            const called = this.rules.parser.node(callee);
            if(called.kind === 'Identifier') {
                if(called.text === 'Function' && this.facts.global(callee)) {
                    this.facts.report(index, 'no-new-func', 'noFunctionConstructor', message);
                }
                continue;
            }
            if(!['apply', 'bind', 'call'].includes(this.method(callee))) {
                continue;
            }
            const object = this.rules.skip(called.children[0] ?? -1);
            const receiver = this.rules.parser.node(object);
            if(receiver.kind === 'Identifier' && receiver.text === 'Function' && this.facts.global(object)) {
                this.facts.report(index, 'no-new-func', 'noFunctionConstructor', message);
            }
        }
    }
}
