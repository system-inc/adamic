// reference.constantValue's expression folding. Scope resolution is supplied
// separately; this component never guesses which binding an identifier reads.
import {panic} from 'adamic';
import type {ParseNode} from '../../../../typescript/parser/nodes.ts';
export interface ConstantResult {readonly text:string;readonly string:boolean;readonly known:boolean;}
export class ConstantValue {
    readonly text:string;readonly string:boolean;readonly known:boolean;
    constructor(text:string,string:boolean,known:boolean){this.text=text;this.string=string;this.known=known;}
}
export function unknownConstant():ConstantValue {return new ConstantValue('',false,false);}
export function constantValue(nodes:readonly ParseNode[],index:number,resolve:(index:number)=>ConstantResult):ConstantResult {
    if(index<0){return unknownConstant();}
    const node=nodes[index]??panic('constant expression absent from node table');
    if(node.kind==='ParenthesizedExpression'){return constantValue(nodes,node.children[0]??-1,resolve);}
    if(node.kind==='Identifier'||node.kind==='RegularExpressionLiteral'){return resolve(index);}
    if(node.kind==='StringLiteral'||node.kind==='NoSubstitutionTemplateLiteral'){return new ConstantValue(node.text,true,true);}
    if(node.kind==='NumericLiteral'){return new ConstantValue(node.text,false,true);}
    if(node.kind==='TrueKeyword'){return new ConstantValue('true',false,true);}
    if(node.kind==='FalseKeyword'){return new ConstantValue('false',false,true);}
    if(node.kind==='NullKeyword'){return new ConstantValue('null',false,true);}
    if(node.kind==='TemplateExpression'){
        const head=nodes[node.children[0]??-1]??panic('template head absent');let text=head.text;
        for(const child of node.children.slice(1)){
            const span=nodes[child]??panic('template span absent');
            const value=constantValue(nodes,span.children[0]??-1,resolve);
            if(!value.known){return unknownConstant();}
            const literal=nodes[span.children[1]??-1]??panic('template tail absent');text+=value.text+literal.text;
        }
        return new ConstantValue(text,true,true);
    }
    if(node.kind==='BinaryExpression'){
        if(nodes[node.children[1]??-1]?.kind!=='PlusToken'){return unknownConstant();}
        const left=constantValue(nodes,node.children[0]??-1,resolve);
        const right=constantValue(nodes,node.children[node.children.length-1]??-1,resolve);
        if(!left.known||!right.known||(!left.string&&!right.string)){return unknownConstant();}
        return new ConstantValue(left.text+right.text,true,true);
    }
    return unknownConstant();
}
export function constantString(nodes:readonly ParseNode[],index:number):ConstantResult {
    return constantValue(nodes,index,(_index):ConstantValue=>unknownConstant());
}
