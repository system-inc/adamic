// Native port of cohere's regexsyntax class scanner. Offsets are UTF-8 bytes.
import { panic } from 'adamic';
export class PatternBytes {
    readonly bytes: number[] = [];
    constructor(text: string) {
        for(let at=0;at<text.length;) {
            const value=text.codePointAt(at) ?? panic('missing pattern code point');
            at+=value>65535?2:1;
            if(value<128) {this.bytes.push(value);}
            else if(value<2048) {this.bytes.push(192+Math.floor(value/64));this.bytes.push(128+value%64);}
            else if(value<65536) {this.bytes.push(224+Math.floor(value/4096));this.bytes.push(128+Math.floor(value/64)%64);this.bytes.push(128+value%64);}
            else {this.bytes.push(240+Math.floor(value/262144));this.bytes.push(128+Math.floor(value/4096)%64);this.bytes.push(128+Math.floor(value/64)%64);this.bytes.push(128+value%64);}
        }
    }
    at(index:number):number {return this.bytes[index] ?? -1;}
    find(value:number,start:number):number {for(let i=start;i<this.bytes.length;i++){if(this.at(i)===value){return i;}}return -1;}
    rune(index:number):Rune {
        const first=this.at(index);if(first<0){return new Rune(65533,0);}
        if(first<128){return new Rune(first,1);}
        const width=first>=240&&first<=244?4:first>=224&&first<=239?3:first>=194&&first<=223?2:1;
        if(width===1){return new Rune(65533,1);}
        let value=first%(width===4?8:width===3?16:32);
        for(let i=1;i<width;i++){const next=this.at(index+i);if(next<128||next>191){return new Rune(65533,1);}value=value*64+next-128;}
        if(value<(width===4?65536:width===3?2048:128)||value>1114111||(value>=55296&&value<=57343)){return new Rune(65533,1);}
        return new Rune(value,width);
    }
    hex(start:number,end:number):boolean {if(start>=end){return false;}for(let i=start;i<end;i++){if(hexValue(this.at(i))<0){return false;}}return true;}
    hexUint(start:number,end:number):number {let value=0;for(let i=start;i<end;i++){value=(value*16+Math.max(0,hexValue(this.at(i))))%4294967296;}return value;}
}
export class Rune {readonly value:number;readonly width:number;constructor(value:number,width:number){this.value=value;this.width=width;}}
function hexValue(value:number):number {if(value>=48&&value<=57){return value-48;}if(value>=65&&value<=70){return value-55;}if(value>=97&&value<=102){return value-87;}return -1;}
export class RegexFlags {
    readonly unicode:boolean;readonly sets:boolean;
    constructor(flags:string){this.unicode=flags.includes('u');this.sets=flags.includes('v');}
    uv():boolean {return this.unicode||this.sets;}
}
export class CharacterElement {
    readonly kind:number;readonly value:number;readonly brace:boolean;readonly max:number;readonly maxBrace:boolean;readonly start:number;readonly end:number;
    constructor(kind:number,value:number,brace:boolean,max:number,maxBrace:boolean,start:number,end:number){this.kind=kind;this.value=value;this.brace=brace;this.max=max;this.maxBrace=maxBrace;this.start=start;this.end=end;}
    written():string {return `${this.kind}\t${this.value}\t${this.brace?1:0}\t0\t${this.max}\t${this.maxBrace?1:0}\t${this.start}\t${this.end}`;}
}
export class EscapeResult {
    readonly element:CharacterElement;readonly step:number;readonly ok:boolean;
    constructor(element:CharacterElement,step:number,ok:boolean){this.element=element;this.step=step;this.ok=ok;}
}
function single(value:number,start:number,end:number,brace=false):EscapeResult {return new EscapeResult(new CharacterElement(0,value,brace,0,false,start,end),end-start,true);}
function breaker(start:number,end:number):EscapeResult {return new EscapeResult(new CharacterElement(2,0,false,0,false,start,end),end-start,true);}
function failedEscape():EscapeResult {return new EscapeResult(new CharacterElement(0,0,false,0,false,0,0),0,false);}
export function skipPatternEscape(p:PatternBytes,i:number,f:RegexFlags):number {
    if(i+1>=p.bytes.length){return 0;}
    const next=p.at(i+1);
    if(next===120){return p.hex(i+2,i+4)?4:2;}
    if(next===117){
        if(p.at(i+2)===123){if(!f.uv()){return 2;}const end=p.find(125,i+3);return end<0?2:end-i+1;}
        return p.hex(i+2,i+6)?6:2;
    }
    if(next===99){return i+2<p.bytes.length?3:2;}
    if((next===112||next===80||next===113)&&f.uv()&&p.at(i+2)===123){const end=p.find(125,i+3);if(end>=0){return end-i+1;}return 2;}
    return 1+Math.max(1,p.rune(i+1).width);
}
export function classEnd(p:PatternBytes,start:number,f:RegexFlags):number {
    if(p.at(start)!==91){return -1;}
    let i=start+1;let depth=1;if(p.at(i)===94){i++;}
    while(i<p.bytes.length){
        const c=p.at(i);
        if(c===92){const step=skipPatternEscape(p,i,f);if(step===0){return -1;}i+=step;}
        else if(c===91&&f.sets){depth++;i++;}
        else if(c===93){depth--;i++;if(depth===0){return i;}}
        else{i+=Math.max(1,p.rune(i).width);}
    }
    return -1;
}
export class ClassSpan {readonly start:number;readonly end:number;constructor(start:number,end:number){this.start=start;this.end=end;}}
export class ClassScan {readonly spans:ClassSpan[]=[];ok=true;}
function scanClass(p:PatternBytes,start:number,f:RegexFlags,result:ClassScan):number {
    const end=classEnd(p,start,f);if(end<0){result.ok=false;return -1;}
    if(f.sets){let i=start+1;if(p.at(i)===94){i++;}while(i<end-1){if(p.at(i)===92){const step=skipPatternEscape(p,i,f);if(step===0){result.ok=false;return -1;}i+=step;}else if(p.at(i)===91){i=scanClass(p,i,f,result);if(i<0){return -1;}}else{i+=Math.max(1,p.rune(i).width);}}}
    result.spans.push(new ClassSpan(start,end));return end;
}
export function scanClasses(p:PatternBytes,f:RegexFlags):ClassScan {
    const result=new ClassScan();let i=0;
    while(i<p.bytes.length){if(p.at(i)===92){const step=skipPatternEscape(p,i,f);if(step===0){result.ok=false;break;}i+=step;}else if(p.at(i)===91){i=scanClass(p,i,f,result);if(i<0){break;}}else{i+=Math.max(1,p.rune(i).width);}}
    return result;
}
export function readClassEscape(p:PatternBytes,i:number,f:RegexFlags):EscapeResult {
    if(i+1>=p.bytes.length){return failedEscape();}
    const next=p.at(i+1);
    if([100,68,119,87,115,83].includes(next)){return breaker(i,i+2);}
    if(next===98){return single(8,i,i+2);}
    if(next===66){return f.uv()?failedEscape():single(66,i,i+2);}
    if(next===112||next===80||next===113){if(f.uv()&&p.at(i+2)===123){const end=p.find(125,i+3);return end<0?failedEscape():breaker(i,end+1);}return single(next,i,i+2);}
    if(next===120){return p.hex(i+2,i+4)?single(p.hexUint(i+2,i+4),i,i+4):single(next,i,i+2);}
    if(next===117){
        if(p.at(i+2)===123){if(!f.uv()){return single(117,i,i+2);}const end=p.find(125,i+3);if(end<0||!p.hex(i+3,end)){return failedEscape();}return single(p.hexUint(i+3,end),i,end+1,true);}
        if(p.hex(i+2,i+6)){
            const high=p.hexUint(i+2,i+6);
            if(f.uv()&&high>=55296&&high<=56319&&p.at(i+6)===92&&p.at(i+7)===117&&p.hex(i+8,i+12)){const low=p.hexUint(i+8,i+12);if(low>=56320&&low<=57343){return single(65536+(high-55296)*1024+low-56320,i,i+12);}}
            return single(high,i,i+6);
        }
        return single(117,i,i+2);
    }
    if(next===110){return single(10,i,i+2);}if(next===116){return single(9,i,i+2);}if(next===114){return single(13,i,i+2);}if(next===118){return single(11,i,i+2);}if(next===102){return single(12,i,i+2);}if(next===48){return single(0,i,i+2);}
    if(next===99){return i+2<p.bytes.length?single(p.at(i+2)&31,i,i+3):failedEscape();}
    const rune=p.rune(i+1);return rune.width===0?failedEscape():single(rune.value,i,i+1+rune.width);
}
function rawCharacter(p:PatternBytes,i:number):EscapeResult {const rune=p.rune(i);return rune.width===0?failedEscape():single(rune.value,i,i+rune.width);}
export class ClassParse {
    readonly elements:CharacterElement[];readonly end:number;readonly ok:boolean;
    constructor(elements:CharacterElement[],end:number,ok:boolean){this.elements=elements;this.end=end;this.ok=ok;}
}
export function parseClass(p:PatternBytes,start:number,f:RegexFlags):ClassParse {
    if(p.at(start)!==91){return new ClassParse([],start,false);}
    let i=start+1;if(p.at(i)===94){i++;}let pending=-1;const out:CharacterElement[]=[];
    while(i<p.bytes.length){
        const c=p.at(i);
        if(c===93){return new ClassParse(out,i+1,true);}
        if(c===92){const token=readClassEscape(p,i,f);if(!token.ok){return new ClassParse([],start,false);}out.push(token.element);pending=token.element.kind===2?-1:out.length-1;i+=token.step;}
        else if(c===91&&f.sets){const end=classEnd(p,i,f);if(end<0){return new ClassParse([],start,false);}out.push(breaker(i,end).element);i=end;pending=-1;}
        else if((c===45||c===38)&&f.sets&&p.at(i+1)===c){out.push(breaker(i,i+2).element);i+=2;pending=-1;}
        else if(c===45&&pending>=0&&i+1<p.bytes.length&&p.at(i+1)!==93){
            i++;const next=p.at(i)===92?readClassEscape(p,i,f):rawCharacter(p,i);
            if(!next.ok||next.element.kind!==0){return new ClassParse([],start,false);}
            const minimum=out[pending]??panic('missing range minimum');const maximum=next.element;
            out[pending]=new CharacterElement(1,minimum.value,minimum.brace,maximum.value,maximum.brace,minimum.start,maximum.end);i+=next.step;pending=-1;
        }
        else{const token=rawCharacter(p,i);if(!token.ok){return new ClassParse([],start,false);}out.push(token.element);pending=out.length-1;i+=token.step;}
    }
    return new ClassParse([],start,false);
}
export function parseClassWithEnd(p:PatternBytes,start:number,end:number,f:RegexFlags):ClassParse {
    if(start<0||end<=start||end>p.bytes.length||p.at(end-1)!==93){return new ClassParse([],start,false);}
    const parsed=parseClass(p,start,f);return !parsed.ok||parsed.end!==end?new ClassParse([],start,false):parsed;
}

// Source AST offsets use UTF-16; diagnostic and checker offsets use UTF-8.
export function sourceOffsets(source:string):number[] {
    const offsets:number[]=[0];let bytes=0;
    for(let i=0;i<source.length;i++){
        const point=source.codePointAt(i)??panic('missing source code point');
        if(point>65535){offsets.push(bytes);i++;}
        bytes+=point<128?1:point<2048?2:point<65536?3:4;offsets.push(bytes);
    }
    return offsets;
}
