import type { Rules } from '../../rules.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { tsgoInspect } from 'adamic';
import { Frames, header } from '../../frames.ts';
export class ScopeValueSymbols {
    readonly names: readonly string[];
    readonly flags: readonly number[];
    constructor(rules: Rules, node: ParseNode) {
        rules.queries++;
        const frames = new Frames(tsgoInspect(rules.program, rules.path,
            rules.byte(node.pos), rules.byte(node.end), 'LabeledStatement', 'scope-value-symbols'));
        header(frames, 'scope-value-symbols');
        const count = frames.natural();
        const names: string[] = []; const flags: number[] = [];
        for(let at = 0; at < count; at++) { names.push(frames.field()); flags.push(frames.natural()); }
        frames.end();
        this.names = names; this.flags = flags;
    }
}
