import type { Rules } from '../../rules.ts';
import { Frames, header } from '../../frames.ts';
export class ScopeValueSymbols {
    readonly names: readonly string[];
    readonly flags: readonly number[];
    constructor(rules: Rules, index: number) {
        const frames = new Frames(rules.ask(index, 'scope-value-symbols'));
        header(frames, 'scope-value-symbols');
        const count = frames.natural();
        const names: string[] = []; const flags: number[] = [];
        for(let at = 0; at < count; at++) { names.push(frames.field()); flags.push(frames.natural()); }
        frames.end();
        this.names = names; this.flags = flags;
    }
}
