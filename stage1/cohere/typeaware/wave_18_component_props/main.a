import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { byteOffsets } from '../unary_minus.ts';
import { ComponentFacts, ComponentNode } from './component_property_syntax_facts.a';
import { StaticPropertyPlacement } from './static_property_placement/index.a';
import { StylePropObject } from './style_prop_object/index.a';
const args = programArguments();
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((p) => p !== '');
const program = tsgoProgram(args[0] ?? panic('missing config'), paths);
let count = 0;
for(const path of paths) {
    const source = readTextFile(path);
    if(source.kind === 'Error') {
        panic(source.message);
    }
    const offsets = byteOffsets(source.text);
    const facts = new ComponentFacts(program, path, offsets[source.text.length] ?? panic('missing end'));
    const overrides = new Map<string, string>();
    if(args.includes('--override')) {
        overrides.set('displayName', 'static getter');
    }
    const placement = new StaticPropertyPlacement(
        facts,
        args.includes('--getter')
            ? 'static getter'
            : args.includes('--assignment')
              ? 'property assignment'
              : 'static public field',
        overrides,
    );
    const style = new StylePropObject(facts, args.includes('--allow') ? ['div', 'Foo'] : []);
    const callbacks = new Map<number, ((node: ComponentNode) => void)[]>();
    callbacks.set(173, [(node: ComponentNode) => placement.property(node)]);
    callbacks.set(178, [(node: ComponentNode) => placement.getter(node)]);
    callbacks.set(227, [(node: ComponentNode) => placement.assignment(node)]);
    callbacks.set(292, [(node: ComponentNode) => style.attribute(node)]);
    callbacks.set(214, [(node: ComponentNode) => style.call(node)]);
    for(let at = 1; at < facts.sourceCount; at++) {
        const node = facts.require(at);
        const listeners = callbacks.get(node.kind);
        if(listeners !== undefined) {
            for(const visit of listeners) {
                visit(node);
            }
        }
    }
    for(const finding of facts.findings) {
        finding.sortKey = finding.written();
    }
    facts.findings.sort((a, b) => (a.sortKey < b.sortKey ? -1 : a.sortKey > b.sortKey ? 1 : 0));
    count += facts.findings.length;
    if(!args.includes('--count')) {
        console.log(`file\t${written(path)}`);
        for(const finding of facts.findings) {
            console.log(finding.written());
        }
    }
}
console.log(`findings ${count}`);
tsgoRelease(program);
