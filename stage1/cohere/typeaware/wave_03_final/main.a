import { panic,programArguments,readTextFile,tsgoProgram,tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { SourceSyntaxForest } from '../wave_03_react/source_syntax_forest.a';
import { SyntaxGraph } from './syntax_graph.a';
import { create as symbolRule } from './rules/symbol-description/rule.a';
import { create as hookRule } from './rules/react-hook-no-any-type/rule.a';
import { create as awaitRule } from './rules/require-await/rule.a';
const args=programArguments();const config=args[0]??panic('missing config');const manifest=readTextFile(args[1]??panic('missing manifest'));if(manifest.kind==='Error'){panic(manifest.message);}
const catalog=readTextFile(args[2]??panic('missing linked rule metadata'));if(catalog.kind==='Error'){panic(catalog.message);}const blinded=catalog.text.split('\n').filter(name=>name!=='');
const paths=manifest.text.split('\n').filter(path=>path!=='');const program=tsgoProgram(config,paths);const forest=new SourceSyntaxForest(program);let findings=0;
for(const path of paths){const source=readTextFile(path);if(source.kind==='Error'){panic(source.message);}const graph=new SyntaxGraph(forest.file(path),source.text);const symbol=symbolRule(graph);const hook=hookRule(graph,blinded);const awaiting=awaitRule(graph);
 for(const node of graph.nodes){switch(node.kind){case 214:symbol.visit(node);hook.visit(node);break;case 263:case 219:case 220:case 175:case 178:case 179:case 177:awaiting.visit(node);break;}}
 for(const finding of graph.tree.findings){finding.sortKey=finding.written();}graph.tree.findings.sort((left,right)=>left.sortKey<right.sortKey?-1:left.sortKey>right.sortKey?1:0);findings+=graph.tree.findings.length;
 if(!args.includes('--count')){console.log(`file\t${written(path)}`);for(const finding of graph.tree.findings){console.log(finding.written());}}
}console.log(`findings ${findings}`);tsgoRelease(program);
