import { AtomicReadState } from '../require_atomic_updates/state.a';
for(let mode = 0; mode < 16; mode++) {
    const left = new AtomicReadState();
    const right = new AtomicReadState();
    left.transfer(0, 1);
    if((mode & 1) !== 0) {
        left.transfer(1, 0);
    }
    if((mode & 2) !== 0) {
        left.transfer(0, 1);
    }
    right.transfer(0, 2);
    if((mode & 4) !== 0) {
        right.transfer(1, 0);
    }
    const joined = left.meet(right);
    if((mode & 8) !== 0) {
        joined.transfer(1, 0);
    }
    console.log(`${mode} ${joined.transfer(2, 1)} ${joined.transfer(2, 2)} ${left.outdated.has(1)} ${right.outdated.has(2)}`);
}
