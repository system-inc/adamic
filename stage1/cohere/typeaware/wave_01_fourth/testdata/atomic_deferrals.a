import { AtomicPositionedEvent, AtomicDeferral, placeAtomicDeferrals } from '../require_atomic_updates/deferrals.a';
for(let mode = 0; mode < 32; mode++) {
    const kept = [new AtomicPositionedEvent(1, 0, 2), new AtomicPositionedEvent(2, 4, 6), new AtomicPositionedEvent(3, (mode & 4) !== 0 ? -1 : 8, 10)];
    const deferrals = [
        new AtomicDeferral((mode & 8) !== 0 ? 3 : 20, (mode & 8) !== 0 ? 12 : 30, mode & 3, new AtomicPositionedEvent(4, 3, 12)),
        new AtomicDeferral(0, (mode & 16) !== 0 ? 2 : 20, 0, new AtomicPositionedEvent(5, 0, 20)),
    ];
    let text = `${mode}`;
    for(const event of placeAtomicDeferrals(kept, deferrals)) {
        text += ` ${event.id}`;
    }
    console.log(text);
}
