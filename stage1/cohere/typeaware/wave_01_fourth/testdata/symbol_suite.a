import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { Frames, header } from '../../frames.ts';
import { written } from '../../../../typescript/parser/nodes.ts';
import { HandedNode, SymbolDescription } from '../symbol_description/rule.a';
import type { Diagnostic } from '../../diagnostic.ts';

const args = programArguments();
const config = args[0] ?? panic('missing config');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
const packet = readTextFile(args[2] ?? panic('missing numeric node capture'));
if(manifest.kind === 'Error' || packet.kind === 'Error') {
    panic('cannot read driver inputs');
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
const frames = new Frames(packet.text);
header(frames, 'numeric-nodes');
const files = frames.natural();
const listener = new SymbolDescription();
let findings = 0;
for(let file = 0; file < files; file++) {
    const path = frames.field();
    const count = frames.natural();
    const diagnostics: Diagnostic[] = [];
    for(let index = 0; index < count; index++) {
        const kind = frames.natural();
        const position = frames.natural();
        const start = frames.natural();
        const end = frames.natural();
        if(listener.listenerKinds.includes(kind)) {
            const diagnostic = listener.onNode(program, path, new HandedNode(kind, position, start, end));
            if(diagnostic !== undefined) {
                diagnostic.sortKey = diagnostic.written();
                diagnostics.push(diagnostic);
            }
        }
    }
    diagnostics.sort((left, right) => left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0);
    console.log(`file\t${written(path)}`);
    for(const diagnostic of diagnostics) {
        console.log(diagnostic.written());
    }
    findings += diagnostics.length;
}
frames.end();
console.log(`findings ${findings}`);
tsgoRelease(program);
