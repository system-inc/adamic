import { panic } from 'adamic';
import { AtomicBlock, AtomicSolution } from '../require_atomic_updates/solver.a';
for(let mode = 0; mode < 16; mode++) {
    const blocks = [
        new AtomicBlock([1, 2], [0, 1]),
        new AtomicBlock([3], (mode & 1) !== 0 ? [1, 0] : []),
        new AtomicBlock([3], (mode & 2) !== 0 ? [0, 2, 1, 0] : [0, 2]),
        new AtomicBlock((mode & 4) !== 0 ? [1, 4] : [4], (mode & 8) !== 0 ? [0, 1] : []),
        new AtomicBlock([], [2, 1, 2, 2]),
        new AtomicBlock([4], [0, 3, 1, 0]),
    ];
    const solution = new AtomicSolution(blocks);
    for(let index = 0; index < blocks.length; index++) {
        const state = solution.incoming[index] ?? panic('missing result');
        console.log(`${mode} ${index} ${solution.reachable.has(index)} ${state.fresh.has(1)} ${state.fresh.has(2)} ${state.outdated.has(1)} ${state.outdated.has(2)} ${state.outdated.has(3)}`);
    }
}
