import { Diagnostic } from '../../diagnostic.ts';
export function atomicDiagnostic(start: number, end: number, name: string, target: string, property: boolean): Diagnostic {
    const id = property ? 'nonAtomicObjectUpdate' : 'nonAtomicUpdate';
    const message = property
        ? 'This property assignment is computed from an object that was read before an await or a yield, so the object may have been replaced or mutated while the function was suspended and this write lands on a stale view of it. The read and the write look adjacent in the source and are not adjacent in time. Re-read the object after the suspension, or keep the whole update on one side of it. Here the assignment writes ' + target + ' and the object ' + name + ' was read before the suspension.'
        : 'This reassignment is not atomic. The value it is computed from was read before an await or a yield, and the function is suspended in between, so anything else that runs during the suspension can write the variable and have its write overwritten by this line. The read and the write look adjacent in the source and are not adjacent in time. Read the variable after the suspension, or keep the whole update on one side of it. Here the variable is ' + name + '.';
    return new Diagnostic('require-atomic-updates', id, message, start, end, '');
}
