// Adapted from cohere's process-output path state. The diagnostic rules still
// require a native event graph and checker facts before this state can run on source.
export class ProcessOutputState {
    readonly chains: readonly string[];
    constructor(chains: readonly string[] = []) { this.chains = chains; }
    holds(outer: string, inner: string): boolean {
        return inner.split(',').every((id) => id === '' || outer.includes(`,${id},`));
    }
    with(chain: string): ProcessOutputState {
        const next: string[] = [];
        for(const held of this.chains) {
            if(this.holds(chain, held)) { return this; }
            if(!this.holds(held, chain)) { next.push(held); }
        }
        next.push(chain); next.sort((left, right) => left < right ? -1 : left > right ? 1 : 0); return new ProcessOutputState(next);
    }
    entering(index: number): ProcessOutputState {
        return new ProcessOutputState(this.chains.filter((held) => !held.includes(`,${index},`)));
    }
    key(): string { return this.chains.join('|'); }
}
