// Private prepared syntax inputs. A native parser/checker adapter is still missing.
export class DeclarationInput {
 kind=''; imported=''; module=''; initializerKind=''; initializerName=''; receiverKind=''; receiverName=''; firstKind=''; firstText=''; receiverFirstKind=''; receiverFirstText=''; objectBinding=false; variableParent=false;
}
export class TagInput {
 kind=''; text=''; receiverKind=''; receiverText=''; depth=0; start=0; end=0;
}
export class ElementInput {
 start=0; end=0; attributes=0; readonly tag=new TagInput(); readonly declarations:DeclarationInput[]=[];
}
export class ChildInput {
 kind=''; text=''; tagKind=''; tagText=''; firstKind=''; firstText='';
}
export class ContainerInput {
 start=0; end=0; readonly children:ChildInput[]=[]; readonly callee=new TagInput(); readonly declarations:DeclarationInput[]=[]; argumentsCount=0; thirdKind='';
}
