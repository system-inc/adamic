import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { UnaryMinus, byteOffsets } from '../unary_minus.ts';
import { Rules } from '../rules.ts';
import { ButtonHasType } from './button_has_type.a';
import { CheckedRequires } from './checked_requires.a';
import { DisplayName } from './display_name.a';
import { ReactSyntax } from './react_syntax.a';

function sourceIdentity(config: string, path: string): string {
    if(!path.startsWith('/') && !config.startsWith('/')) {
        panic('wave 02: relative roots require an absolute tsconfig path');
    }
    const rooted = path.startsWith('/') ? path : `${config.slice(0, config.lastIndexOf('/') + 1)}${path}`;
    const parts: string[] = [];
    for(const part of rooted.split('/')) {
        if(part === '' || part === '.') {
            continue;
        }
        if(part === '..') {
            parts.pop();
        }
        else {
            parts.push(part);
        }
    }
    return `/${parts.join('/')}`;
}

const args = programArguments();
const config = args[0] ?? panic('usage: wave_02_continuation_suite.a tsconfig manifest [--count]');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') {
    panic(manifest.message);
}
const paths = manifest.text.split('\n').filter((path) => path !== '');
const sourcePaths = paths.map((path) => sourceIdentity(config, path));
const program = tsgoProgram(config, sourcePaths);
let findings = 0;
for(const path of paths) {
    const sourceFile = sourcePaths[paths.indexOf(path)] ?? panic('missing source identity');
    const source = readTextFile(sourceFile);
    if(source.kind === 'Error') {
        panic(source.message);
    }
    const parser = new Parser(source.text, sourceFile);
    const scanner = new Scanner(source.text);
    const offsets = byteOffsets(source.text);
    const unary = new UnaryMinus(program, sourceFile, parser, scanner, offsets);
    const linter = new Rules(program, sourceFile, parser, scanner, offsets, unary);
    const root = parser.file();
    if(path.endsWith('.tsx') && parser.nodes.some((node) => node.kind === 'TypeAssertionExpression')) {
        panic('wave 02: shared parser cannot represent JSX; TSX was read as a type assertion');
    }
    for(let remaining = parser.nodes.length; remaining > 0; remaining--) {
        linter.parents.push(-1);
    }
    linter.links(root, -1);
    const syntax = new ReactSyntax(linter, sourceFile);
    new ButtonHasType(linter, syntax).run();
    new CheckedRequires(linter, syntax).run();
    new DisplayName(linter, syntax).run();
    for(const finding of linter.findings) {
        finding.sortKey = finding.written();
    }
    linter.findings.sort((left, right) => (left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0));
    findings += linter.findings.length;
    if(!args.includes('--count')) {
        console.log(`file\t${written(path)}`);
        for(const finding of linter.findings) {
            console.log(finding.written());
        }
    }
}
console.log(`findings ${findings}`);
tsgoRelease(program);
