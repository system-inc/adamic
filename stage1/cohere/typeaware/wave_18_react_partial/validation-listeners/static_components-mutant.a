import { panic } from 'adamic';
import { Diagnostic } from '/workspace/adamic/stage1/cohere/typeaware/diagnostic.ts';

// Reporting portion only. No source-analysis fallback may silently return no findings.
export class StaticComponents {
    // Pinned parser SyntaxKind.SourceFile. The driver supplies the source node once.
    readonly syntaxKinds: readonly number[] = [307];
    render(created: string, start: number, end: number): Diagnostic {
        const where = created !== '' ? `at \`${created}\`` : 'in this render';
        return new Diagnostic(
            'react-hooks/static-components',
            'staticComponentsMutant',
            `This component is created during render, ${where}, so it gets a new identity every time this function runs. React compares components by identity, so it unmounts the previous one and mounts this as a fresh component rather than updating it, discarding all of its state and re-rendering its whole subtree on every render. The usual symptom is an input that loses what was typed into it. Move the component to module scope, or pass the value that varies as a prop.`,
            start,
            end,
            '',
        );
    }
    analyze(): void {
        panic(
            'NotYet: react-hooks/static-components needs native React HIR, SSA phi propagation and JSX compilation-unit lowering',
        );
    }
}
