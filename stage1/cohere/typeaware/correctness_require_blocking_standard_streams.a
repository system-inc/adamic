import { panic } from 'adamic';
import type { Bindings } from './bindings.ts';
import { BlockingStreamIndex } from './blocking_stream_index.a';
import { ProcessNodeFields } from './process_node_fields.a';
import { SymbolDeclarationPath, SymbolDeclarationSet } from './symbol_declaration_paths.a';
import { ProcessOutputCalls, processCollectCalls } from './process_output_calls.a';
import { ProcessControlFlow, processRootOf } from './process_control_flow.a';
import { ProcessOutputChains } from './correctness_no_process_exit_after_output.a';
import { ProcessOutputState } from './process_output_state.a';
import { Diagnostic } from './diagnostic.ts';

class StreamPosition {
    readonly block: number; readonly state: ProcessOutputState;
    constructor(block: number, state: ProcessOutputState) { this.block = block; this.state = state; }
}
class StreamStarted {
    readonly runs: readonly number[]; readonly handsOn: readonly number[];
    constructor(runs: readonly number[], handsOn: readonly number[]) { this.runs = runs; this.handsOn = handsOn; }
}
class StreamEvent {
    readonly kind: string; readonly node: number; readonly started: StreamStarted; readonly argumentsMayBlock: boolean;
    constructor(kind: string, node: number, started: StreamStarted, argumentsMayBlock: boolean) { this.kind = kind; this.node = node; this.started = started; this.argumentsMayBlock = argumentsMayBlock; }
}
class StreamRootResult {
    readonly exits: readonly number[]; readonly started: readonly number[];
    constructor(exits: readonly number[], started: readonly number[]) { this.exits = exits; this.started = started; }
}
export function streamFunctionWithBody(bindings: Bindings, index: number): boolean {
    return bindings.functionKind(bindings.rules.parser.node(index).kind) && new ProcessNodeFields(bindings, index).get(2) >= 0;
}
export function streamCallLike(bindings: Bindings, index: number): boolean { return ['CallExpression', 'NewExpression', 'TaggedTemplateExpression'].includes(bindings.rules.parser.node(index).kind); }
// Numeric TypeScript SyntaxKind listeners, matching the pinned Go cohere registry.
export const requireBlockingStandardStreamsSyntaxKinds: readonly number[] = [307];

export class RequireBlockingStandardStreams {
    readonly syntaxKinds = requireBlockingStandardStreamsSyntaxKinds;
    readonly emptyStrings: readonly string[] = [];
    readonly bindings: Bindings; readonly index: BlockingStreamIndex; readonly calls: ProcessOutputCalls; readonly ordered: boolean;
    readonly functionMayBlock = new Map<string, number>(); readonly symbolFacts = new Map<string, SymbolDeclarationSet>(); readonly fields = new Map<string, ProcessNodeFields>();
    constructor(bindings: Bindings, index: BlockingStreamIndex, calls: ProcessOutputCalls, ordered: boolean) { this.bindings = bindings; this.index = index; this.calls = calls; this.ordered = ordered; }
    syntax(bindings: Bindings, node: number): ProcessNodeFields {
        const key = `${bindings.rules.path}:${node}`;
        if(!this.fields.has(key)) { this.fields.set(key, new ProcessNodeFields(bindings, node)); }
        return this.fields.get(key) ?? panic('missing stream syntax');
    }
    symbols(bindings: Bindings, node: number): SymbolDeclarationSet {
