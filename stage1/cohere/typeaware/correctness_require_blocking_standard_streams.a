        if(!this.symbolFacts.has(key)) { this.symbolFacts.set(key, new SymbolDeclarationSet(bindings.rules, node)); }
        return this.symbolFacts.get(key) ?? panic('missing stream symbols');
    }
    arguments(bindings: Bindings, index: number): number[] {
        const node = bindings.rules.parser.node(index); return ['CallExpression', 'NewExpression'].includes(node.kind) && node.list > 0 ? node.children.slice(node.children.length - node.list) : [];
    }
    handsOnMayBlock(bindings: Bindings, index: number): boolean {
        index = bindings.rules.skip(index); const node = bindings.rules.parser.node(index);
        if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) { return this.mayBlockWhenRun(bindings, index); }
        if(node.kind !== 'Identifier') { return false; } const symbols = this.symbols(bindings, index);
        return (symbols.flags & 16) !== 0 && this.symbolMayBlock(bindings, index);
    }
    callMayBlock(bindings: Bindings, index: number): boolean {
        const rules = bindings.rules; const node = rules.parser.node(index); if(!streamCallLike(bindings, index)) { return false; }
        const callee = rules.skip(node.children[0] ?? -1); const called = rules.parser.node(callee);
        if(node.kind === 'CallExpression' && rules.parser.node(node.children[0] ?? -1).kind === 'ImportKeyword') { return true; }
        for(const argument of this.arguments(bindings, index)) { if(this.handsOnMayBlock(bindings, argument)) { return true; } }
        if(['FunctionExpression', 'ArrowFunction'].includes(called.kind)) { return this.mayBlockWhenRun(bindings, callee); }
        let name = callee; if(called.kind === 'PropertyAccessExpression') { name = called.children[called.children.length - 1] ?? -1; }
        else if(called.kind !== 'Identifier') { return true; }
        return this.symbolMayBlock(bindings, name);
    }
    symbolMayBlock(bindings: Bindings, name: number): boolean {
        const symbols = this.symbols(bindings, name); if(symbols.declarations.length === 0) { return true; }
        for(const declaration of symbols.declarations) { if(this.declarationMayBlock(declaration, bindings.rules.parser.node(name).text)) { return true; } }
        return false;
    }
    declarationMayBlock(declaration: SymbolDeclarationPath, name: string): boolean {
        if(!this.index.canBlock.has(declaration.file)) { return declaration.declarationFile && name === 'require'; }
        if(declaration.declarationFile || declaration.kind === 'FunctionDeclaration' && declaration.name === 'blockStandardStreams' &&
            ['/source/system/StandardStreams.ts', '/source/system/StandardStreams.d.ts'].some((suffix) => declaration.file.endsWith(suffix))) { return true; }
        const bindings = this.index.context(declaration.file).bindings;
        const index = bindings.spans.get(`${declaration.kind}:${declaration.start}:${declaration.end}`) ?? panic('stream declaration absent from native tree');
        if(['FunctionDeclaration', 'MethodDeclaration', 'Constructor', 'GetAccessor', 'SetAccessor'].includes(declaration.kind)) {
            if(this.syntax(bindings, index).get(2) < 0) { return declaration.kind !== 'FunctionDeclaration' || (declaration.flags & 8388608) !== 0; }
            return this.mayBlockWhenRun(bindings, index);
        }
        if(declaration.kind === 'VariableDeclaration') { const initializer = this.syntax(bindings, index).get(3);
            if(initializer >= 0) { const value = bindings.rules.skip(initializer); if(['FunctionExpression', 'ArrowFunction'].includes(bindings.rules.parser.node(value).kind)) { return this.mayBlockWhenRun(bindings, value); } }
        }
        if(['ClassDeclaration', 'ClassExpression'].includes(declaration.kind)) { return this.mayBlockWhenRun(bindings, index); }
        return true;
    }
    nestedMayBlock(bindings: Bindings, index: number, topLevel: boolean): boolean {
        if(topLevel && streamFunctionWithBody(bindings, index)) { return false; }
        if(streamCallLike(bindings, index) && this.callMayBlock(bindings, index)) { return true; }
        for(const child of bindings.rules.parser.node(index).children) { if(this.nestedMayBlock(bindings, child, topLevel)) { return true; } }
        return false;
    }
    mayBlockWhenRun(bindings: Bindings, index: number): boolean {
        const key = `${bindings.rules.path}:${index}`; const cached = this.functionMayBlock.get(key) ?? 0;
        if(cached > 0) { return cached === 1; } this.functionMayBlock.set(key, 3);
        let blocks = false; for(const child of bindings.rules.parser.node(index).children) { if(this.nestedMayBlock(bindings, child, false)) { blocks = true; break; } }
        this.functionMayBlock.set(key, blocks ? 1 : 2); return blocks;
    }
    importsBlockAtLoad(): boolean {
        const file = this.bindings.rules.path; const seen = new Set<string>(); seen.add(file); const queue = [file];
        for(let cursor = 0; cursor < queue.length; cursor++) {
            for(const next of this.index.edges.get(queue[cursor] ?? '') ?? this.emptyStrings) {
                if(seen.has(next)) { continue; } seen.add(next); queue.push(next); if(!this.index.canBlock.has(next)) { continue; }
                const source = this.index.files.get(next);
                if(source === undefined || source.declarationFile) { return true; }
                const context = this.index.context(next);
                for(const child of context.bindings.rules.parser.node(context.root).children) { if(this.nestedMayBlock(context.bindings, child, true)) { return true; } }
            }
        }
        return false;
    }
    localFunction(index: number): number {
        const bindings = this.bindings; const rules = bindings.rules; index = rules.skip(index); const node = rules.parser.node(index);
        if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) { return index; } if(node.kind !== 'Identifier') { return -1; }
        for(const declaration of bindings.list(index, 'binding-declarations', false)) {
            const declared = rules.parser.node(declaration);
            if(declared.kind === 'FunctionDeclaration' && this.syntax(bindings, declaration).get(2) >= 0) { return declaration; }
            if(declared.kind === 'VariableDeclaration') {
                const parent = bindings.parent(declaration); const initializer = this.syntax(bindings, declaration).get(3);
                if(parent < 0 || rules.parser.node(parent).kind !== 'VariableDeclarationList' || rules.parser.node(parent).semantic !== '2' || initializer < 0) { continue; }
                const value = rules.skip(initializer); if(['FunctionExpression', 'ArrowFunction'].includes(rules.parser.node(value).kind)) { return value; }
            }
        }
        return -1;
    }
    startedFunctions(index: number): StreamStarted {
        const node = this.bindings.rules.parser.node(index); const runs: number[] = []; const handsOn: number[] = [];
        if(['CallExpression', 'TaggedTemplateExpression'].includes(node.kind)) {
            const callee = this.localFunction(node.children[0] ?? -1);
            if(callee >= 0) { if(this.bindings.rules.parser.node(callee).children.some((child) => this.bindings.rules.parser.node(child).kind === 'AsteriskToken')) { handsOn.push(callee); } else { runs.push(callee); } }
        }
        for(const argument of this.arguments(this.bindings, index)) { const functionIndex = this.localFunction(argument); if(functionIndex >= 0) { handsOn.push(functionIndex); } }
        return new StreamStarted(runs, handsOn);
    }
    argumentBlocks(index: number): boolean {
        if(streamFunctionWithBody(this.bindings, index)) { return false; }
        if(this.bindings.rules.parser.node(index).kind === 'AwaitExpression' || streamCallLike(this.bindings, index) && this.callMayBlock(this.bindings, index)) { return true; }
        for(const child of this.bindings.rules.parser.node(index).children) { if(this.argumentBlocks(child)) { return true; } } return false;
    }
    argumentsMayBlock(index: number): boolean { return this.arguments(this.bindings, index).some((argument) => this.argumentBlocks(argument)); }
    inRun(index: number, root: number): boolean {
        for(let current = this.bindings.parent(index); current >= 0 && current !== root; current = this.bindings.parent(current)) { if(streamFunctionWithBody(this.bindings, current)) { return false; } } return true;
    }
    recordable(index: number, root: number, recorded: Set<number>): boolean {
        const node = this.bindings.rules.parser.node(index);
        if(node.kind === 'CallExpression' && processRootOf(this.bindings, index) === root && this.calls.exit(index) && !recorded.has(index)) { return false; }
        if(this.ordered && !recorded.has(index) && this.inRun(index, root) && (node.kind === 'AwaitExpression' || streamCallLike(this.bindings, index) && this.callMayBlock(this.bindings, index))) { return false; }
        for(const child of node.children) { if(!this.recordable(child, root, recorded)) { return false; } } return true;
    }
    analyzeRoot(root: number): StreamRootResult {
        const bindings = this.bindings; const rules = bindings.rules; const graph = new ProcessControlFlow(bindings); graph.build(root);
        const events: StreamEvent[][] = []; const recorded = new Set<number>(); const none = new StreamStarted([], []);
        for(const block of graph.blocks) {
            const held: StreamEvent[] = [];
            for(const event of block.events) {
                const node = rules.parser.node(event.node);
                if(event.statement) {
                    const parent = bindings.parent(event.node);
                    if(node.kind === 'Block' && parent >= 0 && rules.parser.node(parent).kind === 'CatchClause') { held.push(new StreamEvent('catch', bindings.parent(parent), none, false)); }
                    if(this.ordered && (node.kind === 'ForOfStatement' && node.children.some((child) => rules.parser.node(child).kind === 'AwaitKeyword') ||
                        node.kind === 'VariableStatement' && node.children.some((child) => rules.parser.node(child).kind === 'VariableDeclarationList' && rules.parser.node(child).semantic === '6'))) { held.push(new StreamEvent('block', event.node, none, false)); }
                    continue;
                }
                if(bindings.functionKind(node.kind) || this.calls.inCatchBinding(event.node, root)) { continue; }
                if(node.kind === 'AwaitExpression') { if(this.ordered) { recorded.add(event.node); held.push(new StreamEvent('block', event.node, none, false)); } continue; }
                if(node.kind === 'CallExpression' && this.calls.exit(event.node)) { recorded.add(event.node); held.push(new StreamEvent('exit', event.node, none, false)); continue; }
                if(node.kind === 'CallExpression' && this.calls.write(event.node) && !this.calls.holdsExit(event.node)) { held.push(new StreamEvent('write', event.node, none, false)); }
                const started = this.startedFunctions(event.node);
                if(started.runs.length > 0 || started.handsOn.length > 0) { held.push(new StreamEvent('call', event.node, started, this.ordered && started.runs.length > 0 && this.argumentsMayBlock(event.node))); }
                if(this.ordered && this.callMayBlock(bindings, event.node)) { recorded.add(event.node); held.push(new StreamEvent('block', event.node, none, false)); }
            }
            events.push(held);
        }
        for(const child of rules.parser.node(root).children) { if(!this.recordable(child, root, recorded)) { return new StreamRootResult([], []); } }
        const chains = new ProcessOutputChains(bindings, root); const reported = new Set<number>(); const started = new Set<number>(); const startedOrder: number[] = [];
        const visited = new Set<string>(); visited.add('0:'); const queue = [new StreamPosition(0, new ProcessOutputState())];
        for(let cursor = 0; cursor < queue.length; cursor++) {
            const current = queue[cursor] ?? panic('missing stream graph position'); let state = current.state; let ended = false;
            for(const event of events[current.block] ?? panic('missing stream block events')) {
                if(event.kind === 'write') { state = state.with(chains.chain(event.node)); }
                else if(event.kind === 'catch') { state = state.entering(chains.id(event.node)); }
                else if(event.kind === 'call') {
                    if(!event.argumentsMayBlock) { for(const functionIndex of event.started.runs) { if(!started.has(functionIndex)) { started.add(functionIndex); startedOrder.push(functionIndex); } } }
                    if(!this.ordered) { for(const functionIndex of event.started.handsOn) { if(!started.has(functionIndex)) { started.add(functionIndex); startedOrder.push(functionIndex); } } }
                } else if(event.kind === 'exit') { if(state.chains.length > 0) { reported.add(event.node); } ended = true; }
                else if(event.kind === 'block') { ended = true; }
                if(ended) { break; }
            }
            if(ended) { continue; }
            for(const successor of graph.block(current.block).successors) { const key = `${successor}:${state.key()}`;
                if(!graph.block(successor).reachable || visited.has(key)) { continue; } visited.add(key); queue.push(new StreamPosition(successor, state)); }
        }
        const exits: number[] = []; for(const exit of reported) { exits.push(exit); } return new StreamRootResult(exits, startedOrder);
    }
    reachedExits(root: number): number[] {
        const queued = new Set<number>(); queued.add(root); const queue = [root]; const reported = new Set<number>(); const exits: number[] = [];
        for(let at = 0; at < queue.length; at++) { const found = this.analyzeRoot(queue[at] ?? panic('missing stream root'));
            for(const exit of found.exits) { if(!reported.has(exit)) { reported.add(exit); exits.push(exit); } }
            for(const functionIndex of found.started) { if(!queued.has(functionIndex)) { queued.add(functionIndex); queue.push(functionIndex); } }
        }
        return exits;
    }
    run(root: number): void {
        const rules = this.bindings.rules; const shebang = rules.scanner.text.startsWith('#!');
        if(!shebang && this.index.imported.has(rules.path) || this.ordered && this.importsBlockAtLoad()) { return; }
        const exits = this.reachedExits(root); if(exits.length === 0) { return; }
        exits.sort((left, right) => rules.parser.node(left).pos - rules.parser.node(right).pos); const node = rules.parser.node(exits[0] ?? -1);
        const reason = shebang ? 'it starts with `#!`' : 'nothing in the program imports it'; const count = exits.length > 1 ? `, the first of ${exits.length} such exits in this file` : '';
        const message = `This file runs as a process (${reason}), and this \`process.exit()\` runs after a write to stdout or stderr before the process has called \`blockStandardStreams()\`${count}. Node writes to a pipe asynchronously, and \`process.exit()\` does not wait: a reader piping this process gets the output cut off (measured: 65,536 of 1 MiB), with exit status 0 and no error. Call Nexus's \`blockStandardStreams()\` (\`source/system/StandardStreams\`) before anything that can exit: first in the module, or first in the main it runs.`;
        rules.findings.push(new Diagnostic('nexus/correctness-require-blocking-standard-streams', 'exitBeforeBlockingStandardStreams', message, rules.byte(rules.start(node)), rules.byte(node.end), ''));
    }
}
export function streamHasCandidate(bindings: Bindings, root: number, calls: ProcessOutputCalls): boolean {
    const nodes: number[] = []; processCollectCalls(bindings, root, nodes); const exits = new Set<number>(); const writes = new Set<number>();
    for(const node of nodes) { if(calls.exit(node)) { exits.add(processRootOf(bindings, node)); } if(calls.write(node)) { writes.add(processRootOf(bindings, node)); } }
    for(const owner of exits) { if(writes.has(owner)) { return true; } } return false;
}
