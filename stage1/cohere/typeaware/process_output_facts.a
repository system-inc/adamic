// Process provenance and syntax helpers shared only by these three claimed rules.
import { panic } from 'adamic';
import { SyntaxProjection } from './syntax_projection.a';
import { ProcessSymbols } from './process_symbol_details.a';
import { ResolvedCallDeclaration } from './resolved_call_declaration.a';
export class ProcessOutputFacts {
    readonly syntax: SyntaxProjection; readonly symbols: ProcessSymbols;
    readonly files = new Map<string, SyntaxProjection>(); readonly fileSymbols = new Map<string, ProcessSymbols>(); readonly bodyCache = new Map<string, boolean>();
    constructor(syntax: SyntaxProjection) { this.syntax = syntax; this.symbols = new ProcessSymbols(syntax); this.files.set(syntax.path, syntax); this.fileSymbols.set(syntax.path, this.symbols); }
    file(path: string): SyntaxProjection {
        const cached = this.files.get(path); if(cached !== undefined) { return cached; } const syntax = new SyntaxProjection(this.syntax.program, path); this.files.set(path, syntax); return syntax;
    }
    symbolsOf(syntax: SyntaxProjection): ProcessSymbols {
        const cached = this.fileSymbols.get(syntax.path); if(cached !== undefined) { return cached; } const symbols = new ProcessSymbols(syntax); this.fileSymbols.set(syntax.path, symbols); return symbols;
    }
    member(syntax: SyntaxProjection, expression: number): number {
        const node = syntax.node(expression);
        if(node.kind === 'Identifier') { return expression; }
