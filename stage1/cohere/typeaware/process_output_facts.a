        for(let parent = syntax.node(index).parent; parent !== 0 && parent !== root; parent = syntax.node(parent).parent) {
            const node = syntax.node(parent);
            if(node.kind === 'TryStatement' && node.children[0] === previous && node.children.some((child) => syntax.node(child).kind === 'CatchClause')) { ids.push(parent); }
            previous = parent;
