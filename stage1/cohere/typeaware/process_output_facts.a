    }
    write(syntax: SyntaxProjection, call: number): boolean {
        const callee = syntax.node(syntax.skip(syntax.node(call).expression)); if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(callee.kind)) { return false; }
        const key = callee.kind === 'PropertyAccessExpression' ? callee.name : callee.children[callee.children.length - 1] ?? 0; if(key === 0) { return false; }
        const name = syntax.node(key); if(callee.kind === 'ElementAccessExpression' && !['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(name.kind)) { return false; }
        const receiver = syntax.skip(callee.expression); const owner = syntax.node(receiver);
        if(['log', 'info', 'debug', 'warn', 'error', 'trace', 'table', 'dir', 'dirxml'].includes(name.text) && owner.kind === 'Identifier' && owner.text === 'console') {
            const symbol = this.symbolsOf(syntax).get(receiver);
            return symbol.declarations.length > 0 && symbol.declarations.every((declaration) => {
                if(!declaration.declarationFile || declaration.kind !== 'VariableDeclaration' || declaration.ancestors.length < 3 || declaration.ancestor(0).kind !== 'VariableDeclarationList' || declaration.ancestor(1).kind !== 'VariableStatement') { return false; }
                const container = declaration.ancestor(2);
                return container.kind === 'SourceFile' ? !declaration.external : container.kind === 'ModuleBlock' && declaration.ancestors.length > 3 && declaration.ancestor(3).globalAugmentation;
            });
        }
        if(name.text !== 'write') { return false; } const stream = this.member(syntax, receiver);
        return stream !== 0 && ['stdout', 'stderr'].includes(syntax.node(stream).text) && this.processMember(syntax, stream);
    }
    awaited(call: number): boolean {
        const syntax = this.syntax; let parent = syntax.node(call).parent;
        while(parent !== 0 && syntax.node(parent).kind === 'ParenthesizedExpression') { parent = syntax.node(parent).parent; }
        return parent !== 0 && syntax.node(parent).kind === 'AwaitExpression';
    }
    bodyWrites(syntax: SyntaxProjection, root: number): boolean {
        const key = `${syntax.path}:${root}`; const cached = this.bodyCache.get(key); if(cached !== undefined) { return cached; }
        const body = syntax.node(root).body; let wrote = false; let exits = false;
        const queue: number[] = body !== 0 && syntax.node(body).kind === 'Block' ? syntax.node(body).children.slice() : [body];
        for(let at = 0; at < queue.length && !exits; at++) {
            const index = queue[at] ?? panic('missing body syntax'); if(index === 0) { continue; } const node = syntax.node(index); if(node.isRoot) { continue; }
            if(node.kind === 'CallExpression') { if(this.exit(syntax, index)) { exits = true; } if(this.write(syntax, index)) { wrote = true; } }
            for(const child of node.children) { queue.push(child); }
        }
        const answer = wrote && !exits; this.bodyCache.set(key, answer); return answer;
    }
    writes(call: number): boolean {
        const syntax = this.syntax; if(this.write(syntax, call)) { return true; }
        const signature = new ResolvedCallDeclaration(syntax, call);
        if((signature.returnFlags & 262144) !== 0) { return false; }
        for(const declaration of signature.declarations) {
            if(!['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration'].includes(declaration.kind) || !declaration.body || (declaration.file !== syntax.path && !declaration.external) || (declaration.functionFlags & 1) !== 0 || ((declaration.functionFlags & 2) !== 0 && !this.awaited(call))) { return false; }
            const file = this.file(declaration.file); return this.bodyWrites(file, file.locate(declaration.kind, declaration.pos, declaration.end));
        }
        return false;
    }
    holdsExit(index: number): boolean {
        const syntax = this.syntax; const queue = syntax.node(index).children.slice();
        for(let at = 0; at < queue.length; at++) {
            const identity = queue[at] ?? 0; const node = syntax.node(identity); if(node.isRoot) { continue; }
            if(node.kind === 'CallExpression' && this.exit(syntax, identity)) { return true; }
            for(const child of node.children) { queue.push(child); }
        }
        return false;
    }
    catchBinding(index: number, root: number): boolean {
        const syntax = this.syntax; let previous = index;
        for(let parent = syntax.node(index).parent; parent !== 0 && parent !== root; parent = syntax.node(parent).parent) {
            const node = syntax.node(parent); if(node.kind === 'CatchClause' && node.children[0] === previous && syntax.node(previous).kind === 'VariableDeclaration') { return true; } previous = parent;
        }
        return false;
    }
    chain(index: number, root: number): string {
