        ids.sort((left, right) => left - right); return `,${ids.map((identity) => `${identity},`).join('')}`;
    }
}
export function chainHolds(outer: string, inner: string): boolean { return inner.split(',').every((part) => part === '' || outer.includes(`,${part},`)); }
export function withWrite(state: readonly string[], chain: string): readonly string[] {
    const next: string[] = [];
    for(const held of state) { if(chainHolds(chain, held)) { return state; } if(!chainHolds(held, chain)) { next.push(held); } }
    next.push(chain); next.sort((left, right) => left < right ? -1 : left > right ? 1 : 0); return next;
}
export function enteringCatch(state: readonly string[], identity: number): readonly string[] { return state.filter((chain) => !chain.includes(`,${identity},`)); }
export class ProcessPosition {
    readonly block: number; readonly state: readonly string[];
    constructor(block: number, state: readonly string[]) { this.block = block; this.state = state; }
}
