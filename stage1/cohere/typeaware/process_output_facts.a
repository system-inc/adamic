        return symbol.declarations.length > 0 && symbol.declarations.every((declaration) => declaration.declarationFile && ['MethodSignature', 'PropertySignature'].includes(declaration.kind) && declaration.ancestors.length >= 3 && declaration.ancestor(0).kind === 'InterfaceDeclaration' && declaration.ancestor(0).name === 'Process' && declaration.ancestor(1).kind === 'ModuleBlock' && declaration.ancestor(2).kind === 'ModuleDeclaration' && declaration.ancestor(2).name === 'NodeJS');
    }
    exit(syntax: SyntaxProjection, call: number): boolean {
