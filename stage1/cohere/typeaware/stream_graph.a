            this.condition(children[0] ?? -1, yes, no); this.enter(yes); this.statement(children[1] ?? -1); this.link(this.current, after);
            if(children.length > 2) { this.enter(no); this.statement(children[2] ?? -1); this.link(this.current, after); } this.enter(after); return;
        }
        if(node.kind === 'WhileStatement') {
            const test = this.fresh(); this.link(this.current, test); this.enter(test); const after = this.fresh(); const body = this.fresh();
            this.condition(children[0] ?? -1, body, this.truthy(children[0] ?? -1) ? -1 : after);
            this.push(index, after, test); this.enter(body); this.statement(children[1] ?? -1); this.link(this.current, test); this.pop(); this.enter(after); return;
        }
        if(node.kind === 'DoStatement') {
            const body = this.fresh(); this.link(this.current, body); const test = this.fresh(); const after = this.fresh();
            this.push(index, after, test); this.enter(body); this.statement(children[0] ?? -1); this.link(this.current, test); this.pop();
            this.enter(test); this.expr(children[1] ?? -1); this.link(this.current, body); if(!this.truthy(children[1] ?? -1)) { this.link(this.current, after); } this.enter(after); return;
        }
        if(node.kind === 'ForStatement') {
            const parts = this.forParts(index); const initializer = parts[0] ?? -1; const condition = parts[1] ?? -1; const increment = parts[2] ?? -1;
            if(initializer >= 0 && this.rules.parser.node(initializer).kind === 'VariableDeclarationList') { this.list(initializer); } else { this.expr(initializer); }
            const test = this.fresh(); this.link(this.current, test); this.enter(test); const after = this.fresh();
            if(condition < 0 && increment < 0) { this.push(index, after, test); this.statement(children[children.length - 1] ?? -1); this.link(this.current, test); this.pop(); this.enter(after); return; }
            const body = this.fresh(); this.condition(condition, body, condition < 0 || this.truthy(condition) ? -1 : after);
            let update = test; if(increment >= 0) { update = this.fresh(); this.disconnected(update); this.expr(increment); this.link(this.current, test); }
            this.push(index, after, update); this.enter(body); this.statement(children[children.length - 1] ?? -1); this.link(this.current, update); this.pop(); this.enter(after); return;
        }
        if(['ForInStatement', 'ForOfStatement'].includes(node.kind)) {
            const parts = children.filter((child) => this.rules.parser.node(child).kind !== 'AwaitKeyword'); this.expr(parts[1] ?? -1);
            const head = this.fresh(); this.link(this.current, head); this.enter(head); const after = this.fresh(); const body = this.fresh(); this.link(head, after); this.link(head, body);
            this.push(index, after, head); this.enter(body); const target = parts[0] ?? -1;
            if(this.rules.parser.node(target).kind === 'VariableDeclarationList') { for(const child of this.rules.parser.node(target).children) { this.bind(this.bindings.shape.name(child)); } } else { this.bind(target); }
            this.statement(parts[2] ?? -1); this.link(this.current, head); this.pop(); this.enter(after); return;
        }
        if(node.kind === 'SwitchStatement') {
            this.expr(children[0] ?? -1); const after = this.fresh(); const clauses = this.rules.parser.node(children[1] ?? -1).children;
            const bodies = clauses.map(() => this.fresh()); let defaultIndex = -1;
            for(let at = 0; at < clauses.length; at++) { const clause = this.rules.parser.node(clauses[at] ?? -1);
                if(clause.kind === 'DefaultClause') { defaultIndex = at; continue; }
                this.expr(clause.children[0] ?? -1); this.link(this.current, bodies[at] ?? -1); const next = this.fresh(); this.link(this.current, next); this.enter(next);
            }
            this.link(this.current, defaultIndex < 0 ? after : bodies[defaultIndex] ?? -1); this.push(index, after, -1); let fallthrough = -1;
            for(let at = 0; at < clauses.length; at++) { this.link(fallthrough, bodies[at] ?? -1); this.enter(bodies[at] ?? -1);
                const clause = this.rules.parser.node(clauses[at] ?? -1); for(const child of clause.children.slice(clause.kind === 'CaseClause' ? 1 : 0)) { this.statement(child); } fallthrough = this.current;
            } this.link(fallthrough, after); this.pop(); this.enter(after); return;
        }
        if(node.kind === 'TryStatement') { this.tryStatement(index); return; }
        if(node.kind === 'LabeledStatement') {
            const body = children[children.length - 1] ?? -1; const kind = this.rules.parser.node(body).kind;
            if(['SwitchStatement', 'WhileStatement', 'DoStatement', 'ForStatement', 'ForInStatement', 'ForOfStatement'].includes(kind)) { this.statement(body); return; }
            const after = this.fresh(); this.jumps.push(new StreamJump([this.rules.parser.node(children[0] ?? -1).text], after, -1, false));
            this.statement(body); this.pop(); this.link(this.current, after); this.enter(after); return;
        }
        if(node.kind === 'WithStatement') { this.expr(children[0] ?? -1); this.statement(children[1] ?? -1); return; }
        if(node.kind === 'ClassDeclaration') { this.classLike(index); return; }
        for(const child of children) { this.visit(child); }
    }
    tryStatement(index: number): void {
        const children = this.rules.parser.node(index).children; const catcher = children.find((child) => this.rules.parser.node(child).kind === 'CatchClause') ?? -1;
        const final = children.length > (catcher < 0 ? 1 : 2) ? children[children.length - 1] ?? -1 : -1;
        const frame = new StreamTry(catcher >= 0 ? this.fresh() : -1, final >= 0 ? this.fresh() : -1); this.tries.push(frame);
        this.statement(children[0] ?? -1); const ends: number[] = [];
        if(catcher >= 0) { this.link(this.current, frame.catchEntry); ends.push(this.current); frame.catching = true; frame.forked = false;
            this.enter(frame.catchEntry); const clause = this.rules.parser.node(catcher);
            for(const child of clause.children) { if(this.rules.parser.node(child).kind === 'VariableDeclaration') { this.bind(this.bindings.shape.name(child)); } }
            this.statement(clause.children[clause.children.length - 1] ?? -1);
        }
        ends.push(this.current); this.tries.pop(); const after = this.fresh();
        if(final < 0) { for(const end of ends) { this.link(end, after); } this.enter(after); return; }
        const snapshot = this.tries.map((outer) => outer.forked); const normal = this.fresh(); for(const end of ends) { this.link(end, normal); }
        for(const source of frame.implicit) { this.link(source, normal); } this.enter(normal); this.statement(final); this.link(this.current, after);
        if(this.block(frame.finallyEntry).incoming) {
            for(let at = 0; at < snapshot.length; at++) { const outer = this.tries[at]; if(outer !== undefined) { outer.forked = snapshot[at] ?? false; } }
            this.enter(frame.finallyEntry); this.statement(final);
            if(this.block(this.current).reachable) {
                if(frame.returned) { const at = this.returnFrame(); if(at >= 0) { const outer = this.tries[at] ?? panic('missing outer try'); outer.returned = true; this.link(this.current, outer.finallyEntry); } }
                if(frame.thrown) { const at = this.throwFrame(); if(at >= 0) { const outer = this.tries[at] ?? panic('missing outer try'); outer.thrown = true; this.link(this.current, this.target(outer)); } }
            }
        } this.enter(after);
    }
}
