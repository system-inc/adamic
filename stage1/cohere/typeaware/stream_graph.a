            const slot = start < (semicolons[0] ?? 0) ? 0 : start < (semicolons[1] ?? 0) ? 1 : 2; result[slot] = child;
        } return result;
    }
    statement(index: number): void {
        if(index < 0) { return; } const node = this.rules.parser.node(index); const children = node.children; this.emit(index, false);
        if(node.kind === 'Block') { for(const child of children) { this.statement(child); } return; }
        if(node.kind === 'VariableStatement') { this.list(children.find((child) => this.rules.parser.node(child).kind === 'VariableDeclarationList') ?? -1); return; }
        if(['ExpressionStatement', 'ExportAssignment'].includes(node.kind)) { this.expr(children[children.length - 1] ?? -1); return; }
        if(['EmptyStatement', 'DebuggerStatement', 'ImportDeclaration', 'ImportEqualsDeclaration', 'FunctionDeclaration', 'ExportDeclaration'].includes(node.kind)) { return; }
        if(['ReturnStatement', 'ThrowStatement'].includes(node.kind)) { this.expr(children[0] ?? -1); this.abrupt(node.kind === 'ReturnStatement'); return; }
        if(['BreakStatement', 'ContinueStatement'].includes(node.kind)) { this.jump(index, node.kind === 'ContinueStatement'); return; }
        if(node.kind === 'IfStatement') {
