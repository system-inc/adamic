    }
    forParts(index: number): number[] {
        const node = this.rules.parser.node(index); const scanner = this.rules.scanner; scanner.pos = node.pos;
        let depth = 0; const semicolons: number[] = []; let close = node.end;
        while(scanner.pos < node.end) {
            scanner.scan(); if(scanner.kind === 'OpenParenToken') { depth++; }
            if(scanner.kind === 'CloseParenToken') { depth--; if(depth === 0) { close = scanner.start; break; } }
            if(scanner.kind === 'SemicolonToken' && depth === 1) { semicolons.push(scanner.start); }
        }
        if(semicolons.length !== 2) { panic('for header missing separators'); }
        const result = [-1, -1, -1];
        for(const child of node.children.slice(0, -1)) {
