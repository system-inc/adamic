        const node = this.rules.parser.node(index); const name = node.children.length > 0 ? this.rules.parser.node(node.children[0] ?? -1).text : '';
        for(let at = this.jumps.length - 1; at >= 0; at--) { const jump = this.jumps[at] ?? panic('missing jump');
            if(continuing && jump.continuing < 0) { continue; }
            if(name === '' ? !continuing && !jump.breakable : !jump.labels.includes(name)) { continue; }
            this.link(this.current, continuing ? jump.continuing : jump.after); break;
