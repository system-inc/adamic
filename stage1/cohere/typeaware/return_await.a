import type { Rules } from './rules.ts';
import { types } from './facts.ts';
import { thenCallbackSignatures } from './then_callback_signatures.a';
import { Repair } from './repair.ts';
import { Suggestion } from './suggestion.ts';

// Pinned parser SyntaxKind values for the forthcoming kind-indexed driver.
export const returnAwaitSyntaxKinds: number[] = [254, 220];
export class ReturnAwait {
    readonly rules: Rules;
    constructor(rules: Rules) { this.rules = rules; }
    functionLike(index: number): boolean {
        return ['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration',
            'GetAccessor', 'SetAccessor', 'Constructor'].includes(this.rules.parser.node(index).kind);
    }
    enclosing(index: number): number {
        let at = this.rules.parents[index] ?? -1;
        while(at >= 0 && !this.functionLike(at)) { at = this.rules.parents[at] ?? -1; }
        return at;
    }
    async(index: number): boolean {
        return index >= 0 && this.rules.parser.node(index).children.some((child) => this.rules.parser.node(child).kind === 'AsyncKeyword');
    }
    errorHandling(index: number): boolean {
        const parser = this.rules.parser;
        const start = this.rules.start(parser.node(index));
        let child = index;
        let at = this.rules.parents[index] ?? -1;
        while(at >= 0 && !this.functionLike(at)) {
            const parent = parser.node(at);
            if(['Block', 'SourceFile', 'CaseClause', 'DefaultClause'].includes(parent.kind)) {
                for(const statement of parent.children) {
                    const node = parser.node(statement);
                    if(node.kind === 'VariableStatement' && node.end < start && node.children.some((part) =>
                        parser.node(part).kind === 'VariableDeclarationList' && ['4', '6'].includes(parser.node(part).semantic))) { return true; }
                }
            }
            if(parent.kind === 'TryStatement') {
                const catchClause = parent.children.find((part) => parser.node(part).kind === 'CatchClause') ?? -1;
                if(parent.children[0] === child || (catchClause === child && parent.children[parent.children.length - 1] !== catchClause)) { return true; }
            }
            child = at; at = this.rules.parents[at] ?? -1;
        }
        return false;
    }
    insert(index: number): Repair[] {
        const node = this.rules.parser.node(index);
        const start = this.rules.byte(this.rules.start(node));
        const strong = this.rules.strong(index) || ['ThisKeyword', 'SuperKeyword', 'NonNullExpression', 'PostfixUnaryExpression', 'MetaProperty'].includes(node.kind);
        const result = [new Repair(start, start, strong ? 'await ' : 'await (')];
        if(!strong) { result.push(new Repair(this.rules.byte(node.end), this.rules.byte(node.end), ')')); }
        return result;
    }
    remove(index: number): Repair[] {
        const parser = this.rules.parser;
        const node = parser.node(index);
        const operand = node.children[0] ?? -1;
        if(operand < 0) { return []; }
        const start = this.rules.start(node);
        const operandStart = this.rules.start(parser.node(operand));
        if(operandStart <= start) { return []; }
        let end = operandStart;
        const source = this.rules.scanner.text;
        for(let at = parser.node(operand).pos; at < operandStart; at++) {
            if(source.slice(at, at + 2) === '/*' || source.slice(at, at + 2) === '//') { end = at; break; }
        }
        const result = [new Repair(this.rules.byte(start), this.rules.byte(end), '')];
        const parent = this.rules.parents[index] ?? -1;
        if(source.slice(operandStart, operandStart + 1) === '{' && parent >= 0 && parser.node(parent).kind === 'ArrowFunction' && parser.node(parent).children[parser.node(parent).children.length - 1] === index) {
            result.push(new Repair(this.rules.byte(operandStart), this.rules.byte(operandStart), '('));
            result.push(new Repair(this.rules.byte(parser.node(operand).end), this.rules.byte(parser.node(operand).end), ')'));
        }
        return result;
    }
    test(index: number): void {
        const parser = this.rules.parser;
        const node = parser.node(index);
        const awaited = node.kind === 'AwaitExpression';
        const subject = awaited ? node.children[0] ?? -1 : index;
        if(subject < 0) { return; }
        const graph = types(this.rules.ask(subject, 'raw-shape'), 'raw-shape');
        const original = graph.root();
        if((original.flags & 524288) !== 0 && original.constraint === 0) { return; }
        const type = original.constraint === 0 ? original : graph.type(original.constraint);
        if((type.flags & 3) !== 0) { return; }
        const thenable = thenCallbackSignatures(this.rules, index, type.id).some((count) => count > 0);
        if(!thenable) {
            if(awaited) {
                const finding = this.rules.add('return-await', 'nonPromiseAwait', 'Returning an awaited value that is not a promise is not allowed.', index);
                for(const repair of this.remove(index)) { finding.repairs.push(repair); }
            }
            return;
        }
        const handling = this.errorHandling(index);
        if(handling && !awaited) {
            const finding = this.rules.add('return-await', 'requiredPromiseAwait', 'Returning an awaited promise is required in this context.', index);
            finding.suggestions.push(new Suggestion('requiredPromiseAwaitSuggestion', 'Add `await` before the expression. Use caution as this may impact control flow.', this.insert(index)));
        }
        if(!handling && awaited) {
            const finding = this.rules.add('return-await', 'disallowedPromiseAwait', 'Returning an awaited promise is not allowed in this context.', index);
            for(const repair of this.remove(index)) { finding.repairs.push(repair); }
        }
    }
    possibly(index: number): void {
        const actual = this.rules.skip(index);
        const node = this.rules.parser.node(actual);
        if(node.kind === 'ConditionalExpression') { this.possibly(node.children[2] ?? -1); this.possibly(node.children[4] ?? -1); }
        else { this.test(actual); }
    }
    run(): void {
        const parser = this.rules.parser;
        for(let index = 0; index < parser.nodes.length; index++) {
            if((this.rules.parents[index] ?? -1) < 0) { continue; }
            const node = parser.node(index);
            if(node.kind === 'ReturnStatement' && this.async(this.enclosing(index)) && node.children.length > 0) { this.possibly(node.children[0] ?? -1); }
            if(node.kind === 'ArrowFunction' && this.async(index)) {
                const body = node.children[node.children.length - 1] ?? -1;
                if(body >= 0 && parser.node(body).kind !== 'Block') { this.possibly(body); }
            }
        }
    }
}
