                continue;
            }
            if(sibling === child || syntaxTree.node(sibling).pos >= syntaxTree.node(child).pos) {
                return false;
            }
            if(this.siblingJump(sibling, sibling)) {
                return true;
            }
        }
        return false;
    }
    guarded(index: number, limit: number, siblings: boolean): boolean {
        const syntaxTree = this.context.syntax;
        if(
            ['ReturnStatement', 'ThrowStatement'].includes(syntaxTree.kind(index)) &&
            this.contains(syntaxTree.child(index, 0), true)
        ) {
            return true;
        }
        let child = index;
        for(let parent = syntaxTree.parent(child); parent >= 0 && child !== limit; parent = syntaxTree.parent(child)) {
            const kind = syntaxTree.kind(parent);
            if(['IfStatement', 'WhileStatement'].includes(kind) && this.contains(syntaxTree.child(parent, 0), true)) {
                return true;
            }
            if(kind === 'DoStatement' && this.contains(syntaxTree.last(parent), true)) {
                return true;
            }
            if(kind === 'ForStatement' && this.contains(this.header(parent)[1] ?? -1, true)) {
                return true;
            }
            if(['ForOfStatement', 'ForInStatement'].includes(kind) && this.contains(this.iterable(parent), true)) {
                return true;
            }
            if(['CaseClause', 'DefaultClause'].includes(kind)) {
                const caseBlock = syntaxTree.parent(parent);
                const statement = syntaxTree.parent(caseBlock);
                if(
                    this.contains(syntaxTree.child(statement, 0), true) ||
                    syntaxTree
                        .node(caseBlock)
                        .children.some(
                            (clause) =>
                                syntaxTree.kind(clause) === 'CaseClause' &&
                                this.contains(syntaxTree.child(clause, 0), true),
                        )
                ) {
                    return true;
                }
            }
            if(kind === 'CatchClause' && this.contains(syntaxTree.child(syntaxTree.parent(parent), 0), false)) {
                return true;
            }
            if(
                kind === 'TryStatement' &&
                syntaxTree.child(parent, 0) === child &&
                this.catchClause(parent) >= 0 &&
                this.contains(child, false, syntaxTree.node(index).pos)
            ) {
                return true;
            }
            if(siblings && ['Block', 'CaseClause', 'DefaultClause'].includes(kind) && this.earlier(parent, child)) {
                return true;
            }
            child = parent;
        }
        return false;
    }
    exitTainted(index: number): boolean {
        const syntaxTree = this.context.syntax;
        if(syntaxTree.boundary(index)) {
            return false;
        }
        return (
            (this.jump(index) && this.exits(index) && this.guarded(index, this.body, true)) ||
            syntaxTree.node(index).children.some((child) => this.exitTainted(child))
        );
    }
    run(): void {
        const ruleRunner = this.context.bindings.rules;
        const syntaxTree = this.context.syntax;
        for(let index = 0; index < ruleRunner.parser.nodes.length; index++) {
            if(
                !['ForOfStatement', 'ForStatement'].includes(syntaxTree.kind(index)) ||
                !this.shape(index) ||
                !this.holdsAwait(this.body, true) ||
                this.orderedEffect(this.body, false, false) ||
                this.carries()
            ) {
                continue;
            }
            for(let pass = 0; pass < 8; pass++) {
                if(!this.taint(this.body)) {
                    break;
                }
            }
            if(this.exitTainted(this.body)) {
                continue;
            }
            const start = ruleRunner.start(syntaxTree.node(index));
            let end = ruleRunner.start(syntaxTree.node(this.body));
            const source = ruleRunner.parser.scanner.text;
            while(end > start && [' ', '\t', '\r', '\n'].includes(source.slice(end - 1, end))) {
                end--;
            }
            ruleRunner.findings.push(
                new Diagnostic(
                    'nexus/performance-no-independent-await-in-loop',
                    'independentAwaitInLoop',
                    message,
                    ruleRunner.byte(start),
                    ruleRunner.byte(end),
                    '',
                ),
            );
        }
    }
}
