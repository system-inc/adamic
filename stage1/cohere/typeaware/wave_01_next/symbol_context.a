import type { Rules } from '../rules.ts';
import { Frames, header } from '../frames.ts';
import { Declaration } from './declaration.a';

export class SymbolContext {
    readonly id: number;
    readonly flags: number;
    readonly declarations: readonly Declaration[];
    constructor(ruleRunner: Rules, index: number, operation: string) {
        const frames = new Frames(ruleRunner.ask(index, `declaration-context\n${operation}`));
        header(frames, 'declaration-context');
        this.id = frames.natural();
        this.flags = frames.natural();
        const count = frames.natural();
        const declarations: Declaration[] = [];
        for(let at = 0; at < count; at++) {
            declarations.push(new Declaration(frames));
        }
        this.declarations = declarations;
        frames.end();
    }
}
