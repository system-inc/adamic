import { Frames, header } from '../frames.ts';
import type { Rules } from '../rules.ts';

export class Ancestor {
    readonly kind: string;
    readonly name: string;
    readonly flags: number;
    readonly keyword: string;
    constructor(kind: string, name: string, flags: number, keyword: string) {
        this.kind = kind;
        this.name = name;
        this.flags = flags;
        this.keyword = keyword;
    }
}
export class AncestryDeclaration {
    readonly file: string;
    readonly kind: string;
    readonly start: number;
    readonly end: number;
    readonly declarationFile: boolean;
    readonly library: boolean;
    readonly external: boolean;
    readonly parents: readonly Ancestor[];
    constructor(
        file: string,
        kind: string,
        start: number,
        end: number,
        declarationFile: boolean,
        library: boolean,
        external: boolean,
        parents: readonly Ancestor[],
    ) {
        this.file = file;
        this.kind = kind;
        this.start = start;
        this.end = end;
        this.declarationFile = declarationFile;
        this.library = library;
        this.external = external;
        this.parents = parents;
    }
}
export class SymbolAncestry {
    readonly present: boolean;
    readonly identity: number;
    readonly flags: number;
    readonly declarations: readonly AncestryDeclaration[];
    constructor(rules: Rules, index: number, followAlias = true) {
        const frames = new Frames(rules.ask(index, followAlias ? 'symbol-ancestry' : 'symbol-ancestry\nown'));
        header(frames, 'symbol-ancestry');
        this.present = frames.yes();
        let identity = 0;
        let flags = 0;
        const declarations: AncestryDeclaration[] = [];
        if(this.present) {
            identity = frames.natural();
            flags = frames.natural();
            const count = frames.natural();
            for(let at = 0; at < count; at++) {
                const file = frames.field();
                const kind = frames.field();
                const start = frames.natural();
                const end = frames.natural();
                const declarationFile = frames.yes();
                const library = frames.yes();
                const external = frames.yes();
                const parents: Ancestor[] = [];
                const length = frames.natural();
                for(let parent = 0; parent < length; parent++) {
                    parents.push(new Ancestor(frames.field(), frames.field(), frames.natural(), frames.field()));
                }
                declarations.push(
                    new AncestryDeclaration(file, kind, start, end, declarationFile, library, external, parents),
                );
            }
        }
        frames.end();
        this.identity = identity;
        this.flags = flags;
        this.declarations = declarations;
    }
}
