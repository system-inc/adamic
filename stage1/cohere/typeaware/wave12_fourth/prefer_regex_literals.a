        while(at >= 0) {
            if(' \t\r\n\v\f'.includes(text[at] ?? '!')) { at--; continue; }
            if(text.slice(at - 1, at + 1) === '*/') { let open = -1; for(let scan = at - 2; scan >= 0; scan--) { if(text.slice(scan, scan + 2) === '/*') { open = scan; break; } } if(open < 0) { return -1; } at = open - 1; continue; }
            let line = at; while(line >= 0 && text[line] !== '\n') { line--; } let quote = ''; let comment = -1;
            for(let scan = line + 1; scan <= at; scan++) { const c = text[scan]; if(c === '\\') { scan++; continue; } if(quote !== '') { if(c === quote) { quote = ''; } } else if(c === '"' || c === "'" || c === '`') { quote = c; } else if(text.slice(scan, scan + 2) === '//') { comment = scan; break; } }
            if(comment >= 0) { at = comment - 1; continue; } return at;
        }
