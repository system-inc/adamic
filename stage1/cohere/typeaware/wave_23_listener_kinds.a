// Numeric ast.Kind values from the pinned typescript-go parser, checked against Go listeners.
// The shared kind-indexed driver can consume this without reading node.kind strings.
export interface Wave23ListenerDeclarationInterface {
    readonly name: string;
    readonly kinds: readonly number[];
}

export const wave23ListenerKinds: readonly Wave23ListenerDeclarationInterface[] = [
