    { name: 'no-func-assign', kinds: [220, 264] },
    { name: 'no-new-func', kinds: [215, 216] },
    { name: 'no-new-native-nonconstructor', kinds: [216] },
    { name: 'no-new-wrappers', kinds: [216] },
    { name: 'no-throw-literal', kinds: [259] },
