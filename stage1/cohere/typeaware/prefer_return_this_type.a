import type { Rules } from './rules.ts';
import { ClassThisTypes } from './class_this_types.a';
import { types } from './facts.ts';
import { Repair } from './repair.ts';

// Pinned parser SyntaxKind values for the forthcoming kind-indexed driver.
export const preferReturnThisTypeSyntaxKinds: number[] = [264, 232];
export class PreferReturnThisType {
    readonly rules: Rules;
    constructor(rules: Rules) { this.rules = rules; }
    matched(index: number, name: string): number {
        const node = this.rules.parser.node(index);
        if(node.kind === 'TypeReference') {
            const key = this.rules.parser.node(node.children[0] ?? -1);
            return key.kind === 'Identifier' && key.text === name ? index : -1;
        }
        if(node.kind === 'UnionType') {
            for(const child of node.children) {
                const result = this.matched(this.rules.skip(child, 'ParenthesizedType'), name);
                if(result >= 0) { return result; }
            }
        }
        return -1;
    }
    returns(index: number): number[] {
        const node = this.rules.parser.node(index);
        if(node.kind === 'ReturnStatement') { return node.children.slice(0, 1); }
        if(!['Block', 'IfStatement', 'DoStatement', 'WhileStatement', 'ForStatement', 'ForInStatement',
            'ForOfStatement', 'WithStatement', 'SwitchStatement', 'CaseBlock', 'CaseClause', 'DefaultClause',
            'LabeledStatement', 'TryStatement', 'CatchClause'].includes(node.kind)) { return []; }
        const result: number[] = [];
        for(const child of node.children) { for(const expression of this.returns(child)) { result.push(expression); } }
        return result;
    }
    check(index: number, owner: number, name: string): void {
        const parser = this.rules.parser;
        const node = parser.node(index);
        const body = node.children[node.children.length - 1] ?? -1;
        if(body < 0 || ['Parameter', 'TypeParameter'].includes(parser.node(body).kind)) { return; }
        const parameters = node.children.filter((child) => parser.node(child).kind === 'Parameter');
        const first = parameters[0] ?? -1;
        if(first >= 0 && parser.node(first).children.some((child) =>
            ['Identifier', 'ThisKeyword'].includes(parser.node(child).kind) && this.rules.text(parser.node(child)) === 'this')) { return; }
        const beforeBody = node.children.indexOf(body) - (node.kind === 'ArrowFunction' ? 2 : 1);
        const annotation = node.children[beforeBody] ?? -1;
        if(annotation < 0) { return; }
        const match = this.matched(annotation, name);
        if(match < 0) { return; }
        const facts = new ClassThisTypes(this.rules, owner);
        if(facts.instance === 0) { return; }
        let returnedThis = false;
        let returnedClass = false;
        if(parser.node(body).kind !== 'Block') {
            const type = types(this.rules.ask(this.rules.skip(body), 'raw-shape'), 'raw-shape').root();
            returnedThis = facts.receiver !== 0 && type.id === facts.receiver;
        }
        else {
            for(const expression of this.returns(body)) {
                if(parser.node(expression).kind === 'ThisKeyword') { returnedThis = true; continue; }
                const graph = types(this.rules.ask(expression, 'raw-shape'), 'raw-shape');
                const type = graph.root();
                if(type.id === facts.instance || ((type.flags & 134217728) !== 0 && type.parts.includes(facts.instance))) {
                    returnedClass = true; break;
                }
                if(facts.receiver !== 0 && type.id === facts.receiver) { returnedThis = true; }
            }
        }
        if(!returnedClass && returnedThis) {
            const finding = this.rules.add('prefer-return-this-type', 'useThisType', 'Use `this` type instead.', match);
            finding.repairs.push(new Repair(finding.start, finding.end, 'this'));
        }
    }
    run(): void {
        const parser = this.rules.parser;
        for(let index = 0; index < parser.nodes.length; index++) {
            const node = parser.node(index);
            if(!['ClassDeclaration', 'ClassExpression'].includes(node.kind) || (this.rules.parents[index] ?? -1) < 0) { continue; }
            const nameIndex = node.children.find((child) => parser.node(child).kind === 'Identifier') ?? -1;
            if(nameIndex < 0) { continue; }
            const name = parser.node(nameIndex).text;
            for(const member of node.children) {
                const kind = parser.node(member).kind;
                if(['MethodDeclaration', 'GetAccessor', 'SetAccessor', 'Constructor'].includes(kind)) { this.check(member, index, name); }
                if(kind === 'PropertyDeclaration') {
                    const initializer = parser.node(member).children[parser.node(member).children.length - 1] ?? -1;
                    if(initializer >= 0 && ['FunctionExpression', 'ArrowFunction'].includes(parser.node(initializer).kind)) { this.check(initializer, index, name); }
                }
            }
        }
    }
}
