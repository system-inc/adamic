import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export class SymbolsInScope {
    readonly names: string[] = [];
    readonly flags: number[] = [];
    constructor(rules: Rules, index: number) {
        const frames = new Frames(rules.ask(index, 'symbols-in-scope'));
        header(frames, 'symbols-in-scope');
        const count = frames.natural();
        for(let at = 0; at < count; at++) {
            this.names.push(frames.field());
            this.flags.push(frames.natural());
        }
        frames.end();
    }
}
