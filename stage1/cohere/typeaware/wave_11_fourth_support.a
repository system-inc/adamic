import type { Rules } from './rules.ts';
import { declarationLineage } from './declaration_lineage.a';
export function globalBinding(rules: Rules, index: number): boolean {
    const chains = declarationLineage(rules, index);
    const chain = chains[0];
    if(chain === undefined) { return false; }
    const declaration = chain.nodes[0];
    return declaration !== undefined && declaration.declarationFile;
}
export function accessObject(rules: Rules, index: number): number {
    const node = rules.parser.node(index);
    return ['PropertyAccessExpression', 'ElementAccessExpression'].includes(node.kind) ? node.children[0] ?? -1 : -1;
}
export function staticName(rules: Rules, index: number): string {
    const node = rules.parser.node(index);
    if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(node.kind)) { return ''; }
    const key = rules.parser.node(node.kind === 'ElementAccessExpression' ?
        rules.skip(node.children[node.children.length - 1] ?? -1) : node.children[node.children.length - 1] ?? -1);
    if(node.kind === 'PropertyAccessExpression' && ['Identifier', 'PrivateIdentifier'].includes(key.kind)) { return key.text; }
    return ['StringLiteral', 'NoSubstitutionTemplateLiteral', 'NumericLiteral'].includes(key.kind) ? key.text : '';
}
export function calleeInner(rules: Rules, index: number): number {
    while(index >= 0) {
        const node = rules.parser.node(index);
        if(node.kind === 'TypeAssertionExpression') { index = node.children[node.children.length - 1] ?? -1; }
        else if(['ParenthesizedExpression', 'NonNullExpression', 'AsExpression', 'SatisfiesExpression',
            'ExpressionWithTypeArguments'].includes(node.kind)) { index = node.children[0] ?? -1; }
        else { return index; }
    }
    return -1;
}
