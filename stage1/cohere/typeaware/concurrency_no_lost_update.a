                if(!read || node.kind === 'YieldExpression') { outcome.dependencies = staled(outcome.dependencies); }
                outcome.suspended = true; outcome.during = true;
            }
            return unique(outcomes);
        }
        if(node.kind === 'BinaryExpression') {
            const left = node.children[0] ?? -1; const right = node.children[node.children.length - 1] ?? -1;
            if(['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken'].includes(analysis.graph.operator(index))) {
                const first = this.evaluate(left, suspended); const outcomes = first.slice(); for(const value of this.then(first, right)) { outcomes.push(value); } return unique(outcomes);
            }
            if(analysis.graph.operator(index) === 'CommaToken') { return unique(this.then(this.evaluate(left, suspended), right)); }
            if(analysis.graph.operator(index) === 'EqualsToken') { return this.evaluate(right, suspended); }
            return this.modified(this.sequence([left, right], suspended));
        }
        if(node.kind === 'ConditionalExpression') {
            const condition = this.evaluate(node.children[0] ?? -1, suspended); const outcomes = this.then(condition, node.children[2] ?? -1);
            for(const result of this.then(condition, node.children[4] ?? -1)) { outcomes.push(result); } return unique(outcomes);
        }
        if(node.kind === 'ObjectLiteralExpression') {
            const parts: number[] = [];
            for(const member of node.children) {
                const property = rules.parser.node(member);
                if(property.kind === 'PropertyAssignment') {
                    const name = property.children[0] ?? -1; if(analysis.kind(name) === 'ComputedPropertyName') { parts.push(rules.parser.node(name).children[0] ?? -1); }
                    parts.push(property.children[property.children.length - 1] ?? -1);
                } else if(property.kind === 'ShorthandPropertyAssignment') { parts.push(property.children[0] ?? -1); }
                else if(property.kind === 'SpreadAssignment') { parts.push(property.children[property.children.length - 1] ?? -1); }
            }
            return this.modified(this.sequence(parts, suspended));
        }
        if(node.kind === 'CallExpression' && analysis.targetRead(index, this.target)) {
            const outcomes = this.sequence(node.children, suspended); for(const outcome of outcomes) { outcome.dependencies = 1; } return unique(outcomes);
        }
        return this.modified(this.sequence(node.children, suspended));
    }
}
export class ConcurrencyNoLostUpdate {
    readonly bindings: Bindings;
    constructor(bindings: Bindings) { this.bindings = bindings; }
    run(): void {
        const rules = this.bindings.rules;
        for(let index = 0; index < rules.parser.nodes.length; index++) {
            const node = rules.parser.node(index);
            if(!['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration', 'GetAccessor', 'SetAccessor'].includes(node.kind)) { continue; }
            if(!node.children.some((child) => ['AsyncKeyword', 'AsteriskToken'].includes(rules.parser.node(child).kind))) { continue; }
            const names: number[] = []; const graph = new LostGraph(this.bindings, names); const analysis = new LostAnalysis(this.bindings, index, graph, names);
            // The graph borrows the local-name table; numeric links own no analysis objects.
            analysis.run();
        }
    }
}
