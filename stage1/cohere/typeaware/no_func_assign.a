import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
import { Bindings } from './bindings.ts';
import { Reassign } from './reassign.ts';
const message = "This assigns to the name a function declares. The declaration is hoisted, so the assignment usually parses and runs without complaint, and what it costs shows up somewhere else: every later call of the name invokes whatever was assigned instead of the function. Inside the function's own body the mistake is quieter still, because the write happens on the first call and the second call reaches a different value. A named function expression is stricter, where the binding is immutable and the write throws in strict mode. Assign to a separate variable, or declare the function as a variable if it is meant to be replaced.";
export class NoFuncAssign {
    readonly rules: Rules;
    readonly bindings: Bindings;
    readonly writes: Reassign;
    readonly anchors: number[] = [];
    readonly names: string[] = [];
    constructor(rules: Rules, bindings: Bindings) { this.rules = rules; this.bindings = bindings; this.writes = new Reassign(rules); }
    first(index: number): number { return this.bindings.list(index, 'binding-declarations', false)[0] ?? -1; }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(!['FunctionDeclaration', 'FunctionExpression'].includes(node.kind)) { continue; }
            const name = this.bindings.shape.name(index);
            if(name < 0 || this.rules.parser.node(name).kind !== 'Identifier') { continue; }
            const declaration = this.first(name);
            if(declaration >= 0) { this.anchors.push(declaration); this.names.push(this.rules.parser.node(name).text); }
        }
        if(this.anchors.length === 0) { return; }
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(node.kind !== 'Identifier' || !this.names.includes(node.text) || !this.writes.writes(index)) { continue; }
            const declaration = this.first(index);
            if(declaration >= 0 && this.anchors.includes(declaration)) {
                this.rules.findings.push(new Diagnostic('no-func-assign', 'noFuncAssign', message, this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), ''));
            }
        }
    }
}
