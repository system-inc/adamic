import type { Rules } from '../rules.ts';
import { Diagnostic } from '../diagnostic.ts';
export function nextDiagnostic(rules: Rules, rule: string, id: string, message: string, index: number): Diagnostic {
    const node = rules.parser.node(index);
    return new Diagnostic(rule, id, message, rules.byte(rules.start(node)), rules.byte(node.end), '');
}
