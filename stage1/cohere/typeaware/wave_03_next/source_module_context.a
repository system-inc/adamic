import { tsgoInspect } from 'adamic';
import { Frames, header } from '../frames.ts';
export function sourceModuleContext(program: number, path: string, length: number): boolean {
    const frames = new Frames(tsgoInspect(program, path, 0, length, 'SourceFile', 'source-module-context'));
    header(frames, 'source-module-context'); const module = frames.yes(); frames.end(); return module;
}
