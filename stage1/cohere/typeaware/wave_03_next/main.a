import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../../typescript/parser/nodes.ts';
import { NextSources } from './next_sources.a';
import { NextFacts } from './next_facts.a';
import { NextModules } from './next_modules.a';
import { nextSyntax } from './next_syntax.a';
import { processEffects } from './process_effects.a';
import { CorrectnessNoUnclearedRaceTimeout } from './correctness_no_uncleared_race_timeout.a';
import { CorrectnessNoProcessExitAfterOutput } from './correctness_no_process_exit_after_output.a';
import { CorrectnessRequireBlockingStandardStreams } from './correctness_require_blocking_standard_streams.a';
const args = programArguments(); const config = args[0] ?? panic('usage: main.a config manifest');
const manifest = readTextFile(args[1] ?? panic('missing manifest')); if(manifest.kind === 'Error') { panic(manifest.message); }
const paths = manifest.text.split('\n').filter((path) => path !== ''); const program = tsgoProgram(config, paths);
const sources = new NextSources(program); let findings = 0;
if(paths.length > 0) {
    const modules = new NextModules(sources.file(paths[0] ?? panic('missing first path')), sources.root(paths[0] ?? panic('missing first path')));
    for(const path of paths) {
        const rules = sources.file(path); const facts = new NextFacts(rules, sources);
        new CorrectnessNoUnclearedRaceTimeout(facts, nextSyntax(rules)).run();
        new CorrectnessNoProcessExitAfterOutput(facts, processEffects(facts)).run();
        new CorrectnessRequireBlockingStandardStreams(facts, modules).run();
        for(const finding of rules.findings) { finding.sortKey = finding.written(); }
        rules.findings.sort((left, right) => left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0);
        findings += rules.findings.length;
        if(!args.includes('--count')) { console.log(`file\t${written(path)}`); for(const finding of rules.findings) { console.log(finding.written()); } }
    }
}
console.log(`findings ${findings}`); tsgoRelease(program);
