// Pinned numeric SyntaxKind adapter; convert once before dispatch.
export function numericKind(name: string): number {
    const part0 = kind0(name);
    if(part0 > 0) { return part0; }
    const part1 = kind1(name);
    if(part1 > 0) { return part1; }
    const part2 = kind2(name);
    if(part2 > 0) { return part2; }
    const part3 = kind3(name);
    if(part3 > 0) { return part3; }
    const part4 = kind4(name);
    if(part4 > 0) { return part4; }
    return 0;
}
