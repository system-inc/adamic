        ].includes(this.node(index).kind);
    }
    pushJump(index: number, after: number, continued: number): void {
        const labels: string[] = [];
        let previous = index;
        let parent = this.parent(index);
        while(this.node(parent).kind === 257 && this.last(parent) === previous) {
            labels.push(this.node(this.child(parent, 0)).text);
            previous = parent;
            parent = this.parent(parent);
        }
        this.jumps.push(new Jump(labels, after, continued));
    }
    truthy(index: number): boolean {
        const node = this.node(this.syntax.skip(index));
        if([111, 13].includes(node.kind)) {
            return true;
        }
        if(node.kind === 8) {
            const text = node.text.replaceAll('_', '');
            if(text.startsWith('0x') || text.startsWith('0X')) {
                return parseInt(text.slice(2), 16) !== 0;
            }
            if(text.startsWith('0b') || text.startsWith('0B')) {
                return parseInt(text.slice(2), 2) !== 0;
            }
            if(text.startsWith('0o') || text.startsWith('0O')) {
                return parseInt(text.slice(2), 8) !== 0;
            }
            return parseFloat(text) !== 0;
        }
        if(node.kind === 10) {
            return node.text !== '';
        }
        if(node.kind === 9) {
            let text = node.text.slice(0, -1).replaceAll('_', '');
            if(
                text.startsWith('0x') ||
                text.startsWith('0X') ||
                text.startsWith('0b') ||
                text.startsWith('0B') ||
                text.startsWith('0o') ||
                text.startsWith('0O')
            ) {
                text = text.slice(2);
            }
            return text.split('').some((part) => part !== '0');
        }
        return false;
    }
    forParts(index: number): number[] {
        const node = this.node(index);
        const scanner = new Scanner(this.rules.scanner.text);
        scanner.pos = node.charPos;
        let depth = 0;
        let braces = 0;
        let brackets = 0;
        const semicolons: number[] = [];
        while(true) {
            const kind = numericKind(scanner.scan());
            if(kind === 1) {
                break;
            }
            if(kind === 20) {
                depth++;
            }
            if(kind === 21) {
                depth--;
                if(depth === 0) {
                    break;
                }
            }
            if(kind === 18) {
                braces++;
            }
            if(kind === 19) {
                braces--;
            }
            if(kind === 22) {
                brackets++;
            }
            if(kind === 23) {
                brackets--;
            }
            if(kind === 26 && depth === 1 && braces === 0 && brackets === 0) {
                semicolons.push(this.rules.byte(scanner.fullStart));
            }
        }
        const parts = [-1, -1, -1];
        for(const child of node.children.slice(0, -1)) {
            const value = this.node(child);
            const first = semicolons[0] ?? -1;
            const second = semicolons[1] ?? -1;
            const slot = value.end <= first ? 0 : value.end <= second ? 1 : 2;
            parts[slot] = child;
        }
        return parts;
    }
    loop(index: number): void {
        const kind = this.node(index).kind;
        const bodyNode = this.last(index);
        if(kind === 247) {
            const body = this.fresh();
            this.link(this.current, body);
            const test = this.fresh();
            const after = this.fresh();
            this.pushJump(index, after, test);
            this.enter(body);
            this.statement(this.child(index, 0));
            this.link(this.current, test);
            this.jumps.pop();
            this.enter(test);
            this.expr(this.child(index, 1));
            this.link(this.current, body);
            if(!this.truthy(this.child(index, 1))) {
                this.link(this.current, after);
            }
            this.enter(after);
            return;
        }
        if(kind === 250 || kind === 251) {
            const children = this.node(index).children.filter((child) => this.node(child).kind !== 134);
            this.expr(children[1] ?? -1);
            const head = this.fresh();
            this.link(this.current, head);
            this.enter(head);
            const after = this.fresh();
            this.link(head, after);
            const body = this.fresh();
            this.link(head, body);
            this.pushJump(index, after, head);
            this.enter(body);
            const initialized = children[0] ?? -1;
            if(this.node(initialized).kind === 262) {
                for(const decl of this.node(initialized).children) {
                    if(this.node(decl).kind === 261) {
                        this.patternBind(this.syntax.name(decl));
                    }
                }
            }
            else {
                this.patternBind(initialized);
            }
            this.statement(bodyNode);
            this.link(this.current, head);
            this.jumps.pop();
            this.enter(after);
            return;
        }
        let condition = this.child(index, 0);
        let increment = -1;
        if(kind === 249) {
            const parts = this.forParts(index);
            const initialized = parts[0] ?? -1;
            if(this.node(initialized).kind === 262) {
                this.variable(initialized);
            }
            else {
                this.expr(initialized);
            }
            condition = parts[1] ?? -1;
            increment = parts[2] ?? -1;
        }
        const test = this.fresh();
        this.link(this.current, test);
        this.enter(test);
        const after = this.fresh();
        const body = this.fresh();
        this.condition(condition, body, condition < 0 || this.truthy(condition) ? -1 : after);
        let update = test;
        if(increment >= 0) {
            update = this.fresh();
            this.disconnected(update);
            this.expr(increment);
            this.link(this.current, test);
        }
        this.pushJump(index, after, update);
        this.enter(body);
        this.statement(bodyNode);
        this.link(this.current, update);
        this.jumps.pop();
        this.enter(after);
    }
    switchStatement(index: number): void {
        this.expr(this.child(index, 0));
        const after = this.fresh();
        const clauses = this.node(this.child(index, 1)).children;
        const bodies = clauses.map(() => this.fresh());
        let defaultIndex = -1;
        let test = this.current;
        for(let at = 0; at < clauses.length; at++) {
            const clause = clauses[at] ?? -1;
            if(this.node(clause).kind === 298) {
                defaultIndex = at;
                continue;
            }
            this.current = test;
            this.expr(this.child(clause, 0));
            this.link(this.current, bodies[at] ?? -1);
            const next = this.fresh();
            this.link(this.current, next);
            this.enter(next);
            test = this.current;
        }
        this.link(test, defaultIndex >= 0 ? (bodies[defaultIndex] ?? -1) : after);
        this.pushJump(index, after, -1);
        let previous = -1;
        for(let at = 0; at < clauses.length; at++) {
            this.link(previous, bodies[at] ?? -1);
            this.enter(bodies[at] ?? -1);
            const clause = clauses[at] ?? -1;
            const offset = this.node(clause).kind === 297 ? 1 : 0;
            for(const statement of this.node(clause).children.slice(offset)) {
                this.statement(statement);
            }
            previous = this.current;
        }
        this.link(previous, after);
        this.jumps.pop();
        this.enter(after);
    }
    tryStatement(index: number): void {
        const children = this.node(index).children;
        const catchNode = children.find((child) => this.node(child).kind === 300) ?? -1;
        const finallyNode =
            children.length > 1 && this.node(children[children.length - 1] ?? -1).kind === 242
                ? (children[children.length - 1] ?? -1)
                : -1;
        const frame = new TryFrame();
        if(catchNode >= 0) {
            frame.catchEntry = this.fresh();
        }
        if(finallyNode >= 0) {
            frame.finallyEntry = this.fresh();
        }
        this.tries.push(frame);
        this.statement(this.child(index, 0));
        const ends: number[] = [];
        if(catchNode >= 0) {
            this.link(this.current, frame.catchEntry);
            ends.push(this.current);
            frame.position = 1;
            frame.forked = false;
            this.enter(frame.catchEntry);
            for(const child of this.node(catchNode).children) {
                if(this.node(child).kind === 261) {
                    this.patternBind(this.syntax.name(child));
                }
            }
            this.statement(this.last(catchNode));
        }
        ends.push(this.current);
        this.tries.pop();
        const after = this.fresh();
        if(finallyNode < 0) {
            for(const end of ends) {
                this.link(end, after);
            }
            this.enter(after);
            return;
        }
        const snapshot = this.tries.map((held) => held.forked);
        const normal = this.fresh();
        for(const end of ends) {
            this.link(end, normal);
        }
        for(const end of frame.implicit) {
            this.link(end, normal);
        }
        this.enter(normal);
        this.statement(finallyNode);
        this.link(this.current, after);
        if(this.incoming[frame.finallyEntry] ?? false) {
            for(let at = 0; at < snapshot.length; at++) {
                const held = this.tries[at];
                if(held !== undefined) {
                    held.forked = snapshot[at] ?? false;
                }
            }
            this.enter(frame.finallyEntry);
            this.statement(finallyNode);
            if(this.block(this.current).reachable) {
                if(frame.returned) {
                    const outer = this.tries[this.returnFrame()];
                    if(outer !== undefined) {
                        outer.returned = true;
                        this.link(this.current, outer.finallyEntry);
                    }
                }
                if(frame.thrown) {
                    const outer = this.tries[this.throwFrame()];
                    if(outer !== undefined) {
                        outer.thrown = true;
                        this.link(this.current, this.throwTarget(outer));
                    }
                }
            }
        }
        this.enter(after);
    }
}

function isAssignment(kind: number): boolean { return kind >= 63 && kind <= 78; }
