import type { Rules } from '../rules.ts';
import type { RegexReferences } from './regex_references.a';
import { Diagnostic } from '../diagnostic.ts';
import { Suggestion } from '../suggestion.ts';
import { Repair } from '../repair.ts';
import { Provenance } from '../wave-24-next/symbol_provenance.a';
import { node as atNode, skip } from '../wave-24-next/shape.a';
import { RegexPattern } from './regex_pattern.a';
// Pinned parser SyntaxKind values for the forthcoming kind-indexed driver.
export const preferRegexLiteralsSyntaxKinds: string[] = ["SourceFile"];
export class PreferRegexLiterals {
    readonly rules: Rules; readonly references: RegexReferences;
    constructor(rules: Rules, references: RegexReferences) { this.rules = rules; this.references = references; }
    staticString(index: number): string | undefined {
        const node = atNode(this.rules, index);
        if(['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(node.kind)) { return node.text; }
        if(node.kind !== 'TaggedTemplateExpression') { return undefined; }
        const template = atNode(this.rules, node.children[node.children.length - 1] ?? -1);
        if(template.kind !== 'NoSubstitutionTemplateLiteral') { return undefined; }
        const tag = atNode(this.rules, skip(this.rules, node.children[0] ?? -1));
        if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(tag.kind)) { return undefined; }
        const key = atNode(this.rules, tag.children[tag.children.length - 1] ?? -1);
        if(key.text !== 'raw' || !(tag.kind === 'PropertyAccessExpression' || ['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(key.kind))) { return undefined; }
        const receiverIndex = tag.children[0] ?? -1; const receiver = atNode(this.rules, receiverIndex);
        if(receiver.kind !== 'Identifier' || receiver.text !== 'String') { return undefined; }
        const symbol = new Provenance(this.rules, receiverIndex);
        if(symbol.declarations.length === 0 || !symbol.declarations.every((item) => item.declaration)) { return undefined; }
        const written = this.rules.text(template); return written.slice(1, written.length - 1);
    }
    preceding(start: number): boolean {
        const source = this.rules.scanner.text; let at = start - 1;
        // Use scanner trivia boundaries for comments and preserve Go's longest
        // suffix allowlist for punctuation rather than JavaScript's token grammar.
        while(at >= 0) {
            if(' \t\r\n\v\f'.includes(source.slice(at, at + 1))) { at--; continue; }
            if(source.slice(at - 1, at + 1) === '*/') { const opening = source.slice(0, at - 1).lastIndexOf('/*'); if(opening < 0) { return true; } at = opening - 1; continue; }
            const line = source.slice(0, at + 1).lastIndexOf('\n') + 1; let single = false; let double = false; let template = false; let comment = -1;
            for(let scan = line; scan <= at; scan++) {
                const char = source.slice(scan, scan + 1);
                if(char === '\\') { scan++; continue; }
                if(single) { if(char === "'") { single = false; } }
                else if(double) { if(char === '"') { double = false; } }
                else if(template) { if(char === '`') { template = false; } }
                else if(char === "'") { single = true; }
                else if(char === '"') { double = true; }
                else if(char === '`') { template = true; }
                else if(source.slice(scan, scan + 2) === '//') { comment = scan; break; }
            }
            if(comment >= 0) { at = comment - 1; continue; } break;
        }
        if(at < 0) { return true; }
        if(source.startsWith('#!')) { const newline = source.indexOf('\n'); if(newline >= 0 && start > newline && source.slice(newline + 1, start).trim() === '') { return true; } }
        const allowed = ['(', ';', '[', ',', '=', '+', '*', '-', '?', '~', '%', '**', '!', 'typeof', 'instanceof', '&&', '||', '??', 'return', '...', 'delete', 'void', 'in', '<', '>', '<=', '>=', '==', '===', '!=', '!==', '<<', '>>', '>>>', '&', '|', '^', ':', '{', '=>', '*=', '<<=', '>>=', '>>>=', '^=', '|=', '&=', '??=', '||=', '&&=', '**=', '+=', '-=', '/=', '%=', '/', 'do', 'break', 'continue', 'debugger', 'case', 'throw'];
        const letters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$';
        if(letters.includes(source.slice(at, at + 1))) { let first = at; while(first >= 0 && letters.includes(source.slice(first, first + 1))) { first--; } return allowed.includes(source.slice(first + 1, at + 1)); }
        for(let length = 4; length >= 1; length--) { if(at - length + 1 >= 0 && allowed.includes(source.slice(at - length + 1, at + 1))) { return true; } } return false;
    }
    run(): void {
        this.references.run();
        for(const index of this.references.calls) {
            const node = this.rules.parser.node(index); const args = node.children.slice(node.children.length - Math.max(node.list, 0));
            if(args.length !== 1 && args.length !== 2) { continue; }
            const pattern = this.staticString(args[0] ?? -1); const flags = args.length === 2 ? this.staticString(args[1] ?? -1) : '';
            if(pattern === undefined || flags === undefined) { continue; }
            const start = this.rules.start(node); const finding = new Diagnostic('prefer-regex-literals', 'unexpectedRegExp',
                'This builds a regular expression by handing constant strings to the `RegExp` constructor, which does at runtime what a literal does at parse time. The constructor form costs a parse on every evaluation, hides syntax errors until the line is reached rather than surfacing them when the file is read, and doubles every backslash so the pattern stops looking like the pattern. Write the regular expression literal.',
                this.rules.byte(start), this.rules.byte(node.end), '');
            this.rules.findings.push(finding);
            const allow = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 \t\r\n\v\f-\\[](){}!@#$%^&*+=/~`.><?,\'"|:;_';
            if(!pattern.split('').every((char) => allow.includes(char)) || !this.preceding(start)) { continue; }
            let comment = false; this.rules.scanner.pos = start;
            while(this.rules.scanner.pos < node.end) {
                this.rules.scanner.scan();
                const gap = this.rules.scanner.text.slice(this.rules.scanner.fullStart, this.rules.scanner.start);
                if(gap.includes('//') || gap.includes('/*')) { comment = true; }
                if(this.rules.scanner.kind === 'EndOfFileToken') { break; }
            }
            if(comment) { continue; }
            const grammar = new RegexPattern(pattern, flags); if(!grammar.valid()) { continue; }
            const escaped = grammar.literal(); let replacement = `/${escaped === '' ? '(?:)' : escaped}/${flags}`;
            const source = this.rules.scanner.text;
            if(start > 0 && source.slice(start - 1, start) === '/') { replacement = ' ' + replacement; }
            const after = source.slice(node.end, node.end + 1);
            if(after !== '' && 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$'.includes(after)) { replacement += ' '; }
            const repairs: Repair[] = [new Repair(this.rules.byte(start), this.rules.byte(node.end), replacement)];
            finding.suggestions.push(new Suggestion('replaceWithLiteral', 'Replace with an equivalent regular expression literal.', repairs));
        }
    }
}
