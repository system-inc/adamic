import type { Rules } from '../rules.ts';
import { Diagnostic } from '../diagnostic.ts';
import { RawSymbolDeclarationCount } from './raw_symbol_declaration_count.a';
export class PreferRestParams {
    readonly rules: Rules;
    constructor(rules: Rules) { this.rules = rules; }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(node.kind !== 'Identifier' || node.text !== 'arguments') { continue; }
            const symbol = new RawSymbolDeclarationCount(this.rules, index);
            if(symbol.identity === 0 || symbol.count !== 0) { continue; }
            const parent = this.rules.parents[index] ?? -1;
            if(parent >= 0) {
                const ancestor = this.rules.parser.node(parent);
                if(ancestor.kind === 'PropertyAccessExpression' && ancestor.children[0] === index) { continue; }
            }
            this.rules.findings.push(new Diagnostic('prefer-rest-params', 'preferRestParams',
                'This reads the implicit `arguments` object, which is array-like rather than an array and carries none of `Array.prototype`, so iterating or slicing it needs a conversion first. Declare a rest parameter (`...args`) and use that instead.',
                this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), ''));
        }
    }
}
