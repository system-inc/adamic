import type { Rules } from '../rules.ts';
import { Frames, header } from '../frames.ts';
export class RawSymbolDeclarationCount {
    readonly identity: number; readonly count: number;
    constructor(rules: Rules, index: number) {
        const frames = new Frames(rules.ask(index, 'raw-symbol-declaration-count'));
        header(frames, 'raw-symbol-declaration-count');
        this.identity = frames.natural(); this.count = frames.natural(); frames.end();
    }
}
