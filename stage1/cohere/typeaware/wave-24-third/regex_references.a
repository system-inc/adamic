import type { Rules } from '../rules.ts';
import type { Bindings } from '../bindings.ts';
import { Provenance } from '../wave-24-next/symbol_provenance.a';
import { node as atNode, skip } from '../wave-24-next/shape.a';
export class RegexReferences {
    readonly rules: Rules; readonly bindings: Bindings; readonly calls: number[] = [];
    readonly symbols = new Map<number, Provenance>(); readonly following: string[] = [];
    constructor(rules: Rules, bindings: Bindings) { this.rules = rules; this.bindings = bindings; }
    symbol(index: number): Provenance {
        const cached = this.symbols.get(index); if(cached !== undefined) { return cached; }
        const value = new Provenance(this.rules, index); this.symbols.set(index, value); return value;
    }
    reference(index: number): boolean {
        const parent = this.rules.parents[index] ?? -1; const kind = atNode(this.rules, parent).kind;
        if(['TypeReference', 'TypeQuery', 'QualifiedName', 'LabeledStatement', 'BreakStatement', 'ContinueStatement', 'JsxAttribute', 'ImportSpecifier'].includes(kind)) { return false; }
        return !this.bindings.declaring(index) || kind === 'ShorthandPropertyAssignment';
    }
    write(index: number): boolean {
        let current = index;
        while(current >= 0) {
            const parent = this.rules.parents[current] ?? -1; const node = atNode(this.rules, parent);
            if(node.kind === 'BinaryExpression') {
                const operator = atNode(this.rules, node.children[1] ?? -1).kind;
                return node.children[0] === current && operator.endsWith('EqualsToken') && !['EqualsEqualsToken', 'EqualsEqualsEqualsToken', 'ExclamationEqualsToken', 'ExclamationEqualsEqualsToken', 'LessThanEqualsToken', 'GreaterThanEqualsToken'].includes(operator);
            }
            if(['PrefixUnaryExpression', 'PostfixUnaryExpression'].includes(node.kind)) { return ['PlusPlusToken', 'MinusMinusToken'].includes(node.operator); }
            if(['ForInStatement', 'ForOfStatement'].includes(node.kind)) { return node.children[0] === current; }
            if(['ParenthesizedExpression', 'SpreadElement', 'SpreadAssignment', 'ObjectLiteralExpression', 'ArrayLiteralExpression'].includes(node.kind)) { current = parent; continue; }
            if(node.kind === 'PropertyAssignment' && node.children[node.children.length - 1] === current) { current = parent; continue; }
            if(node.kind === 'ShorthandPropertyAssignment' && node.children[0] === current) { current = parent; continue; }
            return false;
        }
        return false;
    }
    constant(index: number): string | undefined {
        const current = skip(this.rules, index); const node = atNode(this.rules, current);
        if(['StringLiteral', 'NoSubstitutionTemplateLiteral', 'NumericLiteral'].includes(node.kind)) { return node.text; }
        if(['TrueKeyword', 'FalseKeyword', 'NullKeyword'].includes(node.kind)) { return node.kind === 'TrueKeyword' ? 'true' : node.kind === 'FalseKeyword' ? 'false' : 'null'; }
        if(node.kind === 'TemplateExpression') {
            let value = atNode(this.rules, node.children[0] ?? -1).text;
            for(const child of node.children.slice(1)) {
                const span = atNode(this.rules, child); const expression = this.constant(span.children[0] ?? -1);
                if(expression === undefined) { return undefined; }
                value += expression + atNode(this.rules, span.children[1] ?? -1).text;
            }
            return value;
        }
        if(node.kind === 'BinaryExpression' && atNode(this.rules, node.children[1] ?? -1).kind === 'PlusToken') {
            const leftIndex = node.children[0] ?? -1; const rightIndex = node.children[2] ?? -1;
            const left = this.constant(leftIndex); const right = this.constant(rightIndex);
            if(left !== undefined && right !== undefined && !(atNode(this.rules, skip(this.rules, leftIndex)).kind === 'NumericLiteral' && atNode(this.rules, skip(this.rules, rightIndex)).kind === 'NumericLiteral')) { return left + right; }
        }
        return undefined;
    }
    key(index: number): string | undefined {
        const node = atNode(this.rules, index);
        if(node.kind === 'PropertyAccessExpression') { return atNode(this.rules, node.children[node.children.length - 1] ?? -1).text; }
        return this.constant(node.children[node.children.length - 1] ?? -1);
    }
    target(index: number, object: boolean): void {
        const current = skip(this.rules, index); const node = atNode(this.rules, current);
        if(node.kind === 'Identifier') {
            const identity = this.symbol(current).identity; if(identity === 0) { return; }
            const key = `${identity}:${object}`; if(this.following.includes(key)) { return; } this.following.push(key);
            for(let at = 0; at < this.rules.parser.nodes.length; at++) {
                const candidate = this.rules.parser.node(at);
                if(candidate.kind === 'Identifier' && candidate.text === node.text && this.reference(at) && this.symbol(at).identity === identity) { this.value(at, object); }
            }
            this.following.pop(); return;
        }
        if(node.kind === 'BinaryExpression' && atNode(this.rules, node.children[1] ?? -1).kind === 'EqualsToken') { this.target(node.children[0] ?? -1, object); }
        if(!object || !['ObjectBindingPattern', 'ObjectLiteralExpression'].includes(node.kind)) { return; }
        for(const child of node.children) {
            const member = atNode(this.rules, child);
            if(member.children.some((item) => atNode(this.rules, item).kind === 'DotDotDotToken') || member.kind === 'SpreadAssignment') { continue; }
            const name = member.children[0] ?? -1; const nameNode = atNode(this.rules, name);
            const key = nameNode.kind === 'ComputedPropertyName' ? this.constant(nameNode.children[0] ?? -1) : nameNode.text;
            if(key !== 'RegExp') { continue; }
            const value = member.kind === 'BindingElement' ? this.bindings.shape.name(child) : member.kind === 'ShorthandPropertyAssignment' ? name : member.children[member.children.length - 1] ?? -1;
            this.target(value, false);
        }
    }
    value(index: number, object: boolean): void {
        let current = index;
        while(current >= 0) {
            const parent = this.rules.parents[current] ?? -1; const node = atNode(this.rules, parent);
            if(['ParenthesizedExpression', 'AsExpression', 'SatisfiesExpression', 'TypeAssertionExpression', 'NonNullExpression', 'ExpressionWithTypeArguments'].includes(node.kind)) { current = parent; continue; }
            if(node.kind === 'ConditionalExpression' && node.children[0] !== current) { current = parent; continue; }
            if(node.kind === 'BinaryExpression') {
                const operator = atNode(this.rules, node.children[1] ?? -1).kind;
                if(['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken'].includes(operator) || (operator === 'CommaToken' && node.children[2] === current)) { current = parent; continue; }
                if(node.children[2] === current && ['EqualsToken', 'BarBarEqualsToken', 'AmpersandAmpersandEqualsToken', 'QuestionQuestionEqualsToken'].includes(operator)) { this.target(node.children[0] ?? -1, object); current = parent; continue; }
            }
            if(['PropertyAccessExpression', 'ElementAccessExpression'].includes(node.kind) && node.children[0] === current && object && this.key(parent) === 'RegExp') { this.value(parent, false); }
            if(['CallExpression', 'NewExpression'].includes(node.kind) && node.children[0] === current && !object) { this.calls.push(parent); }
            if(['VariableDeclaration', 'Parameter', 'BindingElement'].includes(node.kind) && this.bindings.shape.initializer(parent) === current) { this.target(this.bindings.shape.name(parent), object); }
            if(node.kind === 'ShorthandPropertyAssignment' && node.children[1] === current) { this.target(node.children[0] ?? -1, object); }
            return;
        }
    }
    run(): void {
        if(!this.rules.scanner.text.includes('RegExp')) { return; }
        for(const name of ['RegExp', 'global', 'globalThis', 'self', 'window']) {
            const references: number[] = []; let modified = false;
            for(let index = 0; index < this.rules.parser.nodes.length; index++) {
                const node = this.rules.parser.node(index);
                if(node.kind !== 'Identifier' || node.text !== name || !this.reference(index)) { continue; }
                const symbol = this.symbol(index); if(symbol.declarations.some((item) => !item.declaration)) { continue; }
                if(this.write(index)) { modified = true; break; } references.push(index);
            }
            if(!modified) { for(const reference of references) { this.value(reference, name !== 'RegExp'); } }
        }
    }
}
