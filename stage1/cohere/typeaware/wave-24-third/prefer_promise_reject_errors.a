import type { Rules } from '../rules.ts';
import type { Shadow } from '../shadow.ts';
import { Diagnostic } from '../diagnostic.ts';
import { Provenance } from '../wave-24-next/symbol_provenance.a';
import { node as atNode } from '../wave-24-next/shape.a';
// Pinned parser SyntaxKind values for the forthcoming kind-indexed driver.
export const preferPromiseRejectErrorsSyntaxKinds: string[] = ["CallExpression", "NewExpression"];
export class PreferPromiseRejectErrors {
    readonly rules: Rules; readonly shape: Shadow;
    readonly symbols = new Map<number, Provenance>();
    constructor(rules: Rules, shape: Shadow) { this.rules = rules; this.shape = shape; }
    symbol(index: number): Provenance {
        const cached = this.symbols.get(index);
        if(cached !== undefined) { return cached; }
        const value = new Provenance(this.rules, index); this.symbols.set(index, value); return value;
    }
    unwrap(index: number): number {
        let current = index;
        while(['ParenthesizedExpression', 'AsExpression', 'SatisfiesExpression', 'TypeAssertionExpression', 'NonNullExpression'].includes(atNode(this.rules, current).kind)) {
            const node = atNode(this.rules, current);
            current = node.kind === 'TypeAssertionExpression' ? node.children[node.children.length - 1] ?? -1 : node.children[0] ?? -1;
        }
        return current;
    }
    global(index: number): boolean {
        if(index < 0) { return false; }
        const value = this.symbol(index);
        return value.identity !== 0 && value.declarations.length > 0 && value.declarations.every((item) => item.declaration);
    }
    error(index: number): boolean {
        const inner = this.unwrap(index); const node = atNode(this.rules, inner);
        if(['Identifier', 'CallExpression', 'NewExpression', 'PropertyAccessExpression', 'ElementAccessExpression', 'TaggedTemplateExpression', 'YieldExpression', 'AwaitExpression'].includes(node.kind)) { return true; }
        if(node.kind === 'ConditionalExpression') { return this.error(node.children[1] ?? -1) || this.error(node.children[2] ?? -1); }
        if(node.kind === 'BinaryExpression') {
            const operator = atNode(this.rules, node.children[1] ?? -1).kind;
            if(['EqualsToken', 'AmpersandAmpersandEqualsToken', 'AmpersandAmpersandToken', 'CommaToken'].includes(operator)) { return this.error(node.children[2] ?? -1); }
            if(['BarBarEqualsToken', 'QuestionQuestionEqualsToken', 'BarBarToken', 'QuestionQuestionToken'].includes(operator)) { return this.error(node.children[0] ?? -1) || this.error(node.children[2] ?? -1); }
        }
        return false;
    }
    check(index: number): void {
        const node = this.rules.parser.node(index); const args = node.children.slice(node.children.length - Math.max(node.list, 0));
        const reason = args[0] ?? -1; const expression = atNode(this.rules, reason);
        const undefinedGlobal = expression.kind === 'Identifier' && expression.text === 'undefined' && this.symbol(reason).declarations.length === 0;
        if(reason >= 0 && this.error(reason) && !undefinedGlobal) { return; }
        this.rules.findings.push(new Diagnostic('prefer-promise-reject-errors', 'rejectAnError',
            'Expected the Promise rejection reason to be an Error. A rejection carrying a string or a plain object arrives at the catch with no stack, so the line that failed is lost and the handler cannot tell one failure from another.',
            this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), ''));
    }
    walk(index: number, targets: readonly number[]): void {
        const node = this.rules.parser.node(index);
        if(node.kind === 'CallExpression') {
            const callee = this.unwrap(node.children[0] ?? -1);
            if(atNode(this.rules, callee).kind === 'Identifier' && targets.includes(this.symbol(callee).identity)) { this.check(index); }
        }
        for(const child of node.children) { this.walk(child, targets); }
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(node.kind === 'CallExpression') {
                const callee = atNode(this.rules, this.unwrap(node.children[0] ?? -1));
                if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(callee.kind)) { continue; }
                const key = atNode(this.rules, callee.children[callee.children.length - 1] ?? -1);
                if(key.text !== 'reject' || !(callee.kind === 'PropertyAccessExpression' || ['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(key.kind))) { continue; }
                const receiver = this.unwrap(callee.children[0] ?? -1); const name = atNode(this.rules, receiver);
                if(name.kind === 'Identifier' && name.text === 'Promise' && this.global(receiver)) { this.check(index); }
            }
            if(node.kind !== 'NewExpression') { continue; }
            const calleeIndex = node.children[0] ?? -1; const callee = atNode(this.rules, calleeIndex);
            if(callee.kind !== 'Identifier' || callee.text !== 'Promise' || !this.global(calleeIndex)) { continue; }
            const executor = node.list > 0 ? node.children[node.children.length - node.list] ?? -1 : -1; const functionNode = atNode(this.rules, executor);
            if(!['ArrowFunction', 'FunctionExpression', 'FunctionDeclaration'].includes(functionNode.kind)) { continue; }
            const parameters = functionNode.children.filter((child) => atNode(this.rules, child).kind === 'Parameter');
            const second = parameters[1] ?? -1;
            if(second < 0) { continue; }
            const nameIndex = this.shape.name(second); const name = atNode(this.rules, nameIndex);
            if(name.kind !== 'Identifier') { continue; }
            const targets: number[] = [];
            for(const parameter of parameters) {
                const candidate = this.shape.name(parameter); const identifier = atNode(this.rules, candidate);
                if(identifier.kind === 'Identifier' && identifier.text === name.text) {
                    const identity = this.symbol(candidate).identity; if(identity !== 0) { targets.push(identity); }
                }
            }
            if(targets.length > 0) { for(const child of functionNode.children) { this.walk(child, targets); } }
        }
    }
}
