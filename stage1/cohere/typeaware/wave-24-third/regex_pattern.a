// Production Go's narrow pattern walk and validity checks, rather than RegExp execution.
export class CharacterSpan {
    start: number; end: number; breaker: boolean;
    constructor(start: number, end: number, breaker = false) { this.start = start; this.end = end; this.breaker = breaker; }
}
export class RegexPattern {
    readonly pattern: string; readonly flags: string; readonly spans: CharacterSpan[] = [];
    constructor(pattern: string, flags: string) { this.pattern = pattern; this.flags = flags; }
    char(at: number): string { return this.pattern.slice(at, at + 1); }
    unicode(): boolean { return this.flags.includes('u') || this.flags.includes('v'); }
    hex(text: string): boolean { return text.length > 0 && text.split('').every((value) => '0123456789abcdefABCDEF'.includes(value)); }
    width(at: number): number { return (this.pattern.codePointAt(at) ?? 0) > 65535 ? 2 : 1; }
    escape(at: number): number {
        if(at + 1 >= this.pattern.length) { return -1; }
        const next = this.char(at + 1);
        if(next === 'x' && this.pattern.slice(at + 2, at + 4).length === 2 && this.hex(this.pattern.slice(at + 2, at + 4))) { return at + 4; }
        if(next === 'u') {
            if(this.char(at + 2) === '{' && this.unicode()) { const end = this.pattern.indexOf('}', at + 3); return end >= 0 ? end + 1 : at + 2; }
            if(this.pattern.slice(at + 2, at + 6).length === 4 && this.hex(this.pattern.slice(at + 2, at + 6))) { return at + 6; }
            return at + 2;
        }
        if(next === 'c') { return at + 2 < this.pattern.length ? at + 3 : at + 2; }
        if(['p', 'P', 'q'].includes(next) && this.unicode() && this.char(at + 2) === '{') {
            const end = this.pattern.indexOf('}', at + 3); if(end >= 0) { return end + 1; }
        }
        return at + 1 + this.width(at + 1);
    }
    classEnd(at: number): number {
        let depth = 1; let current = at + 1;
        while(current < this.pattern.length) {
            const char = this.char(current);
            if(char === '\\') { current = this.escape(current); if(current < 0) { return -1; } }
            else if(char === '[' && this.flags.includes('v')) { depth++; current++; }
            else if(char === ']') { depth--; current++; if(depth === 0) { return current; } }
            else { current += this.width(current); }
        }
        return -1;
    }
    classElement(at: number): CharacterSpan {
        if(this.char(at) !== '\\') { return new CharacterSpan(at, at + this.width(at)); }
        const next = this.char(at + 1); let end = this.escape(at);
        if(end < 0 || (next === 'B' && this.unicode()) || (next === 'c' && at + 2 >= this.pattern.length)) { return new CharacterSpan(at, -1); }
        if(['p', 'P', 'q'].includes(next) && this.unicode() && this.char(at + 2) === '{') {
            const close = this.pattern.indexOf('}', at + 3); if(close < 0) { return new CharacterSpan(at, -1); } end = close + 1;
        }
        if(next === 'u' && this.char(at + 2) === '{' && this.unicode() && !this.hex(this.pattern.slice(at + 3, end - 1))) { return new CharacterSpan(at, -1); }
        if(next === 'u' && end === at + 6 && this.unicode()) {
            const high = Number.parseInt(this.pattern.slice(at + 2, end), 16);
            if(high >= 55296 && high <= 56319 && this.pattern.slice(end, end + 2) === '\\u' && this.hex(this.pattern.slice(end + 2, end + 6))) {
                const low = Number.parseInt(this.pattern.slice(end + 2, end + 6), 16); if(low >= 56320 && low <= 57343) { end += 6; }
            }
        }
        const breaker = 'dDwWsS'.includes(next) || (['p', 'P', 'q'].includes(next) && this.unicode() && this.char(at + 2) === '{');
        return new CharacterSpan(at, end, breaker);
    }
    walkClass(start: number, end: number): boolean {
        const elements: CharacterSpan[] = []; let at = start + 1; let pending = -1;
        if(this.char(at) === '^') { at++; }
        while(at < end - 1) {
            const char = this.char(at);
            if(char === '[' && this.flags.includes('v')) { at = this.classEnd(at); if(at < 0) { return false; } pending = -1; continue; }
            if(['-', '&'].includes(char) && this.flags.includes('v') && this.char(at + 1) === char) { at += 2; pending = -1; continue; }
            if(char === '-' && pending >= 0 && this.char(at + 1) !== ']') {
                const next = this.classElement(at + 1); if(next.end < 0 || next.breaker) { return false; }
                const prior = elements[pending]; if(prior !== undefined) { prior.end = next.end; }
                at = next.end; pending = -1; continue;
            }
            const element = this.classElement(at); if(element.end < 0) { return false; }
            elements.push(element); pending = element.breaker ? -1 : elements.length - 1; at = element.end;
        }
        for(const element of elements) { if(!element.breaker) { this.spans.push(element); } }
        return at === end - 1;
    }
    brace(at: number): number {
        let current = at + 1; const first = current;
        while(this.char(current) !== '' && '0123456789'.includes(this.char(current))) { current++; }
        if(current === first) { return -1; }
        if(this.char(current) === ',') { current++; while(this.char(current) !== '' && '0123456789'.includes(this.char(current))) { current++; } }
        return this.char(current) === '}' ? current + 1 : -1;
    }
    quantified(at: number): number {
        let current = at;
        if(['*', '+', '?'].includes(this.char(current))) { current++; }
        else if(this.char(current) === '{') { const end = this.brace(current); if(end < 0) { return at; } current = end; }
        else { return at; }
        return this.char(current) === '?' ? current + 1 : current;
    }
    walk(): boolean {
        for(let at = 0; at < this.pattern.length;) {
            const char = this.char(at);
            if(char === '[') { const end = this.classEnd(at); if(end < 0 || !this.walkClass(at, end)) { return false; } at = this.quantified(end); continue; }
            if(char === '(') {
                at++;
                if(this.char(at) === '?') {
                    at++; const next = this.char(at);
                    if([':', '=', '!'].includes(next)) { at++; }
                    else if(next === '<') { at++; if(['=', '!'].includes(this.char(at))) { at++; } else { const end = this.pattern.indexOf('>', at); at = end < 0 ? this.pattern.length : end + 1; } }
                }
                continue;
            }
            if(char === ')') { at = this.quantified(at + 1); continue; }
            if(['|', '^', '$'].includes(char)) { at++; continue; }
            let end = at + this.width(at); let emit = true;
            if(char === '\\') {
                end = this.escape(at); if(end < 0) { return false; }
                const next = this.char(at + 1);
                emit = !'dDsSwWpPkqbB'.includes(next);
                if(next === 'x' && end !== at + 4) { emit = false; }
                if(next === 'u' && ((this.char(at + 2) === '{' && !this.hex(this.pattern.slice(at + 3, end - 1))) || (this.char(at + 2) !== '{' && end !== at + 6))) { emit = false; }
                if(next === 'c' && !'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'.includes(this.char(at + 2))) { emit = false; }
                if(end === at + 2 && '01234567'.includes(next)) {
                    let value = Number.parseInt(next, 8); let count = 1;
                    while(count < 3 && this.char(end) !== '' && '01234567'.includes(this.char(end))) {
                        const digit = Number.parseInt(this.char(end), 8); if(value * 8 + digit > 255) { break; } value = value * 8 + digit; end++; count++;
                    }
                }
            }
            if(emit) { this.spans.push(new CharacterSpan(at, end)); } at = this.quantified(end);
        }
        return true;
    }
    valid(): boolean {
        const seen = new Set<string>();
        for(const flag of this.flags.split('')) { if(!'dgimsuvy'.includes(flag) || seen.has(flag)) { return false; } seen.add(flag); }
        if(seen.has('u') && seen.has('v')) { return false; }
        if(!this.walk()) { return false; }
        let depth = 0; let repeatable = false;
        for(let at = 0; at < this.pattern.length;) {
            const char = this.char(at);
            if(char === '\\') { at = this.escape(at); if(at < 0) { return false; } repeatable = true; continue; }
            if(char === '[') { at = this.classEnd(at); if(at < 0) { return false; } repeatable = true; continue; }
            if(char === '(') { depth++; repeatable = false; }
            else if(char === ')') { depth--; if(depth < 0) { return false; } repeatable = true; }
            else if(['*', '+', '?'].includes(char)) { if(!repeatable) { return false; } repeatable = false; }
            else if(char === '{') { const end = this.brace(at); if(end >= 0) { if(!repeatable) { return false; } at = end; repeatable = false; continue; } if(this.unicode()) { return false; } repeatable = true; }
            else { repeatable = char !== '|'; }
            at++;
        }
        return depth === 0;
    }
    literal(): string {
        let previous = 0; let output = '';
        for(const span of this.spans) {
            const written = this.pattern.slice(span.start, span.end); let replacement = '';
            if(written === '/') { replacement = '\\/'; }
            const controls = ['\n', '\r', '\t', '\v', '\f']; const escapes = ['\\n', '\\r', '\\t', '\\v', '\\f'];
            for(let at = 0; at < controls.length; at++) { const control = controls[at] ?? ''; if(written === control || written === '\\' + control) { replacement = escapes[at] ?? ''; } }
            if(replacement !== '' && span.start >= previous) { output += this.pattern.slice(previous, span.start) + replacement; previous = span.end; }
        }
        return output + this.pattern.slice(previous);
    }
}
