// Compare every var declaration with every identifier's own checker symbol.
import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
import { Shadow } from './shadow.ts';
import { Frames, header } from './frames.ts';

export class BlockScopedVar {
    readonly rules: Rules;
    readonly shape: Shadow;
    constructor(rules: Rules) { this.rules = rules; this.shape = new Shadow(rules); }
    symbol(index: number): number {
        const frames = new Frames(this.rules.ask(index, 'symbol-identities'));
        header(frames, 'symbol-identities');
        const identity = frames.natural();
        frames.natural(); frames.yes(); frames.natural(); frames.natural(); frames.end();
        return identity;
    }
    names(index: number, into: number[]): void {
        if(index < 0) { return; }
        const node = this.rules.parser.node(index);
        if(node.kind === 'Identifier') { into.push(index); }
        else if(['ArrayBindingPattern', 'ObjectBindingPattern'].includes(node.kind)) {
            for(const child of node.children) {
                if(this.rules.parser.node(child).kind === 'BindingElement') { this.names(this.shape.name(child), into); }
            }
        }
    }
    container(index: number): number {
        let parent = this.rules.parents[index] ?? -1;
        while(parent >= 0) {
            if(['Block', 'ForStatement', 'ForInStatement', 'ForOfStatement', 'SwitchStatement',
                'CatchClause', 'ClassStaticBlockDeclaration', 'SourceFile'].includes(this.rules.parser.node(parent).kind)) { return parent; }
            parent = this.rules.parents[parent] ?? -1;
        }
        return -1;
    }
    add(rule: string, id: string, message: string, index: number): void {
        const node = this.rules.parser.node(index);
        this.rules.findings.push(new Diagnostic(rule, id, message,
            this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), ''));
    }
    run(): void {
        const declarations: number[] = [];
        const identifiers: number[] = [];
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            // Speculative parser nodes are not members of the final source tree.
            if((this.rules.parents[index] ?? -1) < 0) { continue; }
            const node = this.rules.parser.node(index);
            if(node.kind === 'Identifier') { identifiers.push(index); }
            const parent = this.rules.parents[index] ?? -1;
            if(node.kind === 'VariableDeclaration' && parent >= 0 && this.rules.parser.node(parent).kind === 'VariableDeclarationList' &&
                this.rules.parser.node(parent).semantic === '0') { this.names(this.shape.name(index), declarations); }
        }
        if(declarations.length === 0) { return; }
        const symbols = new Map<number, number>();
        for(const identifier of identifiers) { symbols.set(identifier, this.symbol(identifier)); }
        for(const declaration of declarations) {
            const symbol = symbols.get(declaration) ?? 0;
            const container = this.container(declaration);
            if(symbol === 0 || container < 0) { continue; }
            const bounds = this.rules.parser.node(container);
            const name = this.rules.parser.node(declaration);
            const start = this.rules.start(name);
            let line = 1; let column = 1;
            const source = this.rules.scanner.text;
            for(let at = 0; at < start; at++) {
                const code = source.charCodeAt(at);
                if(code === 13) { line++; column = 1; if(source.charCodeAt(at + 1) === 10 && at + 1 < start) { at++; } }
                else if(code === 10 || code === 8232 || code === 8233) { line++; column = 1; }
                else { column++; }
            }
            for(const identifier of identifiers) {
                if(symbols.get(identifier) !== symbol) { continue; }
                const use = this.rules.parser.node(identifier);
                if(use.pos >= bounds.pos && use.end <= bounds.end) { continue; }
                this.add('block-scoped-var', 'outOfScope',
                    `\`${use.text}\` is declared with \`var\` inside a block on line ${line} column ${column}, and used here, outside it. That works because \`var\` is function-scoped rather than block-scoped, so the braces around the declaration say one thing and the binding does another. Declare it with \`let\` in the scope that actually needs it, or move the declaration out to where it is used.`, identifier);
            }
        }
    }
}
