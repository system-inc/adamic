import { panic, tsgoInspect } from 'adamic';
import type { Parser } from '../../../../typescript/parser/parser.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { Scanner } from '../../../../typescript/scanner/scanner.ts';
import { Frames, header } from '../../frames.ts';
import { types } from '../../facts.ts';
import type { Diagnostic } from '../../diagnostic.ts';

// This owned adapter queries raw checker observations. The driver supplies the
// selected node; queries do not fetch that node again from its index.
export class Context {
    readonly program: number;
    readonly path: string;
    readonly parser: Parser;
    readonly scanner: Scanner;
    readonly offsets: readonly number[];
    readonly blindedRules: readonly string[];
    readonly findings: Diagnostic[] = [];
    constructor(
        program: number,
        path: string,
        parser: Parser,
        scanner: Scanner,
        offsets: readonly number[],
        blindedRules: readonly string[],
    ) {
        this.program = program;
        this.path = path;
        this.parser = parser;
        this.scanner = scanner;
        this.offsets = offsets;
        this.blindedRules = blindedRules;
    }
    byte(position: number): number {
        return this.offsets[position] ?? panic('position outside source');
    }
    tokenStart(node: ParseNode): number {
        this.scanner.pos = node.pos;
        this.scanner.scan();
        return this.scanner.start;
    }
    scanAt(position: number): string {
        this.scanner.pos = position;
        return this.scanner.scan();
    }
    start(node: ParseNode): number {
        return this.byte(this.tokenStart(node));
    }
    ask(node: ParseNode, question: string): string {
        return tsgoInspect(this.program, this.path, this.byte(node.pos), this.byte(node.end), node.kind, question);
    }
    unwrap(node: ParseNode): ParseNode {
        let result = node;
        while(result.kind === 'ParenthesizedExpression') {
            result = this.parser.node(result.children[0] ?? panic('empty parentheses'));
        }
        return result;
    }
    declarationFiles(node: ParseNode): { readonly present: boolean; readonly files: readonly boolean[] } {
        const frames = new Frames(this.ask(node, 'runtime-context\norigin'));
        header(frames, 'runtime-context');
        if(frames.field() !== 'origin') {
            panic('origin mode mismatch');
        }
        const present = frames.yes();
        const files: boolean[] = [];
        if(present) {
            frames.natural();
            frames.field();
            const count = frames.natural();
            for(let at = 0; at < count; at++) {
                frames.field();
                frames.field();
                frames.natural();
                frames.natural();
                files.push(frames.yes());
                frames.yes();
                frames.yes();
                frames.field();
                frames.natural();
                frames.natural();
                const ancestors = frames.natural();
                for(let parent = 0; parent < ancestors; parent++) {
                    frames.field();
                    frames.field();
                    frames.natural();
                    frames.natural();
                    frames.natural();
                    frames.yes();
                    frames.field();
                }
            }
        }
        frames.end();
        return { present, files };
    }
    resultFlags(node: ParseNode): { readonly present: boolean; readonly flags: number } {
        const facts = types(this.ask(node, 'raw-shape'), 'raw-shape');
        return { present: facts.present, flags: facts.present ? facts.root().flags : 0 };
    }
}
