import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import type { Context } from '../symbol_description/context.a';
import { Diagnostic } from '../../diagnostic.ts';

export interface HookCallFactsInterface {
    readonly start: number;
    readonly end: number;
    readonly hasChecker: boolean;
    readonly hasExpression: boolean;
    readonly calleeKind: string;
    readonly calleeName: string;
    readonly receiverKind: string;
    readonly receiverName: string;
    readonly propertyKind: string;
    readonly propertyName: string;
    readonly resultPresent: boolean;
    readonly resultFlags: number;
    readonly blindedRules: readonly string[];
}
export function isHookName(name: string): boolean {
    return /^use[A-Z0-9]/u.test(name);
}
export function namedRules(names: readonly string[]): string {
    if(names.length === 0) {
        return '';
    }
    if(names.length === 1) {
        return `\`${names[0] ?? ''}\``;
    }
    if(names.length === 2) {
        return `\`${names[0] ?? ''}\` and \`${names[1] ?? ''}\``;
    }
    let result = '';
    for(let index = 0; index < names.length; index++) {
        const name = names[index] ?? '';
        result += index === names.length - 1 ? `and \`${name}\`` : `\`${name}\`, `;
    }
    return result;
}
export function description(hook: string, blinded: readonly string[]): string {
    const cost =
        blinded.length === 0
            ? 'Every rule that identifies a React value by its type is disabled for this file, and this build linked none of them so none can be named. '
            : `These rules identify a React value by asking the checker for its type, so they cannot analyse this file and will report nothing in it: ${namedRules(blinded)}. Suppressing this finding turns those off for the file rather than tidying a type. `;
    return `\`${hook}\` here resolves to \`any\`, so the type checker cannot see what this hook returns. ${cost}React's types are probably not resolving here: check that \`@types/react\` is installed and current, that no ambient declaration is shadowing it, and that the path mapping for \`react\` resolves.`;
}
export function visit(node: HookCallFactsInterface): Diagnostic | undefined {
    if(!node.hasChecker || !node.hasExpression) {
        return undefined;
    }
    let hook = '';
    if(node.calleeKind === 'Identifier' && isHookName(node.calleeName)) {
        hook = node.calleeName;
    }
    if(
        node.calleeKind === 'PropertyAccessExpression' &&
        node.receiverKind === 'Identifier' &&
        node.receiverName === 'React' &&
        node.propertyKind === 'Identifier' &&
        isHookName(node.propertyName)
    ) {
        hook = `React.${node.propertyName}`;
    }
    if(hook === '' || !node.resultPresent || (node.resultFlags & 1) === 0) {
        return undefined;
    }
    return new Diagnostic(
        'structure/react-hook-no-any-type',
        'reactHookNoAnyType',
        description(hook, node.blindedRules),
        node.start,
        node.end,
        '',
    );
}

export class Rule {
    readonly context: Context;
    constructor(context: Context) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        if(node.children.length === 0) {
            return;
        }
        const callee = this.context.parser.node(node.children[0] ?? index);
        let receiverKind = '';
        let receiverName = '';
        let propertyKind = '';
        let propertyName = '';
        let relevant = callee.kind === 'Identifier' && isHookName(callee.text);
        if(callee.kind === 'PropertyAccessExpression') {
            const receiver = this.context.unwrap(this.context.parser.node(callee.children[0] ?? index));
            const property = this.context.parser.node(callee.children[callee.children.length - 1] ?? index);
            receiverKind = receiver.kind;
            receiverName = receiver.text;
            propertyKind = property.kind;
            propertyName = property.text;
            relevant =
                receiverKind === 'Identifier' &&
                receiverName === 'React' &&
                propertyKind === 'Identifier' &&
                isHookName(propertyName);
        }
        if(!relevant) {
            return;
        }
        const result = this.context.resultFlags(node);
        const finding = visit({
            start: this.context.start(node),
            end: this.context.byte(node.end),
            hasChecker: true,
            hasExpression: true,
            calleeKind: callee.kind,
            calleeName: callee.text,
            receiverKind,
            receiverName,
            propertyKind,
            propertyName,
            resultPresent: result.present,
            resultFlags: result.flags,
            blindedRules: this.context.blindedRules,
        });
        if(finding !== undefined) {
            this.context.findings.push(finding);
        }
    }
}
export function create(context: Context): Rule {
    return new Rule(context);
}
