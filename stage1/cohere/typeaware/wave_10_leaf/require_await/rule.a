import { panic } from 'adamic';
import type { Diagnostic } from '../../diagnostic.ts';

// Preorder raw body nodes, with the body itself at depth 0. No record owns a
// parent. Numeric kinds and flags are the pinned parser's observations.
export interface BodyNodeFactsInterface {
    readonly kind: number;
    readonly depth: number;
    readonly flags: number;
    readonly awaitModifier: boolean;
}
export interface FunctionFactsInterface {
    readonly modifierFlags: number;
    readonly functionFlags: number;
    readonly bodyPresent: boolean;
    readonly bodyKind: number;
    readonly statementCount: number;
    readonly bodyNodes: readonly BodyNodeFactsInterface[];
}
function boundary(kind: number): boolean {
    return [263, 219, 220, 175, 178, 179, 177, 264, 232].includes(kind);
}
function awaits(node: BodyNodeFactsInterface): boolean {
    return (
        node.kind === 224 || (node.kind === 251 && node.awaitModifier) || (node.kind === 262 && (node.flags & 7) === 6)
    );
}
export function containsAwait(node: FunctionFactsInterface): boolean {
    let stopDepth = -1;
    // Match production's initial ForEachChild walk; the body's own boundary
    // does not stop this first pass, including when it is a concise expression.
    for(const child of node.bodyNodes) {
        if(child.depth === 0) {
            continue;
        }
        if(stopDepth >= 0 && child.depth > stopDepth) {
            continue;
        }
        stopDepth = -1;
        if(awaits(child)) {
            return true;
        }
        if(boundary(child.kind)) {
            stopDepth = child.depth;
        }
    }
    if(node.bodyKind !== 242) {
        const body = node.bodyNodes[0];
        return body !== undefined && awaits(body);
    }
    return false;
}
export function mayNeedReport(node: FunctionFactsInterface): boolean {
    return (
        (node.modifierFlags & 1024) !== 0 &&
        (node.functionFlags & 1) === 0 &&
        node.bodyPresent &&
        !(node.bodyKind === 242 && node.statementCount === 0) &&
        !containsAwait(node)
    );
}
export function visit(node: FunctionFactsInterface): Diagnostic | undefined {
    if(!mayNeedReport(node)) {
        return undefined;
    }
    // Never turn the absent contextual-signature/source-token adapter into a
    // clean result. Candidate handling needs those raw facts before reporting.
    panic(
        'NotYet: require-await supplied-node adapter must provide contextual signatures, declared generic targets, heritage member types and source token spans',
    );
}
