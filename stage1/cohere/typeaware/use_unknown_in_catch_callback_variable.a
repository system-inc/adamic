import type { Rules } from './rules.ts';
import { types } from './facts.ts';
import { thenCallbackSignatures } from './then_callback_signatures.a';
import { handlerParameterTypes } from './handler_parameter_types.a';
import { Repair } from './repair.ts';
import { Suggestion } from './suggestion.ts';
import { Shadow } from './shadow.ts';

export class UseUnknownInCatchCallbackVariable {
    readonly rules: Rules;
    readonly shape: Shadow;
    constructor(rules: Rules) { this.rules = rules; this.shape = new Shadow(rules); }
    flagged(index: number): boolean {
        for(const parameter of handlerParameterTypes(this.rules, index)) {
            if(parameter.count === 0 || !parameter.present) { continue; }
            if(parameter.rest) {
                if(!parameter.arrayOrTuple) { return true; }
                if(parameter.arguments === 0) { continue; }
                if((parameter.firstFlags & 2) === 0) { return true; }
            }
            else if((parameter.flags & 2) === 0) { return true; }
        }
        return false;
    }
    collect(index: number): number[] {
        const actual = this.rules.skip(index);
        const node = this.rules.parser.node(actual);
        if(node.kind === 'BinaryExpression') {
            const operator = this.rules.parser.node(node.children[1] ?? -1).kind;
            if(operator === 'CommaToken') { return this.collect(node.children[2] ?? -1); }
            if(['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken'].includes(operator)) {
                return this.collect(node.children[0] ?? -1).concat(this.collect(node.children[2] ?? -1));
            }
        }
        if(node.kind === 'ConditionalExpression') { return this.collect(node.children[2] ?? -1).concat(this.collect(node.children[4] ?? -1)); }
        if(['ArrowFunction', 'FunctionExpression'].includes(node.kind) && this.flagged(actual)) { return [actual]; }
        return [];
    }
    report(index: number, method: string): void {
        const parser = this.rules.parser;
        const parameter = parser.node(index).children.find((child) => parser.node(child).kind === 'Parameter') ?? -1;
        if(parameter < 0) { return; }
        const node = parser.node(parameter);
        const name = this.shape.name(parameter);
        if(name < 0) { return; }
        const rest = node.children.some((child) => parser.node(child).kind === 'DotDotDotToken');
        const kind = parser.node(name).kind;
        const suffix = method === 'then' ? ' rejection' : '';
        const message = `Prefer the safe \`: unknown\` for a \`${method}\`${suffix} callback variable.`;
        if(!rest && ['ArrayBindingPattern', 'ObjectBindingPattern'].includes(kind)) {
            const array = kind === 'ArrayBindingPattern';
            this.rules.add('use-unknown-in-catch-callback-variable', array ? 'useUnknownArrayDestructuringPattern' : 'useUnknownObjectDestructuringPattern',
                message + (array ? ' The thrown error may not be iterable.' : ' The thrown error may be nullable, or may not have the expected shape.'), parameter);
            return;
        }
        const initializer = this.shape.initializer(parameter);
        const annotation = node.children.find((child) => child !== name && child !== initializer &&
            !['DotDotDotToken', 'QuestionToken', 'ExclamationToken'].includes(parser.node(child).kind)) ?? -1;
        const question = node.children.find((child) => parser.node(child).kind === 'QuestionToken') ?? -1;
        const at = this.rules.byte(parser.node(question < 0 ? name : question).end);
        const typed = annotation >= 0;
        const replacement = rest ? ': [unknown]' : ': unknown';
        const fixes: Repair[] = [];
        let id = typed ? 'wrongTypeAnnotationSuggestion' : 'addUnknownTypeAnnotationSuggestion';
        let description = typed ? 'Change existing type annotation to `: unknown`.' : 'Add an explicit `: unknown` type annotation to the rejection callback variable.';
        if(rest) {
            id = typed ? 'wrongRestTypeAnnotationSuggestion' : 'addUnknownRestTypeAnnotationSuggestion';
            description = typed ? 'Change existing type annotation to `: [unknown]`.' : 'Add an explicit `: [unknown]` type annotation to the rejection callback rest variable.';
        }
        const beforeParameter = this.rules.scanner.text.slice(this.rules.start(parser.node(index)), this.rules.start(node));
        const parenless = !typed && !rest && parser.node(index).kind === 'ArrowFunction' && !beforeParameter.includes('(');
        if(parenless) { fixes.push(new Repair(this.rules.byte(this.rules.start(parser.node(name))), this.rules.byte(this.rules.start(parser.node(name))), '(')); }
        fixes.push(new Repair(at, typed ? this.rules.byte(parser.node(annotation).end) : at, replacement + (parenless ? ')' : '')));
        const finding = this.rules.add('use-unknown-in-catch-callback-variable', 'useUnknown', message, parameter);
        finding.suggestions.push(new Suggestion(id, description, fixes));
    }
    visit(index: number): void {
        const parser = this.rules.parser;
        const call = parser.node(index);
        const calleeIndex = this.rules.skip(call.children[0] ?? -1);
        const callee = parser.node(calleeIndex);
        if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(callee.kind)) { return; }
        const receiver = callee.children[0] ?? -1;
        const keyIndex = callee.children[callee.children.length - 1] ?? -1;
        const key = parser.node(this.rules.skip(keyIndex));
        let method = '';
        if(callee.kind === 'PropertyAccessExpression') { if(key.kind === 'Identifier') { method = key.text; } }
        else if(['StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(key.kind)) { method = key.text; }
        else {
            const type = types(this.rules.ask(keyIndex, 'raw-shape'), 'raw-shape').root();
            if((type.flags & 1024) !== 0) {
                const name = this.rules.name(type, keyIndex);
                if(name === '"catch"') { method = 'catch'; }
                if(name === '"then"') { method = 'then'; }
            }
        }
        if(method !== 'catch' && method !== 'then') { return; }
        const arguments_ = call.children.slice(call.children.length - call.list);
        const target = method === 'catch' ? 0 : 1;
        if(arguments_.length <= target) { return; }
        for(let at = 0; at <= target; at++) { if(parser.node(arguments_[at] ?? -1).kind === 'SpreadElement') { return; } }
        const receiverType = types(this.rules.ask(receiver, 'raw-shape'), 'raw-shape').root();
        if(!thenCallbackSignatures(this.rules, calleeIndex, receiverType.id).some((count) => count > 0)) { return; }
        for(const callback of this.collect(arguments_[target] ?? -1)) { this.report(callback, method); }
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if((this.rules.parents[index] ?? -1) >= 0 && this.rules.parser.node(index).kind === 'CallExpression') { this.visit(index); }
        }
    }
}
