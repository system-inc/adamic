import type { Rules } from '../rules.ts';
import { nodeSymbol } from '../library_declarations.a';
import { Diagnostic } from '../diagnostic.ts';
export class PreferRestParams {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(node.kind !== 'Identifier' || node.text !== 'arguments' || (this.rules.parents[index] ?? -1) < 0) {
                continue;
            }
            const symbol = nodeSymbol(this.rules, index);
            if(!symbol.present || symbol.declarations.length !== 0) {
                continue;
            }
            const parent = this.rules.parser.node(this.rules.parents[index] ?? -1);
            if(parent.kind === 'PropertyAccessExpression' && parent.children[0] === index) {
                continue;
            }
            this.rules.findings.push(
                new Diagnostic(
                    'prefer-rest-params',
                    'preferRestParams',
                    'This reads the implicit `arguments` object, which is array-like rather than an array and carries none of `Array.prototype`, so iterating or slicing it needs a conversion first. Declare a rest parameter (`...args`) and use that instead.',
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    '',
                ),
            );
        }
    }
}
