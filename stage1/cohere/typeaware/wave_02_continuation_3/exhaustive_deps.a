    hook(index: number): string {
        const callee = this.skip(index);
        if(this.kind(callee) === 'Identifier') {
            return this.text(callee);
        }
        if(
            this.kind(callee) === 'PropertyAccessExpression' &&
            this.kind(this.skip(this.child(callee, 0))) === 'Identifier' &&
            this.text(this.skip(this.child(callee, 0))) === 'React' &&
            this.kind(this.last(callee)) === 'Identifier'
