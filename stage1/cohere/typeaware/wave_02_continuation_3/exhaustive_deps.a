        if(this.kind(pattern) !== 'ArrayBindingPattern') {
            return '';
        }
        const children = this.rules.parser.node(pattern).children;
        if(
            children.length !== 2 ||
            children[1] !== declared ||
            this.kind(this.parent(pattern)) !== 'VariableDeclaration'
        ) {
            return '';
        }
        const initializer = this.skip(this.bindings.shape.initializer(this.parent(pattern)));
        return this.kind(initializer) === 'CallExpression' ? this.hook(this.child(initializer, 0)) : '';
