        if(visiting.includes(id)) {
            return false;
        }
        const declared = this.earliest(index);
        const kind = this.kind(declared);
        if(kind === 'BindingElement') {
            return (
                ['useState', 'useReducer', 'useActionState', 'useTransition'].includes(this.setterHook(declared)) &&
