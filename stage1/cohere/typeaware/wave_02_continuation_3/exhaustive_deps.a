        const initializer = this.skip(this.bindings.shape.initializer(declared));
        if(['ArrowFunction', 'FunctionExpression'].includes(this.kind(initializer))) {
            return this.functionStable(initializer, component, [...visiting, id]);
        }
        const list = this.parent(declared);
        if(
            this.kind(list) === 'VariableDeclarationList' &&
            this.rules.parser.node(list).semantic === '2' &&
            this.primitive(initializer)
        ) {
            return true;
        }
        return (
            this.kind(initializer) === 'CallExpression' &&
            ['useRef', 'useEffectEvent'].includes(this.hook(this.child(initializer, 0)))
