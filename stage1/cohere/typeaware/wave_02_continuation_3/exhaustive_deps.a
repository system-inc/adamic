            const operator = this.kind(this.child(current, 1));
            if(['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken'].includes(operator)) {
                return this.construction(this.child(current, 0)) || this.construction(this.child(current, 2));
            }
            if(operator === 'EqualsToken') {
                return this.construction(this.child(current, 2));
            }
        }
        return false;
    }
    analyze(callback: number, deps: number, call: number, component: number, effect: boolean): void {
        const functionNode = this.rules.parser.node(callback);
        const context = astContext(
            this.rules,
            this.rules.path,
            this.rules.byte(functionNode.pos),
            this.rules.byte(functionNode.end),
            functionNode.kind,
