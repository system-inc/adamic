        if(this.kind(name) !== 'Identifier') {
            return false;
        }
        const symbol = this.identity(name);
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if(
                this.kind(index) !== 'BinaryExpression' ||
                !this.contains(component, index) ||
                this.kind(this.child(index, 1)) !== 'EqualsToken'
            ) {
                continue;
            }
            const target = this.skip(this.child(index, 0));
