                const binding = this.earliest(root);
                if(binding < 0 || !this.contains(component, binding) || this.contains(callback, binding)) {
                    continue;
                }
                if(
                    ['FunctionDeclaration', 'ClassDeclaration'].includes(this.kind(binding)) ||
                    (this.kind(binding) === 'VariableDeclaration' &&
                        this.kind(this.bindings.shape.name(binding)) === 'Identifier' &&
                        this.construction(this.bindings.shape.initializer(binding)))
                ) {
                    this.report(binding, 3);
                }
            }
        }
        else {
            const suggested =
                !effect && recommendation.missing.length > 0
                    ? this.recommend(reads, [], effect).suggested
                    : recommendation.suggested;
            const keys = declared.map((entry) => entry.path);
            let sorted = true;
            for(let index = 1; index < keys.length; index++) {
                if((keys[index - 1] ?? '') > (keys[index] ?? '')) {
                    sorted = false;
                }
            }
            if(sorted) {
                suggested.sort((left, right) => (left < right ? -1 : left > right ? 1 : 0));
            }
            const formatted: string[] = [];
            for(const path of suggested) {
                const parts = path.split('.');
                let value = parts[0] ?? '';
                for(let index = 1; index < parts.length; index++) {
                    const prefix = parts.slice(0, index + 1).join('.');
                    value += `${reads.some((read) => read.optional.includes(prefix)) ? '?.' : '.'}${parts[index] ?? ''}`;
                }
                formatted.push(value);
            }
            const finding = this.report(deps, message);
            finding.suggestions.push(
                new Suggestion(
                    'exhaustiveDepsUpdateArray',
                    `Update the dependency array to [${formatted.join(', ')}].`,
                    [],
                ),
            );
        }
        for(let index = 0; index < entryIndexes.length; index++) {
            this.report(entryIndexes[index] ?? -1, entryMessages[index] ?? -1);
        }
    }
    check(call: number): void {
        const name = this.hook(this.child(call, 0));
        const callbackIndex =
            name === 'useImperativeHandle'
                ? 1
                : ['useEffect', 'useLayoutEffect', 'useCallback', 'useMemo'].includes(name)
                  ? 0
                  : -1;
        if(callbackIndex < 0) {
            return;
        }
        let component = this.parent(call);
        while(component >= 0 && !this.functionLike(component)) {
            component = this.parent(component);
        }
        if(component < 0) {
            return;
        }
        const node = this.rules.parser.node(call);
        const argumentsStart = node.children.length - node.list;
        if(node.list <= callbackIndex) {
            this.report(call, 9);
            return;
        }
        let deps = node.list > callbackIndex + 1 ? (node.children[argumentsStart + callbackIndex + 1] ?? -1) : -1;
        if(this.kind(deps) === 'Identifier' && this.text(deps) === 'undefined') {
            deps = -1;
        }
        const effect = ['useEffect', 'useLayoutEffect'].includes(name);
        if(deps < 0 && !effect) {
            if(['useMemo', 'useCallback'].includes(name)) {
                this.report(call, 10);
            }
            return;
        }
        let callback = this.skip(node.children[argumentsStart + callbackIndex] ?? -1);
        if(this.kind(callback) === 'Identifier') {
            if(deps < 0) {
                return;
            }
            const array = this.skip(deps);
            if(
                this.kind(array) === 'ArrayLiteralExpression' &&
                this.rules.parser
                    .node(array)
                    .children.some(
                        (element) =>
                            this.kind(this.skip(element)) === 'Identifier' &&
                            this.text(this.skip(element)) === this.text(callback),
                    )
            ) {
                return;
            }
            const binding = this.earliest(callback);
            if(this.kind(binding) === 'FunctionDeclaration') {
                callback = binding;
            }
            else if(this.kind(binding) === 'VariableDeclaration') {
                const initializer = this.skip(this.bindings.shape.initializer(binding));
                if(initializer < 0) {
                    this.report(call, 11);
                    return;
                }
                if(!['ArrowFunction', 'FunctionExpression'].includes(this.kind(initializer))) {
                    this.report(deps, 0);
                    return;
                }
                callback = initializer;
            }
            else {
                this.report(call, 11);
                return;
            }
        }
        else if(!['ArrowFunction', 'FunctionExpression'].includes(this.kind(callback))) {
            this.report(call, 11);
            return;
        }
        this.analyze(callback, deps, call, component, effect);
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if(this.kind(index) === 'CallExpression' && this.parent(index) >= 0) {
                this.check(index);
            }
        }
    }
}
