    recommend(reads: readonly Read[], declared: readonly Declared[], effect: boolean): Recommendation {
        const result = new Recommendation();
        const paths: string[] = [];
        for(const read of reads) {
            if(!read.stable) {
                paths.push(read.path);
            }
        }
        const satisfied: string[] = declared.map((entry) => entry.path);
        for(const read of reads) {
            if(read.stable) {
