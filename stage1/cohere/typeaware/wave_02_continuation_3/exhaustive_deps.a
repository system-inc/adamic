            if(this.kind(index) !== 'Identifier' || !this.contains(functionIndex, index) || this.nonDependency(index)) {
                continue;
            }
            const declarations = this.declarations(index);
            if(declarations.some((declared) => this.contains(functionIndex, declared))) {
                continue;
            }
            if(
                declarations.some((declared) => this.contains(component, declared)) &&
                !this.stable(index, component, visiting)
            ) {
                return false;
            }
        }
        return true;
    }
    reads(callback: number, component: number): Read[] {
        const reads: Read[] = [];
        const order: number[] = [];
        const queue: number[] = [callback];
        for(let at = 0; at < queue.length; at++) {
            const current = queue[at] ?? -1;
            order.push(current);
            const children = this.rules.parser.node(current).children;
            // Depth-first order matches Go ForEachChild and its insertion-ordered advice.
            for(let offset = children.length - 1; offset >= 0; offset--) {
                queue.splice(at + 1, 0, children[offset] ?? -1);
            }
        }
        for(const index of order) {
            if(this.kind(index) !== 'Identifier' || this.nonDependency(index)) {
                continue;
            }
            const declarations = this.declarations(index);
            if(
                declarations.some((declared) => this.contains(callback, declared)) ||
                !declarations.some((declared) => this.contains(component, declared))
            ) {
                continue;
            }
            const call = this.parent(callback);
            if(
                this.kind(call) === 'CallExpression' &&
                declarations.some(
                    (declared) =>
                        this.kind(declared) === 'VariableDeclaration' &&
                        this.skip(this.bindings.shape.initializer(declared)) === call,
                )
            ) {
                continue;
            }
            const optional: string[] = [];
            const path = this.chain(this.outermost(index), optional);
            if(path === '' || reads.some((read) => read.path === path)) {
                continue;
            }
            reads.push(new Read(path, optional, this.stable(index, component, [])));
        }
        return reads;
