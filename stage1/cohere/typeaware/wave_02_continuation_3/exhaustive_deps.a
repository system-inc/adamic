                    if(this.functionLike(current)) {
                        nested = true;
                        break;
                    }
                }
                if(nested) {
                    continue;
                }
                const declared = this.earliest(index);
                if(
                    this.kind(declared) === 'BindingElement' &&
                    this.contains(component, declared) &&
                    !this.contains(callback, declared) &&
                    this.setterHook(declared) === 'useState'
                ) {
                    this.report(call, 13);
                    break;
