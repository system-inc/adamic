    root(index: number): number {
        let current = this.skip(index);
        while(this.kind(current) === 'PropertyAccessExpression') {
            current = this.skip(this.child(current, 0));
        }
        return current;
    }
    outermost(index: number): number {
        let current = index;
        while(true) {
            const parent = this.parent(current);
            if(
                [
                    'ParenthesizedExpression',
                    'NonNullExpression',
                    'AsExpression',
                    'SatisfiesExpression',
                    'TypeAssertionExpression',
                ].includes(this.kind(parent))
            ) {
                current = parent;
                continue;
            }
            if(
                this.kind(parent) !== 'PropertyAccessExpression' ||
                this.child(parent, 0) !== current ||
                this.kind(this.last(parent)) !== 'Identifier' ||
                this.text(this.last(parent)) === 'current'
            ) {
                const holder = this.parent(current);
                if(
                    this.kind(current) === 'PropertyAccessExpression' &&
                    this.kind(holder) === 'BinaryExpression' &&
                    this.child(holder, 0) === current &&
                    this.kind(this.child(holder, 1)) === 'EqualsToken'
                ) {
                    return this.child(current, 0);
                }
                return current;
            }
            const grandparent = this.parent(parent);
            if(this.kind(grandparent) === 'CallExpression' && this.child(grandparent, 0) === parent) {
                return current;
            }
            current = parent;
        }
    }
    literal(index: number): boolean {
        return [
            'StringLiteral',
            'NumericLiteral',
            'BigIntLiteral',
            'TrueKeyword',
            'FalseKeyword',
            'NullKeyword',
            'NoSubstitutionTemplateLiteral',
            'RegularExpressionLiteral',
        ].includes(this.kind(this.skip(index)));
    }
    primitive(index: number): boolean {
        return ['StringLiteral', 'NumericLiteral', 'NullKeyword', 'NoSubstitutionTemplateLiteral'].includes(
            this.kind(this.skip(index)),
