            }
            return;
        }
        const declared: Declared[] = [];
        const entryIndexes: number[] = [];
        const entryMessages: number[] = [];
        const array = this.skip(deps);
        if(this.kind(array) !== 'ArrayLiteralExpression') {
            entryIndexes.push(deps);
            entryMessages.push(7);
        }
        else {
            for(const element of this.rules.parser.node(array).children) {
                if(this.kind(element) === 'OmittedExpression') {
