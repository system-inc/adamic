            }
        }
        // Flattened trie traversal with explicit insertion-order child lists.
        const nodes: string[] = [''];
        for(const path of [...paths, ...satisfied]) {
            let prefix = '';
            for(const part of path.split('.')) {
                prefix = prefix === '' ? part : `${prefix}.${part}`;
                if(!nodes.includes(prefix)) {
                    nodes.push(prefix);
                }
            }
        }
        const satisfying: string[] = [];
        this.scanTree(
            '',
            nodes,
            paths,
            satisfied,
            reads.map((read) => read.path),
            result.missing,
            satisfying,
        );
        const seen: string[] = [];
        for(const entry of declared) {
            if(satisfying.includes(entry.path)) {
                if(!seen.includes(entry.path)) {
                    seen.push(entry.path);
                    result.suggested.push(entry.path);
                }
                else if(!result.duplicate.includes(entry.path)) {
                    result.duplicate.push(entry.path);
                }
            }
            else if(effect && !entry.path.endsWith('.current') && !entry.external) {
                if(!seen.includes(entry.path)) {
                    seen.push(entry.path);
                    result.suggested.push(entry.path);
                }
            }
            else if(!result.unnecessary.includes(entry.path)) {
