    nonDependency(index: number): boolean {
        const parent = this.parent(index);
        for(let current = parent; current >= 0; current = this.parent(current)) {
            const kind = this.kind(current);
            if(
                [
                    'TypeReference',
                    'FunctionType',
                    'ConstructorType',
                    'TypeQuery',
                    'TypeLiteral',
                    'ArrayType',
                    'TupleType',
                    'OptionalType',
                    'RestType',
                    'UnionType',
                    'IntersectionType',
                    'ConditionalType',
                    'InferType',
                    'ParenthesizedType',
                    'ThisType',
                    'TypeOperator',
                    'IndexedAccessType',
                    'MappedType',
                    'LiteralType',
                    'NamedTupleMember',
                    'TemplateLiteralType',
                    'TemplateLiteralTypeSpan',
                    'ImportType',
                    'TypePredicate',
                    'StringKeyword',
                    'NumberKeyword',
                    'BooleanKeyword',
                    'AnyKeyword',
                    'UnknownKeyword',
                    'NeverKeyword',
                    'ObjectKeyword',
                    'VoidKeyword',
                    'UndefinedKeyword',
                    'BigIntKeyword',
                    'SymbolKeyword',
                ].includes(kind)
            ) {
                return true;
            }
            if(this.functionLike(current) || kind === 'SourceFile') {
                break;
            }
        }
        const kind = this.kind(parent);
        if(kind === 'PropertyAccessExpression') {
            return this.last(parent) === index;
        }
        if(kind === 'PropertyAssignment') {
            return this.child(parent, 0) === index;
        }
        if(
            [
                'QualifiedName',
                'MethodDeclaration',
                'PropertyDeclaration',
                'PropertySignature',
                'MethodSignature',
                'GetAccessor',
                'SetAccessor',
                'EnumMember',
                'ImportSpecifier',
                'ImportClause',
                'NamespaceImport',
                'TypeParameter',
                'TypeReference',
                'TypeQuery',
                'JsxAttribute',
