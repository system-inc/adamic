            const target = this.helper.jump(index, node.kind === 'ContinueStatement');
            let at = -1;
            for(let jump = this.jumpNodes.length - 1; jump >= 0; jump--) { if(this.jumpNodes[jump] === target) { at = jump; break; } }
            if(at >= 0) { this.link(this.current, node.kind === 'BreakStatement' ? this.breakBlocks[at] ?? -1 : this.continueBlocks[at] ?? -1); }
            this.dead(); return;
        }
        if(node.kind === 'SwitchStatement') {
            this.expression(node.children[0] ?? -1);
            const after = this.make(); const clauses = this.rules.parser.node(node.children[1] ?? -1).children;
            const bodies: number[] = []; for(const clause of clauses) { bodies.push(this.make()); }
            let defaultAt = -1;
            for(let at = 0; at < clauses.length; at++) {
                const clause = this.rules.parser.node(clauses[at] ?? -1);
                if(clause.kind === 'DefaultClause') { defaultAt = at; continue; }
                this.expression(clause.children[0] ?? -1); this.link(this.current, bodies[at] ?? -1);
                const next = this.make(); this.link(this.current, next); this.enter(next);
            }
            this.link(this.current, defaultAt < 0 ? after : bodies[defaultAt] ?? -1);
            this.jumpNodes.push(index); this.breakBlocks.push(after); this.continueBlocks.push(-1);
            let tail = -1;
            for(let at = 0; at < clauses.length; at++) {
                const clause = this.rules.parser.node(clauses[at] ?? -1);
                this.link(tail, bodies[at] ?? -1); this.enter(bodies[at] ?? -1);
                this.list(clause.children.slice(clause.kind === 'CaseClause' ? 1 : 0)); tail = this.current;
            }
            this.link(tail, after); this.jumpNodes.pop(); this.breakBlocks.pop(); this.continueBlocks.pop(); this.enter(after); return;
        }
        if(node.kind === 'TryStatement') { this.tryStatement(index); return; }
        if(node.kind === 'LabeledStatement') {
            const body = node.children[1] ?? -1;
            if(['ForStatement', 'ForInStatement', 'ForOfStatement', 'WhileStatement', 'DoStatement', 'SwitchStatement'].includes(this.rules.parser.node(body).kind)) { this.statement(body); return; }
            const after = this.make(); this.jumpNodes.push(index); this.breakBlocks.push(after); this.continueBlocks.push(-1);
            this.statement(body); this.link(this.current, after); this.jumpNodes.pop(); this.breakBlocks.pop(); this.continueBlocks.pop(); this.enter(after); return;
        }
        if(['ForStatement', 'ForInStatement', 'ForOfStatement', 'WhileStatement', 'DoStatement'].includes(node.kind)) {
            const body = node.kind === 'DoStatement' ? node.children[0] ?? -1 : node.children[node.children.length - 1] ?? -1;
            const after = this.make(); const head = this.make(); this.link(this.current, head); this.enter(head);
            for(const child of node.children) { if(child !== body) { this.expression(child); } }
            const entry = this.make(); this.link(this.current, entry);
            // Loop body returns are exempt. Reachability of later statements still
            // follows the same normal/targeted-jump completion used by the suite.
            const completion = this.helper.flow(index);
            if(completion.normal) { this.link(this.current, after); }
            this.jumpNodes.push(index); this.breakBlocks.push(after); this.continueBlocks.push(head);
            this.enter(entry); this.statement(body); this.link(this.current, head);
            this.jumpNodes.pop(); this.breakBlocks.pop(); this.continueBlocks.pop(); this.enter(after); return;
        }
        if(node.kind === 'WithStatement') { this.expression(node.children[0] ?? -1); this.statement(node.children[1] ?? -1); return; }
        if(node.kind === 'FunctionDeclaration') { return; }
        for(const child of node.children) { this.expression(child); }
    }
    tryStatement(index: number): void {
        const node = this.rules.parser.node(index);
        const caught = node.children.find((child) => this.rules.parser.node(child).kind === 'CatchClause') ?? -1;
        const final = node.children.length > 1 && this.rules.parser.node(node.children[node.children.length - 1] ?? -1).kind === 'Block' ? node.children[node.children.length - 1] ?? -1 : -1;
        const frame = new ReturnTry(caught < 0 ? -1 : this.make(), final < 0 ? -1 : this.make());
        this.tries.push(frame); this.statement(node.children[0] ?? -1);
        const ends: number[] = [];
        if(caught >= 0) {
            this.link(this.current, frame.caught); ends.push(this.current); frame.position = 1; frame.forked = false;
            this.enter(frame.caught); const catchNode = this.rules.parser.node(caught);
            this.statement(catchNode.children[catchNode.children.length - 1] ?? -1);
        }
        ends.push(this.current); this.tries.pop(); const after = this.make();
        if(final < 0) { for(const end of ends) { this.link(end, after); } this.enter(after); return; }
        const snapshot = this.tries.map((outer) => outer.forked);
        const normal = this.make(); for(const end of ends) { this.link(end, normal); }
        this.enter(normal); this.statement(final); this.link(this.current, after);
        if(this.block(frame.final).incoming) {
            for(let at = 0; at < snapshot.length; at++) { const outer = this.tries[at]; if(outer !== undefined) { outer.forked = snapshot[at] ?? false; } }
            this.enter(frame.final); this.statement(final);
            if(frame.returned) { this.route(true); }
            if(frame.thrown) { this.route(false); }
        }
        this.enter(after);
    }
    enclosing(index: number): number {
