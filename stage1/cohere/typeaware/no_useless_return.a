        while(current >= 0 && current !== this.root) {
            const parent = this.rules.parents[current] ?? -1;
            if(parent < 0) { break; }
            const node = this.rules.parser.node(parent);
            if(node.kind === 'TryStatement' && node.children[0] === current) { return parent; }
            current = parent;
        }
        return -1;
    }
    exempt(index: number): boolean {
        let current = index;
        while(current >= 0 && current !== this.root) {
            const parent = this.rules.parents[current] ?? -1; if(parent < 0) { break; }
            const node = this.rules.parser.node(parent);
            if(['ForStatement', 'ForOfStatement', 'ForInStatement', 'WhileStatement', 'DoStatement'].includes(node.kind)) { return true; }
            if(node.kind === 'TryStatement' && node.children[node.children.length - 1] === current && node.children[0] !== current && this.rules.parser.node(current).kind === 'Block') { return true; }
            current = parent;
        }
        return false;
    }
    executes(index: number, enclosing: number): boolean {
        const node = this.rules.parser.node(index);
        if(['Block', 'FunctionDeclaration', 'BreakStatement'].includes(node.kind) || (node.kind === 'ReturnStatement' && node.children.length === 0)) { return false; }
        if(enclosing >= 0) {
            const trial = this.rules.parser.node(enclosing); const body = this.rules.parser.node(trial.children[0] ?? -1);
            if(node.pos >= body.end && node.pos < trial.end) { return false; }
        }
        return true;
    }
    endsInReturn(index: number): boolean {
        const events = this.block(index).events;
        for(let at = events.length - 1; at >= 0; at--) {
            const kind = this.rules.parser.node(events[at] ?? -1).kind;
            if(kind === 'ReturnStatement') { return true; }
            if(kind !== 'Block') { return false; }
        }
        return true;
    }
    after(index: number, enclosing: number, seen: number[]): boolean {
        for(const next of this.block(index).successors) {
            if(seen.includes(next)) { continue; } seen.push(next);
            if(!this.block(next).reachable && this.block(index).reachable && !this.endsInReturn(index)) { continue; }
            if(this.block(next).events.some((event) => this.executes(event, enclosing)) || this.after(next, enclosing, seen)) { return true; }
        }
        return false;
    }
    collect(index: number, returns: number[]): void {
        for(const child of this.rules.parser.node(index).children) {
            if(this.helper.scope(child) || this.rules.parser.node(child).kind === 'ClassStaticBlockDeclaration') { continue; }
            if(this.rules.parser.node(child).kind === 'ReturnStatement') { returns.push(child); }
            this.collect(child, returns);
        }
    }
    maybeVoid(graph: Types, subject: TypeFact): boolean {
        return (subject.flags & 16) !== 0 || ((subject.flags & (134217728 | 268435456)) !== 0 &&
            subject.parts.some((part) => this.maybeVoid(graph, graph.type(part))));
    }
    required(candidate: number): boolean {
        const node = this.rules.parser.node(this.root);
        if(!this.helper.scope(this.root)) { return false; }
        const returns: number[] = []; this.collect(this.root, returns);
        if(returns.some((index) => index !== candidate)) { return false; }
        if(node.kind === 'GetAccessor') { return true; }
        const body = node.children[node.children.length - 1] ?? -1;
        const before = node.children[node.children.length - (node.kind === 'ArrowFunction' ? 3 : 2)] ?? -1;
        if(before < 0 || ['Identifier', 'Parameter', 'TypeParameter', 'EqualsGreaterThanToken'].includes(this.rules.parser.node(before).kind) || body < 0) { return false; }
        if(node.children.some((child) => this.rules.parser.node(child).kind === 'AsteriskToken')) { return true; }
        const graph = promisedShape(this.rules, this.root);
        if(!graph.present) { return true; }
        return (graph.root().flags & (1 | 4)) === 0 && !this.maybeVoid(graph, graph.root());
    }
    judge(root: number): void {
        this.root = root; this.blocks.splice(0, this.blocks.length); this.current = this.make(); this.block(0).incoming = true; this.block(0).reachable = true;
        const rootNode = this.rules.parser.node(root);
        const body = rootNode.kind === 'SourceFile' ? root : rootNode.children[rootNode.children.length - 1] ?? -1;
        if(body < 0 || !['Block', 'SourceFile'].includes(this.rules.parser.node(body).kind)) { return; }
        this.statement(body);
        for(let at = 0; at < this.blocks.length; at++) {
            const block = this.block(at); if(!block.reachable) { continue; }
            for(let event = 0; event < block.events.length; event++) {
                const index = block.events[event] ?? -1; const node = this.rules.parser.node(index);
                if(node.kind !== 'ReturnStatement' || node.children.length > 0 || this.exempt(index)) { continue; }
                const enclosing = this.enclosing(index);
                if(block.events.slice(event + 1).some((later) => this.executes(later, enclosing)) || this.after(at, enclosing, []) || this.required(index)) { continue; }
                const start = this.rules.start(node); const finding = new Diagnostic('no-useless-return', 'unnecessaryReturn',
                    'This `return` ends the function at a point where the function was going to end anyway, so it changes nothing and only adds a line the next reader has to check for a reason. Delete it.',
                    this.rules.byte(start), this.rules.byte(node.end), '');
                const parent = this.rules.parents[index] ?? -1;
                const text = this.rules.scanner.text.slice(start, node.end);
                if(parent >= 0 && ['Block', 'SourceFile', 'ModuleBlock', 'CaseClause', 'DefaultClause'].includes(this.rules.parser.node(parent).kind) &&
                    !text.includes('/*') && !text.includes('//')) { finding.fixStart = finding.start; finding.fixEnd = finding.end; }
                this.rules.findings.push(finding);
            }
        }
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            if(this.helper.scope(index) || this.rules.parser.node(index).kind === 'SourceFile') {
                const returns: number[] = []; this.collect(index, returns);
                if(returns.some((child) => this.rules.parser.node(child).children.length === 0)) { this.judge(index); }
            }
        }
    }
}
