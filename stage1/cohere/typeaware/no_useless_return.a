import { panic } from 'adamic';
import type { Rules } from './rules.ts';
import type { Types } from './types.ts';
import type { TypeFact } from './type_fact.ts';
import { Returns } from './returns.ts';
import { Shadow } from './shadow.ts';
import { Diagnostic } from './diagnostic.ts';
import { promisedShape } from './promised_shape.a';

// Statement events and edges use numeric indices, retaining the unreachable
// continuation after an abrupt exit exactly as cohere's graph does.
export class ReturnBlock {
    readonly events: number[] = [];
    readonly successors: number[] = [];
    incoming = false;
    reachable = false;
}
export class ReturnTry {
    caught: number;
    final: number;
    position = 0;
    forked = false;
    returned = false;
    thrown = false;
    constructor(caught: number, final: number) { this.caught = caught; this.final = final; }
}
export class NoUselessReturn {
    readonly rules: Rules;
    readonly helper: Returns;
    readonly blocks: ReturnBlock[] = [];
    readonly tries: ReturnTry[] = [];
    readonly jumpNodes: number[] = [];
    readonly breakBlocks: number[] = [];
    readonly continueBlocks: number[] = [];
    current = 0;
    root = 0;
    constructor(rules: Rules) { this.rules = rules; this.helper = new Returns(rules, new Shadow(rules)); }
    block(index: number): ReturnBlock { return this.blocks[index] ?? panic('missing return block'); }
    make(): number { this.blocks.push(new ReturnBlock()); return this.blocks.length - 1; }
    link(from: number, to: number): void {
        if(from < 0 || to < 0) { return; }
        this.block(from).successors.push(to);
        if(this.block(from).reachable) { this.block(to).incoming = true; }
    }
    enter(index: number): void { this.current = index; this.block(index).reachable = this.block(index).incoming; }
    dead(): void { const next = this.make(); this.block(this.current).successors.push(next); this.current = next; }
    handler(returning: boolean): number {
