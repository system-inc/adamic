        if(node.kind === 'IfStatement') {
            const after = this.make(); const yes = this.make(); const no = node.children.length > 2 ? this.make() : after;
            this.expression(node.children[0] ?? -1); this.link(this.current, yes); this.link(this.current, no);
            this.enter(yes); this.statement(node.children[1] ?? -1); this.link(this.current, after);
            if(node.children.length > 2) { this.enter(no); this.statement(node.children[2] ?? -1); this.link(this.current, after); }
