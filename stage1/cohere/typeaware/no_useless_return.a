            const frame = this.tries[at] ?? panic('missing return try');
            if(returning ? frame.final >= 0 : frame.position === 0 || frame.final >= 0) { return at; }
        }
        return -1;
    }
    target(frame: ReturnTry): number { return frame.position === 0 && frame.caught >= 0 ? frame.caught : frame.final; }
    fork(): void {
