        const at = this.handler(false); if(at < 0) { return; }
        const frame = this.tries[at] ?? panic('missing throwable try');
        if(frame.forked) { return; }
        frame.forked = true; frame.thrown = true; this.link(this.current, this.target(frame));
        const next = this.make(); this.link(this.current, next); this.enter(next);
    }
    expression(index: number): void {
        if(index < 0) { return; }
        const node = this.rules.parser.node(index);
        if(this.helper.scope(index) || ['ClassStaticBlockDeclaration', 'PropertyDeclaration'].includes(node.kind)) { return; }
        if(node.kind === 'ConditionalExpression') {
            this.expression(node.children[0] ?? -1);
            const from = this.current; const join = this.make(); const yes = this.make(); const no = this.make();
            this.link(from, yes); this.enter(yes); this.expression(node.children[2] ?? -1); this.link(this.current, join);
            this.link(from, no); this.enter(no); this.expression(node.children[4] ?? -1); this.link(this.current, join); this.enter(join); return;
        }
        if(node.kind === 'BinaryExpression' && ['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken',
            'AmpersandAmpersandEqualsToken', 'BarBarEqualsToken', 'QuestionQuestionEqualsToken'].includes(this.rules.parser.node(node.children[1] ?? -1).kind)) {
            this.expression(node.children[0] ?? -1);
            const join = this.make(); const right = this.make(); this.link(this.current, join); this.link(this.current, right);
            this.enter(right); this.expression(node.children[2] ?? -1); this.link(this.current, join); this.enter(join); return;
        }
        if(node.kind === 'YieldExpression') {
            for(const child of node.children) { this.expression(child); }
            this.route(true); this.route(false);
            const next = this.make(); this.link(this.current, next); this.enter(next); return;
        }
        for(const child of node.children) { this.expression(child); }
