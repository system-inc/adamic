import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
import type { SyntaxProjection } from './syntax_projection.a';
import { ProcessSymbols } from './process_symbol_details.a';
const objectMessage = 'This throws something that cannot be an Error, so whatever catches it gets no message and no stack trace. The failure then surfaces as a bare string or object with no record of where it came from, which is the difference between reading one line and reading the whole call path. Throw `new Error(...)` instead.';
const undefinedMessage = 'This throws `undefined`, which reaches the handler carrying nothing at all: no message, no stack, no type. It is almost always an expression that was meant to produce an error and did not. Throw `new Error(...)` instead.';
export class NoThrowLiteral {
    readonly rules: Rules; readonly syntax: SyntaxProjection; readonly symbols: ProcessSymbols;
    constructor(rules: Rules, syntax: SyntaxProjection) { this.rules = rules; this.syntax = syntax; this.symbols = new ProcessSymbols(syntax); }
    possible(index: number): boolean {
        if(index === 0) { return false; } const node = this.syntax.node(index);
        if(['Identifier', 'CallExpression', 'NewExpression', 'PropertyAccessExpression', 'ElementAccessExpression', 'TaggedTemplateExpression', 'YieldExpression', 'AwaitExpression'].includes(node.kind)) { return true; }
        if(node.kind === 'BinaryExpression') {
            if(['EqualsToken', 'AmpersandAmpersandEqualsToken', 'AmpersandAmpersandToken', 'CommaToken'].includes(node.operator)) { return this.possible(node.children[2] ?? 0); }
            if(['BarBarEqualsToken', 'QuestionQuestionEqualsToken', 'BarBarToken', 'QuestionQuestionToken'].includes(node.operator)) { return this.possible(node.children[0] ?? 0) || this.possible(node.children[2] ?? 0); }
        }
        return node.kind === 'ConditionalExpression' && (this.possible(node.children[2] ?? 0) || this.possible(node.children[4] ?? 0));
    }
    run(): void {
        for(let at = 1; at <= this.syntax.nodes.length; at++) { const node = this.syntax.node(at); if(node.kind !== 'ThrowStatement' || node.expression === 0) { continue; }
            let id = ''; if(!this.possible(node.expression)) { id = 'object'; }
            else { const argument = this.syntax.node(node.expression); if(argument.kind === 'Identifier' && argument.text === 'undefined' && !this.symbols.get(node.expression).declarations.some((declaration) => !declaration.declarationFile)) { id = 'undef'; } }
            if(id !== '') { this.rules.findings.push(new Diagnostic('no-throw-literal', id, id === 'object' ? objectMessage : undefinedMessage, node.start, node.end, '')); }
        }
    }
}
