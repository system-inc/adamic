import type { Rules } from './rules.ts';
import { Diagnostic } from './diagnostic.ts';
import { ambientName } from './wave16_facts.a';
// Numeric SyntaxKind values from the pinned Go parser, for the incoming kind-indexed driver.
// ThrowStatement = 258.
export function listenerKinds(): readonly number[] {
    return [258];
}

export class NoThrowLiteral {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    could(index: number): boolean {
        if(index < 0) return false;
        const node = this.rules.parser.node(index);
        if(
            [
                'Identifier',
                'CallExpression',
                'NewExpression',
                'PropertyAccessExpression',
                'ElementAccessExpression',
                'TaggedTemplateExpression',
                'YieldExpression',
                'AwaitExpression',
            ].includes(node.kind)
        )
            return true;
        if(node.kind === 'BinaryExpression') {
            const op = this.rules.parser.node(node.children[1] ?? -1).kind;
            if(['EqualsToken', 'AmpersandAmpersandEqualsToken', 'AmpersandAmpersandToken', 'CommaToken'].includes(op))
                return this.could(node.children[2] ?? -1);
            if(
                ['BarBarEqualsToken', 'QuestionQuestionEqualsToken', 'BarBarToken', 'QuestionQuestionToken'].includes(
                    op,
                )
            )
                return this.could(node.children[0] ?? -1) || this.could(node.children[2] ?? -1);
        }
        if(node.kind === 'ConditionalExpression')
            return this.could(node.children[2] ?? -1) || this.could(node.children[4] ?? -1);
        return false;
    }
    run(): void {
        for(let i = 0; i < this.rules.parser.nodes.length; i++) {
            const node = this.rules.parser.node(i);
            if(node.kind !== 'ThrowStatement' || (this.rules.parents[i] ?? -1) < 0) continue;
            const index = node.children[0] ?? -1;
            if(index < 0) continue;
            const argument = this.rules.parser.node(index);
            let id = '';
            if(!this.could(index)) id = 'object';
            else if(
                argument.kind === 'Identifier' &&
                argument.text === 'undefined' &&
                ambientName(this.rules, index, true, true)
            )
                id = 'undef';
            if(id === '') continue;
            const message =
                id === 'undef'
                    ? 'This throws `undefined`, which reaches the handler carrying nothing at all: no message, no stack, no type. It is almost always an expression that was meant to produce an error and did not. Throw `new Error(...)` instead.'
                    : 'This throws something that cannot be an Error, so whatever catches it gets no message and no stack trace. The failure then surfaces as a bare string or object with no record of where it came from, which is the difference between reading one line and reading the whole call path. Throw `new Error(...)` instead.';
            this.rules.findings.push(
                new Diagnostic(
                    'no-throw-literal',
                    id,
                    message,
                    this.rules.byte(this.rules.start(node)),
                    this.rules.byte(node.end),
                    '',
                ),
            );
        }
    }
}
