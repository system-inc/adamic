import type { Rules } from '../rules.ts';
import { Frames, header } from '../frames.ts';
export class Ancestor {
    readonly kind: string; readonly name: string; readonly start: number; readonly end: number;
    readonly flags: number; readonly global: boolean;
    constructor(frames: Frames) {
        this.kind = frames.field(); this.name = frames.field(); this.start = frames.natural();
        this.end = frames.natural(); this.flags = frames.natural(); this.global = frames.yes();
    }
}
export class Origin {
    readonly path: string; readonly declaration: boolean; readonly library: boolean; readonly external: boolean;
    readonly ancestors: Ancestor[] = [];
    constructor(frames: Frames) {
        this.path = frames.field(); this.declaration = frames.yes(); this.library = frames.yes(); this.external = frames.yes();
        const count = frames.natural();
        for(let at = 0; at < count; at++) { this.ancestors.push(new Ancestor(frames)); }
    }
    kind(at: number): string { return this.ancestors[at]?.kind ?? ''; }
    name(at: number): string { return this.ancestors[at]?.name ?? ''; }
    global(at: number): boolean { return this.ancestors[at]?.global ?? false; }
}
export class Provenance {
    readonly identity: number; readonly flags: number; readonly declarations: Origin[] = [];
    constructor(rules: Rules, index: number, alias = false) {
        const question = alias ? 'symbol-provenance-alias' : 'symbol-provenance';
        const frames = new Frames(rules.ask(index, question)); header(frames, question);
        this.identity = frames.natural(); this.flags = frames.natural(); const count = frames.natural();
        for(let at = 0; at < count; at++) { this.declarations.push(new Origin(frames)); }
        frames.end();
    }
    library(): boolean { return this.declarations.length > 0 && this.declarations.some((item) => item.library); }
    member(owner: string): boolean {
        return this.declarations.length > 0 && this.declarations.every((item) => item.library && item.kind(1) === 'InterfaceDeclaration' && item.name(1) === owner);
    }
    globalTimer(): boolean {
        return this.declarations.length > 0 && this.declarations.every((item) => item.declaration &&
            ((item.kind(1) === 'SourceFile' && !item.external) ||
            (item.kind(1) === 'ModuleBlock' && item.global(2)) ||
            (item.kind(1) === 'InterfaceDeclaration' && item.name(1) === 'WindowOrWorkerGlobalScope' && item.library)));
    }
    globalVariable(): boolean {
        return this.declarations.length > 0 && this.declarations.every((item) => item.declaration && item.kind(0) === 'VariableDeclaration' &&
            item.kind(1) === 'VariableDeclarationList' && item.kind(2) === 'VariableStatement' &&
            ((item.kind(3) === 'SourceFile' && !item.external) || (item.kind(3) === 'ModuleBlock' && item.global(4))));
    }
    processMember(): boolean {
        return this.declarations.length > 0 && this.declarations.every((item) => item.declaration &&
            ['MethodSignature', 'PropertySignature'].includes(item.kind(0)) && item.kind(1) === 'InterfaceDeclaration' &&
            item.name(1) === 'Process' && item.kind(2) === 'ModuleBlock' && item.kind(3) === 'ModuleDeclaration' && item.name(3) === 'NodeJS');
    }
}
