import { panic, readTextFile } from 'adamic';
import { Rules } from '../rules.ts';
import { UnaryMinus, byteOffsets } from '../unary_minus.ts';
import { Parser } from '../../../typescript/parser/parser.ts';
import { Scanner } from '../../../typescript/scanner/scanner.ts';
import type { Origin } from './symbol_provenance.a';
export class Modules {
    readonly initial: Rules; readonly units = new Map<string, Rules>();
    constructor(rules: Rules) { this.initial = rules; this.units.set(rules.path, rules); }
    unit(path: string): Rules {
        const known = this.units.get(path); if(known !== undefined) { return known; }
        const source = readTextFile(path); if(source.kind === 'Error') { panic(source.message); }
        const parser = new Parser(source.text, path); const scanner = new Scanner(source.text); const offsets = byteOffsets(source.text);
        const unary = new UnaryMinus(this.initial.program, path, parser, scanner, offsets);
        const rules = new Rules(this.initial.program, path, parser, scanner, offsets, unary); const root = parser.file();
        for(let at = 0; at < parser.nodes.length; at++) { rules.parents.push(-1); }
        rules.links(root, -1); this.units.set(path, rules); return rules;
    }
    index(path: string, kind: string, start: number, end: number): number {
        const rules = this.unit(path);
        return rules.parser.nodes.findIndex((node) => node.kind === kind && rules.byte(node.pos) === start && rules.byte(node.end) === end);
    }
    declaration(origin: Origin): number {
        const node = origin.ancestors[0];
        return node !== undefined ? this.index(origin.path, node.kind, node.start, node.end) : -1;
    }
}
