import { Scanner } from '../../../typescript/scanner/scanner.ts';
import { node as atNode, skip } from './shape.a';
import { panic } from 'adamic';
import type { Rules } from '../rules.ts';
import { Bindings } from '../bindings.ts';
export class PathEvent {
    readonly node: number; readonly kind: number;
    constructor(node: number, kind: number) { this.node = node; this.kind = kind; }
}
export class PathBlock {
    readonly events: PathEvent[] = []; readonly successors: number[] = [];
}
export class JumpScope {
    readonly node: number; readonly exit: number; readonly next: number; readonly labels: readonly string[];
    constructor(node: number, exit: number, next: number, labels: readonly string[]) {
        this.node = node; this.exit = exit; this.next = next; this.labels = labels;
    }
}
// Syntax-only paths. Checker classifications and write/block judgments remain
// outside this builder, so the same paths serve both exit rules.
export class PathGraph {
    readonly rules: Rules; readonly bindings: Bindings; readonly blocks: PathBlock[] = [];
    readonly jumps: JumpScope[] = []; readonly catches: number[] = []; readonly catchTries: number[] = []; readonly finalizers: number[] = [];
    readonly recorded: number[] = []; current = 0;
    constructor(rules: Rules, root: number) {
        this.rules = rules; this.bindings = new Bindings(rules); this.fresh();
        const node = atNode(rules, root);
