        else {
            for(const parameter of node.children.filter((child) => atNode(rules, child).kind === 'Parameter')) { this.expression(parameter); }
            const body = node.children[node.children.length - 1] ?? -1;
            if(atNode(rules, body).kind === 'Block') { this.statement(body); }
            else { this.expression(body); }
        }
    }
    root(index: number): boolean {
        const node = atNode(this.rules, index);
        return this.bindings.functionKind(node.kind) || ['SourceFile', 'ClassStaticBlockDeclaration'].includes(node.kind) ||
            (node.kind === 'PropertyDeclaration' && node.children.length > 1);
    }
    owner(index: number): number {
        let at = this.bindings.parent(index);
        while(at >= 0 && !this.root(at)) { at = this.bindings.parent(at); }
        return at;
    }
    fresh(): number { this.blocks.push(new PathBlock()); return this.blocks.length - 1; }
    block(index: number): PathBlock { return this.blocks[index] ?? panic('invalid path block'); }
    link(from: number, to: number): void {
        if(from >= 0 && to >= 0 && !this.block(from).successors.includes(to)) { this.block(from).successors.push(to); }
    }
    emit(index: number, kind = 0): void {
        if(this.current < 0) { return; }
        this.block(this.current).events.push(new PathEvent(index, kind));
        if(!this.recorded.includes(index)) { this.recorded.push(index); }
    }
    forkThrow(): void {
        if(this.current >= 0 && this.catches.length > 0) {
            const next = this.fresh(); this.link(this.current, this.catches[this.catches.length - 1] ?? -1);
            this.link(this.current, next); this.current = next;
        }
    }
    condition(index: number, yes: number, no: number): void {
        const actual = skip(this.rules, index); const node = atNode(this.rules, actual);
        if(node.kind === 'PrefixUnaryExpression' && node.operator === 'ExclamationToken') { this.condition(node.children[0] ?? -1, no, yes); return; }
        if(node.kind === 'BinaryExpression') {
            const operator = atNode(this.rules, node.children[1] ?? -1).kind;
            if(['AmpersandAmpersandToken', 'BarBarToken'].includes(operator)) {
                const right = this.fresh();
                this.condition(node.children[0] ?? -1, operator === 'AmpersandAmpersandToken' ? right : yes, operator === 'AmpersandAmpersandToken' ? no : right);
                this.current = right; this.condition(node.children[2] ?? -1, yes, no); return;
            }
        }
        if(node.kind === 'ConditionalExpression') {
            const left = this.fresh(); const right = this.fresh(); this.condition(node.children[0] ?? -1, left, right);
            this.current = left; this.condition(node.children[2] ?? -1, yes, no);
            this.current = right; this.condition(node.children[4] ?? -1, yes, no); return;
        }
        this.expression(actual); this.link(this.current, yes); this.link(this.current, no); this.current = -1;
    }
    expression(index: number): void {
        if(index < 0) { return; }
        if(this.current < 0) { this.current = this.fresh(); }
        const node = atNode(this.rules, index);
        if(this.root(index)) { return; }
        this.emit(index);
        if(['CallExpression', 'NewExpression', 'PropertyAccessExpression', 'ElementAccessExpression', 'Identifier', 'AwaitExpression'].includes(node.kind)) { this.forkThrow(); }
        if(node.kind === 'ConditionalExpression') {
            const yes = this.fresh(); const no = this.fresh(); const end = this.fresh();
            this.condition(node.children[0] ?? -1, yes, no);
            this.current = yes; this.expression(node.children[2] ?? -1); this.link(this.current, end);
            this.current = no; this.expression(node.children[4] ?? -1); this.link(this.current, end); this.current = end; return;
        }
        if(node.kind === 'BinaryExpression' && ['AmpersandAmpersandToken', 'BarBarToken', 'QuestionQuestionToken'].includes(atNode(this.rules, node.children[1] ?? -1).kind)) {
            this.expression(node.children[0] ?? -1); const end = this.fresh(); const right = this.fresh();
            this.link(this.current, end); this.link(this.current, right); this.current = right; this.expression(node.children[2] ?? -1);
            this.link(this.current, end); this.current = end; return;
        }
        if(['ClassDeclaration', 'ClassExpression'].includes(node.kind)) { return; }
        for(const child of node.children) { this.expression(child); }
    }
    labels(index: number): string[] {
        const result: string[] = []; let at = this.bindings.parent(index);
        while(atNode(this.rules, at).kind === 'LabeledStatement') {
            result.push(atNode(this.rules, atNode(this.rules, at).children[0] ?? -1).text); at = this.bindings.parent(at);
        }
        return result;
    }
    jump(index: number, continuing: boolean): void {
        const node = atNode(this.rules, index); const label = atNode(this.rules, node.children[0] ?? -1).text;
        for(let at = this.jumps.length - 1; at >= 0; at--) {
            const scope = this.jumps[at]; if(scope === undefined) { continue; }
            if(label !== '' && !scope.labels.includes(label)) { continue; }
            if(continuing && scope.next < 0) { continue; }
            // The production graph links jumps directly to their target; its
            // break/finally omission is preserved for diagnostic parity.
            this.link(this.current, continuing ? scope.next : scope.exit); this.current = -1; return;
        }
        this.current = -1;
    }
    truthy(index: number): boolean {
        const node = atNode(this.rules, skip(this.rules, index));
        if(['TrueKeyword', 'RegularExpressionLiteral'].includes(node.kind)) { return true; }
        if(node.kind === 'StringLiteral') { return node.text !== ''; }
        if(node.kind === 'NumericLiteral') {
            let digits = node.text.replaceAll('_', '').toLowerCase();
            if(digits.startsWith('0x') || digits.startsWith('0b') || digits.startsWith('0o')) { digits = digits.slice(2); }
            else { const exponent = digits.indexOf('e'); if(exponent >= 0) { digits = digits.slice(0, exponent); } }
            return digits.split('').some((digit) => digit !== '0' && digit !== '.');
        }
        if(node.kind === 'BigIntLiteral') { const digits = node.text.replaceAll('_', '').replaceAll('n', '').replaceAll('x', '').replaceAll('b', '').replaceAll('o', ''); return digits.split('').some((digit) => digit !== '0'); }
        return false;
    }
    loop(index: number): void {
        const node = atNode(this.rules, index); const body = node.children[node.children.length - 1] ?? -1;
        const test = this.fresh(); const run = this.fresh(); const end = this.fresh(); const increment = this.fresh();
        const labels = this.labels(index); this.jumps.push(new JumpScope(index, end, increment, labels));
        let condition = -1; let update = -1;
        if(node.kind === 'WhileStatement') { condition = node.children[0] ?? -1; }
        else if(node.kind === 'DoStatement') { condition = node.children[node.children.length - 1] ?? -1; }
        else if(node.kind === 'ForStatement') {
            // Scan separators outside the parsed header expressions, so comments,
            // strings, regexes and nested function bodies cannot supply them.
            const scanner = new Scanner(this.rules.scanner.text); scanner.pos = this.rules.start(node);
            const headers = node.children.slice(0, -1); const semicolons: number[] = [];
            while(scanner.pos < atNode(this.rules, body).pos && semicolons.length < 2) {
                const kind = scanner.scan();
                const child = headers.find((part) => atNode(this.rules, part).pos <= scanner.start && scanner.start < atNode(this.rules, part).end) ?? -1;
                if(child >= 0) { scanner.pos = atNode(this.rules, child).end; continue; }
                if(kind === 'SemicolonToken') { semicolons.push(scanner.start); }
                if(kind === 'EndOfFile') { break; }
            }
            const first = semicolons[0] ?? panic('missing first for separator'); const second = semicolons[1] ?? panic('missing second for separator');
            for(const child of node.children.slice(0, -1)) {
                const item = atNode(this.rules, child);
                if(item.end <= first) { this.expression(child); }
                else if(item.pos < second) { condition = child; }
                else { update = child; }
            }
        }
        else { for(const child of node.children.slice(0, -1)) { this.expression(child); } }
        if(node.kind === 'DoStatement') { this.link(this.current, run); }
        else { this.link(this.current, test); }
        this.current = test;
        if(condition >= 0) { this.expression(condition); }
        this.link(this.current, run);
        if((condition >= 0 && !this.truthy(condition)) || ['ForOfStatement', 'ForInStatement'].includes(node.kind)) { this.link(this.current, end); }
        this.current = run; this.statement(node.kind === 'DoStatement' ? node.children[0] ?? -1 : body); this.link(this.current, increment);
        this.current = increment; if(update >= 0) { this.expression(update); } this.link(this.current, test);
        this.jumps.pop(); this.current = end;
    }
    statement(index: number): void {
        if(index < 0) { return; }
        if(this.current < 0) { this.current = this.fresh(); }
        const node = atNode(this.rules, index);
        if(this.bindings.functionKind(node.kind)) { return; }
        this.emit(index, 2);
        if(node.kind === 'Block' || node.kind === 'SourceFile') { for(const child of node.children) { this.statement(child); } return; }
        if(node.kind === 'IfStatement') {
            const yes = this.fresh(); const no = this.fresh(); const end = this.fresh();
            this.condition(node.children[0] ?? -1, yes, no);
            this.current = yes; this.statement(node.children[1] ?? -1); this.link(this.current, end);
            this.current = no; this.statement(node.children[2] ?? -1); this.link(this.current, end); this.current = end; return;
        }
        if(['WhileStatement', 'DoStatement', 'ForStatement', 'ForInStatement', 'ForOfStatement'].includes(node.kind)) { this.loop(index); return; }
        if(node.kind === 'BreakStatement' || node.kind === 'ContinueStatement') { this.jump(index, node.kind === 'ContinueStatement'); return; }
        if(node.kind === 'LabeledStatement') {
            const child = node.children[1] ?? -1; const kind = atNode(this.rules, child).kind;
            if(['WhileStatement', 'DoStatement', 'ForStatement', 'ForInStatement', 'ForOfStatement', 'SwitchStatement'].includes(kind)) { this.statement(child); return; }
            const end = this.fresh(); this.jumps.push(new JumpScope(index, end, -1, [atNode(this.rules, node.children[0] ?? -1).text]));
            this.statement(child); this.link(this.current, end); this.jumps.pop(); this.current = end; return;
        }
        if(node.kind === 'SwitchStatement') {
            this.expression(node.children[0] ?? -1); const begin = this.current; const end = this.fresh();
            this.jumps.push(new JumpScope(index, end, -1, this.labels(index)));
            const cases = atNode(this.rules, node.children[1] ?? -1).children; let previous = -1; let defaulted = false;
            for(const clause of cases) {
                const entry = this.fresh(); this.link(begin, entry); this.link(previous, entry); this.current = entry;
                const arm = atNode(this.rules, clause); if(arm.kind === 'DefaultClause') { defaulted = true; }
                for(const part of arm.children) { this.statement(part); } previous = this.current;
            }
            this.link(previous, end); if(!defaulted) { this.link(begin, end); } this.jumps.pop(); this.current = end; return;
        }
        if(node.kind === 'TryStatement') {
            const handler = node.children.find((child) => atNode(this.rules, child).kind === 'CatchClause') ?? -1;
            const last = node.children[node.children.length - 1] ?? -1;
            const final = last !== handler && last !== node.children[0] ? last : -1;
            const catchBlock = handler < 0 ? -1 : this.fresh(); const end = this.fresh();
            if(catchBlock >= 0) { this.catches.push(catchBlock); this.catchTries.push(index); }
            if(final >= 0) { this.finalizers.push(final); }
            this.statement(node.children[0] ?? -1); const normal = this.current;
            if(catchBlock >= 0) { this.link(normal, catchBlock); this.catches.pop(); this.catchTries.pop(); }
            if(final >= 0) { this.finalizers.pop(); }
            if(final >= 0) { this.statement(final); }
            this.link(this.current, end);
            if(catchBlock >= 0) {
                this.current = catchBlock; this.emit(index, 1);
                if(final >= 0) { this.finalizers.push(final); }
                const clause = atNode(this.rules, handler); this.statement(clause.children[clause.children.length - 1] ?? -1);
                if(final >= 0) { this.finalizers.pop(); this.statement(final); } this.link(this.current, end);
            }
            this.current = end; return;
        }
        if(node.kind === 'ReturnStatement' || node.kind === 'ThrowStatement') {
            for(const child of node.children) { this.expression(child); }
            const caught = node.kind === 'ThrowStatement' && this.catches.length > 0;
            const target = caught ? this.catchTries[this.catchTries.length - 1] ?? -1 : -1;
            const pending = this.finalizers.slice(); this.finalizers.splice(0, this.finalizers.length);
            for(let at = pending.length - 1; at >= 0; at--) {
                const final = pending[at] ?? -1; const owner = this.bindings.parent(final);
                if(!caught || (owner !== target && this.bindings.contains(target, owner))) { this.statement(final); }
            }
            for(const final of pending) { this.finalizers.push(final); }
            if(caught) { this.forkThrow(); }
            this.current = -1; return;
        }
        this.expression(index);
    }
}
