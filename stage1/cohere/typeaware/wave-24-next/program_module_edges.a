import type { Rules } from '../rules.ts';
import { Frames, header } from '../frames.ts';
export class ModuleEdges {
    readonly edges = new Map<string, string[]>(); readonly imported = new Set<string>();
    readonly canBlock = new Set<string>(); readonly declarations = new Set<string>();
    constructor(rules: Rules, root: number) {
        const frames = new Frames(rules.ask(root, 'program-module-edges')); header(frames, 'program-module-edges');
        const count = frames.natural();
        for(let at = 0; at < count; at++) {
            const path = frames.field(); const declaration = frames.yes(); const computed = frames.yes(); const length = frames.natural();
            if(declaration) { this.declarations.add(path); }
            if(computed || path.endsWith('/source/system/StandardStreams.ts') || path.endsWith('/source/system/StandardStreams.d.ts')) { this.canBlock.add(path); }
            const edges: string[] = [];
            for(let to = 0; to < length; to++) { const target = frames.field(); edges.push(target); this.imported.add(target); }
            this.edges.set(path, edges);
        }
        frames.end();
        let changed = true;
        while(changed) {
            changed = false;
            for(const path of this.edges.keys()) {
                const targets: string[] = this.edges.get(path) ?? [];
                if(!this.canBlock.has(path) && targets.some((target) => this.canBlock.has(target))) { this.canBlock.add(path); changed = true; }
            }
        }
    }
}
