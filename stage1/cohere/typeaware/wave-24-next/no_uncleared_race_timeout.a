import { node as atNode, skip } from './shape.a';
import type { Rules } from '../rules.ts';
import { Bindings } from '../bindings.ts';
import { Shadow } from '../shadow.ts';
import { Diagnostic } from '../diagnostic.ts';
import { Provenance } from './symbol_provenance.a';
const message = 'This `setTimeout` arms the losing side of a `Promise.race`, and its handle is thrown away, so nothing can ever clear it. When the work wins the race, the timer stays armed for its whole duration: in Node it holds the process open (a batch that finished its last item sits until the timeout elapses), and its callback still runs, rejecting a promise nobody is waiting on. Keep the handle (`timer = setTimeout(...)`) and `clearTimeout(timer)` in a `finally` around the race.';
// Pinned parser SyntaxKind values for the forthcoming kind-indexed driver.
export const noUnclearedRaceTimeoutSyntaxKinds: string[] = ["CallExpression"];
export class NoUnclearedRaceTimeout {
    readonly rules: Rules; readonly bindings: Bindings; readonly shape: Shadow;
    constructor(rules: Rules, bindings: Bindings, shape: Shadow) { this.rules = rules; this.bindings = bindings; this.shape = shape; }
    outer(index: number): number {
        let at = index;
        while(atNode(this.rules, this.bindings.parent(at)).kind === 'ParenthesizedExpression') { at = this.bindings.parent(at); }
        return at;
    }
    plainTarget(index: number): boolean {
        const outer = this.outer(index); const parent = atNode(this.rules, this.bindings.parent(outer));
        return parent.kind === 'BinaryExpression' && parent.children[0] === outer && atNode(this.rules, parent.children[1] ?? -1).kind === 'EqualsToken';
    }
    neverRead(index: number): boolean {
        const origin = new Provenance(this.rules, index);
        if(origin.declarations.length !== 1) { return false; }
        const declaration = origin.declarations[0];
        if(declaration === undefined || declaration.path !== this.rules.path || declaration.kind(0) !== 'VariableDeclaration') { return false; }
        const declared = this.bindings.declarations(index)[0] ?? -1;
        const name = this.shape.name(declared);
        if(name < 0) { return false; }
        const text = atNode(this.rules, name).text;
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = atNode(this.rules, at);
            if((this.rules.parents[at] ?? -1) < 0 || at === name || node.kind !== 'Identifier' || node.text !== text) { continue; }
            if(new Provenance(this.rules, at).identity === origin.identity && !this.plainTarget(at)) { return false; }
        }
        return true;
    }
    lost(executor: number, call: number): boolean {
        const outer = this.outer(call); const parentIndex = this.bindings.parent(outer); const parent = atNode(this.rules, parentIndex);
        if(['ExpressionStatement', 'VoidExpression'].includes(parent.kind) || parentIndex === executor) { return true; }
        if(parent.kind === 'VariableDeclaration' && this.shape.initializer(parentIndex) === outer) {
            const name = this.shape.name(parentIndex);
            return atNode(this.rules, name).kind === 'Identifier' && this.neverRead(name);
        }
        if(parent.kind === 'BinaryExpression' && parent.children[2] === outer && atNode(this.rules, parent.children[1] ?? -1).kind === 'EqualsToken') {
            const target = skip(this.rules, parent.children[0] ?? -1);
            return atNode(this.rules, target).kind === 'Identifier' &&
                atNode(this.rules, this.bindings.parent(this.outer(parentIndex))).kind === 'ExpressionStatement' && this.neverRead(target);
        }
        return false;
    }
    timer(call: number): boolean {
        const expression = skip(this.rules, atNode(this.rules, call).children[0] ?? -1); const callee = atNode(this.rules, expression);
        let name = expression;
        if(callee.kind === 'PropertyAccessExpression') {
            const receiver = atNode(this.rules, skip(this.rules, callee.children[0] ?? -1));
            if(receiver.kind !== 'Identifier' || !['globalThis', 'window'].includes(receiver.text)) { return false; }
            name = callee.children[callee.children.length - 1] ?? -1;
        }
        else if(callee.kind !== 'Identifier') { return false; }
        return atNode(this.rules, name).text === 'setTimeout' && new Provenance(this.rules, name).globalTimer();
    }
    visit(index: number, executor: number): void {
        const node = atNode(this.rules, index);
        if(this.bindings.functionKind(node.kind) || ['ClassDeclaration', 'ClassExpression'].includes(node.kind)) { return; }
        if(node.kind === 'CallExpression' && this.timer(index) && this.lost(executor, index)) {
            this.rules.findings.push(new Diagnostic('correctness-no-uncleared-race-timeout', 'unclearedRaceTimeout', message,
                this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), 'nexus/'));
        }
        for(const child of node.children) { this.visit(child, executor); }
    }
    promise(index: number): number {
        let element = skip(this.rules, index);
        if(atNode(this.rules, element).kind === 'Identifier') {
            const declarations = new Provenance(this.rules, element).declarations;
            const declaration = declarations[0];
            if(declarations.length !== 1 || declaration === undefined || declaration.path !== this.rules.path || declaration.kind(0) !== 'VariableDeclaration' ||
                declaration.kind(1) !== 'VariableDeclarationList' || ((declaration.ancestors[1]?.flags ?? 0) & 2) === 0) { return -1; }
            const local = this.bindings.declarations(element)[0] ?? -1;
            const initializer = this.shape.initializer(local);
            if(initializer < 0) { return -1; }
            element = skip(this.rules, initializer);
        }
        const node = atNode(this.rules, element);
        if(node.kind !== 'NewExpression') { return -1; }
        const name = skip(this.rules, node.children[0] ?? -1); const constructor = atNode(this.rules, name);
        if(constructor.kind !== 'Identifier' || constructor.text !== 'Promise' || !new Provenance(this.rules, name).library()) { return -1; }
        return element;
    }
    run(): void {
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const call = atNode(this.rules, at);
            if((this.rules.parents[at] ?? -1) < 0 || call.kind !== 'CallExpression') { continue; }
            const callee = atNode(this.rules, skip(this.rules, call.children[0] ?? -1));
            if(callee.kind !== 'PropertyAccessExpression') { continue; }
            const name = callee.children[callee.children.length - 1] ?? -1;
            if(atNode(this.rules, name).text !== 'race' || !new Provenance(this.rules, name).member('PromiseConstructor')) { continue; }
            const args = call.children.slice(call.children.length - call.list);
            if(args.length === 0) { continue; }
            const array = atNode(this.rules, skip(this.rules, args[0] ?? -1));
            if(array.kind !== 'ArrayLiteralExpression') { continue; }
            for(const item of array.children) {
                const promise = this.promise(item);
                if(promise < 0) { continue; }
                const construction = atNode(this.rules, promise);
                const parameters = construction.children.slice(construction.children.length - construction.list);
                if(parameters.length === 0) { continue; }
                const executor = skip(this.rules, parameters[0] ?? -1); const fn = atNode(this.rules, executor);
                if(!['ArrowFunction', 'FunctionExpression'].includes(fn.kind)) { continue; }
                this.visit(fn.children[fn.children.length - 1] ?? -1, executor);
            }
        }
    }
}
