import { node as atNode, skip } from './shape.a';
import type { Rules } from '../rules.ts';
import { Diagnostic } from '../diagnostic.ts';
import { Bindings } from '../bindings.ts';
import { Provenance, Origin } from './symbol_provenance.a';
import { Modules } from './modules.a';
import { ModuleEdges } from './program_module_edges.a';
import { NoProcessExitAfterOutput } from './no_process_exit_after_output.a';
import { PathGraph } from './path_graph.a';
// Pinned parser SyntaxKind values for the forthcoming kind-indexed driver.
export const requireBlockingStandardStreamsSyntaxKinds: string[] = ["SourceFile"];
export class RequireBlockingStandardStreams {
    readonly rules: Rules; readonly modules: Modules; readonly bindings: Bindings;
    readonly path: NoProcessExitAfterOutput; readonly functionState = new Map<string, number>();
    constructor(rules: Rules, modules: Modules, bindings: Bindings, path: NoProcessExitAfterOutput) {
        this.rules = rules; this.modules = modules; this.bindings = bindings; this.path = path;
    }
    callLike(rules: Rules, index: number): boolean { return ['CallExpression', 'NewExpression', 'TaggedTemplateExpression'].includes(atNode(rules, index).kind); }
    functionLike(rules: Rules, index: number): boolean { return this.bindings.functionKind(atNode(rules, index).kind); }
    arguments(rules: Rules, index: number): number[] {
        const node = atNode(rules, index);
        return ['CallExpression', 'NewExpression'].includes(node.kind) ? node.children.slice(node.children.length - node.list) : [];
    }
    declarationMayBlock(origin: Origin, name: string, graph: ModuleEdges): boolean {
        if(!graph.canBlock.has(origin.path)) { return origin.declaration && name === 'require'; }
        if(origin.declaration || (origin.kind(0) === 'FunctionDeclaration' && origin.name(0) === 'blockStandardStreams' &&
            (origin.path.endsWith('/source/system/StandardStreams.ts') || origin.path.endsWith('/source/system/StandardStreams.d.ts')))) { return true; }
        const rules = this.modules.unit(origin.path); const index = this.modules.declaration(origin); const node = atNode(rules, index);
        const body = node.children[node.children.length - 1] ?? -1;
        if(['FunctionDeclaration', 'MethodDeclaration', 'Constructor', 'GetAccessor', 'SetAccessor'].includes(node.kind)) {
            if(atNode(rules, body).kind !== 'Block') { return node.kind !== 'FunctionDeclaration' || ((origin.ancestors[0]?.flags ?? 0) & 8388608) !== 0; }
            return this.functionMayBlock(rules, index, graph);
        }
        if(node.kind === 'VariableDeclaration') {
            const init = skip(rules, body);
            if(['FunctionExpression', 'ArrowFunction'].includes(atNode(rules, init).kind)) { return this.functionMayBlock(rules, init, graph); }
        }
        if(['ClassDeclaration', 'ClassExpression'].includes(node.kind)) { return this.functionMayBlock(rules, index, graph); }
        return true;
    }
    symbolMayBlock(rules: Rules, index: number, graph: ModuleEdges): boolean {
        const symbol = new Provenance(rules, index, true);
        if(symbol.identity === 0 || symbol.declarations.length === 0) { return true; }
        const name = atNode(rules, index).text;
        return symbol.declarations.some((origin) => this.declarationMayBlock(origin, name, graph));
    }
    handsOnMayBlock(rules: Rules, index: number, graph: ModuleEdges): boolean {
        const argument = skip(rules, index); const node = atNode(rules, argument);
        if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) { return this.functionMayBlock(rules, argument, graph); }
        if(node.kind !== 'Identifier' || (new Provenance(rules, argument, true).flags & 16) === 0) { return false; }
        return this.symbolMayBlock(rules, argument, graph);
    }
    callMayBlock(rules: Rules, index: number, graph: ModuleEdges): boolean {
        const call = atNode(rules, index); const calleeIndex = skip(rules, call.children[0] ?? -1); const callee = atNode(rules, calleeIndex);
        if(call.kind === 'CallExpression' && callee.kind === 'ImportKeyword') { return true; }
        if(this.arguments(rules, index).some((arg) => this.handsOnMayBlock(rules, arg, graph))) { return true; }
        if(['FunctionExpression', 'ArrowFunction'].includes(callee.kind)) { return this.functionMayBlock(rules, calleeIndex, graph); }
        if(callee.kind === 'Identifier') { return this.symbolMayBlock(rules, calleeIndex, graph); }
        if(callee.kind === 'PropertyAccessExpression') { return this.symbolMayBlock(rules, callee.children[callee.children.length - 1] ?? -1, graph); }
        return true;
    }
    bodyMayBlock(rules: Rules, index: number, graph: ModuleEdges, skipFunctions: boolean): boolean {
        if(skipFunctions && this.functionLike(rules, index)) { return false; }
        if(this.callLike(rules, index) && this.callMayBlock(rules, index, graph)) { return true; }
        return atNode(rules, index).children.some((child) => this.bodyMayBlock(rules, child, graph, skipFunctions));
    }
    functionMayBlock(rules: Rules, index: number, graph: ModuleEdges): boolean {
        const key = `${rules.path}:${index}`; const known = this.functionState.get(key) ?? 0;
        if(known !== 0) { return known === 1; }
        this.functionState.set(key, 3);
        const result = atNode(rules, index).children.some((child) => this.bodyMayBlock(rules, child, graph, false));
        this.functionState.set(key, result ? 1 : 2); return result;
    }
    importsBlock(graph: ModuleEdges): boolean {
        const queue = [this.rules.path]; const seen = new Set<string>(queue);
        for(let at = 0; at < queue.length; at++) {
            const targets: string[] = graph.edges.get(queue[at] ?? '') ?? [];
            for(const path of targets) {
                if(seen.has(path)) { continue; } seen.add(path); queue.push(path);
                if(!graph.canBlock.has(path)) { continue; }
                if(graph.declarations.has(path)) { return true; }
                const rules = this.modules.unit(path); const root = rules.parser.nodes.findIndex((node) => node.kind === 'SourceFile');
                if(atNode(rules, root).children.some((child) => this.bodyMayBlock(rules, child, graph, true))) { return true; }
            }
        }
        return false;
    }
    localFunction(index: number): number {
        const actual = skip(this.rules, index); const node = atNode(this.rules, actual);
        if(['FunctionExpression', 'ArrowFunction'].includes(node.kind)) { return actual; }
        if(node.kind !== 'Identifier') { return -1; }
        const symbol = new Provenance(this.rules, actual);
        for(const origin of symbol.declarations) {
            if(origin.path !== this.rules.path) { continue; }
            const declaration = this.modules.declaration(origin); const declared = atNode(this.rules, declaration);
            if(declared.kind === 'FunctionDeclaration' && atNode(this.rules, declared.children[declared.children.length - 1] ?? -1).kind === 'Block') { return declaration; }
            if(declared.kind === 'VariableDeclaration' && origin.kind(1) === 'VariableDeclarationList' && ((origin.ancestors[1]?.flags ?? 0) & 2) !== 0) {
                const initializer = skip(this.rules, declared.children[declared.children.length - 1] ?? -1);
                if(['FunctionExpression', 'ArrowFunction'].includes(atNode(this.rules, initializer).kind)) { return initializer; }
            }
        }
        return -1;
    }
    argumentBlocks(index: number, graph: ModuleEdges): boolean {
        if(this.functionLike(this.rules, index)) { return false; }
        if(atNode(this.rules, index).kind === 'AwaitExpression' || (this.callLike(this.rules, index) && this.callMayBlock(this.rules, index, graph))) { return true; }
        return atNode(this.rules, index).children.some((child) => this.argumentBlocks(child, graph));
    }
    argumentsMayBlock(index: number, graph: ModuleEdges): boolean {
        return this.arguments(this.rules, index).some((argument) => this.argumentBlocks(argument, graph));
    }
    inRun(index: number, root: number): boolean {
        let at = this.bindings.parent(index);
        while(at >= 0 && at !== root) { if(this.functionLike(this.rules, at)) { return false; } at = this.bindings.parent(at); }
        return at === root;
    }
    run(): void {
        if(!this.rules.scanner.text.includes('exit')) { return; }
        const rootsExit = new Set<number>(); const rootsWrite = new Set<number>();
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            if((this.rules.parents[at] ?? -1) < 0) { continue; }
            if(this.path.symbols.exit(at)) { rootsExit.add(this.path.owner(at)); }
            else if(this.path.symbols.write(at)) { rootsWrite.add(this.path.owner(at)); }
        }
        if(!this.rules.parser.nodes.some((_node, root) => rootsExit.has(root) && rootsWrite.has(root))) { return; }
        const sourceRoot = this.rules.parser.nodes.findIndex((node) => node.kind === 'SourceFile');
        const graph = new ModuleEdges(this.rules, sourceRoot); const shebang = this.rules.scanner.text.startsWith('#!');
        if(!shebang && graph.imported.has(this.rules.path)) { return; }
        const ordered = graph.canBlock.has(this.rules.path);
        if(ordered && this.importsBlock(graph)) { return; }
        const starts = new Map<number, number[]>(); const blocks: number[] = [];
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = atNode(this.rules, at);
            if((this.rules.parents[at] ?? -1) < 0) { continue; }
            if(ordered && node.kind === 'AwaitExpression') { blocks.push(at); }
            if(ordered && ((node.kind === 'ForOfStatement' && node.children.some((child) => atNode(this.rules, child).kind === 'AwaitKeyword')) ||
                (node.kind === 'VariableStatement' && node.children.some((child) => atNode(this.rules, child).kind === 'VariableDeclarationList' && atNode(this.rules, child).semantic === '6')))) { blocks.push(at); }
            if(!this.callLike(this.rules, at)) { continue; }
            const functions: number[] = [];
            if(['CallExpression', 'TaggedTemplateExpression'].includes(node.kind)) {
                const callee = this.localFunction(node.children[0] ?? -1);
                const generator = callee >= 0 && atNode(this.rules, callee).children.some((child) => atNode(this.rules, child).kind === 'AsteriskToken');
                if(callee >= 0 && (!generator || !ordered) && (!ordered || !this.argumentsMayBlock(at, graph))) { functions.push(callee); }
            }
            if(!ordered) { for(const argument of this.arguments(this.rules, at)) { const fn = this.localFunction(argument); if(fn >= 0) { functions.push(fn); } } }
            if(functions.length > 0) { starts.set(at, functions); }
            if(ordered && this.callMayBlock(this.rules, at, graph)) { blocks.push(at); }
        }
        const queue = [sourceRoot]; const seen = new Set<number>(queue); const exits: number[] = [];
        for(let cursor = 0; cursor < queue.length; cursor++) {
            const root = queue[cursor] ?? -1; const started: number[] = [];
            if(ordered) {
                const recorded = new PathGraph(this.rules, root).recorded;
                if(blocks.some((index) => this.inRun(index, root) && (!recorded.includes(index) || this.path.catchBinding(index, root)))) { continue; }
            }
            for(const exit of this.path.walk(root, true, blocks, starts, started)) { if(!exits.includes(exit)) { exits.push(exit); } }
            for(const fn of started) { if(!seen.has(fn)) { seen.add(fn); queue.push(fn); } }
        }
        if(exits.length === 0) { return; }
        exits.sort((left, right) => atNode(this.rules, left).pos - atNode(this.rules, right).pos);
        const reason = shebang ? 'it starts with `#!`' : 'nothing in the program imports it';
        const count = exits.length === 1 ? '' : `, the first of ${exits.length} such exits in this file`;
        const message = `This file runs as a process (${reason}), and this \`process.exit()\` runs after a write to stdout or stderr before the process has called \`blockStandardStreams()\`${count}. Node writes to a pipe asynchronously, and \`process.exit()\` does not wait: a reader piping this process gets the output cut off (measured: 65,536 of 1 MiB), with exit status 0 and no error. Call Nexus's \`blockStandardStreams()\` (\`source/system/StandardStreams\`) before anything that can exit: first in the module, or first in the main it runs.`;
        const node = atNode(this.rules, exits[0] ?? -1);
        this.rules.findings.push(new Diagnostic('correctness-require-blocking-standard-streams', 'exitBeforeBlockingStandardStreams', message,
            this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), 'nexus/'));
    }
}
