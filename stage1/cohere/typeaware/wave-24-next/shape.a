import { panic } from 'adamic';
import type { Rules } from '../rules.ts';
import { ParseNode } from '../../../typescript/parser/nodes.ts';
const absent = new ParseNode('Absent', 0, 0, []);
// -1 is the parser's explicit absent-child marker. Other invalid indices still
// refuse through Parser.node rather than becoming an empty syntax node.
export function node(rules: Rules, index: number): ParseNode {
    return index === -1 ? absent : rules.parser.node(index);
}
export function skip(rules: Rules, index: number): number {
    return index === -1 ? -1 : rules.skip(index);
}
