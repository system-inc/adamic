import { node as atNode, skip } from './shape.a';
import type { Rules } from '../rules.ts';
import { Diagnostic } from '../diagnostic.ts';
import { Bindings } from '../bindings.ts';
import { PathGraph } from './path_graph.a';
import { ExitSymbols } from './exit_symbols.a';
import { Modules } from './modules.a';
const message = 'This calls `process.exit()` on a path that has already written to stdout or stderr in this function. `process.exit()` ends the process without waiting for writes still in flight, and a write to a pipe can be one: a reader piping this command (`| grep`, `execSync`, a spawned child) gets the output cut at 64 KB, with exit status 0 and no error. Set `process.exitCode = n` and return instead, so the process ends on its own once the output has drained.';
export class PathPosition {
    readonly block: number; readonly state: readonly string[];
    constructor(block: number, state: readonly string[]) { this.block = block; this.state = state; }
}
export class NoProcessExitAfterOutput {
    readonly rules: Rules; readonly bindings: Bindings; readonly symbols: ExitSymbols;
    constructor(rules: Rules, bindings: Bindings, symbols: ExitSymbols) { this.rules = rules; this.bindings = bindings; this.symbols = symbols; }
    owner(index: number): number {
        let at = this.bindings.parent(index);
        while(at >= 0) {
            if(this.symbols.nested(at) || atNode(this.rules, at).kind === 'SourceFile') { return at; }
            at = this.bindings.parent(at);
        }
        return -1;
    }
    catchBinding(index: number, root: number): boolean {
        let previous = index; let at = this.bindings.parent(index);
        while(at >= 0 && at !== root) {
            const node = atNode(this.rules, at);
            if(node.kind === 'CatchClause' && node.children[0] === previous && atNode(this.rules, previous).kind === 'VariableDeclaration') { return true; }
            previous = at; at = this.bindings.parent(at);
        }
        return false;
    }
    chain(index: number, root: number): string {
        const tries: number[] = []; let previous = index; let at = this.bindings.parent(index);
        while(at >= 0 && at !== root) {
            const node = atNode(this.rules, at);
            if(node.kind === 'TryStatement' && node.children[0] === previous && node.children.some((child) => atNode(this.rules, child).kind === 'CatchClause')) { tries.push(at); }
            previous = at; at = this.bindings.parent(at);
        }
        tries.sort((left, right) => left - right); return ',' + tries.map((item) => `${item}`).join(',') + (tries.length === 0 ? '' : ',');
    }
    contains(outer: string, inner: string): boolean { return inner.split(',').filter((part) => part !== '').every((part) => outer.includes(',' + part + ',')); }
    with(state: readonly string[], chain: string): string[] {
        if(state.some((held) => this.contains(chain, held))) { return state.slice(); }
        const result = state.filter((held) => !this.contains(held, chain)); result.push(chain); result.sort((left, right) => left < right ? -1 : left > right ? 1 : 0); return result;
    }
    walk(root: number, direct = false, blockAt: readonly number[] = [], starts = new Map<number, number[]>(), started: number[] = []): number[] {
        const graph = new PathGraph(this.rules, root); const exits: number[] = [];
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            if(this.symbols.exit(at) && this.owner(at) === root && (!graph.recorded.includes(at) || this.catchBinding(at, root))) { return []; }
        }
        const queue = [new PathPosition(0, [])]; const seen = new Set<string>(['0:']); const found: number[] = [];
        for(let cursor = 0; cursor < queue.length; cursor++) {
            const position = queue[cursor]; if(position === undefined) { continue; }
            let state = position.state.slice(); let ended = false;
            for(const event of graph.block(position.block).events) {
                if(event.kind === 1) { state = state.filter((chain) => !chain.includes(`,${event.node},`)); continue; }
                if(event.kind === 2) { if(blockAt.includes(event.node)) { ended = true; break; } continue; }
                if(this.catchBinding(event.node, root)) { continue; }
                if(this.symbols.exit(event.node)) {
                    if(state.length > 0 && !found.includes(event.node)) { found.push(event.node); }
                    ended = true; break;
                }
                const write = direct ? this.symbols.write(event.node) : this.symbols.followedWrite(event.node);
                if(write && !this.symbols.holdsExit(event.node)) { state = this.with(state, this.chain(event.node, root)); }
                const functions: number[] = starts.get(event.node) ?? [];
                for(const fn of functions) { if(!started.includes(fn)) { started.push(fn); } }
                if(blockAt.includes(event.node)) { ended = true; break; }
            }
            if(ended) { continue; }
            for(const next of graph.block(position.block).successors) {
                const key = `${next}:${state.join('|')}`;
                if(!seen.has(key)) { seen.add(key); queue.push(new PathPosition(next, state)); }
            }
        }
        for(const index of found) { exits.push(index); } return exits;
    }
    run(): void {
        const roots: number[] = [];
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            if((this.rules.parents[at] ?? -1) >= 0 && this.symbols.exit(at)) {
                const root = this.owner(at); if(root >= 0 && !roots.includes(root)) { roots.push(root); }
            }
        }
        for(const root of roots) {
            for(const index of this.walk(root)) {
                const node = atNode(this.rules, index);
                this.rules.findings.push(new Diagnostic('correctness-no-process-exit-after-output', 'exitAfterOutput', message,
                    this.rules.byte(this.rules.start(node)), this.rules.byte(node.end), 'nexus/'));
            }
        }
    }
}
