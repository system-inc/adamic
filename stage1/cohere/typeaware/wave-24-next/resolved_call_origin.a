import type { Rules } from '../rules.ts';
import { Frames, header } from '../frames.ts';
export class CallOrigin {
    readonly returnFlags: number; readonly present: boolean;
    path = ''; kind = ''; start = 0; end = 0; external = false; functionFlags = 0; body = false;
    constructor(rules: Rules, index: number) {
        const frames = new Frames(rules.ask(index, 'resolved-call-origin')); header(frames, 'resolved-call-origin');
        this.returnFlags = frames.natural(); this.present = frames.yes();
        if(this.present) {
            this.path = frames.field(); this.kind = frames.field(); this.start = frames.natural(); this.end = frames.natural();
            this.external = frames.yes(); this.functionFlags = frames.natural(); this.body = frames.yes();
        }
        frames.end();
    }
}
