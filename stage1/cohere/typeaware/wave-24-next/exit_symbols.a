import { node as atNode, skip } from './shape.a';
import type { Rules } from '../rules.ts';
import { Bindings } from '../bindings.ts';
import { Provenance } from './symbol_provenance.a';
import { CallOrigin } from './resolved_call_origin.a';
import { Modules } from './modules.a';
export class ExitSymbols {
    readonly rules: Rules; readonly bindings: Bindings; readonly modules: Modules;
    readonly exits = new Map<number, boolean>(); readonly writes = new Map<number, boolean>();
    constructor(rules: Rules, modules: Modules, bindings: Bindings) { this.rules = rules; this.bindings = bindings; this.modules = modules; }
    member(index: number): number {
        const node = atNode(this.rules, skip(this.rules, index));
        if(node.kind === 'Identifier') { return skip(this.rules, index); }
        if(node.kind === 'PropertyAccessExpression') { return node.children[node.children.length - 1] ?? -1; }
        return -1;
    }
    exit(index: number): boolean {
        const known = this.exits.get(index); if(known !== undefined) { return known; }
        const node = atNode(this.rules, index); const name = this.member(node.children[0] ?? -1);
        const result = node.kind === 'CallExpression' && name >= 0 && atNode(this.rules, name).text === 'exit' && new Provenance(this.rules, name, true).processMember();
        this.exits.set(index, result); return result;
    }
    write(index: number): boolean {
        const known = this.writes.get(index); if(known !== undefined) { return known; }
        const node = atNode(this.rules, index);
        if(node.kind !== 'CallExpression') { return false; }
        const callee = atNode(this.rules, skip(this.rules, node.children[0] ?? -1));
        if(!['PropertyAccessExpression', 'ElementAccessExpression'].includes(callee.kind)) { this.writes.set(index, false); return false; }
        const key = atNode(this.rules, skip(this.rules, callee.children[callee.children.length - 1] ?? -1));
        const name = ['Identifier', 'StringLiteral', 'NoSubstitutionTemplateLiteral'].includes(key.kind) ? key.text : '';
        const receiver = skip(this.rules, callee.children[0] ?? -1); const base = atNode(this.rules, receiver);
        let result = false;
        if(['log', 'info', 'debug', 'warn', 'error', 'trace', 'table', 'dir', 'dirxml'].includes(name) && base.kind === 'Identifier' && base.text === 'console') {
            result = new Provenance(this.rules, receiver).globalVariable();
        }
        if(name === 'write') {
            const stream = this.member(receiver);
            result = stream >= 0 && ['stdout', 'stderr'].includes(atNode(this.rules, stream).text) && new Provenance(this.rules, stream, true).processMember();
        }
        this.writes.set(index, result); return result;
    }
    nested(index: number): boolean {
        const node = atNode(this.rules, index);
        return this.bindings.functionKind(node.kind) || node.kind === 'ClassStaticBlockDeclaration' || (node.kind === 'PropertyDeclaration' && node.children.length > 1);
    }
    holdsExit(index: number): boolean {
        for(const child of atNode(this.rules, index).children) {
            if(this.nested(child)) { continue; }
            if(this.exit(child) || this.holdsExit(child)) { return true; }
        }
        return false;
    }
    bodyEvents(index: number, writes: number[], exits: number[]): void {
        if(this.nested(index)) { return; }
        if(this.exit(index)) { exits.push(index); }
        if(this.write(index)) { writes.push(index); }
        for(const child of atNode(this.rules, index).children) { this.bodyEvents(child, writes, exits); }
    }
    followedWrite(index: number): boolean {
        if(this.write(index)) { return true; }
        const call = atNode(this.rules, index);
        if(call.kind !== 'CallExpression') { return false; }
        const origin = new CallOrigin(this.rules, index);
        if(!origin.present || !origin.body || !['FunctionDeclaration', 'FunctionExpression', 'ArrowFunction', 'MethodDeclaration'].includes(origin.kind) ||
            (origin.path !== this.rules.path && !origin.external) || (origin.functionFlags & 1) !== 0 || (origin.returnFlags & 262144) !== 0) { return false; }
        let outer = index;
        while(atNode(this.rules, this.bindings.parent(outer)).kind === 'ParenthesizedExpression') { outer = this.bindings.parent(outer); }
        if((origin.functionFlags & 2) !== 0 && atNode(this.rules, this.bindings.parent(outer)).kind !== 'AwaitExpression') { return false; }
        const local = this.modules.index(origin.path, origin.kind, origin.start, origin.end);
        if(local < 0) { return false; }
        const unit = this.modules.unit(origin.path); const node = atNode(unit, local);
        const bindings = new Bindings(unit);
        const symbols = origin.path === this.rules.path ? this : new ExitSymbols(unit, this.modules, bindings);
        const writes: number[] = []; const exits: number[] = [];
        symbols.bodyEvents(node.children[node.children.length - 1] ?? -1, writes, exits);
        return writes.length > 0 && exits.length === 0;
    }
}
