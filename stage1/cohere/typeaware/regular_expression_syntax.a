import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';
export function validPattern(rules: Rules, index: number, pattern: string): boolean {
    const frames = new Frames(rules.ask(index, `regular-expression-syntax\n${pattern}`));
    header(frames, 'regular-expression-syntax');
    const valid = frames.yes();
    frames.end();
    return valid;
}
