import type { Rules } from './rules.ts';
import { types } from './facts.ts';
import { typeSymbol, nodeSymbol } from './library_declarations.a';
import { Frames, header } from './frames.ts';
import { Diagnostic } from './diagnostic.ts';
import { stringLike, numberLike, bigintLike, booleanLike, nullish } from './flags.ts';

const allCollections = ['Map', 'ReadonlyMap', 'Set', 'ReadonlySet', 'WeakMap', 'WeakSet'];
const sizedCollections = ['Map', 'ReadonlyMap', 'Set', 'ReadonlySet'];
const typedArrays = [
    'Int8Array',
    'Uint8Array',
    'Uint8ClampedArray',
    'Int16Array',
    'Uint16Array',
    'Int32Array',
    'Uint32Array',
    'Float16Array',
    'Float32Array',
    'Float64Array',
    'BigInt64Array',
    'BigUint64Array',
];
const inMessage =
    'This uses `in` to look for a value in an array. `in` asks whether the array has a property or index of that name, never whether it holds that element, and this name is neither, so the test is always false. Use `.includes()` for membership.';
const sizeMessage =
    'This compares a `.length` or `.size` against a value it can never be on the other side of. A length or size is never negative, so the comparison has the same answer every time: always false (`< 0`, `=== -1`) or always true (`>= 0`, `!== -1`). Compare against `0` for empty, or `> 0` for not empty.';
const bracketMessage =
    "This reads or writes a Map or Set with brackets. Brackets reach the object's own properties, not its entries, so a read finds nothing that `.set()` or `.add()` stored and a write stores nothing `.get()` or `.has()` will see. Use `.get()`, `.set()`, `.has()` or `.add()`.";
const objectMessage =
    "This hands a Map or Set to an `Object` method that lists own properties. Entries are not properties, so the result is always empty. Use the collection's own `.keys()`, `.values()` or `.entries()`, or `Array.from(...)` around one of them.";

export class NoCollectionMisuse {
    readonly rules: Rules;
    constructor(rules: Rules) {
        this.rules = rules;
    }
    library(index: number, id: number, names: readonly string[]): boolean {
        const symbol = typeSymbol(this.rules, index, id);
        return (
            symbol.present &&
            names.includes(symbol.name) &&
            symbol.declarations.some((declaration) => declaration.defaultLibrary)
        );
    }
    collection(index: number, names: readonly string[]): boolean {
        const facts = types(this.rules.ask(index, 'type-shape'), 'type-shape');
        return facts.present && facts.parts(facts.root()).every((id) => this.library(index, id, names));
    }
    property(index: number, id: number, name: string): boolean {
        return types(this.rules.ask(index, `property-shape\n${id}\n${name}`), 'property-shape').present;
    }
    literal(index: number, id: number): string {
        const frames = new Frames(this.rules.ask(index, `literal-value\n${id}`));
        header(frames, 'literal-value');
        const kind = frames.field();
        const value = frames.field();
        frames.end();
        return kind === 'string' ? value : '';
    }
    arrayIndex(name: string): boolean {
        if(name === '') {
            return false;
        }
        const value = Number.parseFloat(name);
        return Number.isInteger(value) && value >= 0 && value < 4294967295 && value.toString() === name;
    }
    inArray(left: number, right: number): boolean {
        const arrays = types(this.rules.ask(right, 'type-shape'), 'type-shape');
        if(
            !arrays.present ||
            !arrays.parts(arrays.root()).every((id) => arrays.type(id).array || arrays.type(id).tuple >= 0)
        ) {
            return false;
        }
        const names = types(this.rules.ask(left, 'type-shape'), 'type-shape');
        if(!names.present) {
            return false;
        }
        for(const id of names.parts(names.root())) {
            if((names.type(id).flags & 1024) === 0) {
                return false;
            }
            const name = this.literal(left, id);
            if(this.arrayIndex(name) || arrays.parts(arrays.root()).some((part) => this.property(right, part, name))) {
                return false;
            }
        }
        return true;
    }
    size(index: number): boolean {
        const node = this.rules.parser.node(this.rules.skip(index));
        if(node.kind !== 'PropertyAccessExpression') {
            return false;
        }
        const member = this.rules.parser.node(node.children[node.children.length - 1] ?? -1);
        if(member.kind !== 'Identifier') {
            return false;
        }
        const receiver = node.children[0] ?? -1;
        const facts = types(this.rules.ask(receiver, 'type-shape'), 'type-shape');
        if(!facts.present) {
            return false;
        }
        if(member.text === 'length') {
            return facts
                .parts(facts.root())
                .every(
                    (id) =>
                        facts.type(id).array ||
                        facts.type(id).tuple >= 0 ||
                        (facts.type(id).flags & stringLike) !== 0 ||
                        this.library(receiver, id, typedArrays),
                );
        }
        return (
            member.text === 'size' &&
            facts.parts(facts.root()).every((id) => this.library(receiver, id, sizedCollections))
        );
    }
    numeric(index: number): number {
        let node = this.rules.parser.node(this.rules.skip(index));
        let sign = 1;
        if(node.kind === 'PrefixUnaryExpression') {
            if(node.operator !== 'MinusToken') {
                return NaN;
            }
            sign = -1;
            node = this.rules.parser.node(this.rules.skip(node.children[0] ?? -1));
        }
        return node.kind === 'NumericLiteral' ? sign * Number.parseFloat(node.text) : NaN;
    }
    mirror(operator: string): string {
        if(operator === 'LessThanToken') {
            return 'GreaterThanToken';
        }
        if(operator === 'GreaterThanToken') {
            return 'LessThanToken';
        }
        if(operator === 'LessThanEqualsToken') {
            return 'GreaterThanEqualsToken';
        }
        if(operator === 'GreaterThanEqualsToken') {
            return 'LessThanEqualsToken';
        }
        return operator;
    }
    decided(operator: string, value: number): boolean {
        if(['LessThanToken', 'GreaterThanEqualsToken'].includes(operator)) {
            return value <= 0;
        }
        return (
            [
                'LessThanEqualsToken',
                'GreaterThanToken',
                'EqualsEqualsEqualsToken',
                'EqualsEqualsToken',
                'ExclamationEqualsEqualsToken',
                'ExclamationEqualsToken',
            ].includes(operator) && value < 0
        );
    }
    missingKey(collection: number, key: number): boolean {
        const keys = types(this.rules.ask(key, 'raw-shape'), 'raw-shape');
        if(!keys.present) {
            return false;
        }
        const facts = types(this.rules.ask(collection, 'type-shape'), 'type-shape');
        for(const id of keys.parts(keys.root())) {
            const flags = keys.type(id).flags;
            if((flags & 1024) !== 0) {
                const name = this.literal(key, id);
                if(facts.parts(facts.root()).some((part) => this.property(collection, part, name))) {
                    return false;
                }
            }
            else if((flags & (numberLike | booleanLike | bigintLike | nullish)) === 0) {
                return false;
            }
        }
        return true;
    }
    objectMethod(index: number): boolean {
        const call = this.rules.parser.node(index);
        const callee = this.rules.parser.node(this.rules.skip(call.children[0] ?? -1));
        if(callee.kind !== 'PropertyAccessExpression') {
            return false;
        }
        const name = callee.children[callee.children.length - 1] ?? -1;
        const member = this.rules.parser.node(name);
        const receiver = this.rules.skip(callee.children[0] ?? -1);
        const object = this.rules.parser.node(receiver);
        const argument = call.list > 0 ? (call.children[call.children.length - call.list] ?? -1) : -1;
        if(
            argument < 0 ||
            member.kind !== 'Identifier' ||
            !['keys', 'values', 'entries', 'getOwnPropertyNames'].includes(member.text) ||
            object.kind !== 'Identifier' ||
            object.text !== 'Object'
        ) {
            return false;
        }
        return (
            nodeSymbol(this.rules, receiver).declarations.some((declaration) => declaration.defaultLibrary) &&
            nodeSymbol(this.rules, name).declarations.some((declaration) => declaration.defaultLibrary) &&
            this.collection(argument, allCollections)
        );
    }
    report(index: number, id: string): void {
        const node = this.rules.parser.node(index);
        const message =
            id === 'inOnArray'
                ? inMessage
                : id === 'impossibleSizeComparison'
                  ? sizeMessage
                  : id === 'bracketAccessOnCollection'
                    ? bracketMessage
                    : objectMessage;
        this.rules.findings.push(
            new Diagnostic(
                'correctness-no-collection-misuse',
                id,
                message,
                this.rules.byte(this.rules.start(node)),
                this.rules.byte(node.end),
                'nexus/',
            ),
        );
    }
    run(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index);
            if(node.kind === 'BinaryExpression') {
                const left = node.children[0] ?? -1;
                const right = node.children[2] ?? -1;
                const operator = this.rules.parser.node(node.children[1] ?? -1).kind;
                if(operator === 'InKeyword') {
                    if(this.inArray(left, right)) {
                        this.report(index, 'inOnArray');
                    }
                    continue;
                }
                if(this.size(left)) {
                    if(this.decided(operator, this.numeric(right))) {
                        this.report(index, 'impossibleSizeComparison');
                    }
                }
                else if(this.size(right) && this.decided(this.mirror(operator), this.numeric(left))) {
                    this.report(index, 'impossibleSizeComparison');
                }
            }
            else if(node.kind === 'ElementAccessExpression') {
                const receiver = node.children[0] ?? -1;
                const key = node.children[node.children.length - 1] ?? -1;
                if(key >= 0 && this.collection(receiver, allCollections) && this.missingKey(receiver, key)) {
                    this.report(index, 'bracketAccessOnCollection');
                }
            }
            else if(node.kind === 'CallExpression' && this.objectMethod(index)) {
                this.report(index, 'objectMethodOnCollection');
            }
        }
    }
}
