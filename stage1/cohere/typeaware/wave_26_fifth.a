import { panic, programArguments, readTextFile, tsgoProgram, tsgoRelease } from 'adamic';
import { written } from '../../typescript/parser/nodes.ts';
import { byteOffsets } from './unary_minus.ts';
import { PreferenceStructure } from './preference_structure.a';
import { PreferenceAccess } from './preference_access.a';
import { PreferPromiseRejectErrors } from './prefer_promise_reject_errors.a';
import { PreferRegexLiterals } from './prefer_regex_literals.a';
import { PreferRestParams } from './prefer_rest_params.a';
import { RegexReference } from './regex_reference.a';
import { SourceComments } from './source_comments.a';
const args = programArguments();
const config = args[0] ?? panic('missing config');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') { panic(manifest.message); }
const paths = manifest.text.split('\n').filter((path) => path !== '');
const program = tsgoProgram(config, paths);
let findings = 0;
for(const path of paths) {
    const source = readTextFile(path);
    if(source.kind === 'Error') { panic(source.message); }
    const offsets = byteOffsets(source.text); const length = offsets[source.text.length] ?? panic('missing source length');
    const tree = new PreferenceStructure(program, path, length);
    const access = new PreferenceAccess(tree);
    new PreferPromiseRejectErrors(access).run();
    new PreferRestParams(tree).run();
    if(source.text.includes('RegExp')) {
        const references = new RegexReference(access); const comments = new SourceComments(tree, length);
        new PreferRegexLiterals(access, references, source.text, offsets, comments).run();
    }
    for(const finding of tree.findings) { finding.sortKey = finding.written(); }
    tree.findings.sort((left, right) => left.sortKey < right.sortKey ? -1 : left.sortKey > right.sortKey ? 1 : 0);
    findings += tree.findings.length;
    if(!args.includes('--count')) { console.log(`file\t${written(path)}`); for(const finding of tree.findings) { console.log(finding.written()); } }
}
console.log(`findings ${findings}`);
tsgoRelease(program);
