import { Diagnostic } from '../diagnostic.ts';
import { Suggestion } from '../suggestion.ts';
import { Repair } from '../repair.ts';
import type { OutputContext } from '../wave_13_next/output_context.a';
import { resolvesGlobal } from './global.a';
const message = 'This calls the `Object` constructor with no argument, which builds the same empty object `{}` builds, more slowly and less legibly. The constructor form also does something different from what it looks like when it is given an argument, since `Object(x)` returns `x` itself rather than a copy, so a reader has to check the argument list before knowing what the line means. Write the literal.';
const use = 'Replace with an object literal.';
const after = 'Replace with an object literal, adding the preceding semicolon that the parenthesis would otherwise swallow.';
export class NoObjectConstructor {
 readonly c: OutputContext;
 constructor(c: OutputContext) { this.c=c; }
 inner(position: number): number {
  let found=-1; const c=this.c;
  for(let at=0;at<c.rules().parser.nodes.length;at++) {
   const n=c.rules().parser.node(at);
   if(n.pos<=position && n.end>position && (found<0 || n.end-n.pos<c.rules().parser.node(found).end-c.rules().parser.node(found).pos)) { found=at; }
  } return found;
 }
 parens(index: number): boolean {
  const c=this.c; const start=c.rules().parser.node(index).pos;
  for(let at=c.parent(index);at>=0 && c.rules().parser.node(at).pos===start;at=c.parent(at)) { if(c.node(at)==='ExpressionStatement') { return true; } }
  const parent=c.parent(index); return parent>=0 && c.node(parent)==='ArrowFunction' && c.last(parent)===index;
 }
 continues(index: number): boolean {
  const c=this.c; const text=c.rules().scanner.text; let at=c.rules().start(c.rules().parser.node(index))-1;
  while(at>=0 && [' ','\t','\r','\n','\v','\f'].includes(text.slice(at,at+1))) { at--; }
  if(at<0) { return false; } const char=text.slice(at,at+1);
  if([';','{',':'].includes(char)) { return false; }
  if(char==='>') { return text.slice(at-1,at)!=='='; }
  if(char==='+' || char==='-') { return text.slice(at-1,at)!==char; }
  let node=this.inner(at);
  if(char===')') {
   for(let n=node;n>=0;n=c.parent(n)) {
    const kind=c.node(n);
    if(['DoStatement','ForStatement','ForInStatement','ForOfStatement','IfStatement','WhileStatement','WithStatement'].includes(kind)) {
     if(kind==='DoStatement') { return false; }
     let body=c.last(n); if(kind==='IfStatement') { body=c.child(n,1); const other=c.child(n,2); if(other>=0 && c.rules().start(c.rules().parser.node(other))>at) { body=other; } }
     if(body>=0 && c.rules().parser.node(body).end>at && c.rules().start(c.rules().parser.node(body))>=at) { return false; }
    }
    if(['CallExpression','NewExpression','ParenthesizedExpression','ArrowFunction','FunctionExpression','FunctionDeclaration'].includes(kind)) { return true; }
   } return true;
  }
  if(char==='}') {
   for(let n=node;n>=0;n=c.parent(n)) {
    if(c.rules().parser.node(n).end!==at+1) { continue; }
    const kind=c.node(n);
    if(['ObjectLiteralExpression','FunctionExpression','ClassExpression'].includes(kind)) { return true; }
    if(kind==='Block') { return c.parent(n)>=0 && c.node(c.parent(n))==='FunctionExpression'; }
    if(['ClassDeclaration','FunctionDeclaration','ArrowFunction','IfStatement','ForStatement','ForInStatement','ForOfStatement','WhileStatement','WithStatement','SwitchStatement','TryStatement','ModuleDeclaration','InterfaceDeclaration','EnumDeclaration'].includes(kind)) { return false; }
   } return false;
  }
  if(char==="'" || char==='"') {
   for(let n=node;n>=0;n=c.parent(n)) { if(c.rules().parser.node(n).end===at+1 && (['ImportDeclaration','ExportDeclaration'].includes(c.node(n)) || (c.parent(n)>=0 && ['ImportDeclaration','ExportDeclaration'].includes(c.node(c.parent(n)))))) { return false; } } return true;
  }
  let start=at; const alphabet='_$0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
  if(alphabet.includes(char)) {
   while(start>0 && alphabet.includes(text.slice(start-1,start))) { start--; }
   const word=text.slice(start,at+1); if(word==='else' || word==='do') { return false; }
   node=this.inner(start);
   if(node>=0 && (['StringLiteral','PrivateIdentifier'].includes(c.node(node)) || (c.node(node)==='Identifier' && c.parent(node)>=0 && c.node(c.parent(node))==='PropertyAccessExpression'))) { return true; }
   for(let n=node;n>=0;n=c.parent(n)) { if(c.node(n)==='VariableDeclaration') { return c.bindings.shape.initializer(n)>=0; } if(c.node(n)==='VariableStatement') { break; } }
   for(let n=node;n>=0;n=c.parent(n)) { if(c.rules().parser.node(n).end!==at+1) { continue; } if(['ReturnStatement','YieldExpression','BreakStatement','ContinueStatement','DebuggerStatement','ImportDeclaration','ExportDeclaration'].includes(c.node(n))) { return false; } if(c.node(n)==='LabeledStatement' && ['BreakStatement','ContinueStatement'].includes(c.node(c.last(n)))) { return false; } }
  } return true;
 }
 run(): void {
  const c=this.c; const r=c.rules();
  for(let at=0;at<r.parser.nodes.length;at++) {
   if(!['CallExpression','NewExpression'].includes(c.node(at))) { continue; }
   const callee=c.child(at,0);
   if(c.node(callee)!=='Identifier' || r.parser.node(callee).text!=='Object' || r.parser.node(at).list>0 || !resolvesGlobal(c,callee)) { continue; }
   let replacement='{}'; let id='useLiteral'; let suggestion=use;
   if(this.parens(at)) { replacement='({})'; if(this.continues(at)) { replacement=';({})'; id='useLiteralAfterSemicolon'; suggestion=after; } }
   const n=r.parser.node(at); const start=r.byte(r.start(n)); const end=r.byte(n.end);
   const finding=new Diagnostic('no-object-constructor','preferLiteral',message,start,end,'');
   finding.suggestions.push(new Suggestion(id,suggestion,[new Repair(start,end,replacement)])); r.findings.push(finding);
  }
 }
}
