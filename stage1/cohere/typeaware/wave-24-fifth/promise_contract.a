import {heritageTypes} from './heritage_types.a';
import {panic} from 'adamic';
import type {Node,Nodes} from './nodes.a';
import type {TypeFact} from '../type_fact.ts';
import type {Types} from '../types.ts';
import {types} from '../facts.ts';
import {Frames,header} from '../frames.ts';
import {GenericCallSignature} from './generic_call_signature.a';
import {typeIndex} from './type_index.a';
import {ArrayLiteralExpression, ArrowFunction, AsteriskToken, AsyncKeyword, BarBarToken, BinaryExpression, CallExpression, ClassDeclaration, ClassExpression, ComputedPropertyName, ConditionalExpression, Constructor, ExpressionWithTypeArguments, FunctionDeclaration, FunctionExpression, GetAccessor, HeritageClause, MethodDeclaration, NewExpression, ObjectLiteralExpression, Parameter, ParenthesizedExpression, PropertyAssignment, QuestionQuestionToken, ReturnStatement, SetAccessor, SpreadElement, StaticKeyword, TypeParameter} from './syntax.a';
export class Step {readonly kind:number;readonly name:string;readonly index:number;constructor(kind:number,name='',index=0){this.kind=kind;this.name=name;this.index=index;}}
export class Substitute {readonly identity:number;readonly types:number[]=[];constructor(identity:number){this.identity=identity;}}
export class PromiseContract {
 readonly nodes:Nodes;readonly subject:Node;readonly facts:TypeFact[]=[];readonly substitutions:Substitute[]=[];
 constructor(nodes:Nodes,subject:Node){this.nodes=nodes;this.subject=subject;}
 parent(node:Node):Node|undefined{const at=this.nodes.rules.parents[node.index]??-1;return at<0?undefined:this.nodes.at(at);}
 children(node:Node):Node[]{return node.original.children.map((at)=>this.nodes.at(at));}
 name(node:Node):Node|undefined{return this.children(node).find((part)=>[79,80,8,10,14,ComputedPropertyName].includes(part.kind));}
 nameText(node:Node):string|undefined{const name=this.name(node);return name===undefined||name.kind===ComputedPropertyName?undefined:name.original.text;}
 gather(graph:Types):readonly number[]{for(const item of graph.records){if(!this.facts.some((part)=>part.id===item.id)){this.facts.push(item);}}return graph.roots;}
 ask(node:Node,question:string):readonly number[]{return this.gather(types(this.nodes.ask(node,question),question.split('\n')[0]??''));}
 fact(identity:number):TypeFact{return this.facts.find((part)=>part.id===identity)??panic('missing contextual type');}
 union(identity:number):readonly number[]{const fact=this.fact(identity);return (fact.flags&134217728)!==0?fact.parts:[identity];}
 expand(identities:readonly number[]):number[]{const result:number[]=[];for(const identity of identities){for(const part of this.union(identity)){const substitute=this.substitutions.find((item)=>item.identity===part);if(substitute===undefined){result.push(part);}else{for(const standIn of substitute.types){for(const branch of this.union(standIn)){result.push(branch);}}}}}return result;}
 substitute(identity:number,type:number):void{let entry=this.substitutions.find((item)=>item.identity===identity);if(entry===undefined){entry=new Substitute(identity);this.substitutions.push(entry);}entry.types.push(type);}
 returns(identity:number):number[]{const text=this.nodes.ask(this.subject,`function-signatures\n${identity}`);const frames=new Frames(text);header(frames,'function-signatures');const count=frames.natural();const widths:number[]=[];for(let at=0;at<count;at++){const parameters=frames.natural();widths.push(parameters);for(let parameter=0;parameter<parameters;parameter++){frames.field();frames.yes();}}const mode='function-signatures';const roots=this.gather(types('1\n1'+`${mode.length}\n${mode}`+text.slice(frames.cursor),mode));const returns:number[]=[];let offset=0;for(const width of widths){returns.push(roots[offset]??panic('missing signature return'));offset+=1+width;}return returns;}
 thenable(identity:number):boolean{const frames=new Frames(this.nodes.ask(this.subject,`then-callback-signatures\n${identity}`));header(frames,'then-callback-signatures');const counts=frames.ids();frames.end();return counts.some((count)=>count>0);}
 demands(identities:readonly number[]):boolean{let signature=false;for(const identity of this.expand(identities)){for(const returned of this.returns(identity)){signature=true;for(const part of this.expand([returned])){if(!this.thenable(part)){return false;}}}}return signature;}
 step(identities:readonly number[],step:Step):number[]{const result:number[]=[];for(const identity of identities){if(step.kind===0){let roots=this.ask(this.subject,`property-shape\n${identity}\n${step.name}`);if(roots.length===0){roots=this.gather(typeIndex(this.nodes,this.subject,identity,true));}for(const root of roots){result.push(root);}}else if(step.kind===1){const fact=this.fact(identity);if(fact.tuple>=0&&!fact.array){const element=fact.arguments[step.index];if(element!==undefined){result.push(element);}}else{for(const root of this.gather(typeIndex(this.nodes,this.subject,identity))){result.push(root);}}}else{for(const root of this.returns(identity)){result.push(root);}}}return result;}
 normalReturn(node:Node):boolean{if(![FunctionExpression,ArrowFunction].includes(node.kind)){return false;}const children=this.children(node);if(children.some((part)=>[AsyncKeyword,AsteriskToken].includes(part.kind))){return false;}const before=children[children.length-(node.kind===ArrowFunction?3:2)];return before===undefined||[Parameter,TypeParameter,79].includes(before.kind);}
 generic(call:Node,argument:Node,steps:Step[]):readonly number[]|undefined{
 const children=this.children(call);const count=call.original.list;if(count<0){return undefined;}const argumentsList=children.slice(children.length-count);const index=argumentsList.findIndex((part)=>part.index===argument.index);if(index<0||argumentsList.slice(0,index).some((part)=>part.kind===SpreadElement)){return undefined;}
 // Type arguments occupy the space between the callee and argument roots.
 if(children.length>1+count){return undefined;}
 const signature=new GenericCallSignature(this.nodes,call);this.gather(signature.graph);if(!signature.present||signature.parameters.length===0){return undefined;}
 let parameter=signature.declared[index];if(signature.rest&&index>=signature.declared.length-1){const rest=signature.declared[signature.declared.length-1];if(rest===undefined){return undefined;}parameter=this.gather(typeIndex(this.nodes,this.subject,rest))[0];}if(parameter===undefined){return undefined;}
 for(let at=0;at<argumentsList.length;at++){if(at===index||at>=signature.declared.length||at>=signature.resolved.length||(signature.rest&&at>=signature.declared.length-1)){continue;}const declared=signature.declared[at]??0;const resolved=signature.resolved[at]??0;if(signature.parameters.includes(declared)){this.substitute(declared,resolved);}}
 const returned=signature.graph.roots[0]??0;if(signature.parameters.includes(returned)){for(const contextual of this.ask(call,'contextual-shape')){this.substitute(returned,contextual);}}
 let current:readonly number[]=[parameter];for(let at=steps.length-1;at>=0;at--){current=this.step(this.expand(current),steps[at]??panic('missing context step'));}return current;
 }
 genericDemand():readonly number[]|undefined{
 const steps:Step[]=[];let current=this.subject;
 if(current.kind===MethodDeclaration){const object=this.parent(current);const name=this.nameText(current);if(object===undefined||object.kind!==ObjectLiteralExpression||name===undefined){return undefined;}steps.push(new Step(0,name));current=object;}
 for(;;){let parent=this.parent(current);if(parent===undefined){return undefined;}
 switch(parent.kind){
 case 218:break;
 case 228:if(![parent.original.children[2],parent.original.children[4]].includes(current.index)){return undefined;}break;
 case 227:if(![BarBarToken,QuestionQuestionToken].includes(this.nodes.at(parent.original.children[1]??-1).kind)){return undefined;}break;
 case 303:{const name=this.nameText(parent);if(name===undefined||parent.original.children[parent.original.children.length-1]!==current.index){return undefined;}steps.push(new Step(0,name));parent=this.parent(parent);if(parent===undefined){return undefined;}break;}
 case 210:{const children=this.children(parent);const index=children.findIndex((part)=>part.index===current.index);if(index<0||children.slice(0,index).some((part)=>part.kind===SpreadElement)){return undefined;}steps.push(new Step(1,'',index));break;}
 case 254:{let containing=this.parent(parent);while(containing!==undefined&&![FunctionDeclaration,FunctionExpression,ArrowFunction,MethodDeclaration,GetAccessor,SetAccessor,Constructor].includes(containing.kind)){containing=this.parent(containing);}if(containing===undefined||!this.normalReturn(containing)){return undefined;}steps.push(new Step(2));parent=containing;break;}
 case 220:if(parent.original.children[parent.original.children.length-1]!==current.index||!this.normalReturn(parent)){return undefined;}steps.push(new Step(2));break;
 case 214:case 215:return this.generic(parent,current,steps);
 default:return undefined;
 }
 current=parent;
 }
 }
 heritage():readonly number[]{if(this.subject.kind!==MethodDeclaration||this.children(this.subject).some((part)=>part.kind===StaticKeyword)){return [];}const name=this.name(this.subject);const owner=this.parent(this.subject);if(name===undefined||name.kind!==79||owner===undefined||![ClassDeclaration,ClassExpression].includes(owner.kind)){return [];}
 for(const identity of this.gather(heritageTypes(this.nodes,owner))){const members=this.ask(this.subject,`property-shape\n${identity}\n${name.original.text}`);if(members.length>0){return members;}}return [];}

 satisfied():boolean{const generic=this.genericDemand();if(generic!==undefined){return this.demands(generic);}let roots=this.ask(this.subject,'contextual-shape');if(roots.length===0){roots=this.heritage();}return this.demands(roots);}
}
