import type {Node,Nodes} from './nodes.a';
import {Diagnostic} from '../diagnostic.ts';
export const kinds:number[]=[214];
export class SymbolDescription {
    readonly nodes:Nodes;
    constructor(nodes:Nodes){this.nodes=nodes;}
    visit(node:Node):void {
        if(node.original.list>0){return;}
        const callee=this.nodes.skip(this.nodes.at(node.original.children[0]??-1));
        if(callee.kind!==79||callee.original.text!=='Symbol'){return;}
        const declarations=this.nodes.origins(callee);
        if(declarations.length===0||declarations[0]!==true){return;}
        const rules=this.nodes.rules;
        rules.findings.push(new Diagnostic('symbol-description','expected','This creates a symbol with no description, so it prints as `Symbol()` in every stack trace, log line and debugger view, and two unrelated symbols are indistinguishable from each other. The description costs nothing and is the only label the value will ever carry. Pass one.',rules.byte(rules.start(node.original)),rules.byte(node.original.end),''));
    }
}
