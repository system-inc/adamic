import type {Node,Nodes} from './nodes.a';
import {Diagnostic} from '../diagnostic.ts';
import {Suggestion} from '../suggestion.ts';
import {Repair} from '../repair.ts';
export const kinds:number[]=[227];
export class ValidTypeof {
    readonly nodes:Nodes;
    constructor(nodes:Nodes){this.nodes=nodes;}
    visit(node:Node):void {
        const left=this.nodes.skip(this.nodes.at(node.original.children[0]??-1));
        const operator=this.nodes.at(node.original.children[1]??-1);
        if(![34,35,36,37].includes(operator.kind)){return;}
        const right=this.nodes.skip(this.nodes.at(node.original.children[2]??-1));
        if(left.kind===222){this.check(right);}
        else if(right.kind===222){this.check(left);}
    }
    check(operand:Node):void {
        const rules=this.nodes.rules;
        let message='';let suggestion=false;
        if([10,14].includes(operand.kind)){
            if(['undefined','object','boolean','number','string','function','symbol','bigint'].includes(operand.original.text)){return;}
            message='A typeof expression can only produce one of eight strings, and "'+operand.original.text+'" is not among them, so this comparison is always false and the branch behind it is dead. The eight are undefined, object, boolean, number, string, function, symbol and bigint. Almost every finding here is a typo or a guess at a type name that the language does not report: typeof null is "object", an array is "object", and there is no "array", "null" or "date".';
        }
        else if([8,9,13,105,111,96].includes(operand.kind)){
            message=this.nonString(rules.text(operand.original));
        }
        else if(operand.kind===79&&operand.original.text==='undefined'&&!this.nodes.origins(operand).includes(false)){
            message=this.nonString('undefined');suggestion=true;
        }
        else{return;}
        const start=rules.byte(rules.start(operand.original));const end=rules.byte(operand.original.end);
        const finding=new Diagnostic('valid-typeof','invalidTypeofValue',message,start,end,'');
        if(suggestion){finding.suggestions.push(new Suggestion('suggestString','Use `"undefined"` instead of `undefined`.',[new Repair(start,end,'"undefined"')]));}
        rules.findings.push(finding);
    }
    nonString(found:string):string{return 'A typeof expression always produces a string, and `'+found+'` is not one, so this comparison is always false (always true for != and !==) and the branch behind it is dead or unconditional. Compare against the string instead: `typeof value === "undefined"`, not `typeof value === undefined`.';}
}
