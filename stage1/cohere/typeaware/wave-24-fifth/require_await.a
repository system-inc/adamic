import type {Node,Nodes} from './nodes.a';
import {PromiseContract} from './promise_contract.a';
import {Diagnostic} from '../diagnostic.ts';
import {Repair} from '../repair.ts';
import {Suggestion} from '../suggestion.ts';
import {ArrowFunction, AsteriskToken, AsyncKeyword, AwaitExpression, AwaitKeyword, Block, ClassDeclaration, ClassExpression, ComputedPropertyName, Constructor, DeclareKeyword, DefaultKeyword, EqualsGreaterThanToken, ExportKeyword, ExpressionStatement, ForOfStatement, FunctionDeclaration, FunctionExpression, GetAccessor, MethodDeclaration, PropertyAssignment, PropertyDeclaration, SetAccessor, SourceFile, VariableDeclarationList, VariableStatement} from './syntax.a';
export const kinds: string[] = ["FunctionDeclaration", "FunctionExpression", "ArrowFunction", "MethodDeclaration", "GetAccessor", "SetAccessor", "Constructor"];
const functions:number[]=[FunctionDeclaration,FunctionExpression,ArrowFunction,MethodDeclaration,GetAccessor,SetAccessor,Constructor];
export class RequireAwait {
 readonly nodes:Nodes;
 constructor(nodes:Nodes){this.nodes=nodes;}
 children(node:Node):Node[]{return node.original.children.map((index)=>this.nodes.at(index));}
 parent(node:Node):Node|undefined{const index=this.nodes.rules.parents[node.index]??-1;return index<0?undefined:this.nodes.at(index);}
 name(node:Node):Node|undefined{return this.children(node).find((part)=>[79,80,8,10,14,ComputedPropertyName].includes(part.kind));}
 containsAwait(node:Node):boolean{
 if(node.kind===AwaitExpression){return true;}
 if(node.kind===ForOfStatement&&this.children(node).some((part)=>part.kind===AwaitKeyword)){return true;}
 if(node.kind===VariableDeclarationList&&(Number(node.original.semantic)&7)===6){return true;}
 if(functions.includes(node.kind)||[ClassDeclaration,ClassExpression].includes(node.kind)){return false;}
 return this.children(node).some((part)=>this.containsAwait(part));
 }
 spaces(start:number):number{const text=this.nodes.rules.scanner.text;let at=start;while(at<text.length&&[' ','\t','\n','\r'].includes(text.slice(at,at+1))){at++;}return at;}
 parameters(node:Node,start:number):number{const text=this.nodes.rules.scanner.text;const found=text.indexOf('(',start);return found>=0&&found<node.original.end?found:start;}
 headStart(node:Node):number{const rules=this.nodes.rules;let start=rules.start(node.original);for(const modifier of this.children(node)){if([ExportKeyword,DefaultKeyword,DeclareKeyword].includes(modifier.kind)){start=Math.max(start,modifier.original.end);}else{return this.spaces(start);}}return this.spaces(start);}
 description(node:Node):string{
 if(node.kind===ArrowFunction){return 'Async arrow function';}
 if(node.kind===Constructor){return "Async method 'constructor'";}
 let kind=[MethodDeclaration,GetAccessor,SetAccessor].includes(node.kind)?'method':'function';let holder=node;
 const parent=this.parent(node);if(parent!==undefined&&parent.kind===PropertyAssignment&&parent.original.children[parent.original.children.length-1]===node.index){holder=parent;kind='method';}
 const name=this.name(holder);if(name!==undefined&&name.kind!==ComputedPropertyName){return `Async ${kind} '${name.original.text}'`;}
 return `Async ${kind}`;
 }
 previous(node:Node):Node|undefined{let subject:Node|undefined=node;while(subject!==undefined){const parent=this.parent(subject);if(parent===undefined){return undefined;}if([ClassDeclaration,ClassExpression,Block,SourceFile].includes(parent.kind)){const children=this.children(parent);const position=children.findIndex((part)=>part.index===subject?.index);return position<=0?undefined:children[position-1];}subject=parent;}return undefined;}
 replacement(node:Node,asyncEnd:number):string{
 const text=this.nodes.rules.scanner.text;const next=this.spaces(asyncEnd);const rest=text.slice(next);
 let continuation=rest.startsWith('[')||rest.startsWith('(');
 for(const keyword of ['instanceof','in']){if(rest.startsWith(keyword)){const after=rest.slice(keyword.length,keyword.length+1);if(after===''||!('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$'.includes(after))){continuation=true;}}}
 if(!continuation){return '';}
 const previous=this.previous(node);if(previous===undefined){return '';}
 const lastPrevious=this.children(previous)[previous.original.children.length-1];
 const continued=[ExpressionStatement,VariableStatement].includes(previous.kind)||(previous.kind===PropertyDeclaration&&this.nodes.rules.scanner.text.slice(previous.original.pos,lastPrevious===undefined?previous.original.pos:lastPrevious.original.pos).includes('='));
 if(!continued){return '';}
 let end=previous.original.end;while(end>0&&[' ','\t','\n','\r'].includes(text.slice(end-1,end))){end--;}
 return end===0||text.slice(end-1,end)!==';'?';':'';
 }
 visit(node:Node):void{
 const children=this.children(node);const async=children.find((part)=>part.kind===AsyncKeyword);if(async===undefined||children.some((part)=>part.kind===AsteriskToken)){return;}
 const body=children[children.length-1];if(body===undefined||(node.kind!==ArrowFunction&&body.kind!==Block)){return;}
 if(body.kind===Block&&body.original.children.length===0){return;}
 if(body.kind===Block?this.children(body).some((part)=>this.containsAwait(part)):this.containsAwait(body)){return;}
 if(new PromiseContract(this.nodes,node).satisfied()){return;}
 const rules=this.nodes.rules;const parent=this.parent(node);let start=this.headStart(node);let end=start;
 if(parent!==undefined&&[PropertyAssignment,PropertyDeclaration].includes(parent.kind)){start=rules.start(parent.original);end=this.parameters(node,start);}
 else if(node.kind===ArrowFunction){const arrow=children.find((part)=>part.kind===EqualsGreaterThanToken);if(arrow!==undefined){start=rules.start(arrow.original);end=arrow.original.end;}}
 else{const name=this.name(node);end=name===undefined?this.parameters(node,start):name.original.end;if(end<=start){end=start+5;}}
 const message=this.description(node)+' has no `await` expression. The `async` keyword wraps the return value in a promise and obliges every caller to await it or handle a floating promise, so a function that never awaits pays that cost for nothing and tells the reader there is asynchrony here to find. Remove `async`, or await what this was waiting for.';
 const finding=new Diagnostic('require-await','missingAwait',message,rules.byte(start),rules.byte(end),'');
 const asyncStart=rules.start(async.original);const asyncEnd=this.spaces(async.original.end);
 finding.suggestions.push(new Suggestion('removeAsync',"Remove `async`. This changes the function's return type from a promise to the value itself, so every caller has to stop awaiting it, which is why it is offered rather than applied.",[new Repair(rules.byte(asyncStart),rules.byte(asyncEnd),this.replacement(node,asyncEnd))]));
 rules.findings.push(finding);
 }
}
