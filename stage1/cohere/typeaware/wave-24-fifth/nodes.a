import {panic} from 'adamic';
import type {Parser} from '../../../typescript/parser/parser.ts';
import type {ParseNode} from '../../../typescript/parser/nodes.ts';
import type {Rules} from '../rules.ts';
import {kindNames} from './kinds.a';
import {Frames,header} from '../frames.ts';
export class Node {
    readonly index:number; readonly kind:number; readonly original:ParseNode;
    constructor(index:number, original:ParseNode,kind:number) {this.index=index;this.original=original;this.kind=kind;}
}
export class Nodes {
    readonly all:Node[]=[];readonly rules:Rules;
    constructor(rules:Rules){this.rules=rules;const kinds=new Map<string,number>();for(let kind=0;kind<kindNames.length;kind++){const name=kindNames[kind]??'';if(name!==''){kinds.set(name,kind);}}for(let index=0;index<rules.parser.nodes.length;index++){const original=rules.parser.node(index);this.all.push(new Node(index,original,kinds.get(original.kind)??-1));}}
    at(index:number):Node{return this.all[index]??panic('missing cached node');}
    skip(node:Node):Node{let result=node;while(result.kind===218){result=this.at(result.original.children[0]??-1);}return result;}
    ask(node:Node,question:string):string{return this.rules.ask(node.index,question);}
    origins(node:Node):boolean[]{const frames=new Frames(this.ask(node,'symbol-provenance'));header(frames,'symbol-provenance');frames.natural();frames.natural();const count=frames.natural();const results:boolean[]=[];for(let index=0;index<count;index++){frames.field();results.push(frames.yes());frames.yes();frames.yes();const ancestors=frames.natural();for(let at=0;at<ancestors;at++){frames.field();frames.field();frames.natural();frames.natural();frames.natural();frames.yes();}}frames.end();return results;}
}
