        while(at >= 0) {
            const node = this.rules.parser.node(at);
            if(!['AsExpression', 'SatisfiesExpression', 'NonNullExpression', 'ParenthesizedExpression'].includes(node.kind)) { break; }
            at = node.children[0] ?? -1;
        }
