            else { return node.kind === 'CallExpression' && this.rules.parser.node(node.children[0] ?? -1).kind === 'ImportKeyword'; }
        }
        return false;
    }
    classInstance(index: number): boolean {
        if(index < 0) { return false; } const node = this.rules.parser.node(index);
        if(node.kind === 'BinaryExpression' && ['QuestionQuestionToken', 'BarBarToken'].includes(this.rules.parser.node(node.children[1] ?? -1).kind)) { return this.classInstance(node.children[0] ?? -1) || this.classInstance(node.children[2] ?? -1); }
        if(node.kind === 'NewExpression') {
            const callee = this.unwrap(node.children[0] ?? -1); if(callee < 0 || this.rules.parser.node(callee).kind !== 'Identifier' || containers.includes(this.name(callee))) { return false; }
            return !classHeritageNames(this.rules, callee).some((name) => containers.includes(name));
