            if(this.dynamic(initializer)) { return; }
            if(this.classInstance(initializer) || this.classAnnotation(index)) { if(camel) { return; } id = 'requireCamelCaseInstance'; }
            else if(exported) { if(pascal) { return; } id = camel && this.imports.unimported(this.rules.path, names) ? 'dropUnimportedExport' : 'requirePascalCaseExported'; }
            else { if(camel || this.jsx.includes(name)) { return; } id = 'requireCamelCaseLocal'; }
        }
        const suggestion = characters.recase(id === 'requirePascalCaseExported' || id === 'dropUnimportedExport');
        if((id === 'requireCamelCaseFunction' || id === 'requireCamelCaseLocal') && (characters.lowered[0] ?? '') !== (characters.characters[0] ?? '') && this.shadows(initializer, (characters.lowered[0] ?? '') + name.slice((characters.characters[0] ?? '').length))) { return; }
        const reasoning = 'const already signals immutability, so casing signals scope instead: PascalCase means the value crosses files, camelCase means this file made it.';
        let message = '';
        if(id === 'requirePascalCaseExported') { message = `Constant "${name}" is exported and should be PascalCase ("${suggestion}"). ${reasoning} A camelCase export reads local at every call site while being importable from anywhere.`; }
        else if(id === 'dropUnimportedExport') { message = `Constant "${name}" is exported, and nothing in this program imports it. Drop the \`export\`: its camelCase is already right for a file-local constant. ${reasoning} If something outside this program does import it, make it PascalCase ("${suggestion}") instead.`; }
        else if(id === 'requireCamelCaseLocal') { message = `Constant "${name}" is file-local and should be camelCase ("${suggestion}"). ${reasoning} A PascalCase local sends the reader looking for an import that is not there.`; }
        else if(id === 'requireCamelCaseFunction') { message = `Constant "${name}" holds a function and should be camelCase ("${suggestion}"), even though it is exported. A function is named for what it does and it is called, so "${suggestion}(...)" reads as an action while "${name}(...)" reads as a constructor. PascalCase is reserved for exported data and for components, which JSX needs capitalized.`; }
        else { message = `Constant "${name}" holds an instance and should be camelCase ("${suggestion}"), even though it is exported. Casing carries two signals and they collide here: PascalCase is the older, louder claim that a name is a type, so a PascalCase instance reads as its own class. An instance is a thing that acts, and "${suggestion}.method()" says so at the call site. Exported data structures like Map and Set keep PascalCase, because they hold rather than act.`; }
        const named = this.rules.parser.node(nameIndex); const finding = new Diagnostic('nexus/consistency-require-constant-casing', id, message, this.rules.byte(this.rules.start(named)), this.rules.byte(named.end), '');
        if(!exported) { this.rename(finding, nameIndex, suggestion); }
