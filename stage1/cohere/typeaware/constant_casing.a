    }
    collect(): void {
        for(let index = 0; index < this.rules.parser.nodes.length; index++) {
            const node = this.rules.parser.node(index); const named = this.bindings.shape.name(index); const name = named >= 0 ? this.rules.parser.node(named).text : '';
            if(node.kind === 'CallExpression') { const callee = this.unwrap(node.children[0] ?? -1); if(this.rules.parser.node(callee).kind === 'Identifier') { this.called.push(this.name(callee)); } }
            if(node.kind === 'FunctionDeclaration' && name !== '') {
