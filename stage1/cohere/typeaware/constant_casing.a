// Numeric SyntaxKind listeners for the shared kind-indexed driver.
export const listenerKinds: readonly string[] = ["VariableDeclaration"];
import type { Rules } from './rules.ts';
import { Bindings } from './bindings.ts';
import { Flow } from './flow.ts';
import { Diagnostic } from './diagnostic.ts';
import { CharacterProperties } from './character_properties.a';
import { CallableTypeFacts } from './callable_type_facts.a';
import { classHeritageNames } from './class_heritage_names.a';
import type { ProgramImports } from './program_imports.a';
import { Frames, header } from './frames.ts';

const containers = ['Map', 'Set', 'WeakMap', 'WeakSet', 'Date', 'RegExp', 'Array', 'Int8Array', 'Uint8Array', 'Uint8ClampedArray',
    'Int16Array', 'Uint16Array', 'Int32Array', 'Uint32Array', 'Float32Array', 'Float64Array', 'BigInt64Array', 'BigUint64Array',
    'ArrayBuffer', 'SharedArrayBuffer', 'DataView', 'URL', 'URLSearchParams', 'Headers', 'TextEncoder', 'TextDecoder', 'String'];
const reserved = ['arguments', 'await', 'break', 'case', 'catch', 'class', 'const', 'continue', 'debugger', 'default', 'delete', 'do',
    'else', 'enum', 'eval', 'export', 'extends', 'false', 'finally', 'for', 'function', 'if', 'implements', 'import', 'in',
    'instanceof', 'interface', 'let', 'new', 'null', 'package', 'private', 'protected', 'public', 'return', 'static', 'super',
    'switch', 'this', 'throw', 'true', 'try', 'typeof', 'var', 'void', 'while', 'with', 'yield'];
export class CasingSymbols {
    readonly symbol: number; readonly local: number; readonly shorthand: number;
    constructor(symbol: number, local: number, shorthand: number) { this.symbol = symbol; this.local = local; this.shorthand = shorthand; }
}
export class ConstantCasing {
    readonly rules: Rules; readonly bindings: Bindings; readonly flow: Flow; readonly imports: ProgramImports;
    readonly functions: string[] = []; readonly imported: string[] = []; readonly called: string[] = []; readonly jsx: string[] = [];
    readonly returningFunction: string[] = []; readonly returningClass: string[] = []; readonly symbols = new Map<number, CasingSymbols>();
    constructor(rules: Rules, bindings: Bindings, flow: Flow, imports: ProgramImports) { this.rules = rules; this.imports = imports; this.bindings = bindings; this.flow = flow; }
    unwrap(index: number): number {
