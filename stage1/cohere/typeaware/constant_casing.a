        if(node.kind === 'Identifier') { return node.text; }
        if(node.kind === 'PropertyAccessExpression' || node.kind === 'QualifiedName') { return this.rules.parser.node(node.children[node.children.length - 1] ?? -1).text; }
        return '';
    }
    upper(name: string): boolean { let at = 0; while(name[at] === '_') { at++; } const first = name.charCodeAt(at); return first >= 65 && first <= 90; }
    functionNode(index: number): boolean { return index >= 0 && ['ArrowFunction', 'FunctionExpression'].includes(this.rules.parser.node(this.unwrap(index)).kind); }
    body(index: number): number { if(index < 0) { return -1; } const children = this.rules.parser.node(index).children; return children[children.length - 1] ?? -1; }
    returnsFunction(index: number): boolean {
        const body = this.body(this.unwrap(index)); if(body < 0) { return false; }
        if(this.rules.parser.node(body).kind !== 'Block') { return this.functionNode(body); }
        return this.rules.parser.node(body).children.some((child) => this.rules.parser.node(child).kind === 'ReturnStatement' && this.functionNode(this.rules.parser.node(child).children[0] ?? -1));
    }
    callName(index: number, identifierOnly = false): string {
        if(index < 0) { return ''; } const node = this.rules.parser.node(this.unwrap(index)); if(node.kind !== 'CallExpression') { return ''; }
        const callee = this.unwrap(node.children[0] ?? -1);
