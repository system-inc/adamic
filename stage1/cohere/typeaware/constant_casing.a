        const nameIndex = this.bindings.shape.name(index); if(nameIndex < 0 || this.rules.parser.node(nameIndex).kind !== 'Identifier') { return; }
        const list = this.bindings.parent(index); if(list < 0 || this.rules.parser.node(list).semantic !== '2') { return; } const statement = this.bindings.parent(list);
        if(statement >= 0 && this.rules.parser.node(statement).children.some((child) => this.rules.parser.node(child).kind === 'DeclareKeyword')) { return; }
        const name = this.name(nameIndex); const screaming = name.includes('_') && !name.endsWith('_') && name.charCodeAt(0) >= 65 && name.charCodeAt(0) <= 90 &&
            [...name].every((character) => character === '_' || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9'));
        let reservedName = name; while(reservedName.endsWith('_')) { reservedName = reservedName.slice(0, -1); }
        if(screaming || reserved.includes(reservedName.toLowerCase())) { return; }
