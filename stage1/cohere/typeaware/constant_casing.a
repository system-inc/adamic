    }
    annotationName(index: number): string { const annotation = this.flow.annotation(index); if(annotation < 0 || this.rules.parser.node(annotation).kind !== 'TypeReference') { return ''; } return this.name(this.rules.parser.node(annotation).children[0] ?? -1); }
    classAnnotation(index: number): boolean {
        const annotation = this.flow.annotation(index); if(annotation < 0) { return false; } const type = this.rules.parser.node(annotation); if(type.kind !== 'TypeReference' || type.children.length !== 1 || this.rules.parser.node(type.children[0] ?? -1).kind !== 'Identifier') { return false; }
        const initializer = this.unwrap(this.bindings.shape.initializer(index)); if(initializer >= 0 && ['ObjectLiteralExpression', 'ArrayLiteralExpression'].includes(this.rules.parser.node(initializer).kind)) { return false; }
        const name = this.annotationName(index); return this.upper(name) && !containers.includes(name) && !['Type', 'Interface', 'Properties', 'Options', 'Kind', 'Record'].some((suffix) => name.endsWith(suffix));
    }
    constEnum(index: number): boolean {
        if(index < 0) { return false; } const node = this.rules.parser.node(index); if(node.kind !== 'AsExpression') { return false; }
        const type = this.rules.parser.node(node.children[1] ?? -1); if(type.kind !== 'TypeReference' || this.name(type.children[0] ?? -1) !== 'const') { return false; }
        const object = this.rules.parser.node(node.children[0] ?? -1); if(object.kind !== 'ObjectLiteralExpression' || object.children.length === 0) { return false; }
        return object.children.every((child) => { const property = this.rules.parser.node(child); if(property.kind !== 'PropertyAssignment') { return false; }
            const key = property.children[0] ?? -1; const value = this.rules.parser.node(property.children[property.children.length - 1] ?? -1);
            if(this.rules.parser.node(key).kind !== 'Identifier' || !this.upper(this.name(key))) { return false; }
            return value.kind === 'NumericLiteral' || (value.kind === 'StringLiteral' && value.text === this.name(key)) ||
