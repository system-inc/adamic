            if(declaration < 0 || this.rules.parser.node(declaration).children.some((child) => this.rules.parser.node(child).kind === 'StringLiteral')) { continue; }
            const identifiers = node.children.filter((child) => this.rules.parser.node(child).kind === 'Identifier'); const local = identifiers[0] ?? -1; const exported = identifiers[identifiers.length - 1] ?? -1;
            if(local >= 0 && this.name(exported) !== 'default' && this.identity(local).local === symbol) { result.push(this.name(exported)); }
        }
