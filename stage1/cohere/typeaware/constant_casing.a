    }
    componentFactory(index: number): boolean {
        const at = this.unwrap(index); if(at < 0) { return false; } const node = this.rules.parser.node(at); const name = this.callName(at);
        if(!['memo', 'forwardRef', 'useMemo'].includes(name) || node.list <= 0) { return false; }
        const first = node.children[node.children.length - node.list] ?? -1; const fn = this.rules.parser.node(first);
        const named = this.bindings.shape.name(first); if(fn.kind === 'FunctionExpression' && named >= 0 && this.upper(this.name(named))) { return true; }
        if(name === 'useMemo' && fn.kind === 'FunctionExpression') { const body = this.rules.parser.node(this.body(first)); return body.kind === 'Block' && body.children.some((child) => {
            const statement = this.rules.parser.node(child); const expression = statement.children[0] ?? -1; if(statement.kind !== 'ReturnStatement' || expression < 0) { return false; }
            const returned = this.rules.parser.node(expression); const named = this.bindings.shape.name(expression); return returned.kind === 'FunctionExpression' && named >= 0 && this.upper(this.name(named)); }); }
        return false;
    }
    functionValue(index: number): boolean {
        const at = this.unwrap(index); if(at < 0) { return false; } const node = this.rules.parser.node(at);
        if(this.functionNode(at)) { return true; }
        if(node.kind === 'Identifier') { return this.functions.includes(node.text) || (this.imported.includes(node.text) && !this.upper(node.text)); }
        const called = this.callName(at); if(this.returningFunction.includes(this.callName(at, true)) || called.endsWith('Creator') || called.endsWith('Factory')) { return true; }
        if(['useMemo', 'useCallback', 'memo'].includes(called) && node.list > 0) { const first = node.children[node.children.length - node.list] ?? -1; return called === 'useMemo' ? this.returnsFunction(first) : this.functionNode(first); }
