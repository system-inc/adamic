            (image.includes(stem) && ['alt', 'size', 'contentType', 'generateImageMetadata'].includes(name)) || (stem === 'sitemap' && name === 'generateSitemaps');
    }
    rename(finding: Diagnostic, nameIndex: number, newName: string): void {
        if(newName === '' || reserved.includes(newName) || ['undefined', 'NaN', 'Infinity'].includes(newName)) { return; }
        const oldName = this.name(nameIndex); const declared = this.identity(nameIndex).symbol;
        if(declared === 0 || this.bindings.list(nameIndex, 'binding-declarations', false).length !== 1) { return; }
        const sites: number[] = []; const replacements: string[] = [];
        for(let at = 0; at < this.rules.parser.nodes.length; at++) {
            const node = this.rules.parser.node(at); if(node.kind !== 'Identifier') { continue; }
            if(node.text === newName) { return; } if(node.text !== oldName) { continue; }
            const parent = this.bindings.parent(at); const kind = parent >= 0 ? this.rules.parser.node(parent).kind : '';
            const symbols = this.identity(at);
            if(kind === 'ExportSpecifier') { if(symbols.local === declared) { return; } continue; }
            if(kind === 'ShorthandPropertyAssignment') { if(symbols.shorthand === declared) { sites.push(at); replacements.push(`${oldName}: ${newName}`); } }
            else if(at === nameIndex || symbols.symbol === declared) { sites.push(at); replacements.push(newName); }
        }
        if(sites.length === 0) { return; }
        // Parser storage is postorder, so sort references by source position before constructing one edit.
        for(let at = 1; at < sites.length; at++) { let cursor = at; while(cursor > 0 && this.rules.parser.node(sites[cursor - 1] ?? -1).pos > this.rules.parser.node(sites[cursor] ?? -1).pos) {
            const site = sites[cursor] ?? -1; sites[cursor] = sites[cursor - 1] ?? -1; sites[cursor - 1] = site;
            const replacement = replacements[cursor] ?? ''; replacements[cursor] = replacements[cursor - 1] ?? ''; replacements[cursor - 1] = replacement; cursor--; } }
        const start = this.rules.start(this.rules.parser.node(sites[0] ?? -1)); const end = this.rules.parser.node(sites[sites.length - 1] ?? -1).end;
        let cursor = start; let text = '';
        for(let at = 0; at < sites.length; at++) { const node = this.rules.parser.node(sites[at] ?? -1); const first = this.rules.start(node); text += this.rules.scanner.text.slice(cursor, first) + (replacements[at] ?? ''); cursor = node.end; }
        text += this.rules.scanner.text.slice(cursor, end); finding.fixStart = this.rules.byte(start); finding.fixEnd = this.rules.byte(end); finding.replacement = text;
    }
    visit(index: number): void {
