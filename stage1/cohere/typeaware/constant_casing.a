                    if(this.rules.parser.node(typeName).kind === 'Identifier' && this.upper(this.name(typeName)) && !containers.includes(this.name(typeName))) { this.returningClass.push(name); } }
                else if(['Identifier', 'Parameter', 'TypeParameter'].includes(kind) && body >= 0 && this.returnsFunction(index)) { this.returningFunction.push(name); }
            }
