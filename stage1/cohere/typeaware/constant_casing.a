            if(['ImportSpecifier', 'ImportClause', 'NamespaceImport'].includes(node.kind) && name !== '') { this.imported.push(name); }
            if(['JsxOpeningElement', 'JsxSelfClosingElement', 'JsxClosingElement'].includes(node.kind)) {
                let tag = node.children[0] ?? -1;
                while(tag >= 0 && this.rules.parser.node(tag).kind === 'PropertyAccessExpression') { tag = this.rules.parser.node(tag).children[0] ?? -1; }
                if(tag >= 0 && this.rules.parser.node(tag).kind === 'Identifier') { this.jsx.push(this.name(tag)); }
            }
            if(node.kind === 'JsxAttribute') { const expression = node.children.find((child) => this.rules.parser.node(child).kind === 'JsxExpression') ?? -1;
                const inner = expression >= 0 ? this.unwrap(this.rules.parser.node(expression).children[0] ?? -1) : -1;
