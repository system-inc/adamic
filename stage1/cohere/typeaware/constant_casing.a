        const base = segments[segments.length - 1] ?? ''; if(!['.tsx', '.ts', '.jsx', '.js'].some((extension) => base.endsWith(extension))) { return false; }
        let stem = base.slice(0, base.lastIndexOf('.')); const image = ['icon', 'apple-icon', 'opengraph-image', 'twitter-image'];
        if(!['page', 'layout', 'route', 'sitemap', 'robots', 'manifest', ...image].includes(stem)) { while(stem.length > 0 && '0123456789'.includes(stem[stem.length - 1] ?? '!')) { stem = stem.slice(0, -1); } if(!image.includes(stem)) { return false; } }
        if(['config', 'generateStaticParams', 'unstable_instant', 'unstable_dynamicStaleTime', 'revalidate', 'dynamic', 'dynamicParams', 'fetchCache', 'preferredRegion', 'runtime', 'maxDuration'].includes(name)) { return true; }
        return (['page', 'layout'].includes(stem) && ['metadata', 'generateMetadata', 'viewport', 'generateViewport'].includes(name)) ||
