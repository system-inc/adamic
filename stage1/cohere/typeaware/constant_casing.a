        if(node.kind === 'BinaryExpression' && ['QuestionQuestionToken', 'BarBarToken'].includes(this.rules.parser.node(node.children[1] ?? -1).kind)) { return this.rebinding(node.children[0] ?? -1) || this.rebinding(node.children[2] ?? -1); }
        if(node.kind === 'ConditionalExpression') { return this.rebinding(node.children[2] ?? -1) || this.rebinding(node.children[4] ?? -1); }
        return false;
    }
    dynamic(index: number): boolean {
