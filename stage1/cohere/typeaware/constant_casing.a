        const names = this.exported(statement, nameIndex); const exported = names.length > 0; if(exported && this.routeContract(name)) { return; }
        const characters = new CharacterProperties(this.rules, nameIndex, name); const camel = characters.casing(false); const pascal = characters.casing(true);
        let id = '';
        if(this.functionValue(initializer) || this.called.includes(name)) { if(camel || this.jsx.includes(name)) { return; } id = 'requireCamelCaseFunction'; }
        else {
