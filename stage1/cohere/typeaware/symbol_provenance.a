import { panic } from 'adamic';
import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';

export interface ProvenanceDeclaration {
    readonly path: string;
    readonly kind: string;
    readonly start: number;
    readonly end: number;
    readonly ambient: boolean;
    readonly module: string;
}
export class SymbolProvenance {
    readonly id: number;
    name = '';
    readonly declarations: ProvenanceDeclaration[] = [];
    valuePath = '';
    valueKind = '';
    valueStart = 0;
    valueEnd = 0;
    constant = false;
    readonly sharpFiles: string[] = [];
    constructor(rules: Rules, index: number, alias: boolean) {
        const frames = new Frames(rules.ask(index, alias ? 'symbol-provenance\nalias' : 'symbol-provenance'));
        header(frames, 'symbol-provenance');
        this.id = frames.natural();
        if(this.id !== 0) {
            this.name = frames.field();
            const count = frames.natural();
            for(let at = 0; at < count; at++) {
                const path = frames.field();
                const kind = frames.field();
                const start = frames.natural();
                const end = frames.natural();
                const ambient = frames.yes();
                const module = frames.field();
                if(end < start) { panic('invalid symbol declaration span'); }
                this.declarations.push({path, kind, start, end, ambient, module});
            }
            if(frames.yes()) {
                this.valuePath = frames.field();
                this.valueKind = frames.field();
                this.valueStart = frames.natural();
                this.valueEnd = frames.natural();
                this.constant = frames.yes();
            }
            const imports = frames.natural();
            for(let at = 0; at < imports; at++) {
                frames.field();
                if(frames.yes()) {
                    const path = frames.field();
                    const external = frames.yes();
                    const packageName = frames.field();
                    if(external && packageName === 'sharp') { this.sharpFiles.push(path); }
                }
            }
        }
        frames.end();
    }
}
