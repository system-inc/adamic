import type { Rules } from './rules.ts';
import { Frames, header } from './frames.ts';

// Declaration-file status is a checker fact. Each caller decides how unresolved
// and declarationless symbols affect its production rule.
export function ambientName(rules: Rules, index: number, missing: boolean, empty: boolean): boolean {
    const name = rules.parser.node(index).text;
    const frames = new Frames(rules.ask(index, `resolved-name\n${name}`));
    header(frames, 'resolved-name');
    let result = missing;
    if(frames.yes()) {
        frames.field();
        const count = frames.natural();
        result = count > 0 || empty;
        for(let at = 0; at < count; at++) {
            frames.field();
            result = frames.yes() && result;
            frames.yes();
        }
    }
    frames.end();
    return result;
}
