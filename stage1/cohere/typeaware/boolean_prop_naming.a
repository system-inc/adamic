import { DeclaredSyntaxTypes } from './declared_syntax_type.a';
import { ReactCompilationGate } from './react_compilation_gate.a';
import { Diagnostic } from './diagnostic.ts';
export const booleanPropPattern = '^(is|has)[A-Z]([A-Za-z0-9]?)+';
export class BooleanPropNaming {
 readonly rules: Rules; readonly syntax: SyntaxProjection; readonly symbols: ProcessSymbols; readonly types: DeclaredSyntaxTypes; readonly gate: ReactCompilationGate; readonly enabled: boolean; readonly pattern: string; readonly nested: boolean; readonly propTypes: readonly string[]; readonly message: string; readonly reported = new Set<number>();
 constructor(rules: Rules, syntax: SyntaxProjection, enabled = false, pattern = booleanPropPattern, nested = false, propTypes: readonly string[] = ['bool'], message = '') {
  if(enabled && ![booleanPropPattern, '^is[A-Z]([A-Za-z0-9]?)+'].includes(pattern)) { panic('boolean-prop-naming requires a native regular-expression engine for this configured pattern'); }
  this.rules = rules; this.syntax = syntax; this.symbols = new ProcessSymbols(syntax); this.types = new DeclaredSyntaxTypes(syntax); this.gate = new ReactCompilationGate(syntax); this.enabled = enabled; this.pattern = pattern; this.nested = nested; this.propTypes = propTypes.length === 0 ? ['bool'] : propTypes; this.message = message;
 }
 key(index: number): string { if(index === 0) { return 'undefined'; } const syntax = this.syntax; let node = syntax.node(index); if(node.kind === 'ComputedPropertyName') { const inner = syntax.skip(node.expression); if(inner === 0) { return 'undefined'; } node = syntax.node(inner); } return node.kind === 'Identifier' ? node.text : 'undefined'; }
 named(index: number): boolean { if(index === 0) { return false; } const node = this.syntax.node(index); return node.kind === 'Identifier' || (node.kind === 'ComputedPropertyName' && node.expression !== 0 && this.syntax.node(this.syntax.skip(node.expression)).kind === 'Identifier'); }
 matches(name: string): boolean { const prefix = name.startsWith('is') ? 2 : this.pattern === booleanPropPattern && name.startsWith('has') ? 3 : 0; const char = name[prefix] ?? ''; return prefix !== 0 && char >= 'A' && char <= 'Z'; }
 text(name: string): string { if(this.message === '') { return `Prop name \`${name}\` doesn’t match rule \`${this.pattern}\``; } let result = ''; let start = 0; while(start < this.message.length) { const at = this.message.indexOf('{{', start); if(at < 0) { result += this.message.slice(start); break; } result += this.message.slice(start, at); const end = this.message.indexOf('}}', at + 2); if(end < 0) { result += this.message.slice(at); break; } const key = this.message.slice(at + 2, end).trim(); result += ['propName', 'component'].includes(key) ? name : key === 'pattern' ? this.pattern : this.message.slice(at, end + 2); start = end + 2; } return result; }
 report(index: number): void { const node = this.syntax.node(index); const name = this.key(node.name); if(this.reported.has(index) || (this.named(node.name) && this.matches(name))) { return; } this.reported.add(index); this.rules.findings.push(new Diagnostic('react/boolean-prop-naming', 'patternMismatch', this.text(name), node.start, node.end, '')); }
 boolean(index: number): boolean { const syntax = this.syntax; const current = syntax.skip(index); if(current === 0) { return false; } const node = syntax.node(current); if(node.kind === 'Identifier') { return this.propTypes.includes(node.text); } if(node.kind !== 'PropertyAccessExpression' || node.name === 0 || syntax.node(node.name).kind !== 'Identifier') { return false; } const name = syntax.node(node.name).text; if(name !== 'isRequired') { return this.propTypes.includes(name); } const object = syntax.skip(node.expression); if(object === 0) { return false; } const inner = syntax.node(object); return inner.kind === 'PropertyAccessExpression' && inner.name !== 0 && syntax.node(inner.name).kind === 'Identifier' && this.propTypes.includes(syntax.node(inner.name).text); }
 object(index: number): void { const syntax = this.syntax; const current = syntax.skip(index); if(current === 0 || syntax.node(current).kind !== 'ObjectLiteralExpression') { return; } for(const child of syntax.node(current).children) { const property = syntax.node(child); if(property.kind !== 'PropertyAssignment') { continue; } const initializer = syntax.skip(property.initializer); if(this.nested && initializer !== 0 && syntax.node(initializer).kind === 'CallExpression') { this.object(syntax.node(initializer).arguments[0] ?? 0); continue; } if(this.boolean(initializer)) { this.report(child); } } }
 members(index: number, visited: readonly number[]): void { if(index === 0 || visited.includes(index)) { return; } const syntax = this.syntax; const node = syntax.node(index); const next = visited.slice(); next.push(index);
  if(node.kind === 'ParenthesizedType') { this.members(this.types.get(index), next); }
  else if(['TypeLiteral', 'InterfaceDeclaration'].includes(node.kind)) { for(const child of node.children) { const member = syntax.node(child); if(member.kind === 'PropertySignature') { const type = this.types.get(child); if(type !== 0 && syntax.node(type).kind === 'BooleanKeyword') { this.report(child); } } } }
  else if(['IntersectionType','UnionType'].includes(node.kind)) { for(const child of node.children) { this.members(child, next); } }
  else if(node.kind === 'TypeReference') { const name = node.children[0] ?? 0; if(name !== 0 && syntax.node(name).kind === 'Identifier') { for(const decl of this.symbols.get(name).declarations) { if(!['InterfaceDeclaration','TypeAliasDeclaration'].includes(decl.kind)) { continue; } if(decl.file !== syntax.path) { panic('boolean-prop-naming imported props syntax requires a cross-file annotation projection'); } const body = syntax.locate(decl.kind, decl.pos, decl.end); this.members(decl.kind === 'InterfaceDeclaration' ? body : this.types.get(body), next); break; } } }
 }
 capital(name: string): boolean { let at = 0; while(name[at] === '_') { at++; } if(at >= name.length) { return false; } const code = name.charCodeAt(at); const first = name.slice(at, at + (code >= 0xd800 && code <= 0xdbff ? 2 : 1)); const upper = first.toUpperCase(); return first === upper || upper.length !== first.length; }
 jsx(index: number, acceptNull: boolean): boolean { const syntax = this.syntax; const current = syntax.skip(index); if(current === 0) { return false; } const node = syntax.node(current); if(['JsxElement','JsxSelfClosingElement','JsxFragment'].includes(node.kind)) { return true; } if(node.kind === 'NullKeyword') { return acceptNull; } if(node.kind === 'ConditionalExpression') { return this.jsx(node.children[2] ?? 0, acceptNull) || this.jsx(node.children[4] ?? 0, acceptNull); } if(node.kind === 'BinaryExpression') { if(['AmpersandAmpersandToken','BarBarToken','QuestionQuestionToken'].includes(node.operator)) { return this.jsx(node.children[0] ?? 0, acceptNull) || this.jsx(node.children[2] ?? 0, acceptNull); } if(node.operator === 'CommaToken') { return this.jsx(node.children[2] ?? 0, acceptNull); } } if(node.kind === 'CallExpression' && node.expression !== 0) { const callee = syntax.node(syntax.skip(node.expression)); if(callee.kind === 'PropertyAccessExpression' && callee.name !== 0 && syntax.node(callee.name).text === 'createElement' && callee.expression !== 0 && syntax.node(callee.expression).kind === 'Identifier' && syntax.node(callee.expression).text === 'React') { return true; } if(callee.kind === 'Identifier' && callee.text === 'createElement') { return this.symbols.get(syntax.skip(node.expression)).declarations.some((decl) => decl.kind === 'ImportSpecifier' && decl.file === syntax.path && this.reactImport(syntax.locate(decl.kind, decl.pos, decl.end))); } } return false; }
 reactImport(index: number): boolean { for(let at = index; at !== 0; at = this.syntax.node(at).parent) { const node = this.syntax.node(at); if(node.kind === 'ImportDeclaration') { return node.children.some((child) => this.syntax.node(child).kind === 'StringLiteral' && this.syntax.node(child).text === 'react'); } } return false; }
 returns(index: number, acceptNull: boolean): boolean { const syntax = this.syntax; const node = syntax.node(index); if(node.kind === 'ReturnStatement') { return this.jsx(node.expression, acceptNull); } if(!['Block','IfStatement','ForStatement','WhileStatement','SwitchStatement','CaseBlock','CaseClause','DefaultClause'].includes(node.kind)) { return false; } return node.children.some((child) => this.returns(child, acceptNull)); }
 returning(index: number, acceptNull: boolean): boolean { const node = this.syntax.node(index); if(node.body === 0) { return false; } if(node.kind === 'ArrowFunction' && this.syntax.node(node.body).kind !== 'Block') { return this.jsx(node.body, acceptNull); } return this.returns(node.body, acceptNull); }
 component(index: number): boolean { const syntax = this.syntax; const node = syntax.node(index); if((node.functionFlags & 3) === 3) { return false; } const parent = this.gate.parent(index);
  if(node.kind === 'FunctionDeclaration') { return (node.name === 0 || this.capital(syntax.node(node.name).text)) && this.returning(index, true); }
  if(node.kind === 'MethodDeclaration') { return parent !== 0 && syntax.node(parent).kind === 'ObjectLiteralExpression' && node.name !== 0 && syntax.node(node.name).kind === 'Identifier' && this.capital(syntax.node(node.name).text) && this.returning(index, false); }
  if(!['FunctionExpression','ArrowFunction'].includes(node.kind) || parent === 0) { return false; } const owner = syntax.node(parent);
  if(owner.kind === 'ExportAssignment') { return this.returning(index, false); }
  if(owner.kind === 'VariableDeclaration') { return owner.name !== 0 && syntax.node(owner.name).kind === 'Identifier' && this.capital(syntax.node(owner.name).text) && this.returning(index, true); }
  if(owner.kind === 'PropertyAssignment' && !(node.kind === 'FunctionExpression' && node.name !== 0)) { return owner.name !== 0 && syntax.node(owner.name).kind === 'Identifier' && this.capital(syntax.node(owner.name).text) && this.returning(index, false); }
  if(!['BinaryExpression','PropertyAssignment','ReturnStatement','ArrowFunction','MethodDeclaration'].includes(owner.kind)) { return false; } if(['ReturnStatement','ArrowFunction'].includes(owner.kind) && !this.returning(index, false)) { return false; } if(!this.returning(index, true)) { return false; } if(node.name !== 0) { return this.capital(syntax.node(node.name).text); } if(owner.kind === 'BinaryExpression') { if(owner.operator === 'CommaToken') { return owner.children[2] === index && this.componentValue(parent); } if(owner.operator !== 'EqualsToken') { return false; } const target = syntax.node(syntax.skip(owner.children[0] ?? 0)); if(target.kind === 'Identifier') { return this.capital(target.text); } if(target.kind === 'PropertyAccessExpression' && target.name !== 0) { return this.capital(syntax.node(target.name).text) || (syntax.node(target.name).text === 'exports' && target.expression !== 0 && syntax.node(target.expression).text === 'module'); } return false; } return true;
 }
 componentValue(index: number): boolean { const parent = this.gate.parent(index); if(parent === 0) { return false; } const node = this.syntax.node(parent); return ['VariableDeclaration','PropertyAssignment','ReturnStatement','ExportAssignment','ArrowFunction'].includes(node.kind) || (node.kind === 'BinaryExpression' && (node.operator === 'EqualsToken' || (node.operator === 'CommaToken' && node.children[2] === index && this.componentValue(parent)))); }
 props(index: number): number { const params = this.gate.parameters(index); const first = params[0]; if(first !== undefined) { const type = this.types.get(first); if(type !== 0) { return type; } } const parent = this.gate.parent(index); if(parent === 0 || this.syntax.node(parent).kind !== 'VariableDeclaration') { return 0; } const type = this.types.get(parent); if(type === 0 || this.syntax.node(type).kind !== 'TypeReference') { return 0; } return this.syntax.node(type).children.slice(1).find((child) => ['TypeReference','TypeLiteral'].includes(this.syntax.node(child).kind)) ?? 0; }
 run(): void { if(!this.enabled) { return; } const syntax = this.syntax; const empty: number[] = []; for(let at = 1; at <= syntax.nodes.length; at++) { const node = syntax.node(at);
  if(node.kind === 'CallExpression' && node.expression !== 0) { const callee = syntax.node(syntax.skip(node.expression)); const name = callee.kind === 'Identifier' ? callee.text : callee.name === 0 ? '' : syntax.node(callee.name).text; const parent = this.gate.parent(at); if(['memo', 'forwardRef'].includes(name) && parent !== 0 && syntax.node(parent).kind === 'VariableDeclaration' && this.types.get(parent) !== 0) { panic('boolean-prop-naming typed wrapper component detection is not yet ported'); } }
  if(['PropertyDeclaration','PropertyAssignment'].includes(node.kind) && node.name !== 0 && ['Identifier','StringLiteral'].includes(syntax.node(node.name).kind) && syntax.node(node.name).text === 'propTypes') { this.object(node.initializer); }
  if(node.kind === 'BinaryExpression' && node.operator === 'EqualsToken') { const target = syntax.skip(node.children[0] ?? 0); if(target !== 0) { const access = syntax.node(target); if(access.kind === 'PropertyAccessExpression' && access.name !== 0 && ['Identifier','StringLiteral'].includes(syntax.node(access.name).kind) && syntax.node(access.name).text === 'propTypes') { this.object(node.children[2] ?? 0); } } }
 } for(let at = 1; at <= syntax.nodes.length; at++) { if(this.component(at)) { this.members(this.props(at), empty); } }
 }
}
