import type { Bindings } from '../bindings.ts';
import type { ParseNode } from '../../../typescript/parser/nodes.ts';
import { waveNode } from '../wave_node.a';
import { Diagnostic } from '../diagnostic.ts';
import { SymbolContext } from './wave07_symbol_context.a';

// Numeric SyntaxKind keys from the pinned production listener map.
export const listenerKinds: readonly number[] = [214];

export class NoUnclearedRaceTimeout {
    readonly bindings: Bindings;
    readonly contexts = new Map<number, SymbolContext>();
    constructor(bindings: Bindings) {
        this.bindings = bindings;
    }
    node(index: number): ParseNode {
        return waveNode(this.bindings.rules.parser, index);
    }
    context(index: number): SymbolContext {
        const stored = this.contexts.get(index);
        if(stored !== undefined) {
            return stored;
        }
        const context = new SymbolContext(this.bindings.rules, index);
        this.contexts.set(index, context);
        return context;
    }
    skip(index: number): number {
        return index < 0 ? index : this.bindings.rules.skip(index);
    }
    args(index: number): number[] {
        const node = this.node(index);
        return node.list > 0 ? node.children.slice(node.children.length - node.list) : [];
    }
    libraryMember(index: number): boolean {
        const context = this.context(index);
        return (
            context.declarations.length > 0 &&
            context.declarations.every(
                (declaration) =>
                    declaration.library &&
                    declaration.kinds[0] === 'InterfaceDeclaration' &&
                    declaration.names[0] === 'PromiseConstructor',
            )
        );
    }
    promise(index: number): number {
        let element = this.skip(index);
        if(this.node(element).kind === 'Identifier') {
            const context = this.context(element);
            const declaration = context.declarations[0];
            if(
                context.declarations.length !== 1 ||
                declaration === undefined ||
                declaration.file !== this.bindings.rules.path ||
                declaration.kind !== 'VariableDeclaration'
            ) {
                return -1;
            }
            const local = this.bindings.spans.get(`${declaration.kind}:${declaration.start}:${declaration.end}`) ?? -1;
            if(local < 0) {
                return -1;
            }
            const list = this.node(this.bindings.parent(local));
            if(list.kind !== 'VariableDeclarationList' || !['2', '6'].includes(list.semantic)) {
                return -1;
            }
            const initializer = this.bindings.shape.initializer(local);
            if(initializer < 0) {
                return -1;
            }
            element = this.skip(initializer);
        }
        const node = this.node(element);
        if(node.kind !== 'NewExpression') {
            return -1;
        }
        const constructor = this.skip(node.children[0] ?? -1);
        if(this.node(constructor).kind !== 'Identifier' || this.node(constructor).text !== 'Promise') {
            return -1;
        }
        const context = this.context(constructor);
        return context.declarations.length > 0 && context.declarations.every((declaration) => declaration.library)
            ? element
            : -1;
    }
    timer(index: number): boolean {
        const callee = this.skip(this.node(index).children[0] ?? -1);
        let name = callee;
        if(this.node(callee).kind === 'PropertyAccessExpression') {
            const receiver = this.skip(this.node(callee).children[0] ?? -1);
            if(
                this.node(receiver).kind !== 'Identifier' ||
                !['globalThis', 'window'].includes(this.node(receiver).text)
            ) {
                return false;
            }
            name = this.node(callee).children[this.node(callee).children.length - 1] ?? -1;
        }
        if(this.node(name).kind !== 'Identifier' || this.node(name).text !== 'setTimeout') {
            return false;
        }
        const context = this.context(name);
        return (
            context.declarations.length > 0 &&
            context.declarations.every(
                (declaration) =>
                    declaration.declarationFile &&
                    ((declaration.kinds[0] === 'SourceFile' && !declaration.module) ||
                        (declaration.kinds[0] === 'ModuleBlock' && declaration.global[1] === true) ||
                        (declaration.kinds[0] === 'InterfaceDeclaration' &&
                            declaration.names[0] === 'WindowOrWorkerGlobalScope' &&
                            declaration.library)),
            )
        );
    }
    outer(index: number): number {
        let current = index;
        while(this.node(this.bindings.parent(current)).kind === 'ParenthesizedExpression') {
            current = this.bindings.parent(current);
        }
        return current;
    }
    assignment(index: number): boolean {
        const outer = this.outer(index);
        const parent = this.node(this.bindings.parent(outer));
        return (
            parent.kind === 'BinaryExpression' &&
            this.node(parent.children[1] ?? -1).kind === 'EqualsToken' &&
            parent.children[0] === outer
        );
    }
    neverRead(index: number): boolean {
        const context = this.context(index);
        const declaration = context.declarations[0];
        if(
            context.declarations.length !== 1 ||
            declaration === undefined ||
            declaration.kind !== 'VariableDeclaration' ||
            declaration.file !== this.bindings.rules.path
        ) {
            return false;
        }
        const local = this.bindings.spans.get(`${declaration.kind}:${declaration.start}:${declaration.end}`) ?? -1;
        if(local < 0) {
            return false;
        }
        const declared = this.bindings.shape.name(local);
        const name = this.node(declared).text;
        for(let reference = 0; reference < this.bindings.rules.parser.nodes.length; reference++) {
            const node = this.node(reference);
            if(node.kind === 'Identifier' && node.text === name && reference !== declared) {
                if(this.context(reference).value === context.identity && !this.assignment(reference)) {
                    return false;
                }
            }
        }
        return true;
    }
    lost(executor: number, call: number): boolean {
        const outer = this.outer(call);
        const parentIndex = this.bindings.parent(outer);
        const parent = this.node(parentIndex);
        if(['ExpressionStatement', 'VoidExpression'].includes(parent.kind) || parentIndex === executor) {
            return true;
        }
        if(parent.kind === 'VariableDeclaration' && this.bindings.shape.initializer(parentIndex) === outer) {
            const name = this.bindings.shape.name(parentIndex);
            return this.node(name).kind === 'Identifier' && this.neverRead(name);
        }
        if(
            parent.kind === 'BinaryExpression' &&
            this.node(parent.children[1] ?? -1).kind === 'EqualsToken' &&
            parent.children[2] === outer
        ) {
            const target = this.skip(parent.children[0] ?? -1);
            return (
                this.node(target).kind === 'Identifier' &&
                this.node(this.bindings.parent(this.outer(parentIndex))).kind === 'ExpressionStatement' &&
                this.neverRead(target)
            );
        }
        return false;
    }
    visit(index: number, executor: number): void {
        const node = this.node(index);
        if(this.bindings.functionKind(node.kind) || ['ClassDeclaration', 'ClassExpression'].includes(node.kind)) {
            return;
        }
        if(node.kind === 'CallExpression' && this.timer(index) && this.lost(executor, index)) {
            this.bindings.rules.findings.push(
                new Diagnostic(
                    'nexus/correctness-no-uncleared-race-timeout',
                    'unclearedRaceTimeout',
                    'This `setTimeout` arms the losing side of a `Promise.race`, and its handle is thrown away, so nothing can ever clear it. When the work wins the race, the timer stays armed for its whole duration: in Node it holds the process open (a batch that finished its last item sits until the timeout elapses), and its callback still runs, rejecting a promise nobody is waiting on. Keep the handle (`timer = setTimeout(...)`) and `clearTimeout(timer)` in a `finally` around the race.',
                    this.bindings.rules.byte(this.bindings.rules.start(node)),
                    this.bindings.rules.byte(node.end),
                    '',
                ),
            );
        }
        for(const child of node.children) {
            this.visit(child, executor);
        }
    }
    race(index: number): void {
        const callee = this.skip(this.node(index).children[0] ?? -1);
        const access = this.node(callee);
        if(access.kind !== 'PropertyAccessExpression') {
            return;
        }
        const name = access.children[access.children.length - 1] ?? -1;
        if(this.node(name).kind !== 'Identifier' || this.node(name).text !== 'race' || !this.libraryMember(name)) {
            return;
        }
        const array = this.skip(this.args(index)[0] ?? -1);
        if(this.node(array).kind !== 'ArrayLiteralExpression') {
            return;
        }
        for(const element of this.node(array).children) {
            const promise = this.promise(element);
            if(promise < 0) {
                continue;
            }
            const executor = this.skip(this.args(promise)[0] ?? -1);
            const node = this.node(executor);
            if(!['ArrowFunction', 'FunctionExpression'].includes(node.kind)) {
                continue;
            }
            const body = node.children[node.children.length - 1] ?? -1;
            this.visit(body, executor);
        }
    }
    run(): void {
        for(let index = 0; index < this.bindings.rules.parser.nodes.length; index++) {
            if(this.node(index).kind === 'CallExpression') {
                this.race(index);
            }
        }
    }
}
