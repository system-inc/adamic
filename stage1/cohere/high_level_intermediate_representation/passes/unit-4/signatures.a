// Literal signatures from Go effects.go; receiver-qualified aliases follow Globals.ts.
import type { Signature, ValueKind } from './effect_types.a';
export function signature(receiver: string,positional: readonly string[],rest: string,hasRest: boolean,result: ValueKind,aliasing: string = ''): Signature { return {receiver,positional,rest,hasRest,result,aliasing}; }
export const methods = new Map<string,Signature>();
methods.set('push',signature('store',[],'capture',true,'primitive'));
methods.set('pop',signature('store',[],'<unknown>',false,'mutable'));
methods.set('add',signature('store',['capture'],'<unknown>',false,'mutable'));
methods.set('set',signature('store',['capture', 'capture'],'<unknown>',false,'mutable'));
methods.set('map',signature('capture',['read'],'<unknown>',false,'mutable'));
methods.set('filter',signature('capture',['read'],'<unknown>',false,'mutable'));
methods.set('slice',signature('capture',['read', 'read'],'<unknown>',false,'mutable'));
methods.set('concat',signature('capture',[],'capture',true,'mutable'));
methods.set('at',signature('capture',['read'],'<unknown>',false,'mutable'));
methods.set('entries',signature('capture',[],'<unknown>',false,'mutable'));
methods.set('includes',signature('read',[],'read',true,'primitive'));
methods.set('indexOf',signature('read',[],'read',true,'primitive'));
methods.set('join',signature('read',['read'],'<unknown>',false,'primitive'));
methods.set('has',signature('read',['read'],'<unknown>',false,'primitive'));
methods.set('toString',signature('read',[],'<unknown>',false,'primitive'));
methods.set('find',signature('capture',['read'],'<unknown>',false,'mutable'));
methods.set('findIndex',signature('read',['read'],'<unknown>',false,'primitive'));
methods.set('every',signature('read',['read'],'<unknown>',false,'primitive'));
methods.set('forEach',signature('capture',['read'],'<unknown>',false,'primitive'));
methods.set('flatMap',signature('capture',['read'],'<unknown>',false,'mutable'));
methods.set('difference',signature('read',['read'],'<unknown>',false,'mutable'));
export const functions = new Map<string,Signature>();
functions.set('String',signature('<unknown>',[],'read',true,'primitive'));
functions.set('Number',signature('<unknown>',[],'read',true,'primitive'));
functions.set('Boolean',signature('<unknown>',[],'read',true,'primitive'));
functions.set('parseInt',signature('<unknown>',[],'read',true,'primitive'));
functions.set('parseFloat',signature('<unknown>',[],'read',true,'primitive'));
functions.set('encodeURIComponent',signature('<unknown>',[],'read',true,'primitive'));
functions.set('decodeURIComponent',signature('<unknown>',[],'read',true,'primitive'));
functions.set('isNaN',signature('<unknown>',[],'read',true,'primitive'));
export const qualified = new Map<string,Signature>();
qualified.set('Object.keys',signature('read',['read'],'<unknown>',false,'mutable','immutable-capture'));
qualified.set('Object.values',signature('read',['capture'],'<unknown>',false,'mutable','capture'));
qualified.set('Object.entries',signature('read',['capture'],'<unknown>',false,'mutable','capture'));
qualified.set('Object.fromEntries',signature('read',['mutate?'],'<unknown>',false,'mutable'));
