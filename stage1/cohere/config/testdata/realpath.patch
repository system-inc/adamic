+// Canonical path identity for directory visitation, following links as the host filesystem does.
+export function realPath(path) {
+    try { return { kind: 'Ok', path: realpathSync.native(path) }; }
+    catch (error) { return { kind: 'Error', message: `cannot resolve path ${path}: ${failure(error.code, false)}` }; }
+}
