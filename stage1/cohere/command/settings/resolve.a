export const prettier: Options = { tabWidth: 2, useTabs: false, semi: true, singleQuote: false, printWidth: 80, trailingComma: 'all', bracketSpacing: true, bracketSameLine: false, arrowParens: 'always', endOfLine: 'lf' };
export type Resolution = { readonly kind: 'Ok'; readonly options: Options; readonly source: string; readonly houseIgnore: readonly string[]; readonly houseIgnoreDeclared: boolean; readonly ignorePatterns: readonly string[] };
export type Answer = Resolution | Failure;
function compare(left: string, right: string): number {
    const length = Math.min(utf8Length(left), utf8Length(right));
    for(let index = 0; index < length; index++) {
        const difference = utf8At(left, index) - utf8At(right, index);
        if(difference !== 0) return difference;
