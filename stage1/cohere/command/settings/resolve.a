}
type Layers = { readonly kind: 'Ok'; readonly layers: readonly Layer[] } | Failure;
type Strings = { readonly kind: 'Ok'; readonly values: readonly string[] } | { readonly kind: 'Error'; readonly message: string };
function strings(doc: Document, index: number): Strings {
