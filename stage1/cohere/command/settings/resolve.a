    for(const child of doc.node(overrides).children) {
        const keys: string[] = [];
        for(const key of doc.node(child).keys) if(!['files', 'rules', 'reason'].includes(key) && !keys.includes(key)) keys.push(key);
        keys.sort(compare);
        if(keys.length > 0) return `lint config ${path}: override ${index} declares ${keys.map((key) => quote(key)).join(', ')}, which this loader does not read: the key would be discarded silently. An override takes "files", "rules" and "reason"`;
