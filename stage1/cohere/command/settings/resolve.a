            else if(key === 'useTabs') options = { ...options, useTabs: value.text === 'true' };
            else if(key === 'semi') options = { ...options, semi: value.text === 'true' };
            else if(key === 'singleQuote') options = { ...options, singleQuote: value.text === 'true' };
            else if(key === 'bracketSpacing') options = { ...options, bracketSpacing: value.text === 'true' };
            else if(key === 'bracketSameLine') options = { ...options, bracketSameLine: value.text === 'true' };
            else if(key === 'trailingComma') options = { ...options, trailingComma: value.text };
            else if(key === 'arrowParens') options = { ...options, arrowParens: value.text };
            else if(key === 'endOfLine') options = { ...options, endOfLine: value.text };
