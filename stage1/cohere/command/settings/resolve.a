function unknownKeys(doc: Document, path: string): string {
    const root = doc.node(doc.root);
    if(root.kind !== 'object') return '';
    const unknown: string[] = [];
    for(const key of root.keys) if(!topKeys.includes(key) && !unknown.includes(key)) unknown.push(key);
    unknown.sort(compare);
    if(unknown.length > 0) return `lint config ${path} declares ${unknown.map((key) => quote(key)).join(', ')}, which this loader does not implement: the key would be discarded silently and whatever it configures would never take effect. Either implement it in \`rawConfig\` and act on it, or add it to \`ignoredTopLevelKeys\` with a note saying why ignoring it is correct`;
    const overrides = doc.field(doc.root, 'overrides');
