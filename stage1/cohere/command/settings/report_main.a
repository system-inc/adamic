// The output interface captures exact strings; this driver uses console only to
// expose the capture to tests. It is not the ruled operating-system adapter.
import { panic } from 'adamic';
import { reportRefusal } from './host.a';
for(const message of ['', 'bad configuration', 'a\nb', '\ufeffé😀']) {
    const stdout: string[] = [];
    const stderr: string[] = [];
    const status = reportRefusal({
        stdout: (text: string) => { stdout.push(text); },
        stderr: (text: string) => { stderr.push(text); },
    }, { kind: 'Refused', message, status: 1, leftover: false });
    // #kqxkvg0: JSON literal shorthand is refused; write out the status property.
    console.log(JSON.stringify({ status: status, stdout: stdout.join(''), stderr: stderr.join('') }) ?? panic('report JSON'));
}
