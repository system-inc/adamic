import type { Edit } from './edit.a';
import type { Suggestion } from './suggestion.a';
export class Diagnostic {
    readonly recordKind = 'diagnostic';
    readonly rule: string;
    readonly id: string;
    readonly message: string;
    readonly start: number;
    readonly end: number;
    readonly edits: readonly Edit[];
    readonly suggestions: readonly Suggestion[];
    constructor(
        rule: string,
        id: string,
        message: string,
        start: number,
        end: number,
        edits: readonly Edit[],
        suggestions: readonly Suggestion[],
    ) {
        this.edits = edits;
        this.suggestions = suggestions;
        this.rule = rule;
        this.id = id;
        this.message = message;
        this.start = start;
        this.end = end;
    }
}
