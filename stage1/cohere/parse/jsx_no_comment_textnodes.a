import type { Context } from './context.a';
import { messageJsxNoCommentTextnodes } from './messages.a';
// The listener is held to synthetic JsxText nodes; the parser's TSX gap is explicit in the tests.
export function jsxNoCommentTextnodes(context: Context, index: number): void {
    if(!context.enabled('react/jsx-no-comment-textnodes')) {
        return;
    }
    if(context.kind(index) !== 'JsxText') {
        return;
    }
    const node = context.node(index);
    const raw = context.source.slice(node.pos, node.end);
    let atLineStart = true;
    for(let position = 0; position < raw.length; position++) {
        const character = raw.slice(position, position + 1);
        if(character === '\n') {
            atLineStart = true;
            continue;
        }
        if([' ', '\t', '\r', '\v', '\f'].includes(character)) {
            continue;
        }
        if(atLineStart && character === '/' && ['/', '*'].includes(raw.slice(position + 1, position + 2))) {
            context.range(
                node.pos,
                node.end,
                'react/jsx-no-comment-textnodes',
                'putCommentInBraces',
                messageJsxNoCommentTextnodes,
            );
            return;
        }
        atLineStart = false;
    }
}
