index 0000000..da2f2f9
--- /dev/null
+++ b/stage1/cohere/lint/rules/no-with/rule.ts
@@ -0,0 +1,17 @@
+import type { RuleContext } from '../../context.ts';
+import { message } from './messages.ts';
+import { Finding } from '../../finding.ts';
+
+export class Rule {
+    readonly context: RuleContext;
+    constructor(context: RuleContext) {
+        this.context = context;
+    }
+    visit(index: number): void {
+        const start = this.context.start(index);
+        this.context.findings.push(new Finding('no-with', 'noWith', message, start, start + 4, '', '', ''));
+    }
+}
+export function create(context: RuleContext): Rule {
+    return new Rule(context);
+}
