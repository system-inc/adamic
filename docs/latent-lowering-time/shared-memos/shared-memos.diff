diff --git a/stage3/census/latent/shared_facts_test.go.txt b/stage3/census/latent/shared_facts_test.go.txt
new file mode 100644
index 00000000..43057708
--- /dev/null
+++ b/stage3/census/latent/shared_facts_test.go.txt
@@ -0,0 +1,97 @@
+package lower
+
+import (
+	"github.com/microsoft/TypeScript/tsc/shim/ast"
+	"github.com/microsoft/TypeScript/tsc/shim/checker"
+	"github.com/system-inc/adamic/internal/load"
+	"testing"
+)
+
+// latentSharedFactsWitness is one lowering's facts: an assigned symbol and one proof mode.
+func latentSharedFactsWitness(program *load.Program, checker *checker.Checker) (*lowering, *ast.Symbol, *predicateFixedPoint) {
+	symbol := &ast.Symbol{}
+	point := &predicateFixedPoint{}
+	l := &lowering{program: program, checker: checker}
+	l.assignedSymbols = map[*ast.Symbol]bool{symbol: true}
+	l.predicateProofs = &predicateProofs{modes: map[string]*predicateFixedPoint{"": point}}
+	return l, symbol, point
+}
+
+// The store serves a lowering only under the (program, checker) pair its facts came from, and empties when either
+// pointer changes, so a later lowering under the first pair again recomputes instead of reading facts a different
+// checker's lowering could have left.
+func TestLatentSharedFactsKeyedByProgramAndChecker(t *testing.T) {
+	program, other := new(load.Program), new(load.Program)
+	first, second := new(checker.Checker), new(checker.Checker)
+	shared := &latentSharedFacts{}
+	shared.seed(&lowering{program: program, checker: first})
+	source, symbol, point := latentSharedFactsWitness(program, first)
+	shared.take(source, true)
+
+	same := &lowering{program: program, checker: first}
+	shared.seed(same)
+	if !same.assignedSymbols[symbol] || same.predicateProofs == nil || same.predicateProofs.modes[""] != point {
+		t.Fatal("a lowering of the same program and checker was not seeded")
+	}
+
+	changed := &lowering{program: program, checker: second}
+	shared.seed(changed)
+	if changed.assignedSymbols != nil || changed.predicateProofs != nil {
+		t.Fatal("a lowering of another checker was seeded with the first checker's facts")
+	}
+	back := &lowering{program: program, checker: first}
+	shared.seed(back)
+	if back.assignedSymbols != nil || back.predicateProofs != nil {
+		t.Fatal("the store kept facts across a checker change")
+	}
+
+	shared.take(source, true)
+	elsewhere := &lowering{program: other, checker: first}
+	shared.seed(elsewhere)
+	if elsewhere.assignedSymbols != nil || elsewhere.predicateProofs != nil {
+		t.Fatal("a lowering of another program was seeded")
+	}
+}
+
+// Only a clean unit's facts reach the store: a unit that recovered a panic may hold a partial assigned-symbol map, and a
+// proof mode a seeded lowering adds stays its own until its unit is clean.
+func TestLatentSharedFactsTakeOnlyCleanUnits(t *testing.T) {
+	program := new(load.Program)
+	first := new(checker.Checker)
+	shared := &latentSharedFacts{}
+	shared.seed(&lowering{program: program, checker: first})
+	partial, _, _ := latentSharedFactsWitness(program, first)
+	shared.take(partial, false)
+	if shared.assigned != nil || shared.proofs != nil {
+		t.Fatal("an unclean unit's facts reached the store")
+	}
+
+	source, _, _ := latentSharedFactsWitness(program, first)
+	shared.take(source, true)
+	seeded := &lowering{program: program, checker: first}
+	shared.seed(seeded)
+	seeded.predicateProofs.modes["kind"] = &predicateFixedPoint{}
+	shared.take(seeded, false)
+	if _, found := shared.proofs.modes["kind"]; found {
+		t.Fatal("a mode an unclean unit added reached the store")
+	}
+}
+
+// Registration swallows its panics, but the unit they happen in is no longer clean.
+func TestLatentSwallowMarksTheUnit(t *testing.T) {
+	latentUnitRecovered = false
+	func() {
+		defer latentSwallow()
+		panic("registration")
+	}()
+	if !latentUnitRecovered {
+		t.Fatal("a swallowed panic left its unit clean")
+	}
+	latentUnitRecovered = false
+	func() {
+		defer latentSwallow()
+	}()
+	if latentUnitRecovered {
+		t.Fatal("a unit with no panic was marked")
+	}
+}
