+// latentSharedFacts is one (program, checker) pair's predicate proofs (predicates_proof.go's predicateProofs) and
+// assigned symbols (predicates.go's assignedSymbols), shared by every lowering latentRun's first-error loop makes for
+// that pair (#pv935yw). Both are answers of the program's files and the checker alone: the proof's verifier reads the
+// checker, fieldLiteral, symbol, isPanicCall and enumTagHazardOf, and assignedSymbol reads l.symbol, which reads only
+// the checker. Of fresh()'s inputs, the program and its files hold still across statements: nothing in first-error
+// mode edits or excises source between them (statementrewrite and refusalrewrite rewrite the compiler's Go, not the
+// program; the overlay's Lower, which normalizes async code, never runs; lowering writes IR, never an ast.Node). The
+// checker can change per file, since latentRun takes it from program.Checker per file, so the store is keyed by both
+// pointers and starts empty when either differs: assignedSymbols' keys are the checker's own symbols, and a different
+// checker would miss silently. The entries memo stays per lowering, since its miss runs moduleOrder, which sets
+// cyclicModules on that lowering.
+//
+// A lowering's facts reach the store only when its unit returned normally and recovered no panic anywhere, the
+// registration's swallowed ones included (latentSwallow): assignedSymbol fills its map during its walk, so a walk a
+// panic cut short leaves a partial map that must never serve a later lowering. predicateFixedPoint stores the walk's
+// declarations and each mode only once they are complete, but takes the same rule. A seeded lowering gets the stored
+// assigned symbols as they are (assignedSymbol writes only into a nil map) and its own copy of the proofs' mode table,
+// so a mode a failed unit adds never reaches the store.
+type latentSharedFacts struct {
+	program  *load.Program
+	checker  *checker.Checker
+	proofs   *predicateProofs
+	assigned map[*ast.Symbol]bool
+}
+
+// latentUnitRecovered says the current unit recovered a panic, a swallowed one included.
+var latentUnitRecovered bool
+
+// latentSwallow is registration's recover: a registration error is no finding, but its unit is no longer clean.
+func latentSwallow() {
+	if recover() != nil {
+		latentUnitRecovered = true
+	}
+}
+
+// seed gives l the store's facts when l's program and checker are the store's, and empties the store when not.
+func (shared *latentSharedFacts) seed(l *lowering) {
+	if shared.program != l.program || shared.checker != l.checker {
+		*shared = latentSharedFacts{program: l.program, checker: l.checker}
+		return
+	}
+	if shared.proofs != nil {
+		modes := make(map[string]*predicateFixedPoint, len(shared.proofs.modes))
+		for field, point := range shared.proofs.modes {
+			modes[field] = point
+		}
+		l.predicateProofs = &predicateProofs{declarations: shared.proofs.declarations, modes: modes}
+	}
+	l.assignedSymbols = shared.assigned
+}
+
+// take keeps l's facts when its unit was clean and l's program and checker are still the store's.
+func (shared *latentSharedFacts) take(l *lowering, clean bool) {
+	if !clean || shared.program != l.program || shared.checker != l.checker {
+		return
+	}
+	if l.predicateProofs != nil {
+		shared.proofs = l.predicateProofs
+	}
+	if l.assignedSymbols != nil {
+		shared.assigned = l.assignedSymbols
+	}
+}
+
