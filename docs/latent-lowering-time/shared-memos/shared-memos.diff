@@ -0,0 +1,55 @@
+"""Run the shared-facts overlay test, then each mutant, which must turn it red with its own message.
+
+Usage: audit_shared_facts.py REPOSITORY LATENT_OVERLAY OUTPUT. LATENT_OVERLAY is make_overlay.py's output directory,
+gofmt'd as the meter leaves it, so the mutants' needles are the gofmt'd hook's text.
+"""
+import json, os, subprocess, sys
+from pathlib import Path
+
+repo, overlay, out = map(lambda x: Path(x).resolve(), sys.argv[1:4])
+out.mkdir(parents=True, exist_ok=True)
+config = json.loads((overlay / 'overlay.json').read_text())
+config['Replace'][str(repo / 'internal/lower/latent_shared_facts_test.go')] = str(repo / 'stage3/census/latent/shared_facts_test.go.txt')
+# The overlay cuts production Lower's body, and with it helpers lower's own tests call (lowerChecked and others), so
+# those tests no longer build under it. An empty replacement deletes a file from the build: only this test compiles.
+for production_test in sorted((repo / 'internal/lower').glob('*_test.go')):
+    config['Replace'][str(production_test)] = ''
+hook_key = str(repo / 'internal/lower/latent_hook.go')
+hook = Path(config['Replace'][hook_key]).read_text()
+tests = '^(TestLatentSharedFactsKeyedByProgramAndChecker|TestLatentSharedFactsTakeOnlyCleanUnits|TestLatentSwallowMarksTheUnit)$'
+
+
+def run(name, settings):
+    path = out / (name + '.json')
+    path.write_text(json.dumps(settings))
+    with (out / (name + '.log')).open('w') as log:
+        result = subprocess.run(['go', 'test', '-overlay=' + str(path), './internal/lower', '-timeout', '300s', '-run', tests, '-count=1', '-v'],
+                                cwd=repo, env=dict(os.environ), stdout=log, stderr=subprocess.STDOUT)
+    return result.returncode, (out / (name + '.log')).read_text()
+
+
+code, text = run('baseline', config)
+assert code == 0, text
+print('baseline: PASS')
+for name, needle, replacement, message in [
+    # Shares across a changed checker: the store is keyed by the program alone.
+    ('shares-across-checker-mutant',
+     'if shared.program != l.program || shared.checker != l.checker {\n\t\t*shared = latentSharedFacts{program: l.program, checker: l.checker}',
+     'if shared.program != l.program {\n\t\t*shared = latentSharedFacts{program: l.program, checker: l.checker}',
+     'a lowering of another checker was seeded with the first checker'),
+    # Takes from every unit, the panic path included.
+    ('takes-unclean-mutant', 'if !clean || shared.program != l.program', 'if shared.program != l.program', "an unclean unit's facts reached the store"),
+    # Seeds the store's own mode table, so a failed unit's mode reaches it.
+    ('shares-mode-table-mutant', 'l.predicateProofs = &predicateProofs{declarations: shared.proofs.declarations, modes: modes}',
+     'l.predicateProofs = shared.proofs', 'a mode an unclean unit added reached the store'),
+    # A swallowed registration panic leaves the unit clean.
+    ('swallow-unmarked-mutant', '\tif recover() != nil {\n\t\tlatentUnitRecovered = true\n\t}', '\t_ = recover()', 'a swallowed panic left its unit clean'),
+]:
+    assert hook.count(needle) == 1, (name, needle)
+    mutated = json.loads(json.dumps(config))
+    destination = out / (name + '.go')
+    destination.write_text(hook.replace(needle, replacement, 1))
+    mutated['Replace'][hook_key] = str(destination)
+    code, text = run(name, mutated)
+    assert code != 0 and message in text, (name, text[-2000:])
+    print(name + ': caught (' + message + ')')
