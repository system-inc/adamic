interface Box { flag: boolean | undefined }
function box(flag: boolean | undefined): Box { return { flag: flag }; }
function show(value: unknown): void {
    if (typeof value === 'object' && value !== null && 'flag' in value) {
        console.log(typeof value.flag);
        if (typeof value.flag === 'boolean') { console.log(String(value.flag)); }
    }
}
show(box(false));
show(box(true));
show(box(undefined));
