// Spec: A downcast to a member of a discriminated union is no exception
// Expect: notyet a TypeAssertionExpression
type Shape = { readonly kind: 'Circle'; readonly radius: number } | { readonly kind: 'Square'; readonly side: number };
const shapes: readonly Shape[] = [{ kind: 'Circle', radius: 2 }];
for (const shape of shapes) {
	const circle = <Extract<Shape, { kind: 'Circle' }>>shape;
	console.log(`${circle.radius}`);
}
