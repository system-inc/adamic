import type {HttpRequest,HttpResponse} from 'adamic/http';
import type {KvNamespace} from 'adamic/workers';
interface Environment {readonly GREETING:string; readonly KV:KvNamespace}
function* steps(kv:KvNamespace):Generator<number> { yield 1; }
export function handle(request:HttpRequest,environment:Environment):HttpResponse {
let total=0;
for (const step of steps(environment.KV)) { total+=step; }
return {status:200,headers:[],body:environment.GREETING+request.path+total};
}
