import type {HttpRequest,HttpResponse} from 'adamic/http';
import type {KvNamespace} from 'adamic/workers';
interface Environment {readonly GREETING:string; readonly KV:KvNamespace}
async function read(kv:KvNamespace,k:string):Promise<string | null> { return await kv.get(k); }
export async function handle(request:HttpRequest,environment:Environment):Promise<HttpResponse> {
const value = await read(environment.KV, request.path);
return {status:200,headers:[],body:value === null ? "none" : value};
}
