import type {HttpRequest,HttpResponse} from 'adamic/http';
import type {KvNamespace} from 'adamic/workers';
type Cached=KvNamespace;
interface Environment {readonly GREETING:string; readonly KV:Cached}
export function handle(request:HttpRequest,environment:Environment):HttpResponse {const kv:Cached=environment.KV; return {status:200,headers:[],body:request.path};}
