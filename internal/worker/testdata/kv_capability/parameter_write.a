import type {HttpRequest,HttpResponse} from 'adamic/http';
import type {KvNamespace} from 'adamic/workers';
interface Environment {readonly GREETING:string; readonly KV:KvNamespace}

export function handle(request:HttpRequest,{KV,GREETING}:Environment):HttpResponse {
KV={get:async(key:string):Promise<string|null>=>null,put:async(key:string,value:string):Promise<void>=>{},delete:async(key:string):Promise<void>=>{}};
return {status:200,headers:[],body:GREETING+request.path};
}
