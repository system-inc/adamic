import * as fs from "node:fs";
import type { HttpRequest, HttpResponse } from "adamic/http";
function changed(_curr:fs.Stats,_prev:fs.Stats):void {}
export function hostPolling(): string { fs.watchFile('x', {persistent:true, interval:250}, changed); return "polling"; }
export function handle(_request:HttpRequest):HttpResponse {return {status:200,headers:[],body:hostPolling()};}
