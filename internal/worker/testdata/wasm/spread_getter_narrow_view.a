// A Wasm function whose spread may run an object literal's getter that writes a module global, the literal
// seen through { readonly label: string }, narrower than its own type (#z6h9s7k). The getter is part of
// what the spread runs, so compute is impure.
import type { HttpRequest, HttpResponse } from "adamic/http";
let state = 1;
const source = {
    get value(): number {
        state = 2;
        return 10;
    },
    label: `source${String(1)}`,
};
export function compute(extra: { readonly label: string }): number {
    const copy = { ...extra };
    return copy.label.length;
}
export function handle(request: HttpRequest): HttpResponse {
    return { status: 200, headers: [], body: String(compute(source)) };
}
