import { panic, utf8At, utf8Length } from 'adamic';
import type { HttpRequest, HttpResponse } from 'adamic/http';

export function handle(request: HttpRequest): HttpResponse {
    if(request.path === '/panic') {
        panic('route exploded');
    }
    if(request.path === '/utf8-panic') {
        utf8At(request.body, -1);
    }
    const bytes: number[] = [];
    for(let index = 0; index < utf8Length(request.body); index += 1) {
        bytes.push(utf8At(request.body, index));
    }
    return { status: 200, headers: [], body: `${utf8Length(request.body)}:${bytes.join(',')}` };
}
