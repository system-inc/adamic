import type {HttpRequest,HttpResponse} from 'adamic/http';
interface Environment {readonly ZONE:string;readonly GREETING:string}
interface Unrelated {readonly ZONE:string} function read(value:Unrelated):void {console.log(Object.keys(value).join(","));}
export function handle(request:HttpRequest,environment:Environment):HttpResponse {read({ZONE:"z"});return {status:200,headers:[],body:request.path};}
