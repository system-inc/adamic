import type {HttpRequest,HttpResponse} from 'adamic/http';
interface Environment {readonly ZONE:string;readonly GREETING:string}
function ignore<T>(...values:T[]):void {void values;}
export function handle(request:HttpRequest,environment:Environment):HttpResponse {ignore<Environment>({ZONE:"program",GREETING:"value"},environment);return {status:200,headers:[],body:request.path};}
