import { panic } from 'adamic';
import type { HttpRequest, HttpResponse } from 'adamic/http';

// A finally runs on every way out of its try but a panic's: /count reads how many times it ran.
let finallies = 0;

export function handle(request: HttpRequest): HttpResponse {
    if(request.path === '/count') {
        return { status: 200, headers: [], body: `${finallies}` };
    }
    try {
        if(request.path === '/panic') {
            panic('panic inside try with a finally');
        }
        return { status: 200, headers: [], body: 'no panic' };
    } finally {
        finallies += 1;
    }
}
