import { decodeJson } from 'adamic';
import type { HttpRequest, HttpResponse } from 'adamic/http';

interface Input { readonly name: string; readonly count: number; readonly note?: string; }
export function handle(request: HttpRequest): HttpResponse {
	const result = decodeJson<Input>(request.body);
	if (result.kind === 'Error') return { status: 400, headers: [], body: result.message };
	return { status: 200, headers: [{ name: 'x-decoded', value: 'yes' }], body: `${result.value.name}:${result.value.count}:${result.value.note ?? '-'}` };
}
