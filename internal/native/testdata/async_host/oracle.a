// External scheduling witness, run directly by Node, outside the compiler subset.
const mode = process.argv[2];
let resolve;
let reject;
const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
const result = { body: 'fetch 世界\0tail', status: 201.5 };
for (let index = 0; index < 2; index++) {
    promise.then((value) => {
        if (value.body !== result.body || value.status !== result.status) throw new Error('payload mismatch');
        console.log('fulfilled');
    }, (error) => {
        if (error.message !== 'network failed') throw new Error('error mismatch');
        console.log('rejected');
    });
}
if (mode === 'early') resolve(result);
else setTimeout(() => mode === 'reject' ? reject(new Error('network failed')) : resolve(result), 50);
console.log('prefix');
await promise.catch(() => {});
console.log(`${mode} clean`);
