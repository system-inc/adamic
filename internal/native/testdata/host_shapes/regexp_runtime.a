// A regular expression compiled at run time is regexp_compile_ownership.c's regex_owned_shape, and its
// groups object the run-time compiler's shape (regexp_compile_bytecode.c, regexp_compile_runtime.c),
// each marked host. Lowering doesn't yet take a pattern that isn't a constant, so no program makes
// either. host_shapes_test.go requires this program refused in exactly those words; when they lift,
// the shapes need stop fixtures.
function propertyOf(value: unknown, key: string): unknown {
	if (value === null || value === undefined) {
		throw new TypeError(`Cannot read properties of ${value === null ? 'null' : 'undefined'} (reading '${key}')`);
	}
	return Reflect.get(Object(value), key, value);
}

const pattern = new RegExp(['(?<letter>', 'x)'].join(''));
const match = pattern.exec('x');
console.log(`${typeof propertyOf(pattern, 'source')} ${typeof propertyOf(match?.groups, 'letter')}`);
