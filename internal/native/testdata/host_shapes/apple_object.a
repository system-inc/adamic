// An Apple object is foreign.c's foreign_shape, marked host. Lowering doesn't view an Apple object as
// unknown, so no program reads one by a run-time key. host_shapes_test.go requires this program
// refused in exactly those words; when they lift, the shape needs a stop fixture. RunLoop's binding is
// embedded (internal/load/apple/corefoundation/run-loop.d.ts), so this loads with no SDK.
import { RunLoop } from 'apple/corefoundation/run-loop';

function propertyOf(value: unknown, key: string): unknown {
	if (value === null || value === undefined) {
		throw new TypeError(`Cannot read properties of ${value === null ? 'null' : 'undefined'} (reading '${key}')`);
	}
	return Reflect.get(Object(value), key, value);
}

console.log(typeof propertyOf(RunLoop.main, 'stop'));
