// A Hash is node_crypto.c's shape, marked host. Lowering doesn't yet view an object with a nullable
// field as unknown, so no program reads one by a run-time key. host_shapes_test.go requires this
// program refused in exactly those words; when they lift, the shape needs a stop fixture.
import { createHash } from 'node:crypto';

function propertyOf(value: unknown, key: string): unknown {
	if (value === null || value === undefined) {
		throw new TypeError(`Cannot read properties of ${value === null ? 'null' : 'undefined'} (reading '${key}')`);
	}
	return Reflect.get(Object(value), key, value);
}

console.log(typeof propertyOf(createHash('sha256'), 'update'));
