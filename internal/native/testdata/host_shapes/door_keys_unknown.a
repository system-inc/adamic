// Object.keys of a host value viewed as unknown is NotYet, so only a typed host reaches
// adamic_object_keys, which stops on it. host_shapes_test.go requires this program refused in
// exactly those words.
import * as fs from 'node:fs';
const seen: unknown = fs.statSync('.');
if (typeof seen === 'object' && seen !== null) {
	const keys = Object.keys(seen);
	console.log(`keys ${keys.includes('dev')} ${keys.includes('_fsFileMode')}`);
}
