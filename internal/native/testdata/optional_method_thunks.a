interface OptionalView { read(flag?: boolean): string; }
class OptionalReader {
    read(flag = true): string { return flag ? 'yes' : 'no'; }
}
function read(view: OptionalView): string {
    return `${view.read()} ${view.read(undefined)} ${view.read(false)}`;
}
console.log(read(new OptionalReader()));
interface Facade { readonly marker: number; run(flag: boolean): string; }
class SameSignature {
    run(flag = true): string { return flag ? 'unused yes' : 'unused no'; }
}
const unused = new SameSignature();
console.log(unused.run(false));
function facade(view: Facade): string { return view.run(false); }
console.log(facade({marker: 1, run: flag => flag ? 'facade yes' : 'facade no'}));

class BaseReader {
    inherited(flag = true): string { return flag ? 'base yes' : 'base no'; }
}
class DerivedReader extends BaseReader { readonly marker = 1; }
interface DerivedView { readonly marker: number; inherited(flag?: boolean): string; }
function inherited(view: DerivedView): string { return view.inherited(false); }
console.log(inherited(new DerivedReader()));
