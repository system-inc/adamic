// a-check: type error TS2322
const edges = [300, -1, 255, 256, NaN, Infinity, -Infinity, -0,
	2 ** 31, 2 ** 32, -(2 ** 31) - 1, 1.9, -1.9, 255.9, -256.9,
	4294967295.9, -4294967296.9, 1e100, -1e100, 2 ** 53, Number.MIN_VALUE];
function number(value) { console.log(Object.is(value, -0) ? '-0' : String(value)); }
function show(array) { number(array.length); for (const value of array) { number(value); } }
function sequence(Type) { return new Type([1, 2, 3, 4, 5, 6]); }
for (const Type of [Uint8Array, Int32Array, Float64Array]) {
	let array = new Type(edges); show(array);
	for (let index = 0; index < edges.length; index++) { array[index] = edges[index]; } show(array);
	const copied = new Type(array.length); copied.set(array); show(copied);
	const filled = new Type(1); for (const value of edges) { filled.fill(value); show(filled); }
	for (const index of [-1, 0.5, NaN, Infinity, -Infinity, array.length, 1e100]) { number(array[index]); }
	number(array[-0]);
	for (const length of [0, NaN, -0, -0.9, 3.9]) { show(new Type(length)); }
	array = sequence(Type); let view = array.subarray(1, -1);
	view[0] = 300; show(array); array[2] = -1; show(view);
	const nested = view.subarray(1); show(nested); view = undefined; array = undefined;
	show(nested); nested[0] = 42; show(nested);
	const indexes = [-Infinity, -99, -6, -2.9, -0, NaN, 0.9, 2.9, 6, 99, Infinity];
	for (const first of indexes) { for (const last of indexes) {
		array = sequence(Type); array.fill(300, first, last); show(array); show(array.subarray(first, last));
	} }
	array = sequence(Type); array.fill(-1); show(array); array.fill(-0, -2); show(array);
	for (const offset of [0, -0.5, NaN, 1.9, 2]) {
		array = sequence(Type); view = array.subarray(0, 4); array.set(view, offset); show(array);
	}
	array = sequence(Type); view = array.subarray(2); array.set(view); show(array); view.set(view, 0); show(view);
	const empty = array.subarray(6); array.set(empty, 6);
	const iterator = array.values(); number(iterator.next().value); view[0] = 77;
	view = undefined; array = undefined; for (const value of iterator) { number(value); }
	array = new Type(0); view = array.subarray(0); array = undefined; show(view);
}
console.log('balanced');
