import { fileStatus, readDirectory, readTextFile, writeTextFile } from 'adamic';

const read = readTextFile('files/input.txt');
console.log(read.kind === 'Ok' ? read.text : read.message);
const written = writeTextFile('files/output.txt', 'response 世界');
console.log(written.kind);
const again = readTextFile('files/output.txt');
console.log(again.kind === 'Ok' ? again.text : again.message);
const listing = readDirectory('files');
console.log(listing.kind === 'Ok' ? listing.names.join(',') : listing.message);
const status = fileStatus('files/output.txt');
console.log(status.kind === 'Ok' ? `${status.type} ${status.size} ${status.symbolicLink}` : status.message);
const empty = writeTextFile('', 'not written');
console.log(empty.kind === 'Error' ? empty.message : 'unexpected write');
