const size = 1000000;
const values = new Float64Array(size);
let state = 42;
for (let index = 0; index < size; index += 1) {
    state = (state * 1664525 + 1013904223) >>> 0;
    values[index] = state % 1000001 - 500000;
}
const started = process.cpuUsage();
values.sort();
const usage = process.cpuUsage(started);
console.error(`sort_user=${(usage.user / 1000000).toFixed(6)}`);
let sum = 0;
let previous = -Infinity;
let ordered = true;
for (const value of values) {
    ordered = ordered && previous <= value;
    previous = value;
    sum += value;
}
console.log(`${values.length} ${values[0]} ${values[size - 1]} ${sum} ordered ${ordered}`);
