diff --git astage1/typescript/parser/numeric_kind.a bstage1/typescript/parser/numeric_kind.a
new file mode 100644
index 0000000..5a457f5
--- /dev/null
+++ bstage1/typescript/parser/numeric_kind.a
@@ -0,0 +1,11 @@
+// Scratch prototype: cache a numeric kind once when each immutable parse node is built.
+const numericKinds = new Map<string, number>();
+export function numericKind(kind: string): number {
+    const known = numericKinds.get(kind);
+    if(known !== undefined) {
+        return known;
+    }
+    const value = numericKinds.size;
+    numericKinds.set(kind, value);
+    return value;
+}
