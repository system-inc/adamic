const original = { x: 1, y: true };
const view: { x: number } = original;
const wider: { x: number; y?: number } = view;
console.log(`${wider.y === undefined}`);
console.log(`${wider.y !== undefined}`);
console.log(`${(wider.y ?? 0) * 10}`);
console.log(`${(wider.y ?? 0) > 0}`);
console.log(`${wider.y === 1}`);
