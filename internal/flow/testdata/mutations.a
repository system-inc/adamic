// Every way a value can be mutated through another, each in a function whose own values nothing
// else reaches, so the only thing that can make a range cover the mutation is the alias graph
// getting it right: through a field read out of it, an element read out of it, a for...of's element,
// a map's value, a conditional's either side, a container holding it, and a callee handed it. Each
// function's last line reads the value, so the mutation is observable on Node too.
interface Counter {
	count: number;
}

interface Box {
	inner: Counter;
}

function throughField(): number {
	const box: Box = { inner: { count: 1 } };
	const inner = box.inner;
	inner.count = 5;
	return box.inner.count;
}

function throughElement(): number {
	const counters: Counter[] = [{ count: 1 }, { count: 2 }];
	const first = counters[0] ?? { count: 0 };
	first.count += 10;
	return (counters[0] ?? { count: 0 }).count;
}

function throughLoop(): number {
	const counters: Counter[] = [{ count: 1 }, { count: 2 }, { count: 3 }];
	for (const counter of counters) {
		counter.count *= 2;
	}
	let total = 0;
	for (let index = 0; index < counters.length; index++) {
		total += (counters[index] ?? { count: 0 }).count;
	}
	return total;
}

function throughMap(): number {
	const byName = new Map<string, Counter>();
	byName.set('a', { count: 1 });
	const found = byName.get('a') ?? { count: 0 };
	found.count = 7;
	return (byName.get('a') ?? { count: 0 }).count;
}

function throughConditional(pick: boolean): number {
	const left: Counter = { count: 1 };
	const right: Counter = { count: 2 };
	const chosen = pick ? left : right;
	chosen.count = 9;
	return left.count + right.count;
}

function throughHolder(): number {
	const counter: Counter = { count: 1 };
	const holder: Counter[] = [counter];
	const again = holder[0] ?? { count: 0 };
	again.count = 4;
	return counter.count;
}

function bump(counter: Counter): void {
	counter.count++;
}

function throughCall(): number {
	const counter: Counter = { count: 1 };
	bump(counter);
	return counter.count;
}

function throughPush(): number {
	const counters: Counter[] = [];
	const counter: Counter = { count: 3 };
	counters.push(counter);
	counter.count = 8;
	return (counters[0] ?? { count: 0 }).count;
}

console.log(`${throughField()} ${throughElement()} ${throughLoop()} ${throughMap()}`);
console.log(`${throughConditional(true)} ${throughConditional(false)} ${throughHolder()} ${throughCall()} ${throughPush()}`);
