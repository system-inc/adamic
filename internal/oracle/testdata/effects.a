let log = '';
let counter = 0;

function note(label: string): boolean {
	log = log + label;
	counter += 1;
	return label === 'a' || label === 'c';
}

function bump(): number {
	counter += 10;
	return counter;
}

function label(): string {
	return `#${counter}`;
}

function shout(text: string): void {
	console.log(text + '!');
	if (counter > 1000) {
		return;
	}
	log = log + text;
}

const first = note('a') && note('b');
const second = note('c') || note('d');
const third = note('x') && note('never');
const fourth = note('y') ? note('c') : note('z');
console.log(`${first} ${second} ${third} ${fourth} ${log} ${counter}`);
const ordered = counter + bump() + counter;
console.log(`${ordered} ${counter}`);
const words = `${label()} ${bump()} ${label()}`;
console.log(words);
shout('hey');
console.log(log);
