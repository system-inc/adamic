for (const text of [accent, emoji, latin]) {
 console.log(text);
 console.log(`${text.length} ${utf8Length(text)}`);
 let sum = 0;
 for (let index = 0; index < utf8Length(text); index += 1) {
  sum += utf8At(text, index);
 }
 console.log(`${sum} ${text.charCodeAt(text.length - 1)} ${text.codePointAt(4094) ?? -1}`);
 console.log(text.slice(-4));
 console.log(`${text === text.slice(0)} ${text.includes('é')} ${text.includes('🌍')}`);
}
const numbers: number[] = [];
const booleans: boolean[] = [];
const number = numbers.pop();
const boolean = booleans.pop();
console.log(`${number ?? 42} ${boolean ?? true}`);
