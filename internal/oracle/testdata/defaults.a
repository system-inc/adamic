// Optional and default parameters: a default runs, in order, only when its argument is undefined.
let made = 0;
function nextStep(): number {
	made++;
	return 10 * made;
}

// Called before it's declared, with each argument left out in turn.
console.log(`${shout('hey')} ${shout('hey', 2)} ${shout('hey', undefined, '?')}`);

function shout(word: string, times = 3, mark = word.slice(0, 1)): string {
	return `${word.repeat(times)}${mark}`;
}

function step(from: number, by = nextStep()): number {
	return from + by;
}
console.log(`${step(1)} ${step(1, 5)} ${step(1)} ${step(1, undefined)} made ${made}`);

function show(value?: number, note?: string): string {
	return `${value ?? -1}/${note ?? 'none'}`;
}
console.log(`${show()} ${show(4)} ${show(4, 'four')} ${show(undefined, 'x')}`);

interface Options {
	size: number;
}
function grow(options: Options = { size: 1 }): number {
	options.size += 1;
	return options.size;
}
// A default object is made each call, so the second call starts fresh.
const mine: Options = { size: 10 };
console.log(`${grow()} ${grow()} ${grow(mine)} ${grow(mine)}`);

class Greeter {
	greeting: string;
	constructor(greeting = 'hello') {
		this.greeting = greeting;
	}
	greet(name = 'world', times = 1): string {
		return `${this.greeting} ${name}`.repeat(times);
	}
}
console.log(new Greeter().greet());
console.log(new Greeter('hi').greet('Ken', 2));
