import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
// persistent: false keeps nothing alive: the program ends before its events are read.
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-'));
fs.watch(directory, {persistent: false}, (eventType, filename) => { console.log(`wrong ${eventType} ${filename ?? 'null'}`); });
fs.writeFileSync(join(directory, 'b.txt'), 'b');
fs.rmSync(directory, {recursive: true, force: true});
console.log('unref exits');
