import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
// Workers' program (#7s8hgd5). Closing the only persistent watcher leaves a pending close, as
// uv_close does, so the loop takes one more turn that never blocks, and the persistent: false
// watcher's events, queued by the unlink, arrive in it after 'unref exits'. The directory goes
// before the loop, since its removal is no event of the file's watch.
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-pending-'));
const file = join(directory, 'file');
fs.writeFileSync(file, 'changed');
fs.watch(file, {persistent: false}, (eventType, filename) => { console.log(`${eventType} ${filename ?? 'null'}`); });
const watcher = fs.watch(file, {persistent: true}, (eventType, filename) => { console.log(`wrong ${eventType} ${filename ?? 'null'}`); });
fs.unlinkSync(file);
watcher.close();
fs.rmSync(directory, {recursive: true, force: true});
console.log('unref exits');
