import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-micro-close-'));
const file = join(directory, 'same.txt');
fs.writeFileSync(file, 'one');
const first = fs.watch(file, {persistent: true}, async () => {
 console.log('first');
 await Promise.resolve();
 second.close(); first.close();
 fs.rmSync(directory, {recursive: true, force: true});
});
const second = fs.watch(file, {persistent: true}, () => { console.log('closed sibling fired'); });
fs.writeFileSync(file, 'two');
