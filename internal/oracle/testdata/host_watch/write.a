import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
// The watched file itself: a write that truncates and writes, then its unlink, a change for its link
// count, a rename as it goes and another as its watch goes. Every self event names its basename.
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-'));
const file = join(directory, 'a.txt');
fs.writeFileSync(file, 'one');
let renames = 0;
const watcher = fs.watch(file, {persistent: true}, changed);
function changed(eventType: string, filename: string | null): void {
 console.log(`${eventType} ${filename ?? 'null'}`);
 if (eventType === 'rename') renames++;
 if (renames === 2) {
  watcher.close();
  fs.rmSync(directory, {recursive: true, force: true});
 }
}
fs.writeFileSync(file, 'two');
fs.unlinkSync(file);
