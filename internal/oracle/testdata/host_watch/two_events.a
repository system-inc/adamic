import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
// Two events read together: Node runs the first listener's microtask before the second listener.
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-'));
let seen = 0;
const watcher = fs.watch(directory, {persistent: true}, async (_eventType, filename) => {
 console.log(filename ?? 'null');
 seen++;
 if (seen === 2) {
  watcher.close();
  fs.rmSync(directory, {recursive: true, force: true});
 }
 await Promise.resolve();
 console.log('micro');
});
fs.writeFileSync(join(directory, 'a'), '');
fs.writeFileSync(join(directory, 'b'), '');
