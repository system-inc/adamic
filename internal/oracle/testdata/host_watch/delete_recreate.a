import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-recreate-'));
const file = join(directory, 'again.txt');
fs.writeFileSync(file, 'one');
let renames = 0;
let fresh: fs.FSWatcher | undefined = undefined;
const original = fs.watch(file, {persistent: true}, (eventType, filename) => {
 console.log(`old ${eventType} ${filename ?? 'null'}`);
 if (eventType === 'rename') renames++;
 if (renames === 2) {
  original.close();
  recreate();
 }
});
function recreate(): void {
 fs.writeFileSync(file, 'two');
 fresh = fs.watch(file, {persistent: true}, (eventType, filename) => {
  console.log(`new ${eventType} ${filename ?? 'null'}`);
  if (fresh !== undefined) fresh.close();
  fs.rmSync(directory, {recursive: true, force: true});
 });
 fs.writeFileSync(file, 'three');
}
fs.unlinkSync(file);
