import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
// fs.unwatchFile closes Node's StatWatcher, a uv_fs_poll handle, through uv_close, so it leaves a
// pending close as a watcher's close does: the persistent: false watcher's queued events arrive.
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-'));
const file = join(directory, 'file');
fs.writeFileSync(file, 'changed');
fs.watch(file, {persistent: false}, (eventType, filename) => { console.log(`${eventType} ${filename ?? 'null'}`); });
function polled(_curr: fs.Stats, _prev: fs.Stats): void { console.log('wrong poll'); }
fs.watchFile(file, {persistent: true, interval: 10}, polled);
fs.unlinkSync(file);
fs.unwatchFile(file);
fs.rmSync(directory, {recursive: true, force: true});
console.log('unwatched');
