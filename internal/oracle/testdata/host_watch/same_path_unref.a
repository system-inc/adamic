import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-fswatch-unref-'));
const first = fs.watch(directory, {persistent: true}, () => { console.log('closed handle fired'); });
const second = fs.watch(directory, {persistent: false}, () => { console.log('unreferenced handle fired'); });
first.close();
console.log('done');
// Teardown owns the still-open unreferenced handle; no pending event runs.
fs.rmSync(directory, {recursive: true, force: true});
