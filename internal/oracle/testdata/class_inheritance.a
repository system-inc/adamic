import type { Weak } from 'adamic';

let order = '';
function mark(label: string): string {
    order = order + label + '|';
    return label + `${order.length}`;
}

abstract class Root {
    readonly rootLabel = mark('root field');
    constructor(value: number) {
        mark(`root body ${value}`);
    }
    abstract kind(): string;
    describe(): string {
        return 'root/' + this.kind();
    }
    number(value: number): number {
        return value + 1;
    }
}
class Middle extends Root {
    readonly middleLabel = mark('middle field');
    readonly inheritedCopy = this.rootLabel + '/copy';
    constructor(value: number) {
        mark('before middle super');
        super(value + 1);
        mark('middle body');
    }
    override kind(): string {
        return 'middle';
    }
    override describe(): string {
        return super.describe() + '/middle';
    }
    override number(value: number): number {
        return super.number(value) + 10;
    }
}
class Leaf extends Middle {
    readonly leafLabel = mark('leaf field');
    parent: Weak<Root> = undefined;
    constructor(value: number) {
        mark('before leaf super');
        super(value + 1);
        mark('leaf body');
    }
    override kind(): string {
        return 'leaf';
    }
    override describe(): string {
        return super.describe() + '/leaf';
    }
    override number(value: number): number {
        return super.number(value) + 100;
    }
}
function throughBase(value: Root): string {
    return `${value.describe()} ${value.number(2)}`;
}
const parent = new Middle(3);
const child = new Leaf(5);
child.parent = parent;
console.log(order);
const values: readonly Root[] = [parent, child];
for(const value of values) {
    console.log(throughBase(value));
    console.log(`${value instanceof Root} ${value instanceof Middle} ${value instanceof Leaf}`);
}
const back = child.parent;
if(back !== undefined) {
    console.log(throughBase(back));
}
console.log(`${child.rootLabel}|${child.middleLabel}|${child.leafLabel}|${child.inheritedCopy}`);
class DefaultLeaf extends Leaf {}
const defaultLeaf = new DefaultLeaf(1);
console.log(`${throughBase(defaultLeaf)} ${defaultLeaf instanceof Root} ${defaultLeaf instanceof DefaultLeaf}`);
const plain = { rootLabel: 'plain' };
console.log(`${plain instanceof Root}`);

class PrivateBase {
    #value = `base${1}`;
    baseValue(): string {
        return this.#value;
    }
}
class PrivateChild extends PrivateBase {
    #value = `child${2}`;
    childValue(): string {
        return this.#value;
    }
}
const privateChild = new PrivateChild();
console.log(privateChild.baseValue() + '/' + privateChild.childValue());
