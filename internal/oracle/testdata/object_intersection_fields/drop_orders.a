// A copy made by spreading an intersection's base holds its object and array fields once more: the
// original dropped first while the copy lives on, then the copy dropped first while the original does.
interface Label { readonly text: string; }
interface Base { readonly kind: 1; readonly label: Label; }
type Tagged = Base & { readonly tags: readonly string[] };
function keepCopy(text: string): Tagged {
    const original: Base = { kind: 1, label: { text: text } };
    const copy: Tagged = { ...original, tags: [text + '!'] };
    return copy;
}
function keepOriginal(text: string): Base {
    const original: Base = { kind: 1, label: { text: text } };
    const copy: Tagged = { ...original, tags: [text, text] };
    console.log(`${copy.label.text} ${copy.tags.length} ${copy.label === original.label}`);
    return original;
}
const copied = keepCopy('built' + '-first');
console.log(`${copied.label.text} ${copied.tags[0]}`);
const kept = keepOriginal('built' + '-second');
console.log(kept.label.text);
