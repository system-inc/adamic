// Constants a format can't fail on, and arguments left out: nothing here can throw, so no call is
// followed by a check and no function is one that can throw.
function shown(value: number): string {
	const fixed = `${value.toFixed(0)} ${value.toFixed(2)} ${value.toFixed(100).length} ${value.toFixed()}`;
	const exponential = `${value.toExponential(0)} ${value.toExponential(100).length} ${value.toExponential()}`;
	const precision = `${value.toPrecision(1)} ${value.toPrecision(100).length} ${value.toPrecision()}`;
	const radix = `${value.toString(2)} ${value.toString(36)} ${value.toString()}`;
	return `${fixed} | ${exponential} | ${precision} | ${radix}`;
}
for (const value of [1.5, -0.25, 255]) {
	try {
		console.log(shown(value));
	} catch {
		console.log('never');
	}
}
