// Constants a format can't fail on, and arguments left out: nothing here can throw, so no call is
// followed by a check and no function is one that can throw. Each is written on a line of its own:
// a template joining them could be longer than V8's longest string, so it checks
// (ir/string_throws.go).
function shown(value: number): void {
	console.log(value.toFixed(0));
	console.log(value.toFixed(2));
	console.log(value.toFixed(100).length);
	console.log(value.toFixed());
	console.log(value.toExponential(0));
	console.log(value.toExponential(100).length);
	console.log(value.toExponential());
	console.log(value.toPrecision(1));
	console.log(value.toPrecision(100).length);
	console.log(value.toPrecision());
	console.log(value.toString(2));
	console.log(value.toString(36));
	console.log(value.toString());
}
for (const value of [1.5, -0.25, 255]) {
	try {
		shown(value);
	} catch {
		console.log('never');
	}
}
