import { parallelMap } from 'adamic';
interface Ring { value: number; next: Ring | undefined; }
function run(): void {
 const ring: Ring = { value: 1, next: { value: 2, next: undefined } };
 ring.next!.next = ring;
 const items = [ring];
 const results = parallelMap(items, item => { item.value += 1; return item; });
 console.log(`${results[0]!.value} ${results[0]!.next!.next!.value}`);
}
run();
