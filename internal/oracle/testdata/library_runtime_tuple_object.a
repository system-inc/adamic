interface Root { readonly kind: 'Holder'; }
interface View extends Root { readonly value: readonly [string, number]; }
function printPair(pair: [string, number]): void {
 const raw = {kind: 'Holder' as const, value: pair};
 const base: Root = raw;
 const view = base as View;
 console.log(`${view.value[0]}:${view.value[1]}`);
}
const source = {first: 1, second: 2};
for (const pair of Object.entries(source)) printPair(pair);
function enumerate(view: {readonly first: number}): void {
 for (const pair of Object.entries(view)) printPair(pair);
}
enumerate(source);
