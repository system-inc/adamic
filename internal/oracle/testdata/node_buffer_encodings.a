import { Buffer } from 'node:buffer';
function base64encode(input: string): string { return Buffer.from(input).toString('base64'); }
function base64decode(input: string): string { return Buffer.from(input, 'base64').toString('utf8'); }
for (const text of ['', 'a', 'ab', 'abc', 'abcd', 'héllo 🌍', '\ud800', '\udfff', 'a\u0000b']) {
 console.log(base64encode(text));
 console.log(base64decode(base64encode(text)));
 console.log(Buffer.from(text).toString('hex'));
 console.log(Buffer.from(text, 'utf16le').toString('ucs2'));
}
for (const text of [' Y W J j \n', 'YQ==', 'YQ', 'YWI=', 'YWI', 'Y', 'Y===Q', '=YQ==', 'YW!Jj', '-_8=', 'ab=c', 'a===', '\u0141Q==', '\u013dYWJj']) {
 console.log(Buffer.from(text, 'base64').toString('hex'));
 console.log(base64decode(text));
}
for (const text of ['00ff', 'abc', 'a!12', '12!345', 'ABCD', '\u0130\u0130']) { console.log(Buffer.from(text, 'hex').toString('hex')); }
const bytes = Buffer.from('a🌍b');
for (const offset of [-1, 0, 1, 2, 3, 4, 5, 6, 7, 100, NaN, Infinity, 1.9]) {
 console.log(bytes.toString('utf8', offset));
 console.log(bytes.toString('base64', offset, 5));
}
