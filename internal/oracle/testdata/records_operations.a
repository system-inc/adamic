interface Values { [key: string]: number }
const r: Values = {};
r['b'] = 4;
r['10'] = 10;
r['2'] = 2;
r['a'] = 1;
r['01'] = 11;
r['4294967294'] = 9;
r['4294967295'] = 8;
console.log(Object.keys(r).join(','));
console.log(Object.values(r).join(','));
console.log(Object.entries(r).map(e => e[0] + ':' + String(e[1])).join(','));
console.log(String(r['missing']));
console.log(String('missing' in r));
console.log(String('a' in r));
console.log(String(delete r['b']));
console.log(String(delete r['missing']));
r['b'] = 5;
r['2'] = 22;
console.log(Object.keys(r).join(','));
const copy: Values = {...r, extra: 6};
console.log(String(JSON.stringify(copy)));
for (const key in copy) { console.log(key); }
const protoKey = '__proto__';
const own: Values = {[protoKey]: 7, ['toString']: 3};
console.log(Object.keys(own).join(','));
console.log(String(own[protoKey]));
console.log(String(Object.hasOwn(own, 'toString')));
console.log(String(JSON.stringify(own)));
const spread: Values = {...own};
console.log(String(JSON.stringify(spread)));
