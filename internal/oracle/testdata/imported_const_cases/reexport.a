import { NEGATIVE } from './constants.a';
import { NUMBER as REEXPORTED, WORD } from './barrel.a';
function numeric(value: number): string {
	switch (value) {
		case REEXPORTED: return 'reexported number';
		case NEGATIVE: return 'direct number';
		default: return 'other';
	}
}
function text(value: string): string {
	switch (value) {
		case WORD: return 'reexported word';
		default: return 'other';
	}
}
console.log(`${numeric(-2)} ${numeric(17)} ${numeric(99)} ${text('alpha')} ${text('other')}`);
