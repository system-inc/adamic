// a6 (#snypn8c, c1, part 2): a left that can only be truthy, 1 or true, never reaches the && result, so only the
// right is written into the member slot. tsc refuses "a" on an && left (TS2872, always truthy), so no string row.
enum Ternary { False = 0, Unknown = 1, Maybe = 3, True = -1 }
function checked(n: number): Ternary.True {
	if (n < 0) {
		throw new Error("negative");
	}
	return Ternary.True;
}
function one(n: number): Ternary.True {
	return 1 && checked(n);
}
function yes(n: number): Ternary.True {
	return true && checked(n);
}
console.log(String(one(1)) + ", " + String(yes(2)));
