const log: string[] = [];
const values: number[] = [1, 2];
console.log(String(values.forEach((value: number): void => { log.push(String(value)); }) === undefined));
const map = new Map<string, number>([['key', 3]]);
console.log(String(map.forEach((value: number): void => { log.push(String(value)); }) === undefined));
console.log(String(map.clear() === undefined));
console.log(String(map.size));
const set = new Set<number>([4]);
console.log(String(set.forEach((value: number): void => { log.push(String(value)); }) === undefined));
console.log(String(set.clear() === undefined));
console.log(String(set.size));
console.log(log.join(','));
function context(): void {
	log.push('context');
}
new Set<number>([5]).forEach((value: number): void => { log.push(String(value)); }, context());
console.log(log.join(','));
