// A global moved into a consumed parameter, then a throw: the catch reads the global, so it can't be
// moved out. Only top-level code reaches that rule (reuse.go's movable): a function's read of a global
// is checked for the dead zone, which already keeps it from moving. The two function cases are its
// neighbors, a later argument that throws and a callee that throws.
type Tree = { value: number; label: string };
let tree: Tree = { value: 1, label: `tree${1}` };
function insert(node: Tree, extra: number): Tree {
	return { ...node, value: node.value + extra };
}
function insertOrThrow(node: Tree, when: boolean): Tree {
	if (when) {
		throw new Error(`inner${2}`);
	}
	return { ...node, value: node.value + 1 };
}
function fail(when: boolean): number {
	if (when) {
		throw new Error(`failed${1}`);
	}
	return 1;
}
function laterArgument(): void {
	try {
		tree = insert(tree, fail(true));
	} catch (error) {
		console.log(`later argument: ${tree.value} ${tree.label}`);
	}
}
function calleeThrows(): void {
	try {
		tree = insertOrThrow(tree, true);
	} catch (error) {
		console.log(`callee throws: ${tree.value} ${tree.label}`);
	}
}
laterArgument();
calleeThrows();
try {
	tree = insertOrThrow(tree, true);
} catch (error) {
	console.log(`top level: ${tree.value} ${tree.label}`);
}
