// Reduced tsc shapes; the member representations are the same as the recorded Map value type.
type Value = string | false;
function show(value: Value | undefined): string { return `${typeof value}:${value}`; }
const map = new Map<string, Value>([['a', 'ab'.repeat(2)], ['b', false]]);
map.set('a', false); map.set('b', 'new'.repeat(2));
console.log(`${show(map.get('a'))} ${show(map.get('b'))} ${show(map.get('missing'))}`);
for (const [key, value] of map) { console.log(`${key}=${show(value)}`); }
const copy = new Map(map);
map.clear();
console.log(`${copy.size} ${show(copy.get('b'))}`);
console.log(`${copy.delete('a')} ${copy.delete('a')}`);
copy.set('a', 'again'.repeat(2));
for (const [key, value] of copy) { console.log(`${key}=${show(value)}`); }
copy.clear(); console.log(`${copy.size}`);
