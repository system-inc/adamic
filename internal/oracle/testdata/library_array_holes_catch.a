function check(length: number): void {
 let kept = `kept${length}`;
 try {
  kept = `updated${length}`;
  const temp = `temporary${length}`;
  const cells = new Array<number>(length);
  console.log(`${temp}:${cells.length}`);
 } catch (error) {
  if (error instanceof Error) { console.log(`${error.name}:${error.message}:${kept}`); }
 }
 const cells = new Array<number>(3);
 try { cells.length = length; } catch (error) {
  if (error instanceof Error) { console.log(`${error.name}:${kept}:${cells.length}`); }
 }
}
check(-1);
check(2);
