function strings(value: string): void { console.log(`${+value}:${-value}:${~value}`); }
for (const value of ['', ' ', '\u00a0\u20280\ufeff', '-0', '2.5', '0x10', '0b11', '0o10', 'Infinity', '-Infinity', 'NaN', '1x', '4294967296', '2147483648', '-2147483649']) { strings(value); }
function numbers(value: number): void { console.log(`${+value}:${-value}:${~value}`); }
numbers(NaN); numbers(Infinity); numbers(-0); numbers(0); numbers(4294967295);
function booleans(value: boolean): void { console.log(`${+value}:${-value}:${~value}`); }
booleans(false); booleans(true);
console.log(`${1 / -'0'}:${1 / -'-0'}`);
function union(value: number | string | boolean): void { console.log(`${+value}:${-value}:${~value}`); }
union('0x10'); union(false); union(-0);
let calls = 0;
function read(): string { calls += 1; return String(calls); }
console.log(`${+read()}:${-read()}:${~read()}:${calls}`);
const custom = { value: 3, valueOf(): number { calls += 1; return this.value; } };
console.log(`${+custom}:${-custom}:${~custom}:${calls}`);
const viaString = { toString(): string { calls += 1; return '0x10'; } };
console.log(`${+viaString}:${-viaString}:${~viaString}:${calls}`);
function arrays(value: number[]): void { console.log(`${+value}:${-value}:${~value}`); }
arrays([]); arrays([3]); arrays([3, 4]);
const fallback = { valueOf(): { readonly n: number } { calls += 1; return { n: 1 }; }, toString(): string { calls += 1; return '5'; } };
console.log(`${+fallback}:${-fallback}:${~fallback}:${calls}`);
console.log(`${+{}}:${-{}}:${~{}}`);
