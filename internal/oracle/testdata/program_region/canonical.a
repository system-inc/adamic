// a-check: refused adamic/cycle-capable
class Reader {
 next: Reader | undefined = undefined;
 read: () => string;
 constructor(label: string) {
  let saved: typeof read | undefined = undefined;
  this.read = read;
  const owner: Reader = this;
  function read(): string { return saved === read && owner.next === owner ? label : "broken"; }
  saved = read;
  this.next = this;
  console.log(String(read === read));
 }
}
const first = new Reader(`node${1}`);
const held = first.read;
console.log(String(held === first.read));
console.log(held());
const second = new Reader(`node${2}`);
console.log(String(held === second.read));
console.log(held());
console.log(second.read());
