// A chain a million links long, freed when the last reference to its head goes: freeing works from a
// list, not by recursion, so it can't overflow the stack (docs/memory.md).
interface Link {
	readonly value: number;
	readonly next: Link | undefined;
}
let chain: Link | undefined = undefined;
for (let index = 0; index < 1000000; index += 1) {
	chain = { value: index, next: chain };
}
console.log(`${chain?.value ?? -1}`);
chain = undefined;
console.log('freed');
