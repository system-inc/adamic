function check(filled: number): void {
 const cells = new Array<number | undefined>(5);
 if (filled >= 0) { cells[filled] = 10 + filled; }
 let visited = "";
 cells.forEach((value, index) => { visited += `${index}:${value};`; });
 const mapped = cells.map((value, index) => `${index}:${value}`);
 console.log(`visits:${visited}`);
 let mappedCount = 0;
 mapped.forEach(() => { mappedCount += 1; });
 console.log(`map:${mapped.length}:${mappedCount}:${mapped.join("|")}`);
 console.log(`join:${cells.join("|")}`);
 console.log(`filter:${cells.filter((value) => value !== undefined).join(",")}`);
 console.log(`some:${cells.some((value) => value !== undefined)}:every:${cells.every((value) => value !== undefined)}`);
 console.log(`reduce:${cells.reduce<number>((sum, value) => sum + (value ?? 0), 0)}`);
 console.log(`search:${cells.indexOf(undefined)}:${cells.lastIndexOf(undefined)}:${cells.includes(undefined)}`);
}
check(-1);
check(0);
check(2);
check(4);
const partly = new Array<number | undefined>(5);
partly[1] = undefined;
partly[2] = 20;
partly[4] = 40;
let visited = "";
partly.forEach((value, index) => { visited += `${index}:${value};`; });
console.log(`partial:${visited}:${partly.indexOf(undefined)}:${partly.includes(undefined)}`);
console.log(`partial map:${partly.map((value) => value ?? -1).join("|")}`);
