class Base {
    stored = 1;
    get value(): number { console.log('base-get'); return this.stored; }
    set value(value: number) { console.log('base-set'); this.stored = value; }
}
function adjust(value: Base): void { value.value = 7; console.log(`${value.value}`); }
class Child extends Base {
    override get value(): number { console.log('child-get'); return super.value + 10; }
    override set value(value: number) { console.log('child-set'); super.value = value + 1; }
}
adjust(new Base());
adjust(new Child());
const exact = new Base();
exact.value = 3;
console.log(`${exact.value}`);
