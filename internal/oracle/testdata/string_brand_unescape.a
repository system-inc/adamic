enum InternalSymbolName { Call = "__call", Constructor = "__constructor", Missing = "__missing" }
type __String = (string & { __escapedIdentifier: void; }) | (void & { __escapedIdentifier: void; }) | InternalSymbolName;
function unescapeLeadingUnderscores(identifier: __String): string {
 const id = identifier as string;
 return id.length >= 3 && id.charCodeAt(0) === 95 && id.charCodeAt(1) === 95 && id.charCodeAt(2) === 95 ? id.slice(1) : id;
}
for (const input of ["", "_", "__", "___", "____name", "__call", "___" + "🌍".repeat(40)]) {
 console.log(unescapeLeadingUnderscores(input.slice(0) as __String));
}
console.log(unescapeLeadingUnderscores(InternalSymbolName.Call));
