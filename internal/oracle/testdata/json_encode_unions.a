import { encodeJson, decodeJson, panic } from 'adamic';
type Shape = { readonly kind: 'Circle'; readonly radius: number } | { readonly kind: 'Box'; readonly width: number; readonly label?: string };
const shapes: readonly Shape[] = [{ kind: 'Circle', radius: 1.5 }, { kind: 'Box', width: 3, label: 'box' }];
const text = encodeJson<readonly Shape[]>(shapes);
console.log(text);
const decoded = decodeJson<readonly Shape[]>(text);
if (decoded.kind !== 'Ok') panic('union round trip failed');
if (encodeJson<readonly Shape[]>(decoded.value) !== text) panic('union re-encode differs');
type NumberTag = { readonly kind: 1; readonly value: string } | { readonly kind: 2; readonly value: number };
const numberTag = encodeJson<NumberTag>({ kind: 2, value: 42 });
console.log(numberTag);
const decodedTag = decodeJson<NumberTag>(numberTag);
if (decodedTag.kind !== 'Ok') panic('numeric tag round trip failed');
if (encodeJson<NumberTag>(decodedTag.value) !== numberTag) panic('numeric tag re-encode differs');
type BooleanTag = { readonly kind: true; readonly value: string } | { readonly kind: false; readonly value: number };
const booleanTag = encodeJson<BooleanTag>({ kind: false, value: 0.1 });
console.log(booleanTag);
const decodedBooleanTag = decodeJson<BooleanTag>(booleanTag);
if (decodedBooleanTag.kind !== 'Ok') panic('boolean tag round trip failed');
if (encodeJson<BooleanTag>(decodedBooleanTag.value) !== booleanTag) panic('boolean tag re-encode differs');
