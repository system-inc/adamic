const boundary = /\B/dug;
const found = boundary.exec('a🌍b');
console.log(`${found === null ? -1 : found.index} ${boundary.lastIndex}`);
const stickyBoundary = /\B/duy;
stickyBoundary.lastIndex = 2;
const stickyFound = stickyBoundary.exec('a🌍b');
console.log(`${stickyFound === null ? -1 : stickyFound.index} ${stickyBoundary.lastIndex}`);
const negative = /(?!\W)/dug;
const negativeFound = negative.exec('🌍');
console.log(`${negativeFound === null ? -1 : negativeFound.index} ${negative.lastIndex}`);
const stickyNegative = /(?!\W)/duy;
stickyNegative.lastIndex = 1;
const stickyNegativeFound = stickyNegative.exec('🌍');
console.log(`${stickyNegativeFound === null ? -1 : stickyNegativeFound.index} ${stickyNegative.lastIndex}`);
const consuming = /(?!\W)./dug;
console.log(`${consuming.exec('🌍') === null}`);
const dot = /./duy;
dot.lastIndex = 1;
const dotFound = dot.exec('🌍');
console.log(`${dotFound === null ? -1 : dotFound.index} ${dot.lastIndex}`);
