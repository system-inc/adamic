interface SymbolNode { readonly name: string; declarations: DeclarationNode[]; }
interface DeclarationNode { readonly text: string; symbol: SymbolNode | undefined; }
function declare(symbol: SymbolNode, declaration: DeclarationNode): void {
 symbol.declarations.push(declaration); declaration.symbol = symbol;
}
function build(): Map<string, SymbolNode> {
 const symbol: SymbolNode = { name: `symbol${1}`, declarations: [] };
 const declaration: DeclarationNode = { text: `declaration${2}`, symbol: undefined };
 declare(symbol, declaration);
 const table = new Map<string, SymbolNode>(); table.set(symbol.name, symbol);
 return table;
}
function run(): void {
 const table = build(); const symbol = table.get(`symbol${1}`);
 if (symbol !== undefined) {
 const declaration = symbol.declarations[0];
 if (declaration !== undefined) { console.log(`${declaration.text} ${declaration.symbol?.name}`); }
 }
}
run();
