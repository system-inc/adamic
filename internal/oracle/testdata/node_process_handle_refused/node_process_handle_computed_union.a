// stdout's handle's setBlocking called through a key whose type is a union naming it, off a parameter.
// The finite element read lowers one read per name, so the call would reach the closure without its
// object where Node blocks; it stops by name (Runtime's must A on #0bxc4jh).
import 'node:process';
type Handle = { setBlocking?: (value: boolean) => void; other?: (value: boolean) => void };
function pick(): 'setBlocking' | 'other' {
	return 'setBlocking';
}
function block(handle: Handle): void {
	const key = pick();
	if (handle[key]) handle[key]!(true);
}
const handle = (process.stdout as any)._handle as { setBlocking?: (value: boolean) => void } | undefined;
if (handle !== undefined) block(handle);
console.log('blocked');
