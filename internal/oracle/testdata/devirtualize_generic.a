class Box<T> {
    readonly value: T;
    constructor(value: T) { this.value = value; }
    get(): T { return this.value; }
}
class Child<T> extends Box<T> { override get(): T { console.log('child-get'); return super.get(); } }
function number(value: Box<number>): number { return value.get(); }
function text(value: Box<string>): string { return value.get(); }
console.log(`${number(new Box(1))}/${number(new Child(2))}`);
console.log(`${text(new Box('base'))}/${text(new Child('child'))}`);
