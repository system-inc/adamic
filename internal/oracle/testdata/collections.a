// Set and Map finished: keys and elements that are objects, arrays, maps and functions, each found by
// identity; clear; forEach, live as for...of is; a Set's entries; map.keys(), values() and entries()
// spread; new Set from anything iterable; new Map from any [key, value] pairs. The strings here are
// built at run time, so a reference a collection didn't take would be caught.

interface Point {
	readonly x: number;
	readonly y: number;
}

class Tag {
	readonly name: string;

	constructor(name: string) {
		this.name = name;
	}
}

function word(stem: string, index: number): string {
	return `${stem}${index}`;
}

// Objects by identity: two points with the same fields are two keys.
const here: Point = { x: 1, y: 2 };
const alsoHere: Point = { x: 1, y: 2 };
const labels = new Map<Point, string>();
labels.set(here, word('here', 1));
labels.set(alsoHere, word('also', 2));
labels.set(here, word('here', 3));
console.log(`${labels.size} ${labels.get(here) ?? 'none'} ${labels.get(alsoHere) ?? 'none'} ${labels.get({ x: 1, y: 2 }) ?? 'none'}`);
console.log(`${labels.has(alsoHere)} ${labels.delete(alsoHere)} ${labels.has(alsoHere)} ${labels.size}`);

const tags = [new Tag(word('red', 0)), new Tag(word('blue', 1)), new Tag(word('red', 0))];
const seen = new Set<Tag>();
for (const tag of tags) {
	seen.add(tag);
	seen.add(tag);
}
console.log(`${seen.size} ${seen.has(tags[2] ?? new Tag('none'))} ${seen.has(new Tag('red0'))}`);

const rows = new Set<number[]>();
const row = [1, 2, 3];
rows.add(row).add([1, 2, 3]).add(row);
console.log(`${rows.size}`);

const handlers = new Map<() => string, number>();
const greet = (): string => word('hello', 7);
handlers.set(greet, 1);
handlers.set(() => word('hello', 7), 2);
console.log(`${handlers.size} ${handlers.get(greet) ?? -1}`);

const inner = new Map<string, number>([[word('a', 1), 1]]);
const outer = new Map<Map<string, number>, string>([[inner, word('inner', 0)]]);
console.log(`${outer.get(inner) ?? 'none'} ${outer.has(new Map<string, number>())}`);

// forEach: value, key, and the collection, live.
const scores = new Map<string, number>([[word('k', 1), 10], [word('k', 2), 20], [word('k', 3), 30]]);
const visited: string[] = [];
scores.forEach((value, key, all) => {
	visited.push(`${key}=${value}/${all.size}`);
	if (key === 'k1') {
		all.delete('k2');
		all.set(word('k', 4), 40);
	}
});
console.log(visited.join(' '));
const elements: string[] = [];
const letters = new Set<string>([word('x', 1), word('y', 2)]);
letters.forEach((value, again, all) => {
	elements.push(`${value}:${again}:${all.size}`);
});
console.log(elements.join(' '));
// A callback's result is dropped.
letters.forEach((value) => `${value}!`);

// clear, and clear during a loop: what's added after it is visited.
const order: string[] = [];
const live = new Map<string, number>([[word('p', 1), 1], [word('p', 2), 2]]);
for (const [key, value] of live) {
	order.push(`${key}:${value}`);
	if (value === 1) {
		live.clear();
		live.set(word('q', 3), 3);
	}
}
console.log(`${order.join(' ')} ${live.size}`);
const cleared = new Set<Tag>(tags);
cleared.clear();
console.log(`${cleared.size} ${cleared.has(tags[0] ?? new Tag('none'))}`);
cleared.add(new Tag(word('again', 9)));
console.log(`${cleared.size}`);

// A Set's entries: each element twice.
const pairs: string[] = [];
for (const [first, second] of letters.entries()) {
	pairs.push(`${first}${second}`);
}
for (const [, only] of letters.entries()) {
	pairs.push(only);
}
console.log(pairs.join(','));

// Spread.
const keys = [...scores.keys()];
const values = [...scores.values()];
const entries = [...scores.entries()];
const members = [...letters.values()];
console.log(`${keys.join(',')} ${values.join(',')} ${entries.length} ${members.join(',')}`);

// new Set from anything iterable.
console.log(`${new Set('héllo \u{1F30D}\u{1F30D}').size} ${[...new Set(`${'ab'.repeat(3)}c`)].join('')}`);
console.log(`${new Set(letters).size} ${new Set(scores.keys()).size} ${new Set(scores.values()).has(40)} ${new Set(scores).size}`);

// new Map from pairs.
const built: [string, number][] = [];
for (let index = 0; index < 5; index += 1) {
	built.push([word('n', index % 3), index]);
}
const fromPairs = new Map(built);
const copied = new Map(fromPairs);
const fromEntries = new Map(fromPairs.entries());
copied.set(word('n', 9), 9);
const shown: string[] = [];
for (const [key, value] of [...fromPairs]) {
	shown.push(`${key}=${value}`);
}
console.log(`${fromPairs.size} ${shown.join(',')} ${copied.size} ${fromEntries.size}`);
const maybe: [string, number | undefined][] = [[word('m', 0), undefined], [word('m', 1), 1]];
const maybes = new Map(maybe);
console.log(`${maybes.has('m0')} ${maybes.get('m0') ?? -1} ${maybes.get('m1') ?? -1}`);

// A callback that deletes its own entry still has its key and value.
const own = new Map<string, string>([[word('own', 1), word('value', 1)], [word('own', 2), word('value', 2)]]);
const kept: string[] = [];
own.forEach((value, key, all) => {
	all.delete(key);
	kept.push(`${key}>${value}`);
});
console.log(`${kept.join(' ')} ${own.size}`);

// Holes in a destructured entry.
for (const [, value] of scores) {
	kept.push(`${value}`);
}
for (const [, count] of [...scores]) {
	kept.push(`${count}`);
}
console.log(kept.join(','));

// A fixed tuple's length is its type's: a tuple is an object of fields, with no length of its own.
for (const entry of [...scores]) {
	console.log(`${entry.length} ${entry[0]}`);
}
const pair: [string, number] = [word('only', 1), 1];
console.log(`${pair.length}`);

// A tuple returned and destructured: at the module's top, where each name is a global a function
// can read, and inside a function.
function cut(text: string): readonly [string, number] {
	return [text.slice(1), text.length];
}
const [rest, length] = cut(word('abc', 1));
function describeCut(): string {
	return `${rest}/${length}`;
}
console.log(describeCut());
function swapped(text: string): [number, string | undefined, number | undefined] {
	const [tail, size] = cut(text);
	let [, middle] = cut(tail);
	middle += 100;
	if (size > 3) {
		return [size + middle, tail, undefined];
	}
	return [size + middle, undefined, size];
}
const [total, maybeTail, maybeSize] = swapped(word('wxyz', 9));
const [otherTotal, , otherSize] = swapped(word('a', 1));
console.log(`${total} ${maybeTail ?? 'none'} ${maybeSize ?? -1} ${otherTotal} ${otherSize ?? -1}`);
