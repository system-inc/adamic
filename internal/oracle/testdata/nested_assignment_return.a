function make(): () => number {
 let count = 0;
 let calls = 0;
 function next(): number { calls += 1; return calls; }
 function write(): number { return count = next(); }
 console.log(String(write()));
 console.log(String(calls));
 function read(): number { return count; }
 return read;
}
console.log(String(make()()));
