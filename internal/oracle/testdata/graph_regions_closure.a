function make(start: number): () => number {
 let saved: (() => number) | undefined = undefined;
 let count = start;
 function read(): number { count += 1; return count; }
 const observe = (): string => saved === undefined ? `empty${start}` : `held${start}`;
 saved = read;
 console.log(observe());
 return read;
}
function run(): void { const held = make(3); console.log(`${held()} ${held()}`); }
run();
