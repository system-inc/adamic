interface Reading {
	value?: number;
	readonly label: string;
}
const reading: Reading = { label: 'x' };
console.log(`${reading.value} ${reading.value === undefined}`);
const raw: Reading = { label: 'z' };
const viewed: Reading = raw;
console.log(`${viewed.value}`);
function show(target: { readonly value?: number }): string {
	return `${target.value}`;
}
console.log(show({}));
