type Factory = (value: number) => number;
namespace Factory {
    export function identity<T>(value: T): T { return value; }
    export function offset(value: number = 4): number { return value + 1; }
    export function sum(values: number[]): number { let total = 0; for (const value of values) { total += value; } return total; }
}
namespace Outer.Inner.Deep {
    export const name = 'deep';
    let calls = 0;
    export function read(): string { calls += 1; return `${name}${calls}`; }
}
namespace Empty { ; export namespace Types { export type Value = number; } }
const scalar: Empty.Types.Value = Factory.identity(8);
const text = Factory.identity('text');
const object = Factory.identity({ text: 'object' });
const array = Factory.identity([2, 3]);
const offset: Factory = (value) => Factory.offset(value);
const detached = Outer.Inner.Deep.read;
console.log(`${scalar} ${text} ${object.text} ${array.join(',')} ${offset(2)} ${Factory.offset()} ${Factory.offset(undefined)} ${Factory.sum([1, 2, 3])}`);
console.log(`${Outer.Inner.Deep.read()} ${detached()} ${detached === Outer.Inner.Deep.read}`);
console.log(`${(Factory.offset)(6)} ${(Outer.Inner.Deep.read)()}`);
