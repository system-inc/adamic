// Original identity body from tsc core.ts, with alpha-renamed overload parameters.
function identity<Value>(x: Value): Value;
function identity<T>(x: T): T { return x; }
console.log(String(identity(3))); console.log(identity('name'));
let defaults = 0;
function next(): number { defaults += 1; return defaults; }
function count(value: string): number;
function count(value: string, amount: number): number;
function count(value: string, amount = next()): number { return value.length + amount; }
console.log(`${count('x')}:${count('xx', 0)}:${defaults}`);
function fixed(value: string, ignored: number): number;
function fixed(value: string): number { return value.length; }
console.log(`${fixed('xx', next())}:${defaults}`);
function sum(first: number, second: number): number;
function sum(...values: number[]): number { let total = 0; for (const value of values) { total += value; } return total; }
console.log(String(sum(2, 3)));
