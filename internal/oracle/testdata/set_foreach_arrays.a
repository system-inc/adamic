// A Set of arrays finds each array by identity and the callback keeps it after delete.
function row(tag: string): string[] {
	return [`${tag}-a`, `${tag}-b`];
}

function show(items: readonly string[]): string {
	return items.join("|");
}

function probe(mode: number): void {
	const keys: string[][] = [];
	const collection = new Set<string[]>();
	for (let index = 0; index < 8; index += 1) {
		const made = row(`k${index}`);
		keys.push(made);
		collection.add(made);
	}
	const first = keys[0] ?? row("missing-key");
	const second = keys[1] ?? row("missing-later");
	const kept: string[][] = [];
	try {
		collection.forEach((item, current, owner) => {
			if (mode === 0) { owner.delete(current); }
			if (mode === 1 && current === first) { owner.delete(second); }
			if (mode === 2) { owner.clear(); }
			if (mode === 3 && current === first) {
				owner.delete(current);
				owner.add(row("k8"));
			}
			if (mode === 4) {
				owner.delete(current);
				kept.push(item);
				kept.push(current);
				throw new Error(`deleted ${show(current)} ${show(item)}`);
			}
			kept.push(item);
			kept.push(current);
			console.log(`${mode}: ${show(item)} ${show(current)} ${item === current} ${owner.size}`);
		});
	} catch (error) {
		console.log(error instanceof Error ? error.message : "unexpected");
	}
	console.log(`kept ${mode}: ${kept.map((item) => show(item)).join(",")} remaining ${collection.size}`);
	const after: string[] = [];
	collection.forEach((item) => { after.push(show(item)); });
	console.log(`after ${mode}: ${after.join(",")}`);
}

for (let mode = 0; mode < 5; mode += 1) { probe(mode); }
