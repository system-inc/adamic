// From integration's reading of 4ddd17f (#fxspptb): a field name longer than a C string literal may
// be. It reached clang as a literal clang refuses; native.go's cString writes it as bytes now.
interface Wide {
	readonly first: number;
	: number;
}
const wide: Wide = { first: 0, : 1 };
wide. += 1;
console.log(`${wide.}`);

// The same name destructured, and a method whose name is as long, called through an interface.
const { : copied } = wide;
console.log(`${copied}`);
interface Speaker {
	(): string;
}
class Loud implements Speaker {
	(): string {
		return `loud ${wide.first}`;
	}
}
const speaker: Speaker = new Loud();
console.log(speaker.());
