function equal<T>(left: T, right: T): boolean { return left === right; }
function contains<T>(items: readonly T[], wanted: T, same: (left: T, right: T) => boolean = equal): boolean {
 for (const item of items) { if (same(item, wanted)) { return true; } }
 return false;
}
console.log(`${contains([4, 7, 11], 7)} ${contains([4, 7, 11], 5)}`);
console.log(`${contains([4, 7], 7, (left, right) => left + 1 === right)}`);
