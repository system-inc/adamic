// a-check: refused a write through a union of "text" into a slot that holds number in { value?: number
type Cell = { value?: string } | { value?: number };
function fill(cell: Cell): void {
	cell.value ??= 'text';
}
const counter: { value?: number } = {};
fill(counter);
console.log(`${(counter.value ?? 1) * 2}`);
