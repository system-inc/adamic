// Integer-counter reads include negative indices and the bound; writes exercise conversions.
function exercise(): void {
 const bytes = new Uint8Array(3);
 for (let index = 0; index < bytes.length; index++) { bytes[index] = index === 0 ? index : 300; }
 for (let index = 0; index <= bytes.length; index++) { console.log(`${bytes[index]}`); }
 for (let index = -1; index < 0; index++) { console.log(`${bytes[index]}`); }
 const words = new Uint16Array(3);
 for (let index = 0; index < words.length; index++) { words[index] = index === 0 ? index : 65537; }
 for (let index = 0; index <= words.length; index++) { console.log(`${words[index]}`); }
 for (let index = -1; index < 0; index++) { console.log(`${words[index]}`); }
 const signed = new Int32Array(3);
 for (let index = 0; index < signed.length; index++) { signed[index] = index === 0 ? index : 4294967295; }
 for (let index = 0; index <= signed.length; index++) { console.log(`${signed[index]}`); }
 for (let index = -1; index < 0; index++) { console.log(`${signed[index]}`); }
 const floats = new Float64Array(3);
 for (let index = 0; index < floats.length; index++) { floats[index] = index === 0 ? index : -0.5; }
 for (let index = 0; index <= floats.length; index++) { console.log(`${floats[index]}`); }
 for (let index = -1; index < 0; index++) { console.log(`${floats[index]}`); }
}
exercise();

// Built-in typed-array iteration reads live storage and owns its original array.
const live = new Uint16Array([1, 2, 3]);
for (const value of live) {
 console.log(`live:${value}`);
 live[1] = 40;
 live[2] = 50;
}
let moving = new Uint16Array([3, 4, 5]);
for (const value of moving) {
 moving = new Uint16Array([99]);
 console.log(`moving:${value}`);
}
for (const value of new Uint16Array([6, 7])) {
 console.log(`break:${value}`);
 break;
}
function first(): number {
 for (const value of new Uint16Array([8, 9])) { return value; }
 return 0;
}
console.log(`return:${first()}`);
try {
 for (const value of new Uint16Array([10, 11])) { throw new Error(`${value}`); }
} catch (error) {
 if (error instanceof Error) { console.log(`caught:${error.message}`); }
}
