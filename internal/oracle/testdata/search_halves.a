// Searching for half of a supplementary character: UTF-16 sees the halves, and so must Adamic,
// though its strings hold the character as four bytes, whole.
const globe = 'a🌍b🌍';
const high = globe.slice(1, 2);
const low = globe.slice(2, 3);
console.log(`${globe.indexOf(high)} ${globe.indexOf(low)} ${globe.indexOf(`${low}b`)} ${globe.indexOf('b')}`);
console.log(`${globe.includes(low)} ${'abc'.includes(low)} ${globe.startsWith(`a${high}`)} ${globe.endsWith(low)} ${globe.endsWith(high)}`);
const halves = globe.split(high);
console.log(`${halves.length} ${halves.map((part) => part.length).join(',')} ${halves.map((part) => part.charCodeAt(0)).join(',')}`);
const lows = globe.split(low);
console.log(`${lows.length} ${lows.join('|') === `a${high}|b${high}|`}`);
console.log(`${'plain'.split('a').join('+')} ${globe.split('🌍').join('+')}`);
