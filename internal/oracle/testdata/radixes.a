// Colors in hexadecimal, permissions in octal, flags in binary, short identifiers in base 36, and
// fractions in every base, through toString(radix).

interface Color {
	readonly name: string;
	readonly red: number;
	readonly green: number;
	readonly blue: number;
}

const colors: readonly Color[] = [
	{ name: 'ink', red: 17, green: 24, blue: 39 },
	{ name: 'paper', red: 250, green: 248, blue: 240 },
	{ name: 'signal', red: 230, green: 57, blue: 0 },
];

function hex(channel: number): string {
	return channel.toString(16).padStart(2, '0');
}

for (const color of colors) {
	const packed = color.red * 65536 + color.green * 256 + color.blue;
	console.log(`${color.name}: #${hex(color.red)}${hex(color.green)}${hex(color.blue)} (${packed.toString(16)}, ${packed.toString(2).length} bits)`);
}

const modes = [493, 420, 511, 384];
console.log(modes.map((mode) => mode.toString(8)).join(' '));

let flags = 0;
for (const bit of [0, 3, 5, 31]) {
	flags += 2 ** bit;
	console.log(`flags ${flags.toString(2)}`);
}

// Identifiers: a counter written in base 36, and read back.
let identifiers = '';
for (let counter = 1234567890; counter < 1234567890 * 40; counter *= 3) {
	identifiers += `${counter.toString(36)} `;
}
console.log(identifiers);
console.log(`${Number.parseInt((987654321).toString(36), 36)}`);

// Fractions, negatives, and the edges, in every base.
const samples = [0.1, -255.5, 1 / 3, 2 ** 53 + 2, 1e21, -1e-7, 5e-324, 0, -0, 0 / 0, 1 / 0, -1 / 0];
for (let radix = 2; radix <= 36; radix += 1) {
	console.log(`${radix}: ${samples.map((sample) => sample.toString(radix)).join(' ')}`);
}
console.log(`${(255).toString(16.9)} ${(255).toString(10)} ${Number.MAX_VALUE.toString(36)}`);
