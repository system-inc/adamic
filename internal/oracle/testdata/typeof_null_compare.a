// Comparisons observe null in a parameter slot and a field, including after stale narrowing.
function inspect(value: RegExpMatchArray | null): void {
	console.log(`slot: ${typeof value} ${typeof value === 'object'} ${'object' === typeof value} ${typeof value !== 'undefined'}`);
	if (typeof value === 'object') {
		console.log('object branch');
	} else {
		console.log('wrong branch');
	}
}
console.log(`literal: ${typeof null === 'object'} ${typeof null !== 'undefined'}`);
inspect(null);
inspect('x'.match(/x/));
const holder: { value: RegExpMatchArray | null } = { value: 'x'.match(/x/) };
function clear(): void {
	holder.value = null;
}
if (holder.value !== null) {
	clear();
	console.log(`field: ${typeof holder.value} ${typeof holder.value === 'object'}`);
}
const object = { value: 1 };
const array = [1];
const fn = () => 1;
console.log(`controls: ${typeof undefined} ${typeof object} ${typeof array} ${typeof fn}`);
function absent(value: { readonly value: number } | undefined): void {
	console.log(`absent: ${typeof value} ${typeof value === 'object'}`);
}
absent(undefined);
absent(object);
