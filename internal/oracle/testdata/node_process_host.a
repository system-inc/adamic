import { EOL, platform } from 'node:os';
import { cwd } from 'node:process';
console.log(`cwd ${process.cwd()}`);
console.log(`cwd import ${cwd() === process.cwd()}`);
console.log(`platform ${process.platform}`);
console.log(`os ${platform() === process.platform} ${EOL === '\n'}`);
console.log(`nextTick ${!!process.nextTick} ${typeof process.nextTick}`);
console.log(`pid ${Number.isInteger(process.pid)} ${process.pid > 0} ${process.pid === process.pid}`);
console.log(`arguments ${process.argv.slice(2).join('|')}`);
console.log(`argv same ${process.argv === process.argv}`);
console.log(`entry ${typeof process.argv[0]} ${typeof process.argv[1]}`);
console.log(`profiling ${process.execArgv.includes('--prof')} ${process.execArgv.includes('--cpu-prof')}`);
console.log(`execArgv same ${process.execArgv === process.execArgv}`);
console.log(`width ${process.stdout.columns ?? -1}`);
console.log(`tty ${process.stdout.isTTY ?? false}`);
console.log(`heap ${Number.isInteger(process.memoryUsage().heapUsed)} ${process.memoryUsage().heapUsed > 0}`);
console.log('before');
process.stdout.write('raw \ud800 \0 héllo 🌍');
process.stdout.write('\x1B[2J\x1B[3J\x1B[H');
console.error('error');
process.stdout.write('after\n');
