// A frozen object's TypeError leaves the function that writes it, and its caller's catch takes it,
// through a call, through a function value and through a finally that runs on the way out. The same
// function writes an object that isn't frozen, which never throws.
type Named = { name: string; size: number };

function rename(target: Named, name: string): string {
	const prefix = `renamed ${target.name}`;
	target.name = `${name}!`;
	return `${prefix} to ${target.name}`;
}

function safe(target: Named, name: string): string {
	try {
		return rename(target, name);
	} catch (error) {
		if (error instanceof Error) {
			return `caught ${error.name}, ${error.message}`;
		}
		return 'not an error';
	}
}

const open: Named = { name: 'open', size: 1 };
const shut: Named = { name: 'shut', size: 2 };
Object.freeze(shut);
console.log(safe(open, 'first'));
console.log(safe(shut, 'second'));

// No catch here: the finally runs, and the error goes on to the caller's.
function grow(target: Named, by: number): number {
	try {
		target.size = target.size + by;
		return target.size;
	} finally {
		console.log(`finally after ${target.name}`);
	}
}
for (const target of [open, shut]) {
	try {
		console.log(`${grow(target, 10)}`);
	} catch (error) {
		if (error instanceof Error) {
			console.log(error.name);
			console.log(error.message);
		}
	} finally {
		console.log(`outer finally for ${target.name}`);
	}
}

// Through a function value the runtime's loop calls: the array map was building is let go.
for (const targets of [[open], [open, shut, open]]) {
	try {
		const sizes = targets.map((target) => {
			target.size = target.size * 2;
			return `${target.name}:${target.size}`;
		});
		console.log(sizes.join(' '));
	} catch (error) {
		if (error instanceof Error) {
			console.log(`${error.name}: ${error.message}`);
		}
	}
}
console.log(`${open.name} ${open.size} ${shut.name} ${shut.size}`);
