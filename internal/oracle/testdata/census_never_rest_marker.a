// Debug.fail's signature. This base lowers Error construction directly at throw.
type AnyFunction = (...args: never[]) => void;
function fail(message?: string, stackCrawlMark?: AnyFunction): never {
    if (stackCrawlMark) { console.log(typeof stackCrawlMark); }
    throw new Error(message ?? '');
}
const marker: AnyFunction = fail;
console.log(typeof marker);
try { fail('probe', fail); } catch { console.log('ok'); }
function optional(message?: string, code?: number): void {
    console.log(`${message === undefined}:${code === undefined}`);
}
function zero(): void { console.log('zero'); }
const a: AnyFunction = optional;
const b: AnyFunction = zero;
console.log(`${typeof a}:${typeof b}`);
const object: { readonly marker: AnyFunction } = { marker: optional };
console.log(typeof object.marker);
function required(value: number): void { console.log(String(value)); }
const opaque: AnyFunction = required;
console.log(typeof opaque);
class Box { value = 1; }
function classParameter(value: Box): void { console.log(String(value.value)); }
const classMarker: AnyFunction = classParameter;
console.log(typeof classMarker);
type Uncallable = (...args: never) => void;
const uncallable: Uncallable = optional;
console.log(typeof uncallable);
let reads = 0;
function pickMarker(): AnyFunction | undefined { reads += 1; return undefined; }
console.log(`${typeof (pickMarker() || optional)}:${reads}`);
console.log(typeof (a || zero));
