class Animal {
	readonly name: string;
	constructor(name: string) { this.name = name; }
	speak(): string { return this.name; }
}
class Dog extends Animal { override speak(): string { return this.name + ':woof'; } }
class Puppy extends Dog { override speak(): string { return this.name + ':puppy'; } }
class Cat extends Animal { override speak(): string { return this.name + ':meow'; } }
class Bird extends Animal { override speak(): string { return this.name + ':chirp'; } }
function dog(animal: Animal): Dog { return animal as Dog; }
function union(animal: Dog | Cat): Dog { return animal as Dog; }
function several(animal: Animal): Dog | Cat { return animal as Dog | Cat; }
const rex: Animal = new Dog('rex'.repeat(2));
const pup: Animal = new Puppy('pup'.repeat(2));
console.log(dog(rex).speak());
console.log(dog(pup).speak());
console.log(union(new Dog('union'.repeat(2))).speak());
console.log(`${dog(rex) === rex}`);
for (const animal of [several(rex), several(new Cat('cat'.repeat(2)))]) {
	if (animal instanceof Dog) { console.log(animal.speak()); }
	else { console.log(animal.speak()); }
}
class Base<T> {
	readonly value: T;
	constructor(value: T) { this.value = value; }
}
class Box<T> extends Base<T> {}
class Pair<T> extends Box<T> {}
function boxed(value: Base<string>): Box<string> { return value as Box<string>; }
function paired(value: Base<number>): Pair<number> { return value as Pair<number>; }
console.log(boxed(new Pair<string>('box'.repeat(2))).value);
console.log(`${paired(new Pair<number>(42)).value}`);
