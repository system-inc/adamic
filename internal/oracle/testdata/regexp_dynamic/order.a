import { programArguments } from 'adamic';
let pattern = programArguments()[0] ?? 'TODO';
let trace = '';
function first(): string { trace += 'pattern '; return pattern; }
function flags(): string { trace += 'flags '; pattern = 'OTHER'; return 'u'; }
const regex = new RegExp(first(), flags());
console.log(`${regex.test('TODO')} ${regex.test('OTHER')} ${trace}`);
let calls = 0;
function throwing(pattern: string): RegExp { calls++; return new RegExp(pattern, 'u'); }
function pass(pattern: string): RegExp { return throwing(pattern); }
try { pass('?'); } catch (error) {
 if (error instanceof Error) console.log(`${error.name} ${calls}`);
}
console.log(`${new RegExp(programArguments()[1] ?? '', 'u').source}`);

let changedPattern = 'a';
changedPattern = 'b';
console.log(`${new RegExp(changedPattern).test('a')}`);
let capturedPattern = 'a';
function changePattern(): void { capturedPattern = 'b'; }
changePattern();
console.log(`${new RegExp(capturedPattern).test('a')}`);
let changedFlags: string | undefined = undefined;
function changeFlags(): void { changedFlags = 's'; }
if (changedFlags === undefined) {
 changeFlags();
 console.log(`${new RegExp('.', changedFlags).test('\n')}`);
}
console.log(`${new RegExp('x' + undefined).test('x')}`);
