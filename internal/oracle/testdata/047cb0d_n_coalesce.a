interface Link {
	value: number;
	label: string;
}
let chain: Link | undefined = { value: 1, label: `built ${1}` };
const fallback: Link = { value: 9, label: `fallback ${9}` };
function drop(): void {
	chain = undefined;
}
if (chain !== undefined) {
	drop();
	const picked: Link = chain ?? fallback;
	console.log(`${picked.value}`);
}
