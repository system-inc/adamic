const values = [1, 2, 3];
let visits = '';
const mapped = values.flatMap((value: number, index: number, all: number[]): number[] => {
	visits += `${index}:${all === values}|`;
	return value === 2 ? [] : [value, value + 10];
});
console.log(`${mapped.join('|')} ${visits}`);
console.log(values.flatMap((value: number): number => value + 1).join('|'));
const shared = [1];
console.log(values.flatMap((value: number): number[] => { shared[0] = value; return shared; }).join('|'));
const growing = [1, 2];
console.log(growing.flatMap((value: number): number[] => { growing.push(9); return [value]; }).join('|'));
const shrinking = [1, 2, 3];
console.log(shrinking.flatMap((value: number): number[] => { shrinking.splice(1, 2); return [value]; }).join('|'));
const words = ['a'.repeat(2), 'b'.repeat(2)];
const strings = words.flatMap((value: string): string[] => [value, value + '!']);
words.splice(0, 2);
console.log(strings.join('|'));
try { values.flatMap((value: number): number[] => { throw new Error(`${value}`); }); } catch (error) { if (error instanceof Error) { console.log(error.message); } }
