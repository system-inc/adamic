import { panic } from 'adamic';

// boolean | undefined, everywhere number | undefined already goes: a variable, a parameter left out
// or given undefined, a default, a result, ??, === undefined, narrowing, and what may be missing in
// an array, a map or behind ?.
let seen: boolean | undefined;
console.log(`${seen} ${seen ?? true} ${seen === undefined}`);
seen = false;
console.log(`${seen} ${seen ?? true} ${seen === undefined}`);
seen = undefined;
console.log(`${seen ?? true}`);

function parity(value: number): boolean | undefined {
	if (!Number.isInteger(value)) {
		return undefined;
	}
	return value % 2 === 0;
}

function describe(even: boolean | undefined): string {
	if (even === undefined) {
		return 'neither';
	}
	// Narrowed: even is a boolean here.
	return even ? 'even' : 'odd';
}
console.log(`${describe(parity(4))} ${describe(parity(7))} ${describe(parity(1.5))} ${describe(undefined)} ${describe(true)}`);

// Optional and default boolean parameters: a default runs only when its argument is undefined.
let defaulted = 0;
function loudness(): boolean {
	defaulted += 1;
	return defaulted % 2 === 1;
}
function shout(word: string, loud = false, bang = loudness(), quiet?: boolean): string {
	const marks = bang ? '!' : '.';
	const said = loud ? `${word.toUpperCase()}${marks}` : `${word}${marks}`;
	return quiet === undefined ? said : `${said}(${quiet})`;
}
console.log(`${shout('hi')} ${shout('hi', true)} ${shout('hi', undefined, true)} ${shout('hi', true, false, false)} ${shout('hi')} made ${defaulted}`);

class Lamp {
	on: boolean;
	constructor(on = true) {
		this.on = on;
	}
	toggle(times = 1, report?: boolean): string {
		for (let step = 0; step < times; step += 1) {
			this.on = !this.on;
		}
		return report ?? false ? `now ${this.on}` : 'quiet';
	}
}
const lamp = new Lamp();
console.log(`${new Lamp(false).on} ${lamp.on} ${lamp.toggle()} ${lamp.toggle(3, true)} ${lamp.toggle(undefined, true)}`);

// Arrays of booleans: an index, at, pop and find may be missing.
const flags: boolean[] = [true, false, true];
console.log(`${flags[0]} ${flags[1]} ${flags[5]} ${flags[-1]} ${flags.at(-2)} ${flags.at(9)}`);
console.log(`${flags.find((flag) => !flag)} ${flags.find((flag) => flag && !flag)}`);
console.log(`${flags.pop()} ${flags.pop()} ${flags.pop()} ${flags.pop()} ${flags.length}`);
const first = flags[0];
console.log(`${first === undefined} ${first ?? false}`);

// A map of booleans.
const answers = new Map<string, boolean>([['yes', true], ['no', false]]);
const yes = answers.get('yes');
console.log(`${yes} ${answers.get('no')} ${answers.get('maybe')} ${answers.get('maybe') ?? true}`);
if (yes !== undefined) {
	console.log(`${!yes}`);
}

// ?. to a boolean field.
interface Switch {
	readonly label: string;
	readonly up: boolean;
}
const switches: Switch[] = [{ label: 'a', up: false }];
const upOrNot = switches[0]?.up;
console.log(`${upOrNot} ${switches[3]?.up} ${switches[3]?.up ?? true}`);

// === between a pair and what it holds, or another pair, for booleans and for numbers.
const counts = new Map<string, number>([['one', 1], ['nan', NaN]]);
console.log(`${yes === true} ${yes === false} ${answers.get('maybe') === false} ${answers.get('maybe') === answers.get('nope')}`);
console.log(`${yes !== true} ${upOrNot === answers.get('no')} ${counts.get('one') === 1} ${counts.get('nan') === counts.get('nan')}`);
console.log(`${counts.get('none') === counts.get('missing')} ${1 === counts.get('one')} ${counts.get('none') !== 1}`);

// A conditional of a boolean and undefined is boolean | undefined.
for (const value of [2, 3]) {
	const maybe = value > 2 ? value === 3 : undefined;
	console.log(`${value}: ${maybe}`);
}

// What a template or + writes for a missing value is "undefined", a string included.
const words = ['one'];
const missingWord = words[4];
let sentence = 'the word is ';
sentence += missingWord;
console.log(`${missingWord} ${counts.get('none')} ${words[0] + '!'} ${missingWord + '?'} ${sentence}`);

const sure = answers.get('yes') ?? panic('no answer for yes');
console.log(`${sure}`);
