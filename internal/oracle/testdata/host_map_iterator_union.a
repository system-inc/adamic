function walk<V>(map: Map<string, V>): void {
    const entries = map.entries();
    for (const [key, value] of entries) { console.log(`entry:${key}:${value}:${typeof value}`); }
    const keys = map.keys();
    for (const key of keys) { console.log(`key:${key}`); }
    const values = map.values();
    for (const value of values) { console.log(`value:${value}:${typeof value}`); }
    for (const [key, value] of map) { console.log(`map:${key}:${value}:${typeof value}`); }
    map.forEach((value, key): void => { console.log(`visit:${key}:${value}:${typeof value}`); });
}
const map = new Map<string, string | number>([['one', 1], ['text', 'x']]);
walk(map);
map.set('one', 0); map.set('text', '');
walk(map);
const optional = new Map<string, string | number | boolean | undefined>();
optional.set('zero', 0); optional.set('empty', ''); optional.set('false', false); optional.set('missing', undefined);
walk(optional);
const live = map.entries();
map.set('later', 3);
for (const [key, value] of live) { console.log(`live:${key}:${value}`); }
const values = map.values();
const first = values.next();
if (!first.done) { console.log(`next:${first.value}`); }
for (const value of values) { console.log(`remaining:${value}`); }
