enum SyntaxKind { First, Token = 2, Last = 4 }
enum Flags { None = 0, A = 1 << 0, B = 1 << 1, Sign = 1 << 31 }
function kind(value: number): SyntaxKind { return value as SyntaxKind; }
function next(value: SyntaxKind): SyntaxKind { return value + 1; }
function inside(value: SyntaxKind): boolean { return value >= SyntaxKind.First && value <= SyntaxKind.Last; }
let value: SyntaxKind = kind(40);
value++;
value += 3;
value <<= 1;
console.log(`${value} ${next(value)} ${inside(kind(3))} ${inside(value)}`);
const values: SyntaxKind[] = [kind(17), next(SyntaxKind.Last)];
const numbers: number[] = values;
numbers.push(99);
const map = new Map<string, SyntaxKind>([['value', kind(-3)]]);
const wide: Map<string, number> = map;
wide.set('other', 12.5);
const box: { value: SyntaxKind } = { value: kind(-5) };
box.value = box.value / 2;
console.log(`${values.join(',')} ${map.get('value')} ${map.get('other')} ${box.value}`);
const combined: Flags = Flags.A | Flags.B;
let signed: Flags = ~Flags.A;
signed ^= Flags.Sign;
signed &= ~Flags.B;
console.log(`${combined} ${signed} ${Flags[combined] ?? 'undefined'} ${kind(NaN)} ${kind(Infinity)}`);
