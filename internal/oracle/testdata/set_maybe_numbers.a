// A Set<number | undefined> keeps the packed undefined word distinct from every number, including
// the canonical packed NaN, while its present numbers use SameValueZero.
const values = new Set<number | undefined>();
values.add(0);
values.add(-0);
values.add(NaN);
values.add(NaN);
values.add(undefined);
values.add(undefined);
values.add(1);
values.add(-3.5);

console.log(`${values.size}`);
console.log(`${values.has(0)} ${values.has(-0)} ${values.has(NaN)} ${values.has(undefined)}`);
console.log(`${values.has(1)} ${values.has(-3.5)} ${values.has(2)}`);
for (const value of values) {
	if (value === undefined) {
		console.log('undefined');
	} else if (value !== value) {
		console.log('NaN');
	} else if (value === 0) {
		console.log(`${1 / value}`);
	} else {
		console.log(`${value}`);
	}
}

console.log(`${values.delete(-0)} ${values.has(0)} ${values.size}`);
console.log(`${values.delete(NaN)} ${values.has(NaN)} ${values.size}`);
console.log(`${values.delete(undefined)} ${values.has(undefined)} ${values.size}`);
values.add(undefined);
values.add(NaN);
values.add(-0);
console.log(`${values.size} ${values.has(undefined)} ${values.has(NaN)} ${values.has(0)}`);
