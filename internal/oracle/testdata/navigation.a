// Great-circle navigation, a hanging cable, compound interest and sound levels: a program that uses
// every function of Math that's ported from V8, and prints each answer in full, so a last bit that
// differs from Node's changes the output.

interface Place {
	readonly name: string;
	readonly latitude: number;
	readonly longitude: number;
}

const earthRadius = 6371.0088;
const degrees = Math.PI / 180;

function haversine(from: Place, to: Place): number {
	const latitudeChange = (to.latitude - from.latitude) * degrees;
	const longitudeChange = (to.longitude - from.longitude) * degrees;
	const half =
		Math.sin(latitudeChange / 2) ** 2 +
		Math.cos(from.latitude * degrees) * Math.cos(to.latitude * degrees) * Math.sin(longitudeChange / 2) ** 2;
	return 2 * earthRadius * Math.asin(Math.sqrt(half));
}

function bearing(from: Place, to: Place): number {
	const longitudeChange = (to.longitude - from.longitude) * degrees;
	const y = Math.sin(longitudeChange) * Math.cos(to.latitude * degrees);
	const x =
		Math.cos(from.latitude * degrees) * Math.sin(to.latitude * degrees) -
		Math.sin(from.latitude * degrees) * Math.cos(to.latitude * degrees) * Math.cos(longitudeChange);
	const angle = Math.atan2(y, x) / degrees;
	return angle < 0 ? angle + 360 : angle;
}

// The angle at the earth's center, by the spherical law of cosines: acos, the other way to haversine.
function centralAngle(from: Place, to: Place): number {
	return Math.acos(
		Math.sin(from.latitude * degrees) * Math.sin(to.latitude * degrees) +
			Math.cos(from.latitude * degrees) * Math.cos(to.latitude * degrees) * Math.cos((to.longitude - from.longitude) * degrees),
	);
}

const places: readonly Place[] = [
	{ name: 'Salt Lake City', latitude: 40.7608, longitude: -111.891 },
	{ name: 'Seoul', latitude: 37.5665, longitude: 126.978 },
	{ name: 'Bell Labs', latitude: 40.6842, longitude: -74.4015 },
	{ name: 'Sydney', latitude: -33.8688, longitude: 151.2093 },
	{ name: 'Reykjavik', latitude: 64.1466, longitude: -21.9426 },
];

let route = 0;
for (let index = 1; index < places.length; index += 1) {
	const from = places[index - 1] ?? places[0];
	const to = places[index];
	if (from === undefined || to === undefined) {
		continue;
	}
	const distance = haversine(from, to);
	route += distance;
	console.log(`${from.name} to ${to.name}: ${distance} km, bearing ${bearing(from, to)}, ${centralAngle(from, to) * earthRadius} by cosines`);
}
console.log(`route: ${route} km`);

// A cable hanging between two posts is a catenary, y = a cosh(x / a). Its length is 2a sinh(span / 2a).
const sag = 12.5;
for (const span of [10, 50, 100, 400]) {
	const height = sag * Math.cosh(span / 2 / sag) - sag;
	const length = 2 * sag * Math.sinh(span / 2 / sag);
	const slope = Math.sinh(span / 2 / sag);
	console.log(`span ${span}: height ${height}, length ${length}, end angle ${Math.atan(slope) / degrees}, x back ${sag * Math.asinh(slope)}`);
	console.log(`  from height: ${sag * Math.acosh((height + sag) / sag)}, tanh ${Math.tanh(span / sag)}, atanh ${Math.atanh(Math.tanh(span / 2 / sag / 4))}`);
}

// Money: continuous compounding, and how long to double, near zero where expm1 and log1p matter.
for (const rate of [0.05, 0.001, 1e-9, 0.25]) {
	const continuous = 1000 * Math.exp(rate * 30);
	const interestOnly = 1000 * Math.expm1(rate);
	const doubling = Math.log(2) / Math.log1p(rate);
	console.log(`rate ${rate}: ${continuous} after 30 years, ${interestOnly} in one, doubles in ${doubling}`);
}

// Sound and bits: decibels are log10, bits are log2, and a cube's side is cbrt of its volume.
const levels = new Map<string, number>([
	['whisper', 1e-10],
	['speech', 1e-6],
	['concert', 1e-1],
	['jet', 100],
]);
for (const [source, intensity] of levels) {
	console.log(`${source}: ${10 * Math.log10(intensity / 1e-12)} dB, ${Math.log2(intensity / 1e-12)} doublings`);
}
for (const volume of [27, 2, 1e-300, 1000000, -8]) {
	console.log(`cube of ${volume}: side ${Math.cbrt(volume)}`);
}

// Slopes, and distances by hypot in two, three and more dimensions.
for (const angle of [0, 30, 45, 60, 89.99, -45, 1e10]) {
	console.log(`tan ${angle}: ${Math.tan(angle * degrees)}`);
}
console.log(`${Math.hypot(3, 4)} ${Math.hypot(1, 1, 1)} ${Math.hypot(1, 2, 3, 4, 5)} ${Math.hypot()} ${Math.hypot(-7)} ${Math.hypot(1e200, 1e200)} ${Math.hypot(1e-200, 3e-200)}`);
console.log(`${Math.hypot(0 / 0, 1 / 0)} ${Math.hypot(0 / 0, 1)} ${Math.hypot(-0, -0)} ${Math.atan2(-0, -1)} ${Math.atan2(0, -0)} ${Math.atan2(1, 0)}`);
console.log(`${Math.sin(1e300)} ${Math.cos(1e22)} ${Math.sin(-0)} ${Math.log(-1)} ${Math.log(0)} ${Math.exp(710)} ${Math.exp(-746)} ${Math.asin(2)}`);
