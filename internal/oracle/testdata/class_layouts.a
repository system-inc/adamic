// A field of a class is read and written where the class's layout puts it, after one check that the
// object has the class's shape. That check is needed: tsc lets an object literal stand where the
// class is expected, its fields in an order of its own, and stage 0 compiles it, so the literal's
// fields must still be found by name. Reads and writes, of numbers, strings, arrays and objects,
// through this, through ?., through compound assignment, and the generic class, which is looked up.

class Point {
	y = 0;
	x = 0;
	label = 'point'.repeat(1);
	tags: string[] = [];
	next: Point | undefined = undefined;

	move(by: number): number {
		this.x += by;
		this.y -= by * 2;
		return this.x * 10 + this.y;
	}
}

function describe(point: Point): string {
	return `${point.label}(${point.x},${point.y})[${point.tags.join('+')}]${point.next?.label ?? '-'}`;
}

const first = new Point();
first.x = 3;
first.y = 4;
first.label = `first-${first.x}`;
first.tags.push('a'.repeat(2));
const second = new Point();
second.next = first;
second.label += '!';
console.log(`${describe(first)} ${describe(second)} ${first.move(5)} ${describe(first)}`);

// Literals with the class's type, fields in other orders and with fewer slots before them.
const literal: Point = { x: 7, y: 8, label: 'literal', tags: ['t'], next: first, move: (by: number) => by };
const reordered: Point = { next: undefined, tags: [], label: 'reordered', x: -1, y: -2, move: (by: number) => -by };
console.log(`${describe(literal)} ${describe(reordered)}`);
literal.x += 10;
reordered.y = literal.x * 2;
reordered.label = `${reordered.label}:${literal.next?.x ?? -1}`;
console.log(`${describe(literal)} ${describe(reordered)} ${literal.x + reordered.y}`);

// Mixed in one array, read in one loop: the same place in the program sees both shapes in turn.
const points: Point[] = [first, literal, second, reordered, new Point()];
let total = 0;
const labels: string[] = [];
for (const point of points) {
	total += point.x * 3 + point.y;
	point.y += 1;
	labels.push(point.label);
}
console.log(`${total} ${labels.join(',')} ${points.map((point) => point.y).join(',')}`);

// A generic class has a layout per instantiation, and is read by name.
class Box<Item> {
	count = 0;
	value: Item;
	constructor(value: Item) {
		this.value = value;
	}
}
const box = new Box<string>('boxed'.repeat(2));
const numbers = new Box<number>(42);
box.count += 2;
numbers.value += 1;
console.log(`${box.value} ${box.count} ${numbers.value} ${numbers.count}`);
