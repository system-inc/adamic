// splice on an array with nothing in it: no element moves, and no pointer arithmetic may be done on
// an array that has no storage yet (NULL + 0 is undefined behavior in C). Found by adamic-fuzz (seed
// 84 of the widened generator): UBSan, "applying zero offset to null pointer", in the runtime.
const empty: number[] = [];
const none = empty.splice(0, 0);
console.log(`${none.length} ${empty.length}`);
const words: string[] = [];
const removed = words.splice(-1, 2);
words.splice(0, 0, `w${removed.length}`);
console.log(`${words.join(',')} ${words.splice(0).join(',')} ${words.length}`);
