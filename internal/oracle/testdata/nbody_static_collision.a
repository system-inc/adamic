// Static names must keep parent lookup without disrupting ordinary object stores.
class Parent { static shared = `parent${1}`; static flag = false; }
class Child extends Parent {}
class Grandchild extends Child {}
class Instance { shared = `instance${2}`; flag = true; }
function read(value: typeof Parent): string { return `${value.shared}/${value.flag}`; }
function write(value: typeof Parent, text: string): void { value.shared = text; value.flag = true; }
const instance = new Instance();
const literal = { shared: `literal${3}`, flag: false };
instance.shared = instance.shared + '!';
literal.shared = instance.shared;
literal.flag = instance.flag;
console.log(`${instance.shared}/${literal.shared}/${literal.flag}`);
console.log(read(Grandchild));
Parent.shared = `updated${4}`;
console.log(read(Child));
write(Child, `child${5}`);
Parent.shared = `later${6}`;
console.log(`${read(Parent)}|${read(Child)}|${read(Grandchild)}`);
write(Grandchild, `grand${7}`);
Child.shared = `child${8}`;
console.log(`${read(Parent)}|${read(Child)}|${read(Grandchild)}`);
console.log(Object.keys(Child).join(',') + '/' + Object.keys(Grandchild).join(','));
