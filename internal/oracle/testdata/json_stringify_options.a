console.log(JSON.stringify({ b: 1, a: [true, null, { z: 3, a: 4 }] }, undefined, 2) ?? '<undefined>');
console.log(JSON.stringify({ b: 1, a: { b: 2, a: 3 }, ignored: undefined }, ['a', 'b', 'a'], '->') ?? '<undefined>');
console.log(JSON.stringify({ '2': 2, a: 1, b: 3 }, [2, 'b', 2, 'missing'], 2.9) ?? '<undefined>');
console.log(JSON.stringify({ x: 1 }, [], 10) ?? '<undefined>');
console.log(JSON.stringify([1, { x: 2 }], [], 1) ?? '<undefined>');
const keys: readonly string[] = ['b', 'a', 'b', '2'];
console.log(JSON.stringify({ a: 1, b: { a: 2, b: 3 }, '2': 4 }, keys) ?? '<undefined>');
for (const space of [-1, 0, 0.9, 1.9, 10, 100, NaN, Infinity]) {
 console.log(JSON.stringify([1, []], null, space) ?? '<undefined>');
}
console.log(JSON.stringify([[1]], undefined, '123456789🌍extra') ?? '<undefined>');
console.log(JSON.stringify([1], undefined, '') ?? '<undefined>');
let value = 7;
function change(): string { value = 9; return ' '; }
console.log(JSON.stringify(value, null, change()) ?? '<undefined>');
let text = 'runtime'.repeat(2);
function replace(): number { text = 'replacement'; return 2; }
console.log(JSON.stringify(text, null, replace()) ?? '<undefined>');
console.log(`${value} ${text}`);
console.log(JSON.stringify([[1]], undefined, String.fromCharCode(0xdc00, 0xd800)) ?? '<undefined>');
