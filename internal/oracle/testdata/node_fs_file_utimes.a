import { programArguments } from 'adamic';
const root = programArguments()[0] ?? '';
function failure(error: Error): void {
    const errno: NodeJS.ErrnoException = error;
    console.log(`${errno.code ?? ''}: ${error.message.replace(root, '<root>')}`);
}
import { utimesSync, statSync } from 'node:fs';
utimesSync(root + '/file',1000.123,1700000000.987654);
console.log(`${statSync(root + '/file').mtimeMs}`);
utimesSync(root + '/link',new Date(1234567890123),new Date(1234567890123));
console.log(`${statSync(root + '/file').mtime.getTime()}`);
try { utimesSync(root + '/missing',0,0); } catch(error) { if (error instanceof Error) { failure(error); } }
try { utimesSync(root + '/file',NaN,0); } catch(error) { if (error instanceof Error) { failure(error); } }
utimesSync(root + '/file',new Date(-1234),new Date(-1234));
console.log(`negative=${statSync(root + '/file').mtimeMs}`);
utimesSync(root + '/file',new Date(NaN),new Date(NaN));
console.log(`invalid=${statSync(root + '/file').mtimeMs}`);
utimesSync(root + '/file',new Date(1234),2);
console.log(`mixed=${statSync(root + '/file').mtimeMs}`);
utimesSync(root + '/file',2,new Date(1234));
console.log(`mixed=${statSync(root + '/file').mtimeMs}`);
utimesSync(root + '/file', new Date(946684800000), new Date(946684801000));
console.log(`${statSync(root + '/file').atime.getTime()} ${statSync(root + '/file').mtime.getTime()}`);
