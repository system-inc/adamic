// TypeScript condition coverage; also preserves the resolved base's Adamic behavior.
function probe(value: (() => number) | undefined): void {
    let branch = 'false';
    if (value) { branch = 'true'; }
    let loops = 0;
    while (value) { loops += 1; break; }
    for (; value;) { loops += 1; break; }
    console.log(`${branch}:${value ? 'true' : 'false'}:${!value}:${loops}`);
}
probe(() => 0);
probe(undefined);
