// Store an arrow that keeps its receiver, then call the override later.
interface Item { readonly label: string; }
class Reader { read(items: Item[]): number { return items.length; } }
class Child extends Reader { override read(items: Item[]): number { return super.read(items); } }
class Grandchild extends Child {
    override read(items: Item[]): number { items.pop(); return items.length; }
}
function inspect(reader: Reader, index: number): void {
    const later = (items: Item[]): number => reader.read(items);
    const items: Item[] = [{ label: `method${index}` }];
    const first = items[0] ?? { label: `missing${index}` };
    console.log(`${later(items)}/${first.label}/${items.length}`);
}
inspect(new Reader(), 0);
inspect(new Child(), 1);
inspect(new Grandchild(), 2);
function literal(): void {
    const items: Item[] = [{ label: `literal${3}` }];
    const first = items[0] ?? { label: `missing${items.length}` };
    ((values: Item[]): void => { values.pop(); })(items);
    console.log(`${first.label}/${items.length}`);
}
literal();
