class Extension { name = "x"; }
interface NA<T> extends ReadonlyArray<T> { pos: number; end: number }
function first(): { pos: number; end: number } | readonly Extension[] { return [new Extension()]; }
let v: { pos: number; end: number } | readonly Extension[] = first();
v = [new Extension()];
