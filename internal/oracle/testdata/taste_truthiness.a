function number(value: number): string {
 return `${value ? 1 : 0} ${!value} ${value || 7} ${value && 9}`;
}
for (const value of [0, -0, NaN, 1, -1, Infinity]) { console.log(number(value)); }
function text(value: string | undefined): string {
 return `${value ? 1 : 0} ${!value} ${value || 'fallback'} ${value && 'yes'}`;
}
console.log(text(undefined)); console.log(text('')); console.log(text('0'));
function maybe(value: number | undefined): string {
 return `${value ? 1 : 0} ${!value} ${value || 4} ${value && 5}`;
}
console.log(maybe(undefined)); console.log(maybe(0)); console.log(maybe(NaN)); console.log(maybe(2));
function mixed(value: number | string | boolean | undefined): string {
 return `${value ? 1 : 0} ${!value} ${value || 'fallback'} ${value && 'yes'}`;
}
console.log(mixed(undefined)); console.log(mixed(false)); console.log(mixed(0)); console.log(mixed(NaN)); console.log(mixed('')); console.log(mixed('x')); console.log(mixed(true));
class Box { readonly value = 0; }
const box = new Box(); const empty: number[] = []; const functions = [(): number => 0]; const fn = functions[0];
console.log(`${box ? 1 : 0} ${empty ? 1 : 0} ${fn ? 1 : 0}`);
const match = /x/.exec('no'); const found = /x/.exec('x');
console.log(`${match ? 1 : 0} ${found ? 1 : 0}`);
let calls = 0;
function next(): number { calls += 1; return calls < 3 ? calls : 0; }
if (next()) { console.log(`if ${calls}`); }
while (next()) { console.log(`while ${calls}`); }
do { calls += 1; } while (next());
for (let i = 2; i; i -= 1) { console.log(`for ${i}`); }
console.log(`${next() || 42} ${calls}`);
console.log(`${next() && 42} ${calls}`);
function reference(value: Box | null): string {
 return `${value ? 1 : 0} ${!value} ${(value || box) === box} ${(value && box) === null}`;
}
console.log(reference(null)); console.log(reference(box));
function answer(value: boolean | undefined): string {
 return `${value ? 1 : 0} ${!value} ${value || true} ${value && true}`;
}
console.log(answer(undefined)); console.log(answer(false)); console.log(answer(true));
function side(): string { calls += 1; return `s${calls}`; }
console.log(`${side() || side()} ${calls}`);
console.log(`${side() && side()} ${calls}`);
