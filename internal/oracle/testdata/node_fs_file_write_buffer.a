import { programArguments } from 'adamic';
import { Buffer } from 'node:buffer';
import { readFileSync, writeFileSync, openSync, writeSync, closeSync } from 'node:fs';
const root = programArguments()[0] ?? '';
const data = Buffer.from([0,0xe2,0x82,0xff,0xed,0xa0,0x80,0xff]);
writeFileSync(root + '/binary',data,{mode:0o600});
console.log(readFileSync(root + '/binary').toString('hex'));
writeFileSync(root + '/binary',Buffer.from([255]),{flag:'a',flush:true});
console.log(readFileSync(root + '/binary').toString('hex'));
const fd = openSync(root + '/binary-fd','w');
writeFileSync(fd,data,{flush:true});
writeSync(fd,'!');
closeSync(fd);
console.log(readFileSync(root + '/binary-fd').toString('hex'));
writeFileSync(root + '/binary',Buffer.from(''));
console.log(readFileSync(root + '/binary').toString('hex'));
try { writeFileSync(root + '/missing/child',data); }
catch(error) { if(error instanceof Error) { const code = 'code' in error && typeof error.code === 'string' ? error.code : undefined; console.log(`${code??''}: ${error.message.replace(root,'<root>')}`); } }
