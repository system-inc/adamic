function errorCode(error: unknown): string | undefined {
    return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' ? error.code : undefined;
}
import { programArguments } from 'adamic';
import { Buffer } from 'node:buffer';
import { readFileSync, writeFileSync, openSync, writeSync, closeSync } from 'node:fs';
const root = programArguments()[0] ?? '';
function errorCode(error: unknown): string | undefined {
    return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' ? error.code : undefined;
}
const data = Buffer.from([0,0xe2,0x82,0xff,0xed,0xa0,0x80,0xff]);
const binaryOptions = {mode:0o600};
writeFileSync(root + '/binary',data,binaryOptions);
console.log(readFileSync(root + '/binary').toString('hex'));
const appendOptions = {flag:'a',flush:true};
writeFileSync(root + '/binary',Buffer.from([255]),appendOptions);
console.log(readFileSync(root + '/binary').toString('hex'));
const fd = openSync(root + '/binary-fd','w');
const flushOptions = {flush:true};
writeFileSync(fd,data,flushOptions);
writeSync(fd,'!');
closeSync(fd);
console.log(readFileSync(root + '/binary-fd').toString('hex'));
writeFileSync(root + '/binary',Buffer.from(''));
console.log(readFileSync(root + '/binary').toString('hex'));
try { writeFileSync(root + '/missing/child',data); }
catch(error) { if(error instanceof Error) { console.log(`${errorCode(error)??''}: ${error.message.replace(root,'<root>')}`); } }
