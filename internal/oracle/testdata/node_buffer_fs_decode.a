// The combined fs-file and Buffer host path, held to source Node on both backends.
// Explicit defaults satisfy checked indexed access without changing BOM semantics.
import { Buffer, type Buffer as ByteBuffer } from 'node:buffer';
import { mkdtempSync, readFileSync, writeFileSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
function read(buffer: ByteBuffer): string {
 let len = buffer.length;
 if (len >= 2 && buffer[0] === 0xfe && buffer[1] === 0xff) {
  len &= ~1;
  for (let i = 0; i < len; i += 2) {
   const temp = buffer[i] ?? 0;
   buffer[i] = buffer[i + 1] ?? 0;
   buffer[i + 1] = temp;
  }
  return buffer.toString('utf16le', 2);
 }
 if (len >= 2 && buffer[0] === 0xff && buffer[1] === 0xfe) { return buffer.toString('utf16le', 2); }
 if (len >= 3 && buffer[0] === 0xef && buffer[1] === 0xbb && buffer[2] === 0xbf) { return buffer.toString('utf8', 3); }
 return buffer.toString('utf8');
}
const root = mkdtempSync(join(tmpdir(), 'adamic-buffer-decode-'));
try {
 for (const hex of ['', 'feff0041d8000042ff', 'feff0041d83cdf0d', 'feffdc00', 'fffe41004200ff', 'fffe00d8', 'fffe00dc', 'efbbbf61f09f8c8d', 'efbbbfe282ff', 'ed a0 80', '616263', 'fe', 'feff', 'fffe', 'efbbbf']) {
  const path = root + '/bytes';
  writeFileSync(path, Buffer.from(hex.replaceAll(' ', ''), 'hex'));
  const bytes = readFileSync(path);
  console.log(JSON.stringify(read(bytes)));
  console.log(bytes.toString('hex'));
 }
}
finally {
 rmSync(root, { recursive: true, force: true });
}
