// JSON.stringify of an object reference prints the allocation behind it (#d9ep7de): a literal held in a
// binding, passed to a parameter, and printed with a space and a key list.
interface Point {
	readonly x: number;
	readonly y: number;
}
const point: Point = { x: 1, y: 2 };
console.log(JSON.stringify(point) ?? '<undefined>');
function makeNamed(nothing: string | null) {
	return { name: 'adamic', count: 3, ready: true, ratio: 0.5, label: 'é"\n', nothing };
}
const named = makeNamed(null);
console.log(JSON.stringify(named) ?? '<undefined>');
function show(value: Point): string {
	return JSON.stringify(value) ?? '<undefined>';
}
console.log(show({ x: -0, y: NaN }));
console.log(show({ x: Infinity, y: 1e21 }));
console.log(JSON.stringify(point, null, 2) ?? '<undefined>');
console.log(JSON.stringify(point, ['y']) ?? '<undefined>');
