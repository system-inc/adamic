// The same shape as def_before_throw.a, read three other ways: after a catch that swallows, by a
// finally, and with an array spread.
type Tree = { value: number; label: string };
function fail(when: boolean): Tree {
	if (when) {
		throw new Error(`failed${1}`);
	}
	return { value: 0, label: `zero${0}` };
}
function failArray(when: boolean): number[] {
	if (when) {
		throw new Error(`array${1}`);
	}
	return [0];
}
function afterSwallow(): string {
	let local: Tree = { value: 5, label: `after${5}` };
	try {
		const other = { ...local, value: 6 };
		local = fail(true);
		console.log(`${other.value}`);
	} catch (error) {
		console.log(`swallowed`);
	}
	return `after: ${local.value} ${local.label}`;
}
function inFinally(): string {
	let local: Tree = { value: 3, label: `finally${3}` };
	try {
		const other = { ...local, value: 4 };
		local = fail(true);
		return `${other.value}`;
	} finally {
		console.log(`finally: ${local.value} ${local.label}`);
	}
}
function arraySpread(): string {
	let numbers: number[] = [1, 2, 3];
	numbers.push(4);
	try {
		const longer = [...numbers, 5];
		numbers = failArray(true);
		return `${longer.length}`;
	} catch (error) {
		return `array caught: ${numbers.length} ${numbers.join(',')}`;
	}
}
console.log(afterSwallow());
try {
	console.log(inFinally());
} catch (error) {
	console.log(`outer caught`);
}
console.log(arraySpread());
