// A wrong producer-certified callable union read by a string-literal key, then called.
type Target = ((value: number) => number) | ((value: number) => string);
interface Receiver { readonly kind: 'Receiver'; readonly value: Target; }
const raw = { kind: 'Receiver' as const, value: (value: string): number => value.length };
const base: { readonly kind: 'Receiver' } = raw;
const view = base as Receiver;
const callable = view['value'];
console.log(`${callable(5)}`);
