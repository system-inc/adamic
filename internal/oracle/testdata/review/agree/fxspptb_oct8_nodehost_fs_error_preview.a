import { openSync, closeSync, mkdtempSync, mkdirSync, readdirSync, symlinkSync } from 'node:fs';
function code(error: unknown): string { return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' ? error.code : ''; }
function report(error: Error): void { console.log(`${error.name}|${code(error)}|${error.message}`); }
// The first seven are the program as found. The rest hold util.inspect's table as Node v24.19.0 writes it (#n6hgpm0):
// C0 controls and DEL in uppercase hex, the C1 controls at both ends and the raw units past them, both surrogate
// halves alone, a pair and a reversed pair, a backslash, each quote rule, the 128-unit cut inside an escape and
// between a pair's halves, and a string past 124 units split after its line feeds, each piece quoted on its own.
for (const value of ['x\ud800\0', 'x\udfff\0', 'x\u0085\0', 'x \0', '\0\n\t\b\v\f\r', "'\"`$\0", 'a'.repeat(130) + '\0',
    'x\x01\x0e\x1a\x1f\x7f\0', 'x\x80\x8a\x9f\xa0\xad\xff\0', 'x\udbff\0', 'x\udc00\0', 'x😀\0', 'x\udc00\ud800\0', 'x\ud800a\0', 'a\\b\0',
    "a'b\0", 'a"b\0', 'a\'"b\0', "a'`b\0", '\'"$\0', '\'"${\0', 'a${b\0',
    'a'.repeat(125) + '\ud800\0', 'a'.repeat(124) + '\x85\0', 'a'.repeat(126) + '😀\0', 'a'.repeat(125) + '😀\0',
    'a'.repeat(61) + '\n' + 'b'.repeat(61) + '\0', 'a'.repeat(61) + '\n' + 'b'.repeat(62) + '\0', 'a'.repeat(70) + "'\n" + 'b'.repeat(60) + '\0', 'a\n' + 'b'.repeat(140) + '\0']) {
    try { closeSync(openSync(value, 'r')); }
    catch(error) { if(error instanceof Error) report(error); }
    try { mkdtempSync(value); }
    catch(error) { if(error instanceof Error) report(error); }
    try { mkdirSync(value); }
    catch(error) { if(error instanceof Error) report(error); }
    try { closeSync(openSync('unused', value)); }
    catch(error) { if(error instanceof Error) report(error); }
    try { readdirSync(value); }
    catch(error) { if(error instanceof Error) report(error); }
    try { symlinkSync(value, 'unused'); }
    catch(error) { if(error instanceof Error) report(error); }
}
