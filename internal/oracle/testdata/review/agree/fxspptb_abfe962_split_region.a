interface Item { readonly text: string; }
let saved: Item | undefined;
function make(value: number): Item { return { text: `item${value}` }; }
class Box<T> {
    readonly value: T;
    constructor(value: T) { this.value = value; }
    size(item: Item): number { return item.text.length; }
}
class Saving extends Box<{ readonly n: number }> {
    override size(item: Item): number { saved = item; return item.text.length; }
}
function measure(box: Box<{ readonly n: number }>, value: number): void {
    console.log(`${box.size(make(value))}`);
}
measure(new Saving({ n: 1 }), 12345);
const filler: string[] = [];
for (let index = 0; index < 50; index++) { filler.push(`filler${index}`); }
console.log(`${saved?.text} ${filler.length}`);
