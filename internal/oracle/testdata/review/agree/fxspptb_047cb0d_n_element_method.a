class Box {
	count = 0;
	bump(step: number): number {
		this.count += step;
		return this.count;
	}
}
const boxes: (Box | undefined)[] = [new Box()];
function cut(): void {
	boxes[0] = undefined;
}
if (boxes[0] !== undefined) {
	console.log(`${boxes[0].bump(1)}`);
	cut();
	console.log(`${boxes[0].bump(1)}`);
}
