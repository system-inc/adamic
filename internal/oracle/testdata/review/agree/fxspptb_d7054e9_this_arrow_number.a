// A closure made in a constructor reads a field through this before the field is set: Node reads
// undefined, so count + 1 is NaN, typed number. Adamic 0.1 says it refuses this escaping a constructor
// before every field is set, but a field read inside a closure passes the check.
class Counter {
	readonly start: number;
	readonly count: number;
	constructor() {
		const next = (): number => this.count + 1;
		this.start = next();
		this.count = 5;
	}
}
console.log(`${new Counter().start}`);
const scaled = [1, 2].map((value) => value * new Counter().start);
console.log(scaled.join(','));
