// Long inputs push thousands of choice points: past the 8 KiB arena into heap frames.
function show(m: RegExpExecArray | null): string {
  if (m === null) return 'null';
  return `${m.index} ${m.length} ${m.map(v => v === undefined ? 'U' : v.length > 8 ? `#${v.length}` : v).join(',')}`;
}
let text = '';
for (let i = 0; i < 20000; i++) text += i % 3 === 0 ? 'b' : 'a';
const tail = text + 'c';
console.log(show(/((a)|(b))*c/.exec(tail)));
console.log(show(/((a)|(b))*?c/.exec(tail)));
console.log(`${/((a)|(b))*d/.test(text)}`);
console.log(show(/(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(?=(a))(?<=(a))(b|a)+c/.exec('xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaac')));
console.log(show(/a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?(b)*c/.exec('xaaaaaaaaaaaaaaaaaaaaaabbbc')));
let bb = '';
for (let i = 0; i < 3000; i++) bb += 'ab';
console.log(show(/(?<=(ab)+)c/.exec(bb + 'c')));
console.log(show(/(?<=(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)(a)+)c/.exec(bb + 'aaaaaaaaaaaaaaaaaaaaac')));
console.log(`${tail.replace(/(a+)|(b)/g, '$2').length}`);
const parts = tail.split(/(b)/);
console.log(`${parts.length} ${parts[parts.length - 1]}`);
const sixteen = /(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)(p)/;
console.log(show(sixteen.exec('zabcdefghijklmnop')));
console.log(`${sixteen.test('zabcdefghijklmnop')} ${/(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)(m)(n)(o)/.test('abcdefghijklmno')}`);
