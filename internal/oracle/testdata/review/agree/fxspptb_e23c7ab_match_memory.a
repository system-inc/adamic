function build(n: number): string {
 let s = '';
 for (let i = 0; i < n; i++) s += i % 3 === 0 ? 'ab' : 'b\u{1F30D}';
 return s;
}
const input = build(40);
const named = /(?<first>a)?(b)(?<emoji>\u{1F30D})?/dgu;
let total = 0;
let kept: RegExpExecArray | null = null;
for (let m = named.exec(input); m !== null; m = named.exec(input)) {
 total += m.index;
 const groups = m.groups;
 if (groups !== undefined && groups.first !== undefined) kept = m;
}
console.log(`${total} ${kept === null ? 'none' : kept.index}`);
const all = input.match(/b\u{1F30D}?/gu);
console.log(`${all === null ? 0 : all.length}`);
for (const m of input.matchAll(/(a)(b)/g)) {
 if (m.index > 10) break;
}
function first(): string {
 for (const m of input.matchAll(/(?<x>b)(\u{1F30D})/gu)) {
  const g = m.groups;
  if (g !== undefined) return `${m.index}:${g.x}`;
 }
 return 'none';
}
console.log(first());
console.log(`${input.replace(/(?<x>a)(b)|(z)/g, '[$<x>$2$3$&$`]').length}`);
console.log(input.split(/(a)|(\u{1F30D})/u, 7).map((value) => value ?? 'u').join('|'));
const iterator = input.matchAll(/b/g);
const one = iterator.next();
console.log(`${one.done}`);
const sticky = /(a)(b)/y;
sticky.lastIndex = 0;
const s1 = sticky.exec(input);
const s2 = sticky.exec(input);
console.log(`${s1 === null ? 'null' : s1[1]} ${s2 === null ? 'null' : s2[1]} ${sticky.lastIndex}`);
