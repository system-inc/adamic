// The direct (non-virtual) form of virtual_map_borrow.a: Worker.run only reads its array, but its
// position is consumed because an override maps in place, so a direct call hands the array over and
// Worker.run lets go of it. A variable borrowed from that array, still read after, is left dangling.
interface Box {
	v: string;
}
class Worker {
	run(items: Box[]): number {
		return items.length;
	}
}
class Mapper extends Worker {
	run(items: Box[]): number {
		const out = items.map((box) => ({ v: `${box.v}!` }));
		return out.length;
	}
	twice(): string {
		const items: Box[] = [{ v: `a${1}` }, { v: `b${2}` }];
		const first = items[0] ?? { v: `z${0}` };
		const count = super.run(items);
		return `${first.v} ${count}`;
	}
}
console.log(new Mapper().twice());
