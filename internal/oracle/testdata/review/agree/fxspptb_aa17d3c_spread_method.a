// A spread whose literal calls a method on the source: the method receives the source as this while
// its replaced field has been moved out (reuse.go's take), if the receiver read is counted as a
// field read.
interface Leaf {
	v: string;
}
interface Tree {
	left: Leaf;
	tag: string;
	peek(): string;
}
class Real implements Tree {
	left: Leaf;
	tag: string;
	constructor(left: Leaf) {
		this.left = left;
		this.tag = `t${0}`;
	}
	peek(): string {
		return this.left.v;
	}
}
interface Plain {
	left: Leaf;
	tag: string;
}
function grow(leaf: Leaf): Leaf {
	return { v: `${leaf.v}+` };
}
function rebuild(tree: Tree): Plain {
	return { ...tree, left: grow(tree.left), tag: tree.peek() };
}
const made = rebuild(new Real({ v: `a${1}` }));
console.log(`${made.left.v} ${made.tag}`);
