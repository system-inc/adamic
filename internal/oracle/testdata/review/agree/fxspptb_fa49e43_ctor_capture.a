// A class constructor whose object a closure captures, the closure kept in a global. The object
// outlives the statement that made it, so it can't be made in that statement's region.
let later: () => string = () => '-';

class Counter {
	label: string;
	constructor(count: number) {
		this.label = `counter${count}`;
		later = () => this.label;
	}
}

function size(counter: Counter): number {
	return counter.label.length;
}

console.log(`${size(new Counter(5))}`);
console.log(later());
console.log(`${size(new Counter(12))}`);
console.log(later());
