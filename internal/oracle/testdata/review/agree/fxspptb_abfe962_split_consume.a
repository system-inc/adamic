interface Item { readonly text: string; readonly count: number; }
function make(value: number): Item { return { text: `item${value}`, count: value }; }
class Box<T> {
    readonly value: T;
    constructor(value: T) { this.value = value; }
    replace(item: Item): Item { return { text: `${item.text}?`, count: item.count }; }
}
class Reusing extends Box<{ readonly n: number }> {
    override replace(item: Item): Item { return { ...item, text: `${item.text}!` }; }
}
function swap(box: Box<{ readonly n: number }>, item: Item): Item {
    return box.replace(item);
}
const kept = make(5);
const swapped = swap(new Reusing({ n: 1 }), kept);
console.log(`${kept.text} ${swapped.text} ${kept === swapped}`);
