// A spread reuses local's object in the statement before an assignment to local that can throw, and
// the catch reads local's old value.
type Tree = { value: number; label: string };
function fail(when: boolean): Tree {
	if (when) {
		throw new Error(`failed${1}`);
	}
	return { value: 0, label: `zero${0}` };
}
function spreadThenAssign(): string {
	let local: Tree = { value: 5, label: `local${5}` };
	try {
		const other = { ...local, value: 6 };
		local = fail(true);
		return `${other.value}`;
	} catch (error) {
		return `spread caught: ${local.value} ${local.label}`;
	}
}
function consume(node: Tree): Tree {
	return { ...node, value: node.value + 100 };
}
function moveThenAssign(): string {
	let local: Tree = { value: 7, label: `moved${7}` };
	try {
		const other = consume(local);
		local = fail(true);
		return `${other.value}`;
	} catch (error) {
		return `move caught: ${local.value} ${local.label}`;
	}
}
console.log(moveThenAssign());
