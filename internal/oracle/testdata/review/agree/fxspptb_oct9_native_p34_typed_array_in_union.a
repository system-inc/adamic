interface Root { readonly kind: 'Holder'; }
interface View extends Root { readonly value: string | Uint8Array; }
const raw = { kind: 'Holder' as const, value: new Uint8Array(3) };
const base: Root = raw;
const viewed = base as View;
const read = viewed.value;
console.log(typeof read === 'string' ? read : `${read.length}`);
