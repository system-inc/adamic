class Gauge {
    #level: number | undefined = undefined;
    get level(): number | undefined { return this.#level; }
    set level(value: number | undefined) { this.#level = value; }
}
const gauge = new Gauge();
gauge.level = 3;
function show(g: Gauge): string { return `${g.level}`; }
console.log(show(gauge));
