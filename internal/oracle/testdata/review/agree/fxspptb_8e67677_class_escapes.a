function t(pattern: RegExp, inputs: string[]): string { return inputs.map(i => pattern.test(i) ? '1' : '0').join(''); }
console.log(t(new RegExp('[\\B]'), ['B', '\b', 'x']));
console.log(t(new RegExp('[\\8\\9]'), ['8', '9', '\b']));
console.log(t(new RegExp('[\\_]'), ['_', '\\']));
console.log(t(new RegExp('[\\-]'), ['-']));
console.log(t(new RegExp('[\\c]'), ['\\', 'c']));
console.log(t(new RegExp('[\\ca]'), ['\x01', 'a']));
console.log(t(new RegExp('\\c0'), ['\\c0', '\x10']));
console.log(t(new RegExp('[\\x]'), ['x', '\\']));
console.log(t(new RegExp('[\\u]'), ['u']));
console.log(t(new RegExp('[\\u{41}]'), ['A', 'u', '{', '4', '}']));
console.log(t(new RegExp('[\\400]'), [' 0', '\x20', '0']));
console.log(t(new RegExp('\\400'), [' 0', '\x200']));
console.log(t(new RegExp('\\377'), ['\xff']));
console.log(t(new RegExp('[\\377]'), ['\xff', '3']));
console.log(t(new RegExp('(a)[\\1]'), ['a\x01', 'a1']));
console.log(t(new RegExp('[\\d-z]'), ['-', 'z', 'y', '5']));
console.log(t(new RegExp('[%-\\d]'), ['-', '%', '&', '5']));
