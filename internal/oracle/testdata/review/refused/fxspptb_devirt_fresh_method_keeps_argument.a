interface Node {
    readonly label: string;
    readonly children: Node[];
}
let saved: Node = { label: `empty${0}`, children: [] };
class Keeper {
    keep(node: Node): number {
        saved = node;
        return node.children.length;
    }
}
function run(keeper: Keeper): void {
    const node: Node = { label: `node${1}`, children: [] };
    keeper.keep(node);
    node.children.push(saved); // closes the cycle
    console.log(`${node.children.length}`);
}
run(new Keeper());
saved = { label: `cleared${3}`, children: [] };
