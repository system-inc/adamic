// a-check: refused an unproven type predicate; the overload implementation does not prove both directions
function isText(x: string | number): x is string;
function isText(x: string | number): boolean {
  x = "rebound";
  return typeof x === "string";
}
function f(v: string | number): void {
  if (isText(v)) {
    console.log("text " + v);
  } else {
    console.log("number " + String(v + 1));
  }
}
f("a");
f(41);
