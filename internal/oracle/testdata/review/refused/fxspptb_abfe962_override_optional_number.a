class Base {
    scale(value: number, factor: number = 2): number { return value * factor; }
}
class Child extends Base {
    override scale(value: number, factor: number): number { return value * factor + 1; }
}
const values: readonly Base[] = [new Base(), new Child()];
for (const value of values) {
    console.log(`${value.scale(3)} ${value.scale(3, 4)}`);
}
