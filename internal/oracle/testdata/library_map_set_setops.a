// Empty, self, proper subset, and SameValueZero overlap for every ES2025 Set method.
function show(values: ReadonlySet<number>): string {
	const parts: string[] = [];
	for (const value of values) {
		if (Number.isNaN(value)) {
			parts.push('NaN');
		} else if (value === 0) {
			parts.push(1 / value > 0 ? '+0' : '-0');
		} else {
			parts.push(`${value}`);
		}
	}
	return parts.join(',');
}

function row(label: string, left: Set<number>, right: Set<number>): void {
	console.log(`${label} union ${show(left.union(right))} ${show(right.union(left))}`);
	console.log(`${label} intersection ${show(left.intersection(right))} ${show(right.intersection(left))}`);
	console.log(`${label} difference ${show(left.difference(right))} ${show(right.difference(left))}`);
	console.log(`${label} symmetric ${show(left.symmetricDifference(right))} ${show(right.symmetricDifference(left))}`);
	console.log(`${label} predicates ${left.isSubsetOf(right)} ${left.isSupersetOf(right)} ${left.isDisjointFrom(right)} ${right.isSubsetOf(left)} ${right.isSupersetOf(left)} ${right.isDisjointFrom(left)}`);
}

const empty = new Set<number>();
const some = new Set<number>([2, 1]);
const self = new Set<number>([1, 2, 3]);
row('empty', empty, empty);
row('empty some', empty, some);
row('self', self, self);
row('subset', some, new Set<number>([1, 2, 3]));
row('overlap', new Set<number>([1, 2, 3]), new Set<number>([3, 4, 2]));
row('nan', new Set<number>([NaN, 1]), new Set<number>([NaN, 2]));
row('zero', new Set<number>([-0, 1]), new Set<number>([0, 2]));

const concrete = new Set<number>([1, 2]);
const asReadonly: ReadonlySet<number> = concrete;
console.log(`readonly ${show(new Set<number>([2, 3]).union(asReadonly))} ${show(concrete.intersection(asReadonly))}`);
console.log(`unchanged ${show(some)} ${show(self)} ${empty.size}`);
