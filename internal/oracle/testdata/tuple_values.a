// Tuples as values: made by a literal wherever the checker types it a tuple, returned, passed, held in
// fields, arrays and maps, destructured into names at the top level and in functions, and read by
// index. Each is an object of its elements, so the strings in it are counted like any field's.
type Pair = readonly [string, number];

function cut(text: string, prefix: string): readonly [string, boolean] {
	if (text.startsWith(prefix)) {
		return [text.slice(prefix.length), true];
	}
	return [text, false];
}

function describe(pair: Pair): string {
	const [word, count] = pair;
	return `${word}=${count}`;
}

function swap(pair: Pair): readonly [number, string] {
	return [pair[1], pair[0]];
}

function maybeFirst(words: readonly string[]): [string | undefined, number] {
	return [words[0], words.length];
}

const [rest, found] = cut('prefix/rest', 'prefix/');
const [unchanged, notFound] = cut('other', 'prefix/');
console.log(`${rest} ${found} ${unchanged} ${notFound}`);

const pairs: Pair[] = [['b', 2], ['a', 3], ['c', 1]];
pairs.push(['d', 0]);
pairs.sort((left, right) => left[1] - right[1]);
console.log(pairs.map(describe).join(' '));
for (const [word, count] of pairs) {
	console.log(`${word.repeat(count)}|`);
}
const swapped = pairs.map((pair): readonly [number, string] => [pair[1], `${pair[0]}!`]);
console.log(swapped.map((pair) => `${pair[0]}:${pair[1]}`).join(' '));
console.log(`${swap(['x', 9])[1]} ${swap(['x', 9])[0]}`);

const [, second] = cut('ab', 'a');
const [missing, size] = maybeFirst([]);
const [present] = maybeFirst(['only']);
console.log(`${second} ${missing ?? 'none'} ${size} ${present ?? 'none'}`);

interface Holder {
	readonly pair: Pair;
	readonly name: string;
}

const holder: Holder = { pair: ['held', 7], name: 'holder' };
const same = holder.pair;
console.log(`${describe(holder.pair)} ${same === holder.pair} ${describe(['held', 7]) === describe(holder.pair)}`);

const counts = new Map<string, Pair>();
counts.set('one', ['uno', 1]);
const fetched = counts.get('one');
if (fetched !== undefined) {
	const [spanish, number] = fetched;
	console.log(`${spanish} ${number}`);
}

function deep(depth: number): readonly [string, number] {
	if (depth === 0) {
		return ['bottom', 0];
	}
	const [label, below] = deep(depth - 1);
	return [`${label}<`, below + 1];
}
const [label, levels] = deep(3);
console.log(`${label} ${levels}`);

// Two elements of one type, and holes in a for...of pattern, over an array and a map.
function bounds(values: readonly number[]): readonly [number, number] {
	let smallest = Infinity;
	let largest = -Infinity;
	for (const value of values) {
		smallest = Math.min(smallest, value);
		largest = Math.max(largest, value);
	}
	return [smallest, largest];
}
const [low, high] = bounds([4, 9, 1]);
console.log(`${low}..${high} ${high - low}`);
for (const [, count] of pairs) {
	console.log(`${count}`);
}
for (const [, spanish] of counts) {
	console.log(spanish[0]);
}

// Destructuring assignment: the tuple whole first, then each name in order, a union taking a string,
// number | undefined taking a number, and a hole.
let remainder = 'a/b/c';
let below = true;
while (below) {
	[remainder, below] = cut(remainder, 'a/');
}
let either: string | number = 0;
let maybeCount: number | undefined = undefined;
[maybeCount, either] = swap(['twelve', 12]);
console.log(`${remainder} ${below} ${either} ${maybeCount ?? -1} ${typeof either}`);
[, either] = swap(['word', 1]);
console.log(`${either} ${typeof either}`);

// An optional element left out of a literal is undefined, read through the tuple it's written into.
const optional: [number, string?] = [5];
const both: [number, string?] = [6, 'six'];
const maybeCounts: [string, number?, number?] = ['m'];
console.log(`${optional[0]} ${optional[1] ?? 'none'} ${both[1] ?? 'none'} ${maybeCounts[1] ?? -1} ${maybeCounts[2] ?? -2}`);
