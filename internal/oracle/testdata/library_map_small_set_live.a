function step(iterator: SetIterator<number>, label: string): void {
    const result = iterator.next();
    if (result.done) { console.log(`${label} done`); }
    else { console.log(`${label} ${result.value}`); }
}
const set = new Set<number>([3, 1, 2, 4]);
const iterator = set.values();
step(iterator, 'set');
set.delete(3); set.add(5); set.delete(2); set.add(6); set.add(3);
step(iterator, 'set'); step(iterator, 'set'); step(iterator, 'set'); step(iterator, 'set'); step(iterator, 'set');
set.delete(4); set.delete(5);
console.log(`back ${[...set].join(',')}`);
set.add(7); set.add(8);
console.log(`five ${[...set].join(',')}`);
step(iterator, 'exhausted');
const clearing = set.values();
step(clearing, 'clear'); set.clear(); set.add(9); set.add(10);
step(clearing, 'clear'); step(clearing, 'clear'); step(clearing, 'clear');
console.log(`cleared ${[...set].join(',')}`);
