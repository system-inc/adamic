const hasOwnProperty = Object.prototype.hasOwnProperty;
const object = {value: 1, hasOwnProperty: 2};
console.log(String(hasOwnProperty.call(object, "value")));
console.log(String(hasOwnProperty.call(object, "missing")));
console.log(String(hasOwnProperty.call(object, "toString")));
console.log(String(hasOwnProperty.call(object, "hasOwnProperty")));
console.log(String(Object.prototype.hasOwnProperty.call(object, "value")));
console.log(String(Object.prototype.hasOwnProperty.call(object, "missing")));
console.log(String(Object.prototype.hasOwnProperty.call(object, "toString")));
function key(): string { console.log("key"); return "value"; }
function target(): {value: number} { console.log("target"); return {value: 2}; }
console.log(String(Object.prototype.hasOwnProperty.call(target(), key())));
function local(): boolean {
    const own = Object.prototype.hasOwnProperty;
    return own.call(object, "value");
}
console.log(String(local()));
function captured(): boolean {
    const own = Object.prototype.hasOwnProperty;
    const value = {value: 3};
    const check = () => own.call(value, "value");
    return check();
}
console.log(String(captured()));
