// String.fromCharCode, ToUint16 on every edge, and String.fromCodePoint, over values that are code
// points. Each string is shown by its UTF-16 units, so a lone surrogate shows as itself, and printed,
// where a lone surrogate is U+FFFD.
function units(text: string): string {
	const codes: string[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(`${text.charCodeAt(index)}`);
	}
	return `[${codes.join(' ')}]`;
}

const edges = [
	0, -0, 65, 65.9, -65.9, -1, -65535, -65536, -65537, 65535, 65536, 65601, 131137, 4294967296 + 66, -4294967296 - 66,
	1e20, -1e20, 2 ** 53, 2 ** 53 + 2, 0.5, -0.5, NaN, Infinity, -Infinity, 0xd83c, 0xdf0d, 0xffff, 0xfffe, 233,
];
for (const edge of edges) {
	console.log(`${edge}: ${units(String.fromCharCode(edge))}`);
}

const pair = String.fromCharCode(0xd83c, 0xdf0d);
const reversed = String.fromCharCode(0xdf0d, 0xd83c);
console.log(`${pair} ${pair.length} ${pair === '🌍'} ${units(reversed)} ${reversed.length}`);
console.log(`${String.fromCharCode(72, 105, 0x20, 0x4e16, 0x754c, 33)} ${String.fromCharCode() === ''} ${String.fromCodePoint() === ''}`);
console.log(`${units(String.fromCharCode(0xd800))} ${String.fromCharCode(0xd800)}|${String.fromCharCode(0xdc00)}|`);

const points = [0, -0, 0x41, 0x7f, 0x80, 0x7ff, 0x800, 0xffff, 0x10000, 0x1f30d, 0x10ffff, 0xd800, 0xdfff, 233, 0x4e16];
for (const point of points) {
	const made = String.fromCodePoint(point);
	console.log(`${point}: ${units(made)} ${made.codePointAt(0) ?? -1}`);
}
const joined = String.fromCodePoint(0xd83c, 0xdf0d, 0x1f30d, 104);
console.log(`${joined} ${joined.length} ${joined === '🌍🌍h'} ${[...joined].length}`);
