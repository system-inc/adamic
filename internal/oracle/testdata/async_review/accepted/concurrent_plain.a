// Two tasks interleave at their suspensions, as refused/concurrent.a's do, with nothing that can throw
// out of them: each writes the strings it's given and makes none, and its await is inside a try, so it
// always fulfills, and awaiting the first before the second leaves no rejection unobserved. The
// suspension mutants read this one.
async function task(start: string, resume: string, result: string): Promise<string> {
	console.log(start);
	try {
		await Promise.resolve();
	} catch {
		return 'never';
	}
	console.log(resume);
	return result;
}
const first = task('one:start', 'one:resume', 'one:ok');
const second = task('two:start', 'two:resume', 'two:ok');
console.log(await first);
console.log(await second);
