// Repeated prefixes force backward candidates to fail their full byte comparison.
// An internal lone surrogate can stay on the byte path; boundary halves need UTF-16.
const pieces = ['ababa', 'ééβéβ', '中中文', '😀x😀x', 'x\ud800y', 'x\udc00y', '\u0000a\u0000b'];
for (const piece of pieces) {
    const text = `${piece.repeat(40)}!${piece}`;
    const padded = `${'p'.repeat(80)}${text}${'q'.repeat(80)}`;
    const slice = padded.slice(80, 80 + text.length);
    const nested = slice.slice(1, slice.length - 1);
    const needles = [piece, piece.slice(0, 1), piece.slice(-1), `${piece}!`, `${piece}?`, '', 'missing', text, `${text}x`];
    for (const needle of needles) {
        console.log(`${text.indexOf(needle)} ${text.lastIndexOf(needle)} ${slice.indexOf(needle)} ${slice.lastIndexOf(needle)} ${nested.indexOf(needle)} ${nested.lastIndexOf(needle)}`);
    }
    console.log(`${''.indexOf(piece)} ${''.lastIndexOf(piece)} ${''.indexOf('')} ${''.lastIndexOf('')}`);
}
