// A variable borrowed from an array (docs/memory.md, "A variable borrowed from an array"): a const
// given an element holds no count when nothing can take the element out of the array while the
// const lives. Each probe below does take it out, or would let reuse write into it, while the const
// lives and is read after: each must keep its count, or it reads freed memory (or, for the spread,
// the array's own object written over). Labels are built at runtime, so freeing one is seen.
interface Item {
	readonly label: string;
	readonly size: number;
}

function make(count: number): Item[] {
	const items: Item[] = [];
	for (let index = 0; index < count; index++) {
		items.push({ label: `item${index}`, size: index });
	}
	return items;
}

function storeFirst(items: Item[]): void {
	items[0] = { label: `stored${items.length}`, size: -1 };
}

function storeDeep(items: Item[]): void {
	storeFirst(items);
}

function grown(item: Item): Item {
	return { ...item, label: `${item.label}+` };
}

function total(items: Item[]): number {
	let sum = 0;
	for (let index = 0; index < items.length; index++) {
		const item = items[index] ?? { label: `missing${index}`, size: 0 };
		sum += item.size + item.label.length;
	}
	return sum;
}

// Each probe is a function of its own, so nothing after it in its block is another probe's change.
function probe1(): void {
	const stored = make(2);
	const first = stored[0] ?? { label: `none`, size: 0 };
	stored[0] = { label: `replaced${stored.length}`, size: 9 };
	console.log(`1 ${first.label} ${stored[0]?.label ?? `-`}`);
}

function probe2(): void {
	const spliced = make(3);
	const head = spliced[0] ?? { label: `none`, size: 0 };
	spliced.splice(0, 1);
	const tail = spliced[1] ?? { label: `none`, size: 0 };
	spliced.pop();
	console.log(`2 ${head.label} ${tail.label} ${spliced.length}`);
}

function probe3(): void {
	const called = make(2);
	const before = called[0] ?? { label: `none`, size: 0 };
	storeDeep(called);
	console.log(`3 ${before.label} ${called[0]?.label ?? `-`}`);
}

function probe4(): void {
	const closed = make(2);
	const alias = closed;
	const kept = closed[0] ?? { label: `none`, size: 0 };
	// The closure reaches the array through another name, so closed itself isn't captured.
	const clear = (): void => {
		alias[0] = { label: `closure${alias.length}`, size: 0 };
	};
	clear();
	console.log(`4 ${kept.label} ${closed[0]?.label ?? `-`}`);
}

function probe5(): void {
	let swapped = make(2);
	const old = swapped[1] ?? { label: `none`, size: 0 };
	swapped = make(1);
	console.log(`5 ${old.label} ${swapped.length}`);
}

function probe6(): void {
	const mapped = make(2);
	const element = mapped[0] ?? { label: `none`, size: 0 };
	const relabeled = mapped.map((item) => ({ ...item, label: `${item.label}!` }));
	console.log(`6 ${element.label} ${relabeled[0]?.label ?? `-`}`);
}

function probe7(): void {
	const spread = make(2);
	const original = spread[0] ?? { label: `none`, size: 0 };
	// original is dead after the spread: reuse would take its object over, which is the array's.
	const copy = { ...original, label: `${original.label}*` };
	console.log(`7 ${copy.label} ${spread[0]?.label ?? `-`}`);
}

function probe8(): void {
	const handed = make(2);
	const given = handed[1] ?? { label: `none`, size: 0 };
	const result = grown(given);
	console.log(`8 ${result.label} ${handed[1]?.label ?? `-`}`);
}

function probe9(): void {
	const short = make(1);
	const fallback = short[3] ?? { label: `fallback${short.length}`, size: 7 };
	console.log(`9 ${fallback.label} ${fallback.size} ${total(make(3))}`);
}

probe1();
probe2();
probe3();
probe4();
probe5();
probe6();
probe7();
probe8();
probe9();
