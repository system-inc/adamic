import { programArguments } from 'adamic';
const root = programArguments()[0] ?? '';
function failure(error: Error): void {
    const code = 'code' in error && typeof error.code === 'string' ? error.code : undefined;
    console.log(`${code ?? ''}: ${error.message.replace(root, '<root>')}`);
}
import { openSync, closeSync, writeSync, readFileSync } from 'node:fs';
const fd = openSync(root + '/out', 'w', 0o640);
writeSync(fd, 'first'); closeSync(fd);
const again = openSync(root + '/out', 'w'); closeSync(again);
console.log(`truncated=${readFileSync(root + '/out','utf8').length}`);
const append = openSync(root + '/out', 'a'); writeSync(append, 'last'); closeSync(append);
console.log(readFileSync(root + '/out','utf8'));
try { openSync(root + '/out','wx'); } catch (error) { if (error instanceof Error) { failure(error); } }
try { openSync(root + '/missing','r'); } catch (error) { if (error instanceof Error) { failure(error); } }
try { openSync(root + '/locked/out','w'); } catch (error) { if (error instanceof Error) { failure(error); } }
try { openSync(root + '/missing','bad',-1); } catch(error) { if(error instanceof Error) { failure(error); } }
try { openSync(root + '/missing','w\0'); } catch(error) { if(error instanceof Error) { failure(error); } }
try { openSync(root + '/missing',"a'b"); } catch(error) { if(error instanceof Error) { failure(error); } }
try { openSync("a'\0",'r'); } catch(error) { if(error instanceof Error) { failure(error); } }
try { openSync("a'\"\0",'r'); } catch(error) { if(error instanceof Error) { failure(error); } }
