const box = { label: `digits${1}`, pattern: /\d+/g };
console.log(`${box.pattern.test('a12')} ${box.pattern.lastIndex} ${box.label}`);
box.pattern.lastIndex = 0;
const matched = box.pattern.exec('a12b3');
console.log(matched === null ? 'none' : (matched[0] ?? 'none'));

class Scanner {
    pattern: RegExp;
    label: string;
    constructor(label: string) {
        this.label = label;
        this.pattern = /\d+/g;
    }
    take(text: string): string {
        const found = this.pattern.exec(text);
        return found === null ? 'none' : (found[0] ?? 'none');
    }
}
const scanner = new Scanner(`scan${1}`);
console.log(`${scanner.label} ${scanner.take('a12b3')} ${scanner.take('a12b3')}`);

interface Chain {
    readonly label: string;
    pattern: RegExp;
    next: Chain | undefined;
}
function chain(depth: number): Chain {
    const node: Chain = { label: `n${depth}`, pattern: /a/g, next: undefined };
    if (depth > 0) {
        node.next = chain(depth - 1);
    }
    return node;
}
const root = chain(2);
let current: Chain | undefined = root;
const labels: string[] = [];
while (current !== undefined) {
    labels.push(`${current.label}:${current.pattern.test('ba') ? 'yes' : 'no'}`);
    current = current.next;
}
console.log(labels.join('|'));

class Link {
    readonly label: string;
    pattern: RegExp;
    next: Link | undefined = undefined;
    items: RegExp[];
    constructor(label: string) {
        this.label = label;
        this.pattern = /a/g;
        this.items = [/b/, /c/];
    }
    grow(depth: number): Link {
        if (depth > 0) {
            const child = new Link(`n${depth}`);
            this.next = child;
            child.grow(depth - 1);
        }
        return this;
    }
}
const linked = new Link(`root`).grow(2);
const parts: string[] = [];
let cursor: Link | undefined = linked;
while (cursor !== undefined) {
    const item = cursor.items[0];
    parts.push(`${cursor.label}:${cursor.pattern.test('xa') ? 'yes' : 'no'}:${item === undefined ? 'missing' : item.source}`);
    cursor = cursor.next;
}
console.log(parts.join('|'));
