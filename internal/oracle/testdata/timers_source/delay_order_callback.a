// A warning a timer's callback gives prints after that callback's own lines and before the next
// callback's, as Node's does. The timer it sets runs at 1 ms and prints nothing: Node starts every
// timer a turn sets from the loop's cached clock, and native reads the clock at each set, so under
// load whether it fires before the second callback is a race this fixture doesn't pin.
import 'node:timers';

const unit = 'abc'.length;
setTimeout(() => {
    console.log('first stdout');
    console.error('first stderr before');
    setTimeout(() => {}, -unit);
    console.error('first stderr after');
}, unit);
setTimeout(() => { console.error('second stderr'); }, unit);
console.log('scheduled');
