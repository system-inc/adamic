// Node warns for every delay past 2^31 - 1 ms: two warnings, 2147483648 and 1e+300 as JavaScript
// writes them, and the hint line only after the first.
import 'node:timers';

const unit = 'ab'.length;
setTimeout(() => { console.log('first fired'); }, unit * 1073741824);
setTimeout(() => { console.log('second fired'); }, unit * 5e299);
console.log('scheduled');
