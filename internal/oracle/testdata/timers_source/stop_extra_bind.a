// stop_extra_assignment.a's fourth argument through a bind of the four-parameter view, which hands the
// value its bound callback before the three it's called with.
import 'node:timers';

type Ruled = (callback: (label?: unknown) => void, ms: number, label?: unknown) => unknown;
type Four = (callback: (label?: unknown, extra?: unknown) => void, ms: number, label: string, extra: string) => unknown;

const ruled: Ruled = setTimeout;
const callback = (label?: unknown, extra?: unknown): void => console.log(`fired ${String(label)} ${String(extra)}`);
console.log('before');
const four: Four = ruled;
const bound = four.bind(undefined, callback);
bound(1, 'L', 'X');
console.log('after');
