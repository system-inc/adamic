// setTimeout with a delay past 2^31 - 1 ms, which Node makes 1 ms with a warning on stderr, stops on
// both backends after what Node printed so far, a run-time NotYet (Adamic's ruling on #995spev), and
// Node runs on.
import 'node:timers';

console.log('before');
setTimeout(() => { console.log('fired'); }, 'ab'.length * 1073741824);
console.log('scheduled');
