// setTimeout with a delay past 2^31 - 1 ms runs at 1 ms, as Node's does, after Node's warning on
// stderr: its line with the process id and the number, the duration line and the hint line
// (#zhgmbwz).
import 'node:timers';

console.log('before');
setTimeout(() => { console.log('fired'); }, 'ab'.length * 1073741824);
console.log('scheduled');
