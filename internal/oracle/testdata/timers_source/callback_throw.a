// A throw in a timeout's callback is uncaught, as Node's is: what ran before it printed, then the
// error, and the exit status the oracle's runner gives one.
import 'node:timers';

const word = ['timer', 'callback', 'failed'];
setTimeout(() => {
    console.log('before the throw');
    throw new Error(word.join(' '));
}, 1);
console.log('scheduled');
