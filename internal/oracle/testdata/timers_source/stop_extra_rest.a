// stop_extra_assignment.a's fourth argument through a view whose parameters are a rest tuple of four.
import 'node:timers';

type Ruled = (callback: (label?: unknown) => void, ms: number, label?: unknown) => unknown;
type Four = (callback: (label?: unknown, extra?: unknown) => void, ms: number, label: string, extra: string) => unknown;

const ruled: Ruled = setTimeout;
const callback = (label?: unknown, extra?: unknown): void => console.log(`fired ${String(label)} ${String(extra)}`);
console.log('before');
type Spread = (...values: [callback: (label?: unknown, extra?: unknown) => void, ms: number, label: string, extra: string]) => unknown;
const spread: Spread = ruled;
spread(callback, 1, 'L', 'X');
console.log('after');
