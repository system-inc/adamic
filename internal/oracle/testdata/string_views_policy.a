// Small and large views of large heap parents, including a view of a view.
function parts(word: string): string[] {
    let parent = '';
    for (let index = 0; index < 1024; index++) { parent += word; }
    const large = parent.slice(10, parent.length - 10);
    const small = large.substring(4, 9);
    const whole = large.slice();
    const empty = parent.slice(9, 2);
    parent = 'gone';
    return [small, large, whole, empty];
}
for (const word of ['ab', 'é世', '🌍x']) {
    for (const part of parts(word)) {
        console.log(`${part.length} ${part.charCodeAt(0)} ${part.charCodeAt(part.length - 1)} ${part.indexOf(word)} ${part.lastIndexOf(word)}`);
    }
}
// The eightfold boundary includes the native header. These lengths straddle it on 64-bit hosts.
for (const size of [447, 448, 449, 511, 512, 513]) {
    const parent = 'a'.repeat(size);
    for (const length of [1, 7, 8, 9, 16, 64]) {
        const view = parent.slice(1, length + 1);
        console.log(`${size} ${length} ${view.length} ${view === 'a'.repeat(length)}`);
    }
}
