// Each escape on its own, then the same characters as object keys.
function show(value: string): void {
	console.log(JSON.stringify(value) ?? '<undefined>');
}
show('"');
show('\\');
show('/');
show('\b');
show('\t');
show('\n');
show('\f');
show('\r');
show('\u0000');
show('\u0001');
show('\u001b');
show('\u001f');
show('\u2028');
show('\u2029');
show(String.fromCharCode(0xd800));
show(String.fromCharCode(0xdbff));
show(String.fromCharCode(0xdc00));
show(String.fromCharCode(0xdfff));
show(String.fromCharCode(0xd800, 0xdc00));
show(String.fromCharCode(0xd800) + 'x' + String.fromCharCode(0xdfff));
show(String.fromCharCode(0xd800, 0xdc00, 0xdc00));
show(String.fromCharCode(0xd800, 0xd800, 0xdc00));
console.log(JSON.stringify({ '"': 1, '\\': 2, '\n': 3, '\u0000': 4, '\u2028': 5, '\u2029': 6 }) ?? '<undefined>');
console.log(JSON.stringify({ '\ud800': 'high', '\udc00': 'low', '\ud800\udc00': 'pair' }) ?? '<undefined>');
