function make(seed: number): (n: number) => number {
 let count = seed;
 function read(n: number): number { count += n; return count; }
 function factory(offset: number): (n: number) => number {
  return (n: number): number => offset + read(n);
 }
 return factory(10);
}
const run = make(2);
console.log(String(run(1)));
console.log(String(run(2)));
console.log(String(make(4)(3)));
