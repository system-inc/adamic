function make(): () => number {
 let saved: (() => number) | undefined = undefined;
 let count = 1;
 function read(): number { return count; }
 const observe = (): string => saved === undefined ? 'empty' : 'held';
 saved = read;
 console.log(observe());
 return read;
}
function run(): void { const held = make(); console.log(`${held()}`); }
run();
