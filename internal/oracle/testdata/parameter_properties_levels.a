let sequence = '';
function mark(name: string): number {
    sequence += name + ' ';
    return sequence.length;
}
class Base {
    constructor(
        public value: number = mark('base-default'),
        protected readonly code: number = mark('base-code'),
        private readonly secret: number = mark('base-secret'),
        public readonly label: string = 'base',
        public readonly doubled: number = value * 2,
    ) {
        sequence += 'base-body ';
    }
    read(): string { return `${this.value}/${this.code}/${this.secret}/${this.label}/${this.doubled}`; }
}
class Mid extends Base {
    constructor(
        public override value: number = mark('mid-default'),
        code: number = mark('mid-code'),
        public readonly tag: string = 'mid',
        private readonly note: string = 'note',
    ) {
        value += 1;
        sequence += 'mid-before ';
        super(value, code, note.length, 'from-mid');
        sequence += `mid-after ${this.code} `;
    }
    override read(): string { return `${super.read()}/${this.tag}/${this.note}`; }
    shownCode(): number { return this.code; }
}
class Top extends Mid {
    constructor(
        public override value: number = mark('top-default'),
        code: number = mark('top-code'),
        public readonly flag: boolean = false,
        readonly extra?: number,
    ) {
        value += 10;
        code += 100;
        sequence += 'top-before ';
        super(value, code, 'top-tag');
        sequence += 'top-after ';
    }
    override read(): string { return `${super.read()}/${this.flag}/${this.extra ?? -1}`; }
}
const top = new Top();
console.log(top.read());
console.log(`${top.shownCode()}`);
console.log(sequence);
const given = new Top(3, 4, true, 9);
console.log(given.read());
const asBase: Base = given;
console.log(`${asBase.read()} ${asBase.value} ${asBase.label}`);
given.value = 70;
console.log(`${given.value} ${given.read()}`);
