// core.ts:1278 getProperty and :1287 getOwnKeys. Object.hasOwn replaces the
// aliased Object.prototype.hasOwnProperty.call intrinsic, unsupported elsewhere.
interface MapLike<T> { [index: string]: T }
function getProperty(map: MapLike<string>, key: string): string | undefined {
 return Object.hasOwn(map, key) ? map[key] : undefined;
}
function getOwnKeys(map: MapLike<string>): string[] {
 const keys: string[] = [];
 for (const key in map) {
  if (Object.hasOwn(map, key)) keys.push(key);
 }
 return keys;
}
const messages: MapLike<string> = {alpha: 'A', beta: 'B'};
console.log(String(getProperty(messages, 'alpha')));
console.log(String(getProperty(messages, 'missing')));
console.log(getOwnKeys(messages).join(','));
// core.ts:1470 groupBy's actual dictionary and lazy coalescing-write pattern,
// specialized to number arrays. Its generic mapped return view is outside scope.
const result: Record<string, number[]> = {};
let makes = 0;
function make(): number[] {makes = makes + 1; return [];}
function key(): string {console.log('key'); return 'odd';}
const first = result[key()] ??= make();
first.push(1);
const second = result[key()] ??= make();
second.push(3);
console.log(String(makes));
console.log(first.join(','));
console.log(String(first === second));
console.log(String(JSON.stringify(result)));
// parser.ts:10794 argMap[argument.name] = args[i], specialized driver.
