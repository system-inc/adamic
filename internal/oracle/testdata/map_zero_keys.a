// A Map stores the key -0 as +0 (ECMA-262, Map.prototype.set), so the keys it gives back are +0,
// which only 1 / key can tell apart. Keys compare with SameValueZero: -0 finds +0, NaN finds NaN.
const scores = new Map<number, string>();
scores.set(-0, 'negative zero'.repeat(1));
console.log(`${scores.get(0) ?? 'missing'} ${scores.has(-0)} ${scores.size}`);
for (const key of scores.keys()) {
	console.log(`${1 / key}`);
}
scores.set(0, 'zero');
scores.set(NaN, 'not a number');
scores.set(-NaN, 'still not a number');
console.log(`${scores.get(-0) ?? 'missing'} ${scores.get(NaN) ?? 'missing'} ${scores.size}`);
const built = new Map<number, number>([[-0, 1], [5, 2]]);
for (const [key, value] of built) {
	console.log(`${1 / key} ${value}`);
}
const copied = [...built];
for (const pair of copied) {
	console.log(`${1 / pair[0]}`);
}
built.delete(0);
built.set(-0, 3);
for (const key of built.keys()) {
	console.log(`${1 / key}`);
}
