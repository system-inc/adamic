let sequence = '';
function mark(name: string, value: number): number {
    sequence += `${name} `;
    return value;
}
class Plain {
    readonly field = mark('plain field', 1);
    constructor(public readonly value: number = mark('plain default', 7)) {
        console.log(`plain body ${this.value} ${this.field}`);
    }
    read(): number { return this.value; }
}
const plain = new Plain();
console.log(`plain ${plain.read()} ${sequence}`);
sequence = '';
class Base {
    readonly field = mark('base field', 2);
    constructor(protected readonly base: number = mark('base default', 3)) {
        console.log(`base body ${this.base}`);
    }
    read(): number { return this.base; }
}
class Derived extends Base {
    readonly second = mark('derived field', 4);
    constructor(private readonly value: number = mark('derived default', 9), public count: number = 5) {
        count += 1;
        super();
        console.log(`derived body ${this.value} ${this.count} ${this.second}`);
    }
    override read(): number { return super.read() + this.value; }
}
const derived = new Derived();
derived.count += 2;
const bases: readonly Base[] = [derived];
for (const base of bases) { console.log(`dispatch ${base.read()}`); }
console.log(`derived ${derived.count} ${sequence}`);
class Box<T> {
    constructor(readonly item: T) {}
    get(): T { return this.item; }
}
class Pair<T> extends Box<T> {
    constructor(item: T, readonly other: T) { super(item); }
}
const words = new Pair<string>('left', 'right');
const numbers = new Pair<number>(11, 13);
console.log(`${words.get()} ${words.other} ${numbers.get()} ${numbers.other}`);
class Callback {
    constructor(private readonly run: (value: number) => number, readonly missing?: number) {}
    apply(value: number): number { return this.run(value) + (this.missing ?? 0); }
}
const callback = new Callback((value) => value * 2);
console.log(`callback ${callback.apply(6)}`);
