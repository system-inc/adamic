// A null field prints null and an undefined one is left out (#d9ep7de), whether a literal or a variable
// wrote it, where the field is held so that the two differ: a string, a number, or a union holding both. A
// null or undefined reference prints as Node prints it at the top and in an array. A field held as a bare
// pointer that admits null or undefined is refused until #ckxcnr6 (json_objects_refused/null_variable.a).
interface Box {
	readonly v: number;
}
interface Holder {
	readonly a: Box | null | undefined;
	readonly b: Box | null | undefined;
	readonly c: string | null;
	readonly d: number | undefined;
	readonly e: string | undefined;
}
const holder: Holder = { a: null, b: undefined, c: null, d: undefined, e: undefined };
console.log(JSON.stringify(holder) ?? '<undefined>');
const filled: Holder = { a: { v: 1 }, b: { v: 2 }, c: 'c', d: 4, e: 'e' };
console.log(JSON.stringify(filled) ?? '<undefined>');
function text(flag: boolean): string | undefined {
	return flag ? 'x'.repeat(2) : undefined;
}
function box(kind: number): Box | null | undefined {
	if (kind === 0) {
		return null;
	}
	return kind === 1 ? undefined : { v: kind };
}
const written: Holder = { a: box(0), b: box(1), c: null, d: undefined, e: text(false) };
console.log(JSON.stringify(written) ?? '<undefined>');
function maybe(flag: boolean): Box | null {
	return flag ? { v: 1 } : null;
}
function optional(flag: boolean): Box | undefined {
	return flag ? { v: 1 } : undefined;
}
console.log(`${JSON.stringify(maybe(false)) ?? '<undefined>'} ${JSON.stringify(maybe(true)) ?? '<undefined>'}`);
console.log(JSON.stringify(optional(false)) ?? '<undefined>');
console.log(JSON.stringify([maybe(false), optional(false), maybe(true)]) ?? '<undefined>');
const maybeName = text(false);
console.log(JSON.stringify({ name: maybeName }) ?? '<undefined>');
const named: { readonly name: string | undefined } = { name: maybeName };
console.log(JSON.stringify(named) ?? '<undefined>');
