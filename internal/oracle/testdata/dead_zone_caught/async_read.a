// A global read in its temporal dead zone inside an async function rejects its promise with Node's
// ReferenceError, which an awaiting try catches (#bxmdk73). Node prints before, after, then the error.
async function readLater(): Promise<number> {
	return later * 2;
}
async function run(): Promise<void> {
	try {
		console.log(String(await readLater()));
	} catch (error) {
		if (error instanceof Error) console.log(`${error.name}|${error.message}|${String(error)}`);
	}
}
console.log('before');
void run();
const later = 21;
console.log('after');
