interface MapLike<T> { [index: string]: T; }
type Keys = 'first' | 'second' | '2' | '10';
function keys<T>(map: MapLike<T>): string { return Object.keys(map).join(','); }
function read<T>(map: MapLike<T>, key: string): T | undefined { return map[key]; }
function write<T>(map: MapLike<T>, key: string, value: T): void { map[key] = value; }
const cache: Partial<Record<Keys, number>> = {};
console.log(keys(cache));
console.log(String(read(cache, 'first')));
console.log(String(Object.hasOwn(cache, 'first')));
cache.second = 2;
cache['10'] = 10;
cache.first = 1;
cache['2'] = 20;
console.log(keys(cache));
console.log(String(read(cache, 'first')));
write(cache, 'first', 11);
console.log(String(cache.first));
const view: MapLike<number> = cache;
view['second'] = 22;
console.log(String(cache.second));
console.log(String(delete cache.first));
console.log(String(read(view, 'first')));
cache.first = 33;
console.log(keys(view));
console.log(String(JSON.stringify(cache)));
for (const key in cache) { console.log(key); }
const copy: MapLike<number> = {...cache};
console.log(keys(copy));
