interface Name { readonly width: number; readonly text: string; }
type DeclarationName = Name;
type QualifiedName = Name;
function getFullWidth(name: Name): number { return name.width; }
function getTextOfNode(name: Name): string { return name.text; }
function declarationNameToString(name: DeclarationName | QualifiedName | undefined): string {
    return !name || getFullWidth(name) === 0 ? "(Missing)" : getTextOfNode(name);
}
console.log(declarationNameToString(undefined));
console.log(declarationNameToString({ width: 0, text: 'empty' }));
console.log(declarationNameToString({ width: 3, text: 'name' }));
function primitive(value: string | number | boolean | undefined): void {
    console.log(`${!value}:${!!value}`);
    if (value) { console.log('yes'); } else { console.log('no'); }
}
primitive(''); primitive('0'); primitive('false'); primitive(0); primitive(-0);
primitive(NaN); primitive(Infinity); primitive(-1); primitive(false); primitive(true); primitive(undefined);
