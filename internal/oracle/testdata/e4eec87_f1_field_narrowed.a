// A number | undefined field narrowed by the checker, invalidated by a call or alias.
interface Box {
 value: number | undefined;
 text: string | undefined;
}
function clear(box: Box): void {
 box.value = undefined;
 box.text = undefined;
}
const box: Box = { value: 1, text: 'a' };
if (box.value !== undefined) {
 clear(box);
 console.log(`interface field: ${box.value} ${Number.isNaN(box.value)}`);
}
box.text = 'b';
class Holder {
 held: number | undefined = 3;
 empty(): void { this.held = undefined; }
 show(): string {
  if (this.held === undefined) { return 'none'; }
  this.empty();
  return `class field: ${this.held} ${this.held === 0}`;
 }
}
console.log(new Holder().show());
const first: Box = { value: 2, text: 'c' };
const alias = first;
if (first.value !== undefined) {
 alias.value = undefined;
 console.log(`alias: ${first.value} ${first.value * 2}`);
}
