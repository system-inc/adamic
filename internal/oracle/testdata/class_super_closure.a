// super.method() inside an arrow captures this, as this.method() would: called right away by map,
// later from a variable, and from a function value returned out of the method.
class Base {
    readonly name = `base${1}`;
    describe(): string { return `B(${this.name})`; }
}
class Child extends Base {
    override describe(): string {
        const parts = [1, 2].map((value) => `${super.describe()}${value}`);
        const later = (): string => super.describe();
        return parts.join(',') + '/' + later();
    }
}
class Grandchild extends Child {
	override describe(): string {
		return `G[${super.describe()}]`;
	}
	deferred(): () => string {
		return (): string => super.describe();
	}
}
const value: Base = new Child();
console.log(value.describe());
const grand = new Grandchild();
console.log(grand.describe());
const later = grand.deferred();
console.log(later());
