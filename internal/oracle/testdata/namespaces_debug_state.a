namespace Debug {
 export let currentLogLevel = 0;
 export let text: string | undefined;
 export let enabled = false;
 export function update(): void {currentLogLevel += 2; text = 'inside'.repeat(2); enabled = true;}
 export function qualified(): void {Debug.currentLogLevel += 1; Debug.text = 'qualified'.repeat(2);}
 export function read(): string {return `${currentLogLevel}:${text ?? 'none'}:${enabled}`;}
}
console.log(Debug.read());
Debug.currentLogLevel = 3;
Debug.currentLogLevel++;
Debug.currentLogLevel += 4;
Debug.text = 'outside'.repeat(2);
console.log(Debug.read());
Debug.update();
console.log(`${Debug.currentLogLevel}:${Debug.text ?? 'none'}:${Debug.enabled}`);
if (Debug.text !== undefined) {console.log(Debug.text.toUpperCase());}
Debug.text = undefined;
console.log(Debug.read());
Debug.qualified();
console.log(Debug.read());
