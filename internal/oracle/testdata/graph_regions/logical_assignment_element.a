// &&= and ??= on a graph member array's element (#89tq0ef): the new element is held through the graph,
// and adamic_array_set drops the old one through it. A plain retain leaked the regions.
interface Node { name: string; next: Node[] }
const a: Node = { name: 'a' + String(1), next: [] };
const b: Node = { name: 'b' + String(2), next: [a] };
a.next.push(b);
const c: Node = { name: 'c' + String(3), next: [a] };
a.next[0] &&= c;
const first = a.next[0];
console.log(a.name + ' ' + (first === undefined ? '-' : first.name) + ' ' + b.name + ' ' + c.name);
