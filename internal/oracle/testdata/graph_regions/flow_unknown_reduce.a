// f2, a control: reduce over a parameter's callback, whose targets are Unknown, its copy planned at the callback's Return (#41vb71c).
interface Node { name: string; next: Node[]; kids: Node[][] }
const a: Node = { name: 'a' + '', next: [], kids: [] };
const b: Node = { name: 'b' + '', next: [a], kids: [] };
a.next.push(b); // a cycle: the program is a graph program
const byName = (x: Node, y: Node): number => (x.name < y.name ? -1 : 1);
function fold(f: (acc: Node[], n: Node) => Node[]): Node[] { return a.next.reduce(f, []); }
a.kids.push(fold((acc: Node[], n: Node): Node[] => (n === b ? n.next.toSorted(byName) : acc)));
const k = a.kids[0];
console.log(`${a.kids.length} ${k === undefined ? -1 : k.length}`);
