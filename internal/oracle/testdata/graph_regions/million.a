interface GraphNode {
 next: GraphNode | undefined;
 other: GraphNode | undefined;
 readonly label: string | undefined;
}
function node(): GraphNode { return { next: undefined, other: undefined, label: undefined }; }
function run(): void {
 const count = 1000000;
 const root = node();
 let previous = root;
 let reachable = 1;
 for (let index = 1; index < count; index++) {
  const current = node();
  if (index % 20 === 0) {
   previous.other = current;
   previous.other = root;
  } else {
   previous.next = current;
   current.other = index % 7 === 0 ? previous : root;
   previous = current;
   reachable++;
  }
 }
 console.log(`members ${count} reachable ${reachable}`);
}
run();
