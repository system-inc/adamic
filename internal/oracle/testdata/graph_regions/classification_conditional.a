interface Link { readonly label: string; next: Link | undefined; }
function cycle(index: number): Link {
 const value = index > 0
  ? { label: 'v' + String(index), next: undefined as Link | undefined }
  : { label: 'x' + String(index), next: undefined as Link | undefined };
 const view: Link = value;
 view.next = view;
 return view;
}
function run(): void {
 const escaped = cycle(1);
 console.log(escaped.label);
}
run();
