interface Link { readonly label: string; next: Link | undefined; }
function make(index: number) {
 return { label: 'v' + String(index), next: undefined as Link | undefined };
}
function cycle(): Link {
 const view: Link = make(1);
 view.next = view;
 return view;
}
function run(): void {
 const escaped = cycle();
 console.log(escaped.label);
}
run();
