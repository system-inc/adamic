// Object.entries of a Record<string, Node> is a RecordCall whose array graphFlows plans, and whose [key, value] pairs are adopted as they're made (#y7wexf5).
interface Node { name: string; next: Node[]; pairs: [string, Node][] }
function entriesOf(record: Record<string, Node>): [string, Node][] {
 return Object.entries(record);
}
const a: Node = { name: 'a' + '', next: [], pairs: [] };
const b: Node = { name: 'b' + '', next: [a], pairs: [] };
a.next.push(b); // this cycle makes the program a graph program, so Node values must be in a region
const record: Record<string, Node> = { b: b };
a.pairs = entriesOf(record); // a holds the entries, each pair holds b, b holds a
const pair = a.pairs[0];
if (pair !== undefined) { console.log(`${a.name} ${a.pairs.length} ${pair[0]} ${pair[1].next[0] === a}`); }
