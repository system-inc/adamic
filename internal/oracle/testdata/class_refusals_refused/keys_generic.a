const source = { value: 1, [Symbol.iterator]() { let index = 0; return { next() { index++; return { value: index, done: index > 2 }; } }; } };
function keys<T extends { readonly value: number }>(v: T): string { return Object.keys(v).join(","); } const view: { readonly value: number } = source; console.log(keys(view));
