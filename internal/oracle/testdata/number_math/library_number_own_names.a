const keys: readonly string[] = ['length', 'name', 'prototype', 'MAX_VALUE', 'MIN_VALUE', 'NaN', 'NEGATIVE_INFINITY', 'POSITIVE_INFINITY', 'MAX_SAFE_INTEGER', 'MIN_SAFE_INTEGER', 'EPSILON', 'isFinite', 'isInteger', 'isNaN', 'isSafeInteger', 'parseFloat', 'parseInt', 'constructor', 'toExponential', 'toFixed', 'toPrecision', 'toString', 'toLocaleString', 'valueOf', 'hasOwnProperty', '__proto__', 'caller', 'arguments', 'call', 'apply', 'bind', '', 'Length', 'lengthx', 'lengt', 'length\u0000', 'toFixe', 'Infinity', 'undefined'];
for (const key of keys) console.log(`${key} ${Number.hasOwnProperty(key)} ${Number.prototype.hasOwnProperty(key)}`);
