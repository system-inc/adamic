console.log(`${0.1 + 0.2} ${1 / 3} ${-0} ${1 / 0} ${-1 / 0} ${0 / 0}`);
console.log(`${7 % 3} ${-7 % 3} ${7 % -3} ${5.5 % 2} ${1 % 0} ${-0 % 5}`);
console.log(`${2 ** 10} ${2 ** 0.5} ${1 ** (0 / 0)} ${(-1) ** (1 / 0)} ${(0 / 0) ** 0} ${2 ** -1074}`);
console.log(`${1e21} ${1e-7} ${123456789012345680000} ${2 ** 53 + 1} ${0x1f} ${1_000_000} ${0b101} ${0o17}`);
let counter = 10;
counter -= 3;
counter *= 2;
counter /= 7;
counter **= 3;
counter %= 5;
console.log(`${counter}`);
let up = 0;
up++;
++up;
up--;
console.log(`${up} ${-up} ${+up} ${up < 1} ${up >= 1}`);

function powerBase(value: number): number {
    return value;
}
const quarterBase = powerBase(16);
console.log(`${Math.pow(quarterBase, 0.25)} ${powerBase(2) ** 0.25}`);
console.log(`${1 / (powerBase(-0) ** 0.5)} ${powerBase(-Infinity) ** 0.5}`);
