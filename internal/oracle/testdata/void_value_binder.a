function bindDeclaration(log: string[], label: string): void {
	log.push(label);
}
function bindEnum(constant: boolean, log: string[]): void {
	return constant ? bindDeclaration(log, 'const') : bindDeclaration(log, 'regular');
}
const log: string[] = [];
console.log(String(bindEnum(true, log) === undefined));
console.log(String(bindEnum(false, log) === undefined));
console.log(log.join(','));
console.log(String((false ? bindDeclaration(log, 'skipped') : bindDeclaration(log, 'chosen')) === undefined));
console.log(log.join(','));
class Binder {
	bind(log: string[]): void { log.push('base'); }
}
class DerivedBinder extends Binder {
	bind(log: string[]): void { log.push('derived'); }
}
function invoke(binder: Binder, log: string[]): boolean {
	return binder.bind(log) === undefined;
}
console.log(String(invoke(new DerivedBinder(), log)));
console.log(log.join(','));
