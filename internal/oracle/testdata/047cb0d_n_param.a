interface Link {
	value: number;
	label: string;
}
let chain: Link | undefined = { value: 1, label: `built ${1}` };
function drop(): void {
	chain = undefined;
}
function describe(link: Link | undefined): string {
	return link === undefined ? 'none' : `link ${link.value}`;
}
if (chain !== undefined) {
	console.log(describe(chain));
	drop();
	console.log(describe(chain));
}
