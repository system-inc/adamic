interface Link { readonly label: string; next: Link | undefined; }
interface Box { readonly held: Link; readonly tag: number; }
function make(index: number): Box {
 const left: Link = { label: `left${index}`, next: undefined };
 const right: Link = { label: `right${index}`, next: left };
 left.next = right;
 return { held: right, tag: index };
}
function run(): void {
 const box = make(2);
 console.log(`${box.held.label} ${box.held.next?.label ?? '-'} ${box.tag}`);
}
run();
