// #hae423v wave 2: a NodeArray goes where a TextRange is held, as tsc hands one to setTextRange's location, and
// pos and end are read and written through the TextRange, each by kind: the array's side record here, and a
// plain object's own fields through the same functions.
interface TextRange { pos: number; end: number; }
interface Node { kind: number; }
interface NodeArray<T extends Node> extends Array<T>, TextRange {
    hasTrailingComma: boolean;
    transformFlags: number;
}
function createNodeArray(): NodeArray<Node> {
    const nodes = [{ kind: 1 }, { kind: 2 }] as NodeArray<Node>;
    nodes.pos = -1;
    nodes.end = -1;
    nodes.hasTrailingComma = false;
    nodes.transformFlags = 0;
    return nodes;
}
function setRange(range: TextRange, pos: number, end: number): void {
    range.pos = pos;
    range.end = end;
}
function width(range: TextRange): number {
    return range.end - range.pos;
}
const nodes = createNodeArray();
console.log(String(width(nodes)));
setRange(nodes, 3, 10);
console.log(String(width(nodes)));
console.log(`${nodes.pos}|${nodes.end}|${nodes.length}|${nodes[1]?.kind}`);
const plain: TextRange = { pos: 4, end: 6 };
setRange(plain, 5, 12);
console.log(`${width(plain)}|${plain.pos}|${plain.end}`);
