import { performance as clock } from 'node:perf_hooks';
console.log(`features ${typeof clock.now} ${typeof performance.mark} ${typeof performance.measure} ${typeof performance.clearMarks} ${typeof performance.clearMeasures}`);
const first = clock.now();
const second = performance.now();
console.log(`now ${Number.isFinite(first)} ${first >= 0} ${second >= first}`);
const origin = performance.timeOrigin;
console.log(`origin ${Number.isFinite(origin)} ${origin > 946684800000} ${performance.timeOrigin === origin}`);
performance.clearMarks();
performance.clearMeasures();
const start = performance.mark('start');
const old = performance.mark('duplicate');
const newer = performance.mark('duplicate');
const end = performance.mark('end');
performance.measure('duplicate', 'start', 'end');
performance.clearMeasures('duplicate');
const measure = performance.measure('work', 'duplicate', 'end');
console.log(`mark ${start.name} ${start.entryType} ${start.duration} ${start.startTime >= second}`);
console.log(`latest ${measure.startTime === newer.startTime} ${measure.startTime >= old.startTime}`);
console.log(`measure ${measure.name} ${measure.entryType} ${measure.duration >= 0} ${measure.duration === end.startTime - newer.startTime}`);
const backwards = performance.measure('backwards', 'end', 'start');
console.log(`backwards ${backwards.duration <= 0}`);
const fromOrigin = performance.measure('origin', undefined, 'start');
console.log(`zero ${fromOrigin.startTime} ${fromOrigin.duration === start.startTime}`);
performance.clearMarks('duplicate');
performance.clearMeasures('work');
performance.clearMarks();
performance.clearMeasures();
