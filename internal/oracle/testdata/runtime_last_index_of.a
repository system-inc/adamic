// Search whole characters and either half of a surrogate pair, including empty and absent needles.
// Repetition makes heap strings long enough to exercise the UTF-16 index as well as short slices.
const pieces = ['', 'aababa', 'éβaé', '😀x😀', '\ud800x\udc00', '\u0000a\u0000', 'a💩b😀'];
for (const piece of pieces) {
    const text = piece.repeat(17);
    for (let first = 0; first <= piece.length; first++) {
        for (let last = first; last <= piece.length; last++) {
            const needle = piece.slice(first, last);
            console.log(`${text.lastIndexOf(needle)}`);
            console.log(`${text.slice(1, text.length - 1).lastIndexOf(needle)}`);
        }
    }
    console.log(`${text.lastIndexOf('absent')}`);
    console.log(`${text.lastIndexOf(piece + 'too long to match')}`);
}
