// Print UTF-16 length and a lossless run-length encoding of every code point.
function show(label: string, text: string): void {
	let runs = '';
	let previous = -1;
	let count = 0;
	for (const character of text) {
		const point = character.codePointAt(0) ?? -1;
		if (point === previous) {
			count++;
		} else {
			if (count > 0) runs = runs + `${previous.toString(16)}:${count},`;
			previous = point;
			count = 1;
		}
	}
	if (count > 0) runs = runs + `${previous.toString(16)}:${count},`;
	console.log(`${label} ${text.length} ${runs}`);
}
function check(label: string, text: string): void {
	for (const form of ['NFC', 'NFD', 'NFKC', 'NFKD']) {
		const result = text.normalize(form);
		show(`${label} ${form}`, result);
		show(`${label} ${form} again`, result.normalize(form));
	}
}

// Retained ASCII, individually normalized starters, ordered marks, and WTF-8.
for (const text of ['', 'ascii'.repeat(32), '\u0000é\u0000', 'é'.repeat(128), '各ΩЖ'.repeat(32),
	'각'.repeat(128), '각'.repeat(32), 'ﬁ'.repeat(128), 'ﷺ'.repeat(128),
	'̣'.repeat(128) + '́'.repeat(128) + '̕'.repeat(128), '\ud800'.repeat(128), '\udc00'.repeat(128), '😀'.repeat(128)]) {
	check('quick', text);
}
const built = 'x'.repeat(256) + 'é'.repeat(256) + 'x'.repeat(256);
check('shared slice', built.slice(256, 512));
check('short slice', built.slice(300, 309));
show('default', built.normalize());
show('undefined', built.normalize(undefined));
show('built form', built.normalize(('nf' + 'c').toUpperCase()));
