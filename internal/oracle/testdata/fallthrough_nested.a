function nested(code: number): string {
 let text = `n${code}`;
 switch (code) {
  default: text += ':outer-default';
  case 1:
   switch (code + 1) {
    case 2: text += ':inner-two';
    default: text += ':inner-default';
    case 3: text += ':inner-three'; break;
   }
  case 2: text += ':outer-two'; break;
  case 3: text += ':outer-three';
 }
 return text;
}
for (const code of [0, 1, 2, 3]) { console.log(nested(code)); }
let calls = 0;
function next(): number { calls += 1; return calls; }
let result = '';
switch (next()) {
 case 1: result += 'first';
 default: result += ':default';
 case 1: result += ':duplicate';
}
console.log(`${result} ${calls}`);
