// indexOf and includes from every position, searched in place (string.c's adamic_string_index_of_at):
// a text long enough to have its own position index (string_index.c), of ASCII, two-byte characters,
// surrogate pairs and lone halves, each search from every position before, in and past it, folded into
// one line per search. The same text as a shared slice of a longer one gives the same answers.
let text = '';
for (let round = 0; round < 12; round++) {
	text += `ab${round}é🌍\uD83Dx\uDE00🌍🌍c`;
}
const longer = `${'prefix '.repeat(10)}${text}${' suffix'.repeat(10)}`;
const shared = longer.slice(70, 70 + text.length);
console.log(`${text.length} ${shared === text}`);
const searches = ['a', 'b1', 'é', '🌍', '🌍🌍', '\uD83C', '\uDF0D', '\uDF0Dc', 'x\uDE00', '\uD83D', '\uDE00', 'c', '', 'zz', 'ab11é'];
for (const search of searches) {
	let sum = 0;
	let agree = true;
	for (let position = -2; position <= text.length + 2; position++) {
		const found = text.indexOf(search, position);
		sum = (sum * 31 + found + 2 + (text.includes(search, position) ? 7 : 0)) % 1000003;
		agree = agree && shared.indexOf(search, position) === found;
	}
	console.log(`${search.length} ${sum} ${agree} ${text.indexOf(search, 1.5)} ${text.indexOf(search, NaN)} ${text.indexOf(search, Infinity)}`);
}
