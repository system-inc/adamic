// Sorting references at the top level. sort_releases.a sorts inside functions because a top-level
// variable used to be held until the program ended, which hid from the leak check anything it
// reached. Globals are let go at exit now, last declared first, so these arrays die before the leak
// check runs, and anything the sort didn't let go of is a leak. The strings are built at runtime,
// since literals are immortal.
import { panic } from 'adamic';

interface Task {
	readonly name: string;
	readonly priority: number;
}

const count = 5;
const words: string[] = [];
for (let index = 0; index < count; index++) {
	words.push(`word${(index * 7) % count}`);
}
words.sort((left, right) => (left < right ? -1 : left > right ? 1 : 0));
console.log(words.join(','));

const names = ['write', 'test', 'ship', 'plan'];
const tasks: Task[] = [];
for (let index = 0; index < names.length; index++) {
	tasks.push({ name: `${names[index] ?? ''}${index}`, priority: index % 2 });
}
tasks.sort((left, right) => right.priority - left.priority);
console.log(tasks.map((task) => task.name).join(','));

// A later global holding what an earlier one holds: released in reverse, each lets go of its own.
const first = tasks[0] ?? panic('no first task');
let longest = words[0] ?? '';
for (const word of words) {
	if (word.length >= longest.length) {
		longest = `${word}!`;
	}
}
console.log(`${first.name} ${longest}`);
