/* eslint-disable no-useless-call -- This program tests delayed call and literal apply adapters. */
let trace = '';
const absolute = Math.abs;
const alias = absolute;
function ignored(): string {
    trace += 't';
    return 'unused';
}
function argument(): number {
    trace += 'a';
    return -3;
}
console.log(`${alias.apply(ignored(), [argument()])} ${trace}`);
const local = Number.parseInt;
function callLater(): number {
    return local.call(null, 'ff', 16);
}
console.log(`${callLater()}`);
