// Size classes (runtime/heap.c). Strings of every length from 1 to 300 bytes, and objects whose
// own blocks are every size an object can be from an empty one (40 bytes) up through 300. Some of
// each size stay live, some are dropped, then more of that same size are made, so a class's free
// list is taken from while other slots of it are still live. A string's block is the 64-byte header
// plus its length, so length 192 is the 256-byte class and length 193 comes from malloc. Empty
// slices are 64-byte strings. Boxed numbers, arrays, maps, closures and weak handles are the other
// heap kinds, kept and dropped the same way.
import type { Weak } from 'adamic';

interface Packed {
	readonly label: string;
	readonly weight: number;
}

interface Box {
	readonly label: string;
}

interface Holder {
	readonly box: Box;
	readonly handle: Weak<Box>;
}

function letter(mark: number): string {
	const alphabet = "abcdefghijklmnopqrstuvwxyz";
	return alphabet[mark % 26] ?? "a";
}

function makeText(length: number, mark: number): string {
	return letter(mark).repeat(length);
}

let stringSum = 0;
let objectSum = 0;
const edges: string[] = [];
for (let length = 1; length <= 300; length++) {
	let texts: string[] = [];
	let objects: Packed[] = [];
	for (let index = 0; index < 8; index++) {
		texts.push(makeText(length, index));
		objects.push({ label: makeText(length, index + 8), weight: length * 8 + index });
	}
	let heldText: string[] = [];
	let heldObject: Packed[] = [];
	for (let index = 1; index < 8; index += 2) {
		const text = texts[index];
		const object = objects[index];
		if (text !== undefined && object !== undefined) {
			heldText.push(text);
			heldObject.push(object);
		}
	}
	texts = [];
	objects = [];
	for (let index = 0; index < 4; index++) {
		const made = makeText(length, index + 16);
		const object: Packed = { label: makeText(length, index + 20), weight: length };
		stringSum = (stringSum + made.length + made.charCodeAt(0) + made.charCodeAt(length - 1)) % 1000003;
		objectSum = (objectSum + object.label.length + object.label.charCodeAt(length - 1) + object.weight) % 1000003;
		if (index % 2 === 0) {
			heldText.push(made);
			heldObject.push(object);
		}
	}
	for (const text of heldText) {
		stringSum = (stringSum + text.length + text.charCodeAt(0) + text.charCodeAt(length - 1)) % 1000003;
	}
	for (const object of heldObject) {
		objectSum = (objectSum + object.label.length + object.weight + object.label.charCodeAt(0)) % 1000003;
	}
	if (length === 1 || length === 16 || length === 17 || length === 176 || length === 177 || length === 192 || length === 193 || length === 256 || length === 300) {
		const sample = heldText[0];
		const packed = heldObject[0];
		if (sample !== undefined && packed !== undefined) {
			edges.push(`${length}:${sample.length}:${sample.charCodeAt(length - 1)}:${packed.label.length}:${packed.weight}`);
		}
	}
}

function churnBlanks(): number {
	let batch: string[] = [];
	for (let index = 0; index < 8; index++) {
		batch.push("abc".slice(1, 1));
	}
	let held: string[] = [];
	for (let index = 1; index < 8; index += 2) {
		const item = batch[index];
		if (item !== undefined) {
			held.push(item);
		}
	}
	batch = [];
	for (let index = 0; index < 4; index++) {
		const made = "xyz".slice(2, 2);
		if (index % 2 === 0) {
			held.push(made);
		}
	}
	let sum = 0;
	for (const item of held) {
		sum += 1 + item.length;
	}
	return sum;
}

function churnBoxes(): number {
	let keptA: number | string = 0.5;
	let keptB: number | string = 1.5;
	let slot: number | string = 2.5;
	for (let index = 0; index < 12; index++) {
		slot = index + 3.5;
	}
	for (let index = 0; index < 6; index++) {
		slot = index + 40.5;
	}
	let sum = 0;
	if (typeof keptA === "number") {
		sum += keptA;
	}
	if (typeof keptB === "number") {
		sum += keptB;
	}
	if (typeof slot === "number") {
		sum += slot;
	}
	return sum;
}

function churnArrays(): number {
	let batch: number[][] = [];
	for (let index = 0; index < 8; index++) {
		batch.push([index, index + 1, index + 2]);
	}
	let held: number[][] = [];
	for (let index = 1; index < 8; index += 2) {
		const item = batch[index];
		if (item !== undefined) {
			held.push(item);
		}
	}
	batch = [];
	for (let index = 0; index < 4; index++) {
		held.push([index + 10, index + 11]);
	}
	let sum = 0;
	for (const item of held) {
		sum += item.length + (item[0] ?? 0);
	}
	return sum;
}

function churnMaps(): number {
	let batch: Map<string, number>[] = [];
	for (let index = 0; index < 8; index++) {
		const map = new Map<string, number>();
		map.set(`k${index}`, index);
		batch.push(map);
	}
	let held: Map<string, number>[] = [];
	for (let index = 1; index < 8; index += 2) {
		const item = batch[index];
		if (item !== undefined) {
			held.push(item);
		}
	}
	batch = [];
	for (let index = 0; index < 4; index++) {
		const map = new Map<string, number>();
		map.set(`n${index}`, index + 10);
		held.push(map);
	}
	let sum = 0;
	for (const map of held) {
		let found = map.get("k1") ?? map.get("k3") ?? map.get("k5") ?? map.get("k7") ?? map.get("n0") ?? map.get("n1") ?? map.get("n2") ?? map.get("n3") ?? 0;
		for (const [, value] of map) {
			found += value;
		}
		sum += map.size + found;
	}
	return sum;
}

function churnClosures(): number {
	let plain: (() => number)[] = [];
	let closed: (() => number)[] = [];
	for (let index = 0; index < 8; index++) {
		plain.push(() => 7);
		const captured = index;
		closed.push(() => captured);
	}
	let heldPlain: (() => number)[] = [];
	let heldClosed: (() => number)[] = [];
	for (let index = 1; index < 8; index += 2) {
		const left = plain[index];
		const right = closed[index];
		if (left !== undefined && right !== undefined) {
			heldPlain.push(left);
			heldClosed.push(right);
		}
	}
	plain = [];
	closed = [];
	for (let index = 0; index < 4; index++) {
		heldPlain.push(() => index);
		const captured = index + 30;
		heldClosed.push(() => captured);
	}
	let sum = 0;
	for (const made of heldPlain) {
		sum += made();
	}
	for (const made of heldClosed) {
		sum += made();
	}
	return sum;
}

function churnWeaks(): number {
	let batch: Holder[] = [];
	for (let index = 0; index < 8; index++) {
		const box: Box = { label: `w${index}` };
		batch.push({ box, handle: box });
	}
	let held: Holder[] = [];
	for (let index = 1; index < 8; index += 2) {
		const item = batch[index];
		if (item !== undefined) {
			held.push(item);
		}
	}
	batch = [];
	for (let index = 0; index < 4; index++) {
		const box: Box = { label: `n${index}` };
		held.push({ box, handle: box });
	}
	let sum = 0;
	for (const item of held) {
		const weakLabel = item.handle?.label;
		sum += item.box.label.length + (weakLabel === undefined ? 0 : weakLabel.length);
	}
	return sum;
}

interface Shape0 {}
function churnShape0(seed: number): number {
	let batch: Shape0[] = [];
	for (let index = 0; index < 6; index++) {
		batch.push({});
	}
	let held: Shape0[] = [];
	for (let index = 1; index < 6; index += 2) {
		const item = batch[index];
		if (item !== undefined) {
			held.push(item);
		}
	}
	batch = [];
	for (let index = 0; index < 3; index++) {
		held.push({});
	}
	let sum = 0;
	for (const item of held) {
		sum += 0;
	}
	return sum;
}

interface Shape1 {
	readonly f0: number;
}
function churnShape1(seed: number): number {
	let batch: Shape1[] = [];
	for (let index = 0; index < 6; index++) {
		batch.push({ f0: seed + index + 0 });
	}
	let held: Shape1[] = [];
	for (let index = 1; index < 6; index += 2) {
		const item = batch[index];
		if (item !== undefined) {
			held.push(item);
		}
	}
	batch = [];
	for (let index = 0; index < 3; index++) {
		held.push({ f0: seed + 100 + index + 0 });
	}
	let sum = 0;
	for (const item of held) {
		sum += item.f0;
	}
	return sum;
}

