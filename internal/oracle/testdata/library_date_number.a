function numeric(date: Date): number { return Number(date); }
for (const time of [-8640000000000000, -62167219200000, -1, 0, 1, 8640000000000000, NaN]) {
    const date = new Date(time);
    console.log(`${numeric(date)} ${Number.isNaN(numeric(date))}`);
    date.setTime(1);
    console.log(`${numeric(date)}`);
}
console.log(`${Number(new Date("0000-01-01T00:00:00Z"))}`);
let calls = 0;
function make(): Date { calls += 1; return new Date(2); }
console.log(`${Number(make())} ${calls}`);
