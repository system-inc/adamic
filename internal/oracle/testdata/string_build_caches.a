// A cached ASCII string becomes Latin text in the same append allocation.
function asciiToLatin(): void {
    let text = 'a'.repeat(80);
    text += 'b';
    console.log(`${text.length} ${text.charCodeAt(80)}`);
    text += 'é';
    console.log(`${text.length} ${text.charCodeAt(81)} ${text.slice(79)}`);
}

// A cached BMP view gains a supplementary point when two lone halves meet.
function joinCachedHalves(): void {
    let text = 'é'.repeat(80);
    text += '\ud83c';
    console.log(`${text.length} ${text.charCodeAt(80)} ${text.codePointAt(80)}`);
    text += '\udf0d';
    console.log(`${text.length} ${text.charCodeAt(80)} ${text.charCodeAt(81)} ${text.codePointAt(80)} ${text.codePointAt(81)}`);
    text += 'tail';
    console.log(`${text.slice(79)} ${text.indexOf('tail')} ${text.slice(80, 81).charCodeAt(0)}`);
}

asciiToLatin();
joinCachedHalves();
