// toUpperCase and toLowerCase, as Node does them: Unicode's full, locale-independent mappings, one
// fixture line for each special case. The case-mapping sweep (internal/native/case_test.go) holds
// every code point; this holds the method through the compiler, on strings the program builds.

// units writes a string's UTF-16 code units, so a lone surrogate is seen as itself and not as the
// U+FFFD stdout would print.
function units(text: string): string {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(text.charCodeAt(index));
	}
	return codes.join(',');
}

function show(label: string, text: string): void {
	const upper = text.toUpperCase();
	const lower = text.toLowerCase();
	console.log(`${label}: ${upper} [${units(upper)}] ${lower} [${units(lower)}]`);
}

// ASCII, and nothing to change.
show('ascii', 'Hello, World 123');
show('empty', '');

// Full mappings: one code point becomes two or three.
show('sharp s', 'straße');
show('n apostrophe', 'ŉ');
show('ligatures', 'ﬀ ﬁ ﬂ ﬃ ﬄ ﬅ ﬆ');
show('greek with dialytika', 'ΐ ΰ');
show('ypogegrammeni', 'ᾳ ᾼ ῳ');
show('armenian', 'ﬓ և');

// The unconditional İ: it lowercases to i and a combining dot above, in every locale-free mapping.
show('dotted capital I', 'İstanbul');
show('dotless small i', 'ı');

// Final sigma: Σ lowercases to ς at the end of a word, and to σ anywhere else.
show('odysseus', 'ΟΔΥΣΣΕΥΣ');
show('sigma alone', 'Σ');
show('sigma then letter', 'ΣA');
show('letter then sigma', 'AΣ');
show('ignorable between', "AΣ'");
show('ignorable before', "A'Σ");
show('ignorable then letter', "AΣ'B");
show('cased and ignorable', 'ʰΣ AʰΣ AΣʰ');
show('two words', 'ΣΑΣ ΣΑΣ.');
show('beyond the BMP', '𐐀Σ Σ𐐨');

// Lone surrogates have no case and pass through as themselves, beside letters that change.
const high = '😀'.slice(0, 1);
const low = '😀'.slice(1);
show('lone high', `a${high}b`);
show('lone low', `${low}ß`);
show('lone before sigma', `A${high}Σ`);
show('lone after sigma', `AΣ${low}`);

// Strings the program builds, freed while the mapped ones live on.
const built: string[] = [];
for (const word of ['ǅemal', 'ǈubljana', 'Ǌoj']) {
	built.push(`${word}-${word.length}`.toUpperCase());
	built.push(word.repeat(2).toLowerCase());
}
console.log(built.join(' '));
console.log(`${'ß'.toUpperCase().length} ${'İ'.toLowerCase().length} ${'ΐ'.toUpperCase().length}`);
console.log(`${'ΣΣ'.toLowerCase() === 'σς'} ${'İ'.toLowerCase().toUpperCase()}`);
