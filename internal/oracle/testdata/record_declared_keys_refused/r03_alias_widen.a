// a-check: refused a value with declared properties seen through a wider index signature, which can write under a declared property what it does not hold (Options seen as Dict: outFile is declared string | undefined, and the index signature holds string | number | undefined)
interface Options { outFile?: string; [name: string]: string | number | undefined; }
type Dict = { [name: string]: string | number | undefined };
function key(): string { return 'outFile'; }
const name: string = key();
const options: Options = {};
const d: Dict = options;
d.outFile = 3;
console.log(typeof options.outFile);
