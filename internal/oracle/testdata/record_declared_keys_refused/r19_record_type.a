// a-check: refused a value with declared properties seen through a wider index signature, which can write under a declared property what it does not hold (Options seen as Record<string, string | number | undefined>: outFile is declared string | undefined, and the index signature holds string | number | undefined)
interface Options { outFile?: string; [name: string]: string | number | undefined; }
type Dict = { [name: string]: string | number | undefined };
function key(): string { return 'outFile'; }
const name: string = key();
const options: Options = {};
const r: Record<string, string | number | undefined> = options;
r.outFile = 3;
console.log(typeof options.outFile);
