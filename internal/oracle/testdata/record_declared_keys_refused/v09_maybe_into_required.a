// a-check: refused a write into a record with declared properties through a key that is not one literal, of a value a declared property it can land under cannot take (number | undefined written into Counts by key: required is declared number)
interface Counts { required: number; [k: string]: number | undefined; }
const keys: string[] = ["required", "other"];
const key = keys[0] ?? "other";
const counts: Counts = { required: 1 };
const maybe: number | undefined = keys.length > 5 ? 1 : undefined;
counts[key] = maybe;
console.log(typeof counts.required);
