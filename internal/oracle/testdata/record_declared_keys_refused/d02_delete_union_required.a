// a-check: refused a delete from a record through a key that is not one literal, which can remove a required declared property (delete options[key] on Options by key: required is declared number, not optional)
interface Options { target?: number; required: number; [option: string]: number | undefined; }
function drop(options: Options, key: "target" | "required"): void { delete options[key]; }
const options: Options = { target: 7, required: 4 };
drop(options, "required");
console.log(typeof options.required);
