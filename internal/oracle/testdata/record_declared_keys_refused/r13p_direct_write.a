// a-check: refused a write into a record with declared properties through a key that is not one literal, of a value a declared property it can land under cannot take (string | number | undefined written into Options by name: outFile is declared string | undefined)
interface Options { outFile?: string; [name: string]: string | number | undefined; }
function key(): string { return 'outFile'; }
const name: string = key();
const options: Options = {};
const source: { x: string | number | undefined } = { x: 3 };
options[name] = source.x;
console.log(typeof options.outFile);
