// a-check: refused a value with declared properties seen through a wider index signature, which can write under a declared property what it does not hold (Opts seen as Dict: name is declared string, and the index signature holds string | number)
interface Opts { name: string; [key: string]: string | number; }
type Dict = { [key: string]: string | number };
function pick(): string { return "name"; }
const key: string = pick();
const opts: Opts = { name: "x" };
const other: Dict = {};
const wide: Dict = key.length > 0 ? opts : other;
wide[key] = 5;
console.log(typeof opts.name);
