// a-check: refused a write into a record with declared properties through a key that is not one literal, which can store under a declared property what it does not hold (Options written by name: outFile is declared string | undefined, and the index signature holds string | number | undefined)
interface Options { outFile?: string; [name: string]: string | number | undefined; }
