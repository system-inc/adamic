// a-check: refused a type argument with declared properties bound to a type parameter constrained to a wider index signature, which can write under a declared property what it does not hold (Options as T, constrained to Dict: outFile is declared string | undefined, and the index signature holds string | number | undefined)
interface Options { outFile?: string; [name: string]: string | number | undefined; }
type Dict = { [name: string]: string | number | undefined };
function key(): string { return 'outFile'; }
const name: string = key();
class Store<T extends Dict> {
    held: T;
    constructor(held: T) { this.held = held; }
    put(value: number): void { const wide: Dict = this.held; wide[name] = value; }
}
class OptionsStore extends Store<Options> {}
const options: Options = {};
const store = new OptionsStore(options);
store.put(3);
console.log(typeof options.outFile);
