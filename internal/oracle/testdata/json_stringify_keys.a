// Integer indexes sort numerically and come first. Leading zeros, signs and 2^32-1 do not.
console.log(JSON.stringify({ b: 1, 10: 2, a: 3, 2: 4, '01': 5, 0: 6, '-1': 7, '': 8, '+1': 9, '1.0': 10 }) ?? '<undefined>');
console.log(JSON.stringify({ '4294967295': 'max', '4294967294': 'index', '00': 'zeros', z: 1, '0': 0 }) ?? '<undefined>');
console.log(JSON.stringify({ c: 1, '3': 3, b: 2, '1': 1, a: 4, '2': 2 }) ?? '<undefined>');
console.log(JSON.stringify({ '8': 8, '08': 80, '9': 9, x: 1 }) ?? '<undefined>');
