enum Flag {
    None = 0,
    Read = 1 << 0,
    Write = 1 << 1,
    Both = Read | Write,
    Extra = Both + 4,
    Negative = -Read,
    Times = Write * 3,
}
enum Dup { A = 1, B = 1, C = 2, D = 1, E = C }
enum Word { Yes = 'yes', No = 'no', Again = Yes }
enum Mixed { Number = 7, Text = 'seven', Also = 7 }
const enum Width { Small = 2, Large = Small * 4, Huge = Large + 1 }
console.log(`${Flag.None} ${Flag.Read} ${Flag.Write} ${Flag.Both} ${Flag.Extra} ${Flag.Negative} ${Flag.Times}`);
console.log(`${Flag[0] ?? 'none'} ${Flag[1] ?? 'none'} ${Flag[3] ?? 'none'} ${Flag[7] ?? 'none'} ${Flag[-1] ?? 'none'} ${Flag[6] ?? 'none'}`);
console.log(`${Dup.A} ${Dup.B} ${Dup.C} ${Dup.D} ${Dup.E} ${Dup[1] ?? 'none'} ${Dup[2] ?? 'none'}`);
console.log(Object.keys(Dup).join(','));
console.log(`${Word.Yes} ${Word.No} ${Word.Again} ${Word.Yes === Word.Again}`);
console.log(Object.keys(Word).join(','));
console.log(`${Mixed.Number} ${Mixed.Text} ${Mixed.Also} ${Mixed[7] ?? 'none'}`);
console.log(Object.keys(Mixed).join(','));
console.log(`${Width.Small} ${Width.Large} ${Width.Huge}`);
