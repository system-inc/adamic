function check(start: number): string {
 let seen = 'seen' + String(start);
 function sum(total: number, value: number): number { seen += String(value); return total + value + start; }
 function visit(value: number, key: string): void { seen += key + String(value); }
 function accept(value: number): boolean { return value > start; }
 const total = [1, 2, 3].reduce(sum, 0);
 const made = Array.from({ length: 2 }, (_, index) => seen + String(index));
 const values = new Map<string, number>(); values.set('a', 4); values.set('b', 5); values.forEach(visit);
 const some = [1, 3].some(accept); const every = [3, 4].every(accept);
 return `${total}:${made.join(',')}:${seen}:${some}:${every}`;
}
console.log(check(2));
