interface Grand { readonly kind: string; }
interface Parent { readonly kind: string; readonly parent: Grand; }
interface Tree { readonly kind: string; readonly parent: Parent; readonly children: readonly Tree[]; }
function label(n: number): string { return `kind${n}`; }
function inspect(node: Tree): number {
 const parent = node.parent;
 const kind = parent.parent.kind;
 const children = node.children;
 let total = node.kind.length + parent.kind.length + kind.length;
 for (const child of children) { total += inspect(child); }
 return total;
}
const grand: Grand = { kind: label(1) };
const parent: Parent = { kind: label(2), parent: grand };
const leaf: Tree = { kind: label(3), parent, children: [] };
const root: Tree = { kind: label(4), parent, children: [leaf, leaf] };
console.log(`${inspect(root)}`);
