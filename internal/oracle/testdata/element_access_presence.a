interface Entry { readonly value: number; }
interface Cache { left: Entry | undefined; right: Entry | undefined; }
type Key = 'left' | 'right';
const cache: Cache = { left: { value: 7 }, right: undefined };
function drop(): void { cache.left = undefined; }
function read(value: Cache, key: Key): number {
 if (value[key] !== undefined) {
  console.log(`${value[key].value}`);
  drop();
  return value[key].value;
 }
 return -1;
}
console.log(`${read(cache, 'left')}`);
