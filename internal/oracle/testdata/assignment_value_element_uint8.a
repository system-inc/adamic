const holder: (Uint8Array)[] = [new Uint8Array([1])];
let calls = 0;
function receiver(): (Uint8Array)[] { calls += 1; return holder; }
function index(): number { calls += 10; return 0; }
function show(value: Uint8Array): string { return `${value[0]}`; }
const assigned = (receiver()[index()] = new Uint8Array([7]));
console.log(show(assigned));
console.log(show(holder[0] ?? assigned));
console.log(`calls:${calls}`);
const saved = (receiver()[index()] = new Uint8Array([7]));
holder[0] = new Uint8Array([1]);
console.log(show(saved));
