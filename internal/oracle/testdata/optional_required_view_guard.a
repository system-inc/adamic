interface Fields { slot?: number | undefined; }
const source: { slot: number | undefined } = { slot: undefined };
function read(record?: Fields): string { if (!record) return String(record); return `${'slot' in record}|${String(record.slot)}`; }
console.log(`${read(source)}|${Object.keys(source).join(',')}|${Object.hasOwn(source, 'slot')}`);
