async function walk(flag: boolean): Promise<number> {
    let total = 0;
    if (flag) {
        total = await Promise.resolve(2);
    } else {
        total = await Promise.resolve(5);
    }
    let step = 0;
    while (step < 4) {
        step++;
        if (step === 2) { continue; }
        total += await Promise.resolve(step);
    }
    for (let index = 0; index < 4; index++) {
        if (index === 3) { break; }
        total += await Promise.resolve(index);
    }
    return total;
}
console.log(`${await walk(true)} ${await walk(false)}`);
