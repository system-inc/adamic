// Constant lengths an array can't fail on: nothing here can throw, so no call is followed by a check
// and no function is one that can throw.
function shown(value: number): string {
	const filled = new Array<number>(3).fill(value).join(',');
	const none = new Array<number>(0).fill(value).length;
	const counted = Array.from({ length: 4 }, (_, index) => index + value).join(',');
	const empty = Array.from({ length: 0 }, (_, index) => index).length;
	return `${filled} | ${none} | ${counted} | ${empty}`;
}
for (const value of [1, 2.5, -3]) {
	try {
		console.log(shown(value));
	} catch {
		console.log('never');
	}
}
