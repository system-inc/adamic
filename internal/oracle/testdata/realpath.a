// Canonical directory identity follows a link; a dangling link is an error, not a path.
import { realPath } from 'adamic';

for (const path of ['walking/link-to-inner', 'walking/dangling', '', 'walking/dangling/..', 'walking/link-to-inner/../link-to-file']) {
	const result = realPath(path);
	console.log(result.kind === 'Ok' ? `Ok ${result.path}` : `Error ${result.message}`);
}
