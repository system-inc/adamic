/* eslint-disable @typescript-eslint/unbound-method -- The oracle calls these intrinsic aliases with receivers proven by the branch. */
const slice = String.prototype.slice;
let text = 'before';
function change(): number {
    text = 'after';
    return 1;
}
console.log(slice.apply(text, [change()]));
console.log(text);
const search = Array.prototype.indexOf;
let numbers = [1, 2];
function replace(): number {
    numbers = [9];
    return 2;
}
console.log(`${search.call(numbers, replace())} ${numbers.join('|')}`);
