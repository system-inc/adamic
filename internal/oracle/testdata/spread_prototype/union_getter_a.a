interface Heavy {
	readonly kind: "heavy";
	readonly label: string;
	readonly weight: number;
}
interface Light {
	readonly kind: "light";
	readonly label: string;
}
class Sized {
	readonly kind = "heavy";
	readonly label = "t";
	get weight(): number {
		return 20;
	}
}
function copy(source: Heavy | Light): Heavy | Light {
	return { ...source };
}
const value = copy(new Sized());
if (value.kind === "heavy") {
	console.log(typeof value.weight + " " + String(value.weight));
}
