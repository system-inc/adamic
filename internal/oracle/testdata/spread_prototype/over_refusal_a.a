interface Source {
	readonly label: string;
	readonly weight: number;
}
class Plain {
	readonly label = "p";
	readonly weight = 2;
}
class Sized {
	readonly label = "t";
	get weight(): number {
		return 20;
	}
}
const elsewhere: Source = new Sized();
console.log(String(elsewhere.weight));
const built: Source = new Plain();
const value: Source = { ...built };
console.log(typeof value.weight + " " + String(value.weight));
