// A default runs only when its field reads undefined, and defaults run in source order. fallback
// counts its calls: a present field, even 0 or '', never calls it, and an absent field or an explicit
// undefined calls it once each. Node prints 1, 101, 102, 0, 2, bc, b,c and 2 once more.
let calls = 0;

function fallback(): number {
	calls++;
	return 100 + calls;
}

function pick(given: { count?: number | undefined }): number {
	const { count = fallback() } = given;
	return count;
}

console.log(String(pick({ count: 1 })));
console.log(String(pick({})));
console.log(String(pick({ count: undefined })));
console.log(String(pick({ count: 0 })));
console.log(String(calls));

const order: string[] = [];

function note(text: string): string {
	order.push(text);
	return text;
}

function label(given: { a?: string; b?: string; c?: string }): string {
	const { a = note('a'), b = note('b'), c = note('c') } = given;
	return a + b + c;
}

console.log(label({ a: '' }));
console.log(order.join(','));
console.log(String(calls));
