const text = 'abc';
if (String(text) !== text) { throw new Error('identity'); }
if (typeof String(text) !== typeof text) {
 throw new Error('wrong typeof: ' + typeof String('abc'));
}
console.log(typeof String('abc'));
console.log(String('abc'));
