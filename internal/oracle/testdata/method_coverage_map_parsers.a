const integer = parseInt;
const floating = parseFloat;
const intAlias = integer;
console.log(
    [
        '0x10',
        '10',
        '11',
        '12',
        '14',
        '15',
        '-10',
        '+10',
        ' 10',
        'z',
        '',
        'Infinity',
        '1.5',
        '1e3',
        '0b10',
        '0o10',
        'ff',
        'g',
        '10tail',
    ]
        .map(intAlias)
        .join('|'),
);
console.log(
    [
        '',
        ' ',
        '\t-1.25tail',
        '+.5e2x',
        '1e',
