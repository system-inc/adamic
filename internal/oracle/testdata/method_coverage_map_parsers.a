        '-Infinity',
        'NaN',
        '-0',
        '.25',
        '1.2.3',
        '1e309',
        '1e-400',
    ]
        .map(floating)
        .join('|'),
);
console.log(['2.5x', ' 3.25 ', '-0'].map(parseFloat).join('|'));
