// a-check: refused optional property errno in ErrnoException absent from structural source Error, which can hide fields
import { programArguments } from 'adamic';
const root = programArguments()[0] ?? '';
function failure(error: Error): void {
    const errno: NodeJS.ErrnoException = error;
    console.log(`${errno.code ?? ''}: ${error.message.replace(root, '<root>')}`);
}
import { unlinkSync, existsSync } from 'node:fs';
unlinkSync(root + '/file'); console.log(`file=${existsSync(root + '/file')}`);
unlinkSync(root + '/dangling'); console.log('removed dangling');
try { unlinkSync(root + '/missing'); } catch(error) { if (error instanceof Error) { failure(error); } }
try { unlinkSync(root + '/directory'); } catch(error) { if (error instanceof Error) { failure(error); } }
try { unlinkSync(root + '/locked/file'); } catch(error) { if (error instanceof Error) { failure(error); } }
