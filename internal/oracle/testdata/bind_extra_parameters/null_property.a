// An optional-property bind with unknown allocation reach, admitted by the complete name scan (#x909e6q).
function defaulted(a: number, b: number = 9): number { return a + b; }
const withDefault = defaulted.bind(undefined, 1);
console.log(String(withDefault()));
const otherReceiver = {};
function propertyFixed(): number { console.log("property fixed"); return 1; }
const nullProperty: { f: ((x: number) => number) | null } = { f: null };
const nullPropertyBound = nullProperty.f?.bind(otherReceiver, propertyFixed());
console.log(typeof nullPropertyBound);
