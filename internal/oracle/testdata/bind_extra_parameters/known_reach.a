// unary holds only one, which declares the one parameter Unary names, so its bind lowers, while two,
// also held as Unary, declares two: the reach names one alone, and two never counts (#04f5s0s).
type Unary = (x: number) => number;
function one(x: number): number { return x + 1; }
function two(x: number, y: number = 1): number { return x + y; }
const held: Unary = two;
console.log(String(held(1)));
const unary: Unary = one;
const bound = unary.bind(undefined);
console.log(String(bound(1)));
