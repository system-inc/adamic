const numbers = [NaN, -0, 0, Infinity, -Infinity, 1, 2];
for (const left of numbers) for (const right of numbers) console.log(`${Object.is(left, right)}`);
const first = { value: 1 };
const other = { value: 1 };
console.log(`${Object.is(first, first)} ${Object.is(first, other)} ${Object.is(first, 1)}`);
console.log(`${Object.is('a' + 'b', 'ab')} ${Object.is(true, true)} ${Object.is(true, false)} ${Object.is(undefined, undefined)} ${Object.is(0, false)}`);
function compare(left: number | string | undefined, right: number | string | undefined): boolean { return Object.is(left, right); }
console.log(`${compare(NaN, NaN)} ${compare('ab', 'ab')} ${compare(undefined, undefined)} ${compare(1, '1')}`);
const array = [1];
const map = new Map<string, number>();
const closure = (): number => 1;
console.log(`${Object.is(array, array)} ${Object.is(map, map)} ${Object.is(closure, closure)} ${Object.is(array, map)}`);
