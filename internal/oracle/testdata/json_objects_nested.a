const full = { n: 0, extra: 'kept'.repeat(2), child: {flag: false, values: [1, 2]} };
const view: {readonly n: number} = full;
console.log(JSON.stringify(view) ?? 'undefined');
const items = [{n: 1, words: ['one', 'two']}, {n: 2, words: ['three']}];
console.log(JSON.stringify(items) ?? 'undefined');
const mixed = [items, full, false, 'tail'.repeat(2)];
console.log(JSON.stringify(mixed) ?? 'undefined');
console.log(JSON.stringify(new Map<string, number>([['key', 1]])) ?? 'undefined');
console.log(JSON.stringify(new Set<string>(['key'])) ?? 'undefined');
console.log(JSON.stringify({map: new Map<string, number>(), set: new Set<number>()}) ?? 'undefined');
