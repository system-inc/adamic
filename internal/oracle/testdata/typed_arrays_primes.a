// The Workers sieve at 0a3e6511691f98bdadba30a6792d18d3a0e54b76,
// bench/workers/handler/sieve.a, with zero-filled Uint8Array flags replacing booleans.
function countPrimes(limit: number): number {
 const composite = new Uint8Array(limit + 1);
 for (let prime = 2; prime * prime <= limit; prime++) {
  if (composite[prime] !== 1) {
   for (let multiple = prime * prime; multiple <= limit; multiple += prime) {
    composite[multiple] = 1;
   }
  }
 }
 let count = 0;
 for (let index = 2; index <= limit; index++) {
  if (composite[index] !== 1) { count++; }
 }
 return count;
}
for (const limit of [0, 1, 2, 10, 100]) {
 console.log(`${limit}: ${countPrimes(limit)}`);
}
