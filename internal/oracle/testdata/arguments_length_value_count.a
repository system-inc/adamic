function reader(): number {
	return arguments.length;
}
function quiet(): number {
	return 77;
}
function invoke(run: (first: number, second: number) => number): number {
	return run(1, 2);
}
let selected: (first: number, second: number) => number = quiet;
console.log(`${invoke(selected)}`);
selected = reader;
console.log(`${invoke(selected)}`);
const source = [1, 2, 3];
const restValue: (...items: number[]) => number = reader;
console.log(`${restValue(...source)}`);
