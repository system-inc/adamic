const cells = new Array<string | undefined>(5);
cells[0] = `word${0}`;
cells[2] = `word${2}`;
cells[4] = `word${4}`;
cells[-1] = `property${1}`;
console.log(`before:${cells.length}:${cells.join("|")}`);
cells.length = 3;
console.log(`shrink:${cells.length}:${cells.join("|")}:${cells[4] === undefined}:${cells[-1]}`);
cells.length = 6;
console.log(`grow:${cells.length}:${cells.join("|")}`);
cells[5] = `word${5}`;
cells.length = 0;
console.log(`empty:${cells.length}:${cells[5] === undefined}:${cells[-1]}`);
cells.length = 4;
console.log(`restore:${cells.join("|")}`);
try { cells.length = 1.5; } catch (error) {
 if (error instanceof RangeError) { console.log(`${error.name}:${error.message}:${cells.length}`); }
}
const dense = [1, 2, 3];
dense.length = 5;
console.log(`dense:${dense.join("|")}`);
dense.length = 1;
console.log(`dense:${dense.join("|")}`);
const changed = new Array<number>(4);
changed[0] = 1;
changed[2] = 3;
const mapped = changed.map((value, index) => {
 if (index === 0) { changed.length = 1; }
 return value * 10;
});
console.log(`mutated map:${mapped.length}:${mapped.join("|")}`);
