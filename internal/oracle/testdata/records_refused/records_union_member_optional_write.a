// a-check: refused writing a possibly absent optional own field
type OptionValue = string | number | boolean | undefined;
interface Options {
	newLine?: number;
	removeComments?: boolean;
	target?: number;
	[option: string]: OptionValue;
}
interface Printer {
	newLine?: number;
	removeComments?: boolean;
	omitTrailingSemicolon?: boolean;
}
function setNewLine(options: Options | Printer, value: number): void {
	options.newLine = value;
}
function newLine(options: Options | Printer): string {
	return String(options.newLine);
}
const options: Options = { target: 2 };
const printer: Printer = { omitTrailingSemicolon: true };
setNewLine(options, 1);
setNewLine(printer, 0);
console.log(`${newLine(options)} ${String(options.newLine)} ${newLine(printer)} ${String(printer.newLine)} ${String(printer.omitTrailingSemicolon)} ${String(options['target'])}`);
