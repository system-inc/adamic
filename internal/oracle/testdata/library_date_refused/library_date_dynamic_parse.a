function parse(text: string): number { return Date.parse(text); }
function construct(text: string): number { return new Date(text).getTime(); }
for (const text of [
 '1970', '1970-01', '1970T00:00', '1970-01-01T00:00:00',
 '-271821-04-20T00:00:00.000Z', '+275760-09-13T01:00:00.000+01:00',
 '2000-02-29t12:34:56.123456z', '2000-02-29T24:00:00.0001Z',
 '-000000-03-31', '-000000-03-31T00:45Z', '2020-13-01', '2020-02-31',
 'Thu, 01 Jan 1970 00:00:00 GMT', 'Thu Jan 01 1970 00:00:00 GMT+0000 (Coordinated Universal Time)',
 'Dec 17 1995', 'December 17, 1995 03:24:00', '12/17/1995', '1995/12/17',
 '17 Dec 1995 03:24:00 GMT', 'December 17 1995 3:24 PM',
 'Sun Dec 17 1995 03:24:00 GMT-0800 (Pacific Standard Time)',
 '17-Dec-1995 03:24:00 PST', '17 Dec 1995 03:24:00 GMT+05:30',
 '17 Dec 1995 03:24:00 UT', '17 Dec 1995 03:24:00 EST',
 'Jan 1', '1', '49', '50', '99', '0', '13', '0000', ' 0000 ',
 '1970-1-1', '1970-01-01T00:00:00+0000', '1970-01-01\u0000ignored',
 '\u00a01970/01/01\u00a0', 'prefix (ignored (nested)) 1970/01/01',
 '1970-01-01T00:00:00.000Z garbage', 'not a date', '',
 '01 Jan 1970 00::01', '01 Jan 1970 00:00:00.12 GMT',
 'Thu, 01 Jan -0001 00:00:00 GMT', 'Thu, 01 Jan 0001 00:00:00 GMT',
 '01 Jan 1970 00:00:00 GMT+999999999:00', '01 Jan 1970 00:00:00 GMT+400000:00', '01 Jan 1970 00:00:00 GMT+300000:00',
 '999999999999999/01/01', '1970-01-01T00:00:00.000000000000000001Z'
]) {
 console.log(`${parse(text)} ${construct(text)}`);
}
for (const time of [-8640000000000000, -62198755200000, -62167219200000, -1, 0, 951782400000, 253402300800000, 8640000000000000, NaN]) {
 const date = new Date(time);
 const native = date.toString();
 const utc = date.toUTCString();
 console.log(`${parse(native)} ${construct(native)} ${parse(utc)} ${construct(utc)}`);
}

for (const year of ['0', '01', '49', '50', '99', '1970', '2000', '10000', '275760', '999999']) {
 for (const month of ['Jan', 'January', 'feb', 'DEC', 'Sep']) {
  for (const zone of ['GMT', 'UTC', 'PST', 'EST', 'GMT+05:30', 'GMT-8', 'GMT+1245', '']) {
   const text = `${month} 01 ${year} 12:34:56.789 ${zone}`;
   console.log(`${parse(text)} ${construct(text)}`);
  }
 }
}
for (const first of ['1', '2', '12', '13', '31', '32', '49', '50', '99', '1970', '2000']) {
 for (const separator of ['/', '-', '.', ' ']) {
  for (const suffix of ['', ' 00:00:00', ' (comment)', ' junk']) {
   const text = `${first}${separator}1${separator}20${suffix}`;
   console.log(`${parse(text)} ${construct(text)}`);
  }
 }
}
