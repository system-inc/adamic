// Prototype calls on views and receiver lifetime while arguments reassign its variable.
for (const word of ['abcabc', 'é🌍xé']) {
    let source = `!${word}?`.slice(1, -1);
    let order = '';
    const start = (): number => { order += 's'; source = 'changed'; return 1; };
    const end = (): number => { order += 'e'; return 4; };
    console.log(String.prototype.slice.call(source, start(), end()));
    source = `!${word}?`.substring(1, word.length + 1);
    console.log(String.prototype.substring.call(source, end(), start()));
    source = `!${word}?`.slice(1, -1);
    console.log(`${String.prototype.charAt.call(source, start()).charCodeAt(0)} ${source} ${order}`);
    source = `!${word}?`.slice(1, -1);
    console.log(`${String.prototype.charCodeAt.call(source, start())}`);
    source = `!${word}?`.slice(1, -1);
    console.log(`${(String.prototype.at.call(source, start()) ?? '').charCodeAt(0)}`);
    source = `!${word}?`.slice(1, -1);
    console.log(`${String.prototype.indexOf.call(source, 'x', start())}`);
    source = `!${word}?`.slice(1, -1);
    console.log(`${String.prototype.lastIndexOf.call(source, source.slice(0, 1))}`);
}
console.log(`${String.prototype.substring.call(12345, 1, 4)} ${String.prototype.charAt.call(true, 1)} ${String.prototype.slice.call(false, 1, 4)}`);
