namespace Slot {
    export let value: number = undefined!;
    export function set(): void { value = 7; }
    export function reset(): void { value = undefined!; }
    export function observe(): void { console.log(typeof value); }
}
const escaped = Slot;
console.log(String(escaped === Slot));
Slot.observe();
Slot.set();
console.log(String(Slot.value));
Slot.reset();
Slot.observe();
