// A number read off the parameter is returned, and the region still happens (#1jch5ez): look's
// `return p.x` hands back a copy of the field, which can't carry the object out, so make(7) is
// allocated in the statement's region. The label is built at runtime, so a use after free of it shows.
interface P {
	readonly x: number;
	readonly label: string;
}

function make(n: number): P {
	return { x: n, label: `p${n}` };
}

function look(p: P): number {
	return p.x;
}

let total = 0;
total += look(make(7));
console.log(`${total}`);
