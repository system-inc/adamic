// keep pushes its parameter onto an outer array, so the point make(7) built outlives the statement
// that made it and must stay off the statement's region. keep returns a Binary, which escaping
// consumes, so the push is what marks the escape. The label is built at runtime, since an immortal
// string literal would hide a use after free.
interface P {
	readonly x: number;
	readonly label: string;
}

function make(n: number): P {
	return { x: n, label: `p${n}` };
}

const outer: P[] = [{ x: 0, label: 'seed' }];

function keep(p: P): number {
	outer.push(p);
	return p.x + p.label.length;
}

let total = 0;
total += keep(make(7));
console.log(`${total} ${outer[1]?.label} ${outer.length}`);
