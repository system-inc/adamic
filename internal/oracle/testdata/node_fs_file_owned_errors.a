import { programArguments } from 'adamic';
import { openSync, closeSync, writeSync, readFileSync, writeFileSync, statSync, unlinkSync, mkdirSync, utimesSync, readdirSync, realpathSync } from 'node:fs';
const root = programArguments()[0] ?? '';
function failure(error: unknown): void {
    if (typeof error !== 'object' || error === null) { return; }
    const code = 'code' in error && typeof error.code === 'string' ? error.code : 'missing';
    const errno = 'errno' in error && typeof error.errno === 'number' ? error.errno : 0;
    const syscall = 'syscall' in error && typeof error.syscall === 'string' ? error.syscall : 'missing';
    const path = 'path' in error && typeof error.path === 'string' ? error.path.replace(root, '<root>') : 'missing';
    console.log(`${code} ${errno} ${syscall} ${path}`);
    console.log(`${'errno' in error} ${'syscall' in error} ${'path' in error}`);
}
const fd = openSync(root + '/out', 'w');
writeSync(fd, 'owned');
closeSync(fd);
try { closeSync(fd); } catch (error) { failure(error); }
try { writeSync(fd, 'stale'); } catch (error) { failure(error); }
try { readFileSync(fd, 'utf8'); } catch (error) { failure(error); }
try { writeFileSync(fd, 'stale'); } catch (error) { failure(error); }
const reopened = openSync(root + '/out', 'r');
console.log(readFileSync(reopened, 'utf8'));
closeSync(reopened);
try { statSync(root + '/missing'); } catch (error) { failure(error); }
try { unlinkSync(root + '/missing'); } catch (error) { failure(error); }
try { unlinkSync(root + '/directory'); } catch (error) { failure(error); }
try { mkdirSync(root + '/directory'); } catch (error) { failure(error); }
try { utimesSync(root + '/missing', new Date(0), new Date(0)); } catch (error) { failure(error); }
try { readdirSync(root + '/missing', { withFileTypes: true }); } catch (error) { failure(error); }
try { realpathSync.native(root + '/missing'); } catch (error) { failure(error); }
failure(new Error('plain'));
try { statSync(root + '/nul\0'); } catch (error) { failure(error); }
writeSync(1, 'standard\n');
