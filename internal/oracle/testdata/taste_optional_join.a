let receivers = 0;
let separators = 0;
function receiver(present: boolean): number[] | undefined {
    receivers++;
    return present ? [1, 2] : undefined;
}
function separator(): string { separators++; return ":"; }
console.log(receiver(false)?.join(separator()) ?? "missing");
console.log(`${receivers}:${separators}`);
console.log(receiver(true)?.join(separator()) ?? "missing");
console.log(`${receivers}:${separators}`);
receiver(false)?.join(separator());
console.log(`${receivers}:${separators}`);
