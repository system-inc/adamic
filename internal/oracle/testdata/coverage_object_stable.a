let fields = { ordinary: 'old' + '-text', '10': 'ten', '2': 'two', '01': 'leading' };
const alias = (fields);
console.log(Object.values(alias).join('|'));
for (const [key, value] of Object.entries(alias)) console.log(`${key}:${value}`);
console.log(`${Object.hasOwn(alias, '2')} ${Object.is(alias, fields)}`);
const result = Object.assign(fields, { ordinary: 'new' + '-text' }, fields);
console.log(`${Object.is(result, fields)} ${fields.ordinary}`);
Object.freeze(fields);
console.log(`${Object.isSealed(fields)} ${Object.isExtensible(fields)} ${Object.isFrozen(fields)}`);
console.log(Object.keys(fields).join('|'));
