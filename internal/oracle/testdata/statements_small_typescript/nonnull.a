const state: { index?: number } = { index: 1 };
state.index!++;
console.log(`${state.index}`);
--state.index!;
console.log(`${state.index}`);
state.index = 0;
state.index!--;
console.log(`${state.index}`);
let calls = 0;
function receiver(): { index?: number } {
    calls++;
    return state;
}
++receiver().index!;
receiver().index!++;
console.log(`${state.index}:${calls}`);
state.index = NaN;
state.index!++;
console.log(`${state.index}`);
