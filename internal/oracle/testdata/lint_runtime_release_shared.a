// Many owners release the same object, array, map, closure and boxed scalar values.
function identity<Value>(value: Value): Value {
    return value;
}
function identityReader(value: () => string): () => string {
    return value;
}
function churn(round: number): void {
    const text = `shared${round}`.repeat(20);
    const object = { text };
    const array = [object, object];
    const map = new Map<string, typeof object>([[text, object]]);
    let captured = text;
    const read = (): string => captured;
    const owners: { readonly object: typeof object; readonly array: typeof array; readonly map: typeof map; readonly read: () => string }[] = [];
    for (let index = 0; index < 256; index++) {
        owners.push({ object, array, map, read });
        identity(text);
        identity(object);
        identity(array);
        identity(map);
        identityReader(read);
    }
    owners.splice(0, 255);
    captured = `${text}!`;
    const last = owners.pop();
    if (last !== undefined) {
        console.log(`${last.object.text.length} ${last.array.length} ${last.map.size} ${last.read().length}`);
    }
    let scalar: number | boolean | string | undefined = text;
    for (let index = 0; index < 256; index++) {
        scalar = index % 4 === 0 ? index : index % 4 === 1 ? true : index % 4 === 2 ? text : undefined;
    }
    console.log(`${String(scalar)}`);
}
for (let round = 0; round < 3; round++) {
    churn(round);
}
