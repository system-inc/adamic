// stdout's handle handed to a function as a parameter, whose setBlocking is read off it and called
// detached: Node's throws TypeError: Illegal invocation, and so does both backends' (#0bxc4jh).
import 'node:process';
function detach(handle: { setBlocking?: (value: boolean) => void }): void {
	const set = handle.setBlocking;
	try {
		if (set) set(true);
		console.log('blocked');
	} catch (error) {
		console.log(`${error instanceof TypeError}`);
		if (error instanceof Error) console.log(error.message);
	}
}
const handle = (process.stdout as any)._handle as { setBlocking?: (value: boolean) => void } | undefined;
if (handle === undefined) {
	console.log('no handle');
} else {
	detach(handle);
}
