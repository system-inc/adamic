const map = new Map<number, string>([[1, 'a'.repeat(2)]]);
const held = map.values();
console.log(`${held.next().value} ${held.next().done}`);
for (let key = 2; key < 10000; key += 1) { map.set(key, `${key}`); map.delete(key); }
map.set(2, 'b'.repeat(2));
console.log(`${held.next().done} ${held.next().done}`);
console.log([...map.values()].join(' '));
const active = map.keys();
console.log(`${active.next().value}`);
map.delete(1);
for (let key = 3; key < 100; key += 1) { map.set(key, `${key}`); map.delete(key); }
map.set(100, 'last');
console.log(`${active.next().value} ${active.next().value} ${active.next().done}`);
console.log(`${held.next().done}`);
