// A Stats holds every field Node gives it (#6xfkdwj): Node's fourteen own numbers and Stats.prototype's
// four Dates, read statically and by a run-time key. The file is this run's own, so a number that
// differs from run to run (its inode, its change and birth times) is printed as a relation, and one
// the box gives every run alike (the device, the owner, the mode, a block count, the times utimesSync
// set) by its value. utimesSync moved the access and modification times to fixed past ones, and not
// the change time: a change time written from the modification time reads before the access time.
// Each Date is read twice and is the same object, as Node's cached accessor gives.
import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

function errorCode(error: unknown): string | undefined {
	return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' ? error.code : undefined;
}

function propertyOf(value: unknown, key: string): unknown {
	if (value === null || value === undefined) {
		throw new TypeError(`Cannot read properties of ${value === null ? 'null' : 'undefined'} (reading '${key}')`);
	}
	return Reflect.get(Object(value), key, value);
}

// An exclusive create takes the first name no other run holds.
function freshFile(): string {
	const started = String(Date.now());
	for (let index = 0; index < 100; index++) {
		const path = join(tmpdir(), `adamic-stats-fields-${started}-${String(index)}`);
		try {
			fs.writeFileSync(path, 'four', { flag: 'wx' });
			return path;
		} catch (error) {
			if (errorCode(error) !== 'EEXIST') throw error;
		}
	}
	throw new Error('no fresh name');
}

const file = freshFile();
fs.utimesSync(file, 1700000000.25, 1600000000.5);
const stats = fs.statSync(file);
const again = fs.statSync(file);
const place = fs.statSync(tmpdir());
console.log(`dev ${String(stats.dev === place.dev)} ${String(stats.dev)}`);
console.log(`mode ${String(stats.mode)} file ${String(stats.isFile())}`);
console.log(`nlink ${String(stats.nlink)}`);
console.log(`uid ${String(stats.uid)} gid ${String(stats.gid)}`);
console.log(`rdev ${String(stats.rdev)}`);
console.log(`blksize ${String(stats.blksize)}`);
console.log(`ino ${String(stats.ino === again.ino)} ${String(stats.ino > 0)} ${String(stats.ino !== place.ino)} place ${String(place.ino)}`);
console.log(`size ${String(stats.size)}`);
console.log(`blocks ${String(stats.blocks)}`);
console.log(`atimeMs ${String(stats.atimeMs)} mtimeMs ${String(stats.mtimeMs)}`);
console.log(`ctimeMs after the access time ${String(stats.ctimeMs > stats.atimeMs)} not the modification time ${String(stats.ctimeMs !== stats.mtimeMs)} again ${String(stats.ctimeMs === again.ctimeMs)}`);
console.log(`birthtimeMs by the change time ${String(stats.birthtimeMs <= stats.ctimeMs)} after the access time ${String(stats.birthtimeMs > stats.atimeMs)} again ${String(stats.birthtimeMs === again.birthtimeMs)}`);
console.log(`atime ${String(stats.atime.getTime())} same ${String(stats.atime === stats.atime)}`);
console.log(`mtime ${String(stats.mtime.getTime())} same ${String(stats.mtime === stats.mtime)}`);
console.log(`ctime rounded ${String(stats.ctime.getTime() === Math.round(stats.ctimeMs))} same ${String(stats.ctime === stats.ctime)}`);
console.log(`birthtime rounded ${String(stats.birthtime.getTime() === Math.round(stats.birthtimeMs))} same ${String(stats.birthtime === stats.birthtime)}`);
console.log(`Number of each Date ${String(Number(stats.atime))} ${String(Number(stats.mtime))} ${String(Number(stats.ctime) === stats.ctime.getTime())} ${String(Number(stats.birthtime) === stats.birthtime.getTime())}`);
const numbers = [stats.dev, stats.mode, stats.nlink, stats.uid, stats.gid, stats.rdev, stats.blksize, stats.ino, stats.size, stats.blocks, stats.atimeMs, stats.mtimeMs, stats.ctimeMs, stats.birthtimeMs];
const names = ['dev', 'mode', 'nlink', 'uid', 'gid', 'rdev', 'blksize', 'ino', 'size', 'blocks', 'atimeMs', 'mtimeMs', 'ctimeMs', 'birthtimeMs'];
for (let index = 0; index < names.length; index++) {
	const value = propertyOf(stats, names[index] ?? '');
	console.log(`${names[index] ?? ''} by key ${typeof value} ${String(value === numbers[index])}`);
}
const atime = propertyOf(stats, 'atime');
console.log(`atime by key ${typeof atime} ${String(atime === stats.atime)} twice ${String(atime === propertyOf(stats, 'atime'))}`);
const mtime = propertyOf(stats, 'mtime');
console.log(`mtime by key ${typeof mtime} ${String(mtime === stats.mtime)} twice ${String(mtime === propertyOf(stats, 'mtime'))}`);
const ctime = propertyOf(stats, 'ctime');
console.log(`ctime by key ${typeof ctime} ${String(ctime === stats.ctime)} twice ${String(ctime === propertyOf(stats, 'ctime'))}`);
const birthtime = propertyOf(stats, 'birthtime');
console.log(`birthtime by key ${typeof birthtime} ${String(birthtime === stats.birthtime)} twice ${String(birthtime === propertyOf(stats, 'birthtime'))}`);
console.log(`another Stats' Dates ${String(again.mtime === stats.mtime)} ${String(again.mtime.getTime() === stats.mtime.getTime())}`);
fs.unlinkSync(file);
