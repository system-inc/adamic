// A for...in over a record reads the key list its table keeps (runtime record.c's
// adamic_record_for_in_keys) until a write adds or deletes a key. Each line is one loop's keys, held to
// Node: array indexes ascending, then insertion order.
function show(label: string, record: Record<string, number>): void {
	const keys: string[] = [];
	for (const key in record) {
		keys.push(key);
	}
	console.log(label + ': ' + keys.join(','));
}

const r: Record<string, number> = { b: 1, a: 2 };
show('first', r);
show('again', r);
r['c'] = 3;
show('added', r);
delete r['b'];
show('deleted', r);
r['7'] = 7;
r['3'] = 3;
show('indexes', r);
r['b'] = 4;
show('added back', r);
// A value written to a key the record has leaves its keys as they were.
r['a'] = 20;
show('value written', r);
console.log('a is ' + String(r['a']));

// A key deleted during the loop isn't visited, and one added during it isn't either.
const during: Record<string, number> = { x: 1, y: 2, z: 3 };
show('during, before', during);
const visited: string[] = [];
for (const key in during) {
	visited.push(key);
	if (key === 'x') {
		delete during['y'];
		during['w'] = 4;
	}
}
console.log('during: ' + visited.join(','));
show('during, after', during);

// Nested loops over one record, one of them adding a key each pass: the outer loop reads on through the
// list it began with, and each inner loop sees the keys there when it starts.
const pairs: string[] = [];
for (const outer in r) {
	for (const inner in r) {
		pairs.push(outer + inner);
	}
}
console.log('nested: ' + pairs.join(','));
const grow: Record<string, number> = { p: 1, q: 2 };
const trace: string[] = [];
for (const outer in grow) {
	for (const inner in grow) {
		trace.push(outer + inner);
	}
	grow[outer + outer] = 0;
}
console.log('nested, growing: ' + trace.join(','));
show('grown', grow);

// Object.keys is a new array each time, never the list a for...in reads: reversing it changes no loop.
show('before Object.keys', r);
const listed = Object.keys(r);
listed.reverse();
console.log('Object.keys reversed: ' + listed.join(','));
show('after Object.keys', r);
console.log('Object.keys again: ' + Object.keys(r).join(','));
