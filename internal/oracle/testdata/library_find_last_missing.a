const numbers = [1, 2, 3, 4];
const found = numbers.findLast((item: number | undefined, index: number, array: number[]): boolean => {
 console.log(`${index}:${item}:${array === numbers}`);
 if (index === 3) { array.splice(0, 3); }
 if (index === 2) { array.push(8); }
 return item === undefined && index === 1;
});
console.log(`${found}`);
console.log(numbers.join(','));
const strings = ['a'.repeat(2), 'b'.repeat(2), 'c'.repeat(2)];
console.log(`${strings.findLastIndex((item: string, index: number): boolean => {
 console.log(`${index}:${typeof item}:${item}`);
 if (index === 2) { strings.splice(0, 3); }
 return item === undefined;
})}`);
const snapshot = ['x'.repeat(2), 'y'.repeat(2)];
console.log(snapshot.findLast((item: string): boolean => { snapshot.splice(0, 2); return true; }) ?? 'missing');
const empty: string[] = [];
console.log(empty.findLast((): boolean => true) ?? 'empty');
const mutable = ['x'.repeat(2), 'y'.repeat(2)];
const readonly: readonly string[] = mutable;
console.log(`${readonly.findLastIndex((item: string, index: number): boolean => {
 console.log(`${index}:${item}`);
 mutable.splice(0, 2);
 return false;
})}`);
