// TypeScript 6.0.3 utilities.ts:8705, original formatMessage body.
interface DiagnosticMessage { readonly message: string; }
type DiagnosticArguments = string[];
function getLocaleSpecificMessage(message: DiagnosticMessage): string { return message.message; }
function some(args: readonly string[]): boolean { return args.length > 0; }
function formatStringFromArgs(text: string, args: readonly string[]): string { return text + args.join('|'); }
function formatMessage(message: DiagnosticMessage, ...args: DiagnosticArguments): string {
    let text = getLocaleSpecificMessage(message);

    if (some(args)) {
        text = formatStringFromArgs(text, args);
    }

    return text;
}
let order = '';
function argument(value: string): string { order += value; return value; }
const message = { message: 'message:' };
console.log(formatMessage(message));
console.log(formatMessage(message, argument('a'), argument('b')));
console.log(order);
const items = ['c', 'd'];
console.log(formatMessage(message, argument('e'), ...items, argument('f')));
function change(...args: string[]): string { args.push('owned'); return args.join('|'); }
console.log(change(...items));
console.log(items.join('|'));
console.log(order);
