// getter_writes_global.a's control (#qk8rztp S2c-2b): the same calls with no getter anywhere, so the
// spread may run none (ir.ObjectLiteral's SpreadGetters is empty), and reuse judges describe's call
// as it did before the spread had a case of its own. Its counts must not move. Node prints 11
// tree1, then tree1.
type Tree = { value: number; label: string };
let tree: Tree = { value: 1, label: `tree${String(1)}` };
const source: Tree = { value: 10, label: `source${String(2)}` };
function describe(node: Tree, extra: Tree): string {
    const copy = { ...extra };
    return `${String(node.value + copy.value)} ${node.label}`;
}
console.log(describe(tree, source));
console.log(tree.label);
