namespace Values {
    export const entries: number[] = [1, 2];
    export const record: { text: string } = { text: 'start' };
    let version = 0;
    export function change(): string { version += 1; record.text = `version${version}`; entries.push(version); return record.text; }
}
class Label {
    constructor(public text: string) {}
    read(): string { return this.text; }
}
class Store {
    readonly first = 'base-field';
    constructor(public label: Label, public map: Map<string, string>, public set: Set<number>, public list: number[]) {}
    read(): string { return `${this.first} ${this.label.read()} ${this.map.get('key') ?? 'missing'} ${this.set.size} ${this.list.join(',')}`; }
}
class ChildStore extends Store {
    readonly second = 'child-field';
    constructor(label: Label, map: Map<string, string>, set: Set<number>, list: number[], public flag: boolean = false, public word?: string, public note?: Label, public run?: () => string) {
        super(label, map, set, list);
    }
    extra(): string { const run = this.run; return `${this.second} ${this.flag ?? false} ${this.word ?? 'absent'} ${this.note?.text ?? 'absent'} ${run === undefined ? 'absent' : run()}`; }
}
function make(index: number): ChildStore {
    const map = new Map<string, string>();
    map.set('key', `map${index}`);
    const set = new Set<number>();
    set.add(index);
    const suffix = `closure${index}`;
    return new ChildStore(new Label(`label${index}`), map, set, Values.entries, true, `word${index}`, new Label(`note${index}`), () => suffix);
}
const full = make(3);
const empty = new ChildStore(new Label('empty'), new Map<string, string>(), new Set<number>(), []);
Values.change();
console.log(full.read());
console.log(full.extra());
console.log(`${empty.read()} ${empty.extra()}`);
full.label = new Label(Values.change());
full.map.set('key', 'changed');
full.set.add(8);
full.word = undefined;
console.log(`${full.read()} ${full.extra()} ${Values.record.text}`);
