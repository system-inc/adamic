const template = { readonlyMarker: true, raw: ['a', 'b', 'c'] };
console.log(String.raw(template, 1, true));
console.log(String.raw(template));
console.log(String.raw(template, undefined, null, 'ignored'));
const empty: readonly string[] = [];
console.log(String.raw({ raw: empty }, 'ignored'));
console.log(String.raw({ raw: ['single'] }, 'ignored'));
console.log(String.raw({ raw: ['a', 'b'] }, 'first', 'last'));
console.log(String.raw({ raw: ['\uD83C', '\uDF0D'] }));
let order = '';
const changed = { raw: ['before', 'end'] };
function substitution(): number { order = order + 's'; changed.raw[0] = 'after'; return 42; }
console.log(String.raw(changed, substitution()));
console.log(order);

console.log(String.raw`\n\u0061`);
console.log(String.raw`a${42}b${true}c${undefined}d`);
console.log(String.raw`\u{invalid}`);
console.log(String.raw`escaped \` tick \${text}`);
let tagOrder = '';
function taggedValue(value: number): number { tagOrder = tagOrder + `${value}`; return value; }
console.log(String.raw`a${taggedValue(1)}b${taggedValue(2)}c`);
console.log(tagOrder);
