// String variant of TypeScript 6.0.3 checker.ts:7440, labeledElementDeclarations?.[i].
function pick(text: string | undefined, i: number): string | undefined { return text?.[i]; }
console.log(`${pick(undefined, 0)} ${pick('first', 0)} ${pick('first', 99)} ${pick('', 0)}`);
console.log(`${pick('é😀', 0)} ${pick('é😀', 1)} ${pick('é😀', 2)}`);
console.log(`${pick('first', -1)} ${pick('first', 0.5)} ${pick('first', NaN)} ${pick('first', -0)}`);
let count = 0;
function position(): number { count++; return 0; }
function observe(text: string | undefined): void { console.log(`${text?.[position()]} ${count}`); }
observe(undefined);
observe('');
observe(`text${count}`);
