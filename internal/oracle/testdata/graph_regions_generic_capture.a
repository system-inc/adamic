class Tie<T> {
 readonly tag: string;
 constructor(tag: string) { this.tag = tag; }
 tie(initial: T, make: (get: () => T) => T): T {
  let cell: T = initial;
  const get = (): T => (this.tag.length > 0 ? cell : cell);
  cell = make(get);
  return cell;
 }
}
function run(n: number): number {
 const tie = new Tie<() => number>(`t${n}`);
 const f = tie.tie((): number => 0, (get: () => () => number): (() => number) => (): number => (n > 100 ? get()() : n));
 return f();
}
console.log(`${run(1)}`);
