/* eslint-disable @typescript-eslint/unbound-method -- The oracle supplies primitive string receivers to these explicitly typed intrinsic aliases. */
const split: (this: string, separator: string) => string[] = String.prototype.split;
const replace: (this: string, search: string, replacement: string) => string = String.prototype.replace;
const replaceAll: (this: string, search: string, replacement: string) => string = String.prototype.replaceAll;
console.log(split.call('a|b|', '|').join('|'));
console.log(
    split
        .apply('🌍', [''])
        .map((part) => part.charCodeAt(0))
        .join('|'),
);
console.log(replace.call('aba', 'a', 'x'));
console.log(replace.apply('aba', ['a', '$&!']));
console.log(replaceAll.call('aba', 'a', 'x'));
console.log(replaceAll.apply('ab', ['', '-']));
