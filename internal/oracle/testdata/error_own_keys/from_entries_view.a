// Object.fromEntries over Object.entries of a caught Error through a structural view, a road that already stops.
try {
	throw new Error('m');
} catch (e) {
	if (e instanceof Error) {
		const o: { message: string } = e;
		const copy = Object.fromEntries(Object.entries(o));
		console.log(JSON.stringify(copy) ?? 'undefined');
	}
}
