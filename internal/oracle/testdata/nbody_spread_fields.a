// Spread copies preserve layouts but are excluded from literal write guards.
class Source { #hidden = 9; public count = 1; public text = `source${1}`; read(): number { return this.#hidden; } }
function update(value: { count: number; text: string }): string {
    value.count += 3;
    value.text = `${value.text}:${value.count}`;
    return value.text;
}
const source = new Source();
const copy = { ...source, text: `copy${2}` };
console.log(update(source));
console.log(update(copy));
const reversed = { text: `reverse${3}`, count: 4 };
const spread = { ...reversed, text: `spread${4}` };
console.log(update(spread));
console.log(`${source.read()}/${source.count}/${copy.count}/${reversed.count}`);
