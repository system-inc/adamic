interface Runner { run(value: string): string; }
class FieldRunner implements Runner {
    readonly run: (value: string) => string;
    constructor(label: string) { this.run = (value: string): string => `${label}:${value}`; }
}
const concrete = new FieldRunner('field');
const saved = concrete.run;
console.log(saved('saved'));
const exact: Runner = new FieldRunner('interface');
console.log(exact.run('exact'));
function through(value: Runner): string { return value.run('parameter'); }
console.log(through(exact));
class Derived extends FieldRunner {}
const inherited: Runner = new Derived('derived');
console.log(inherited.run('inherited'));
