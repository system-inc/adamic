// Undefined becomes null in an array and is omitted from an object, including when nested.
console.log(JSON.stringify([undefined]) ?? '<undefined>');
console.log(JSON.stringify([undefined, 1, undefined]) ?? '<undefined>');
console.log(JSON.stringify([1, undefined]) ?? '<undefined>');
console.log(JSON.stringify([undefined, undefined]) ?? '<undefined>');
console.log(JSON.stringify([[undefined], [1, undefined, 2]]) ?? '<undefined>');
console.log(JSON.stringify({ a: undefined }) ?? '<undefined>');
console.log(JSON.stringify({ a: undefined, b: undefined }) ?? '<undefined>');
console.log(JSON.stringify({ a: 1, b: undefined, c: 2 }) ?? '<undefined>');
console.log(JSON.stringify({ a: undefined, b: null, c: undefined }) ?? '<undefined>');
console.log(JSON.stringify({ a: [undefined, { b: undefined, c: 1, d: undefined }] }) ?? '<undefined>');
console.log(JSON.stringify({ missing: undefined, fn: () => 1, n: NaN, ok: true }) ?? '<undefined>');
