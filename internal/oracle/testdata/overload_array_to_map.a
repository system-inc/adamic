function arrayToMap<K, V>(array: readonly V[], makeKey: (value: V) => K | undefined): Map<K, V>;
function arrayToMap<K, V1, V2>(array: readonly V1[], makeKey: (value: V1) => K | undefined, makeValue: (value: V1) => V1 | V2 = (value) => value): Map<K, V1 | V2> {
    const result = new Map<K, V1 | V2>();
    for (const value of array) {
        const key = makeKey(value);
        if (key !== undefined) result.set(key, makeValue(value));
    }
    return result;
}
const mapped = arrayToMap(['keep', 'skip', 'keep'], (value) => value === 'skip' ? undefined : value);
console.log(`${mapped.size}:${mapped.get('keep') ?? 'missing'}`);
