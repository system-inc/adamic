let receiver = new Uint8Array([1, 2, 3, 4]);
const original = receiver;
function numberArgument(name: string, value: number): number {
    console.log(name);
    receiver = new Uint8Array(0);
    return value;
}
receiver.fill(numberArgument("value", 300), numberArgument("start", 1), numberArgument("end", 3));
console.log(`fill ${original[1]} ${original[2]} ${receiver.length}`);
receiver = original;
const view = receiver.subarray(numberArgument("begin", 1), numberArgument("finish", 3));
view[0] = -1;
console.log(`view ${original[1]} ${view.length} ${receiver.length}`);
receiver = original;
function sourceArgument(): Uint8Array {
    console.log("source");
    receiver = new Uint8Array(0);
    return new Uint8Array([7, 8]);
}
receiver.set(sourceArgument(), numberArgument("offset", 1));
console.log(`set ${original[1]} ${original[2]} ${receiver.length}`);
receiver = original;
receiver[numberArgument("index", 3)] = numberArgument("write", 300);
console.log(`write ${original[3]} ${receiver.length}`);
let source: number[] = [300, -1];
const constructed = new Uint8Array(source);
source[0] = 17;
console.log(`copied constructor ${constructed[0]} ${source[0]}`);
