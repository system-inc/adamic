// Shape: TypeScript checker.ts getStringLiteralType (20305), pinned at 050880ce.
// The freshType back-edge is deliberately outside this acyclic first shape.
class LiteralType {
    readonly value: string;
    readonly id: number;
    constructor(value: string, id: number) {
        this.value = value;
        this.id = id;
    }
}
const cache = new Map<string, LiteralType>();
let nextId = 0;
function getStringLiteralType(value: string): LiteralType {
    let type = cache.get(value);
    if(type === undefined) {
        type = new LiteralType(value, nextId);
        nextId += 1;
        cache.set(value, type);
    }
    return type;
}
