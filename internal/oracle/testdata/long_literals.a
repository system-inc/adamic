// String literals longer than C11 promises a string literal can be (4,095 bytes), which clang refuses
// under -pedantic: the compiler writes those as bytes. One at the edge, one past it, and a long
// non-ASCII one, read by index the way a tokenizer reads, which also takes the index long literals
// get the first time a position is asked of them.

const edge = '';
const past = 'é';
console.log(`${edge.length} ${past.length} ${edge[4094] ?? ''} ${past.charCodeAt(4094)} ${edge.slice(4090)}`);

