console.log(`${text.length} ${text.charCodeAt(0)} ${text.charCodeAt(text.length - 1)} ${text.codePointAt(10) ?? -1}`);

// Forward and backward over every unit, and a jump around.
let forward = 0;
for (let index = 0; index < text.length; index += 1) {
	forward = (forward * 31 + text.charCodeAt(index)) % 1000003;
}
let backward = 0;
for (let index = text.length - 1; index >= 0; index -= 1) {
	backward = (backward * 31 + (text[index] ?? '?').charCodeAt(0)) % 1000003;
}
const jumps: number[] = [];
for (let step = 0, at = 7; step < 40; step += 1) {
	at = (at * 31 + 977) % text.length;
	jumps.push(text.charCodeAt(at));
}
console.log(`${forward} ${backward} ${jumps.join(',')}`);
console.log(`${text.slice(9, 13)}|${text.slice(10, 11).charCodeAt(0)}|${text.slice(11, 12).charCodeAt(0)}|${text.slice(-14, -1)}`);

// indexOf answers in units, wherever the match is.
console.log(`${text.indexOf('🌍')} ${text.indexOf('世界 🌍 héllo')} ${text.indexOf('missing')} ${text.lastIndexOf('🌍')}`);
const built = `${text}#marker#${'ü'.repeat(3)}`;
console.log(`${built.indexOf('#marker#')} ${built.indexOf('ü')} ${built.indexOf('héllo', )} ${text.indexOf(text.slice(5000, 5010))}`);

// A literal whose checkpoints fall on low halves of pairs (é🌍 is three units, so unit 32k is the
