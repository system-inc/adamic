class Box<T> {
    readonly value: T;
    constructor(value: T) { this.value = value; }
    read(): string { return 'box'; }
}
class Bad extends Box<{ readonly n: number }> {
    override read(): string { throw new Error(`bad${this.value.n}`); }
}
function show(box: Box<{ readonly n: number }>): string {
    return box.read();
}
try {
    console.log(show(new Bad({ n: 1 })));
    console.log('after');
} catch (error) {
    if (error instanceof Error) {
        console.log('caught ' + error.message);
    }
}
