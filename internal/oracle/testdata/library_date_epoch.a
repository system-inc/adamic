const before = new Date(-1.9);
const after = new Date(1.9);
console.log(String(before.getTime()));
console.log(String(before.valueOf()));
console.log(String(Number(before)));
console.log(String(before < after));
console.log(String(before <= before));
console.log(String(after > before));
console.log(String(after >= after));
console.log(String(before === before));
console.log(String(before === after));
console.log(String(new Date(-0).getTime()));
console.log(String(Object.is(new Date(-0).valueOf(), -0)));
console.log(String(new Date(8640000000000001).getTime()));
console.log(String(new Date(-8640000000000001).getTime()));
console.log(String(new Date(Infinity).valueOf()));
console.log(String(new Date(NaN).getTime()));
const copy = new Date(before);
console.log(String(copy.getTime()));
console.log(String(copy === before));
