// Copied verbatim (LF normalized) from TypeScript 6.0.3 src/compiler/sys.ts:59-66.
export function generateDjb2Hash(data: string): string {
    let acc = 5381;
    for (let i = 0; i < data.length; i++) {
        acc = ((acc << 5) + acc) + data.charCodeAt(i);
    }
    return acc.toString();
}

for (const text of ["", "abc", "héllo 🌍", "x".repeat(40), "\u0000", "\uD800", "\uDC00", "𐐀"]) {
	console.log(generateDjb2Hash(text));
}
