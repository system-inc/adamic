import process from 'node:process';
const key = 'ADAMIC_ENV_MUTATION';
process.env.ADAMIC_ENV_MUTATION = 'first';
console.log(process.env[key]);
process.env[key] = '';
console.log(process.env.ADAMIC_ENV_MUTATION);
process.env[key] = 'héllo 世界 🌍';
console.log(process.env[key]);
console.log(`${delete process.env.ADAMIC_ENV_MUTATION}`);
console.log(process.env[key] ?? 'missing');
process.env.ADAMIC_ENV_MUTATION = 'again';
console.log(`${delete process.env[key]}`);
function prototype(key: string): void {
    process.env[key] = 'own environment string';
    console.log(process.env[key]);
    console.log(`${delete process.env[key]}`);
}
prototype('toString');
