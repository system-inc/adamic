interface Values { readonly list: readonly string[]; readonly map: Map<string, string>; readonly callback: () => string; readonly count: number; readonly flag: boolean; readonly missing: string | undefined; }
interface Root { readonly values: Values; }
function make(n: number): Root { return { values: { list: [`list${n}`], map: new Map([[`key${n}`, `map${n}`]]), callback: () => `call${n}`, count: n, flag: true, missing: undefined } }; }
function inspect(root: Root): void {
 const list = root.values.list;
 const map = root.values.map;
 const callback = root.values.callback;
 console.log(`${list[0] ?? 'empty'} ${map.get('key2') ?? 'empty'} ${callback === root.values.callback} ${root.values.count} ${root.values.flag} ${root.values.missing ?? 'missing'}`);
}
const root = make(2);
inspect(root);
console.log(root.values.callback());
