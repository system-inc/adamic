function bounds(start: number | undefined, end: number | undefined): void {
 const text = "ab😀caba";
 console.log(text.slice(start, end));
 console.log(text.substring(start ?? 0, end));
 console.log(`${text.lastIndexOf("a", end)}/${text.lastIndexOf("", end)}`);
}
for (const start of [undefined, 0, -2, 1.9, NaN, Infinity, -Infinity]) {
 for (const end of [undefined, 0, -2, 3.9, NaN, Infinity, -Infinity]) { bounds(start, end); }
}
console.log("ababa".lastIndexOf("aba", 1).toString());
console.log("ababa".lastIndexOf("aba", 2).toString());
console.log("ababa".lastIndexOf("long", 2).toString());
console.log("aaa".lastIndexOf("a").toString());
console.log("ab".slice(undefined, undefined));
console.log("ab".substring(0, undefined));
let order = "";
function receiver(): string { order += "r"; return "ababa"; }
function search(): string { order += "s"; return "aba"; }
function position(): number | undefined { order += "p"; return 1; }
console.log(`${receiver().lastIndexOf(search(), position())}:${order}`);
