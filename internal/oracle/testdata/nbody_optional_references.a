// Optional reference caches see repeated absence and presence at one read site.
interface View { text?: string; object?: { readonly label: string }; }
function read(view: View): string { return `${view.text ?? '-'}:${view.object?.label ?? '-'}`; }
function replace(view: View): string {
    if (view.text !== undefined) view.text = `${view.text}!`;
    if (view.object !== undefined) view.object = { label: `${view.object.label}!` };
    return read(view);
}
const missing: View = {};
const first: View = { text: `first${1}`, object: { label: `one${1}` } };
const reordered: View = { object: { label: `two${2}` }, text: `second${2}` };
for (const view of [missing, missing, first, first, reordered, reordered, missing, missing]) console.log(replace(view));
