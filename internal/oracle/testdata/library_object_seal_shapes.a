const plain = { value: 1 };
console.log(String(Object.isExtensible(plain)));
console.log(String(Object.isSealed(plain)));
console.log(String(Object.isFrozen(plain)));
console.log(String(Object.preventExtensions(plain) === plain));
console.log(String(Object.isExtensible(plain)));
console.log(String(Object.isSealed(plain)));
console.log(String(Object.isFrozen(plain)));
Object.seal(plain);
plain.value = 2;
console.log(String(plain.value));
console.log(String(Object.isSealed(plain)));
console.log(String(Object.isFrozen(plain)));
Object.freeze(plain);
console.log(String(Object.isSealed(plain)));
console.log(String(Object.isFrozen(plain)));
console.log(String(Object.isFrozen(Object.seal(new Object()))));
const date = new Date(0);
const alias = date;
console.log(String(Object.isExtensible(date)));
console.log(String(Object.isSealed(date)));
console.log(String(Object.isFrozen(date)));
console.log(String(Object.preventExtensions(alias) === date));
console.log(String(date.getTime()));
console.log(String(Object.isExtensible(date)));
console.log(String(Object.isSealed(date)));
console.log(String(Object.isFrozen(date)));
console.log(String(Object.freeze(date) === date));
console.log(String(Object.seal(date) === date));
console.log(String(Object.freeze(null) === null));
console.log(String(Object.seal(1)));
console.log(String(Object.preventExtensions(false)));
