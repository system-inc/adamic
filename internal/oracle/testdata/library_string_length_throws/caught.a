// Each way of making a string past V8's longest (536,870,888 UTF-16 units) throws Node's RangeError,
// "Invalid string length", and a catch takes it: its name and its message are two fields, printed
// apart. half is 2^28 units, so half joined to itself is 24 units over and is refused before it's
// built; repeat and pad are refused before anything is. Each operation is the last one in its
// statement that tests the pending word, so dropping its own test changes what's printed, and the
// step written before it is a string made at run time, let go on the way to the catch, so the leak
// check holds it.
const half = 'ab'.repeat(2 ** 27);
console.log(String(half.length));
let step = 0;

function report(label: string, text: string): void {
	console.log(label);
	console.log(String(text.length));
}

step = step + 1;
try {
	report(String(step), half + half);
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

step = step + 1;
try {
	report(String(step), `${half}${half}`);
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

step = step + 1;
try {
	report(String(step), [half, half].join(''));
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

step = step + 1;
try {
	report(String(step), 'ab'.repeat(268435456));
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

step = step + 1;
try {
	report(String(step), 'a'.padStart(536870889, 'xy'));
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

step = step + 1;
try {
	report(String(step), 'a'.padEnd(Infinity, 'xy'));
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

step = step + 1;
try {
	report(String(step), 'aa'.replaceAll('a', half));
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

// One FDFA above the largest repeat whose eighteen-unit compatibility expansion fits: refused once
// it's measured, before the result is allocated.
step = step + 1;
try {
	report(String(step), 'ﷺ'.repeat(29826161).normalize('NFKD'));
} catch (error) {
	if (error instanceof Error) {
		console.log(error.name);
		console.log(error.message);
	}
}

// text = text + more throws before text is written, so text holds what it held.
function grown(): number {
	let text = half;
	try {
		text = text + half;
	} catch (error) {
		if (error instanceof Error) {
			console.log(error.name);
			console.log(error.message);
		}
	}
	return text.length;
}
console.log(String(grown()));
console.log('done');
