function afterPattern({ value }: { readonly value: number }, next = value + 1): string {
    return `${value}/${next}`;
}
console.log(afterPattern({ value: 3 }));
console.log(afterPattern({ value: 3 }, 20));
function beforePattern(value = 2, { suffix }: { readonly suffix: string }): string {
    return `${value}/${suffix}`;
}
console.log(beforePattern(undefined, { suffix: 'tail' }));
const shared = { value: 4 };
function mutate(): number {
    shared.value = 9;
    return 8;
}
function ordered(first = mutate(), { value }: { readonly value: number }, last = first + value): string {
    return `${first}/${value}/${last}`;
}
console.log(ordered(undefined, shared));
shared.value = 4;
console.log(ordered(2, shared, 30));
function tuple([first, second]: readonly [number, number], last = first + second): string {
    return `${first}/${second}/${last}`;
}
console.log(tuple([5, 6]));
const arrow = ({ value }: { readonly value: number }, next = value + 2): string => `${value}/${next}`;
console.log(arrow({ value: 10 }));
console.log(arrow({ value: 10 }, 40));
