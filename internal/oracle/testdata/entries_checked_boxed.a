function show(view: {readonly visible: number}): void {
 console.log(Object.values(view).join(','));
 for (const [key, value] of Object.entries(view)) console.log(`${key}:${value}`);
}
const source: {visible: number; hidden: number | string} = {visible: 1, hidden: 2};
show(source);

enum OpenKind {First = 1, Last = 2}
function kind(value: number): OpenKind {return value;}
function enumEntries(view: {readonly kind: OpenKind}): void {
 console.log(Object.values(view).join(','));
 for (const [key, value] of Object.entries(view)) console.log(`${key}:${value}`);
}
const enumSource = {kind: kind(37), extra: 12.5};
enumEntries(enumSource);
