/* eslint-disable no-useless-call -- This program tests delayed call and literal apply adapters. */
const text = String;
const number = Number;
console.log(`${text.call(undefined, null)}|${text.apply(null, [undefined])}|${text(false)}`);
console.log(`${number('0x10')} ${number.call(null, true)} ${number.apply(undefined, [null])} ${number(undefined)}`);
function show(value: string | number | boolean): void {
    console.log(`${value}`);
}
show(text(42));
show(number('12.5'));
