function show(values: Uint16Array): void {
    let result = "";
    for (const value of values) {
        result = result + value.toString() + ",";
    }
    console.log(result);
}
const source: number[] = [65535, 65536, 65537, -1, -65537, 3.9, -3.9, NaN, Infinity, -Infinity, 4294967297, 9007199254740991];
const converted = new Uint16Array(source);
show(converted);
converted[0] = -2.9;
converted[1] = 65538.9;
converted[2] = Infinity;
show(converted);
converted.fill(-65539.9, 3, 6);
show(converted);
const view = converted.subarray(1, 5);
view[0] = 65540;
view.fill(65541, -2);
converted.set(converted.subarray(0, 4), 2);
show(converted);
show(view);
console.log((converted[99] ?? -99).toString());
function escapedView(): Uint16Array {
    const owner = new Uint16Array([65537, -1, 65538]);
    return owner.subarray(1);
}
const escaped = escapedView();
escaped[1] = -2;
show(escaped);
const empty = new Uint16Array();
const truncated = new Uint16Array(3.9);
const negativeFraction = new Uint16Array(-0.5);
console.log(`${empty.length} ${truncated.length} ${negativeFraction.length}`);
show(truncated);
let evaluations = 0;
function length(): number {
    evaluations++;
    console.log(`length ${evaluations}`);
    return 2;
}
const allocated = new Uint16Array(length());
function value(): number {
    evaluations++;
    console.log(`value ${evaluations}`);
    return 65542;
}
allocated[1] = value();
show(allocated);
