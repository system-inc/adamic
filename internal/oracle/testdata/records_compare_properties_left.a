// core.ts:2143 a[key] is passed directly to the generic comparer.
function observe(left: number | undefined, right: number | undefined): void {
    console.log(String(left)); console.log(String(right));
}
const left: Record<string, number> = {};
const right: Record<string, number> = { ['toString']: 1 };
const key: string = 'toString';
console.log('before comparer');
observe(left[key], right[key]);
