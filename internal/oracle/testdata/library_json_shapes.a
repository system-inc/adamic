const maybeMixed: (string | undefined)[] = ["b", undefined];
console.log(JSON.stringify(maybeMixed) ?? 'u');
const functions: (() => number)[] = [() => 1, () => 2];
console.log(JSON.stringify(functions) ?? 'u');
const maps: Map<string, number>[] = [new Map<string, number>([['a', 1]]), new Map<string, number>()];
console.log(JSON.stringify(maps) ?? 'u');
function choose(n: number): string | Map<string, number> | (() => number) { return n === 0 ? 's'.repeat(3) : n === 1 ? new Map<string, number>() : () => n; }
for (let n = 0; n < 3; n += 1) {
 console.log(JSON.stringify(choose(n)) ?? 'u');
 console.log(JSON.stringify([choose(n)]) ?? 'u');
 console.log(JSON.stringify({ k: choose(n), z: 1 }) ?? 'u');
}
function space(n: number): string | number | undefined { return n === 0 ? '\t'.repeat(2) : n === 1 ? 3 : undefined; }
for (let n = 0; n < 3; n += 1) { console.log(JSON.stringify({ a: [1] }, null, space(n)) ?? 'u'); }
function maybeSpace(n: number): number | undefined { return n === 0 ? 0.5 : n === 1 ? 12 : undefined; }
for (let n = 0; n < 3; n += 1) { console.log(JSON.stringify({ a: [1] }, null, maybeSpace(n)) ?? 'u'); }
console.log(JSON.stringify({ a: [1] }, null, true) ?? 'u');
function keyList(n: number): string[] | undefined { return n === 0 ? ["b", "1"] : n === 1 ? ["zz"].slice(1) : undefined; }
for (let n = 0; n < 3; n += 1) { console.log(JSON.stringify({ a: 1, b: 2, '1': 3 }, keyList(n)) ?? 'u'); }
const maybeKeys: (string | undefined)[] = [undefined, 'a'];
console.log(JSON.stringify({ a: 1, b: 2 }, maybeKeys) ?? 'u');
const boolKeys: boolean[] = [true];
console.log(JSON.stringify({ a: 1, true: 2 }, boolKeys) ?? 'u');
const numberKeys: number[] = [1e21, 0.1, -0, NaN];
console.log(JSON.stringify({ '1e+21': 1, '0.1': 2, '0': 3, NaN: 4, x: 5 }, numberKeys) ?? 'u');
const nested: number[][][] = [[[1], []], []];
console.log(JSON.stringify(nested, null, 1) ?? 'u');
const maybeArrays: (number[] | undefined)[] = [undefined, [1]];
console.log(JSON.stringify(maybeArrays) ?? 'u');
console.log(JSON.stringify({ a: maybeArrays, b: undefined }, null, ' ') ?? 'u');
