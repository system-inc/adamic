// Updates preserve position; deletion and reinsertion append, including 4 -> 5 -> 4.
const map = new Map<string, string>();
for (let index = 0; index < 4; index++) { map.set(`${index}`.repeat(2), `v${index}`.repeat(2)); }
console.log(`four ${[...map.keys()].join(',')} ${[...map.values()].join(',')}`);
map.set('11'.repeat(1), 'update'.repeat(2));
map.set('44'.repeat(1), 'v4'.repeat(2));
console.log(`five ${[...map.keys()].join(',')} ${[...map.values()].join(',')}`);
map.delete('11');
console.log(`four back ${[...map.keys()].join(',')}`);
map.set('11'.repeat(1), 'reinsert'.repeat(2));
console.log(`five again ${[...map.keys()].join(',')}`);
map.delete('00'); map.delete('22');
console.log(`three ${[...map.keys()].join(',')} ${[...map.values()].join(',')}`);
map.clear();
map.set('new'.repeat(2), 'value'.repeat(2));
console.log(`clear ${map.size} ${[...map.keys()].join(',')}`);
const set = new Set<string>(['aa'.repeat(2), 'bb'.repeat(2), 'cc'.repeat(2), 'dd'.repeat(2)]);
set.delete('bbbb'); set.add('bb'.repeat(2));
console.log(`set four ${[...set].join(',')}`);
set.add('ee'.repeat(2)); set.delete('aaaa'); set.add('aa'.repeat(2));
console.log(`set five ${[...set].join(',')}`);
set.delete('cccc');
console.log(`set four back ${[...set].join(',')}`);
const first = { name: 'first'.repeat(2) };
const equal = { name: 'first'.repeat(2) };
const second = { name: 'second'.repeat(2) };
const third = { name: 'third'.repeat(2) };
const fourth = { name: 'fourth'.repeat(2) };
const objects = new Map([[first, 1], [second, 2], [third, 3], [fourth, 4]]);
console.log(`identity ${objects.has(first)} ${objects.has(equal)}`);
objects.set(equal, 5); objects.delete(second);
for (const [key, value] of objects) { console.log(`object ${key.name} ${value}`); }
