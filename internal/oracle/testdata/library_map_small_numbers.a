// SameValueZero on both sides of promotion and return to inline storage.
const map = new Map<number, string>();
console.log(`empty ${map.size} ${map.has(NaN)} ${map.get(-0)}`);
map.set(NaN, 'nan'.repeat(2));
map.set(NaN, 'again'.repeat(2));
map.set(-0, 'zero'.repeat(2));
map.set(+0, 'updated'.repeat(2));
console.log(`small ${map.size} ${map.get(NaN)} ${map.get(-0)} ${map.has(+0)}`);
for (const key of map.keys()) { console.log(`small key ${key} reciprocal ${1 / key}`); }
map.set(1, 'one'); map.set(2, 'two'); map.set(3, 'three');
console.log(`promoted ${map.size} ${map.get(NaN)} ${map.get(+0)}`);
map.delete(1); map.delete(2); map.delete(3);
map.set(NaN, 'last'.repeat(2));
console.log(`back ${map.size} ${map.get(NaN)} ${[...map.keys()].join(',')}`);
const set = new Set<number>([NaN, NaN, -0, +0]);
console.log(`set small ${set.size} ${set.has(NaN)} ${set.has(-0)}`);
set.add(1); set.add(2); set.add(3); set.delete(1); set.delete(2);
console.log(`set back ${set.size} ${[...set].join(',')}`);
for (const key of set) { console.log(`set key ${key} reciprocal ${1 / key}`); }
const optional = new Map<number | undefined, string>([[undefined, 'missing'], [NaN, 'nan'], [-0, 'zero'], [1, 'one']]);
optional.set(NaN, 'again'); optional.set(+0, 'updated');
console.log(`optional ${optional.size} ${optional.get(undefined)} ${optional.get(NaN)} ${optional.get(-0)}`);
optional.set(2, 'two'); optional.delete(1); optional.delete(2);
console.log(`optional back ${optional.size} ${optional.get(undefined)} ${optional.get(NaN)}`);
