const array = [1, 2, 3];
console.log(Object.keys(array).join(','));
console.log(Object.getOwnPropertyNames(array).join(','));
console.log(Object.keys(['a', 'b']).join(','));
console.log(Object.getOwnPropertyNames([true]).join(','));
try { Object.getOwnPropertyNames(undefined); } catch (error) { if (error instanceof Error) console.log(`${error.name}: ${error.message}`); }
try { Object.getOwnPropertyNames(null); } catch (error) { if (error instanceof Error) console.log(`${error.name}: ${error.message}`); }
