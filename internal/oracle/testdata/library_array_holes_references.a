function text(index: number): string { return `value${index}`; }
const words = new Array<string>(4);
words[1] = text(1);
words[1] = text(2);
words[5] = text(5);
words[-1] = text(-1);
words[0.5] = text(50);
words[NaN] = text(99);
console.log(`${words.length}:${words[0] === undefined}:${words[1]}:${words[4] === undefined}:${words[5]}`);
console.log(`${words[-1]}:${words[0.5]}:${words[NaN]}`);
const contextual: string[] = new Array(2);
contextual[1] = text(10);
console.log(`${contextual[0] === undefined}:${contextual[1]}`);
const optional = new Array<number | undefined>(3);
optional[1] = undefined;
optional[2] = 10;
console.log(`${optional[0] === undefined}:${optional[1] === undefined}:${optional[2]}`);
