interface Root { child: { text: string }; }
function inspect(n: number): void {
 const root: Root = { child: { text: `finally${n}` } };
 const child = root.child;
 try { throw new Error(root.child.text); }
 catch (error) { if (error instanceof Error) { console.log(error.message); } }
 finally { root.child = { text: `changed${n}` }; }
 console.log(child.text);
}
function leave(n: number): void {
 const root: Root = { child: { text: `throw${n}` } };
 const child = root.child;
 throw new Error(child.text);
}
inspect(1);
try { leave(2); } catch (error) { if (error instanceof Error) { console.log(error.message); } }
