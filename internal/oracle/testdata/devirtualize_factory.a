class Base { run(): string { return 'base'; } }
class Child extends Base { override run(): string { return 'child'; } }
class Maker { make(): Base { return new Base(); } }
class LaterMaker extends Maker { override make(): Base { return new Child(); } }
function through(value: Maker): string { return value.make().run(); }
console.log(through(new Maker()));
console.log(through(new LaterMaker()));
console.log(new LaterMaker().make().run());
class StaticMaker { static make(): Base { console.log('static-factory'); return new Child(); } }
console.log(StaticMaker.make().run());
