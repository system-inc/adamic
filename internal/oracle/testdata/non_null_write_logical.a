console.log(`${calls} ${value}`);
value! ||= right();
value! ||= right();
value! ??= right();
console.log(`${calls} ${value}`);
value! = 0;
value! &&= right();
console.log(`${calls} ${value}`);
value! ||= right();
value! &&= right();
