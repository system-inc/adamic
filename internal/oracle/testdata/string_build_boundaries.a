// Sweep slice and substring across ASCII, two-byte, three-byte and four-byte boundaries.
function units(text: string): string {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(text.charCodeAt(index));
	}
	return `${text.length}:${codes.join(',')}`;
}
const text = ['a', 'é', '世', '🌍', '\ud800', 'x', '\udfff', 'z'].join('');
for (let start = -1; start <= text.length + 1; start++) {
	for (let end = -1; end <= text.length + 1; end++) {
		console.log(`${start}/${end} ${units(text.slice(start, end))} ${units(text.substring(start, end))}`);
	}
}
console.log(`${units(text.slice())} ${units(text.slice(3))} ${units(text.substring(3))}`);
// Copy versus sharing at 64 bytes, and a small fraction of a large owner.
for (const word of ['a', 'é', '世', '🌍', '\ud800']) {
	const parent = word.repeat(300);
	for (const length of [1, 63, 64, 65, 74, 75, 76, 150]) {
		const part = parent.slice(1, length + 1);
		console.log(`${units(part)} ${units(part.substring(1, part.length - 1))}`);
	}
}
