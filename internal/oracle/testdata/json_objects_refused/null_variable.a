// A field held as a bare pointer that admits null: a variable set to null writes a null pointer whose byte
// says Object, so native couldn't tell null from undefined there. Refused until #ckxcnr6 records which.
class Link {
	readonly target: { readonly v: number } | null;
	constructor(target: { readonly v: number } | null) {
		this.target = target;
	}
}
console.log(JSON.stringify(new Link({ v: 1 })) ?? '<undefined>');
console.log(JSON.stringify(new Link(null)) ?? '<undefined>');
