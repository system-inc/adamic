interface Leaf { readonly text: string; }
class Root {
 child: { leaf: Leaf };
 constructor(n: number) { this.child = { leaf: { text: `method${n}` } }; }
 replace(n: number): void { this.child.leaf = { text: `new${n}` }; }
}
function inspect(root: Root): void {
 const leaf = root.child.leaf;
 root.replace(2);
 console.log(`${leaf.text} ${root.child.leaf.text}`);
}
inspect(new Root(1));
