// scanner.ts:4050-4060: UTF-16 fallback body, without the debug assertion.
function encode(codePoint: number): string {
    if (codePoint <= 65535) return String.fromCharCode(codePoint);
    const codeUnit1 = Math.floor((codePoint - 65536) / 1024) + 0xD800;
    const codeUnit2 = ((codePoint - 65536) % 1024) + 0xDC00;
    return String.fromCharCode(codeUnit1, codeUnit2);
}
for (const codePoint of [65, 0xD800, 0x10000, 0x1F30D, 0x10FFFF]) console.log(encode(codePoint));
// transformers/generators.ts:2969: label text conversion.
for (const labelNumber of [0, 1, 1e21]) console.log(String(labelNumber));
