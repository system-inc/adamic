const numbers: Record<string, number | undefined> = {empty: undefined, nan: NaN};
numbers['x'] = 2;
console.log(String(numbers['x'] + 1));
console.log(String(numbers['absent']));
console.log(String('empty' in numbers));
console.log(Object.values(numbers).map(n => String(n)).join(','));
console.log(String(JSON.stringify(numbers)));
const booleans: Record<string, boolean> = {yes: true, no: false};
console.log(String(booleans['missing']));
console.log(Object.values(booleans).map(b => String(b)).join(','));
console.log(String(JSON.stringify(booleans)));
