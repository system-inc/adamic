function make(): () => number {
 let saved: (() => number) | undefined = undefined;
 let depth = 0;
 function read(): number { depth++; return saved === undefined || depth > 3 ? depth : saved(); }
 function factory(): () => number { return () => read(); }
 saved = factory();
 return saved;
}
for (let round = 0; round < 3; round++) { console.log(String(make()())); }
