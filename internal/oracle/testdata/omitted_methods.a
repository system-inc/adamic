interface Reader { read(s: string, n?: number, b?: boolean, text?: string, obj?: {x: number}): void; }
class R implements Reader {
 read(s: string, n?: number, b?: boolean, text?: string, obj?: {x: number}): void {
 console.log(`${s}:${n === undefined}:${b === undefined}:${text === undefined}:${obj === undefined}`);
 }
}
const r = new R();
r.read('class');
const reader: Reader = r;
reader.read('interface');
function invoke(target: Reader): void { target.read('dynamic'); }
invoke(r);
const method = (s: string): void => r.read(s);
method('method-value');
reader.read('present', 0, false, '', {x: 0});
