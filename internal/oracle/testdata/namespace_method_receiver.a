namespace Debug {
    export const flags = 99;
    export function attachFlowNodeDebugInfoWorker() {
        return {
            flags: 7,
            value(this: { flags: number }): number { return this.flags; },
        };
    }
}
const node = Debug.attachFlowNodeDebugInfoWorker();
console.log(`${node.value()}:${Debug.flags}`);
node.flags = 11;
console.log(`${node.value()}`);
