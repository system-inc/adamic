function observe(cells: number[]): void {
 console.log(cells.splice(1, 2, 9).join("|"));
}
function make(mode: number): number[] {
 const cells = new Array<number>(5);
 if (mode >= 0) { cells[mode] = 10 + mode; }
 if (mode === 1) { cells[3] = 13; }
 return cells;
}
observe(make(-1));
observe(make(0));
observe(make(1));
observe(make(2));
observe(make(4));
