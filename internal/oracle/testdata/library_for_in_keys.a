const bag = {
	z: 'z',
	'20': 'twenty',
	'3': 'three',
	'100': 'hundred',
	'0': 'zero',
	'00': 'double',
	'01': 'octal',
	'1e2': 'exp',
	'+2': 'plus',
	'-1': 'minus',
	'2.0': 'float',
	'08': 'eight',
	'4294967295': 'max',
	'4294967294': 'almost',
	'': 'empty',
	'9': 'nine',
	'10': 'ten',
	a: 'a',
	' 1': 'space',
	'1 ': 'trail',
	'999999999999999999999': 'big',
};
const keys: string[] = [];
for (const key in bag) {
	keys.push(key);
}
console.log(keys.join('|'));

const first = { a: 1 };
const second = { a: 2, extra: 3, '5': 5, b: 4, '10': 10, z: 6 };
let view: { readonly a: number } = first;
view = second;
const later: string[] = [];
for (const key in view) {
	later.push(key);
}
console.log(later.join('|'));
console.log(`${view.a}`);
