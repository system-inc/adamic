// The receiver's alternatives hold left two ways, a number in Packed and a packed number | undefined in
// Loose, so no one store writes it in both: the key proof the read shares stops it.
interface Packed { left: number; right: number; }
interface Loose { left: number | undefined; right: number; }
function set(target: Packed | Loose, side: 'left' | 'right', value: number): void {
	target[side] = value;
}
const packed: Packed = { left: 1, right: 2 };
set(packed, 'left', 3);
console.log(`${packed.left} ${packed.right}`);
