function show(r: Record<string, number> | undefined): void {
 console.log(String(JSON.stringify(r)));
 if(r !== undefined) console.log(String(r['x']));
}
show(undefined);
show({x: 1});
const nested: Record<string, Record<string, number> | undefined> = {
 missing: undefined,
 live: {x: 2}
};
console.log(String(JSON.stringify(nested)));
