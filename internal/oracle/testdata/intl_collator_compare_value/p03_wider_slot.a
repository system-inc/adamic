// compare read into a slot wider than its own stays the method value refusal (#9tw2b9z): the closure
// answers an unboxed number, which a slot answering unknown would read boxed. tsc rejects
// (x: unknown, y: unknown) => unknown for it, so the wider slot is the one tsc accepts. Node prints
// function.
const collator = new Intl.Collator(undefined, { usage: 'sort', sensitivity: 'variant', numeric: true });
const wide: (x: string, y: string) => unknown = collator.compare;
console.log(typeof wide);
