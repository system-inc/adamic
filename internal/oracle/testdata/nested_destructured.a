function make(start: number): () => string {
 function next(): string { count += 1; label = label + '!'; return `${label}:${count}`; }
 const { name: initial } = { name: `item${start}` };
 let [count, label]: [number, string] = [start, initial];
 return next;
}
const next = make(3);
console.log(`${next()} ${next()}`);
