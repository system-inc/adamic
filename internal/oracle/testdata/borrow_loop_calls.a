// Loops over a local or a parameter array whose body calls something that could free that array.
// Labels are built at runtime: a literal string is immortal and cannot show a use after free.
interface Item {
	readonly label: string;
}

function make(count: number): Item[] {
	const items: Item[] = [];
	for (let index = 0; index < count; index++) {
		items.push({ label: `item${index}` });
	}
	return items;
}

function lengthOf(items: Item[]): number {
	return items.length;
}

function forwardLength(items: Item[]): number {
	return lengthOf(items);
}

function remove(items: Item[]): void {
	items.pop();
}

function removeDeep(items: Item[]): void {
	remove(items);
}

function grow(items: Item[]): void {
	items.push({ label: `grown${items.length}` });
}

function replaceAt(items: Item[], index: number): void {
	items[index] = { label: `replaced${items.length}` };
}

function consume(items: Item[]): number {
	const copy = [...items, { label: "tail" }];
	return copy.length;
}

function mapped(items: Item[]): string {
	return items.map((item) => item.label).join(",");
}

function readLocal(): void {
	const items = make(2);
	for (const item of items) {
		console.log(`read-local:${item.label}:${lengthOf(items)}`);
	}
}

function readParameter(items: Item[]): void {
	for (const item of items) {
		console.log(`read-parameter:${item.label}:${forwardLength(items)}`);
	}
}

function pushLocal(): void {
	const items = make(1);
	for (const item of items) {
		grow(items);
		console.log(`push:${item.label}`);
		break;
	}
	console.log(`push-length:${items.length}`);
}

function popLocal(): void {
	const items = make(1);
	for (const item of items) {
		remove(items);
		console.log(`pop-local:${item.label}`);
	}
}

function popParameter(items: Item[]): void {
	for (const item of items) {
		removeDeep(items);
		console.log(`pop-parameter:${item.label}`);
	}
}

// The popped array is the other parameter. The two arguments are one array at the call.
function popAlias(items: Item[], alias: Item[]): void {
	for (const item of items) {
		remove(alias);
		console.log(`pop-alias:${item.label}`);
	}
}

function popInBranch(items: Item[]): void {
	for (const item of items) {
		if (items.length > 0) {
			remove(items);
		}
		console.log(`pop-branch:${item.label}`);
	}
}

function popInTry(items: Item[]): void {
	for (const item of items) {
		try {
			remove(items);
		} catch (error) {
			if (error instanceof Error) {
				console.log(`pop-try-error:${error.message}`);
			}
		}
		console.log(`pop-try:${item.label}`);
	}
}

function spreadLocal(): void {
	const items = make(2);
	for (const item of items) {
		console.log(`spread-local:${item.label}:${consume(items)}`);
	}
	console.log(`spread-local-length:${items.length}`);
}

function spreadParameter(items: Item[]): void {
	for (const item of items) {
		console.log(`spread-parameter:${item.label}:${consume(items)}`);
	}
	console.log(`spread-parameter-length:${items.length}`);
}

function mapLocal(): void {
	const items = make(2);
	for (const item of items) {
		console.log(`map:${item.label}:${mapped(items)}`);
	}
	console.log(`map-length:${items.length}`);
}

function replaceLocal(): void {
	const items = make(1);
	for (const item of items) {
		replaceAt(items, 0);
		console.log(`replace:${item.label}`);
	}
}

function earlyReturn(items: Item[]): void {
	for (const item of items) {
		remove(items);
		console.log(`return:${item.label}`);
		return;
	}
	console.log("return-after");
}

function breakAfterPop(): void {
	const items = make(2);
	for (const item of items) {
		remove(items);
		console.log(`break:${item.label}`);
		break;
	}
	console.log(`break-length:${items.length}`);
}

function continueAfterRead(): void {
	const items = make(2);
	for (const item of items) {
		console.log(`continue:${lengthOf(items)}`);
		continue;
	}
}

function throwAfterRead(): void {
	const items = make(1);
	try {
		for (const item of items) {
			console.log(`throw-read:${lengthOf(items)}`);
			throw new Error(`stop:${item.label}`);
		}
	} catch (error) {
		if (error instanceof Error) {
			console.log(error.message);
		}
	}
	console.log(`throw-read-after:${items[0]?.label ?? "missing"}`);
}

function throwAfterPop(): void {
	const items = make(1);
	try {
		for (const item of items) {
			remove(items);
			throw new Error(`popped:${item.label}`);
		}
	} catch (error) {
		if (error instanceof Error) {
			console.log(error.message);
		}
	}
	console.log(`throw-pop-length:${items.length}`);
}

function sameStatement(): void {
	const items = make(1);
	for (const item of items) {
		console.log(`same:${removeAndCount(items)}:${item.label}`);
	}
}

function removeAndCount(items: Item[]): number {
	const count = items.length;
	items.pop();
	return count;
}

let quietItems = make(2);
let ownedItems = make(2);
let lentItems = make(2);
let stash: Item[] = [];

function resetOwned(): void {
	ownedItems = make(0);
}

function resetLent(): void {
	lentItems = make(0);
}

function reportQuiet(values: Item[]): void {
	for (const item of values) {
		console.log(`quiet:${item.label}`);
	}
}

// The local keeps its own count of the global's array. The call replaces the global.
function scanCopy(): void {
	const values = ownedItems;
	for (const item of values) {
		resetOwned();
		console.log(`copy:${item.label}`);
	}
}

// The parameter is borrowed. Only the caller's hold on lentItems keeps the array alive,
// and the loop calls the function that replaces that global.
function scanLent(values: Item[]): void {
	for (const item of values) {
		resetLent();
		console.log(`lent:${item.label}`);
	}
}

function remember(items: Item[]): void {
	stash = items;
}

function forget(): void {
	stash.pop();
}

function stashThenPop(): void {
	const items = make(1);
	remember(items);
	for (const item of items) {
		forget();
		console.log(`stash:${item.label}`);
	}
}

class Box {
	items: Item[] = [];

	constructor(items: Item[]) {
		this.items = items;
	}
}

function wipe(box: Box): void {
	box.items = make(0);
}

function fieldLocal(box: Box): void {
	const items = box.items;
	for (const item of items) {
		wipe(box);
		console.log(`field-local:${item.label}:${items.length}`);
	}
}

function fieldDirect(box: Box): void {
	for (const item of box.items) {
		wipe(box);
		console.log(`field-direct:${item.label}`);
	}
}

class Reader {
	read(items: Item[]): number {
		return items.length;
	}
}

class Eater extends Reader {
	override read(items: Item[]): number {
		const copy = [...items, { label: "x" }];
		return copy.length;
	}
}

function concreteReader(): void {
	const items = make(2);
	const reader = new Reader();
	for (const item of items) {
		console.log(`concrete:${item.label}:${reader.read(items)}`);
	}
	console.log(`concrete-length:${items.length}`);
}

function virtualEater(reader: Reader): void {
	const items = make(1);
	for (const item of items) {
		console.log(`virtual:${item.label}:${reader.read(items)}`);
	}
	console.log(`virtual-length:${items.length}`);
}

readLocal();
readParameter(make(2));
pushLocal();
popLocal();
popParameter(make(1));
const aliased = make(1);
popAlias(aliased, aliased);
popInBranch(make(1));
popInTry(make(1));
spreadLocal();
spreadParameter(make(2));
mapLocal();
replaceLocal();
earlyReturn(make(1));
breakAfterPop();
continueAfterRead();
throwAfterRead();
throwAfterPop();
sameStatement();
reportQuiet(quietItems);
scanCopy();
console.log(`copy-length:${ownedItems.length}`);
scanLent(lentItems);
console.log(`lent-length:${lentItems.length}`);
stashThenPop();
fieldLocal(new Box(make(2)));
fieldDirect(new Box(make(1)));
concreteReader();
virtualEater(new Reader());
virtualEater(new Eater());
