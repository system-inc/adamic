function present(value: Date): void { console.log(String(value)); console.log(`${value}`); console.log('' + value); console.log(value.toString()); }
function optional(value: Date | undefined): void { console.log(String(value)); console.log(`${value}`); console.log('' + value); }
function nullable(value: Date | null): void { console.log(String(value)); console.log(`${value}`); console.log('' + value); }
