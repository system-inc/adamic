function forEachTrailingCommentRange<U>(text: string, pos: number, callback: (pos: number, end: number, kind: number, newline: boolean) => U): U | undefined;
// The absent state is not observed by a callback with four parameters.
function forEachTrailingCommentRange<T, U>(text: string, pos: number, callback: (pos: number, end: number, kind: number, newline: boolean) => U): U | undefined {
    return text.length === 0 ? undefined : callback(pos, text.length, 2, false);
}
console.log(forEachTrailingCommentRange('comment', 2, (pos, end, kind, newline) => `${pos}:${end}:${kind}:${newline}`) ?? 'missing');
console.log(forEachTrailingCommentRange('', 0, (pos) => `${pos}`) ?? 'missing');
