const numbers = new Set<number>();
console.log(`${numbers.has(NaN)}`);
numbers.add(NaN);
numbers.add(NaN);
numbers.add(-0);
numbers.add(+0);
console.log(`${numbers.has(NaN)}`);
console.log(`${numbers.has(+0)}`);
console.log(`${numbers.size}`);
console.log(`${numbers.delete(-0)}`);
console.log(`${numbers.has(+0)}`);
numbers.clear();
console.log(`${numbers.size}`);
const words = new Set<string>();
words.add('present');
console.log(`${words.has('present')}`);
console.log(`${words.has('absent')}`);
const flags = new Set<boolean>();
flags.add(false);
console.log(`${flags.has(false)}`);
console.log(`${flags.has(true)}`);
