let target: Int32Array = new Int32Array([1]);
function show(value: Int32Array): string { return `${value[0]}`; }
const assigned = (target = new Int32Array([7]));
console.log(show(assigned));
console.log(show(target));

const saved = (target = new Int32Array([7]));
target = new Int32Array([1]);
console.log(show(saved));
