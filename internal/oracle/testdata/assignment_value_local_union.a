let target: number | string = 1;
function show(value: number | string): string { return `${value}:${typeof value}`; }
const assigned = (target = ['new', 'built'].join('/'));
console.log(show(assigned));
console.log(show(target));

const saved = (target = ['new', 'built'].join('/'));
target = 1;
console.log(show(saved));
