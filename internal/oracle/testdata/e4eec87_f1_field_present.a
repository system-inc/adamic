interface Box { value: number | undefined; }
function keep(box: Box): void { box.value = 5; }
const box: Box = { value: 2 };
if (box.value !== undefined) {
 console.log(`${box.value * 2}`);
 keep(box);
 console.log(`${box.value}`);
 const alias = box;
 alias.value = undefined;
 console.log(`${(box.value) === undefined}`);
}
