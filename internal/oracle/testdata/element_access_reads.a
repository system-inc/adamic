type Key = 'left' | 'right';
function numberField(value: { readonly left?: number; readonly right?: number }, key: Key): number | undefined { return value[key]; }
function referenceField(value: { readonly left?: { readonly label: string }; readonly right?: { readonly label: string } }, key: Key): { readonly label: string } | undefined { return value[key]; }
function mixedField(value: { readonly left: number; readonly right: string }, key: Key): number | string { return value[key]; }
console.log(`${numberField({}, 'left') ?? -1} ${numberField({ right: 7 }, 'left') ?? -1} ${numberField({ right: 7 }, 'right') ?? -1}`);
console.log(`${referenceField({}, 'right')?.label ?? 'missing'} ${referenceField({ right: { label: ['built', 'value'].join('-') } }, 'right')?.label ?? 'missing'}`);
console.log(`${mixedField({ left: 3, right: 'text' }, 'left')} ${mixedField({ left: 3, right: 'text' }, 'right')}`);
enum Interval { Low = 250, Medium = 500, High = 2000 }
function numericField(value: { readonly 250: number; readonly 500: number; readonly 2000: number }, key: Interval): number { return value[key]; }
for (const key of [Interval.Low, Interval.Medium, Interval.High]) { console.log(`${numericField({ "250": 1, "500": 2, "2000": 3 }, key)}`); }
let current = { left: 10, right: 20 };
let receiverCalls = 0;
function receiver(): { left: number; right: number } { receiverCalls += 1; console.log('receiver'); return current; }
function key(): Key { console.log('key'); current = { left: 100, right: 200 }; return 'right'; }
console.log(`${receiver()[key()]} ${receiverCalls} ${current.right}`);

// A getter elsewhere does not make these required data fields into accessors.
class Carrier { get yieldType(): number { return 123; } }
function dispatch(value: { readonly yieldType: number; readonly returnType: number }, key: 'yieldType' | 'returnType'): number { return value[key]; }
function inheritedGetter(value: { readonly yieldType: number }, key: 'yieldType'): number { return value[key]; }
console.log(`${dispatch({ yieldType: 1, returnType: 2 }, 'yieldType')} ${dispatch({ yieldType: 1, returnType: 2 }, 'returnType')} ${inheritedGetter(new Carrier(), 'yieldType')}`);
