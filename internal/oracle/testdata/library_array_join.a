const grid: number[][] = [[1, 2], [], [3, NaN, -0]];
console.log(grid.join('|'));
console.log(grid.join());
console.log(grid.join(undefined));
const deep: number[][][] = [[[1], [2]], [], [[3, 4]]];
console.log(deep.join(' / '));
const noNumbers: (number | undefined)[] = [];
const optional: ((number | undefined)[] | undefined)[] = [[undefined, 2], undefined, noNumbers, [3, undefined]];
console.log(optional.join('|'));
const words: (string | undefined)[][] = [['a' + 'b', undefined], [], ['c' + 'd', '']];
console.log(words.join('\0'));
const empty: number[] = [];
console.log(`${empty.join('🌍')} ${[NaN, Infinity, -Infinity, -0].join('|')}`);
const absent: (number | undefined)[] = [undefined, 1, undefined];
console.log(absent.join('::'));
const fragments: string[] = ['\uD83C', '\uDF0D'];
console.log(fragments.join(''));
console.log(fragments.join('|'));
