import { programArguments } from 'adamic';
import { openSync, writeSync, closeSync, readFileSync } from 'node:fs';
const root = programArguments()[0] ?? '';
const fd = openSync(root + '/out', 'w+');
console.log(`${writeSync(fd, 'hé🌍\uD800', undefined, 'utf8')}`);
console.log(`${writeSync(fd, 'XY', 0)}`);
writeSync(fd, '!', null, 'utf-8');
writeSync(fd, '?', 1.5);
writeSync(fd, 'n', NaN);
closeSync(fd);
console.log(readFileSync(root + '/out', 'utf8'));
