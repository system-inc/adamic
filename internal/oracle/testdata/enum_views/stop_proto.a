// __proto__ by a run-time key: Node gives Object.prototype, which no representation holds, so both
// backends stop loudly at the read, as Reflect.get's does (#ys4naww).
import * as ts from './barrel.a';
const kinds = (ts as Readonly<Record<"SyntaxKind", Readonly<Record<string, string | number>>>>).SyntaxKind;
for (const name of ["Identifier", "__proto__"]) {
	console.log(`${name} ${typeof kinds[name]}`);
}
console.log(Object.keys({ tscUsesKeys: 1 }).join(","));
