// A class getter that runs code where a run-time key read could call it: NotYet at the view's read,
// judged by its syntax there, as Reflect.get's read is.
import * as ts from './barrel.a';
let calls = 0;
class Counter {
	get count(): number {
		calls++;
		return calls;
	}
}
const counter = new Counter();
const kinds = (ts as Readonly<Record<"SyntaxKind", Readonly<Record<string, string | number>>>>).SyntaxKind;
const name = ["Identifier"].join("");
console.log(`${kinds[name]} ${counter.count}`);
console.log(Object.keys({ tscUsesKeys: 1 }).join(","));
