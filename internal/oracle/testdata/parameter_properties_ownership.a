import type { Weak } from 'adamic';
interface Label { readonly text: string; }
class Parent {
    readonly children: Child[] = [];
    constructor(readonly label: Label) {}
}
class Child {
    constructor(private readonly label: Label, readonly parent: Weak<Parent>, private readonly render: () => string) {}
    show(): string {
        const parent = this.parent;
        const name = parent === undefined ? 'missing' : parent.label.text;
        return `${this.label.text} ${name} ${this.render()}`;
    }
}
function label(value: number): Label { return {text: `label ${value}`}; }
function make(value: number): Parent {
    const parent = new Parent(label(value));
    const suffix = `suffix ${value}`;
    parent.children.push(new Child(label(value + 1), parent, () => suffix));
    return parent;
}
for (let index = 0; index < 8; index += 1) {
    const parent = make(index);
    for (const child of parent.children) { console.log(child.show()); }
}
