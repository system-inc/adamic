interface PerformanceTime { now(): number; readonly timeOrigin: number; }
interface Performance extends PerformanceTime {
    mark(name: string): void;
    measure(name: string, startMark?: string, endMark?: string): void;
    clearMeasures(name?: string): void;
    clearMarks(name?: string): void;
}
interface PerformanceHooks {
    shouldWriteNativeEvents: boolean;
    performance?: Performance | undefined;
    performanceTime?: PerformanceTime | undefined;
}
function isNodeLikeSystem(): boolean { return true; }
function tryGetPerformance() {
    if (isNodeLikeSystem()) {
        try {
            const { performance } = require('perf_hooks') as Partial<typeof import('perf_hooks')>;
            if (performance !== undefined) {
                return { shouldWriteNativeEvents: false, performance };
            }
        } catch { }
    }
    if (typeof performance === 'object') {
        return { shouldWriteNativeEvents: true, performance };
    }
    return undefined;
}
function tryGetPerformanceHooks(): PerformanceHooks | undefined {
    const p = tryGetPerformance();
    if (p === undefined) return undefined;
    const { shouldWriteNativeEvents, performance } = p;
    const hooks: PerformanceHooks = { shouldWriteNativeEvents, performance: undefined, performanceTime: undefined };
    if (typeof performance.timeOrigin === 'number' && typeof performance.now === 'function') {
        hooks.performanceTime = performance;
    }
    if (hooks.performanceTime !== undefined && typeof performance.mark === 'function' && typeof performance.measure === 'function' && typeof performance.clearMarks === 'function' && typeof performance.clearMeasures === 'function') {
        hooks.performance = performance;
    }
    return hooks;
}
const hooks = tryGetPerformanceHooks();
console.log(`hooks ${hooks !== undefined} ${hooks?.shouldWriteNativeEvents ?? true}`);
const clock = hooks?.performanceTime;
if (clock !== undefined) {
    const first = clock.now();
    console.log(`clock ${Number.isFinite(first)} ${first >= 0} ${clock.now() >= first} ${clock.timeOrigin > 946684800000}`);
}
const impl = hooks?.performance;
if (impl !== undefined) {
    impl.mark('ts-start');
    impl.mark('ts-end');
    impl.measure('ts-work', 'ts-start', 'ts-end');
    impl.measure('ts-origin');
    impl.clearMeasures('ts-work');
    impl.clearMarks('ts-start');
    impl.clearMeasures();
    impl.clearMarks();
    try { impl.measure('missing', 'absent', 'end-absent'); }
    catch (error) { if (error instanceof Error) console.log(error.name + ': ' + error.message); }
}
