interface Tagged {
	readonly id: number;
}
class Box<T> {
	readonly id: number;
	v: T | undefined;
	constructor(v: T) {
		this.id = 1;
		this.v = v;
	}
}
class Maker<T> {
	readonly tag: string;
	constructor(tag: string) {
		this.tag = tag;
	}
	make(x: T): Tagged {
		return this.tag.length > 0 ? new Box<T>(x) : new Box<T>(x);
	}
}
interface Node {
	readonly name: string;
	box: Tagged;
}
function make(k: number): number {
	const empty = new Maker<number>(`e`);
	const n: Node = { name: `n${k}`, box: empty.make(0) };
	const maker = new Maker<Node>(`m`);
	n.box = maker.make(n);
	return n.box.id + n.name.length;
}
console.log(`${make(1)}`);

