// replaceAll and matchAll given a literal with the g flag, and object writes in a program that never
// calls Object.freeze: nothing here can throw, so no call is followed by a check and no function is
// one that can throw.
type Tally = { text: string; count: number };

function tallied(text: string): Tally {
	const tally: Tally = { text: '', count: 0 };
	for (const match of text.matchAll(/[aeiou]/g)) {
		tally.count = tally.count + match[0].length;
	}
	tally.text = text.replaceAll(/[aeiou]/g, '*');
	tally.text = `${tally.text} ${text.replaceAll(new RegExp('s', 'g'), '$')}`;
	return tally;
}
for (const text of ['adamic', 'strings', 'rhythm']) {
	try {
		const tally = tallied(text);
		console.log(`${tally.text} ${tally.count}`);
	} catch {
		console.log('never');
	}
}
