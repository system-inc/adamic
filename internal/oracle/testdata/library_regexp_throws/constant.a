// matchAll given a literal with the g flag, and object writes in a program that never calls
// Object.freeze: nothing here can throw, so no call is followed by a check and no function is one that
// can throw. replaceAll isn't here: a replace can make its string longer than V8's longest, so it
// always checks (ir/string_throws.go), and so would a template.
type Tally = { text: string; count: number };

function tallied(text: string): Tally {
	const tally: Tally = { text: '', count: 0 };
	for (const match of text.matchAll(/[aeiou]/g)) {
		tally.count = tally.count + match[0].length;
	}
	tally.text = text;
	return tally;
}
for (const text of ['adamic', 'strings', 'rhythm']) {
	try {
		const tally = tallied(text);
		console.log(tally.text);
		console.log(tally.count);
	} catch {
		console.log('never');
	}
}
