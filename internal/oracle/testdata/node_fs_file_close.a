import { programArguments } from 'adamic';
const root = programArguments()[0] ?? '';
function failure(error: Error): void {
    const errno: NodeJS.ErrnoException = error;
    console.log(`${errno.code ?? ''}: ${error.message.replace(root, '<root>')}`);
}
import { openSync, closeSync, writeSync } from 'node:fs';
const fd=openSync(root + '/out','w'); closeSync(fd);
try { closeSync(fd); } catch(error) { if (error instanceof Error) { failure(error); } }
try { writeSync(fd,'closed'); } catch(error) { if (error instanceof Error) { failure(error); } }
try { closeSync(-1); } catch(error) { if (error instanceof Error) { failure(error); } }

const plain=new Error('plain');
const plainErrno: NodeJS.ErrnoException = plain;
console.log(`plain-code=${plainErrno.code ?? 'missing'}`);
