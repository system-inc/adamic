function allocate(s2: string): void {
    let previous = new Array(s2.length + 1);
    console.log(`${previous.length}`);
}
allocate("abc");
const cells = new Array<number>(4);
console.log(`${cells.length}:${cells[0] === undefined}:${cells[3] === undefined}`);
cells[1] = 7;
cells[3] = 9;
console.log(`${cells[0] === undefined}:${cells[1]}:${cells[2] === undefined}:${cells[3]}`);
const maximum = Array<number>(4294967295);
console.log(`${maximum.length}`);
maximum[4294967294] = 42;
console.log(`${maximum[4294967294]}:${maximum[4294967293] === undefined}`);
