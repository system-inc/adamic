interface Link {
 readonly label: string;
 next: Link | undefined;
 previous: Link | undefined;
}
function join(left: Link, right: Link): void { left.next = right; right.previous = left; }
function run(): void {
 const first: Link = { label: `first${1}`, next: undefined, previous: undefined };
 const second: Link = { label: `second${2}`, next: undefined, previous: undefined };
 const third: Link = { label: `third${3}`, next: undefined, previous: undefined };
 join(first, second); join(second, third);
 console.log(`${first.next?.next?.label} ${third.previous?.previous?.label}`);
 second.next = undefined;
 console.log(`${third.previous?.label} ${second.next === undefined}`);
 join(second, third);
 console.log(`${first.next?.next?.label}`);
}
run();
