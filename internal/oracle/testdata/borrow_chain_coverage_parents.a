interface Tree { readonly text: string; readonly parent: Tree | undefined; readonly children: readonly Tree[]; }
function depth(start: Tree): number {
 let node: Tree | undefined = start;
 let total = 0;
 while (node !== undefined) { const text = node.text; total += text.length; node = node.parent; }
 return total;
}
function children(root: Tree): number {
 const nodes = root.children;
 let total = 0;
 for (let index = 0; index < nodes.length; index++) {
  const child = nodes[index];
  if (child !== undefined) { const text = child.text; total += text.length + depth(child); }
 }
 return total;
}
const top: Tree = { text: `top${1}`, parent: undefined, children: [] };
const leaf: Tree = { text: `leaf${2}`, parent: top, children: [] };
const root: Tree = { text: `root${3}`, parent: undefined, children: [leaf, leaf] };
console.log(`${depth(leaf)} ${children(root)}`);
