let objects = 0;
let indices = 0;
let rights = 0;
let order = '';
function rhsNumber(): number { rights += 1; order += 'r'; return 7; }
function rhsString(): string { rights += 1; order += 'r'; return `built${rights}`; }
function rhsBoolean(): boolean { rights += 1; order += 'r'; return true; }
function index(): number { indices += 1; order += 'i'; return 0; }
function local_number(value: number): void {
 const result = (value ||= rhsNumber());
 console.log(`local number: ${result} ${value} ${rights}`);
}
local_number(0);
local_number(-0);
local_number(NaN);
local_number(2);
interface Field_number { value: number; }
const field_number: Field_number = { value: 0 };
function object_number(): Field_number { objects += 1; order += 'o'; return field_number; }
const array_number: (number)[] = [0];
function elements_number(): (number)[] { objects += 1; order += 'a'; return array_number; }
