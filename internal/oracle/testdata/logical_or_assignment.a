interface Item { readonly label: string; }
function item(): Item { rights += 1; order += 'r'; return { label: `made${rights}` }; }
function reference(value: Item | undefined): void {
 const result = (value ||= item());
 console.log(`reference: ${result.label} ${value.label} ${rights}`);
}
reference(undefined);
reference({ label: `old${rights}` });
interface RefField { value: Item | undefined; }
const refField: RefField = { value: undefined };
function objectRef(): RefField { objects += 1; order += 'o'; return refField; }
const refArray: (Item | undefined)[] = [item()];
refArray[0] = undefined;
function elementsRef(): (Item | undefined)[] { objects += 1; order += 'a'; return refArray; }
console.log(`ref field: ${(objectRef().value ||= item()).label}`);
console.log(`ref field skip: ${(objectRef().value ||= item()).label}`);
console.log(`ref element: ${(elementsRef()[index()] ||= item()).label}`);
console.log(`ref element skip: ${(elementsRef()[index()] ||= item()).label}`);
function mixed(value: number | string | boolean | undefined): void {
 console.log(`union: ${value ||= rhsString()} ${value}`);
