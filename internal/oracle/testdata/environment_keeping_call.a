let saved: (() => string) | undefined = undefined;
function keep(read: () => string): void { saved = read; }
function forward(read: () => string): void { keep(read); }
function fill(start: number): void {
 const scratch = 'scratch' + String(start);
 function read(): string { return scratch; }
 forward(read);
}
fill(3);
function show(): void { if (saved !== undefined) { console.log(saved()); } }
show();
