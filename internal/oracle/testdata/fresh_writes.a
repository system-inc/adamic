// The other writes the relaxation for fresh writes proves (docs/memory.md), each of a value that
// can't reach what it's written into: every kind of write, a fresh holder through a loop where the
// last pass's node escaped, a value made by a summarized function, a holder made by a constructor,
// and a write after a catch.
interface Node {
	readonly label: string;
	readonly nodes: Node[];
	next: Node | undefined;
	readonly named: Map<string, Node>;
}

function leaf(label: string): Node {
	return { label, nodes: [], next: undefined, named: new Map<string, Node>() };
}

function branch(label: string, count: number): Node {
	const node = leaf(label);
	for (let index = 0; index < count; index += 1) {
		node.nodes.push(leaf(`${label}.${index}`));
	}
	return node;
}

function describe(node: Node): string {
	const parts: string[] = [];
	for (const child of node.nodes) {
		parts.push(describe(child));
	}
	const next = node.next === undefined ? '' : ` -> ${node.next.label}`;
	const named: string[] = [];
	for (const [name, value] of node.named) {
		named.push(`${name}=${value.label}`);
	}
	return `${node.label}[${parts.join(',')}]${next}${named.length > 0 ? ` {${named.join(',')}}` : ''}`;
}

// Each kind of write, of fresh values into a fresh holder.
function everyWrite(tag: string): Node {
	const node = branch(tag, 2);
	node.nodes[0] = leaf(`${tag}.replaced`);
	node.nodes.splice(1, 0, leaf(`${tag}.spliced`));
	node.nodes.fill(leaf(`${tag}.filled`), 2);
	node.next = leaf(`${tag}.next`);
	node.named.set('first', branch(`${tag}.named`, 1));
	return node;
}
console.log(describe(everyWrite('w')));

// Into a holder that's a parameter, values that are fresh all the way down.
function grow(into: Node, label: string): void {
	into.nodes.push(branch(label, 2));
	into.next = leaf(`${label}.after`);
	into.named.set(label, leaf(`${label}.kept`));
}
const grown = leaf('grown');
grow(grown, 'g');
console.log(describe(grown));

// A node made each pass, filled while it's fresh, then handed to a list it escapes into: the next
// pass's node is a new one, which hasn't.
function collect(out: Node[], passes: number): void {
	for (let index = 0; index < passes; index += 1) {
		const item = leaf(`item${index}`);
		item.nodes.push(leaf(`item${index}.child`));
		out.push(item);
	}
}
const items: Node[] = [];
collect(items, 3);
console.log(items.map((item) => describe(item)).join(' '));

// A holder a constructor makes, written in the constructor and after.
class Box {
	readonly name: string;
	readonly contents: Box[] = [];
	constructor(name: string, inner: number) {
		this.name = name;
		for (let index = 0; index < inner; index += 1) {
			this.contents.push(new Box(`${name}.${index}`, inner - 1));
		}
	}
}
function size(box: Box): number {
	let total = 1;
	for (const inner of box.contents) {
		total += size(inner);
	}
	return total;
}
const box = new Box('box', 3);
box.contents.push(new Box('extra', 1));
console.log(`${box.name} holds ${size(box)}`);

// A write after a catch, into a holder nothing outside has seen.
function risky(count: number): Node {
	if (count > 1) {
		throw new Error(`too many: ${count}`);
	}
	return leaf(`risky${count}`);
}
function guarded(count: number): Node {
	const node = leaf(`guarded${count}`);
	try {
		node.nodes.push(risky(count));
	} catch (error) {
		node.nodes.push(leaf(error instanceof Error ? error.message : 'unknown'));
	}
	return node;
}
console.log(`${describe(guarded(1))} ${describe(guarded(2))}`);

// A set whose elements and a map whose keys can reach back to them, given only fresh values.
interface Step {
	readonly name: string;
	readonly next: Set<Step>;
	readonly visits: Map<Step, number>;
}
function step(name: string): Step {
	return { name, next: new Set<Step>(), visits: new Map<Step, number>() };
}
function plan(count: number): Step {
	const start = step('start');
	for (let index = 0; index < count; index += 1) {
		start.next.add(step(`step${index}`));
		start.visits.set(step(`visit${index}`), index);
	}
	return start;
}
const planned = plan(3);
const names: string[] = [];
for (const next of planned.next) {
	names.push(next.name);
}
for (const [visited, times] of planned.visits) {
	names.push(`${visited.name}x${times}`);
}
console.log(`${planned.name}: ${names.join(' ')}`);
