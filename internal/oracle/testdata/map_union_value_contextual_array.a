// Start at the union layout; Map values and their copied iterator survive clearing.
type Value = string | number;
const values: Value[] = [];
values.push(17);
values.push(18);
values.push('built'.repeat(2));
for (const value of values) { console.log(`${typeof value}:${value}`); }
const map = new Map<string, Value>([['a', values[0] ?? 'missing'], ['b', values[2] ?? 'missing']]);
console.log(`${map.get('a')} ${map.get('b')}`);
const copied = Array.from(map.values());
map.clear();
for (const value of copied) { console.log(`${typeof value}:${value}`); }
