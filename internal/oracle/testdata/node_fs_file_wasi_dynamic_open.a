import { programArguments } from 'adamic';
import { openSync, closeSync, writeSync, readFileSync } from 'node:fs';
const root = programArguments()[0] ?? '';
let mode = 0o666;
mode = 0o600;
const fd = openSync(root + '/dynamic', 'w', mode);
writeSync(fd, 'dynamic mode'); closeSync(fd);
console.log(readFileSync(root + '/dynamic', 'utf8'));
