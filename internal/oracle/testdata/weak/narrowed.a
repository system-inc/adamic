import type { Weak } from 'adamic';

// A Weak the checker narrowed to present, read after its target was freed: natively a panic, never a
// read of freed memory; on Node the target is still there.
interface Box {
	readonly label: string;
}
interface Holder {
	kept: Weak<Box>;
}
let strong: Box | undefined = { label: 'c'.repeat(2) };
const holder: Holder = { kept: strong };
if (holder.kept !== undefined) {
	console.log(`before: ${holder.kept.label}`);
	strong = undefined;
	console.log(`after: ${holder.kept.label}`);
}
