import type { Weak } from 'adamic';

// A Weak of a union narrowed to present, read after its target was freed. Native must panic
// before keeping the local; Node still holds the target. The string is built at runtime.
interface Named {
	readonly kind: 'Named';
	readonly name: string;
}
interface Counted {
	readonly kind: 'Counted';
	readonly count: number;
}
interface Holder {
	kept: Weak<Named | Counted>;
}
let strong: Named | undefined = { kind: 'Named', name: 'n'.repeat(2) };
const holder: Holder = { kept: strong };
if (holder.kept !== undefined) {
	console.log('before');
	strong = undefined;
	const seen = holder.kept;
	console.log(`after: ${seen.kind === 'Named' ? seen.name : seen.count}`);
}
