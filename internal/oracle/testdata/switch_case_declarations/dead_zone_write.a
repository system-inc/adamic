function replacement(): string {
	console.log('right side');
	return `new${1}`;
}
function show(input: number): void {
	switch (input) {
		case 1:
			let value = `value${input}`;
			console.log(value);
			break;
		case 2:
			write();
			break;
		default:
			function write(): void { value = replacement(); }
	}
}
console.log('before');
show(2);
console.log('unreachable');
