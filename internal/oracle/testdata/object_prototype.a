class Box {
	readonly label = 'box';
	method(): number { return 1; }
}
let calls = 0;
function object(): { readonly label: string } {
	calls += 1;
	return { label: `call${calls}` };
}
const plain = { label: 'plain', optional: undefined };
const box = new Box();
console.log(plain.toString());
console.log(box.toString());
console.log(object().toString());
console.log(`${calls}`);
console.log(plain.toLocaleString());
console.log(box.toLocaleString());
console.log(`${plain.valueOf() === plain} ${box.valueOf() === box}`);
console.log(`${plain.hasOwnProperty('label')} ${plain.hasOwnProperty('missing')} ${plain.hasOwnProperty('toString')}`);
console.log(`${plain.propertyIsEnumerable('label')} ${plain.propertyIsEnumerable('optional')} ${plain.propertyIsEnumerable('toString')}`);
console.log(`${box.hasOwnProperty('label')} ${box.hasOwnProperty('method')} ${box.propertyIsEnumerable('method')}`);
console.log('hello'.toString());
console.log('hello'.toLocaleString());
console.log('hello'.valueOf());
console.log(true.toString());
console.log(false.toLocaleString());
console.log(`${true.valueOf()}`);
console.log((-0).toString());
console.log(`${(42).valueOf()}`);
const numbers: number[] = [1, 2, 3];
const strings: string[] = ['a', '', 'b'];
const optional: (number | undefined)[] = [1, undefined, 3];
console.log(numbers.toString());
console.log(strings.toString());
console.log(strings.toLocaleString());
const booleans: boolean[] = [true, false];
console.log(booleans.toLocaleString());
console.log(optional.toString());
const map = new Map<string, number>();
const set = new Set<number>();
console.log(map.toString());
console.log(set.toLocaleString());
const own = {
	unique: 1,
	toString: (): string => 'own string',
	valueOf: (): number => 99,
	toLocaleString: (): string => 'own locale',
	hasOwnProperty: (key: string): boolean => key === 'custom',
	propertyIsEnumerable: (key: string): boolean => key === 'custom',
	isPrototypeOf: (value: { readonly label: string }): boolean => true,
};
console.log(own.toString());
console.log(`${own.valueOf()}`);
console.log(own.toLocaleString());
const ownHas = own.hasOwnProperty;
console.log(`${ownHas('custom')} ${own.hasOwnProperty('unique')} ${own.propertyIsEnumerable('custom')} ${own.isPrototypeOf(plain)}`);
const indexed: (number | undefined)[] = [undefined, 7];
const unicode = 'A🌍';
for (const key of ['0', '1', '2', '3', 'length', '-0', '-1', '01', '1x', '1.0', '1e0', ' 1', 'NaN', 'Infinity', '9999999999999999999999', 'toString', 'constructor', '']) {
	console.log(`${key}: array ${indexed.hasOwnProperty(key)} ${indexed.propertyIsEnumerable(key)} string ${unicode.hasOwnProperty(key)} ${unicode.propertyIsEnumerable(key)}`);
	console.log(`${(42).hasOwnProperty(key)} ${true.hasOwnProperty(key)} ${map.hasOwnProperty(key)} ${set.propertyIsEnumerable(key)}`);
}
indexed.pop();
console.log(`${indexed.hasOwnProperty('1')} ${indexed.hasOwnProperty('0')}`);
const empty: string[] = [];
console.log(`${empty.hasOwnProperty('0')} ${''.hasOwnProperty('0')}`);
const callable = (): number => 1;
console.log(`${callable.propertyIsEnumerable('name')} ${callable.propertyIsEnumerable('length')} ${callable.propertyIsEnumerable('prototype')}`);
let order = '';
function receiverNumber(): number { order += 'receiver '; return 42; }
function receiverArray(): number[] { order += 'receiver '; return [7]; }
function propertyKey(): string { order += 'key '; return '0'; }
console.log(`${receiverNumber().hasOwnProperty(propertyKey())} ${order}`);
order = '';
console.log(`${receiverArray().hasOwnProperty(propertyKey())} ${order}`);
function named(value: number): number { return value; }
const namedAlias = named;
const arrowAlias = callable;
for (const key of ['name', 'length', 'prototype', 'arguments', 'caller', 'toString']) {
	console.log(`${key}: named ${named.hasOwnProperty(key)} ${named.propertyIsEnumerable(key)} arrow ${callable.hasOwnProperty(key)} ${callable.propertyIsEnumerable(key)}`);
	console.log(`${namedAlias.hasOwnProperty(key)} ${arrowAlias.hasOwnProperty(key)}`);
}
const error = new Error('message');
console.log(`${error.valueOf() === error}`);
