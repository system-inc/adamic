// A function declared by name, read as a value: handed to map, sort, forEach and Map's forEach,
// held in a variable, an array and an object, passed on and returned, throwing through map's loop,
// and the same object at every read, as JavaScript gives it (=== and a Set say so). The first use
// comes before the declarations, which JavaScript hoists. Strings are built at run time.

console.log(apply(early, word('before the declaration ', 0)));

function word(stem: string, index: number): string {
	return `${stem}${index}`;
}
function early(value: string): string {
	return `early ${value}`;
}
function shout(value: string): string {
	return `${value.toUpperCase()}!`;
}
function byLength(left: string, right: string): number {
	return left.length - right.length;
}
function show(value: string, index: number): void {
	console.log(`${index}: ${value}`);
}
function failing(value: string): string {
	if (value === 'bb2') {
		throw new Error(`failing at ${value}`);
	}
	return value;
}
function apply(run: (value: string) => string, value: string): string {
	return run(value);
}
function pick(loud: boolean): (value: string) => string {
	return loud ? shout : early;
}
let calls = 0;
function counted(value: number): number {
	calls += 1;
	return value * 2;
}
function size(items: readonly string[]): number {
	return items.length;
}
function factorial(value: number): number {
	return value <= 1 ? 1 : value * factorial(value - 1);
}

const words = [word('a', 1), word('bb', 2), word('c', 3)];
console.log(words.map(shout).join(', '));
console.log([...words].sort(byLength).join(', '));
words.forEach(show);
console.log(words.map(word).join(', '));
try {
	console.log(words.map(failing).join(', '));
} catch (error) {
	console.log(error instanceof Error ? error.message : 'something');
}

const held = shout;
console.log(held(word('held ', 1)));
console.log(`${held === shout} ${shout === shout} ${pick(true) === shout} ${pick(false) === shout}`);
const kept = new Set<(value: string) => string>([shout, shout, held, failing, pick(true)]);
console.log(`${kept.size}`);
const runs: ((value: string) => string)[] = [shout, early, failing];
console.log(runs.map((run) => run(word('each ', runs.length))).join(' / '));
const table = { first: shout, second: early };
console.log(`${table.first(word('field ', 1))} ${table.second(word('field ', 2))}`);
console.log(apply(pick(true), word('picked ', 1)));
console.log(apply(pick(false), word('picked ', 2)));

const doubled = [1, 2, 3].map(counted);
console.log(`${doubled.join(',')} after ${calls} calls`);
console.log([1, 3, 5].map(factorial).join(','));
const measure: (items: readonly string[]) => number = size;
console.log(`${measure(words)} ${[['a'], ['b', 'c']].map(size).join(',')}`);
const later = (value: string): string => apply(shout, value);
console.log(later(word('inside an arrow ', 3)));

const ages = new Map<string, string>();
ages.set(word('ann', 1), word('age ', 31));
ages.set(word('bob', 2), word('age ', 42));
function listed(value: string, key: string): void {
	console.log(`${key} is ${value}`);
}
ages.forEach(listed);
