const values = [1, 2];
for (const value of values.values()) { console.log(`${value}`); if (value === 1) { values.push(3); values[1] = 8; } }
for (const key of values.keys()) { console.log(`key ${key}`); }
for (const [index, value] of values.entries()) { console.log(`${index}:${value}`); }
for (const entry of values.entries()) { console.log(`pair ${entry[0]}:${entry[1]}`); }
let words = ['a'.repeat(2), 'b'.repeat(2)];
for (const value of words.values()) { words = ['new']; console.log(value); }
const shrink = [1, 2, 3];
for (const [index, value] of shrink.entries()) { shrink.splice(1, 2); console.log(`shrink ${index}:${value}`); }
const closures: (() => number)[] = [];
for (const key of values.keys()) { closures.push((): number => key); }
console.log(closures.map((callback: () => number): number => callback()).join('|'));
for (const key of values.keys()) { if (key === 1) { continue; } console.log(`continue ${key}`); }
