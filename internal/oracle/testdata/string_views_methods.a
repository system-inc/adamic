// Each method on short ASCII, BMP, supplementary and lone-surrogate nested views.
for (const word of ['ababa', 'é世aé', 'a🌍b🌍', 'x\ud800y\udfff', 'a\u0000b']) {
    const parent = `!${word}?`;
    const outer = parent.substring(1, parent.length - 1);
    const text = outer.slice(0);
    for (const position of [-100, -1, -0, 0, 1, 2, 1.9, -1.9, 100, NaN, Infinity, -Infinity]) {
        const at = text.at(position);
        console.log(`${text.charAt(position).charCodeAt(0)} ${text.charCodeAt(position)} ${at === undefined} ${(at ?? '').charCodeAt(0)}`);
        for (const end of [-1, 0, 2, 100, NaN, Infinity, -Infinity]) {
            const slice = text.slice(position, end);
            const substring = text.substring(position, end);
            console.log(`${slice.length}:${slice.charCodeAt(0)}:${slice.charCodeAt(slice.length - 1)} ${substring.length}:${substring.charCodeAt(0)}:${substring.charCodeAt(substring.length - 1)}`);
        }
        for (const needle of ['', 'a', 'ab', 'é', '🌍', '\ud800', '\udfff', '\u0000', 'missing']) {
            console.log(`${text.indexOf(needle, position)} ${text.lastIndexOf(needle)}`);
        }
    }
    console.log(`${text.slice()} ${text.substring(0)} ${text.charAt(0).charCodeAt(0)} ${text.charCodeAt(0)} ${(text.at(0) ?? '').charCodeAt(0)}`);
}
