interface Tool { run: (n: number) => number }

const tool: Tool = { run: function rec(n: number): number { return n <= 1 ? 1 : n * rec(n - 1); } };
console.log(`${tool.run(5)}`);

const tools: Tool[] = [
	{ run: function (value: number): number { return value + 1; } },
	{ run: function (value: number): number { return value * 3; } },
];
console.log(tools.map(function (item): string { return `${item.run(4)}`; }).join(','));

class Box {
	callback = function (value: number): number { return value + 5; };
	read(value: number): number { return this.callback(value); }
}
const box = new Box();
const saved = box.callback;
box.callback = function (value: number): number { return value * 10; };
console.log(`${saved(2)} ${box.callback(2)} ${box.read(2)}`);

function callWith(fn: (value: number) => number, value: number): number {
	return fn(value);
}
console.log(`${callWith(function (value: number): number { return value * value; }, 6)}`);
console.log(`${[1, 2, 3, 4].reduce(function (total, value): number { return total + value; }, 0)}`);
console.log([1, 2, 3, 4, 5].filter(function (value): boolean { return value % 2 === 0; }).join(','));

const holder = { compare: function compare(left: number, right: number): number { return right - left; } };
console.log([1, 4, 2].sort(holder.compare).join(','));

let slot: (value: number) => number = function (value: number): number { return value + 1; };
const first = slot;
slot = function (value: number): number { return value + 10; };
console.log(`${first(1)} ${slot(1)}`);
