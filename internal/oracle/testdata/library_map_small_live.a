function step(iterator: MapIterator<number>, label: string): void {
    const result = iterator.next();
    if (result.done) { console.log(`${label} done`); }
    else { console.log(`${label} ${result.value}`); }
}
const map = new Map<number, number>([[3, 30], [1, 10], [2, 20], [4, 40]]);
const first = map.keys();
const second = map.keys();
step(first, 'first'); step(second, 'second'); step(second, 'second');
map.delete(3);
map.set(5, 50);
map.set(1, 11);
map.delete(2);
map.set(6, 60);
step(first, 'first'); step(second, 'second');
map.set(3, 33);
step(first, 'first'); step(first, 'first'); step(first, 'first'); step(first, 'first');
step(second, 'second'); step(second, 'second'); step(second, 'second'); step(second, 'second');
map.delete(4); map.delete(5);
console.log(`after close ${[...map.keys()].join(',')}`);
map.set(7, 70); map.set(8, 80);
console.log(`promote again ${[...map.keys()].join(',')}`);
step(first, 'exhausted');
const clearing = map.keys();
step(clearing, 'clear');
map.clear();
map.set(9, 90); map.set(10, 100);
step(clearing, 'clear'); step(clearing, 'clear'); step(clearing, 'clear');
console.log(`cleared ${[...map.keys()].join(',')}`);
const tiny = new Map<number, number>([[1, 1]]);
const held = tiny.keys();
step(held, 'tiny');
for (let index = 2; index < 10; index++) { tiny.delete(index - 1); tiny.set(index, index); }
step(held, 'tiny'); step(held, 'tiny');
console.log(`tiny back ${tiny.size} ${[...tiny.keys()].join(',')}`);
