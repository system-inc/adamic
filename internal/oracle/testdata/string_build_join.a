// Empty joins and separators that join, separate or reverse surrogate halves.
function show(text: string): void {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(text.charCodeAt(index));
		codes.push(text.codePointAt(index) ?? -1);
	}
	console.log(`${text.length} ${text.codePointAt(0) ?? -1}: ${codes.join(',')}`);
}
const high = String.fromCharCode(0xd83c);
const low = String.fromCharCode(0xdf0d);
for (const separator of ['', 'a', 'é', '世', '🌍', high, low]) {
	show([high, '', low, 'x'].join(separator));
	show(['', ''].join(separator));
}
const empty: string[] = [];
show(empty.join('🌍'));
show([high].join(low));
show([low, high].join(''));
show([1, -0, NaN, Infinity].join('🌍'));
show([true, false].join(high));
show(''.concat(high, '', low, 'é'));
show(high.concat());
show(high + low);
show(`${high}${low}${42}${true}${false}`);
