// a-check: refused a value of type Result[] seen as { done?: boolean | undefined; value: readonly (string | undefined)[] | undefined; }[], whose readonly field done becomes writable: a readonly field may hold something narrower than boolean | undefined, which a write of boolean | undefined would replace; keep done readonly in the type it's seen as, or copy the value ({ ...value }) (adamic/invariant-mutable)
interface Result { readonly done?: boolean | undefined; readonly value: readonly (string | undefined)[] | undefined }
const iterator = 'aba'.matchAll(/a/g);
const results: Result[] = [];
const wider: { done?: boolean | undefined; value: readonly (string | undefined)[] | undefined }[] = results;
results.push(iterator.next());
results.push(iterator.next());
results.push(iterator.next());
for (const result of results) {
