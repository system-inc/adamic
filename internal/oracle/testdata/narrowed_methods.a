// A method called through a narrowing a call undid: JavaScript throws reading the method, before
// any argument is evaluated, and so does native, rather than run the method with no this.
class Box {
	count = 0;
	bump(step: number): number {
		console.log('in bump');
		this.count += step;
		return this.count;
	}
}
let box: Box | undefined = new Box();
function drop(): number {
	box = undefined;
	return 1;
}
if (box !== undefined) {
	console.log(`${box.bump(1)}`);
	drop();
	console.log(`${box.bump(drop())}`);
}
