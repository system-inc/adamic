interface Answer { yes: boolean | undefined; }
const answer: Answer = { yes: true };
console.log(`${answer.yes ?? false}`);
answer.yes = false;
console.log(`${answer.yes ?? true}`);
answer.yes = undefined;
console.log(`${answer.yes === undefined}`);
interface Shown { value: string | number; }
const shown: Shown = { value: 1 };
console.log(`${shown.value}`);
shown.value = 'one';
console.log(`${shown.value}`);
const mixed: (string | number)[] = ['a', 1];
console.log(`${mixed.length}/${mixed[0]}/${mixed[1]}`);
let contextCalls = 0;
function context(): void { contextCalls += 1; }
new Set<number>([1]).forEach((value: number): void => { console.log(`${value}`); }, context());
console.log(`${contextCalls}`);
function caseValue(value: number): number { console.log(`case ${value}`); return value; }
switch (1) {
 case caseValue(1):
 case caseValue(2): console.log('matched'); break;
 default: console.log('wrong');
}
