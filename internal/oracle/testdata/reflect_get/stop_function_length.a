// A function a run-time key read hands out, read by a key in turn, stopped on both backends alike
// in the Function form. Its length now answers as Node's does (#xdcec18): natively an array's map
// is an immortal closure carrying Node's length, and on the JavaScript backend it is Node's own
// function. Node prints map function and then number.
import { propertyOf } from './hostErrors.ts';

const map = propertyOf([1], 'map');
console.log(`map ${typeof map}`);
console.log(typeof propertyOf(map, 'length'));
