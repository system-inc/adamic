// A scalar field read by a run-time key answers as Node's does, natively from the representation
// byte its object carries: a decoded object's number and boolean beside its string, a literal's
// number and boolean, decodeJson's number result, fileStatus's size and symbolicLink, matchAll's
// done, and a Map's number and a Set's boolean from next(). The size prints its type only, since its
// value varies. The path is relative to internal/oracle, where its test runs it. memoryUsage's
// heapUsed is a host object's field, which stops (stop_host_memory_heap.a). Last, an optional number
// field, present and absent, and a number | undefined field written with a plain number and then
// with undefined: a slot that may hold a packed maybe-number, whose byte must name the slot's
// storage, not the value written into it.
import { decodeJson, fileStatus } from 'adamic';
import { propertyOf } from './hostErrors.ts';

function show(label: string, value: unknown): void {
	if (typeof value === 'number') console.log(`${label} number ${String(value)}`);
	else if (typeof value === 'boolean') console.log(`${label} boolean ${value ? 'true' : 'false'}`);
	else if (typeof value === 'string') console.log(`${label} string ${value}`);
	else console.log(`${label} ${typeof value}`);
}

const decoded = decodeJson<{ readonly n: number; readonly b: boolean; readonly s: string }>('{"n":1,"b":true,"s":"text"}');
if (decoded.kind === 'Ok') {
	for (const name of ['n', 'b', 's']) show(name, propertyOf(decoded.value, name));
} else console.log(decoded.message);
const literal = { count: 2, on: false };
show('count', propertyOf(literal, 'count'));
show('on', propertyOf(literal, 'on'));
show('decoded result', propertyOf(decodeJson<number>('5'), 'value'));
const status = fileStatus('testdata');
console.log(`size ${typeof propertyOf(status, 'size')}`);
show('symbolicLink', propertyOf(status, 'symbolicLink'));
show('done', propertyOf('ab'.matchAll(/a/g).next(), 'done'));
const numbers = new Map<string, number>([['a', 1]]).values();
show('map value', propertyOf(numbers.next(), 'value'));
const flags = new Set<boolean>([true]).values();
show('set value', propertyOf(flags.next(), 'value'));
const present: { readonly count?: number } = { count: 3 };
show('present', propertyOf(present, 'count'));
const absent: { readonly count?: number } = {};
show('absent', propertyOf(absent, 'count'));
const box: { count: number | undefined } = { count: undefined };
box.count = 4;
show('written', propertyOf(box, 'count'));
box.count = undefined;
show('cleared', propertyOf(box, 'count'));
