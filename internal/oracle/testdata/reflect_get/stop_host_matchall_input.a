// A host object stops for every key (#ey7aysy): a matchAll iterator has no own input on Node, and
// native's shape holds its private input, regex and done, which a run-time key read handed out
// before. Node prints undefined.
import { propertyOf } from './hostErrors.ts';

const matches = 'ab'.matchAll(/a/g);
console.log('iterator');
const value = propertyOf(matches, 'input');
console.log(typeof value);
