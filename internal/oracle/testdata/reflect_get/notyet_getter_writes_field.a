// A keyed getter that writes a field keeps the program-wide syntax refusal.
class Reader {
	count = 0;
	get next(): number { this.count = this.count + 1; return this.count; }
}
function read(value: object, key: string): unknown {
	return Reflect.get(Object(value), key, value);
}
console.log(String(read(new Reader(), 'next')));
