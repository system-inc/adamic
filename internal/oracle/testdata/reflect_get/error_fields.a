// An Error's own fields keep answering a run-time key read, though its prototype isn't Object's: the
// carve-out from #ey7aysy's host stop, on both backends, since stage3's adapters read caught errors
// through this propertyOf. A caught fs error's code and message, and a thrown Error's message and
// name. A key that isn't an Error's own field reads undefined on each, as on Node, so the carve-out
// can't hand out a field the runtime adds later (Language's condition on #ey7aysy). The carve-out
// holds for an in test and the read it narrows too (Adamic's ruling on #ey7aysy at 23:03Z): each
// error's names answer in as Node's do, and errorCode, tsc's helper shape, reads a caught code. A
// Node-coded host error (a path with a null byte, adamic_coded_error_methods) is an Error alike.
import { readFileSync } from 'node:fs';
import { errorCode, propertyOf } from './hostErrors.ts';

function show(label: string, value: unknown): void {
	if (typeof value === 'string') console.log(`${label}: "${value}"`);
	else console.log(`${label}: ${typeof value}`);
}

function hasCode(value: unknown): string {
	return typeof value === 'object' && value !== null && 'code' in value ? 'yes' : 'no';
}

function hasMessage(value: unknown): string {
	return typeof value === 'object' && value !== null && 'message' in value ? 'yes' : 'no';
}

function hasName(value: unknown): string {
	return typeof value === 'object' && value !== null && 'name' in value ? 'yes' : 'no';
}

function hasFoo(value: unknown): string {
	return typeof value === 'object' && value !== null && 'foo' in value ? 'yes' : 'no';
}

try {
	readFileSync('/nonexistent-adamic-reflect-get/file', 'utf8');
} catch (error) {
	show('code', propertyOf(error, 'code'));
	show('message', propertyOf(error, 'message'));
	show('caught foo', propertyOf(error, 'foo'));
	console.log(`caught in: code ${hasCode(error)} message ${hasMessage(error)} foo ${hasFoo(error)}`);
	show('errorCode', errorCode(error));
}
try {
	readFileSync('a\0b', 'utf8');
} catch (error) {
	show('coded code', propertyOf(error, 'code'));
	show('coded name', propertyOf(error, 'name'));
	show('coded foo', propertyOf(error, 'foo'));
	console.log(`coded in: code ${hasCode(error)} message ${hasMessage(error)} foo ${hasFoo(error)}`);
}
try {
	throw new Error('thrown');
} catch (error) {
	show('thrown', propertyOf(error, 'message'));
	show('name', propertyOf(error, 'name'));
	show('thrown foo', propertyOf(error, 'foo'));
	console.log(`thrown in: message ${hasMessage(error)} name ${hasName(error)} foo ${hasFoo(error)}`);
}
