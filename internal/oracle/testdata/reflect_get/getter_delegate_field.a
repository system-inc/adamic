// A keyed getter reads through its own delegate, with the admitted receiver as this.
class Holder {
	readonly value: number;
	constructor(value: number) { this.value = value; }
}
class Wrapper {
	readonly holder: Holder;
	constructor(value: number) { this.holder = new Holder(value); }
	get answer(): number { return this.holder.value; }
}
function read(value: object, key: string): unknown {
	return Reflect.get(Object(value), key, value);
}
console.log(String(read(new Wrapper(42), 'answer')));
