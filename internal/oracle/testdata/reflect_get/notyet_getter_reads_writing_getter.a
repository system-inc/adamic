// A getter that reads a writing getter keeps the program-wide syntax refusal.
class Reader {
	count = 0;
	get bump(): number { this.count = this.count + 1; return this.count; }
	get outer(): number { return this.bump; }
}
function read(value: object, key: string): unknown {
	return Reflect.get(Object(value), key, value);
}
console.log(String(read(new Reader(), 'outer')));
