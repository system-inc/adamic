// An array allocation in a getter keeps the program-wide syntax refusal.
class Reader {
	readonly value = 42;
	get pair(): number[] { return [this.value, this.value]; }
}
function read(value: object, key: string): unknown {
	return Reflect.get(Object(value), key, value);
}
console.log(String(read(new Reader(), 'pair')));
