// A Stats' isFile is StatsBase.prototype's method on Node, which native's shape doesn't hold, so it
// read undefined on both backends before it stopped (#ey7aysy). It now answers on both backends as
// Node's does (#zhrjf2t), natively an immortal closure (stats_reads.a). Node prints function.
import * as fs from 'node:fs';
import { propertyOf } from './hostErrors.ts';

const stats = fs.statSync('.');
console.log(stats.isDirectory() ? 'directory' : 'other');
const value = propertyOf(stats, 'isFile');
console.log(typeof value);
