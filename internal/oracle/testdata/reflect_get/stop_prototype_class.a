// A class instance's constructor stops, on both backends, in the class constructor stop's words: an
// instance carries its class's metadata, never the class the program holds. The JavaScript backend's
// accessor table is an object literal, which constructor indexes to Object's own member, so it must
// look at the table's own entries alone, or it stops naming a setter without a getter. Node prints
// function.
import { propertyOf } from './hostErrors.ts';

class Thing {
	label = 'thing';
}
const thing = new Thing();
console.log(thing.label);
const value = propertyOf(thing, 'constructor');
console.log(typeof value);
