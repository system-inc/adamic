// A record's own values, read by a run-time key, each boxed by the kind its record was made with
// (#zhgxzjg, Runtime's three record shapes): numbers, booleans, strings, and a number that may be
// undefined, an own key holding undefined among them. A record of boolean | undefined isn't admitted
// yet ("record values with an unsupported slot representation"), so it isn't here.
// propertyOf is hostErrors.ts's, written out here: that module's errorCode reads error.code through an unknown
// narrowed by in, a named dynamic read, which stops in a program holding a number or boolean record until
// #3tjjcjs boxes a record's slot by its kind (#859ksab). This file is about the run-time key road, which boxes.
function propertyOf(value: unknown, key: string): unknown {
	if (value === null || value === undefined) {
		throw new TypeError(`Cannot read properties of ${value === null ? "null" : "undefined"} (reading '${key}')`);
	}
	return Reflect.get(Object(value), key, value);
}

function show(label: string, value: unknown): void {
	if (typeof value === 'string') console.log(`${label}: "${value}"`);
	else if (typeof value === 'number') console.log(`${label}: ${String(value)}`);
	else if (typeof value === 'boolean') console.log(`${label}: ${value ? 'true' : 'false'}`);
	else console.log(`${label}: ${typeof value}`);
}

const counts: Record<string, number> = {};
counts['seen'] = 3;
const flags: Record<string, boolean> = {};
flags['on'] = true;
flags['off'] = false;
const names: Record<string, string> = {};
names['first'] = 'ada';
const maybeCounts: Record<string, number | undefined> = {};
maybeCounts['here'] = 4;
maybeCounts['gone'] = undefined;
show('count', propertyOf(counts, 'seen'));
show('missing', propertyOf(counts, 'missing'));
show('on', propertyOf(flags, 'on'));
show('off', propertyOf(flags, 'off'));
show('name', propertyOf(names, 'first'));
show('here', propertyOf(maybeCounts, 'here'));
show('gone', propertyOf(maybeCounts, 'gone'));
