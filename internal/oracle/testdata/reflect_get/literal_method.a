// An object literal's method is its own data property holding a function, on Node and on both
// backends alike, so a run-time key read gives that function; only a class's methods, which no object
// holds as its own, stop.
import { propertyOf } from './hostErrors.ts';

const literal = {
	describe(): string {
		return 'described';
	},
};
console.log(literal.describe());
console.log(typeof propertyOf(literal, 'describe'));
