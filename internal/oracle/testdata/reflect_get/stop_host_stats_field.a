// A Stats' dev is Node's own field, which native's shape didn't hold, so it read undefined natively
// and a number on the JavaScript backend before it stopped (#ey7aysy), and then it stopped on both
// backends rather than make up a value (#zhrjf2t). Native's shape holds it now, and it answers on both
// as Node's does (#6xfkdwj), natively its slot read by the shape's kind. Node prints number.
import * as fs from 'node:fs';
import { propertyOf } from './hostErrors.ts';

const stats = fs.statSync('.');
console.log(stats.isDirectory() ? 'directory' : 'other');
const value = propertyOf(stats, 'dev');
console.log(typeof value);
