// A host object stops for every key (#ey7aysy): a Stats' dev is Node's own field, which native's
// shape doesn't hold, so it read undefined natively and a number on the JavaScript backend before.
// Node prints number.
import * as fs from 'node:fs';
import { propertyOf } from './hostErrors.ts';

const stats = fs.statSync('.');
console.log(stats.isDirectory() ? 'directory' : 'other');
const value = propertyOf(stats, 'dev');
console.log(typeof value);
