// The transitive gate follows a getter call into a method that writes.
class Reader {
	count = 0;
	bump(): number { this.count = this.count + 1; return this.count; }
	get next(): number { return this.bump(); }
}
function read(value: object, key: string): unknown {
	return Reflect.get(Object(value), key, value);
}
console.log(String(read(new Reader(), 'next')));
