// Object.keys of a host object stops in a keyless message (#ey7aysy, Adamic's ruling at 08:28Z): a
// Stats' own keys on Node are dev, mode and the rest, and native's shape holds size, mtimeMs, mtime,
// _fsFileMode and atime. Node prints keys true false.
import * as fs from 'node:fs';

const stats = fs.statSync('.');
console.log('stats');
const keys = Object.keys(stats);
console.log(`keys ${keys.includes('dev')} ${keys.includes('_fsFileMode')}`);
