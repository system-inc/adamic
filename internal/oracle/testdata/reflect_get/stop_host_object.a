// A Stats' constructor is Stats on Node, not Object, so it stopped on both backends while a host
// object's prototype wasn't known natively and Object's closures would have stood in for another's.
// It now answers on both backends as Node's does (#zhrjf2t), natively Stats' own immortal closure
// (stats_reads.a). Node prints function.
import * as fs from 'node:fs';
import { propertyOf } from './hostErrors.ts';

const stats = fs.statSync('.');
console.log(stats.isDirectory() ? 'directory' : 'other');
const value = propertyOf(stats, 'constructor');
console.log(typeof value);
