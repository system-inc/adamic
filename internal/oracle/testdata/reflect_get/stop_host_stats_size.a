// A Stats' size is a field native's shape holds, which panicked natively before it stopped
// (#ey7aysy): "dynamic read of a host scalar without type metadata". It now answers on both backends
// as Node's does (#zhrjf2t), natively its slot read by the shape's kind (stats_reads.a). Node prints
// number.
import * as fs from 'node:fs';
import { propertyOf } from './hostErrors.ts';

const stats = fs.statSync('.');
console.log(stats.isDirectory() ? 'directory' : 'other');
const value = propertyOf(stats, 'size');
console.log(typeof value);
