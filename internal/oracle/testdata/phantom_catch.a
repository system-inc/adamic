type Escaped = string & { __escapedIdentifier: void };
type Missing = void & { __escapedIdentifier: void };
function read(value: Escaped | Missing): string {
    return String(value.__escapedIdentifier);
}
try {
    console.log(read(undefined as Missing));
} catch (error) {
    if (error instanceof Error) {
        console.log(`${error.name}: ${error.message}`);
    }
}
console.log(read(('run' + 'time') as Escaped));
let visits = 0;
function missing(): Escaped | Missing {
    visits += 1;
    return undefined as Missing;
}
console.log(String(missing()?.__escapedIdentifier));
console.log(`${visits}`);

type Count = number & { marker?: undefined };
type Answer = boolean & { marker: void };
console.log(String((3 as Count)['marker']));
console.log(String((false as Answer).marker));
// The chain belongs to the actual primitive. Boolean has no length and Number has no slice.
type SizedAnswer = boolean & { length: void };
type SlicedCount = number & { slice: void };
console.log(String((true as SizedAnswer).length));
console.log(String((4 as SlicedCount).slice));
let current: Escaped | Missing = ('new' + 'value') as Escaped;
function drop(): void { current = undefined as Missing; }
if (current !== undefined) {
    drop();
    try {
        console.log(String(current.__escapedIdentifier));
    } catch (error) {
        if (error instanceof Error) { console.log(`${error.name}: ${error.message}`); }
    }
}
