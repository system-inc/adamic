interface Entry { label: string; }
function entries(size: number): Entry[] {
 const cells = new Array<Entry>(size);
 cells[1] = { label: `entry${size}` };
 return cells;
}
const cells = entries(3);
console.log(`${cells[0] === undefined}:${cells[1]?.label}:${cells[2] === undefined}`);
console.log(cells.map((entry, index) => `${index}:${entry.label}`).join("|"));
cells[1] = { label: `replacement${cells.length}` };
cells.length = 1;
console.log(`${cells.length}:${cells[1] === undefined}`);
const flags = new Array<boolean>(4);
flags[1] = false;
flags[3] = true;
console.log(`${flags[0] === undefined}:${flags.indexOf(false)}:${flags.includes(true)}:${flags.join("|")}`);
console.log(flags.map((flag) => flag ? "yes" : "no").join("|"));
