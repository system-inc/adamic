type Branded = number[] & { marker: void };
type BrandedReadonly = readonly number[] & { marker?: undefined };
function into(values: number[]): Branded { return values as Branded; }
function out(values: Branded): number[] { return values as number[]; }
const original = [3, 1, 2];
const branded = into(original);
console.log(`${branded === original} ${out(branded) === original}`);
console.log(String(branded.marker));
branded.sort((a, b) => a - b);
console.log(`${original.join(',')} ${branded.length} ${branded[0] ?? -1}`);
const readonly = branded as readonly number[] as BrandedReadonly;
console.log(`${readonly.slice(1).join(',')} ${readonly.includes(2)}`);
console.log(String(readonly.marker));

// Adapted from TypeScript 6.0.3 corePublic.ts:17-19 and core.ts:1039.
// The original sorted body is unchanged; required undefined is changed to void
// to stay within the approved brand rule while that language choice is pending.
interface SortedReadonlyArray<T> extends ReadonlyArray<T> { " __sortedArrayBrand": void; }
function sorted<T>(array: readonly T[]): SortedReadonlyArray<T> {
    return array.slice() as readonly T[] as SortedReadonlyArray<T>;
}
function describe<T>(array: SortedReadonlyArray<T>): string {
    return `${array.length} ${array.slice().length}`;
}
console.log(describe(sorted([1, 2])));
console.log(describe(sorted(['built' + 'one', 'built' + 'two'])));
console.log(describe(sorted([{ name: 'object' + 'one' }])));
interface SortedAlias<T> extends SortedReadonlyArray<T> {}
const alias = sorted([4, 5]) as SortedAlias<number>;
console.log(`${alias.length} ${alias.join(',')}`);
function first<Pack extends readonly (number | string)[]>(values: Pack): number | string | undefined {
    return values[0];
}
console.log(String(first(sorted([13, 14]))));
console.log(String(first(sorted(['made' + 'first', 'made' + 'second']))));
