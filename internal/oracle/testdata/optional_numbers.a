// ?. to a number field is number | undefined: undefined when the object is, the field when it isn't.
interface Cell {
	value: number;
	label: string;
}

const cells: Cell[] = [{ value: 3, label: 'three' }];
const found = cells[0]?.value;
const missing = cells[5]?.value;
console.log(`${found ?? -1} ${missing ?? -1} ${missing === undefined} ${cells[0]?.label ?? 'none'}`);
if (found !== undefined) {
	console.log(`${found * 2}`);
}

function sizeOf(cell: Cell | undefined): number {
	return (cell?.value ?? 0) + 1;
}
console.log(`${sizeOf(cells[0])} ${sizeOf(undefined)}`);
