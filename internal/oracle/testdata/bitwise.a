const values: number[] = [
	0,
	-0,
	1,
	-1,
	2147483647,
	-2147483648,
	4294967296,
	9007199254740992,
	9007199254740992 + 2,
	0 / 0,
	1 / 0,
	-1 / 0,
	0.5,
	-0.5,
	1.5,
	-1.5,
	2147483647.5,
];

let power = 1;
for (let exponent = 0; exponent <= 64; exponent += 1) {
	values.push(power - 1);
	values.push(power);
	values.push(power + 1);
	values.push(-power - 1);
	values.push(-power);
	values.push(-power + 1);
	power *= 2;
}

for (const value of values) {
	console.log(`~ ${value} ${~value}`);
	for (const right of values) {
		console.log(`& ${value} ${right} ${value & right}`);
		console.log(`| ${value} ${right} ${value | right}`);
		console.log(`^ ${value} ${right} ${value ^ right}`);
		console.log(`<< ${value} ${right} ${value << right}`);
		console.log(`>> ${value} ${right} ${value >> right}`);
		console.log(`>>> ${value} ${right} ${value >>> right}`);
	}
}

const shiftCounts: number[] = [];
for (let count = -1; count <= 33; count += 1) {
	shiftCounts.push(count);
}
shiftCounts.push(64);
for (const value of values) {
	for (const count of shiftCounts) {
		console.log(`count << ${value} ${count} ${value << count}`);
		console.log(`count >> ${value} ${count} ${value >> count}`);
		console.log(`count >>> ${value} ${count} ${value >>> count}`);
	}
}

interface Box {
	value: number;
}

let local = 4294967295;
local &= 2147483649;
console.log(`local &= ${local}`);
local |= 2;
console.log(`local |= ${local}`);
local ^= -1;
console.log(`local ^= ${local}`);
local <<= 33;
console.log(`local <<= ${local}`);
local >>= 1;
console.log(`local >>= ${local}`);
local >>>= 0;
console.log(`local >>>= ${local}`);

const field: Box = { value: 4294967295 };
field.value &= 2147483649;
console.log(`field &= ${field.value}`);
field.value |= 2;
console.log(`field |= ${field.value}`);
field.value ^= -1;
console.log(`field ^= ${field.value}`);
field.value <<= 33;
console.log(`field <<= ${field.value}`);
field.value >>= 1;
console.log(`field >>= ${field.value}`);
field.value >>>= 0;
console.log(`field >>>= ${field.value}`);

const elements = [4294967295];
if (elements[0] === undefined) {
	console.log('missing element');
} else {
	elements[0] &= 2147483649;
	console.log(`element &= ${elements[0] ?? -1}`);
	elements[0] |= 2;
	console.log(`element |= ${elements[0] ?? -1}`);
	elements[0] ^= -1;
	console.log(`element ^= ${elements[0] ?? -1}`);
	elements[0] <<= 33;
	console.log(`element <<= ${elements[0] ?? -1}`);
	elements[0] >>= 1;
	console.log(`element >>= ${elements[0] ?? -1}`);
	elements[0] >>>= 0;
	console.log(`element >>>= ${elements[0] ?? -1}`);
}

let order = '';
const orderedField: Box = { value: -1 };
function fieldTarget(): Box {
	order += 'target ';
	return orderedField;
}
function fieldRight(): number {
	order += `right:${orderedField.value} `;
	orderedField.value = 99;
	return 1;
}
fieldTarget().value >>>= fieldRight();
console.log(`${order}result:${orderedField.value}`);

order = '';
const orderedArray = [-1];
function arrayRight(): number {
	order += `right:${orderedArray[0] ?? -2} `;
	orderedArray[0] = 99;
	return 1;
}
if (orderedArray[0] === undefined) {
	console.log('missing ordered element');
} else {
	orderedArray[0] >>>= arrayRight();
	console.log(`${order}result:${orderedArray[0] ?? -2}`);
}
