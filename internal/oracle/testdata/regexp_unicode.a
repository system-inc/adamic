// A supplementary character is two units without u, and one with u. i and iu fold different letters.
function show(match: RegExpExecArray | null): string {
	if (match === null) {
		return 'null';
	}
	return `${match.index}:${match[0]}`;
}
console.log(show(/./.exec('a🌍b')));
console.log(show(/./u.exec('a🌍b')));
console.log(show(/🌍/.exec('a🌍b')));
console.log(show(/🌍/u.exec('a🌍b')));
console.log(show(/\ud83c/.exec('🌍')));
console.log(show(/\ud83c/u.exec('🌍')));
const units = 'a🌍b'.match(/./g);
const points = 'a🌍b'.match(/./gu);
console.log(`${units === null ? 'null' : units.join('|')}`);
console.log(`${points === null ? 'null' : points.join('|')}`);
console.log('a🌍b'.replace(/🌍/, '[$`][$&][$\']'));
console.log('a🌍b'.replace(/🌍/u, '[$`][$&][$\']'));
console.log(`${/k/i.test('K')} ${/k/iu.test('K')} ${/K/i.test('k')} ${/K/iu.test('k')} ${/K/i.test('K')}`);
console.log(`${/s/i.test('ſ')} ${/s/iu.test('ſ')} ${/ſ/i.test('s')} ${/ſ/iu.test('S')}`);
console.log(`${/i/i.test('İ')} ${/i/iu.test('İ')} ${/İ/i.test('i')} ${/İ/iu.test('i')} ${/I/iu.test('ı')} ${/I/i.test('İ')}`);
console.log(`${/σ/i.test('Σ')} ${/σ/iu.test('Σ')} ${/σ/i.test('ς')} ${/σ/iu.test('ς')} ${/ς/iu.test('Σ')} ${/ς/i.test('σ')}`);
console.log(`${/ß/i.test('ss')} ${/ß/iu.test('ss')} ${/ss/i.test('ß')} ${/ss/iu.test('ß')} ${/ß/i.test('ß')} ${/ß/iu.test('ß')}`);
console.log(`${/é/i.test('É')} ${/é/iu.test('É')} ${/ﬃ/i.test('FFI')} ${/ﬃ/iu.test('FFI')} ${/ﬃ/iu.test('ffi')}`);
