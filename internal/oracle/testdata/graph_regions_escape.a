interface EscapeNode { readonly label: string; parent: EscapeNode | undefined; child: EscapeNode | undefined; }
function tie(parent: EscapeNode, child: EscapeNode): void { parent.child = child; child.parent = parent; }
function run(): void {
 let root: EscapeNode | undefined = { label: `root${1}`, parent: undefined, child: undefined };
 const held: EscapeNode = { label: `held${2}`, parent: undefined, child: undefined };
 tie(root, held);
 root = undefined;
 console.log(`${held.parent?.label} ${held.parent?.child === held}`);
}
run();
console.log('after escape scope');
