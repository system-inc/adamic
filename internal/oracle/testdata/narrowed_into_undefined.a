// Reviewer R2, round three, i7/narrowed_reads_undefined.a: where a narrowing a call undid is read
// into a place typed to hold undefined (typeof, a parameter of Link | undefined, an element of
// (Link | undefined)[]), JavaScript goes on, and so does Adamic: no check there.
interface Link {
	readonly value: number;
}
let chain: Link | undefined = { value: 1 };
function drop(): void {
	chain = undefined;
}
function describe(link: Link | undefined): string {
	return link === undefined ? 'none' : `${link.value}`;
}
if (chain !== undefined) {
	drop();
	console.log(`typeof ${typeof chain}`);
}
chain = { value: 2 };
if (chain !== undefined) {
	drop();
	console.log(`passed ${describe(chain)}`);
}
chain = { value: 3 };
if (chain !== undefined) {
	drop();
	const kept: (Link | undefined)[] = [chain];
	console.log(`kept ${kept.length} ${kept[0] === undefined}`);
}
