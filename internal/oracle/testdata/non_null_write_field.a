class Box { value: number | undefined = undefined; }
const box = new Box();
box.value! = 5;
box.value! += 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! -= 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! *= 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! /= 2;
console.log(`${box.value!}`);
box.value! = 5;
box.value! %= 3;
console.log(`${box.value!}`);
box.value! = 2;
box.value! **= 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! &= 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! |= 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! ^= 3;
console.log(`${box.value!}`);
box.value! = 5;
box.value! <<= 1;
console.log(`${box.value!}`);
box.value! = 5;
box.value! >>= 1;
console.log(`${box.value!}`);
box.value! = -5;
box.value! >>>= 1;
console.log(`${box.value!}`);
box.value! = 0;
box.value! ||= 3;
box.value! &&= 4;
box.value! ??= 99;
console.log(`${box.value!}`);
