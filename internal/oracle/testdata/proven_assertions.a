type Leaf = { readonly kind: 'leaf'; readonly value: number };
type Branch = { readonly kind: 'branch'; readonly label: string };
type Node = Leaf | Branch;
function assertLeaf(node: Node): asserts node is Leaf {
	if (node.kind !== 'leaf') {
		throw new Error('expected leaf');
	}
}
function assertNumber(value: number | string): asserts value is number {
	if (typeof value === 'number') {
		return;
	}
	throw new Error('expected number');
}
function assertCondition(cond: boolean): asserts cond {
	if (!cond) {
		throw new Error('expected true');
	}
}
function show(node: Node): void {
	try {
		assertLeaf(node);
		console.log(`leaf ${node.value + 2}`);
	} catch {
		console.log('not leaf');
	}
}
show({ kind: 'leaf', value: 5 });
show({ kind: 'branch', label: 'oak' });
function number(value: number | string): void {
	try {
		assertNumber(value);
		console.log(`number ${value + 3}`);
	} catch {
		console.log('not number');
	}
}
number(7);
number('seven');
function condition(value: string | undefined): void {
	try {
		assertCondition(value !== undefined);
		console.log(value.toUpperCase());
	} catch {
		console.log('missing');
	}
}
condition('text');
condition(undefined);
