function argument(): number {
    console.log('argument');
    return 1;
}
try {
    Array.prototype.indexOf.call(undefined, argument());
}
catch(error) {
    if(error instanceof Error) {
        console.log(`${error.name}: ${error.message}`);
    }
}
try {
    Array.prototype.lastIndexOf.call(null, 1);
}
catch(error) {
    if(error instanceof Error) {
        console.log(`${error.name}: ${error.message}`);
    }
}
try {
    Array.prototype.copyWithin.call(null, 0, 1);
}
catch(error) {
    if(error instanceof Error) {
        console.log(`${error.name}: ${error.message}`);
    }
}
try {
    Array.prototype.reduceRight.call(undefined, (): number => 0, 0);
}
catch(error) {
    if(error instanceof Error) {
        console.log(`${error.name}: ${error.message}`);
    }
}
console.log(
    `${Array.prototype.every.call(3, (value: number): boolean => {
        console.log('unexpected every');
        return false;
    })}`,
);
console.log(
    `${Array.prototype.some.call(false, (value: number): boolean => {
        console.log('unexpected some');
        return true;
    })}`,
);
console.log(`${Array.prototype.findLastIndex.call(7, (value: number): boolean => true)}`);
console.log(`${Array.prototype.findLast.call(true, (value: number): boolean => true) === undefined}`);
console.log(`${Array.prototype.push.call(1)} ${Array.prototype.unshift.call(false)}`);
console.log(`${Array.prototype.pop.call(1) === undefined} ${Array.prototype.shift.call(true) === undefined}`);
console.log(
    `${Array.prototype.join.call(1, ',')} ${Array.prototype.toString.call(1)} ${Array.prototype.toString.call(false)}`,
);
console.log(`${[].toString.call(true)}`);
