// A defined locale never constructs silently (Runtime's must 1 on #zjndrx5): Node resolves the
// well-formed 'en' and goes on, and natively no locale is built, so both backends stop at the
// construction in the ruled form, Intl.Collator with a defined locale isn't built yet, after Node's
// first line.
console.log('before');
const collator = new Intl.Collator('en', { usage: 'sort', sensitivity: 'variant', numeric: true });
console.log(`collator ${typeof collator}`);
