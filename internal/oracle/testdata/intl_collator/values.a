// Object.values of a collator is [] on Node, which has no own property (#zjndrx5 head 1's C), where
// native's shape would hand out compare's closure: a compile-time NotYet by name.
const collator = new Intl.Collator(undefined, { usage: 'sort', sensitivity: 'variant', numeric: true });
console.log('collator');
console.log(`values ${Object.values(collator).length}`);
