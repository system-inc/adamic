interface Leaf { readonly kind: string; }
interface Node { parent: Leaf; }
class Reader { change(node: Node): void { console.log(`read${node.parent.kind.length}`); } }
class Writer extends Reader { override change(node: Node): void { node.parent = { kind: `new${2}` }; } }
function make(n: number): Node { return { parent: { kind: `override${n}` } }; }
function visit(node: Node, reader: Reader): void {
 const parent = node.parent;
 reader.change(node);
 console.log(parent.kind);
}
visit(make(1), new Reader());
visit(make(2), new Writer());
