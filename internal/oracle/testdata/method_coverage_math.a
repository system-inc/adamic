/* eslint-disable no-useless-call -- This program tests delayed call and literal apply adapters. */
const abs = Math.abs;
console.log(`${abs(0.5)}|${abs.call(null, 0.5)}|${abs.apply(undefined, [0.5])}`);
const ceil = Math.ceil;
console.log(`${ceil(0.5)}|${ceil.call(null, 0.5)}|${ceil.apply(undefined, [0.5])}`);
const floor = Math.floor;
console.log(`${floor(0.5)}|${floor.call(null, 0.5)}|${floor.apply(undefined, [0.5])}`);
const round = Math.round;
console.log(`${round(0.5)}|${round.call(null, 0.5)}|${round.apply(undefined, [0.5])}`);
const trunc = Math.trunc;
console.log(`${trunc(0.5)}|${trunc.call(null, 0.5)}|${trunc.apply(undefined, [0.5])}`);
const sign = Math.sign;
console.log(`${sign(0.5)}|${sign.call(null, 0.5)}|${sign.apply(undefined, [0.5])}`);
const sqrt = Math.sqrt;
console.log(`${sqrt(0.5)}|${sqrt.call(null, 0.5)}|${sqrt.apply(undefined, [0.5])}`);
const pow = Math.pow;
console.log(`${pow(0.5, 0.5)}|${pow.call(null, 0.5, 0.5)}|${pow.apply(undefined, [0.5, 0.5])}`);
const sin = Math.sin;
console.log(`${sin(0.5)}|${sin.call(null, 0.5)}|${sin.apply(undefined, [0.5])}`);
const cos = Math.cos;
console.log(`${cos(0.5)}|${cos.call(null, 0.5)}|${cos.apply(undefined, [0.5])}`);
const tan = Math.tan;
console.log(`${tan(0.5)}|${tan.call(null, 0.5)}|${tan.apply(undefined, [0.5])}`);
const asin = Math.asin;
console.log(`${asin(0.5)}|${asin.call(null, 0.5)}|${asin.apply(undefined, [0.5])}`);
const acos = Math.acos;
console.log(`${acos(0.5)}|${acos.call(null, 0.5)}|${acos.apply(undefined, [0.5])}`);
const atan = Math.atan;
console.log(`${atan(0.5)}|${atan.call(null, 0.5)}|${atan.apply(undefined, [0.5])}`);
const atan2 = Math.atan2;
console.log(`${atan2(0.5, 0.5)}|${atan2.call(null, 0.5, 0.5)}|${atan2.apply(undefined, [0.5, 0.5])}`);
