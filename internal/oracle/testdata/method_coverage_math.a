console.log(`${sinh(0.5)}|${sinh.call(null, 0.5)}|${sinh.apply(undefined, [0.5])}`);
const cosh = Math.cosh;
console.log(`${cosh(0.5)}|${cosh.call(null, 0.5)}|${cosh.apply(undefined, [0.5])}`);
const tanh = Math.tanh;
console.log(`${tanh(0.5)}|${tanh.call(null, 0.5)}|${tanh.apply(undefined, [0.5])}`);
const asinh = Math.asinh;
console.log(`${asinh(0.5)}|${asinh.call(null, 0.5)}|${asinh.apply(undefined, [0.5])}`);
const acosh = Math.acosh;
console.log(`${acosh(0.5)}|${acosh.call(null, 0.5)}|${acosh.apply(undefined, [0.5])}`);
const atanh = Math.atanh;
