import { statSync, readdirSync, type Stats, type Dirent } from 'node:fs';

function inspect(value: Stats | Dirent | undefined): void {
    if (value !== undefined) {
        console.log(`${value.isFile()} ${value.isDirectory()} ${value.isSymbolicLink()}`);
    } else { console.log('absent'); }
}
function reverse(value: Dirent | Stats | undefined): void {
    if (value !== undefined) {
        console.log(`${value.isFile()} ${value.isDirectory()} ${value.isSymbolicLink()}`);
    }
}
let value: Stats | Dirent | undefined;
inspect(value);
for (const entry of readdirSync('walking', { withFileTypes: true })) {
    value = entry;
    console.log(entry.name);
    inspect(value);
    reverse(value);
    value = statSync('walking/' + entry.name, { throwIfNoEntry: false });
    inspect(value);
    reverse(value);
}
