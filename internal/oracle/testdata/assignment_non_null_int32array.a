import { panic } from 'adamic';
let holder = new Int32Array([1]);
let receiverCalls = 0;
let indexCalls = 0;
let rightCalls = 0;
function receiver(): Int32Array { receiverCalls += 1; return holder; }
function index(): number { indexCalls += 1; return 0; }
function right(): number { rightCalls += 1; holder[0] = 32; return 2; }
function update(): void {
 const held = receiver();
 const position = index();
 const old = held[position] ?? panic('missing');
 held[position] = old | right();
}
update();
console.log(`${holder[0]}:${receiverCalls}:${indexCalls}:${rightCalls}`);
