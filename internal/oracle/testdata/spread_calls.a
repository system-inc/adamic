// Spread arguments to the calls that take any number of numbers, evaluated in order with the others.
const values = [3, 9, 1];
const none: number[] = [];
const edges = [-0, 0, NaN];
const signed = [-0, -0];
console.log(`${Math.max(...values)} ${Math.min(...values, 0)} ${Math.max(10, ...values)} ${Math.max(...none)} ${Math.min(...none)}`);
console.log(`${Math.max(...edges)} ${1 / Math.max(...signed)} ${1 / Math.min(0, ...signed)} ${Math.hypot(...[3, 4])} ${Math.hypot(...none)} ${Math.max(...[-Infinity])}`);
const codes = [72, 105, 0xd83c, 0xdf0d];
console.log(`${String.fromCharCode(...codes)} ${String.fromCodePoint(...[0x1f30d], 33)} ${String.fromCharCode(...none).length}`);
let calls = 0;
function counted(value: number): number {
	calls++;
	return value;
}
console.log(`${Math.max(counted(1), ...values, counted(2))} ${calls}`);
