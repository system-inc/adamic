// readDirectory and fileStatus: a walk of walking/, a directory's names in Node's order (sorted by
// their bytes, hidden ones included, without . and ..), each name's type and size with a symbolic
// link followed and said, and every failure in Adamic's words. The oracle gives this program a
// directory of its own as its first argument (input_test.go), holding locked, which it can list,
// unlisted, which it can't, and closed, which it can't even enter; messages name it <dir>.
import { fileStatus, panic, programArguments, readDirectory } from 'adamic';

const directory = programArguments()[0] ?? panic('pass a directory to walk beside');

function shown(path: string): string {
	return path.replace(directory, '<dir>');
}

function walk(path: string, depth: number): void {
	const listing = readDirectory(path);
	if (listing.kind === 'Error') {
		console.log(`${'  '.repeat(depth)}${shown(listing.message)}`);
		return;
	}
	console.log(`${'  '.repeat(depth)}${shown(path)}: ${listing.names.length} names, ${listing.names.join(' ')}`);
	for (const name of listing.names) {
		if (name.includes('\uFFFD')) {
			// A name that wasn't valid UTF-8 comes back with U+FFFD for the bad byte, and that name no
			// longer reaches the file, on Node as here. (Where the file system won't hold such a name,
			// the oracle makes the file under the decoded name instead, which would reach it; it isn't
			// looked up, so every machine prints and counts the same.)
			console.log(`${'  '.repeat(depth + 1)}${name}: not looked up`);
			continue;
		}
		const inside = `${path}/${name}`;
		const status = fileStatus(inside);
		if (status.kind === 'Error') {
			console.log(`${'  '.repeat(depth + 1)}${shown(status.message)}`);
			continue;
		}
		// A directory's own size depends on the file system, the same for every run on one machine;
		// a file's is its length.
		const size = status.type === 'file' ? `${status.size} bytes` : `${status.size >= 0}`;
		console.log(`${'  '.repeat(depth + 1)}${name}: ${status.type}, ${size}${status.symbolicLink ? ', a symbolic link' : ''}`);
		if (status.type === 'directory' && !status.symbolicLink) {
			walk(inside, depth + 2);
		}
	}
}

walk('walking', 0);
walk(directory, 0);

const failures = [
	readDirectory('walking/a.txt'),
	readDirectory('walking/missing'),
	readDirectory('walking/dangling'),
	readDirectory(''),
	readDirectory('walking\u0000'),
	readDirectory(`${directory}/unlisted`),
	readDirectory(`${directory}/closed`),
];
for (const failure of failures) {
	console.log(failure.kind === 'Error' ? shown(failure.message) : `listed ${failure.names.join(',')}`);
}
const statuses = [
	fileStatus('walking/missing/inside'),
	fileStatus('walking/a.txt/inside'),
	fileStatus(''),
	fileStatus('walking/\u0000'),
	fileStatus(`${directory}/closed/inside`),
	fileStatus(`${directory}/unlisted/inside`),
	fileStatus('/dev/null'),
	fileStatus('walking/link-to-inner'),
	fileStatus('walking/\uD800'),
];
for (const status of statuses) {
	console.log(status.kind === 'Error' ? shown(status.message) : `${status.type} ${status.symbolicLink}`);
}
