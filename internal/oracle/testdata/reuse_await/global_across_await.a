// A global read before an await and written after it, while another task writes it during the
// suspension (Memory's question 1 on #qk8rztp S2c-2b). grow reads g, a1, then awaits later(), and
// swap writes g while grow is suspended. Node prints a1x2|b3, then a1x2: grow's read comes before
// the await, and its write comes last. Natively flow.NormalizeAsync snapshots every operand before
// a suspension into a frame cell that owns what it holds, so grow keeps a1 counted across the await
// whatever reuse says, and swap's write can't free it. Reuse's await case is therefore not this
// program's guard: native/reuse.go's movable meets no await in a normalized instruction, and
// touches meets one only in an async callee, whose frame owns its parameters. The two tasks are
// awaited in one expression after both are made, as async_review/accepted/concurrent.a's are, each
// catching what it awaits, so neither completion escapes before both are awaited.
let g = `a${String(1)}`;
async function later(): Promise<string> {
    await Promise.resolve();
    return `x${String(2)}`;
}
async function grow(): Promise<string> {
    try {
        g = g + await later();
        return g;
    } catch (error) {
        if (error instanceof Error) { return `caught:${error.message}`; }
        return "wrong error";
    }
}
async function swap(): Promise<string> {
    try {
        await Promise.resolve();
        g = `b${String(3)}`;
        return g;
    } catch (error) {
        if (error instanceof Error) { return `caught:${error.message}`; }
        return "wrong error";
    }
}
const one = grow();
const two = swap();
console.log(`${await one}|${await two}`);
console.log(g);
