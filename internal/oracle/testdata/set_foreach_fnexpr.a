// Set.forEach with a function expression. The element is passed twice and kept after delete.
function key(index: number): string { return `key${index}`; }

const collection = new Set<string>();
for (let index = 0; index < 4; index += 1) {
	collection.add(key(index));
}
const kept: string[] = [];
collection.forEach(function visit(item: string, current: string, owner: Set<string>): string {
	if (current === "key0") { owner.delete(key(1)); }
	if (current === "key0") { owner.add(key(4)); }
	owner.delete(current);
	kept.push(item);
	kept.push(current);
	console.log(`visit ${item} ${current} ${item === current} ${owner.size}`);
	return item;
});
console.log(`kept ${kept.join(",")} remaining ${collection.size}`);
const after: string[] = [];
collection.forEach((item) => { after.push(item); });
console.log(`after ${after.join(",")}`);
