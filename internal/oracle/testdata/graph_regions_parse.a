interface ParseNode {
 readonly name: string;
 parent: ParseNode | undefined;
 children: ParseNode[];
}
function attach(parent: ParseNode, child: ParseNode): void {
 child.parent = parent;
 parent.children.push(child);
}
function parse(): void {
 const root: ParseNode = { name: `root${1}`, parent: undefined, children: [] };
 const child: ParseNode = { name: `child${2}`, parent: undefined, children: [] };
 const leaf: ParseNode = { name: `leaf${3}`, parent: undefined, children: [] };
 attach(root, child); attach(child, leaf);
 console.log(`${root.children[0]?.name} ${leaf.parent?.parent?.name}`);
 root.children[0] = leaf;
 console.log(`${root.children[0]?.name} ${child.parent?.name}`);
}
parse();
