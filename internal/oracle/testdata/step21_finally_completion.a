// Return-through-finally from utilities.ts:787, extended with completion replacement controls.
function result(index: number): string {
    try {
        if (index === 1) throw new Error(`discard${index}`);
        return `try${index}`;
    } finally {
        if (index > 0) return `finally${index}`;
    }
}
for (const index of [0, 1, 2]) console.log(result(index));
for (let index = 0; index < 3; index += 1) {
    try { throw new Error(`break${index}`); }
    finally { console.log(`cleanup${index}`); break; }
}
console.log('after');
