import { panic } from 'adamic';
let getterCalls = 0;
let setterCalls = 0;
class Holder {
 value = ['old'].join('');
 get item(): string | undefined { getterCalls += 1; return this.value; }
 set item(value: string | undefined) { setterCalls += 1; this.value = value ?? ''; }
}
let holder = new Holder();
let receiverCalls = 0;
let indexCalls = 0;
let rightCalls = 0;
function receiver(): {item:string | undefined} { receiverCalls += 1; return holder; }
function index(): number { indexCalls += 1; return 0; }
function right(): string | undefined { rightCalls += 1; holder.item = ['changed'].join(''); return rightCalls % 2 === 0 ? undefined : ['right'].join(''); }
function update(): void {
 const held = receiver();
 const old = held.item ?? panic('missing');
 held.item = old + right();
}
update(); update();
console.log(`${holder.item}:${receiverCalls}:${indexCalls}:${rightCalls}:${getterCalls}:${setterCalls}`);
