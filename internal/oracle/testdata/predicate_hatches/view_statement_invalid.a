interface Node { readonly kind: number }
interface Statement extends Node { readonly label: string }
const accepted: boolean = true;
function opaque(kind: number): boolean { return accepted; }
function isStatement(node: Node): node is Statement { return opaque(node.kind); }
function cast(node: Node, test: (node: Node) => node is Statement): Statement {
    if (test(node)) { return node; }
    throw new Error('not an statement');
}
const original = { kind: 1, label: 42 };
const node: Node | undefined = original;
console.log(cast(node!, isStatement).kind === 1 ? '1' : 'other');
console.log(cast(node!, isStatement).label);
