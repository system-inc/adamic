interface Leaf { text: string; }
interface Root { readonly child: Leaf; }
function inspect(root: Root): void {
 const child = root.child;
 const copied = { ...child, text: `copy${2}` };
 console.log(`${child.text} ${copied.text} ${root.child.text}`);
}
function consume(root: Root): string { return root.child.text; }
function local(): void {
 const root: Root = { child: { text: `owned${1}` } };
 const child = root.child;
 console.log(consume(root));
 console.log(child.text);
}
inspect({ child: { text: `original${1}` } });
local();
