// The literal leaves pending out, so the object has no slot for it, and the write would find none
// (a panic natively). Node prints undefined, then false. Optional presence lifts this.
interface State {
	pending?: boolean;
	errors: boolean;
}
const state: State = { errors: true };
console.log(String(state.pending));
state.pending = false;
console.log(String(state.pending));
