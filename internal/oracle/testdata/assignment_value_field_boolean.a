const holder: { item: boolean } = { item: false };
let calls = 0;
function receiver(): { item: boolean } { calls += 1; return holder; }
function show(value: boolean): string { return `${value}`; }
const assigned = (receiver().item = true);
console.log(show(assigned));
console.log(show(holder.item));
console.log(`calls:${calls}`);
const saved = (receiver().item = true);
holder.item = false;
console.log(show(saved));
