// fileStatus of stdout itself, after a line is printed: Node has written the line, so the file it
// names is 26 bytes long, and native's buffer must be out before the status is taken, as it is
// before a file is read or written (output_test.go runs this with stdout a file).
import { fileStatus, readDirectory } from 'adamic';

console.log('written before the status');
const status = fileStatus('/dev/stdout');
console.log(status.kind === 'Ok' ? `${status.type} ${status.size}` : status.message);
console.log('and before a listing');
const listing = readDirectory('.');
console.log(listing.kind === 'Ok' ? `listed ${listing.names.length > 0}` : listing.message);
const again = fileStatus('/dev/stdout');
console.log(again.kind === 'Ok' ? `${again.type} ${again.size}` : again.message);
