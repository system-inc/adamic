enum SyntaxKind { First, Last }
function other(): SyntaxKind {
    console.log('lookup');
    const value: number = 42;
    return value;
}
function describe(): number {
    switch (other()) {
        case SyntaxKind.First: return 10;
        case SyntaxKind.Last: return 20;
    }
}
console.log('before');
console.log(`${describe()}`);
