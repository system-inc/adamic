// A map that writes its results over a unique array's elements (reuse.go's mapped) with a rest packed
// in each iteration (#9grybqc): spread's type is admitted by the callback's, so each call collects
// spread's rest from the element, the index's number and the array. The pack holds the element the
// result replaces, and lets go of it at the iteration's end. Node prints:
//
//	string:x;number:1;object:y,z
//	word0!0 word1!1 word2!2
//	word0!0
const spread = (...items: (string | number | string[])[]): string =>
	items.map((item) => typeof item + ':' + (Array.isArray(item) ? item.join(',') : String(item))).join(';');
console.log(spread('x', 1, ['y', 'z']));
function shouted(count: number): string {
	const words: string[] = [];
	for (let index = 0; index < count; index++) {
		words.push(`word${index}`);
	}
	const loud = words.map((word, index) => `${word}!${index}`);
	return loud.join(' ');
}
console.log(shouted(3));
console.log(shouted(1));
