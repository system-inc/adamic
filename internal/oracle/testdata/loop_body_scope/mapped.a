// A map that writes its results over a unique array's elements (reuse.go's mapped) with a rest packed
// in each iteration (#9grybqc). shouted's words is a local nothing reads after the map, so the plan
// takes it over, as reuse_arrays.a's shouted. Its callback's type, (word: string, index: number) =>
// string, admits joined, a rest function of the program's (and spread), so each call collects a rest
// from the element, the index's number and the array, which the callback never reads. The pack holds
// the element the result replaces, and lets go of it at the iteration's end. Node prints:
//
//	string:x;number:1;object:y,z
//	w+2
//	word0!0 word1!1 word2!2
//	word0!0
const spread = (...items: (string | number | string[])[]): string =>
	items.map((item) => typeof item + ':' + (Array.isArray(item) ? item.join(',') : String(item))).join(';');
const joined = (...items: (string | number)[]): string => items.map((item) => String(item)).join('+');
console.log(spread('x', 1, ['y', 'z']));
console.log(joined('w', 2));
function shouted(count: number): string {
	const words: string[] = [];
	for (let index = 0; index < count; index++) {
		words.push(`word${index}`);
	}
	const loud = words.map((word: string, index: number): string => `${word}!${index}`);
	return loud.join(' ');
}
console.log(shouted(3));
console.log(shouted(1));
