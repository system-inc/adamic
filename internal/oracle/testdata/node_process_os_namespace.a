import * as _os from 'node:os';
import * as proc from 'node:process';
import defaultProcess from 'node:process';
console.log(_os.platform());
console.log(JSON.stringify(_os.EOL));
console.log(String(_os.tmpdir().length > 0));
console.log(String(proc.cwd() === defaultProcess.cwd()));
console.log(defaultProcess.env.ADAMIC_PROCESS_NAMESPACE_MISSING ?? 'absent');

// TypeScript sys.ts's System.newLine shape, including diagnostic concatenation.
const nodeSystem = { newLine: _os.EOL };
console.log(JSON.stringify(nodeSystem.newLine));
console.log("Version 6.0.3" + nodeSystem.newLine + "diagnostic" + nodeSystem.newLine);
