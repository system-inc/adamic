// A function expression is the callback, not an arrow and not a module function.
function key(index: number): string { return `key${index}`; }
function value(index: number): string { return `value${index}`; }

const collection = new Map<string, string>();
for (let index = 0; index < 4; index += 1) {
	collection.set(key(index), value(index));
}
const kept: string[] = [];
collection.forEach(function visit(item: string, current: string, owner: Map<string, string>): string {
	if (current === "key0") { owner.delete(key(1)); }
	if (current === "key2") { owner.set(current, `changed${current}`); }
	owner.delete(current);
	kept.push(current);
	kept.push(item);
	console.log(`visit ${current} ${item} ${owner.size}`);
	return item;
});
console.log(`kept ${kept.join(",")} remaining ${collection.size}`);
const added = new Map<string, string>();
added.set(key(0), value(0));
try {
	added.forEach(function (item: string, current: string, owner: Map<string, string>): void {
		owner.clear();
		kept.push(current);
		throw new Error(`cleared ${current} ${item}`);
	});
} catch (error) {
	console.log(error instanceof Error ? error.message : "unexpected");
}
console.log(`after throw ${kept.join(",")} ${added.size}`);
