// a-check: refused an object refinement using an open numeric enum as a literal tag
// Two paths reach the read: one narrows by kind, which proves the layout, and one by an alias of
// tag, an open enum in A. The alias path takes a, whose tag holds BKind.B's number: Node prints text1.
enum Kind { A, B }
enum AKind { A }
enum BKind { B = 1, C = 2 }
interface A { readonly kind: Kind.A; readonly tag: AKind; readonly value: string }
interface B { readonly kind: Kind.B; readonly tag: BKind.B; readonly value: number }
type Pair = A | B;
function numeric(): number { return 1; }
const a: A = { kind: Kind.A, tag: numeric(), value: 'text' };
function show(v: Pair, byKind: boolean): void {
	const isB = v.tag === BKind.B;
	if (byKind) {
		if (v.kind !== Kind.B) return;
	} else {
		if (!isB) return;
	}
	console.log(`${v.value + 1}`);
}
show(a, false);
