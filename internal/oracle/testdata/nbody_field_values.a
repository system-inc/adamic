// Reference replacement must retain the new value before releasing the old slot.
interface Payload { text: string; }
class Holder {
    label = `label${1}`;
    flag = false;
    amount: number | undefined = 0;
    payload: Payload = { text: `payload${2}` };
    list = [`item${3}`];
    map = new Map<string, string>([['key', `map${4}`]]);
}
const holder = new Holder();
holder.label = holder.label;
holder.payload = holder.payload;
holder.list = holder.list;
holder.map = holder.map;
holder.flag = true;
holder.amount = undefined;
console.log(`${holder.label}/${holder.flag}/${holder.amount}/${holder.payload.text}/${holder.list.join(',')}/${holder.map.get('key')}`);
holder.label = `new${5}`;
holder.payload = { text: holder.label };
holder.list = [holder.payload.text];
holder.map = new Map<string, string>([['key', holder.list[0] ?? 'missing']]);
holder.amount = -0;
console.log(`${holder.label}/${holder.amount}/${holder.payload.text}/${holder.list.join(',')}/${holder.map.get('key')}`);
