function check(start: number): string {
 const text = 'value' + String(start);
 const words = [text]; const item = { label: text + '!' };
 const byName = new Map<string, string>(); byName.set('key', text);
 const names = new Set<string>(); names.add(text);
 function read(): string { return `${text}:${words.join(',')}:${item.label}:${byName.get('key') ?? ''}:${names.has(text)}`; }
 if (start === 0) { throw new Error(read()); }
 return read();
}
for (const start of [0, 1]) {
 try { console.log(check(start)); }
 catch (error) { if (error instanceof Error) { console.log(error.message); } }
}
