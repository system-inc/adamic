interface Root { child: { text: string }; }
function inspect(root: Root): void {
 for (let n = 0; n < 2; n++) {
  const child = root.child;
  try { console.log(child.text); }
  finally { root.child = { text: `iteration${n}` }; }
  console.log(child.text);
 }
}
inspect({ child: { text: `start${1}` } });
