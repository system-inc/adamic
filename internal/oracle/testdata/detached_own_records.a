const hasOwnProperty = Object.prototype.hasOwnProperty;
function hasProperty(map: Record<string, number>, key: string): boolean {
    return hasOwnProperty.call(map, key);
}
const map: Record<string, number> = {value: 1, ["constructor"]: 2};
console.log(String(hasProperty(map, "value")));
console.log(String(hasProperty(map, "missing")));
console.log(String(hasProperty(map, "toString")));
console.log(String(hasProperty(map, "constructor")));
console.log(String(Object.prototype.hasOwnProperty.call(map, "value")));
console.log(String(Object.prototype.hasOwnProperty.call(map, "toString")));
const key = "toString";
if (hasOwnProperty.call(map, key)) {
    console.log(String(map[key]));
}
function snapshot(): void {
    const value = map[key];
    if (hasOwnProperty.call(map, key)) {
        console.log(String(value));
    }
}
snapshot();
console.log("ok");
