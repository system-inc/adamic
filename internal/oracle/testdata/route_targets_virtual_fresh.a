// Every virtual producer returns fresh, but its ABI must stay on the heap.
interface Item { readonly label: string; }
function make(index: number): Item { return { label: `made${index}` }; }
let saved: Item | undefined;
class Base {
    make(index: number): Item { return make(index); }
    use(item: Item): number { return item.label.length; }
    replace(item: Item): Item { return item; }
}
class Child extends Base {
    override make(index: number): Item { return { label: `child${index}` }; }
    override replace(item: Item): Item { return { ...item, label: `${item.label}!` }; }
}
class Grandchild extends Child {
    override make(index: number): Item { return make(index + 100); }
    override use(item: Item): number { saved = item; return item.label.length; }
}
class Sibling extends Base {
    override use(item: Item): number { return item.label.length + 1; }
}
function produce(base: Base, index: number): Item { return base.make(index); }
function size(item: Item): number { return item.label.length; }
function run(base: Base, index: number): void {
    console.log(`${size(produce(base, index))}/${base.use(make(index))}`);
    const item = make(index + 10);
    console.log(base.replace(item).label);
    console.log(saved?.label ?? 'none');
}
run(new Base(), 0);
run(new Child(), 1);
run(new Grandchild(), 2);
run(new Sibling(), 3);
console.log(saved?.label ?? 'none');
