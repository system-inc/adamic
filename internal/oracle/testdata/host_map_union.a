const values = new Map<string, string | number>([['one', 1], ['text', 'x']]);
console.log(`${values.get('one')} ${values.get('text')} ${values.get('missing')}`);
values.set('one', 0);
values.set('text', '');
values.set('new', 'new');
for (const [key, value] of values.entries()) { console.log(`${key}:${value}:${typeof value}`); }
for (const value of values.values()) { console.log(`value:${value}:${typeof value}`); }
for (const entry of [...values.entries()]) { if (entry !== undefined) { const [key, value] = entry; console.log(`copy:${key}:${value}`); } }
values.forEach((value, key, map): void => { map.set(key, 9); console.log(`visit:${key}:${value}:${map.get(key)}`); });
for (const [key, value] of values) { console.log(`after:${key}:${value}`); }
values.delete('one');
console.log(`${values.has('one')} ${values.get('one')}`);
const optional = new Map<string, number | string | boolean | undefined>();
optional.set('false', false); optional.set('missing', undefined); optional.set('zero', 0); optional.set('text', 'x');
for (const [key, value] of optional) { console.log(`${key}:${value}:${typeof value}`); }
console.log(`${optional.has('missing')} ${optional.get('missing')} ${optional.get('absent')}`);
