const byArrow: (() => number)[] = [];
const byFunction: (() => number)[] = [];
for (let index = 0; index < 4; index += 1) {
	byArrow.push(() => index);
	byFunction.push(function (): number { return index; });
}
console.log(byArrow.map(function (call): string { return `${call()}`; }).join(','));
console.log(byFunction.map(function (call): string { return `${call()}`; }).join(','));

let shared = 0;
const lateArrow: (() => number)[] = [];
const lateFunction: (() => number)[] = [];
for (let step = 0; step < 3; step += 1) {
	shared = step;
	lateArrow.push(() => shared);
	lateFunction.push(function (): number { return shared; });
}
console.log(lateArrow.map((call) => `${call()}`).join(','));
console.log(lateFunction.map((call) => `${call()}`).join(','));

const numbers = [10, 20, 30];
const ofArrow: (() => number)[] = [];
const ofFunction: (() => number)[] = [];
for (const value of numbers) {
	ofArrow.push(() => value);
	ofFunction.push(function (): number { return value; });
}
console.log(ofArrow.map((call) => `${call()}`).join(','));
console.log(ofFunction.map((call) => `${call()}`).join(','));

const bag = { a: 1, b: 2, c: 3 };
const inArrow: (() => string)[] = [];
const inFunction: (() => string)[] = [];
for (let key in bag) {
	inArrow.push(() => key);
	inFunction.push(function (): string { return key; });
}
console.log(inArrow.map((call) => call()).join(','));
console.log(inFunction.map((call) => call()).join(','));

let outer = 'start';
const outerArrow: (() => string)[] = [];
const outerFunction: (() => string)[] = [];
for (outer in bag) {
	outerArrow.push(() => outer);
	outerFunction.push(function (): string { return outer; });
}
console.log(outerArrow.map((call) => call()).join(','));
console.log(outerFunction.map((call) => call()).join(','));
console.log(outer);

const nestedArrow: (() => string)[] = [];
const nestedFunction: (() => string)[] = [];
for (let left = 0; left < 2; left += 1) {
	for (let right = 0; right < 2; right += 1) {
		nestedArrow.push(() => `${left}:${right}`);
		nestedFunction.push(function (): string { return `${left}:${right}`; });
	}
}
console.log(nestedArrow.map((call) => call()).join(','));
console.log(nestedFunction.map((call) => call()).join(','));
