let count = 0;
function side(): string { count += 1; return `side${count}`; }
console.log(`${void side() === undefined} ${count}`);
void side();
console.log(`${count}`);
void (count += 2);
void (count++);
void console.log(`console ${count}`);
const missing = void side();
console.log(`${missing === undefined} ${typeof missing} ${count}`);
const maybe: number | undefined = void side();
console.log(`${maybe === undefined} ${count}`);
function done(): void { return void side(); }
done();
console.log(`${count}`);
try { void fail(); } catch (error) { if (error instanceof Error) { console.log(error.message); } } finally { console.log('void finally'); }
function fail(): number { count += 1; throw new Error(`void throws ${count}`); }
class Box { readonly name: string; constructor() { this.name = side(); console.log(this.name); } }
void new Box();
void [side(), side()];
console.log(`${void (side(), side()) === undefined} ${count}`);
