class Parent {
    readonly label: string;
    child: Child | undefined = undefined;
    constructor(label: string) { this.label = label; }
    read(): string { return this.label; }
}
class Child extends Parent {
    readonly detail: string;
    constructor(label: string) { super(label + '/parent'); this.detail = label + '/child'; }
    override read(): string { return super.read() + '/' + this.detail; }
}
class Grandchild extends Child {
    override read(): string { return super.read() + '/grandchild'; }
}
function family(index: number): void {
    const parent = new Parent(`root${index}`);
    parent.child = new Child(`first${index}`);
    console.log(`${parent.read()}/${parent.child.read()}`);
    const saved = parent.child;
    parent.child = new Grandchild(`second${index}`);
    console.log(`${saved.read()}/${parent.child.read()}`);
    parent.child = undefined;
    console.log(`${saved.read()}/${parent.child === undefined}`);
}
for (const index of [1, 2, 3]) { family(index); }
