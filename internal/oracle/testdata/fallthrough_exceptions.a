function attempt(code: number): string {
 let text = `start${code}`;
 try {
  switch (code) {
   case 0: text += ':zero';
   case 1: text += ':one'; throw new Error(text);
   default: text += ':default';
   case 2: return text;
  }
 } catch (error) { if (error instanceof Error) { return error.message; } }
 return text;
}
console.log(`${attempt(0)} ${attempt(1)} ${attempt(2)} ${attempt(3)}`);
let total = 0;
for (let n = 0; n < 3; n++) {
 const held = { text: `held${n}` };
 try {
  switch (n) {
   case 0: total += held.text.length;
   case 1: total += 10; continue;
   default: total += 100;
  }
  total += 1000;
 } finally { total += held.text.length; }
}
console.log(`${total}`);
