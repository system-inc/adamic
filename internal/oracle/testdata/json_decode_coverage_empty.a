import { decodeJson } from 'adamic';
for (const text of ['{}', '{"ignored":{"a":[null,true,1,"x"]}}', '[]', 'null', '{"ignored":[1,]}']) {
 const r = decodeJson<{}>(text);
 console.log(r.kind === 'Error' ? r.message : Object.keys(r.value).join(','));
}
for (const text of ['[]', '[true,false]', '[true,1]', 'false']) {
 const r = decodeJson<boolean[]>(text);
 if (r.kind === 'Error') console.log(r.message);
 else { const values = r.value; values.push(true); console.log(values.join(',')); }
}
