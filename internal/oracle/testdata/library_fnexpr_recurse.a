let slot = function self(n: number): number {
	return n <= 1 ? n : self(n - 1) + self(n - 2);
};
const kept = slot;
slot = function (n: number): number { return n; };
console.log(`${kept(6)} ${slot(6)}`);

function self(n: number): number { return n + 100; }
const inner = function self(n: number): number {
	return n <= 0 ? 0 : n + self(n - 1);
};
console.log(`${inner(4)} ${self(4)}`);

const walk = function walk(n: number): number {
	const step = function (next: (k: number) => number, left: number): number { return next(left); };
	return n <= 0 ? 0 : n + step(walk, n - 1);
};
console.log(`${walk(5)}`);

function apply(fn: (n: number) => number, n: number): number {
	return fn(n);
}
const fact = function fact(n: number): number {
	return n <= 1 ? 1 : n * apply(fact, n - 1);
};
console.log(`${fact(6)}`);

const sum = function sum(n: number): number {
	const calls: ((n: number) => number)[] = [];
	calls.push(sum);
	const call = calls[0];
	if (call === undefined) {
		return n;
	}
	return n <= 0 ? 0 : n + call(n - 1);
};
console.log(`${sum(4)}`);
