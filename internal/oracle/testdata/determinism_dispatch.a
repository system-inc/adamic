// TestStage0EmitsDeterministically's witness, emitted and never run: twelve classes of eight methods, each class's
// dispatch map its own, so a stage 0 that lists methods in map order emits this C a different way nearly every time.
class Alder {
    readonly base: number;
    constructor(base: number) { this.base = base; }
    north(): number { return this.base + 0; }
    east(): number { return this.base + 1; }
    south(): number { return this.base + 2; }
    west(): number { return this.base + 3; }
    up(): number { return this.base + 4; }
    down(): number { return this.base + 5; }
    inward(): number { return this.base + 6; }
    outward(): number { return this.base + 7; }
}
