function lower(match: string): string { return match.toLowerCase(); }
console.log("ONE TWO".replace(/[A-Z]+/g, lower));
console.log("abc".replace(/(b)/, (match: string) => "[" + match + "]"));
console.log("aba".replaceAll(/a/g, () => "$&"));
const reset = /a/g;
reset.lastIndex = 2;
console.log("aba".replace(reset, (match: string) => `${reset.lastIndex}:${match}`));
console.log(`${reset.lastIndex}`);
let calls = 0;
const gathered = /a/g;
console.log("aba".replace(gathered, (match: string) => { calls += 1; gathered.lastIndex = 99; return `${calls}:${match}`; }));
console.log(`${gathered.lastIndex}`);
console.log("abc".replace(/(?:)/g, () => "-"));
console.log("😀x".replace(/(?:)/gu, () => "-"));
console.log("😀x".replace(/(?:)/g, () => "-"));
const sticky = /a/y;
sticky.lastIndex = 1;
console.log("baa".replace(sticky, lower));
console.log(`${sticky.lastIndex}`);
console.log("no match".replace(/z/g, lower));
console.log("aaa".replace(/a/, () => "!"));
