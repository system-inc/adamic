import { encodeJson, decodeJson, panic } from 'adamic';
for (const value of [0, 0.1 + 0.2, 1e21, 5e-324, -0, 9007199254740993, -1e-7, 1.7976931348623157e308]) {
 const text = encodeJson<number>(value);
 console.log(text);
 const decoded = decodeJson<number>(text);
 if (decoded.kind !== 'Ok') panic('number round trip failed');
 if (encodeJson<number>(decoded.value) !== text) panic('number re-encode differs');
}
for (const value of [NaN, Infinity, -Infinity]) {
 const text = encodeJson<number>(value);
 console.log(text);
 // Nonfinite values are excluded from round trips; the independent witness
 // still compares their encoded text with Node JSON.stringify. Keep decodeJson
 // rejecting null: changing null support is a separate language decision.
 if (decodeJson<number>(text).kind !== 'Error') panic('nonfinite JSON must fail numeric decode');
}
for (const value of ['quote"slash\\', '\b\f\n\r\t\u0000\u001f', '\u2028', '🌍', '\ud800', '\udc00', '\ud800\ud800\udc00\udc00', 'built'.repeat(20)]) {
 const text = encodeJson<string>(value);
 console.log(text);
 const decoded = decodeJson<string>(text);
 if (decoded.kind !== 'Ok') panic('string round trip failed');
 if (encodeJson<string>(decoded.value) !== text) panic('string re-encode differs');
}
for (const value of [true, false]) {
 const text = encodeJson<boolean>(value);
 console.log(text);
 const decoded = decodeJson<boolean>(text);
 if (decoded.kind !== 'Ok') panic('boolean round trip failed');
 if (encodeJson<boolean>(decoded.value) !== text) panic('boolean re-encode differs');
}
console.log(encodeJson<number | string>(42));
console.log(encodeJson<number | string>('mixed'));
console.log(encodeJson<1 | 2>(2));
console.log(encodeJson<'one' | 'two'>('two'));
