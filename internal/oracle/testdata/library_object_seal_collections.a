Object.seal(new Map());
Object.seal(new Set());
const map = new Map<string, number>();
console.log(String(Object.isExtensible(map)));
console.log(String(Object.isSealed(map)));
console.log(String(Object.isFrozen(map)));
console.log(String(Object.seal(map) === map));
map.set('one', 1);
console.log(String(map.size));
console.log(String(map.get('one')));
console.log(String(Object.isExtensible(map)));
console.log(String(Object.isSealed(map)));
console.log(String(Object.isFrozen(map)));
Object.freeze(map);
map.set('two', 2);
console.log(String(map.size));
console.log(String(Object.isFrozen(map)));
const set = new Set<number>();
console.log(String(Object.preventExtensions(set) === set));
set.add(3);
console.log(String(set.has(3)));
console.log(String(Object.isExtensible(set)));
console.log(String(Object.isSealed(set)));
console.log(String(Object.isFrozen(set)));
Object.freeze(set);
set.add(4);
console.log(String(set.size));
console.log(String(Object.isFrozen(set)));
