// Writes must choose the named field across structural, optional and union layouts.
interface Pair { left: number; right: number; }
function update(pair: Pair): string {
	pair.left += 10;
	pair.right += 20;
	return `${pair.left} ${pair.right}`;
}
console.log(update({ left: 1, right: 2 }));
console.log(update({ right: 3, left: 4 }));
console.log(update({ left: 5, right: 6 }));
interface Optional { value: number; extra?: number; }
function optional(object: Optional): string {
	object.value += 100;
	if (object.extra !== undefined) object.extra += 200;
	return `${object.value} ${object.extra ?? -1}`;
}
console.log(optional({ value: 7 }));
console.log(optional({ extra: 8, value: 9 }));
console.log(optional({ value: 10, extra: 11 }));
type Shape = { kind: 'Left'; value: number } | { kind: 'Right'; value: number; extra: number };
function union(object: Shape): number { object.value += 1000; return object.value; }
console.log(`${union({ kind: 'Left', value: 12 })} ${union({ extra: 13, kind: 'Right', value: 14 })}`);
class Position { stable = 15; speed = 16; }
class Reordered { speed = 17; stable = 18; }
function move(position: Position): number { position.stable += position.speed; return position.stable; }
const position = new Position();
const other = new Reordered();
console.log(`${move(position)} ${other.stable} ${other.speed}`);
const uniform: { uniformWrite: number } = { uniformWrite: 19 };
uniform.uniformWrite += 20;
console.log(`${uniform.uniformWrite}`);
class Parent { static count = 21; }
class Child extends Parent {}
Child.count = 22;
Parent.count = 23;
console.log(`${Parent.count} ${Child.count}`);
console.log(Object.keys(Child).join(','));
