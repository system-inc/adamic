// A helper that writes two fields deep: a grandchild's children are past what a placeholder reaches.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function addChild(parent: Node, child: Node): void {
	parent.nodes.push(child);
}
function addGrandchild(parent: Node, child: Node): void {
	const first = parent.nodes[0];
	if (first !== undefined) {
		first.nodes.push(child); // closes the cycle
	}
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	addChild(node, { kind: `c${n}`, nodes: [] });
	addGrandchild(node, node);
	return node.nodes.length;
}
console.log(`${run(1)}`);
