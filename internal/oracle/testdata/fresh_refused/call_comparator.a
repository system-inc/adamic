// A helper used as a sort comparator: the runtime calls it with two elements, which can be the same
// node, so its push isn't judged at any call the graph sees.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function order(left: Node, right: Node): number {
	if (left.nodes.length === 0) {
		left.nodes.push(right); // closes the cycle
	}
	return left.kind < right.kind ? -1 : 1;
}
function run(n: number): number {
	const first: Node = { kind: `a${n}`, nodes: [] };
	const second: Node = { kind: `b${n}`, nodes: [first] };
	const all = [second, first];
	all.sort(order);
	return first.nodes.length + second.nodes.length;
}
console.log(`${run(1)}`);
