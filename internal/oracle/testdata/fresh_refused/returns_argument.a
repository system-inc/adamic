// A function that looks like it makes a fresh value but returns its argument.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function same(node: Node): Node {
	return node;
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	node.nodes.push(same(node)); // closes the cycle
	return node.nodes.length;
}
console.log(`${run(1)}`);
