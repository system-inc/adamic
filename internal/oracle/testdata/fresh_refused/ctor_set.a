// Reviewer R, round 12: a constructor puts this where its parent holds it, then closes the
// cycle through a readonly field, a write the finder once skipped.
class Node {
  readonly members = new Set<Node>();
  readonly parent: Node | undefined;
  constructor(parent: Node | undefined) {
    if (parent !== undefined) {
      parent.members.add(this);
    }
    this.parent = parent; // closes the cycle
  }
}

function build(): number {
  const root = new Node(undefined);
  const child = new Node(root);
  return root.members.size + (child.parent === undefined ? 0 : 1);
}

console.log(`${build()}`);
