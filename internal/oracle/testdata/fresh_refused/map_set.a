// A map's set of the holder into its own map.
interface Room {
	readonly name: string;
	readonly doors: Map<string, Room>;
}
function run(n: number): number {
	const hall: Room = { name: `h${n}`, doors: new Map<string, Room>() };
	hall.doors.set('self', hall); // closes the cycle
	return hall.doors.size;
}
console.log(`${run(1)}`);
