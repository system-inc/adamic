// splice inserting the holder into its own children.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	node.nodes.splice(0, 0, node); // closes the cycle
	return node.nodes.length;
}
console.log(`${run(1)}`);
