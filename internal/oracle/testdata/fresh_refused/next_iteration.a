// The holder is captured into the value on the loop's next iteration: the first push is of a value
// that can't reach node, the second of one made to hold node on the pass before.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	let last: Node = { kind: `first${n}`, nodes: [] };
	for (let index = 0; index < 2; index += 1) {
		node.nodes.push(last); // closes the cycle
		last = { kind: `l${index}`, nodes: [node] };
	}
	return node.nodes.length;
}
console.log(`${run(1)}`);
