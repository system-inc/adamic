// A write through another view of the holder: either is a Node or a Box, and the write's own type
// (the union) has no slot of its own, so only matching it against Node's slot keeps it refused.
interface Node {
	readonly kind: string;
	next: Node | undefined;
}
interface Box {
	readonly tag: number;
	next: Node | undefined;
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, next: undefined };
	const box: Box = { tag: n, next: undefined };
	const either: Node | Box = n > 0 ? node : box;
	either.next = node; // closes the cycle
	return box.tag + (node.next === undefined ? 0 : 1);
}
console.log(`${run(1)}`);
