// A node made on an earlier pass of a loop, which escaped into a global there, written on a later
// pass: the newest node a site made is fresh, but the ones before it aren't.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
let saved: Node = { kind: 'empty', nodes: [] };
function current(): Node {
	return { kind: 'current', nodes: [saved] };
}
function run(n: number): number {
	let previous: Node = { kind: `start${n}`, nodes: [] };
	for (let index = 0; index < 2; index += 1) {
		const item: Node = { kind: `item${index}`, nodes: [] };
		if (index === 1) {
			previous.nodes.push(current()); // closes the cycle
		}
		saved = item;
		previous = item;
	}
	return previous.nodes.length;
}
console.log(`${run(1)}`);
saved = { kind: 'cleared', nodes: [] };
