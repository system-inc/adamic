interface Trace {
    readonly push: (label: string, data: { readonly path: string }, separate: boolean) => void;
}
function argument(label: string): string {
    console.log(`argument ${label}`);
    return label;
}
function run(trace: Trace | undefined): void {
    trace?.push(argument('bind'), { path: argument('file') }, true);
    console.log('after push');
}
const trace: Trace = {
    push: (label: string, data: { readonly path: string }, separate: boolean): void => {
        console.log(`${label} ${data.path} ${separate}`);
    },
};
run(trace);
run(undefined);

interface Counter {
    readonly read: () => number;
}
function observe(counter: Counter | undefined): void {
    console.log(typeof counter?.read());
}
const counter: Counter = { read: (): number => 42 };
observe(counter);
observe(undefined);
