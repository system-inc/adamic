// A heterogeneous union narrows to a cast receiver, not a bare C name.
interface Item { count: number; text: string; }
function update(value: Item | number): string {
    if (typeof value === 'number') return `number${value}`;
    value.count += 2;
    value.text = `${value.text}:${value.count}`;
    return value.text;
}
class Entry { count = 1; text = `class${1}`; }
console.log(update(new Entry()));
console.log(update({ text: `literal${2}`, count: 2 }));
console.log(update(3));
