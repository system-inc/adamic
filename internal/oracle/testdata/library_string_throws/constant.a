// Constants that can't fail: String.fromCodePoint given integer code points from 0 to 0x10FFFF, and
// fromCharCode, which never throws. None of these is a call that can throw, so nothing here tests the
// pending word. normalize isn't here: a decomposition can make its string longer than V8's longest,
// so it always checks (ir/string_throws.go), and so would a template.
console.log(String.fromCodePoint(72, 105, 0x1f30d, 0, 0x10ffff).length.toString());
console.log(String.fromCodePoint());
console.log(String.fromCharCode(72, 1.5, -1, 0x110000).length.toString());
