// Receiver and RHS run once; old reference reads survive a sibling write.
const holder = { source: `source${1}`, target: `target${2}`, count: 0 };
let receivers = 0;
function receiver(): typeof holder { receivers += 1; return holder; }
function change(): string {
    holder.source = `changed${3}`;
    holder.count += 1;
    return '!';
}
receiver().target = holder.source + change();
console.log(`${receivers}/${holder.source}/${holder.target}/${holder.count}`);
receiver().target += holder.source;
console.log(`${receivers}/${holder.target}`);
holder.target = holder.source;
holder.source = holder.target;
console.log(`${holder.source}/${holder.target}`);
