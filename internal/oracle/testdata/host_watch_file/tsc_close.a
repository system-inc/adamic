import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-watch-'));
const file = join(directory, 'watched');
function start(path: string): {close: () => void} {
 fs.watchFile(path, {persistent:true, interval:250}, changed);
 return {close: () => fs.unwatchFile(path, changed)};
 function changed(_curr: fs.Stats, _prev: fs.Stats): void {console.log('wrong callback ' + path);}
}
const watcher = start(file);
watcher.close();
fs.rmSync(directory, {recursive:true, force:true});
console.log('closed');
