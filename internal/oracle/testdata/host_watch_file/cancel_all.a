import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-watch-'));
const file = join(directory, 'watched');
function changed(_curr: fs.Stats, _prev: fs.Stats): void { console.log('wrong callback'); }
fs.watchFile(file, {persistent:true, interval:10}, changed);
fs.unwatchFile(file);
fs.rmSync(directory, {recursive:true, force:true});
console.log('cancelled');
