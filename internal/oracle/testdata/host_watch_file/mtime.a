import * as fs from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const directory = fs.mkdtempSync(join(tmpdir(), 'adamic-watch-'));
const file = join(directory, 'watched');
let stage = 0;
function changed(curr: fs.Stats, prev: fs.Stats): void {
 if (stage === 0) {
  console.log(`missing ${curr.size} ${prev.size}`);
  stage = 1;
  fs.writeFileSync(file, 'data');
  fs.utimesSync(file, 1700000000, 1700000000);
 } else if (stage === 1) {
  console.log(`created ${curr.size} ${prev.size}`);
  stage = 2;
  fs.utimesSync(file, 1700000000, 1700000002);
 } else {
  console.log(`mtime ${curr.size === prev.size} ${curr.mtimeMs - prev.mtimeMs}`);
  fs.unwatchFile(file);
  fs.rmSync(directory, {recursive:true, force:true});
 }
}
fs.watchFile(file, {persistent:true, interval:10}, changed);
