// Two classes behind one interface whose run() results disagree, an object's and a number's. A call
// through the interface may find either class's method, which carries no discard of its own, so
// there's no one way to let go of what it gives back.
interface Box {
	readonly label: string;
}

interface Action {
	run(): void;
}

class Maker implements Action {
	name: string;
	constructor(name: string) {
		this.name = name;
	}
	run(): Box {
		return { label: `maker${this.name}` };
	}
}

class Counter implements Action {
	count = 0;
	run(): number {
		this.count++;
		return this.count;
	}
}

const actions: Action[] = [new Maker("a"), new Counter()];
for (const action of actions) {
	action.run();
}
console.log(`ran ${actions.length}`);
