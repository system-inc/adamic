function choose(code: number): void { process.exitCode = code; }
function end(code: number): never { return process.exit(code); }
for (const code of [1.5, NaN, Infinity, -Infinity, 1234.56789]) {
	process.exitCode = 6;
	try { choose(code); } catch (error) {
		console.log(error instanceof Error ? `${error.name}: ${error.message}` : 'wrong error');
	}
	console.log(`kept ${process.exitCode}`);
	try { end(code); } catch (error) {
		console.log(error instanceof Error ? `${error.name}: ${error.message}` : 'wrong error');
	} finally { console.log('invalid exit runs finally'); }
}
process.exitCode = undefined;
