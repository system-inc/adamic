import { resolve, dirname, join } from 'node:path';
for (const path of ['', '.', '..', '/', '//', '///', '//a', '//a/b', 'a/', 'a//', '/a/../', '/../../a', 'a/../../b', '/a/./b//', 'héllo/🌍/', 'a\0b']) {
    console.log(`dirname [${path}] [${dirname(path)}]`);
    console.log(`join [${path}] [${join(path)}]`);
    console.log(`resolve [${path}] [${resolve(path)}]`);
}
console.log(`empty [${join()}] [${resolve()}]`);
console.log(join('', 'a', '', '../b/', ''));
console.log(join('/a', '/b', '..', 'c/'));
console.log(resolve('ignored', '/a', '../b', ''));
console.log(resolve('/a', '/b', '..', '..', '..'));

for (const left of ['', '/', '//', 'a/', '.', '..', '../..', '/a/b', 'a//b', '🌍']) {
    for (const right of ['', '/', '..', '../', '../b/', '/root', '.', './.', 'b//c', '../../..']) {
        console.log(`pair [${join(left, right)}] [${resolve(left, right)}] [${dirname(left + '/' + right)}]`);
    }
}
