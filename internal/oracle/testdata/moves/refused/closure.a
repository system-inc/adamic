import { parallelMap } from 'adamic';
function run(): void {
    const element = { value: 1 };
    const observer = () => element.value;
    const items = [element];
    const results = parallelMap(items, (item) => { item.value += 1; return item; });
    console.log(`${results.length}`);
    console.log(`${observer()}`);
}
run();
