const array = [1, 2];
const values = array.values();
const keys = array.keys();
const entries = array.entries();
console.log(`${values.next().value}`);
array[1] = 8;
array.push(3);
console.log(`${values.next().value}`);
for (const value of values) console.log(`remaining ${value}`);
console.log(`${values.next().done}`);
array.push(4);
console.log(`${values.next().done}`);
for (const key of keys) console.log(`key ${key}`);
for (const pair of entries) console.log(`entry ${pair[0]}:${pair[1]}`);
const words = ['built'.repeat(2), 'second'.repeat(2)];
const text = words.values();
console.log(`${text.next().value}`);
words.pop();
console.log(`${text.next().done}`);
words.push('late');
console.log(`${text.next().done}`);
const symbols = array[Symbol.iterator]();
console.log(`${symbols[Symbol.iterator]() === symbols}`);
console.log(`${symbols.next().value}`);
