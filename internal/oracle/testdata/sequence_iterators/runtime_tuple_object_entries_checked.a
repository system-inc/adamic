interface Root { readonly kind: 'Holder'; }
interface View extends Root { readonly value: readonly [string, number]; }
function check(pair: readonly [string, number]): void {
 const raw = {kind: 'Holder' as const, value: pair};
 const base: Root = raw;
 const viewed = base as View;
 console.log(`${viewed.value[0]}:${viewed.value[1]}`);
 console.log(`${viewed.value[0]}:${viewed.value[1]}`);
}
function entries(source: {readonly object: number}): void { for (const pair of Object.entries(source)) check(pair); } entries({object: 7});
