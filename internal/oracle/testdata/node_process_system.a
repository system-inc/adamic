import { EOL } from 'node:os';
const system = {
    args: process.argv.slice(2),
    newLine: EOL,
    write: (text: string): void => { process.stdout.write(text); },
    getExecutingFilePath: (): string => process.argv[1] ?? '',
    getCurrentDirectory: (): string => process.cwd(),
    getEnvironmentVariable: (name: string): string => process.env[name] ?? '',
    getMemoryUsage: (): number => process.memoryUsage().heapUsed,
    clearScreen: (): void => { process.stdout.write('\x1B[2J\x1B[3J\x1B[H'); },
    debugMode: (process.env.NODE_INSPECTOR_IPC ?? '').length > 0 || (process.env.VSCODE_INSPECTOR_OPTIONS ?? '').length > 0 || process.execArgv.some(arg => /^--(?:inspect|debug)(?:-brk)?(?:=\d+)?$/i.test(arg)),
    cpuProfilingEnabled: (): boolean => process.execArgv.includes('--cpu-prof') || process.execArgv.includes('--prof'),
};
console.log(`args ${system.args.join('|')}`);
console.log(`newline ${system.newLine === '\n'}`);
system.write('write');
system.clearScreen();
console.log(`tty ${process.stdout.isTTY ?? false} width ${process.stdout.columns ?? -1}`);
console.log(`directory ${system.getCurrentDirectory()}`);
console.log(`entry ${system.getExecutingFilePath().length > 0}`);
console.log(`environment ${system.getEnvironmentVariable('ADAMIC_HOST_PROCESS_MISSING')}`);
console.log(`memory ${system.getMemoryUsage() > 0}`);
console.log(`flags ${system.debugMode} ${system.cpuProfilingEnabled()}`);
