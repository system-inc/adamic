// && keeps a falsy left value, and a missing reference typed null is null: item && item.ready is
// boolean | null, which Node prints as null. Stage 0 refuses the type rather than give the absent
// boolean | undefined pair a Maybe holds, which would print undefined.
class Item {
	value = 1;
	ready = true;
}
function find(flag: boolean): Item | null {
	return flag ? new Item() : null;
}
const none = find(false);
console.log(`${none && none.ready}`);
