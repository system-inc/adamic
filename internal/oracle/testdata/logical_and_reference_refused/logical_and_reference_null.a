// Review witness: a boolean | null value from none && none.ready.
// A null test prints null on Node; lowering currently reaches a native panic.
// This measured disagreement awaits Lower's review; it is not a refusal pin.
class Item {
	value = 1;
	ready = true;
}
function find(flag: boolean): Item | null {
	return flag ? new Item() : null;
}
const none = find(false);
const value = none && none.ready;
if (value === null) {
    console.log('null');
} else {
    console.log(value ? 'true' : 'false');
}
