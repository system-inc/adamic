const value = 7;
const r: Record<string, number> = {value, ['10']: 10, [2]: 2, ['']: 4};
r[0] = 0;
r[-0] = 9;
r[-1] = 8;
r[1.5] = 6;
r[4294967295] = 5;
console.log(String(r[2]));
console.log(String(2 in r));
console.log(String(Object.hasOwn(r, 0)));
console.log(String(delete r[10]));
console.log(Object.keys(r).join('|'));
console.log(Object.values(r).join(','));
console.log(Object.entries(r).map(e => e[0] + ':' + String(e[1])).join(','));
console.log(String(JSON.stringify(r)));
r.dot = 12;
console.log(String(r.dot));
console.log(String(delete r.dot));
r[NaN] = 13; r[Infinity] = 14;
console.log(String(r[NaN]));
console.log(Object.keys(r).join('|'));
console.log(String(r.dot ??= 15));
