// A call can invalidate checker narrowing; observations keep undefined as it is.
namespace Debug {
    export let level: number | undefined = 7;
    export let payload: number | string = 1;
    export function clear(): void { level = undefined; }
    export function change(value: number | string): void { payload = value; }
}
function observe(value: number | undefined): void { console.log(`${value}`); }
if (Debug.level !== undefined) {
    Debug.clear();
    console.log(`${Debug.level}`);
    observe(Debug.level);
}
if (typeof Debug.payload === 'number') { console.log(`${Debug.payload + 2}`); }
Debug.change('a'.repeat(2));
if (typeof Debug.payload === 'string') { console.log(Debug.payload); }
