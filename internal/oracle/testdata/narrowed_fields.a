// A field the checker narrowed undefined out of, put back by a call: reading through it is
// JavaScript's TypeError, in all three runs. next holds a Leaf, which no Link is (its kind says
// so), so no Link can reach itself: a mutable Link | undefined in a Link would be a cycle, which
// 0.1 refuses.
interface Leaf {
	readonly kind: 'leaf';
	readonly value: number;
}
interface Link {
	value: number;
	next: Leaf | undefined;
}
const head: Link = { value: 1, next: { kind: 'leaf', value: 2 } };
function cut(): void {
	head.next = undefined;
}
if (head.next !== undefined) {
	console.log(`${head.next.value}`);
	cut();
	console.log(`${head.next.value}`);
}
