// writeTextFile, each way it can end. The oracle gives this program an empty directory of its own as
// its first argument (input_test.go), with a directory in it named locked that it may not write
// into, and compares what each run leaves there, byte for byte. Messages name the directory as <dir>,
// since each run's is its own.
import { panic, programArguments, readTextFile, writeTextFile } from 'adamic';

const directory = programArguments()[0] ?? panic('pass a directory to write in');

function units(text: string): string {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index += 1) {
		codes.push(text.charCodeAt(index));
	}
	return codes.join(' ');
}

function write(name: string, text: string): void {
	const result = writeTextFile(name.length > 0 ? `${directory}/${name}` : '', text);
	if (result.kind === 'Error') {
		console.log(`error: ${result.message.replace(directory, '<dir>')}`);
		return;
	}
	const back = readTextFile(`${directory}/${name}`);
	// Code unit by code unit for the short ones; the large one is held to Node by the file it leaves.
	console.log(back.kind === 'Ok' ? `wrote ${name}, read back ${back.text.length}: ${back.text.length < 100 ? units(back.text) : 'long'}` : `wrote ${name}, then ${back.message.replace(directory, '<dir>')}`);
}

write('plain.txt', 'hello\n');
write('unicode.txt', 'héllo, 世界 🌍\n');
// A lone surrogate is written as U+FFFD, as Node's UTF-8 makes it; a pair is one character.
write('surrogates.txt', 'alone \uD800 and \uDFFF, together 🌍');
write('marked.txt', '﻿a mark stays');
write('nul.txt', 'a\u0000b');
write('empty.txt', '');
// Written again, shorter: the file is emptied first, so nothing of the longer text is left.
write('again.txt', 'a long first text, longer than the second');
write('again.txt', 'short');
// A lone surrogate in the name names the file with U+FFFD.
write('\uD800.txt', 'named by a lone surrogate');
write('large.txt', 'line of text\n'.repeat(100000).slice(0, 1000000));

write('missing/inside.txt', 'no directory to hold it');
write('locked', 'a directory, not a file');
write('plain.txt/inside.txt', 'a file, not a directory');
write('locked/inside.txt', 'not allowed in');
write('', 'nowhere');
write('nul\u0000.txt', 'a NUL can name no file');
