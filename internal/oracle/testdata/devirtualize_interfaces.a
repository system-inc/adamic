interface Runner { run(value: string): string; }
class First implements Runner { run(value: string): string { return `first:${value}`; } }
class Second implements Runner { run(value: string): string { return `second:${value}`; } }
function through(value: Runner): string { return value.run('parameter'); }
const first: Runner = new First();
const second: Runner = new Second();
console.log(first.run('exact'));
console.log(second.run('exact'));
for (const value of [first, second]) { console.log(through(value)); }
const saved = (value: string): string => first.run(value);
console.log(saved('saved'));
let selected: Runner = new First();
function change(): string { selected = new Second(); return 'argument'; }
console.log(selected.run(change()));
console.log(selected.run('after'));
const literal: Runner = { run: (value: string): string => `literal:${value}` };
console.log(through(literal));
class Inherited extends First {}
const inherited: Runner = new Inherited();
console.log(inherited.run('inherited'));
function make(): Runner { return new Second(); }
console.log(make().run('returned'));
const alias: Runner = second;
console.log(alias.run('alias'));
