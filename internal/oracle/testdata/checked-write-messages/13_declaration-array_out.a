// Real array mutator extracted into a reduced consumer. This exercises container-element writes, not only named object fields.
interface Node { readonly kind: "Declaration" | "Expression"; }
interface Declaration { readonly kind: "Declaration"; }
function collect(array: Node[], node: Node): void {
    array.push(node);
}

