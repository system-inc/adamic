// new Set of a generator's call steps it to its end by its origin and adds each value it yields in
// order: a value given again is kept once, in its first place, as on Node. Values are built.
function* words(count: number): Generator<string, undefined, undefined> {
    for(let index = 0; index < count; index++) {
        yield `w${String(index % 2)}`;
    }
}
const set = new Set(words(5));
console.log(String(set.size));
console.log([...set].join(','));
console.log(String(set.has(`w${String(1)}`)));
console.log(String(new Set(words(0)).size));
