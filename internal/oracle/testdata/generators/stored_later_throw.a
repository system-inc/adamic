// A stored generator's one read as an argument, then a throw in a later argument, before the call is
// made (#qk8rztp S2c-4-1, Language's second exit): consume(stored, suffix(...)). The read has already
// moved the frame out of the const into the statement's temporary, which the throw releases unstepped,
// so the body's try and finally print nothing, on Node or here, and the const's release lets go of
// nothing. On the path where the suffix is made, the callee's for-of steps it and both print.
function* guarded(label: string): Generator<string, undefined, undefined> {
    try {
        console.log(`body ${label}`);
    } finally {
        console.log(`finally ${label}`);
    }
    yield `${label}<`;
}
function consume(items: Iterable<string>, tail: string): string {
    let all = '';
    for (const item of items) {
        all += item;
    }
    return `${all}${tail}`;
}
function suffix(label: string, fail: boolean): string {
    if (fail) {
        throw new Error(`no suffix ${label}`);
    }
    return `>${label}`;
}
function run(label: string, fail: boolean): string {
    const stored = guarded(`${label}!`);
    return consume(stored, suffix(label, fail));
}
try {
    console.log(run(`a${String(1)}`, true));
} catch (error) {
    if (error instanceof Error) {
        console.log(`caught ${error.message}`);
    }
}
console.log(run(`b${String(2)}`, false));
