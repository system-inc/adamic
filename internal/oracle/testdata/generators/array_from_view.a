// tsc's arrayFrom (core.ts:1337-1347, its overloads and all), handed mapDefinedIterator's call as
// builderState.ts:624 hands it one, with a mapper, so the instance's T and U are both read. The
// generator crosses into arrayFrom's Iterable<T> parameter through IterableOf, the parameter's one
// use is its for-of, and that for-of steps the generator by its dispatch (#qk8rztp S2c-1). The
// generator itself steps a Map's values() through its own view (S2b-1b).
interface SourceFile {
    readonly fileName: string;
    readonly emitted: boolean;
}
/**
 * Shims `Array.from`.
 *
 * @internal
 */
export function arrayFrom<T, U>(iterator: Iterable<T>, map: (t: T) => U): U[];
/** @internal */
export function arrayFrom<T>(iterator: Iterable<T>): T[];
/** @internal */
export function arrayFrom<T, U>(iterator: Iterable<T>, map?: (t: T) => U): (T | U)[] {
    const result: (T | U)[] = [];
    for (const value of iterator) {
        result.push(map ? map(value) : value);
    }
    return result;
}
/** @internal */
// eslint-disable-next-line no-restricted-syntax
export function* mapDefinedIterator<T, U>(iter: Iterable<T>, mapFn: (x: T) => U | undefined): Generator<U & ({} | null), void, unknown> {
    for (const x of iter) {
        const value = mapFn(x);
        if (value !== undefined) {
            yield value;
        }
    }
}
const seenFileNamesMap = new Map<string, SourceFile>();
for(let index = 0; index < 5; index++) {
    seenFileNamesMap.set(`/src/${String(index)}.ts`, { fileName: `/out/${String(index)}.js`, emitted: index % 2 === 0 });
}
const affected = arrayFrom(mapDefinedIterator(seenFileNamesMap.values(), (value: SourceFile) => value.emitted ? value : undefined), (file: SourceFile) => file);
console.log(String(affected.length));
console.log(affected.map((file: SourceFile): string => file.fileName).join(','));
