// A spread steps a plain function*, whose inferred Generator<string, void, unknown> holds void only
// as its last value, which a spread never reads; alone and among other elements, each step's string
// is built and the frame finishes when the spread does.
function* words(prefix: string, count: number) {
    for(let index = 0; index < count; index++) {
        yield `${prefix}${String(index)}`;
    }
}
const all = [...words(`w${String(1)}`, 3)];
console.log(all.join(','));
const mixed = ['head', ...words('m', 2), 'tail', ...words('n', 0)];
console.log(mixed.join(','));
console.log(String([...words('e', 0)].length));
