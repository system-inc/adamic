interface Link {
	value: number;
	label: string;
}
let chain: Link | undefined = { value: 1, label: `built ${1}` };
let count: number | undefined = 1;
function drop(): void {
	chain = undefined;
	count = undefined;
}
if (chain !== undefined && count !== undefined) {
	drop();
	console.log(`${typeof chain} ${typeof count}`);
}
