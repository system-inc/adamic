const holder: { item: Uint8Array } = { item: new Uint8Array([1]) };
let calls = 0;
function receiver(): { item: Uint8Array } { calls += 1; return holder; }
function show(value: Uint8Array): string { return `${value[0]}`; }
const assigned = (receiver().item = new Uint8Array([7]));
console.log(show(assigned));
console.log(show(holder.item));
console.log(`calls:${calls}`);
const saved = (receiver().item = new Uint8Array([7]));
holder.item = new Uint8Array([1]);
console.log(show(saved));
