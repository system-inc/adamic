function make(start: number): { readonly read: () => number; readonly get: () => (() => number); readonly deep: () => (() => number) } {
    let count = start;
    function read(): number { count += 1; return count; }
    function get(): () => number { return read; }
    function deep(): () => number {
        function inner(): () => number { return read; }
        return inner();
    }
    return { read, get, deep };
}
const first = make(10);
const second = make(20);
console.log(`${first.read === first.get()} ${first.read === first.deep()} ${first.get() === first.get()} ${first.read === second.get()}`);
console.log(`${first.get()()} ${first.deep()()} ${second.get()()}`);
function selfValue(): () => (() => number) {
    function read(): number { return 7; }
    function get(): () => number { return read; }
    return get;
}
const escaped = selfValue();
console.log(`${escaped() === escaped()} ${escaped()()}`);
function recreate(): () => (() => number) {
    let count = 30;
    function read(): number { count += 1; return count; }
    function invoke(): number { return read(); }
    function get(): () => number { return read; }
    invoke();
    return get;
}
const get = recreate();
console.log(`${get()()} ${get()()}`);
