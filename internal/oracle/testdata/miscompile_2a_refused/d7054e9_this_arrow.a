// a-check: refused this escaping a constructor through a closure before every field is set
class Box {
 readonly first: string; readonly later: string; readonly count: number;
 constructor(label: string) {
  const read = (): string => this.later;
  const counted = (): number => this.count + 1;
  this.first = `${read()}:${counted()}`;
  this.later = label; this.count = 2;
 }
}
const box = new Box('set'); console.log(`${box.first}|${box.later}`);
