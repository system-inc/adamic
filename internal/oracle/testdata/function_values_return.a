function choose(mode: number): string | number | boolean | undefined {
    if (mode === 0) return `held${mode}`;
    if (mode === 1) return 42;
    if (mode === 2) return false;
    return undefined;
}
const value = choose;
console.log(`${value === choose}`);
for (let mode = 0; mode < 4; mode++) {
    const result = value(mode);
    if (result === undefined) console.log("missing");
    else console.log(`${typeof result}:${result}`);
}

function chooseArray(array: boolean): string | string[] {
    return array ? [`first${1}`, `second${2}`] : `scalar${3}`;
}
const arrayValue = chooseArray;
for (let index = 0; index < 2; index++) {
    const result = arrayValue(index === 0);
    console.log(typeof result === "string" ? result : result.join(","));
}
interface Result { readonly text: string; }
function chooseObject(object: boolean): string | Result {
    return object ? { text: `object${4}` } : `scalar${5}`;
}
const objectValue = chooseObject;
for (let index = 0; index < 2; index++) {
    const result = objectValue(index === 0);
    console.log(typeof result === "string" ? result : result.text);
}
