import 'node:process';
// The adapted tsc errorCode narrowing. No assertion to Error or ErrnoException.
for (const path of process.argv.slice(2)) {
    try { process.chdir(path); }
    catch (error: unknown) {
        if (typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' && 'message' in error && typeof error.message === 'string') {
            console.log(error.code);
            console.log(error.message);
            console.log(String(Object.prototype.hasOwnProperty.call(error, 'code') && Object.prototype.hasOwnProperty.call(error, 'message')));
        }
    }
}
for (const value of [NaN, Infinity, -Infinity, 0.5]) {
    try { process.exitCode = value; }
    catch (error: unknown) {
        if (typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' && 'message' in error && typeof error.message === 'string') {
            console.log(error.code);
            console.log(error.message);
            console.log(String(Object.prototype.hasOwnProperty.call(error, 'code') && Object.prototype.hasOwnProperty.call(error, 'message')));
        }
    }
    try { process.exit(value); }
    catch (error: unknown) {
        if (typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' && 'message' in error && typeof error.message === 'string') {
            console.log(error.code);
            console.log(error.message);
            console.log(String(Object.prototype.hasOwnProperty.call(error, 'code') && Object.prototype.hasOwnProperty.call(error, 'message')));
        }
    }
}
