interface Root { readonly child: { text: string }; }
function inspect(root: Root, map: Map<number, number>): number {
 const child = root.child;
 const width = child.text.length;
 let total = 0;
 [1, 2].forEach((n: number): void => { total += n + width; });
 total += [1, 2].reduce((sum: number, n: number): number => sum + n + width, 0);
 const copy = Array.from({ length: 2 }, (_value: undefined, n: number): number => n + width);
 const sorted = [2, 1].sort((a: number, b: number): number => a - b + width - width);
 map.forEach((n: number): void => { total += n + width; });
 return total + (copy[0] ?? 0) + (sorted[0] ?? 0) + child.text.length;
}
function changes(root: Root): void {
 const text = root.child.text;
 [1].forEach((n: number): void => { root.child.text = `changed${n}`; });
 console.log(text);
}
console.log(`${inspect({ child: { text: `callbacks${1}` } }, new Map([[1, 2]]))}`);
changes({ child: { text: `before${1}` } });
