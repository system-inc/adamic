// s2 (#snypn8c, c3): a let local is narrowed by tsc, but something may write it between the comparison
// and the write, so only a const local is proved.
enum K { A, B, C, D }
function kindOf(n: number): K {
	return n;
}
function take(x: K.A | K.B): string {
	return "took " + String(x);
}
function compared(n: number): string {
	let t = kindOf(n);
	if (t === K.A || t === K.B) {
		return take(t);
	}
	t = kindOf(n + 1);
	return "skip " + String(t);
}
console.log(compared(0) + ", " + compared(7));
