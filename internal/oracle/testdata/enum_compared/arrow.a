// s4 (#snypn8c, c3): a read inside an arrow made in the then-branch runs when the arrow is called, so the
// proof stops at the function boundary.
enum K { A, B, C, D }
function kindOf(n: number): K {
	return n;
}
function take(x: K.A | K.B): string {
	return "took " + String(x);
}
function later(n: number): string {
	const t = kindOf(n);
	if (t === K.A || t === K.B) {
		const call = (): string => take(t);
		return call();
	}
	return "skip";
}
console.log(later(0) + ", " + later(7));
