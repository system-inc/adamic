interface Pattern {
    prefix: string;
    suffix: string;
    rewrite: (text: string) => string;
}
let defaults = 0;
function fresh(label: string): Pattern {
    defaults++;
    return {
        prefix: [label, ":"].join(""),
        suffix: "!",
        rewrite: (text: string): string => [label, text].join("/")
    };
}
function render(label: string, { prefix, suffix, rewrite }: Pattern = fresh(label)): string {
    return `${prefix}${rewrite(label)}${suffix}`;
}
const supplied = fresh(["giv", "en"].join(""));
console.log(render(["cus", "tom"].join(""), supplied));
console.log(render(["miss", "ing"].join("")));
console.log(render(["unde", "fined"].join(""), undefined));
console.log(`${defaults}`);
