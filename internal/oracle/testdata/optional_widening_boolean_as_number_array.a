const original = { x: 1, y: true };
const views: readonly { x: number }[] = [original];
const wider: readonly { x: number; y?: number }[] = views.map((view): { x: number; y?: number } => ({ x: view.x }));
for (const point of wider) {
	console.log(typeof point.y);
	console.log(`${point.y === undefined}`);
	console.log(`${(point.y ?? 0) + 1}`);
}
