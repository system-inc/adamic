// map reads the length once; a callback that shrinks the array leaves JavaScript a hole, which 0.1
// can't hold, so it's an inserted check, the same in both backends. Found by adamic-fuzz (seed 138):
// native panicked and the JavaScript backend ran on.
interface Holder {
	list: number[];
}

const holder: Holder = { list: [100, 1e21, 7] };
const doubled = holder.list.map((item) => item * 2);
console.log(doubled.join(','));
console.log(holder.list.map((item) => `${holder.list.pop() ?? -1}:${item}`).join(' '));
