interface Box { readonly text: string; }
function owned(code: string, seed: number): string {
 let text = `start${seed}`;
 let box: Box = { text: `box${seed}` };
 switch (code) {
  case 'a':
   text += ':a';
   box = { text: `${text}:${box.text}` };
  case 'b': {
   const temporary = { text: `${box.text}:b` };
   text = `${text}:${temporary.text}`;
  }
  default:
   box = { text: `${text}:default` };
  case 'c':
   return `${text}|${box.text}`;
  case 'd':
 }
 return `${text}|${box.text}|empty`;
}
for (const code of ['a', 'b', 'c', 'd', 'e']) { console.log(owned(code, 7)); }
function returning(code: number): Box {
 switch (code) {
  case 1: console.log(`fall${code}`);
  case 2: return { text: `returned${code}` };
  default: return { text: `default${code}` };
 }
}
console.log(`${returning(1).text} ${returning(2).text} ${returning(3).text}`);
function fresh(seed: number): Box { return { text: `fresh${seed}` }; }
function walk(seed: number): string {
 let box = fresh(seed);
 switch (seed) {
  case 0: box = { ...box, text: `${box.text}:zero` };
  case 1: box = { ...box, text: `${box.text}:one` };
  default: return box.text;
 }
}
console.log(`${walk(0)} ${walk(1)} ${walk(2)}`);
