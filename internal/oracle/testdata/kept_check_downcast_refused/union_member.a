// a-check: refused a downcast from Shape to Circle in .a whose checks no proof erases
// A cast to a member of a discriminated union keeps one tag test that panics, the kind of check !
// is, so .a writes it as a narrowing: if (shape.kind !== 'Circle') panic('why').
type Circle = { readonly kind: 'Circle'; readonly radius: number };
type Square = { readonly kind: 'Square'; readonly side: number };
type Shape = Circle | Square;
function radius(shape: Shape): number {
	const circle = shape as Circle;
	return circle.radius;
}
console.log(`radius ${radius({ kind: 'Circle', radius: 2 })}`);
