console.log(`initial ${process.exitCode}`);
for (const code of [0, -0, -1, 256, 4294967297, 9007199254740991]) {
	const assigned = (process.exitCode = code);
	console.log(`assigned ${assigned}, read ${process.exitCode}`);
}
process.exitCode = undefined;
console.log(`cleared ${process.exitCode}`);
function choose(): void { process.exitCode = 259; }
try { choose(); } finally { console.log('normal finally'); }
console.log('normal completion');
