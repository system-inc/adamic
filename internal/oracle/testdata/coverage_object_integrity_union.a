function query(value: number | string | boolean | undefined | { readonly n: number }): string {
 return `${Object.isSealed(value)} ${Object.isFrozen(value)} ${Object.isExtensible(value)}`;
}
console.log(query(undefined));
console.log(query(false));
console.log(query('made' + '-text'));
console.log(query(3));
const plain = { n: 1 };
console.log(query(plain));
Object.preventExtensions(plain);
console.log(query(plain));
Object.seal(plain);
console.log(query(plain));
Object.freeze(plain);
console.log(query(plain));
