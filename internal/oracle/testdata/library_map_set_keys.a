// The reserved undefined NaN word must never equal a present NaN.
const map = new Map<number | undefined, string>([[undefined, 'missing'], [NaN, 'nan'], [-0, 'zero']]);
map.set(0 / 0, 'new nan');
map.set(0, 'new zero');
console.log(`${map.size} ${map.get(undefined)} ${map.get(NaN)} ${map.get(-0)}`);
console.log(`${map.has(undefined)} ${map.has(NaN)} ${map.has(0)}`);
for (const [key, value] of map) {
	console.log(`${key} ${value} ${key === undefined ? 'undefined' : 1 / key}`);
}
map.forEach((value: string, key: number | undefined) => {
	console.log(`${key}=${value}`);
});
console.log(`${map.delete(undefined)} ${map.has(NaN)} ${map.size} ${map.delete(NaN)} ${map.has(0)}`);
map.set(undefined, 'again');
const copy = new Map(map);
console.log(`${copy.size} ${copy.get(undefined)} ${copy.get(0)}`);
const values: (number | undefined)[] = [undefined, NaN, -0, 0, NaN, undefined, 4];
const set = new Set<number | undefined>(values);
for (const value of set) {
	console.log(`${value} ${value === undefined ? 'undefined' : 1 / value}`);
}
console.log(`${set.size} ${set.has(undefined)} ${set.has(NaN)} ${set.delete(undefined)} ${set.has(NaN)}`);
set.add(undefined);
console.log(`${new Set(set).size} ${[...set.keys()].join(',')}`);
const onlyMissing = new Set<number | undefined>([undefined]);
const onlyNan = new Set<number | undefined>([NaN]);
console.log(`${onlyMissing.union(onlyNan).size} ${onlyMissing.intersection(onlyNan).size} ${onlyMissing.isDisjointFrom(onlyNan)}`);
// An open iterator keeps a deleted historical slot, which must not count toward size.
const held = map.keys();
map.delete(undefined);
console.log(`held size ${map.size}`);
console.log(`held next done ${held.next().done}`);
