// A controller that holds its table and is its data source: the table holds the controller, which holds
// the table, a cycle neither count sees. Refused, with Weak<TableView> as the fix (controller-weak.a).
// want: refuses Controller, handed to Apple as a delegate the TableView holds

import type { TableView } from 'apple/appkit/table-view';
import type { TableViewDataSource } from 'apple/appkit/table-view-data-source';

class Controller implements TableViewDataSource {
	readonly table: TableView;
	constructor(table: TableView) {
		this.table = table;
	}
	numberOfRows(tableView: TableView): number {
		return tableView === this.table ? 1 : 0;
	}
}
export function attach(table: TableView): void {
	table.dataSource = new Controller(table);
}
