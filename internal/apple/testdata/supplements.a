// supplements.a: day 6's app, held to its witness. A supplements list written in Adamic through
// SwiftUI, its rows a class of their own, shows a progress view, awaits its list from URLSession,
// decodes it into true types with decodeJson, and renders it: what SwiftUI shows is printed. Then a
// list drifted from its type ("Noon" isn't a timing) comes back as an error, a value, not a crash.
// supplements.swift is the same app written in Swift: the two must agree (witness_test.go).

import { decodeJson, programArguments } from 'adamic';
import { Window } from 'apple/appkit/window';
import { Url } from 'apple/foundation/url';
import { UrlSession } from 'apple/foundation/url-session';
import { Host } from 'apple/swiftui/host';
import { State, renderWhenStateChanges } from 'apple/swiftui/state';
import { horizontalStack, image, list, navigationStack, progressView, section, spacer, text, type View } from 'apple/swiftui/views';

interface Supplement {
	readonly name: string;
	readonly dose: string;
	readonly symbol: string;
	readonly timing: 'Morning' | 'Evening';
}

const supplements = new State<readonly Supplement[]>([]);

class SupplementRow implements View {
	readonly supplement: Supplement;

	constructor(supplement: Supplement) {
		this.supplement = supplement;
	}

	body(): View {
		return horizontalStack({ spacing: 10 }, [image(this.supplement.symbol).foregroundColor('Accent'), text(this.supplement.name), spacer(), text(this.supplement.dose).foregroundColor('Secondary')]);
	}
}

class SupplementsView implements View {
	rows(timing: 'Morning' | 'Evening'): readonly View[] {
		return supplements.value.filter((supplement) => supplement.timing === timing).map((supplement) => new SupplementRow(supplement));
	}

	body(): View {
		if (supplements.value.length === 0) {
			return navigationStack(progressView().navigationTitle('Stack'));
		}
		return navigationStack(list([section('Morning', this.rows('Morning')), section('Evening', this.rows('Evening'))]).listStyle('Inset').navigationTitle('Stack'));
	}
}

const host = new Host(new SupplementsView());
renderWhenStateChanges(() => {
	host.render(new SupplementsView());
});
const window = new Window({ contentRectangle: { x: 0, y: 0, width: 360, height: 480 }, styleMask: ['Titled'], backing: 'Buffered', defer: true });
window.contentView = host.view();
console.log(`loading: rows ${host.listRows()}`);

const address = programArguments()[0] ?? 'http://127.0.0.1:1';

// A loop is its own function: async unit 2 doesn't cut a for-of into an await's states yet.
function listed(): void {
	console.log(`supplements: ${supplements.value.length}, rows ${host.listRows()}`);
	for (const supplement of supplements.value) {
		console.log(`  ${supplement.timing}: ${supplement.name}, ${supplement.dose}`);
	}
}

// What the server has at a path, awaited: "" where the request fails, which decodes as an error.
async function fetched(path: string): Promise<string> {
	try {
		const response = await UrlSession.shared.data({ from: new Url({ string: `${address}/${path}` }) });
		return response.body;
	} catch {
		return '';
	}
}

const decoded = decodeJson<Supplement[]>(await fetched('supplements.json'));
if (decoded.kind === 'Error') {
	console.log('supplements: failed');
} else {
	supplements.set(decoded.value);
	listed();
}
const again = decodeJson<Supplement[]>(await fetched('drifted.json'));
console.log(`drifted: ${again.kind === 'Error' ? 'refused' : 'accepted'}, rows ${host.listRows()}`);
window.close();
