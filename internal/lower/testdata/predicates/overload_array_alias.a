const nodes: Node[] = [identifier];
function corrupt(array: readonly Node[]): array is readonly Identifier[];
function corrupt(array: readonly Node[]): boolean { console.log("called"); nodes[0] = { kind: 11 }; return true; }
console.log(`${corrupt(nodes)}`);
