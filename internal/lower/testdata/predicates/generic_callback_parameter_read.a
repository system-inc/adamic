// The result type and callback contract resolve at each closed-world call.
function cast<TOut extends TIn, TIn = unknown>(value: TIn, test: (value: TIn) => value is TOut): TOut {
    if (test(value)) return value;
    throw new Error("failed cast");
}
function isDefined(value: string | undefined): value is string {
    return value !== undefined;
}
console.log(cast<string, string | undefined>("word", isDefined).toUpperCase());
console.log(cast<string, string | undefined>("second", (value: string | undefined) => value !== undefined).toUpperCase());
