interface Node { readonly kind: number }
interface Identifier extends Node { readonly kind: 80; readonly escapedText: string }
function isIdentifier(node: Node): node is Identifier { return node.kind === 80; }
function read(node: Node): string {
    if (isIdentifier(node)) return node.escapedText;
    return "other";
}
const identifier = { kind: 80, escapedText: "word" };
console.log(read(identifier));
console.log(isIdentifier(identifier).toString());
function isDefined(value: string | undefined): value is string { return value !== undefined; }
console.log(isDefined("word").toString());
