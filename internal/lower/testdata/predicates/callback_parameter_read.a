// A narrowed read inside the callee consumes the callback's true direction.
function read(value: string | undefined, test: (value: string | undefined) => value is string): string {
    if (test(value)) return value.toUpperCase();
    return "missing";
}
function isDefined(value: string | undefined): value is string {
    return value !== undefined;
}
console.log(read("word", isDefined));
console.log(read(undefined, isDefined));
console.log(read("second", (value: string | undefined) => value !== undefined));
