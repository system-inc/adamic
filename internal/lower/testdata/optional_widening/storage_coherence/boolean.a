function readActual(actual: { value: boolean | undefined }): void { console.log(`${actual.value}`); }
function readView(view: { value?: boolean | undefined }): void { console.log(`${view.value}`); }
function maybe(present: boolean): boolean | undefined { return present ? false : undefined; }
const actual: { x: number; value: boolean | undefined } = { x: 1, value: true };
const narrow: { x: number } = actual;
const view: { x: number; value?: boolean | undefined } = narrow;
view.value = undefined;
console.log(`${actual.value}`);
view.value = true;
readActual(actual);
actual.value = false;
readView(view);
actual.value = undefined;
readView(view);
view.value = maybe(false);
readActual(actual);
view.value = maybe(true);
readActual(actual);
