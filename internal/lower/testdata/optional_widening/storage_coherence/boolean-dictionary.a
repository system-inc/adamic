const actual: { x: number; value: boolean | undefined } = { x: 1, value: false };
const narrow: { x: number } = actual;
const view: { x: number; value?: boolean | undefined } = narrow;
const read: { readonly [key: string]: boolean | number | undefined } = narrow;
console.log(`${actual.value} ${typeof read['value']}`);
view.value = undefined;
console.log(`${actual.value} ${typeof read['value']}`);
actual.value = false;
console.log(`${actual.value} ${typeof read['value']}`);
actual.value = true;
console.log(`${actual.value} ${typeof read['value']}`);
