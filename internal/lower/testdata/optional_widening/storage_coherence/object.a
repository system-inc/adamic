function value(index: number): { label: string } { return { label: `value${index}` }; }
const actual = { x: 1, value: value(0) };
const narrow: { x: number } = actual;
const view: { x: number; value?: { label: string } } = narrow;
const first = value(2);
view.value = first;
console.log(`${actual.value.label} ${actual.value === first}`);
const second = value(3);
actual.value = second;
console.log(`${view.value?.label} ${view.value === second}`);
view.value = actual.value;
console.log(`${actual.value.label} ${actual.value === second}`);
