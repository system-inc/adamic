function readActual(actual: { value: number | undefined }): void { console.log(`${actual.value}`); }
function readView(view: { value?: number | undefined }): void { console.log(`${view.value}`); }
function maybe(present: boolean): number | undefined { return present ? 7 : undefined; }
const actual: { x: number; value: number | undefined } = { x: 1, value: 0 };
const narrow: { x: number } = actual;
const view: { x: number; value?: number | undefined } = narrow;
view.value = undefined;
readActual(actual);
view.value = 2;
readActual(actual);
actual.value = 3;
readView(view);
actual.value = undefined;
readView(view);
view.value = maybe(false);
readActual(actual);
view.value = maybe(true);
readActual(actual);
view.value = NaN;
readActual(actual);
actual.value = NaN;
readView(view);
