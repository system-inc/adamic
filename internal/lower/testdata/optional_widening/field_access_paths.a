// Fixed offsets and caches must preserve the field name across every layout.
interface Pair { left: number; right: number; }
function update(pair: Pair): string {
	pair.left += 10;
	pair.right += 20;
	return `${pair.left} ${pair.right}`;
}
const first = { left: 1, right: 2 };
const reversed = { right: 3, left: 4 };
const third = { left: 5, right: 6 };
console.log(update(first));
console.log(update(reversed));
console.log(update(third));
interface Optional { readonly label: string; readonly amount?: number; }
function show(value: Optional): string { return `${value.label} ${value.amount ?? -1}`; }
console.log(show({ label: 'absent' }));
console.log(show({ amount: 42, label: 'reordered' }));
console.log(show({ label: 'present', amount: 7 }));
const absentExtra = { label: 'absent-extra', padding: 99 };
console.log(show(absentExtra));
type Shape = { readonly kind: 'Left'; readonly value: number } | { readonly kind: 'Right'; readonly value: number; readonly extra: number };
function read(shape: Shape): number { return shape.value; }
console.log(`${read({ kind: 'Left', value: 8 })} ${read({ extra: 9, kind: 'Right', value: 10 })}`);
class Position { stable = 11; speed = 12; }
class Reordered { speed = 13; stable = 14; }
function move(position: Position): number { position.stable += position.speed; return position.stable; }
const position = new Position();
const different = new Reordered();
console.log(`${move(position)} ${different.stable} ${different.speed}`);
// This name is uniform across all generated layouts, so it needs no shape test.
const fixed: { uniform: number } = { uniform: 15 };
fixed.uniform += 16;
console.log(`${fixed.uniform}`);
class Parent { static count = 17; }
class Child extends Parent {}
console.log(`${Child.count}`);
Parent.count = 18;
console.log(`${Child.count}`);
Child.count = 19;
console.log(`${Parent.count} ${Child.count}`);
