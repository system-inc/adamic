interface Circle {
    readonly kind: "circle";
    readonly radius: number;
}
interface Square {
    readonly kind: "square";
    readonly side: number;
}
type Shape = Circle | Square;
// core.ts's find, with stage 3's array[i]! adaptation: a narrowing overload over a boolean implementation.
function find<T, U extends T>(array: readonly T[] | undefined, predicate: (element: T, index: number) => element is U, startIndex?: number): U | undefined;
function find<T>(array: readonly T[] | undefined, predicate: (element: T, index: number) => boolean, startIndex?: number): T | undefined;
function find<T>(array: readonly T[] | undefined, predicate: (element: T, index: number) => boolean, startIndex?: number): T | undefined {
    if (array === undefined) return undefined;
    for (let i = startIndex ?? 0; i < array.length; i++) {
        const value = array[i]!;
        if (predicate(value, i)) {
            return value;
        }
    }
    return undefined;
}
// utilitiesPublic.ts's getFirstJSDocTag: its predicate parameter forwarded to find.
function getFirst<T extends Shape>(shapes: readonly Shape[], predicate: (shape: Shape) => shape is T): T | undefined {
    return find(shapes, predicate);
}
// A direct kind compare, proven.
function isCircle(shape: Shape): shape is Circle {
    return shape.kind === "circle";
}
const shapes: Shape[] = [{ kind: "square", side: 2 }, { kind: "circle", radius: 3 }];
// Proven too: the false side holds no Circle.
function isRound(shape: Shape): shape is Circle {
    return shape.kind !== "square";
}
const pick = shapes.length > 1;
const circle = getFirst(shapes, pick ? isCircle : isRound);
console.log(circle === undefined ? "none" : `radius ${String(circle.radius)}`);
