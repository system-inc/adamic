enum SyntaxKind { Identifier = 80 }
interface Node { readonly kind: number }
interface Identifier extends Node { readonly kind: SyntaxKind.Identifier; readonly escapedText: string }
function isIdentifier(node: Node): node is Identifier { return node.kind === SyntaxKind.Identifier; }
function visit(node: Node | undefined): void { console.log(`${node?.kind ?? 0}`); if (node !== undefined && isIdentifier(node)) console.log(node.escapedText); }
visit(undefined);
const value: Identifier = {kind:80,escapedText:"value"};
visit(value);
