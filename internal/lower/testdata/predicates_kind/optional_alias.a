enum SyntaxKind { Identifier = 80, StringLiteral = 11 }
interface Node { readonly kind: number }
interface Identifier extends Node { readonly kind: SyntaxKind.Identifier; readonly escapedText: string; readonly text?: string | undefined }
function isIdentifier(node: Node): node is Identifier { return node.kind === SyntaxKind.Identifier; }
function visit(node: Node): void {
 if (isIdentifier(node)) {
  const alias: { readonly text?: string | undefined } = node;
  console.log(`${node.escapedText}:${"text" in alias}:${alias.text ?? "missing"}`);
 } else console.log("other");
}
const missing: Identifier = { kind: SyntaxKind.Identifier, escapedText: "missing" };
const undefinedValue: Identifier = { kind: SyntaxKind.Identifier, escapedText: "undefined", text: undefined };
const value: Identifier = { kind: SyntaxKind.Identifier, escapedText: "value", text: "payload" };
visit(missing);
visit(undefinedValue);
visit(value);
