enum SyntaxKind { Identifier = 80, StringLiteral = 11 }
interface Node { readonly kind: number }
interface Identifier extends Node { readonly kind: SyntaxKind.Identifier; readonly escapedText: string }
function isIdentifier(node: Node): node is Identifier { const kind = node.kind; const saved = kind; return saved === SyntaxKind.Identifier; }
function visit(node: Node): void { if (isIdentifier(node)) console.log(node.escapedText); else console.log("other"); }
const identifier: Identifier = {kind:SyntaxKind.Identifier,escapedText:"name"};
visit(identifier);
visit({kind:SyntaxKind.StringLiteral});
