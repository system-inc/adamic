class Base {
    scale(value: number, factor: number = 2): number { return value * factor; }
    label(name: string = `base${1}`): string { return `hello ${name}`; }
}
class Child extends Base {
    override scale(value: number, factor: number): number { return value * factor + 1; }
    override label(name: string): string { return `hi ${name}`; }
}
const values: readonly Base[] = [new Base(), new Child()];
for (const value of values) {
    console.log(`${value.scale(3)} ${value.scale(3, 4)} ${value.label('x')}`);
    console.log(value.label());
}
