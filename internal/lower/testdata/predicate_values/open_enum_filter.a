enum Kind { A = 1, B = 2 }
interface A { readonly kind: Kind.A; readonly value: number }
// B's kind is the open Kind, so it can hold Kind.A with a string value.
interface B { readonly kind: Kind; readonly value: string }
type Node = A | B;
function isA(n: Node): n is A { return n.kind === Kind.A; }
function numeric(): number { return 1; }
const b: B = { kind: numeric(), value: "text" };
const nodes: Node[] = [b];
// isA reaches filter as a value: nothing here narrows on it, so only A's view sees the lie.
for (const a of nodes.filter(isA)) {
    console.log(`${a.value + 1}`);
}
