interface Expression {
    readonly kind: "E";
    readonly e: number;
}
interface Statement {
    readonly kind: "S";
    readonly s: string;
}
type Node = Expression | Statement;
let calls = 0;
// Unproven, and it lies on true: it says yes to an Expression.
function isS(n: Node): n is Statement {
    calls = calls + 1;
    return calls > 0;
}
const expression: Node = { kind: "E", e: 1 };
const bound = isS.bind(undefined);
if (bound(expression)) {
    console.log(expression.s);
}
