enum SyntaxKind { Identifier, Block }
interface Node { readonly kind: SyntaxKind }
interface Identifier extends Node { readonly kind: SyntaxKind.Identifier; readonly text: string }
// tsc's shape: a kind on an open SyntaxKind proves no layout, so the claim is checked through a view.
function isIdentifier(node: Node): node is Identifier { return node.kind === SyntaxKind.Identifier; }
// isIdentifier reaches visitNode as a value, as tsc's visitNode(node, visitor, isIdentifier) does.
function visitNode(node: Node, test: (node: Node) => node is Identifier): string {
	if (test(node)) return node.text;
	return "other";
}
// Keyword shares SyntaxKind.Identifier with another layout, so isIdentifier says yes to it.
interface Keyword extends Node { readonly kind: SyntaxKind.Identifier; readonly width: number }
const keyword: Keyword = { kind: SyntaxKind.Identifier, width: 3 };
console.log(visitNode(keyword, isIdentifier));
