interface Expression {
    readonly kind: "E";
    readonly e: number;
}
interface Statement {
    readonly kind: "S";
    readonly s: string;
}
type Node = Expression | Statement;
let calls = 0;
// Unproven, and it lies on true: it says yes to an Expression.
function isS(n: Node): n is Statement {
    calls = calls + 1;
    return calls > 0;
}
const expression: Node = { kind: "E", e: 1 };
function choose(present: boolean): ((node: Node) => node is Statement) | undefined {
    return present ? isS : undefined;
}
console.log(String(choose(false)?.(expression)));
if (choose(true)?.(expression)) {
    console.log(expression.s);
}
