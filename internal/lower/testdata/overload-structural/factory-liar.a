interface Result<T> { readonly value: T; flag: boolean; }
const shared: Result<string | number | undefined> = { value: 1, flag: false };
function widerResult(): Result<string | number | undefined> { return shared; }
function evaluate(): Result<string | undefined>;
function evaluate(): Result<string | number | undefined> { return widerResult(); }
console.log(`${evaluate().value}`);
