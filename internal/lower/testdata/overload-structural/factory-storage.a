// a-check: refused overload 1 of evaluate result Result<string | number> cannot be served by implementation result Other | Result<string | number> at result.value; required field is absent from Other; prove every return for this overload's admitted arguments, preserving result variance
interface Result<T> { readonly value: T; }
interface Other { readonly other: boolean; }
const shared: Result<number> = { value: 7 };
function narrowResult(): Result<number> { return shared; }
function evaluate(): Result<number | string>;
function evaluate(): Result<number | string> | Other { return narrowResult(); }
console.log(`${evaluate().value}`);
