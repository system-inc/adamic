import { panic } from 'adamic';
import { readFileSync, openSync, writeSync, closeSync, statSync, mkdirSync, unlinkSync, utimesSync } from 'node:fs';

function errorCode(error: unknown): string | undefined {
    return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' ? error.code : undefined;
}
export function writeFile(path: string, data: string, writeByteOrderMark?: boolean): void {
    let fd: number | undefined = undefined;
    try {
        fd = openSync(path, 'w');
        writeSync(fd, writeByteOrderMark === true ? '\uFEFF' + data : data, undefined, 'utf8');
    } finally {
        if (fd !== undefined) { closeSync(fd); }
    }
}
export function fileExists(path: string): boolean {
    try { const stat = statSync(path, {throwIfNoEntry:false}); return stat === undefined ? false : stat.isFile(); }
    catch { return false; }
}
export function getFileSize(path: string): number {
    try { const stat = statSync(path, {throwIfNoEntry:false}); return stat === undefined ? 0 : stat.isFile() ? stat.size : 0; }
    catch { return 0; }
}
export function getModifiedTime(path: string): Date | undefined {
    try { const stat = statSync(path, {throwIfNoEntry:false}); return stat === undefined ? undefined : stat.mtime; }
    catch { return undefined; }
}
export function setModifiedTime(path: string, time: Date): void {
    try { utimesSync(path, time, time); } catch { return; }
}
export function deleteFile(path: string): void {
    try { return unlinkSync(path); } catch { return; }
}
export function createDirectory(path: string): void {
    try {
        const stat = statSync(path, {throwIfNoEntry:false});
        if (stat !== undefined && stat.isDirectory()) { return; }
    } catch { /* getNodeSystem's directoryExists treats every failure as missing. */ }
    try { mkdirSync(path); }
    catch (error) { if (error instanceof Error) { if (errorCode(error) !== 'EEXIST') { throw error; } } }
}

export function readFile(fileName: string, _encoding?: string): string | undefined {
    let buffer: Buffer;
    try { buffer = readFileSync(fileName); }
    catch { return undefined; }
    let len = buffer.length;
    if (len >= 2 && buffer[0] === 0xFE && buffer[1] === 0xFF) {
        len &= ~1;
        for (let i = 0; i < len; i += 2) {
            const temp = (buffer[i] ?? panic('BOM byte missing'));
            buffer[i] = (buffer[i + 1] ?? panic('BOM pair missing'));
            buffer[i + 1] = temp;
        }
        return buffer.toString('utf16le', 2);
    }
    if (len >= 2 && buffer[0] === 0xFF && buffer[1] === 0xFE) { return buffer.toString('utf16le', 2); }
    if (len >= 3 && buffer[0] === 0xEF && buffer[1] === 0xBB && buffer[2] === 0xBF) { return buffer.toString('utf8', 3); }
    return buffer.toString('utf8');
}
