import 'node:process';
let stash: (() => string) | undefined;
try {
 stash = (): string => { return typeof session.connect; };
 const inspector: typeof import('inspector') = require('inspector');
 const session = new inspector.Session();
 session.connect();
} catch (error) {
 console.log('require caught');
}
try {
 console.log(stash === undefined ? "none" : stash());
} catch (error) {
 console.log(error instanceof ReferenceError ? "dead zone" : "other");
}
