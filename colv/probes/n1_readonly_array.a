const collator = new Intl.Collator(undefined, { usage: 'sort', sensitivity: 'variant', numeric: true });
const collators: Intl.Collator[] = [collator];
const views: readonly { compare: (x: string, y: string) => number }[] = collators;
try {
	views[0].compare = (x: string, y: string): number => 0;
	console.log('wrote');
} catch (error) {
	console.log('threw');
}
console.log(String(collator.compare('a', 'b')));
