const collator = new Intl.Collator(undefined, { usage: 'sort', sensitivity: 'variant', numeric: true });
function isView(value: unknown): value is { compare: (x: string, y: string) => number } {
	return typeof value === 'object' && value !== null && 'compare' in value;
}
const opaque: unknown = collator;
if (isView(opaque)) {
	try {
		opaque.compare = (x: string, y: string): number => 0;
		console.log('wrote');
	} catch (error) {
		console.log('threw');
	}
}
console.log(String(collator.compare('a', 'b')));
