const collator = new Intl.Collator(undefined, { usage: 'sort', sensitivity: 'variant', numeric: true });
const frozen = Object.freeze(collator);
const view: { compare: (x: string, y: string) => number } = frozen;
try {
	view.compare = (x: string, y: string): number => 0;
	console.log('wrote');
} catch (error) {
	console.log('threw');
}
console.log(String(collator.compare('a', 'b')));
