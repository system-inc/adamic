package main

import (
	"strings"
	"unicode"
)

// frontmatter is the YAML between /*--- and ---*/ that test262 puts at the top of a test
// (INTERPRETING.md). Only the fields the runner acts on are kept.
type frontmatter struct {
	Features      []string
	Flags         []string
	Includes      []string
	NegativePhase string
	NegativeType  string
	Present       bool
}

// parseFrontmatter reads the first /*--- ... ---*/ block. A file without one has a zero value and
// Present false: the whole file is the test.
func parseFrontmatter(source string) frontmatter {
	start := strings.Index(source, "/*---")
	if start < 0 {
		return frontmatter{}
	}
	rest := source[start+len("/*---"):]
	end := strings.Index(rest, "---*/")
	if end < 0 {
		return frontmatter{}
	}
	parsed := parseYAMLSubset(rest[:end])
	parsed.Present = true
	return parsed
}

// bodyAfterFrontmatter is the test with that block removed. The copyright comment above it stays.
func bodyAfterFrontmatter(source string) string {
	start := strings.Index(source, "/*---")
	if start < 0 {
		return source
	}
	rest := source[start+len("/*---"):]
	end := strings.Index(rest, "---*/")
	if end < 0 {
		return source
	}
	return source[:start] + rest[end+len("---*/"):]
}

// parseYAMLSubset reads the small shape test262 actually writes: scalars, flow lists, block lists,
// and one level of nesting (negative: phase and type). Block scalars (| and >) are skipped. It is
// not a YAML parser; a construct it doesn't understand is ignored, and the test is then attempted
// rather than sorted wrong in silence only when the field was one we needed. The corpus tests cover
// the shapes this tree uses.
func parseYAMLSubset(yaml string) frontmatter {
	var parsed frontmatter
	parent := ""
	parentIndent := -1
	listKey := ""
	listIndent := -1
	blockIndent := -1
	for _, line := range strings.Split(yaml, "\n") {
		if blockIndent >= 0 {
			if strings.TrimSpace(line) == "" || indentOf(line) > blockIndent {
				continue
			}
			blockIndent = -1
		}
		if strings.TrimSpace(line) == "" {
			continue
		}
		indent := indentOf(line)
		trim := strings.TrimSpace(line)
		if strings.HasPrefix(trim, "- ") && listKey != "" && indent > listIndent {
			addField(&parsed, listKey, unquote(strings.TrimSpace(trim[2:])))
			continue
		}
		colon := strings.Index(trim, ":")
		if colon <= 0 || strings.ContainsAny(trim[:colon], " \t'\"") {
			continue
		}
		key := trim[:colon]
		value := strings.TrimSpace(trim[colon+1:])
		if parent != "" && indent <= parentIndent {
			parent = ""
		}
		fullKey := key
		if parent != "" && indent > parentIndent {
			fullKey = parent + "." + key
		}
		listKey = ""
		if value == "|" || value == ">" || value == "|-" || value == ">-" || value == "|+" || value == ">+" {
			blockIndent = indent
			continue
		}
		if value == "" {
			parent = key
			parentIndent = indent
			listKey = fullKey
			listIndent = indent
			continue
		}
		if strings.HasPrefix(value, "[") && strings.HasSuffix(value, "]") {
			for _, item := range splitFlowList(value[1 : len(value)-1]) {
				addField(&parsed, fullKey, item)
			}
			continue
		}
		setScalar(&parsed, fullKey, unquote(value))
	}
	return parsed
}

func addField(parsed *frontmatter, key string, value string) {
	if value == "" {
		return
	}
	switch key {
	case "features":
		parsed.Features = append(parsed.Features, value)
	case "flags":
		parsed.Flags = append(parsed.Flags, value)
	case "includes":
		parsed.Includes = append(parsed.Includes, value)
	default:
		setScalar(parsed, key, value)
	}
}

func setScalar(parsed *frontmatter, key string, value string) {
	if auditSelector() == "M03" {
		setScalar_audit_M03(parsed, key, value)
		return
	}

	switch key {
	case "negative.phase":
		parsed.NegativePhase = value
	case "negative.type":
		parsed.NegativeType = value
	case "features", "flags", "includes":
		addField(parsed, key, value)
	}
}

func splitFlowList(inside string) []string {
	if strings.TrimSpace(inside) == "" {
		return nil
	}
	parts := strings.Split(inside, ",")
	items := make([]string, 0, len(parts))
	for _, part := range parts {
		item := unquote(strings.TrimSpace(part))
		if item != "" {
			items = append(items, item)
		}
	}
	return items
}

func unquote(value string) string {
	if len(value) >= 2 {
		if (value[0] == '"' && value[len(value)-1] == '"') || (value[0] == '\'' && value[len(value)-1] == '\'') {
			return value[1 : len(value)-1]
		}
	}
	return value
}

func indentOf(line string) int {
	indent := 0
	for _, character := range line {
		if character == ' ' {
			indent++
			continue
		}
		if character == '\t' {
			indent += 2
			continue
		}
		if unicode.IsSpace(character) {
			indent++
			continue
		}
		break
	}
	return indent
}

func setScalar_audit_M03(parsed *frontmatter, key string, value string) {
	switch key {
	case "negative.phase":
		parsed.NegativePhase = value
	case "negative.type":

	case "features", "flags", "includes":
		addField(parsed, key, value)
	}
}
