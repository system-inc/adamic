package main
import("go/parser";"go/token";"go/ast";"encoding/json";"os";"path/filepath")
func main(){b,_:=os.ReadFile("/workspace/adamic/review/test-audit/cmd-adamic-test262-corpus/base.json");sources:=map[string]string{};json.Unmarshal(b,&sources);tests,_:=filepath.Glob("/workspace/adamic/cmd/adamic-test262/*_test.go");for _,p:=range tests {b,_:=os.ReadFile(p);sources[filepath.Base(p)]=string(b)};graph:=map[string][]string{};files:=map[string]string{};for name,s:=range sources {f,_:=parser.ParseFile(token.NewFileSet(),name,s,0);for _,d:=range f.Decls{fn,ok:=d.(*ast.FuncDecl);if !ok{continue};files[fn.Name.Name]=name;ast.Inspect(fn.Body,func(n ast.Node)bool{c,ok:=n.(*ast.CallExpr);if !ok{return true};switch a:=c.Fun.(type){case *ast.Ident:graph[fn.Name.Name]=append(graph[fn.Name.Name],a.Name);case *ast.SelectorExpr:graph[fn.Name.Name]=append(graph[fn.Name.Name],a.Sel.Name)};return true})}};json.NewEncoder(os.Stdout).Encode(map[string]any{"calls":graph,"files":files})}
