@@ -0,0 +1,16 @@
+package lower
+
+import (
+	"github.com/microsoft/TypeScript/tsc/shim/ast"
+	"os"
+)
+
+var auditU038Selector = os.Getenv("ADAMIC_MUTANT")
+
+func auditU038(id string) bool { return auditU038Selector == id }
+func auditU038Statements(statements []*ast.Node) []*ast.Node {
+	if auditU038("M02") {
+		return statements[:max(0, len(statements)-1)]
+	}
+	return statements
+}
