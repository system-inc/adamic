@@ -0,0 +1,11 @@
+package native
+
+import "os"
+
+func auditMutant(id string) bool { return os.Getenv("ADAMIC_MUTANT") == id }
+func auditValue[T any](id string, normal, mutant T) T {
+	if auditMutant(id) {
+		return mutant
+	}
+	return normal
+}
