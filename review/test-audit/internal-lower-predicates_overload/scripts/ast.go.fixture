package main
import("go/parser";"go/token";"go/ast";"encoding/json";"os";"path/filepath";"strings")
func main(){out:=map[string][]map[string]any{};files,_:=filepath.Glob("/workspace/adamic/internal/lower/*.go");for _,p:=range files {if strings.HasSuffix(p,"_test.go"){continue};fs:=token.NewFileSet();f,_:=parser.ParseFile(fs,p,nil,0);for _,d:=range f.Decls {a,ok:=d.(*ast.FuncDecl);if !ok || a.Body==nil{continue};args:=[]string{};for _,field:=range a.Type.Params.List {for _,n:=range field.Names{args=append(args,n.Name)}};rec:="";if a.Recv!=nil && len(a.Recv.List[0].Names)>0{rec=a.Recv.List[0].Names[0].Name+"."};results:=a.Type.Results!=nil;out[filepath.Base(p)]=append(out[filepath.Base(p)],map[string]any{"name":a.Name.Name,"start":fs.Position(a.Pos()).Offset,"end":fs.Position(a.End()).Offset,"body":fs.Position(a.Body.Lbrace).Offset,"namepos":fs.Position(a.Name.Pos()).Offset,"args":strings.Join(args,","),"receiver":rec,"results":results})}};json.NewEncoder(os.Stdout).Encode(out)}
