diff --git a/internal/load/audit_mutant.go b/internal/load/audit_mutant.go
new file mode 100644
index 00000000..9027a2bc
--- /dev/null
+++ b/internal/load/audit_mutant.go
@@ -0,0 +1,11 @@
+package load
+
+import "os"
+
+func auditMutant(id string) bool { return os.Getenv("ADAMIC_MUTANT") == id }
+func auditDiagnosticCode(n int32) int32 {
+	if auditMutant("M03") {
+		return n + 1
+	}
+	return n
+}
diff --git a/internal/lower/audit_mutant.go b/internal/lower/audit_mutant.go
new file mode 100644
index 00000000..0cd09370
--- /dev/null
+++ b/internal/lower/audit_mutant.go
@@ -0,0 +1,17 @@
+package lower
+
+import "os"
+
+func auditMutant(id string) bool { return os.Getenv("ADAMIC_MUTANT") == id }
+func auditElementMessage(name string) string {
+	if auditMutant("M07") {
+		return "typed array facility " + name
+	}
+	return "typed array element type " + name
+}
+func auditNotYetWhat(what string) string {
+	if auditMutant("M16") {
+		return "unsupported construct"
+	}
+	return what
+}
