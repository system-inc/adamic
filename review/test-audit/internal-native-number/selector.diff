diff --git a/internal/native/runtime/audit_mutant.h b/internal/native/runtime/audit_mutant.h
new file mode 100644
index 00000000..991005dd
--- /dev/null
+++ b/internal/native/runtime/audit_mutant.h
@@ -0,0 +1,6 @@
+#ifndef ADAMIC_AUDIT_MUTANT_H
+#define ADAMIC_AUDIT_MUTANT_H
+#include <stdlib.h>
+#include <string.h>
+static bool audit_mutant(const char *id) { const char *selected = getenv("ADAMIC_MUTANT"); return selected != NULL && strcmp(selected, id) == 0; }
+#endif
diff --git a/internal/buildcache/audit_mutant.go b/internal/buildcache/audit_mutant.go
new file mode 100644
index 00000000..ae546a46
--- /dev/null
+++ b/internal/buildcache/audit_mutant.go
@@ -0,0 +1,11 @@
+package buildcache
+
+import "os"
+
+func auditMutant(id string) bool { return os.Getenv("ADAMIC_MUTANT") == id }
+func auditName(name string) string {
+	if auditMutant("M11") {
+		return "artifact"
+	}
+	return name
+}
