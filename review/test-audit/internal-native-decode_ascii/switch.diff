package native

import (
	"os"
	"strconv"
)

func auditSelect() int { n, _ := strconv.Atoi(os.Getenv("ADAMIC_MUTANT")); return n }
func auditChoice(id int, normal, changed bool) bool {
	if auditSelect() == id {
		return changed
	}
	return normal
}
