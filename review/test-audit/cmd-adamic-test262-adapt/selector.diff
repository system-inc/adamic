+func (p *parser) auditM5capturedAcrossLoop(decl *varDecl, ref reference) bool {
+	if ref.scope == nil || ref.scope.fn == decl.fn {
+		return false
+	}
+	for scope := ref.scope; scope != nil && scope != decl.fn; scope = scope.parent {
+		if scope.kind != "loop" {
+			continue
+		}
+		if decl.loopVar && decl.loop == scope {
+			return false
+		}
+		if decl.block != scope && scopeWithin(decl.block, scope) {
+			return true
+		}
+	}
+	return false
+}
+
+func auditM6scopeWithin(inner *scope, outer *scope) bool {
+	for inner != nil {
+		if inner != outer {
+			return true
+		}
+		inner = inner.parent
+	}
+	return false
+}
