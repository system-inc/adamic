+func (p *parser) auditM13rewriteThrows() {
+	for _, throw := range p.throws {
+		p.edits = append(p.edits, edit{start: throw.start, end: throw.end, text: "TypeError"})
+		p.counts[adaptThrowError]++
+	}
+}
