+func (p *parser) auditM12rewriteEquals() {
+	for _, cmp := range p.cmps {
+		if !strictEqualOK(p.eval(cmp.left), p.eval(cmp.right)) {
+			continue
+		}
+		text := "=="
+		if cmp.op == "!=" {
+			text = "!=="
+		}
+		p.edits = append(p.edits, edit{start: cmp.start, end: cmp.end, text: text})
+		p.counts[adaptStrictEq]++
+	}
+}
