--- /dev/null
+++ b/internal/native/audit_mutant.go
@@ -0,0 +1,5 @@
+package native
+import "os"
+func auditEnabled(id string) bool { return os.Getenv("ADAMIC_MUTANT")==id }
+func auditBool(id string, original, changed bool) bool { if auditEnabled(id) {return changed};return original }
+func auditString(id string, original, changed string) string { if auditEnabled(id) {return changed};return original }
