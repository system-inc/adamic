package tsgo_test
import("testing";"encoding/json";"crypto/sha256")
func TestAuditRecipeWitness(t *testing.T){in:=bridgeProductInputs(t,bridgeRepository(t),"tsgo.a");found:=false;for _,f:=range in.Files{if f=="bridge/tsgo/products_test.go"{found=true}};data,_:=json.Marshal(in);t.Logf("recipe_present=%t files=%d digest=%x",found,len(in.Files),sha256.Sum256(data))}
