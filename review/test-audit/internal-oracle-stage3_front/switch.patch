diff --git a/internal/lower/audit_mutant.go b/internal/lower/audit_mutant.go
new file mode 100644
index 00000000..11f594f0
--- /dev/null
+++ b/internal/lower/audit_mutant.go
@@ -0,0 +1,26 @@
+package lower
+
+import (
+	"github.com/system-inc/adamic/internal/ir"
+	"os"
+)
+
+func auditMutant(id string) bool { return os.Getenv("ADAMIC_MUTANT") == id }
+func auditString(id, before, after string) string {
+	if auditMutant(id) {
+		return after
+	}
+	return before
+}
+func auditNumber(id string, before, after float64) float64 {
+	if auditMutant(id) {
+		return after
+	}
+	return before
+}
+func auditSwitchOperator(id string, before, after ir.Operator) ir.Operator {
+	if auditMutant(id) {
+		return after
+	}
+	return before
+}
