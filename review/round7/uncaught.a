// An uncaught error after a lot of buffered output, thrown from inside a finally's try, through
// nested for...of loops over an array and a Map, three calls deep. Every line before must come out,
// then the panic, with the finally's line between them.
function deep(level: number, rows: string[], table: Map<string, number>): number {
	let total = 0;
	for (const row of rows) {
		for (const [key, value] of table) {
			total += value + key.length + row.length;
			if (level === 0 && total > 50) {
				throw new Error(`deep ${level} ${total}`);
			}
		}
		if (level > 0) {
			total += deep(level - 1, rows, table);
		}
	}
	return total;
}
const rows: string[] = [];
const table = new Map<string, number>();
for (let index = 0; index < 3; index++) {
	rows.push(`row${index}`);
	table.set(`key${index}`, index);
}
for (let line = 0; line < 2000; line++) {
	console.log(`line ${line}`);
}
try {
	console.log(`${deep(3, rows, table)}`);
} finally {
	console.log('finally ran');
}
console.log('never');
