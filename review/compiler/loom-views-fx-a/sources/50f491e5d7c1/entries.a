interface Root { readonly kind: 1; }
interface View extends Root { readonly count: 7; }
const raw = { kind: 1 as const, count: 9 };
const base: Root = raw;
const view = base as View;
const entries: [string, number][] = Object.entries(view);
for (const [key, value] of entries) console.log(`${key}:${value}`);
