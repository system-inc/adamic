      "+// Map adapts each supplied value to the callback's actual signature. It does not",
      "+// adapt storage reachable through a parameter, or change the result protocol.",
      "+func (l *lowering) nullableObjectAdaptedMapCallback(node *ast.Node, contextual *checker.Type) bool {",
      "+\tif !l.libraryMapArgument(node) {",
      "+\t\treturn false",
      "+\t}",
      "+\touter := node",
      "+\tfor outer.Parent.Kind == ast.KindParenthesizedExpression {",
      "+\t\touter = outer.Parent",
      "+\t}",
      "+\tcallee := ast.SkipParentheses(outer.Parent.AsCallExpression().Expression)",
      "+\treceiver := l.concrete(l.checker.GetTypeAtLocation(callee.AsPropertyAccessExpression().Expression))",
      "+\tif !l.checker.IsArrayType(receiver) && !checker.IsTupleType(receiver) {",
      "+\t\treturn false",
      "+\t}",
      "+\tactual := l.checker.GetSignaturesOfType(l.checker.GetTypeAtLocation(node), checker.SignatureKindCall)",
      "+\texpected := l.checker.GetSignaturesOfType(contextual, checker.SignatureKindCall)",
      "+\tif len(actual) != 1 || len(expected) != 1 || len(actual[0].Parameters()) > len(expected[0].Parameters()) {",
      "+\t\treturn false",
      "+\t}",
      "+\tif l.concrete(l.checker.GetReturnTypeOfSignature(actual[0])) != l.concrete(l.checker.GetReturnTypeOfSignature(expected[0])) {",
      "+\t\treturn false",
      "+\t}",
      "+\tfor index, parameter := range actual[0].Parameters() {",
      "+\t\tif len(parameter.Declarations) > 0 && parameter.Declarations[0].Kind == ast.KindParameter && parameter.Declarations[0].AsParameterDeclaration().DotDotDotToken != nil {",
      "+\t\t\treturn false",
      "+\t\t}",
      "+\t\tif !l.nullableObjectCallbackStorageMatches(l.checker.GetTypeOfSymbol(parameter), l.checker.GetTypeOfSymbol(expected[0].Parameters()[index])) {",
      "+\t\t\treturn false",
      "+\t\t}",
      "+\t}",
      "+\treturn true",
      "+}",
      "+",
      "+// Only primitive alternatives may change at a value boundary. Keep every",
      "+// nonprimitive member identical, including an array's element-storage type.",
      "+func (l *lowering) nullableObjectCallbackStorageMatches(from, to *checker.Type) bool {",
      "+\tmembers := func(proven *checker.Type) []*checker.Type {",
      "+\t\tvar held []*checker.Type",
      "+\t\tvar visit func(*checker.Type)",
      "+\t\tvisit = func(each *checker.Type) {",
      "+\t\t\teach = l.concrete(each)",
      "+\t\t\tif each.Flags()&checker.TypeFlagsUnion != 0 {",
      "+\t\t\t\tfor _, part := range each.Types() {",
      "+\t\t\t\t\tvisit(part)",
      "+\t\t\t\t}",
      "+\t\t\t} else if each.Flags()&(checker.TypeFlagsStringLike|checker.TypeFlagsNumberLike|checker.TypeFlagsBooleanLike|checker.TypeFlagsNull|checker.TypeFlagsUndefined|checker.TypeFlagsVoid|checker.TypeFlagsNever) == 0 {",
      "+\t\t\t\theld = append(held, each)",
      "+\t\t\t}",
      "+\t\t}",
      "+\t\tvisit(proven)",
      "+\t\treturn held",
      "+\t}",
      "+\tleft, right := members(from), members(to)",
      "+\tif len(left) != len(right) {",
      "+\t\treturn false",
      "+\t}",
      "+\tfor _, member := range left {",
      "+\t\tfound := false",
      "+\t\tfor _, other := range right {",
      "+\t\t\tfound = found || member == other",
      "+\t\t}",
      "+\t\tif !found {",
      "+\t\t\treturn false",
      "+\t\t}",
      "+\t}",
      "+\treturn true",
      "+}"
    ]
