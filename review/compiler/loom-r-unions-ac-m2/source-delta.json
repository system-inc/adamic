      "+package lower",
      "+",
      "+import (",
      "+\t\"github.com/microsoft/TypeScript/tsc/shim/ast\"",
      "+\t\"github.com/microsoft/TypeScript/tsc/shim/checker\"",
      "+\t\"github.com/system-inc/adamic/internal/ir\"",
      "+)",
      "+",
      "+// Admit one concrete object representation plus both nullish tags. Collections,",
      "+// closures, weak handles and erased structural primitives need their own proofs.",
      "+func (l *lowering) nullableObjectUnion(proven *checker.Type) bool {",
      "+\tproven = l.concrete(proven)",
      "+\tif proven.Flags()&checker.TypeFlagsUnion == 0 || !l.includesNull(proven) || !l.includesUndefined(proven) {",
      "+\t\treturn false",
      "+\t}",
      "+\tpresent := l.checker.GetNonNullableType(proven)",
      "+\theld, known := l.representation(present)",
      "+\treturn known && held == ir.Object && present.Flags()&checker.TypeFlagsObject != 0",
      "+}",
      "+",
      "+func unionObservation(node *ast.Node) bool {",
      "+\tparent := node.Parent",
      "+\tfor parent != nil && parent.Kind == ast.KindParenthesizedExpression {",
      "+\t\tnode, parent = parent, parent.Parent",
      "+\t}",
      "+\tif comparedWithUndefined(node) || parent != nil && parent.Kind == ast.KindTypeOfExpression {",
      "+\t\treturn true",
      "+\t}",
      "+\tif parent != nil && parent.Kind == ast.KindBinaryExpression {",
      "+\t\tbinary := parent.AsBinaryExpression()",
      "+\t\tswitch binary.OperatorToken.Kind {",
      "+\t\tcase ast.KindEqualsEqualsEqualsToken, ast.KindExclamationEqualsEqualsToken:",
      "+\t\t\treturn true",
      "+\t\tcase ast.KindQuestionQuestionToken:",
      "+\t\t\treturn binary.Left == node",
      "+\t\t}",
      "+\t}",
      "+\treturn false",
      "+}",
      "+",
      "+func (l *lowering) checkedNullableObject(node *ast.Node, read ir.Expression) ir.Expression {",
      "+\tobserved := l.concrete(l.checker.GetTypeAtLocation(node))",
      "+\tnarrowed, known := l.representation(observed)",
      "+\tcontextual := l.checker.GetContextualType(node, checker.ContextFlagsNone)",
      "+\tif contextual != nil && l.nullableObjectUnion(contextual) {",
      "+\t\treturn read",
      "+\t}",
      "+\tif !known || narrowed == ir.Union || unionObservation(node) {",
      "+\t\treturn read",
      "+\t}",
      "+\tb := l.libraryArrayBuilder([]ir.Expression{read})",
      "+\theld := b.read(b.parameters[0])",
      "+\tnull := ir.Expression(ir.IsNull{Value: held})",
      "+\tmatches := ir.Expression(ir.Binary{Operator: ir.And,",
      "+\t\tLeft:  ir.Binary{Operator: ir.Equal, Left: ir.TypeOf{Value: held}, Right: ir.StringConstant{Index: l.constant(\"object\")}},",
      "+\t\tRight: ir.Unary{Operator: ir.Not, Operand: null}})",
      "+\tif l.includesNull(observed) {",
      "+\t\tmatches = ir.Binary{Operator: ir.Or, Left: matches, Right: null}",
      "+\t}",
      "+\tif l.includesUndefined(observed) {",
      "+\t\tmatches = ir.Binary{Operator: ir.Or, Left: matches, Right: ir.IsUndefined{Value: held}}",
      "+\t}",
      "+\tmessage := \"union member where the checker narrowed it away: a call since the narrowing put it back\"",
      "+\tb.body = append(b.body, ir.If{Condition: ir.Unary{Operator: ir.Not, Operand: matches}, Then: []ir.Statement{ir.Panic{Message: ir.StringConstant{Index: l.constant(message)}}}})",
      "+\tresult := ir.Expression(ir.Narrow{Value: held, To: ir.Object})",
      "+\tif l.includesNull(observed) {",
      "+\t\tresult = ir.Conditional{Condition: null, WhenTrue: ir.Null{Of: ir.Object}, WhenNot: result, Of: ir.Object}",
      "+\t}",
      "+\tcall := b.finish(\"narrowed_nullable_object\", result)",
      "+\tl.result.Functions[b.function].CheckedUnionNarrow = true",
      "+\treturn call",
      "+}",
      "+",
      "+// A legacy object-or-null pointer uses NULL for null. Normalize it when a",
      "+// contextual tagged slot receives it, evaluating the source only once.",
      "+func (l *lowering) nullableObjectBoundary(node *ast.Node, value ir.Expression) ir.Expression {",
      "+\tif value == nil || value.Type() != ir.Object {",
      "+\t\treturn value",
      "+\t}",
      "+\town := l.concrete(l.checker.GetTypeAtLocation(node))",
      "+\tif !l.includesNull(own) || l.includesUndefined(own) {",
      "+\t\treturn value",
      "+\t}",
      "+\tcontextual := l.checker.GetContextualType(node, checker.ContextFlagsNone)",
      "+\tif contextual == nil {",
      "+\t\treturn value",
      "+\t}",
      "+\ttarget, known := l.representation(contextual)",
      "+\tif !known || target != ir.Union {",
      "+\t\treturn value",
      "+\t}",
      "+\tif _, literal := value.(ir.Null); literal {",
      "+\t\treturn value",
      "+\t}",
      "+\tb := l.libraryArrayBuilder([]ir.Expression{value})",
      "+\theld := b.read(b.parameters[0])",
      "+\treturn b.finish(\"nullable_object_to_union\", ir.Conditional{Condition: ir.IsNull{Value: held}, WhenTrue: ir.Box{Value: ir.Null{}}, WhenNot: ir.Box{Value: held}, Of: ir.Union})",
      "+}",
      "+",
      "+// Optional access skips both nullish tags; only an actual object reaches the read.",
      "+func (l *lowering) optionalNullableObject(read ir.Expression) ir.Expression {",
      "+\tb := l.libraryArrayBuilder([]ir.Expression{read})",
      "+\theld := b.read(b.parameters[0])",
      "+\tabsent := ir.Binary{Operator: ir.Or, Left: ir.IsNull{Value: held}, Right: ir.IsUndefined{Value: held}}",
      "+\treturn b.finish(\"optional_nullable_object\", ir.Conditional{Condition: absent, WhenTrue: ir.Undefined{Of: ir.Object}, WhenNot: ir.Narrow{Value: held, To: ir.Object}, Of: ir.Object})",
      "+}",
      "+",
      "+// A value boundary can normalize a pointer. Shared fields, elements and callable",
      "+// signatures cannot change their storage convention without a copy or adapter.",
      "+func (l *lowering) nullableObjectSharedView(from, to *checker.Type, visited map[[2]*checker.Type]bool) bool {",
      "+\tfrom, to = l.present(l.concrete(from)), l.present(l.concrete(to))",
      "+\tif from == nil || to == nil || from == to || visited[[2]*checker.Type{from, to}] {",
      "+\t\treturn false",
      "+\t}",
      "+\tvisited[[2]*checker.Type{from, to}] = true",
      "+\tshared := func(inside, viewed *checker.Type) bool {",
      "+\t\tinside, viewed = l.concrete(inside), l.concrete(viewed)",
      "+\t\tbefore, knownBefore := l.representation(inside)",
      "+\t\tafter, knownAfter := l.representation(viewed)",
      "+\t\tif knownBefore && knownAfter && before != after &&",
      "+\t\t\t(before == ir.Object && l.includesNull(inside) && after == ir.Union ||",
      "+\t\t\t\tafter == ir.Object && l.includesNull(viewed) && before == ir.Union) {",
      "+\t\t\treturn true",
      "+\t\t}",
      "+\t\treturn l.nullableObjectSharedView(inside, viewed, visited)",
      "+\t}",
      "+\ta := l.checker.GetSignaturesOfType(from, checker.SignatureKindCall)",
      "+\tb := l.checker.GetSignaturesOfType(to, checker.SignatureKindCall)",
      "+\tif len(a) > 0 && len(b) > 0 {",
      "+\t\tfor i, parameter := range a[0].Parameters() {",
      "+\t\t\tif i < len(b[0].Parameters()) && shared(l.checker.GetTypeOfSymbol(parameter), l.checker.GetTypeOfSymbol(b[0].Parameters()[i])) {",
      "+\t\t\t\treturn true",
      "+\t\t\t}",
      "+\t\t}",
      "+\t\treturn shared(l.checker.GetReturnTypeOfSignature(a[0]), l.checker.GetReturnTypeOfSignature(b[0]))",
      "+\t}",
      "+\tif l.checker.IsArrayType(from) || checker.IsTupleType(from) || l.isLibraryType(from, \"Map\", \"ReadonlyMap\", \"Set\", \"ReadonlySet\") {",
      "+\t\ta, b := l.typeArguments(from), l.typeArguments(to)",
      "+\t\tfor i := range a {",
      "+\t\t\tif i < len(b) && shared(a[i], b[i]) {",
      "+\t\t\t\treturn true",
      "+\t\t\t}",
      "+\t\t}",
      "+\t\treturn false",
      "+\t}",
      "+\tfor _, field := range l.checker.GetPropertiesOfType(to) {",
      "+\t\tif field.Flags&ast.SymbolFlagsMethod != 0 {",
      "+\t\t\tcontinue",
      "+\t\t}",
      "+\t\tif previous := l.checker.GetPropertyOfType(from, field.Name); previous != nil && shared(l.checker.GetTypeOfSymbol(previous), l.checker.GetTypeOfSymbol(field)) {",
      "+\t\t\treturn true",
      "+\t\t}",
      "+\t}",
      "+\treturn false",
      "+}",
      "+",
      "+func freshNullableObjectStorage(node *ast.Node) bool {",
      "+\tnode = ast.SkipParentheses(node)",
      "+\tif node.Kind != ast.KindArrayLiteralExpression && node.Kind != ast.KindObjectLiteralExpression {",
      "+\t\treturn false",
      "+\t}",
      "+\tfor _, part := range literalParts(node) {",
      "+\t\tif part.Kind == ast.KindSpreadElement || part.Kind == ast.KindSpreadAssignment {",
      "+\t\t\treturn false",
      "+\t\t}",
      "+\t}",
      "+\treturn true",
      "+}",
      "+",
      "+func (l *lowering) nullableObjectViewHazard(node *ast.Node, contextual *checker.Type) bool {",
      "+\t// RegExp replacement adapts the closure's actual signature instead of sharing",
      "+\t// lib.d.ts's callable ABI, including its declared return conversion.",
      "+\tif l.regexReplacementArgument(node) {",
      "+\t\treturn false",
      "+\t}",
      "+\treturn !freshNullableObjectStorage(node) && l.nullableObjectSharedView(l.checker.GetTypeAtLocation(node), contextual, map[[2]*checker.Type]bool{})",
      "+}",
      "+",
      "+// These existing typeof paths retain the lookup slot's presence until it is",
      "+// classified. An ordinary nullable pointer lookup loses that distinction.",
      "+func nullableObjectLookupTypeOf(node *ast.Node, value ir.Expression) bool {",
      "+\tparent := node.Parent",
      "+\tfor parent != nil && parent.Kind == ast.KindParenthesizedExpression {",
      "+\t\tparent = parent.Parent",
      "+\t}",
      "+\tif parent == nil || parent.Kind != ast.KindTypeOfExpression {",
      "+\t\treturn false",
      "+\t}",
      "+\tswitch value.(type) {",
      "+\tcase ir.ArrayIndex, ir.MapGet, ir.ArrayPop:",
      "+\t\treturn true",
      "+\t}",
      "+\treturn false",
      "+}"
    ],
