+	}
+}
+function run(n: number): void {
+	const box: Box = { label: `b${n}` };
+	const getter: WeakGetter = new StrongGetter(box);
+	const got = getter.get();
+	console.log(`${got === box} ${got?.label ?? 'gone'}`);
