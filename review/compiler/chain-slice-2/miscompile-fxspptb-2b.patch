+import type { Weak } from 'adamic';
+
+// The control for weak_union_narrowed.a: a Weak of one interface, narrowed, read after its target
+// was freed, through a local as that probe reads it.
+interface Named {
+	readonly name: string;
+}
+interface Holder {
+	kept: Weak<Named>;
+}
+let strong: Named | undefined = { name: 'n'.repeat(2) };
+const holder: Holder = { kept: strong };
+if (holder.kept !== undefined) {
+	console.log('before');
+	strong = undefined;
+	const seen = holder.kept;
+	console.log(`after: ${seen.name}`);
+}
diff --git a/internal/oracle/testdata/weak_miscompiles/4ddd17f_weak_union_narrowed.a b/internal/oracle/testdata/weak_miscompiles/4ddd17f_weak_union_narrowed.a
new file mode 100644
index 00000000..6b5f31bc
--- /dev/null
+++ b/internal/oracle/testdata/weak_miscompiles/4ddd17f_weak_union_narrowed.a
@@ -0,0 +1,23 @@
+import type { Weak } from 'adamic';
+
+// A Weak of a union the checker narrowed to present, read after its target was released: weak/narrowed.a
+// says natively a panic, never a read of freed memory or a null one; on Node the target is still there.
+interface Named {
+	readonly kind: 'Named';
+	readonly name: string;
+}
+interface Counted {
+	readonly kind: 'Counted';
+	readonly count: number;
+}
+interface Holder {
+	kept: Weak<Named | Counted>;
+}
+let strong: Named | undefined = { kind: 'Named', name: 'n'.repeat(2) };
+const holder: Holder = { kept: strong };
+if (holder.kept !== undefined) {
+	console.log('before');
+	strong = undefined;
+	const seen = holder.kept;
+	console.log(`after: ${seen.kind === 'Named' ? seen.name : seen.count}`);
+}
