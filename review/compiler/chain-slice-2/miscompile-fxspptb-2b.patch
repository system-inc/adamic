+import type { Weak } from 'adamic';
+interface Box {
+	readonly label: string;
+}
+interface WeakGetter {
+	get(): Weak<Box>;
+}
+class StrongGetter {
+	readonly box: Box;
+	constructor(box: Box) {
+		this.box = box;
+	}
+	get(): Box {
