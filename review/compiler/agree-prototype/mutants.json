[
  {
    "mutant": "M20",
    "command": [
      "go",
      "test",
      "./internal/lower",
      "-run",
      "^(TestInheritedLibraryReadsNeverLoadOwnFields|TestPrototypeMethodsAreRefusedWithReasons|TestNullishPrototypeReadsAreRejectedByChecker|TestPrototypeHazardsBehindObjectViewsAreNotYet|TestUnrepresentedPrototypeCallsAreNotYet|TestIsPrototypeOfReadsExplainThePrototypeRefusal)$",
      "-count=1",
      "-timeout",
      "90s",
      "-json"
    ],
    "exit": 0
  },
  {
    "mutant": "own-refusal-reason",
    "command": [
      "go",
      "test",
      "./internal/lower",
      "-run",
      "^TestIsPrototypeOfReadsExplainThePrototypeRefusal$",
      "-count=1",
      "-timeout",
      "90s",
      "-json"
    ],
    "exit": 1
  }
]
