diff --git a/internal/lower/class_accessors.go b/internal/lower/class_accessors.go
index 153b9971..64ddef02 100644
--- a/internal/lower/class_accessors.go
+++ b/internal/lower/class_accessors.go
@@ -389,9 +389,11 @@ func (l *lowering) checkAccessorSpreads() error {
 		return nil
 	}
 	spread := false
+	staticSpread := false
 	check := func(node any) bool {
 		if literal, ok := node.(ir.ObjectLiteral); ok && literal.Spread != nil {
 			spread = true
+			staticSpread = staticSpread || !plainDataSpreadSource(literal.Spread)
 		}
