@@ -41 +83,6 @@ _Noreturn void adamic_uncaught(void) {
-	adamic_panic(text, length);
+	fputc('\n', stderr);
+	fflush(stderr);
+	adamic_release(adamic_thrown);
+	adamic_thrown = NULL;
+	adamic_exception_pending = false;
+	exit(1);
