    const results = items.map((item, index) => {
        for (let step = 0; step < 10000; step += 1) {
            item.value = (item.value * 17 + step + index) % 65521;
        }
        item.done = true;
        return item;
    });
    let digest = 0;
    for (const item of results) {
        digest = (digest * 31 + item.value) % 1000000007;
        if (!item.done) { console.log('unfinished'); }
    }
    console.log(`${results.length} moved objects, ordered digest ${digest}`);
