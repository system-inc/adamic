+func (f *closureFacts) results(targets []int) FunctionTargets {
+	result := FunctionTargets{}
+	for _, target := range targets {
+		if target < 0 || target >= len(f.returns) {
+			result.Unknown = true
+			continue
+		}
+		mergeClosureTargets(&result, f.returns[target])
+	}
+	return result
