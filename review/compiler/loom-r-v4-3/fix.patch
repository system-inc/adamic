diff --git a/internal/lower/primitive_identity.go b/internal/lower/primitive_identity.go
new file mode 100644
index 00000000..c6a9f5f5
--- /dev/null
+++ b/internal/lower/primitive_identity.go
@@ -0,0 +1,18 @@
+package lower
+
+import "github.com/microsoft/TypeScript/tsc/shim/checker"
+
+// primitiveIdentityType proves that an operand cannot be an adapter key. Any,
+// unknown, object, callable and unresolved parameter types retain normalization.
+func (l *lowering) primitiveIdentityType(proven *checker.Type) bool {
+	proven = l.concrete(proven)
+	if proven.Flags()&checker.TypeFlagsUnion != 0 {
+		for _, member := range proven.Types() {
+			if !l.primitiveIdentityType(member) {
+				return false
+			}
+		}
+		return len(proven.Types()) != 0
+	}
+	return proven.Flags()&(checker.TypeFlagsNumberLike|checker.TypeFlagsStringLike|checker.TypeFlagsBooleanLike|checker.TypeFlagsBigIntLike|checker.TypeFlagsUndefined|checker.TypeFlagsNull) != 0
+}
diff --git a/internal/lower/primitive_identity_test.go b/internal/lower/primitive_identity_test.go
new file mode 100644
index 00000000..108152e5
--- /dev/null
+++ b/internal/lower/primitive_identity_test.go
@@ -0,0 +1,40 @@
+package lower
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/system-inc/adamic/internal/load"
+)
+
+func TestPrimitiveIdentityCheckerProof(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		declaration string
+		primitive   bool
+	}{
+		{"type Target = number;", true}, {"type Target = string;", true}, {"type Target = boolean;", true}, {"type Target = bigint;", true}, {"type Target = undefined;", true}, {"type Target = null;", true},
+		{"type Target = number|string|boolean|bigint|undefined|null;", true},
+		{"type Target = number|object;", false}, {"type Target = string|(()=>void);", false},
+		{"type Target = object;", false}, {"type Target = {};", false}, {"type Target = unknown;", false}, {"type Target = any;", false},
+	} {
+		path := filepath.Join(t.TempDir(), "primitive.a")
+		if err := os.WriteFile(path, []byte(test.declaration), 0600); err != nil {
+			t.Fatal(err)
+		}
+		program, err := load.Load([]string{path})
+		if err != nil {
+			t.Fatal(err)
+		}
+		file := program.Files()[0]
+		checked, release := program.Checker(context.Background(), file)
+		l := &lowering{program: program, checker: checked}
+		got := l.primitiveIdentityType(checked.GetTypeAtLocation(file.Statements.Nodes[0].Name()))
+		release()
+		if got != test.primitive {
+			t.Fatalf("%s primitive=%t, want %t", test.declaration, got, test.primitive)
+		}
+	}
+}
