  "source_lines": [
    "-\t} else if ((kind == adamic_json_string || kind == adamic_json_map || kind == adamic_json_function || kind == adamic_json_array) && value.reference == NULL) {",
    "+\t} else if ((kind == adamic_json_string || kind == adamic_json_map || kind == adamic_json_function || kind == adamic_json_array || kind == adamic_json_record) && value.reference == NULL) {",
    "+\tcase adamic_json_record: {",
    "+\t\tconst adamic_record *record = value.reference;",
    "+\t\tadamic_array *ordered = adamic_record_keys(record);",
    "+\t\tascii(w, \"{\");",
    "+\t\tsize_t written = 0;",
    "+\t\tsize_t count = w->key_list ? w->key_count : ordered->length;",
    "+\t\tfor (size_t index = 0; index < count; index++) {",
    "+\t\t\tadamic_string *key = w->key_list ? w->keys[index] : ordered->elements[index].reference;",
    "+\t\t\tconst adamic_value *slot = adamic_record_get_own(record, key);",
    "+\t\t\tif (slot == NULL) { continue; }",
    "+\t\t\tjson_scalar item = scalar(*slot, schema->element->kind);",
    "+\t\t\tif (item.kind == adamic_json_undefined || item.kind == adamic_json_function) { continue; }",
    "+\t\t\tif (written++ != 0) { ascii(w, \",\"); }",
    "+\t\t\tindent(w, depth + 1); quote(w, key); ascii(w, w->pretty ? \": \" : \":\");",
    "+\t\t\t(void)write_value(w, *slot, schema->element, depth + 1);",
    "+\t\t}",
    "+\t\tif (written != 0) { indent(w, depth); }",
    "+\t\tascii(w, \"}\"); adamic_release(ordered); return true;",
    "+\t}",
    "-\tadamic_json_tuple, adamic_json_object",
    "+\tadamic_json_tuple, adamic_json_object, adamic_json_record"
  ],
