// Census reason: an index signature
export interface MapLike<T> {
    [index: string]: T;
}
const hasOwnProperty = Object.prototype.hasOwnProperty;
export function hasProperty(map: MapLike<any>, key: string): boolean {
    return hasOwnProperty.call(map, key);
}

// Driver.
const map: MapLike<string> = { paths: "src" };
for (const key of ["paths", "missing", "toString", "constructor", "__proto__"]) console.log(`${key} ${hasProperty(map, key)}`);
