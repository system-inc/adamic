// From TypeScript 6.0.3, src/compiler/core.ts:1464
// Census reason: an index signature
export function groupBy<T, K extends string | number | boolean | null | undefined>(values: readonly T[] | undefined, keySelector: (value: T) => K): { [P in K as `${P}`]?: T[]; } { // eslint-disable-line no-restricted-syntax
    const result: Record<string, T[]> = {};
    if (values !== undefined) {
        for (let i = 0; i < values.length; i++) {
            const value = values[i];
            const key = `${keySelector(value)}`;
            const array = result[key] ??= [];
            array.push(value);
        }
    }
    return result as { [P in K as `${P}`]?: T[]; };
}


// Driver.
const groups = groupBy(["src", "test", "source"], value => value.slice(0, 1));
for (const key of Object.keys(groups)) console.log(`${key} ${groups[key]?.join(",")}`);
