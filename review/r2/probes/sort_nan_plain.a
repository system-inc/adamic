// The same comparator, on number[] with no undefined: a NaN result.
const nan = 0 / 0;
const plain: number[] = [5, nan, 1, 3, -0];
plain.sort((left, right) => left - right);
console.log(`plain [${plain.join(',')}]`);
const maybe: (number | undefined)[] = [5, nan, 1, 3, -0];
maybe.sort((left, right) => (left ?? 0) - (right ?? 0));
console.log(`maybe, no undefined [${maybe.join(',')}]`);
const withUndefined: (number | undefined)[] = [5, undefined, nan, 1, 3, -0];
withUndefined.sort((left, right) => (left ?? 0) - (right ?? 0));
console.log(`maybe, one undefined [${withUndefined.join(',')}]`);
const consistent: (number | undefined)[] = [5, undefined, 2, 1, undefined, 3, 2];
consistent.sort((left, right) => (left ?? 0) - (right ?? 0));
console.log(`consistent [${consistent.join(',')}]`);
