// A constructor calling a method declared below it, which reads a field the constructor hasn't set
// yet: on Node the field is undefined there, and reading its length throws.
class Label {
	readonly size: number;
	readonly text: string;

	constructor(text: string) {
		this.size = this.measure();
		this.text = text;
	}

	measure(): number {
		return this.text.length;
	}
}
console.log(`${new Label(['a', 'b'].join('')).size}`);
