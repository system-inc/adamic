// A narrowing a call undoes, then reads that may see undefined in JavaScript without throwing: typeof,
// ??, ?., and passing it on where undefined is allowed. Each must answer as Node does.
interface Link {
	readonly value: number;
}
let chain: Link | undefined = { value: 1 };
function drop(): void {
	chain = undefined;
}
function describe(link: Link | undefined): string {
	return link === undefined ? 'none' : `${link.value}`;
}
if (chain !== undefined) {
	drop();
	console.log(`typeof ${typeof chain}`);
}
chain = { value: 2 };
if (chain !== undefined) {
	drop();
	console.log(`passed ${describe(chain)}`);
}
chain = { value: 3 };
if (chain !== undefined) {
	drop();
	const kept: (Link | undefined)[] = [chain];
	console.log(`kept ${kept.length} ${kept[0] === undefined}`);
}
