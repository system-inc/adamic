// TypeScript 6.0.3 corePublic.ts:17-19 and core.ts:1039, same sorted body.
interface SortedReadonlyArray<T> extends ReadonlyArray<T> {
    " __sortedArrayBrand": undefined;
}
function sorted<T>(array: readonly T[]): SortedReadonlyArray<T> {
    return array.slice() as readonly T[] as SortedReadonlyArray<T>;
}
function observe(a: SortedReadonlyArray<number> | readonly number[]): string {
    if (" __sortedArrayBrand" in a) {
        const narrowed: SortedReadonlyArray<number> = a;
        return `present ${narrowed.length}`;
    }
    return 'absent';
}
console.log(observe(sorted([1, 2])));
