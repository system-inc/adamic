import type { Weak } from 'adamic';
// A target and the object holding its only weak handle die together, in both orders, and a target
// holding a weak handle to itself.
interface Box {
	readonly label: string;
	self: Weak<Box>;
}
interface Pair {
	readonly first: Box;
	readonly second: Holder;
}
interface Holder {
	kept: Weak<Box>;
}
function run(n: number): number {
	const box: Box = { label: `b${n}`, self: undefined };
	box.self = box;
	const p: Pair = { first: box, second: { kept: box } };
	const q: Holder = { kept: p.first };
	const r: Pair = { first: { label: `c${n}`, self: undefined }, second: q };
	const x = p.second.kept;
	const y = r.second.kept;
	const z = box.self;
	return (x === undefined ? 0 : x.label.length) + (y === undefined ? 0 : y.label.length) + (z === undefined ? 0 : z.label.length);
}
console.log(`${run(1)} ${run(22)}`);
