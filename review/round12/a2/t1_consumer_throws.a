// The consumer throws after reading the region's values, which hold heap strings.
interface Node {
	readonly label: string;
	readonly left: Node | undefined;
	readonly right: Node | undefined;
}

function build(depth: number): Node {
	if (depth === 0) {
		return { label: `leaf${depth}`, left: undefined, right: undefined };
	}
	return { label: `node${depth}`, left: build(depth - 1), right: build(depth - 1) };
}

function count(node: Node | undefined, limit: number): number {
	if (node === undefined) {
		return 0;
	}
	if (limit === 0) {
		throw new Error(`limit at ${node.label.length}`);
	}
	return 1 + count(node.left, limit - 1) + count(node.right, limit - 1);
}

function inner(depth: number, limit: number): number {
	let total = 0;
	total += count(build(depth), limit);
	return total;
}

let total = 0;
for (let round = 0; round < 6; round++) {
	try {
		total += count(build(3), round);
		console.log(`round ${round} total ${total}`);
	} catch (error) {
		if (error instanceof Error) {
			console.log(`round ${round} caught ${error.message}`);
		}
	}
}
for (let round = 0; round < 6; round++) {
	try {
		console.log(`inner ${inner(3, round)}`);
	} catch (error) {
		if (error instanceof Error) {
			console.log(`inner ${round} caught ${error.message}`);
		}
	} finally {
		console.log(`finally ${round}`);
	}
}
console.log(`total ${total}`);
