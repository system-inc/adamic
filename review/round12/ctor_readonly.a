class Node {
  readonly kids: Node[] = [];
  readonly parent: Node | undefined;
  readonly name: string;
  constructor(name: string, parent: Node | undefined) {
    this.name = name;
    if (parent !== undefined) {
      parent.kids.push(this);
    }
    this.parent = parent;
  }
}

function build(round: number): number {
  const root = new Node(`root${round}`, undefined);
  const child = new Node(`child${round}`, root);
  const up = child.parent;
  return root.kids.length + (up === undefined ? 0 : up.kids.length);
}

let total = 0;
for (let round = 0; round < 3; round++) {
  total += build(round);
}
console.log(`total ${total}`);
