interface Animal {
	name: string;
}
interface Dog extends Animal {
	bark: string;
}
interface Cat extends Animal {
	lives: number;
}
function makeDog(index: number): Dog {
	return { name: `dog${index}`, bark: 'wo'.repeat(index + 1) };
}
function makeCat(index: number): Cat {
	return { name: `cat${index}`, lives: index };
}
const dogs: Dog[] = [makeDog(1)];
const cat = makeCat(2);
function report(list: Dog[]): void {
	for (const dog of list) {
		console.log(`${dog.name} says ${dog.bark.toUpperCase()}`);
	}
}
const dogMap = new Map<string, Dog>();
dogMap.set('a', makeDog(1));
function total(map: ReadonlyMap<string, Animal>): number {
	return map.size;
}
console.log(`${total(dogMap)}`);
const lists = new Map<string, Dog[]>();
lists.set('k', dogs);
const readonlyLists: ReadonlyMap<string, readonly Animal[]> = lists;
console.log(`${readonlyLists.size}`);
