interface Animal {
	name: string;
}
interface Dog extends Animal {
	bark: string;
}
interface Cat extends Animal {
	lives: number;
}
function makeDog(index: number): Dog {
	return { name: `dog${index}`, bark: 'wo'.repeat(index + 1) };
}
function makeCat(index: number): Cat {
	return { name: `cat${index}`, lives: index };
}
const dogs: Dog[] = [makeDog(1)];
const cat = makeCat(2);
function report(list: Dog[]): void {
	for (const dog of list) {
		console.log(`${dog.name} says ${dog.bark.toUpperCase()}`);
	}
}
const pairs: [string, Dog][] = dogs.map((dog): [string, Dog] => [dog.name, dog]);
const map = new Map<string, Dog>(pairs);
console.log(`${map.size}`);
const sorted = [...dogs].sort((left, right) => left.name.localeCompare(right.name));
report(sorted);
const filtered: Dog[] = dogs.filter((dog) => dog.bark.length > 0);
report(filtered);
