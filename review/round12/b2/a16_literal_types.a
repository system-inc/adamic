interface Animal {
	name: string;
}
interface Dog extends Animal {
	bark: string;
}
interface Cat extends Animal {
	lives: number;
}
function makeDog(index: number): Dog {
	return { name: `dog${index}`, bark: 'wo'.repeat(index + 1) };
}
function makeCat(index: number): Cat {
	return { name: `cat${index}`, lives: index };
}
const dogs: Dog[] = [makeDog(1)];
const cat = makeCat(2);
function report(list: Dog[]): void {
	for (const dog of list) {
		console.log(`${dog.name} says ${dog.bark.toUpperCase()}`);
	}
}
type Shape = { kind: 'circle'; radius: number } | { kind: 'square'; side: number };
const shapes: Shape[] = [];
const circle = { kind: 'circle' as const, radius: dogs.length };
shapes.push(circle);
const shape: Shape = circle;
const stored: { shape: Shape } = { shape: circle };
console.log(`${shapes.length} ${shape.kind} ${stored.shape.kind}`);
