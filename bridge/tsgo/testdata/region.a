import { panic, programArguments, tsgoProgram, tsgoQuery, tsgoRelease, type TSGoResult, type TSGoQuery } from 'adamic';

// Both the result wrapper and its payload live in the statement's region.
function measure(answer: TSGoResult<TSGoQuery>): number {
    if (answer.kind === 'Error') return -1;
    return answer.value.symbolName.length + answer.value.type.length;
}
function run(): void {
    const argumentsGiven = programArguments();
    const config = argumentsGiven[0] ?? panic('missing config');
    const file = argumentsGiven[1] ?? panic('missing file');
    const opened = tsgoProgram(config, [file]);
    if (opened.kind === 'Error') { console.error(opened.message); return; }
    console.log(`${measure(tsgoQuery(opened.value, file, 14))}`);
    const released = tsgoRelease(opened.value);
    if (released.kind === 'Error') console.error(released.message);
}
run();
