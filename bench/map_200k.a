// Build 200,000 distinct runtime string keys, look each up, then fold insertion order.
const entries = new Map<string, number>();
for(let index = 0; index < 200000; index++) {
    entries.set(`key-${index}`, index * 3 + 1);
}
let lookups = 0;
for(let index = 199999; index >= 0; index--) {
    lookups += entries.get(`key-${index}`) ?? -1;
}
let checksum = 0;
for(const [key, value] of entries) {
    checksum = (checksum * 33 + key.length + value) % 2147483647;
}
console.log(`${entries.size} ${lookups} ${checksum}`);
