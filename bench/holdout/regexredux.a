//
// Source: regexredux/regexredux.node-3.node from public/download/benchmarksgame-sourcecode.zip
// (blob 05648fc9a0d6) at benchmarksgame commit 40296663ed350d5fe4a6ab5e367bab61cb77c219 (March 7, 2025).
// The game has no regexredux.node or .node-1; .node-3 is its lowest-numbered Node.js entry.
//
// Ported to Adamic for the speed holdout (#re2xhwa). The patterns, the replacements and the output are
// the original's. Each change is one the language makes, and a comment marked "Adamic:" says which.
//
// Input: the game pipes in fasta's output for n = 5,000,000, the game's size. This port reads no
// stdin: fastaLines (fasta_input.a, fasta.node's own generator) makes the same lines, and each is
// joined with the newline fasta wrote after it, which is the text the original reads.
//
// Adamic: the worker thread goes. The original runs workerThread's replacements on a second thread
// while the main thread counts the matches, then waits for its length. Here the main thread counts
// first and then calls workerThread itself, which is the order the output was printed in. With the
// worker go `require('worker_threads')`, the `isMainThread` split, the Promise and `async`/`await`.
// `require('fs')` goes with stdin.
import { panic } from 'adamic';
import { fastaLines } from './fasta_input.a';

mainThread();

function mainThread(): void {
	const regExps = [
		/agggtaaa|tttaccct/ig,
		/[cgt]gggtaaa|tttaccc[acg]/ig,
		/a[act]ggtaaa|tttacc[agt]t/ig,
		/ag[act]gtaaa|tttac[agt]ct/ig,
		/agg[act]taaa|ttta[agt]cct/ig,
		/aggg[acg]aaa|ttt[cgt]ccct/ig,
		/agggt[cgt]aa|tt[acg]accct/ig,
		/agggta[cgt]a|t[acg]taccct/ig,
		/agggtaa[cgt]|[acg]ttaccct/ig,
	];

	// Adamic: `fs.readFileSync('/dev/stdin', 'ascii')` becomes fasta's lines, generated here. fasta
	// writes only ASCII, so reading it as ASCII changes nothing.
	const input: string[] = [];
	fastaLines(5000000, (line) => {
		input.push(line + '\n');
	});
	let data = input.join('');
	const initialLen = data.length;

	data = data.replace(/^>.*\n|\n/mg, '');
	const cleanedLen = data.length;

	for (let j = 0; j < regExps.length; j++) {
		// Adamic: an element read is `RegExp | undefined` under noUncheckedIndexedAccess; j is below
		// the length, so the check never fires.
		const re = regExps[j] ?? panic('regex-redux: no pattern at j');
		const m = data.match(re);
		// Adamic: console.log takes exactly one string, so the two values Node's console.log joined
		// with a space are joined here. No source holds a %, so util.format printed exactly this.
		console.log(`${re.source} ${m ? m.length : 0}`);
	}

	const endLen = workerThread(data);

	console.log(`\n${initialLen}\n${cleanedLen}\n${endLen}`);
}

// Adamic: the worker posted the length back in a message; here it's returned.
function workerThread(str: string): number {
	const len = str
		.replace(/tHa[Nt]/g, '<4>')
		.replace(/aND|caN|Ha[DS]|WaS/g, '<3>')
		.replace(/a[NSt]|BY/g, '<2>')
		.replace(/<[^>]*>/g, '|')
		.replace(/\|[^|][^|]*\|/g, '-').length;
	return len;
}
