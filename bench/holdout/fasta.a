//
// Source: fasta/fasta.node, the game's first Node.js fasta entry, from public/download/benchmarksgame-sourcecode.zip
// (blob 05648fc9a0d6) at benchmarksgame commit 40296663ed350d5fe4a6ab5e367bab61cb77c219 (March 7, 2025).
//
// Ported to Adamic for the speed holdout (#re2xhwa). The algorithm, the data and the output are the
// original's. Each change is one the language makes, and a comment marked "Adamic:" says which.
// Input size: n = 25,000,000, the game's, unless a first argument names another. fasta is also the
// generator of the input k-nucleotide, regex-redux and reverse-complement read (inputs.json).
import { panic, programArguments } from 'adamic';

// Adamic: `var` becomes `let` or `const` throughout, since 0.1 has no `var`.
let last = 42;
const A = 3877,
	C = 29573,
	M = 139968;

function rand(max: number): number {
	last = (last * A + C) % M;
	return (max * last) / M;
}

const ALU =
	'GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG' +
	'GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA' +
	'CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT' +
	'ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA' +
	'GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG' +
	'AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC' +
	'AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA';

// Adamic: the two tables are read and written by a run-time key, so they get the type that says so.
const IUB: Record<string, number> = {
	a: 0.27,
	c: 0.12,
	g: 0.12,
	t: 0.27,
	B: 0.02,
	D: 0.02,
	H: 0.02,
	K: 0.02,
	M: 0.02,
	N: 0.02,
	R: 0.02,
	S: 0.02,
	V: 0.02,
	W: 0.02,
	Y: 0.02,
};

const HomoSap: Record<string, number> = {
	a: 0.3029549426680,
	c: 0.1979883004921,
	g: 0.1975473066391,
	t: 0.3015094502008,
};

function makeCumulative(table: Record<string, number>): void {
	let last: string | null = null;
	for (const c in table) {
		// Adamic: a record read is `number | undefined`, and `+=` on one is refused, so the sum is
		// written out with each read checked. Both keys come from this for-in, so neither check fires.
		if (last) table[c] = (table[c] ?? panic('makeCumulative: no entry')) + (table[last] ?? panic('makeCumulative: no entry'));
		last = c;
	}
}

function fastaRepeat(n: number, seq: string): void {
	let seqi = 0,
		lenOut = 60;
	while (n > 0) {
		if (n < lenOut) lenOut = n;
		if (seqi + lenOut < seq.length) {
			console.log(seq.substring(seqi, seqi + lenOut));
			seqi += lenOut;
		} else {
			const s = seq.substring(seqi);
			seqi = lenOut - s.length;
			console.log(s + seq.substring(0, seqi));
		}
		n -= lenOut;
	}
}

function fastaRandom(n: number, table: Record<string, number>): void {
	// Adamic: `new Array(60)` is an array of holes, which 0.1 doesn't have. Every slot is written
	// before the line is joined, so starting each one as '' prints the same line.
	let line = new Array<string>(60).fill('');
	makeCumulative(table);
	while (n > 0) {
		if (n < line.length) line = new Array<string>(n).fill('');
		for (let i = 0; i < line.length; i++) {
			const r = rand(1);
			for (const c in table) {
				// Adamic: the record read is checked; c comes from this for-in, so it never fires.
				if (r < (table[c] ?? panic('fastaRandom: no entry'))) {
					line[i] = c;
					break;
				}
			}
		}
		console.log(line.join(''));
		n -= line.length;
	}
}

// Adamic: with no argument the size is the game's, fixed here, so fasta's own timed run has no input
// at all. With one, it's read as a decimal integer, where the original reads `+process.argv[2]`: the comparison tool runs fasta
// that way to make the input of the programs that read fasta's output, at the sizes inputs.json names.
const sizeArgument = programArguments()[0];
const n = sizeArgument === undefined ? 25000000 : Number.parseInt(sizeArgument, 10);

console.log('>ONE Homo sapiens alu');
fastaRepeat(2 * n, ALU);

console.log('>TWO IUB ambiguity codes');
fastaRandom(3 * n, IUB);

console.log('>THREE Homo sapiens frequency');
fastaRandom(5 * n, HomoSap);
