//
// Source: knucleotide/knucleotide.node, the game's first Node.js k-nucleotide entry, from
// public/download/benchmarksgame-sourcecode.zip (blob 05648fc9a0d6) at benchmarksgame commit
// 40296663ed350d5fe4a6ab5e367bab61cb77c219 (March 7, 2025).
//
// Ported to Adamic for the speed holdout (#re2xhwa). The counting, the sorting, the reading of the
// third sequence in 2,048-character pieces and the output are the original's. Each change is one the
// language makes, and a comment marked "Adamic:" says which.
//
// Input: the game pipes in fasta's output for n = 25,000,000, the game's size, on stdin. Adamic has no
// stdin yet, so this port reads the same bytes from a file named by its first argument, and hands
// each line to the line handler where readline did (see master).
'use strict';

// Adamic: `require('readline')` and `require('cluster')` go. Readline's place is taken by the input
// file, read whole and cut into lines, and the cluster's by one worker in this process (see master).
// `process` comes from node:process.
import process from 'node:process';
import { panic, programArguments, readTextFile } from 'adamic';

const missing = 'k-nucleotide: a key the map was built from is missing';

// Adamic: the constructor function and its prototype method become a class with the same field and
// the same toString.
class RefNum {
	num: number;
	constructor(num: number) {
		this.num = num;
	}
	toString(): string {
		return this.num.toString();
	}
}

function frequency(seq: string, length: number): Map<string, RefNum> {
	// Adamic: `var` becomes `const` or `let`, and the untyped declarations get their type.
	const freq = new Map<string, RefNum>(),
		n = seq.length - length + 1;
	let key: string,
		cur: RefNum | undefined,
		i = 0;
	for (; i < n; ++i) {
		key = seq.substr(i, length);
		cur = freq.get(key);
		cur === undefined ? freq.set(key, new RefNum(1)) : ++cur.num;
	}
	return freq;
}

function sort(seq: string, length: number): string {
	const f = frequency(seq, length),
		keys = Array.from(f.keys()),
		n = seq.length - length + 1;
	let res = '';
	// Adamic: the original subtracts and multiplies RefNums, which JavaScript turns into numbers by way
	// of their toString. Arithmetic on an object is refused, so each reads its num, the same integer.
	// Every key read is one the map was built from, so the check never fires.
	keys.sort((a, b) => (f.get(b) ?? panic(missing)).num - (f.get(a) ?? panic(missing)).num);
	for (const key of keys) res += key + ' ' + (((f.get(key) ?? panic(missing)).num * 100) / n).toFixed(3) + '\n';
	res += '\n';
	return res;
}

function find(seq: string, s: string): string {
	const f = frequency(seq, s.length);
	// Adamic: `+` turns the RefNum or the 0 into a string by way of its toString in JavaScript. A `+`
	// with an object or a number beside a string is refused, so toString is called by name.
	return (f.get(s) || 0).toString() + '\t' + s + '\n';
}

// Adamic: the original forks four cluster workers with workerId 0 to 3, sends each the whole third
// sequence in pieces, and gives each a share of the counting, chosen by its workerId. Workers go, so
// one worker in this process takes the pieces once and computes the four shares in workerId order,
// handing each worker's result to the master's handler for it, as each worker's process.send did.
const workerIds = ['0', '1', '2', '3'];

function master(): void {
	let reading = false,
		seq = '';
	const maxBuf = 2048;

	const send = worker((i, message) => messageHandler(i)(message));

	const flush = function (close?: boolean): void {
		send(seq);
		if (close) send('eof');
		seq = '';
	};
	const lineHandler = function (line: string): void {
		if (reading) {
			if (line[0] !== '>' && (seq += line.toUpperCase()).length >= maxBuf) flush();
		} else reading = line.substr(0, 6) === '>THREE';
	};
	// Adamic: `results` starts as one '' per worker, since writing past an array's end is refused and the
	// original's `[]` grows as results arrive. Every slot is written before the join.
	let jobs = workerIds.length;
	const results = new Array<string>(workerIds.length).fill('');
	const messageHandler = function (i: number): (message: string) => void {
		return function (message: string): void {
			results[i] = message;
			if (!--jobs) {
				process.stdout.write(results.join(''));
				process.exit(0);
			}
		};
	};

	// Adamic: stdin becomes a file named by the first argument, because Adamic has no stdin yet. The
	// file is fasta's output, the bytes the game pipes in, and it's cut into lines as readline cut stdin:
	// at each newline, the newline dropped, and a last line without one handed over only if it isn't
	// empty. fasta writes only `\n`, so readline's `\r` and `\r\n` never arise. The close handler runs
	// after the last line, as on stdin's end. Readline reads only once master has returned, after the
	// handlers above are set; reading in order, the reading comes last here for the same reason. A
	// missing argument or a file that can't be read panics with why, to stderr, exit 70.
	const input = readTextFile(programArguments()[0] ?? panic('k-nucleotide: the input file must be the first argument'));
	if (input.kind === 'Error') panic(input.message);
	let lineStart = 0;
	while (lineStart < input.text.length) {
		let lineEnd = input.text.indexOf('\n', lineStart);
		if (lineEnd < 0) lineEnd = input.text.length;
		lineHandler(input.text.slice(lineStart, lineEnd));
		lineStart = lineEnd + 1;
	}
	flush(true);
}

function worker(processSend: (i: number, message: string) => void): (message: string) => void {
	let seq = '';
	return function (message: string): void {
		if (message === 'eof') {
			for (let i = 0; i < workerIds.length; ++i) {
				let res = '';
				switch (workerIds[i]) {
					case '0':
						res += sort(seq, 1);
						res += sort(seq, 2);
						res += find(seq, 'GGT');
						break;
					case '1':
						res += find(seq, 'GGTA');
						res += find(seq, 'GGTATT');
						break;
					case '2':
						res += find(seq, 'GGTATTTTAATT');
						break;
					case '3':
						res += find(seq, 'GGTATTTTAATTTATAGT');
						break;
				}
				processSend(i, res);
			}
			// Adamic: each worker's process.exit() goes with the workers; the master's ends the program.
		} else seq += message;
	};
}

// Adamic: `cluster.isMaster ? master() : worker()`: with no cluster, this is the master.
master();
