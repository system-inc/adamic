// a-check: checked
// tsc-shaped input; source evidence: binder.ts:853
interface Token {kind: number; pos: number;}
function run(iterations: number): number {
 const source: Token[]=[];
 for(let i=0;i<256;i++) source.push({kind:i%4===0 ? 80 : 28,pos:i});
 let total=0;
 for(let n=0;n<iterations;n++) {
  const result: Token[]=[];
  for(const token of source) result.push(token);
  total+=result.length+(result[255]?.pos ?? 0);
 }
 return total;
}
console.log(`${run(8)}`);
