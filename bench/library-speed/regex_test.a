// a-check: checked
// tsc-shaped input; source evidence: path.ts:882,734,744,902
function run(iterations: number): number {
 const pattern=/\/\/|(?:^|\/)\.\.?(?:$|\/)/;
 const paths=["src/compiler/checker.ts","src/../compiler/checker.ts","./src/compiler.ts","src//compiler.ts","src/.hidden.ts"];
 let total=0;
 for(let n=0;n<iterations;n++) for(let i=0;i<256;i++) total+=pattern.test(paths[i%5] ?? "") ? 1 : 0;
 return total;
}
console.log(`${run(8)}`);
