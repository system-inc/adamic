// a-check: checked
// tsc-shaped input; source evidence: checker.ts:5576; scanner.ts:441
function run(iterations: number): number {
 let text=""; for(let i=0;i<256;i++) text+="x\u00e9\u03bb\ud83d\ude00\ud800z";
 let total=0;
 for(let n=0;n<iterations;n++) for(let i=0;i<text.length;i++) total+=text.charCodeAt(i);
 return total;
}
console.log(`${run(8)}`);
