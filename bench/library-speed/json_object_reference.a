// a-check: checked
// Expected lowering NotYet: referenced objects do not have complete JSON value metadata.
// tsc-shaped input; source evidence: builder.ts:1130,1145; emitter.ts:1138
interface FileInfo {version: string; signature: string; affectsGlobalScope: boolean;}
function run(iterations: number): number {
 const fileNames: string[]=[]; const fileInfos: FileInfo[]=[]; const root: number[]=[];
 for(let i=0;i<256;i++) {
  fileNames.push(`./src/compiler/file${i}.ts`);
  fileInfos.push({version:"0123456789abcdef",signature:"abcdef0123456789",affectsGlobalScope:i%8===0});
  root.push(i+1);
 }
 const buildInfo={fileNames,fileInfos,root,options:{target:7,strict:true},version:"6.0.3"};
 let total=0;
 for(let n=0;n<iterations;n++) {
  const text=JSON.stringify(buildInfo) ?? "";
  total+=text.length+text.charCodeAt(0)+text.charCodeAt(text.length-1);
 }
 return total;
}
console.log(`${run(8)}`);
