{
    "extends": [
        "cohere:typescript"
    ],
    "ignorePatterns": [
        "**/testdata/**",
        "**/fixtures/**",
        "**/corpus/**",
        "**/evidence/**",
        "**/proof/**",
        "stage1/**/gaps/**",
        "review/**",
        "stage3/meter/runs/**",
        "verify/catalog/**/*.{json,jsonl}",
        "cloud/reports/**/*.{json,jsonl}",
        "docs/verification/**/*.{json,jsonl}",
        "stage3/lane/shards.json",
        "stage3/lane/shard-plan.json",
        "stage3/patch-set.md",
        "internal/load/node_types/node_modules/**",
        "stage1/cohere/tsprinter/results/**",
        "stage1/cohere/lint/validation/**",
        "stage1/cohere/lint/performance/**",
        "stage1/cohere/css/performance/**",
        "stage1/cohere/typeaware/validation-volume*/**",
        "stage1/cohere/markdownblocks/mutant_evidence/**",
        "stage1/cohere/markdownblocks/fixture_speed_evidence/**",
        "stage1/cohere/lint/inventory/inventory.json",
        "stage1/cohere/lint/.generated/**",
        "stage1/cohere/lint/rules/*/rule.json",
        "stage1/cohere/lint/rules/*/mutant.json",
        "stage1/**/*.md",
        "bench/regex/*.json",
        "bench/wasm/results/**",
        "bench/wasm/README.md",
        "bench/workers/REPORT.md",
        "cloud/method-values-*.json",
        "cmd/adamic-gate/timings.json",
        "docs/library-*/*.json",
        "docs/non-null-readiness-*.json",
        "docs/optional-widening/*.json",
        "docs/per-backend-stops-fixtures.json",
        "docs/regex-cycle-proof.md",
        "docs/stage1-progress/**",
        "docs/tsc-generated-c.md",
        "docs/tsc-strictness/*.json",
        "docs/utf16-views/*.json",
        "docs/views-v2-evidence/**",
        "docs/nested-functions.md",
        "internal/lower/*mutants.md",
        "internal/lower/representation_clock_source_evidence/**",
        "internal/native/CLANG_UNITS.md",
        "internal/native/clang_units_evidence/**",
        "internal/native/normalize_long_report.md",
        "internal/native/performance/**/*.md",
        "internal/native/runtime/wasi-agreement/*.{json,md}",
        "internal/oracle/node_fs_file_host_status.json",
        "notes/**/*.{json,md}"
    ],
    "overrides": [
        {
            "files": [
                "internal/load/prelude.d.ts"
            ],
            "rules": {
                "@typescript-eslint/method-signature-style": "off",
                "@typescript-eslint/no-redeclare": "off",
                "nexus/consistency-require-type-suffix": "off",
                "@typescript-eslint/no-unnecessary-type-parameters": "off",
                "@typescript-eslint/prefer-function-type": "off"
            },
            "reason": "A declaration file the checker reads as lib: its members' syntax is part of what programs admit, it mirrors lib.d.ts's conventions, and most of it merges into lib's own global interfaces, so a member keeps lib's declaration form (Lower, with Language)."
        },
        {
            "files": [
                "internal/load/prelude.d.ts"
            ],
            "rules": {
                "adamic/no-type-predicate": "off"
            },
            "reason": "isArray's predicate is axiom C1 in docs/axioms/library-any.md, audited to narrow to a readonly view of an array and never to its elements, on both backends. A trusted predicate in the trusted surface is the axiom audit's to hold (Language)."
        },
        {
            "files": [
                "bench/nbody.ts",
                "bench/spectral_norm.ts"
            ],
            "rules": {
                "nexus/correctness-no-caller-data-mutation": "off"
            },
            "reason": "Benchmark programs: updating the bodies and the vectors in place is the workload timed against Node and Bun, and internal/native's loop-borrow tests compile nbody.ts to check exactly those loops."
        },
        {
            "files": [
                "bench/devirtualize.a"
            ],
            "rules": {
                "max-classes-per-file": "off"
            },
            "reason": "A benchmark of method dispatch in a hot loop: it needs its visitor classes side by side in one program, the same source run three ways."
        }
    ]
}
