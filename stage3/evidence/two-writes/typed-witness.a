import type { Node, NodeFactory, NodeFlags, SourceFile, SyntaxKind } from "__TSC_PUBLIC__";
declare const runtime: {
    factory: NodeFactory;
    NodeFlags: typeof NodeFlags;
    SyntaxKind: typeof SyntaxKind;
    setNodeFlags<T extends Node>(node: T, flags: NodeFlags): T;
    getSynthesizedDeepCloneWithReplacements<T extends Node>(node: T, trivia: boolean, replace: (node: Node) => Node | undefined): T;
};
const flagged = Object.assign(runtime.factory.createIdentifier("x"), { flags: runtime.NodeFlags.Synthesized as NodeFlags.Synthesized });
const changed = runtime.setNodeFlags(flagged, runtime.NodeFlags.None);
const promisedFlag: NodeFlags.Synthesized = changed.flags;
const binary = runtime.factory.createBinaryExpression(runtime.factory.createIdentifier("x"), runtime.SyntaxKind.PlusToken, runtime.factory.createIdentifier("y"));
const parent = runtime.factory.createSourceFile([], runtime.factory.createToken(runtime.SyntaxKind.EndOfFileToken), runtime.NodeFlags.None);
const parented = Object.assign(binary, { parent });
const clone = runtime.getSynthesizedDeepCloneWithReplacements(parented, true, () => undefined);
const promisedParent: SourceFile = clone.parent;
