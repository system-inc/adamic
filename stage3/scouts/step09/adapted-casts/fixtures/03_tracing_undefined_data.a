// a-check: refused a function taking ArrayBufferView<ArrayBufferLike> seen as one taking string | undefined (tsc relates a method's parameters both ways), so it can be handed what it can't take; write the method as a property holding a function (handle: (animal: Animal) => void), which tsc checks one way, or take the wider type in the method (method-signature-style); use a proven upcast, cast a discriminated object union with unique literal or enum tags to members or a sub-union, or downcast along nominal class ancestry (adamic/no-unchecked-cast)
// From TypeScript 6.0.3, adapted src/compiler/tracing.ts:338
// Adaptation: 62-temporary-tracing-write; reduced host boundary witness.
import * as fs from "node:fs";
const typesFd = 1;
for (const descriptor of [{ id: 1 }, undefined]) {
    try {
        (fs as { writeSync(fd: number, data: string | undefined): number }).writeSync(typesFd, JSON.stringify(descriptor));
        console.log("accepted");
    }
    catch (error) {
        console.log(error instanceof TypeError ? "TypeError" : "other error");
    }
}
