function isString(value: unknown): boolean { return typeof value === "string"; }
function isNullOrUndefined(value: unknown): boolean { return value === null || value === undefined; }
function isCompilerOptionsValue(option: CommandLineOption | undefined, value: any): value is CompilerOptionsValue {
    if (option) {
