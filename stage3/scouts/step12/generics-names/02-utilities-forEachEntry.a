export function forEachEntry<K, V, U>(map: ReadonlyMap<K, V>, callback: (value: V, key: K) => U | undefined): U | undefined {
    const iterator = map.entries();
    for (const [key, value] of iterator) {
        const result = callback(value, key);
        if (result) {
            return result;
        }
    }
    return undefined;
}

console.log(forEachEntry(new Map<string, number>([["x", 1], ["y", 2]]), (value, key) => value === 2 ? key : undefined) ?? "missing");
console.log(forEachEntry(new Map<string, number>(), (value, key) => key) ?? "missing");
