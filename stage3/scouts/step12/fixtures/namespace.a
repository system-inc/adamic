// a-check: refused a namespace; use a module: a file of its own, with named exports
// From TypeScript 6.0.3 src/compiler/debug.ts:113,223
// Reduced witness; retained expressions, scaffolding and driver are explicit.
export namespace Debug {
    export function assertEqual<T>(a: T, b: T): void {
        if (a !== b) { throw new Error(`Expected ${a} === ${b}.`); }
    }
}
Debug.assertEqual(1, 1);
console.log("ok");
