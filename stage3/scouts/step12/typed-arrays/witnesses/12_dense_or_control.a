const segments = new Uint16Array(2);
const segment = 0;
const shiftedDigit = 7 << 15;
segments[segment] = (segments[segment] ?? 0) | shiftedDigit;
const residual = shiftedDigit >>> 16;
if (residual !== 0) segments[segment + 1] = (segments[segment + 1] ?? 0) | residual;
console.log(`${segments[0]}`); console.log(`${segments[1]}`);
