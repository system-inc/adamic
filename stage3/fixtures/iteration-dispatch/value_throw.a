interface Step {value: string; done: boolean;}
class Result {
 get done(): boolean {return false;}
 get value(): string {throw new Error('value getter');}
}
const source = {[Symbol.iterator]() {return {next(): Result {return new Result();}, return(): Step {console.log('must not close'); return {value: 'complete',done:true};}};}};
try {for(const value of source) {console.log(value);break;}} catch(error) {console.log(error instanceof Error ? error.message : 'unexpected');}
