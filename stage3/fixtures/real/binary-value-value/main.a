interface OptionsNameMap { readonly size: number; }
let watchOptionsNameMapCache: OptionsNameMap;
const optionsForWatch: readonly string[] = ['a','b'];
let creations = 0;
function createOptionNameMap(options: readonly string[]): OptionsNameMap { creations += 1; return {size:options.length}; }
function getWatchOptionsNameMap(): OptionsNameMap {
    return watchOptionsNameMapCache || (watchOptionsNameMapCache = createOptionNameMap(optionsForWatch));
