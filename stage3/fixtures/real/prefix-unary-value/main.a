// a-check: checked
// From src/compiler/utilities.ts:997 (TypeScript 6.0.3, main adaptations).

interface SourceFile { readonly scriptKind: number; readonly checkJsDirective: { readonly enabled: boolean } | undefined; }
const ScriptKind = { JS:1, JSX:2 } as const;
export function isPlainJsFile(file: SourceFile | undefined, checkJs: boolean | undefined): boolean {
    return !!file && (file.scriptKind === ScriptKind.JS || file.scriptKind === ScriptKind.JSX) && !file.checkJsDirective && checkJs === undefined;
}
const file: SourceFile = {scriptKind:1, checkJsDirective:undefined};
console.log(`${isPlainJsFile(file,undefined)}:${isPlainJsFile(undefined,undefined)}`);
