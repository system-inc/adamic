// a-check: checked
// From src/compiler/utilities.ts:8147 (TypeScript 6.0.3, main adaptations).

export function compareDataObjects(dst: any, src: any): boolean {
    if (!dst || !src || Object.keys(dst).length !== Object.keys(src).length) {
        return false;
    }

    for (const e in dst) {
        if (typeof dst[e] === "object") {
            if (!compareDataObjects(dst[e], src[e])) {
                return false;
            }
        }
        else if (typeof dst[e] !== "function") {
            if (dst[e] !== src[e]) {
                return false;
            }
        }
    }
    return true;
}
console.log(`${compareDataObjects({x:7},{x:7})}:${compareDataObjects({x:7},{x:9})}`);
