type SyntaxKind = 64;
function tokenToString(token:SyntaxKind):string {return '=';}
function writeTokenText(token: SyntaxKind, writer: (s: string) => void): void;
function writeTokenText(token: SyntaxKind, writer: (s: string) => void, pos: number): number;
function writeTokenText(token: SyntaxKind, writer: (s: string) => void, pos?: number): number {
        const tokenString = tokenToString(token)!;
        writer(tokenString);
        return pos! < 0 ? pos! : pos! + tokenString.length;
    }
let output='';
function writer(text:string):void {output+=text;}
writeTokenText(64,writer);
console.log(`${writeTokenText(64,writer,10)}:${writeTokenText(64,writer,-1)}:${output}`);
