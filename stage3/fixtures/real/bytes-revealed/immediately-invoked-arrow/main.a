// a-check: checked
// From src/compiler/transformers/esDecorators.ts:670 (TypeScript 6.0.3, ed6e2975 adaptations).

interface Expression {readonly kind:number;readonly text:string;}
interface ClassLikeDeclaration {readonly name:string;}
interface ArrowFunction extends Expression {readonly kind:220;readonly body:string;}
interface ParenthesizedExpression extends Expression {readonly kind:218;readonly expression:Expression;}
interface CallExpression extends Expression {readonly kind:214;readonly expression:Expression;}
type ImmediatelyInvokedArrowFunction = CallExpression & {readonly expression:ParenthesizedExpression & {readonly expression:ArrowFunction;};};
interface Statement {readonly text:string;}
function transformClassLike(node:ClassLikeDeclaration) {
 startLexicalEnvironment();
 const classDefinitionStatements:Statement[]=[];
 const heritageClauses=undefined;
 const members:Expression[]=[];
 const lexicalEnvironment:Statement[]=[];
 const classExpression=factory.createClassExpression(/*modifiers*/undefined,node.name,/*typeParameters*/undefined,heritageClauses,members);
 classDefinitionStatements.push(factory.createReturnStatement(classExpression));
 setOriginalNode(classExpression,node);
 return factory.createImmediatelyInvokedArrowFunction(factory.mergeLexicalEnvironment(classDefinitionStatements,lexicalEnvironment));
}
function startLexicalEnvironment():void {}
function setOriginalNode(node:Expression,original:ClassLikeDeclaration):void {}
const factory={
 createClassExpression(modifiers:undefined,name:string,typeParameters:undefined,heritage:undefined,members:readonly Expression[]):Expression {return {kind:232,text:'class '+name+' {}'};},
 createReturnStatement(node:Expression):Statement {return {text:'return '+node.text+';'};},
 mergeLexicalEnvironment(statements:Statement[],environment:Statement[]):Statement[] {return [...environment,...statements];},
 createImmediatelyInvokedArrowFunction(statements:Statement[]):ImmediatelyInvokedArrowFunction {const body=statements.map(x=>x.text).join('');return {kind:214,text:'(()=>{'+body+'})()',expression:{kind:218,text:'',expression:{kind:220,text:'',body}}};}
};

console.log(transformClassLike({name:'C'}).text);
