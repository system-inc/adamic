// a-check: checked
// From src/compiler/transformers/module/module.ts:1926 (TypeScript 6.0.3, ed6e2975 adaptations).

interface Expression {readonly text: string;}
interface Identifier {readonly text: string;}
interface VariableDeclaration {readonly name: Identifier; readonly initializer?: Expression;}
type InitializedVariableDeclaration = VariableDeclaration & {readonly initializer: Expression};
function transformInitializedVariable(node: InitializedVariableDeclaration): Expression {
        if (isBindingPattern(node.name)) {
            return flattenDestructuringAssignment(
                visitNode(node, visitor, isInitializedVariable),
                visitor,
                context,
                FlattenLevel.All,
                /*needsValue*/ false,
                createAllExportExpressions,
            );
        }
        else {
            return factory.createAssignment(
                setTextRange(
                    factory.createPropertyAccessExpression(
                        factory.createIdentifier("exports"),
                        node.name,
                    ),
                    /*location*/ node.name,
                ),
                node.initializer ? visitNode(node.initializer, visitor, isExpression) : factory.createVoidZero(),
            );
        }
    }
function isBindingPattern(name: Identifier): boolean {return false;}
function isInitializedVariable(node: InitializedVariableDeclaration): boolean {return true;}
function isExpression(node: Expression): boolean {return true;}
const visitor = 0;
const context = 0;
const FlattenLevel = {All:0};
const createAllExportExpressions = 0;
function flattenDestructuringAssignment(node: InitializedVariableDeclaration, a:number,b:number,c:number,d:boolean,e:number): Expression {return node.initializer;}
function visitNode<T>(node: T, visitor: number, test: (node:T)=>boolean): T {return node;}
function setTextRange(node: Expression, location: Identifier): Expression {return node;}
const factory = {
 createIdentifier(text: string): Identifier {return {text};},
 createPropertyAccessExpression(node: Identifier, name: Identifier): Expression {return {text:node.text+'.'+name.text};},
 createAssignment(left: Expression, right: Expression): Expression {return {text:left.text+'='+right.text};},
 createVoidZero(): Expression {return {text:'void 0'};}
};

console.log(transformInitializedVariable({name:{text:'x'},initializer:{text:'7'}}).text);
