interface PrivateIdentifier extends Expression {readonly kind: 81;}
interface BinaryExpression extends Expression {readonly left: Expression; readonly right: Expression; readonly operatorToken: {readonly kind: number};}
type PrivateIdentifierInExpression = BinaryExpression & {readonly left: PrivateIdentifier; readonly token: 103;};
function accessPrivateIdentifier(node:PrivateIdentifier): {brandCheckIdentifier:Expression}|undefined {return node.text === '#x' ? {brandCheckIdentifier:{text:'_brand'}} : undefined;}
const visitor=0, context=0;
