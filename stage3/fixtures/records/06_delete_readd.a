// Census reason: an index signature
export interface MapLike<T> {
    [index: string]: T;
}
const hasOwnProperty = Object.prototype.hasOwnProperty;
export function getOwnKeys<T>(map: MapLike<T>): string[] {
    const keys: string[] = [];
    for (const key in map) {
        if (hasOwnProperty.call(map, key)) {
            keys.push(key);
        }
    }

    return keys;
}

/** @internal */

// Driver.
const wildcardDirectories: MapLike<number> = {};
wildcardDirectories["src"] = 1;
wildcardDirectories["test"] = 0;
const path = "src";
delete wildcardDirectories[path];
wildcardDirectories[path] = 1;
console.log(getOwnKeys(wildcardDirectories).join(","));
