enum SyntaxKind { WithKeyword = 118, AssertKeyword = 132, Identifier = 80 }
function select(currentToken: SyntaxKind): void {
    console.log('before');
    const result = currentToken as SyntaxKind.WithKeyword | SyntaxKind.AssertKeyword;
    console.log(`token=${result}`);
    console.log('after');
}
select(SyntaxKind.Identifier);
