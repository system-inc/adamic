// Census reason: class declaration or expression
type Identifier = string;
class IdentifierNameMap<V> {
    private readonly _map = new Map<string, V>();
    get size(): number {
        return this._map.size;
    }
    get(key: Identifier): V | undefined { return this._map.get(key); }
    set(key: Identifier, value: V): void { this._map.set(key, value); }
    delete(key: Identifier): boolean { return this._map.delete(key); }
}
function unorderedRemoveItem<T>(items: T[], item: T): void { const i=items.indexOf(item); if(i>=0) items.splice(i,1); }
class IdentifierNameMultiMap<V> extends IdentifierNameMap<V[]> {
    add(key: Identifier, value: V): V[] {
        let values = this.get(key);
        if (values) {
            values.push(value);
        }
        else {
            this.set(key, values = [value]);
        }
        return values;
    }

    remove(key: Identifier, value: V) {
        const values = this.get(key);
        if (values) {
            unorderedRemoveItem(values, value);
            if (!values.length) {
                this.delete(key);
            }
        }
    }
}

const names = new IdentifierNameMultiMap<string>();
names.add("x", "first"); names.add("x", "second"); names.remove("x", "first");
console.log(names.get("x")?.join(",") ?? "none");
console.log(`${names.size}`);
names.remove("x", "second"); console.log(names.get("x")?.join(",") ?? "none");

