// a-check: checked
// Step 12: Node enumerates the hidden string; checked Adamic reflection must stop before yielding it.
interface Visible { readonly visible: number; }
const source = { visible: 1, hidden: 'wrong' };
const view: Visible = source;
console.log('before entries');
const entries: [string, number][] = Object.entries(view);
console.log('count:' + entries.length);
entries.forEach(entry => console.log(entry[0] + ':' + entry[1]));
console.log('after entries');
