// Real compound store parameterized by flags; NodeFlags represented as numbers and driver keeps one literal flag domain.
interface Node { readonly pos: number; readonly flags: number; }
type Mutable<T> = { -readonly [P in keyof T]: T[P] };
interface Identifier extends Node { readonly escapedText: string; }
function bindChildren(node: Node, flags: number): void {
    (node as Mutable<Node>).flags |= flags;
}

const node: { readonly pos: 0; readonly flags: 0; readonly escapedText: "label"; } = { pos: 0, flags: 0, escapedText: "label" };
console.log("before write");
bindChildren(node, 1);
console.log(`stored ${node.flags}`);
