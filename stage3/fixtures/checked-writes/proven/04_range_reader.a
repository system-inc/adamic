function nodeIsSynthesized(node: Node): boolean { return positionIsSynthesized(node.pos); }
function rangeIsOnSingleLine(node: Node, file: SourceFile): boolean { return node.end <= file.text.length; }
function rangeEndPositionsAreOnSameLine(parent: Node, child: Node, file: SourceFile): boolean { return parent.end === child.end && file.text.length > 0; }
function synthesizedNodeStartsOnNewLine(node: Node, format: ListFormat): boolean { return node.pos < 0 && format > 0; }
