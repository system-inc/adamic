// SymbolTable values are reduced to numbers; resetMembers parameterizes the real members assignment.
type SymbolTable = Map<string, number>;
interface ObjectType { members: SymbolTable | undefined; }
interface ResolvedType { members: SymbolTable; }
function resetMembers(type: ObjectType, members: SymbolTable | undefined): void {
    type.members = members;
}

const members: SymbolTable = new Map<string, number>([["x", 1]]);
const type: ResolvedType = { members };
console.log("before write");
resetMembers(type, undefined);
console.log(`stored ${type.members === undefined ? "undefined" : "members"}`);
