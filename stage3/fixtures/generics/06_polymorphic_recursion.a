// a-check: refused a generic function instantiated without end (polymorphic recursion); call it with the same type arguments it was called with, or write a function per type
// Supplemental 0.1 monomorphization boundary; not a tsc reduction.
function grow<T>(value: T, depth: number): number {
    if (depth === 0) return 0;
    return grow([value], depth - 1);
}
console.log(`${grow(1, 1)}`);
