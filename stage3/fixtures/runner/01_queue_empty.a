// From TypeScript 6.0.3, src/compiler/core.ts:1573
// Census reason: a function inside a function (a closure)
// Driver supplies the queue state used by tsc's unchanged nested isEmpty.
function probeQueueEmpty(elements: readonly number[], headIndex: number): boolean {
    function isEmpty() {
        return headIndex === elements.length;
    }
    return isEmpty();
}

console.log(`${probeQueueEmpty([1, 2], 0)} ${probeQueueEmpty([1, 2], 2)} ${probeQueueEmpty([], 0)}`);
