// Census reason: a namespace
// Fixed scanner input is the token stream for a JSDoc comma followed by EOF.
enum SyntaxKind { EndOfFileToken = 1, CommaToken = 28 }
type JSDocSyntaxKind = SyntaxKind;
namespace Parser {
    var currentToken: SyntaxKind;
    const scanner = { scanJsDocToken: (): JSDocSyntaxKind => SyntaxKind.EndOfFileToken };
    function token(): SyntaxKind {
        return currentToken;
    }
    function nextTokenJSDoc(): JSDocSyntaxKind {
        return currentToken = scanner.scanJsDocToken();
    }
    export namespace JSDocParser {
        const enum JSDocState {
            BeginningOfLine,
            SawAsterisk,
            SavingComments,
            SavingBackticks, // NOTE: Only used when parsing tag comments
        }

        const enum PropertyLikeParse {
            Property = 1 << 0,
            Parameter = 1 << 1,
            CallbackParameter = 1 << 2,
        }
        // Keep the original worker-local helper body; omit unrelated comment parsing.
            function parseOptionalJsdoc(t: JSDocSyntaxKind): boolean {
                if (token() === t) {
                    nextTokenJSDoc();
                    return true;
                }
                return false;
            }

        export function run(): void {
            currentToken = SyntaxKind.CommaToken;
            console.log(`${parseOptionalJsdoc(SyntaxKind.CommaToken)} ${token()}`);
            console.log(`${parseOptionalJsdoc(SyntaxKind.CommaToken)} ${token()}`);
            console.log(`${JSDocState.SavingBackticks} ${PropertyLikeParse.Property | PropertyLikeParse.Parameter}`);
        }
    }
}
Parser.JSDocParser.run();
