// Census reason: a namespace
interface Node { readonly kind: number; }
namespace Parser {
    var nodeCount: number;
    function countNode(node: Node) {
        nodeCount++;
        return node;
    }
    // Fixture driver initializes the same singleton slot initializeState resets.
    export function run(nodes: Node[]): number {
        nodeCount = 0;
        for (const node of nodes) { countNode(node); }
        return nodeCount;
    }
}
