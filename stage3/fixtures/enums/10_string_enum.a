// From TypeScript 6.0.3, src/compiler/types.ts:8068
// From TypeScript 6.0.3, src/compiler/utilities.ts:6570
// Census reason: enum
function fileExtensionIsOneOf(path: string, extensions: readonly string[]): boolean { return extensions.some(extension => path.endsWith(extension)); }
export const enum Extension {
    Ts = ".ts",
    Tsx = ".tsx",
    Dts = ".d.ts",
    Js = ".js",
    Jsx = ".jsx",
    Json = ".json",
    TsBuildInfo = ".tsbuildinfo",
    Mjs = ".mjs",
    Mts = ".mts",
    Dmts = ".d.mts",
    Cjs = ".cjs",
    Cts = ".cts",
    Dcts = ".d.cts",
}
export function getDeclarationEmitExtensionForPath(path: string): Extension.Dts | Extension.Dmts | Extension.Dcts | ".d.json.ts" {
    return fileExtensionIsOneOf(path, [Extension.Mjs, Extension.Mts]) ? Extension.Dmts :
        fileExtensionIsOneOf(path, [Extension.Cjs, Extension.Cts]) ? Extension.Dcts :
        fileExtensionIsOneOf(path, [Extension.Json]) ? `.d.json.ts` : // Drive-by redefinition of json declaration file output name so if it's ever enabled, it behaves well
        Extension.Dts;
}

// Driver.
for (const path of ["index.ts", "index.mts", "index.cjs", "data.json"]) { console.log(`${path}: ${getDeclarationEmitExtensionForPath(path)}`); }
