// Census reason: enum
export enum DiagnosticCategory {
    Warning,
    Error,
    Suggestion,
    Message,
}
/** @internal */
export function diagnosticCategoryName(d: { category: DiagnosticCategory; }, lowerCase = true): string {
    const name = DiagnosticCategory[d.category];
    return lowerCase ? name.toLowerCase() : name;
}
// Driver.
for (const category of [DiagnosticCategory.Warning, DiagnosticCategory.Error, DiagnosticCategory.Suggestion, DiagnosticCategory.Message]) { console.log(diagnosticCategoryName({category})); console.log(diagnosticCategoryName({category}, false)); }
