// Census reason: non-boolean control condition
interface DiagnosticMessage {key: string; message: string;}
let localizedDiagnosticMessages: { [key: string]: string } | undefined;
export function getLocaleSpecificMessage(message: DiagnosticMessage): string {
    return localizedDiagnosticMessages && localizedDiagnosticMessages[message.key] || message.message;
}

const message = {key: "error", message: "fallback"};
console.log(getLocaleSpecificMessage(message));
