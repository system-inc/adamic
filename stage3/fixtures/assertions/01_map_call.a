// From TypeScript 6.0.3, src/compiler/core.ts:519
// Census reason: the non-null assertion !
// Support types and driver are reduced scaffolding; the upstream function is unchanged.

export function getOrUpdate<K, V>(map: Map<K, V>, key: K, callback: () => V): V {
    if (map.has(key)) {
        return map.get(key)!;
    }
    const value = callback();
    map.set(key, value);
    return value;
}

const values = new Map<string, number>();
console.log(String(getOrUpdate(values, "id", () => 17)));
console.log(String(getOrUpdate(values, "id", () => 99)));
