// From TypeScript 6.0.3, src/compiler/scanner.ts:800
// Census reason: the non-null assertion !
// Support types and driver are reduced scaffolding; the upstream function is unchanged.

const shebangTriviaRegex = /^#!.*/;

function scanShebangTrivia(text: string, pos: number) {
    const shebang = shebangTriviaRegex.exec(text)![0];
    pos = pos + shebang.length;
    return pos;
}

console.log(String(scanShebangTrivia("#!/usr/bin/node\nlet x", 0)));
console.log(String(scanShebangTrivia("#!node", 0)));
