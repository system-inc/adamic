+ }
+ throw e;
+}
+try {
+ fail('Debug Failure.', undefined);
+} catch (e) {
+ if (e instanceof Error) {
+  console.log(e.message);
+  console.log(e.name);
+ }
+}
+try {
+ fail('passed marker', mark);
+} catch (e) {
+ if (e instanceof Error) {
+  console.log(e.message);
+  console.log(e.name);
+ }
+}
+const e = new Error('unchanged');
+Error.captureStackTrace(e);
+console.log(e.message);
+console.log(e.name);
