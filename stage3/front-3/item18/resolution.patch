+			}
+			want := onNode(t, path)
+			if !mutant.mutate(p) {
+				t.Fatal("mutant changed nothing")
+			}
+			got, _ := natively(t, p)
+			if difference := disagreement(want, got); difference == "" {
+				t.Fatal("mutant survived Node comparison")
+			} else {
+				t.Logf("caught: %s (Node exit %d, mutant exit %d)", difference, want.exitCode, got.exitCode)
+			}
+		})
+	}
+}
