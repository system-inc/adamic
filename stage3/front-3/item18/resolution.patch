diff --git a/internal/fresh/phantom_member_test.go b/internal/fresh/phantom_member_test.go
new file mode 100644
index 000000000..129debb6e
--- /dev/null
+++ b/internal/fresh/phantom_member_test.go
@@ -0,0 +1,39 @@
+package fresh_test
+
+import (
+	"testing"
+
+	"github.com/system-inc/adamic/internal/fresh"
+	"github.com/system-inc/adamic/internal/ir"
+)
+
+func TestPhantomMemberFreshness(t *testing.T) {
+	for _, receiverWrites := range []bool{false, true} {
+		t.Run(map[bool]string{false: "absent member holds no receiver", true: "receiver effects remain"}[receiverWrites], func(t *testing.T) {
+			program := &ir.Program{Strings: []string{"missing"}, Locals: []ir.Local{{Type: ir.Array, Function: -1}}}
+			array := ir.Read{Local: 0, Of: ir.Array}
+			var receiver ir.Expression = array
+			if receiverWrites {
+				receiver = ir.ArrayPush{Array: array, Value: ir.Undefined{Of: ir.Object}, Element: ir.Object, Site: 2}
+			}
+			member := ir.PhantomMember{Value: receiver, Optional: true, Failure: ir.MakeError{Message: ir.StringConstant{Index: 0}}}
+			program.Main = []ir.Statement{
+				ir.Declare{Local: 0, Value: ir.ArrayLiteral{Element: ir.Object}},
+				ir.Evaluate{Value: ir.ArrayPush{Array: array, Value: member, Element: ir.Object, Site: 1}},
+			}
+			writes := fresh.ProveWrites(program)
+			want := 1
+			if receiverWrites {
+				want = 2
+			}
+			if len(writes) != want {
+				t.Fatalf("phantom receiver writes: got %d, want %d: %+v", len(writes), want, writes)
+			}
+			for _, write := range writes {
+				if write.Kind != fresh.WriteElement || !write.Proven || write.Site == 0 {
+					t.Fatalf("absent phantom member must retain effects and hold no receiver: %+v", write)
+				}
+			}
+		})
+	}
+}
