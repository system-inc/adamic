+	bad := nodeProcessTerminal(t, "backpressure", mutant)
+	if len(bad.stdout) >= len(truth.stdout) || len(bad.stderr) != 0 || disagreement(truth, bad) == "" {
+		t.Fatal("blocking mutation survived, or failed outside Node comparison")
+	}
