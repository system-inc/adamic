+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("Node: %v\n%s", err, output)
+	}
+	if err := json.Unmarshal(output, &cases); err != nil {
+		t.Fatal(err)
+	}
+	runRegexCases(t, cases)
+}
