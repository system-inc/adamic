+	data, err := os.ReadFile(countsPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(data)
+	if strings.Contains(text, row+"\n") {
+		return
+	}
+	if !*updateSurrogateCounts {
+		t.Fatalf("fixture counts changed: %s", row)
+	}
+	prefix := "| " + path + " |"
+	at := strings.Index(text, prefix)
