+		t.Fatalf("unexpected Node result %d %s", truth.exitCode, truth.stderr)
+	}
+	for _, got := range []run{execute(t, binary), onNode(t, script)} {
+		if difference := disagreement(truth, got); difference != "" {
+			t.Fatalf("%s: %s", difference, got.stderr)
+		}
+	}
+}
