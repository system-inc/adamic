+		if (length == 0 || (length == 1 && segment[0] == '.')) { continue; }
+		if (length == 2 && segment[0] == '.' && segment[1] == '.') {
+			while (output > 1 && name[output - 1] != '/') { output--; }
+			if (output > 1) { output--; }
+			continue;
+		}
+		if (output > 1) { name[output++] = '/'; }
