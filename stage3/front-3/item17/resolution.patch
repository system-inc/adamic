+	} else {
+		end := at + strings.Index(text[at:], "\n")
+		text = text[:at] + row + text[end:]
+	}
+	if err := os.WriteFile(countsPath, []byte(text), 0644); err != nil {
+		t.Fatal(err)
+	}
