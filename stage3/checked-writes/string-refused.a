// a-check: refused a value of type { readonly text: "left" | "right"; } seen as { text: string; }, whose readonly field text becomes writable: a readonly field may hold something narrower than "left" | "right", which a write of string would replace; keep text readonly in the type it's seen as, or copy the value ({ ...value }) (adamic/invariant-mutable)
const node: { readonly text: 'left' | 'right' } = { text: 'left' };
function store(view: { text: string }, value: string): void { view.text = value; }
store(node, 'outside'.repeat(2));
console.log(node.text);
