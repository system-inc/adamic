  "rules": [
    {
      "id": 1,
      "reason": "Both getLeadingCommentRanges and getTrailingCommentRanges pass undefined. The body never reads state."
    },
    {
      "id": 4,
      "reason": "The existing StringConstructor library owns the function. Both feature-probe and fallback remain."
    },
    {
      "id": 5,
      "reason": "Only keyof this mapped type is consumed. The mapped value is never observed or instantiated."
    },
    {
      "id": 6,
      "reason": "AnyFunction is callable. Its existing Function name property is already a string; the feature test is retained."
    },
    {
      "id": 7,
      "reason": "ProgramHost constrains its generic to BuilderProgram. readFile does not depend on that generic."
    },
    {
      "id": 8,
      "reason": "Preserve the same builder family T carried by each caller and its createProgram callback; a broad BuilderProgram would violate callback variance."
    },
    {
      "id": 9,
      "reason": "Emit callbacks observe AST node arrays; Node is their actual common element bound."
    },
