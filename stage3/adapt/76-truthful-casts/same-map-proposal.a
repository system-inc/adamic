// From TypeScript 6.0.3, src/compiler/core.ts, sameMap overloads and implementation.
// Proposal only: the honest union return reveals a blocked builder caller.
export function sameMap<T, U = T>(array: T[], f: (x: T, i: number) => U): (T | U)[];
/** @internal */
export function sameMap<T, U = T>(array: readonly T[], f: (x: T, i: number) => U): readonly (T | U)[];
/** @internal */
export function sameMap<T, U = T>(array: T[] | undefined, f: (x: T, i: number) => U): (T | U)[] | undefined;
/** @internal */
export function sameMap<T, U = T>(array: readonly T[] | undefined, f: (x: T, i: number) => U): readonly (T | U)[] | undefined;
/** @internal */
export function sameMap<T, U = T>(array: readonly T[] | undefined, f: (x: T, i: number) => U): readonly (T | U)[] | undefined {
    if (array !== undefined) {
        for (let i = 0; i < array.length; i++) {
            const item = array[i]!;
            const mapped = f(item, i);
            if (item as unknown !== mapped) {
                const result: (T | U)[] = array.slice(0, i);
                result.push(mapped);
                for (i++; i < array.length; i++) {
                    result.push(f(array[i]!, i));
                }
                return result;
            }
        }
    }
    return array;
}
const input: (string | number)[] = ["a", "b"];
const output = sameMap<string | number, string>(input, (value, index) => {
    if (index === 1) { input[0] = 0; }
    return typeof value === "string" ? value : String(value);
});
console.log(`${typeof output?.[0]}`);
