      "start": 88632,
      "end": 89005,
      "line": 2471,
      "endLine": 2482,
      "text": "export function or<T extends unknown[], U>(...fs: ((...args: T) => U)[]): (...args: T) => U | undefined {\r\n    return (...args) => {\r\n        let lastResult: U | undefined;\r\n        for (const f of fs) {\r\n            lastResult = f(...args);\r\n            if (lastResult) {\r\n                return lastResult;\r\n            }\r\n        }\r\n        return lastResult;\r\n    };\r\n}"
    }
