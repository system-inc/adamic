+
+// Scratch only: retain the entry-root compiler program, including diagnostics.
+func (p *Program) CensusFiles() []*ast.SourceFile {
+	var files []*ast.SourceFile
+	for _, f := range p.compiler.GetSourceFiles() {
+		if !f.IsDeclarationFile && !IsLibrary(f) && !IsPrelude(f) {
