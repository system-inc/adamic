          "text": "function convertOptionsFromJson<TRaw>(optionsNameMap: Map<string, CommandLineOption>, jsonOptions: TRaw, basePath: string, defaultOptions: CompilerOptions | TypeAcquisition | WatchOptions | undefined, diagnostics: DidYouMeanOptionsDiagnostics, errors: Diagnostic[]) {\r\n    if (!jsonOptions) {\r\n        return;\r\n    }\r\n\r\n    for (const id in jsonOptions) {\r\n        const opt = optionsNameMap.get(id);\r\n        if (opt) {\r\n            (defaultOptions || (defaultOptions = {}))[opt.name] = convertJsonOption(opt, jsonOptions[id], basePath, errors);\r\n        }\r\n        else {\r\n            errors.push(createUnknownOptionError(id, diagnostics));\r\n        }\r\n    }\r\n    return defaultOptions;\r\n}"
