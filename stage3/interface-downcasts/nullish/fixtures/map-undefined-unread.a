interface Base { readonly kind: string; }
interface Target extends Base { readonly kind: 'box'; readonly value: ReadonlyMap<string,string> | undefined; }
function make(which:number):Base {
 if(which===0) {const raw={kind:'box',value:new Map<string,string>()}; return raw;}

 const raw={kind:'box',value:undefined}; return raw;
}
function read(node:Target):void { console.log(node.kind); }

read(make(0) as Target);
read(make(1) as Target);
