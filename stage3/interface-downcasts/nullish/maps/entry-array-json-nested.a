interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly values:readonly (readonly (1|undefined)[])[]}
const values:number[][]=[[1]];
const raw={kind:'box',values:values};const base:Base=raw;
function read(node:Target):void{console.log(JSON.stringify(node.values)??'missing');console.log(JSON.stringify({nested:node.values})??'missing');}
read(base as Target);
