class Named{readonly count:number=7;}
interface Entry{child?:Named|undefined}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Entry>}
const fake={count:7};const item:Entry={child:new Named()};const empty:Entry={};const source=new Map<string,Entry>([['key',item],['empty',empty]]);const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);item.child=new Named();console.log(String(fake.count));
