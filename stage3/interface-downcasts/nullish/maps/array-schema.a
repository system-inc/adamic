interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<string,readonly number[]>|null|undefined}
const values:readonly string[]=['seven'];const map=new Map<string,readonly string[]>();map.set('key',values);
const raw={kind:'box',value:map};const base:Base=raw;
function payload(values:readonly number[]):void{console.log(String(values[0]??0));}
function read(node:Target):void{const map=node.value;if(map!==null&&map!==undefined){const value=map.get('key');if(value!==undefined){payload(value);}}}
read(base as Target);
