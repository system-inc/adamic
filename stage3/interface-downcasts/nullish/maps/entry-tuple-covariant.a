interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,readonly [number,string]>|null}
const pair:readonly [1,string]=[1,'seven'];
const raw={kind:'box',value:new Map<string,readonly [1,string]>([['key',pair]])};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
