interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,number|string|null|undefined>|null}
const map=new Map<string,number|string|null|undefined>([['number',7],['string','seven'],['null',null],['undefined',undefined]]);
const clone=new Map<string,number|string|null|undefined>(map);
map.set('number','changed');map.delete('string');map.clear();console.log(String(map.size));
const raw={kind:'box',value:clone};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){for(const value of map.values()){console.log(typeof value+':'+String(value===null));}}}
read(base as Target);
