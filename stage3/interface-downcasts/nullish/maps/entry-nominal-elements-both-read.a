class Named {readonly count:number=7;}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly values:readonly (Named|null|undefined)[]}
const fake={count:7};const item:(Named|null|undefined)[]=[new Named(),null,undefined];const raw={kind:'box',values:item};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.values[0]);}
read(base as Target);console.log(String(fake.count));
