type Brand=number&{readonly __brand:void};
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,{readonly count:Brand}>|null}
const raw={kind:'box',value:new Map<string,{readonly count:number}>([['key',{count:7}]])};const base:Base=raw;
function read(node:Target):void{console.log(node.kind);}
read(base as Target);
