class Box<T> {private readonly identity:number=1;readonly count:T;constructor(value:T){this.count=value;}}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Box<number>>|null}
const item=new Box<number>(7);const source=new Map<string,Box<number>>([['key',item]]);
const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){const value=map.get('key');if(value!==undefined){console.log(String(value instanceof Box));console.log(String(value===item));console.log(String(value.count));}}}
read(base as Target);
