class Named{readonly count:number=7;}
interface Entry{child:Named;next:Entry|undefined}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Entry>}
const leaf={child:new Named(),next:undefined as Entry|undefined};
const item={child:new Named(),next:leaf as Entry|undefined};
const source=new Map<string,Entry>([['key',item]]);const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{node.value.forEach(entry=>{console.log(String(entry.child.count));const next=entry.next;console.log(next===undefined?'undefined':String(next.child.count));});}
item.next=leaf;read(base as Target);item.next=undefined;read(base as Target);item.next=leaf;read(base as Target);
