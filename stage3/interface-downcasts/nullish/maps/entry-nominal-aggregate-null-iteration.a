class Named{readonly count:number=7;}
interface Entry{readonly child:Named}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Entry|null>}
const fake={count:7};const item:Entry={child:new Named()};const source=new Map<string,Entry|null>([['key',item],['missing',null]]);const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{for (const [iterationKey, value] of node.value) {if(value!==null&&value!==undefined){console.log(String(value.child.count));}else{console.log(value===null?'null':'undefined');}}console.log(String(node.value.has('missing')));}
read(base as Target);console.log(String(fake.count));
