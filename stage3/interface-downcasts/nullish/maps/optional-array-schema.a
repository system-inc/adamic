interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<string,readonly number[]>|null}
const map=new Map<string,readonly number[]|undefined>();map.set('key',undefined);map.set('other',[7]);
const raw={kind:'box',value:map};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
