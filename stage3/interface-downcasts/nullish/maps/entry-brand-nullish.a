type Escaped=string&{readonly __escaped:void};
type Missing=void&{readonly __escaped:void};
type Name=Escaped|Missing;
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Name>|null}
const item='seven' as Escaped;
const missing=undefined as Missing;
const raw={kind:'box',value:new Map<string,Name>([['key',item],['undefined',missing]])};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){console.log(typeof map.get('key'));console.log(typeof map.get('undefined'));console.log(String(map.has('undefined')));}}
read(base as Target);
