interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,(boolean)|undefined>|null}
const item:boolean=true;
const source=new Map<string,boolean>([['key',item]]);
const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){console.log(typeof map.get('key'));console.log(typeof map.get('missing'));console.log(String(map.get('key')===item));const current=map.get('key');if(current!==null&&current!==undefined){console.log(String(current));}
const iterator=map.values();const first=iterator.next();console.log('iterator:'+typeof first.value);console.log(String(first.done));const last=iterator.next();console.log(typeof last.value);console.log(String(last.done));
for(const [key,value] of map){console.log(key+':'+typeof value);}
const copied=new Map<string,(boolean)|undefined>(map);console.log('copy:'+typeof copied.get('key'));
for (const [iterationKey, value] of map) {source.clear();console.log('callback:'+typeof value);}console.log(String(source.size));}}
read(base as Target);
