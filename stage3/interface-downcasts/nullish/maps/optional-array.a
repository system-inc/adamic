interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<string,readonly number[]|undefined>|null}
const map=new Map<string,readonly number[]|undefined>();map.set('key',undefined);map.set('other',[7]);
const raw={kind:'box',value:map};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){console.log(String(map.has('key')));const a=map.get('key');console.log(typeof a);const b=map.get('other');if(b!==undefined){console.log(String(b[0]??0));}}}
read(base as Target);
