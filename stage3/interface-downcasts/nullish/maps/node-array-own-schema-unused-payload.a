interface NodeArray<T> extends ReadonlyArray<T>{readonly pos:number}
interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<string,NodeArray<number>>|null}
interface Wrong<T> extends ReadonlyArray<T>{readonly pos:string}
const values=Object.assign([7,8],{pos:'three'});const map=new Map<string,Wrong<number>>();map.set('key',values);
const raw={kind:'box',value:map};const base:Base=raw;
function payload(values:NodeArray<number>):void{console.log(String(values.pos));console.log(String(values[0]??0));}
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
