interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,readonly [number,string]>|null}
const pair:readonly [number,string,number]=[7,'seven',9];
const raw={kind:'box',value:new Map<string,readonly [number,string,number]>([['key',pair]])};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
