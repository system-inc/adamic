interface Key {readonly count:number}
interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<Key,number>|null}
const key={count:7};const map=new Map<Key,number>();map.set(key,8);
const raw={kind:'box',value:map};const base:Base=raw;
function read(node:Target,key:Key):void{const map=node.value;if(map!==null){console.log(String(map.get(key)??0));}}
read(base as Target,key);
