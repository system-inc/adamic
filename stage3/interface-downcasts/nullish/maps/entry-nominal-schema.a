class Named {private readonly identity:number=1;readonly count:number=7;}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Named>|null}
const raw={kind:'box',value:new Map<string,{readonly count:number;readonly identity:number}>([['key',{count:7,identity:1}]])};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
