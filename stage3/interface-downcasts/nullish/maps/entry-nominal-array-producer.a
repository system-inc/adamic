class Named {readonly count:number=7;}
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,readonly Named[]>}
const fake={count:7};const item:Named[]=[new Named()];const source=new Map<string,Named[]>([['key',item]]);const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);console.log(String(fake.count));
