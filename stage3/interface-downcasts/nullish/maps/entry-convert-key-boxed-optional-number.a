interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<number|undefined|null|undefined,string>|null}
const source=new Map<number|undefined,string>([[7,'seven'],[undefined,'missing']]);
const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){
console.log(String(map.get(7)));console.log(String(map.get(null)));console.log(String(map.get(undefined)));
for(const key of map.keys()){console.log('key:'+String(key));}
for(const [key,value] of map){console.log(String(key)+':'+value);}
const keys=[...map.keys()];console.log(keys.join(','));
const copy=new Map<number|undefined|null|undefined,string>(map);copy.set(null,'null');copy.set(undefined,'missing');copy.set(8,'eight');copy.set(9,'nine');copy.set(10,'ten');
console.log(String(copy.get(7)));console.log(String(copy.get(null)));console.log(String(copy.get(undefined)));console.log(String(copy.size));
const iterator=map.keys();console.log(String(iterator.next().value));console.log(String(iterator.next().value));console.log(String(iterator.next().done));
map.forEach((value,key)=>{console.log('callback:'+String(key)+':'+value);});
source.clear();console.log(keys.join(','));console.log(String(copy.get(7)));
}}
read(base as Target);
