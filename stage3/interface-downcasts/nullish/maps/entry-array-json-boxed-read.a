interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,readonly (number|null)[]>|null}
const raw={kind:'box',value:new Map<string,readonly number[]>([['key',[7]]])};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){const values=map.get('key');if(values!==undefined){console.log(JSON.stringify(values) ?? 'undefined');}}}
read(base as Target);
