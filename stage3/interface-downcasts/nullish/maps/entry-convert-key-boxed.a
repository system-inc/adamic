interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly other:readonly number[];readonly value:ReadonlyMap<number|null|undefined,string>|null}
const source=new Map<number,string>([[NaN,'nan'],[-0,'zero'],[7,'seven']]);
const raw={kind:'box',other:[8],value:source};const base:Base=raw;
function read(node:Target):void{console.log(node.other.join(','));const map=node.value;if(map!==null){
console.log(typeof map.get(null));console.log(typeof map.get(undefined));console.log(String(map.has(undefined)));console.log(String(map.get(NaN)));console.log(String(map.get(0)));console.log(String(map.get(-0)));
for(const key of map.keys()){console.log('key:'+String(key));}
for(const [key,value] of map){console.log(String(key)+':'+value);}
const keys=[...map.keys()];console.log(keys.join(','));
const copy=new Map<number|null|undefined,string>(map);console.log(String(copy.get(NaN)));console.log(String(copy.has(undefined)));copy.set(null,'null');copy.set(undefined,'missing');copy.set(11,'eleven');copy.set(12,'twelve');copy.set(13,'thirteen');console.log(String(copy.get(13)));console.log(String(copy.get(null)));console.log(String(copy.get(0)));copy.set(NaN,'again');console.log(String(copy.size));console.log(String(copy.get(undefined)));console.log(String(copy.get(NaN)));
const iterator=map.keys();console.log(String(iterator.next().value));console.log(String(iterator.next().value));console.log(String(iterator.next().value));console.log(String(iterator.next().done));
map.forEach((value,key)=>{console.log('callback:'+String(key)+':'+value);});
source.set(9,'nine');console.log(String(map.get(9)));console.log(String(source.size));
}}
read(base as Target);
