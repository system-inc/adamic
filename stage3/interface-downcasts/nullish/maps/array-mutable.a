interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<string,number[]>|null|undefined}
const values:number[]=[7,8];const map=new Map<string,number[]>();map.set('key',values);values.push(9);
const raw={kind:'box',value:map};const base:Base=raw;
function payload(values:number[]):void{console.log(String(values[0]??0));}
function read(node:Target):void{const map=node.value;if(map!==null&&map!==undefined){const value=map.get('key');if(value!==undefined){payload(value);}}}
read(base as Target);
