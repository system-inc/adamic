interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,(boolean)|null|undefined>|null}
const item:boolean=true;
const source=new Map<string,boolean|undefined>([['key',item],['undefined',undefined]]);
const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){console.log(typeof map.get('key'));console.log(typeof map.get('missing'));console.log(typeof map.get('undefined'));console.log(String(map.has('undefined')));console.log(String(map.get('key')===item));const current=map.get('key');if(current!==null&&current!==undefined){console.log(String(current));}
for(const value of map.values()){console.log('values:'+typeof value);}
for(const [key,value] of map){console.log(key+':'+typeof value);}
const copied=new Map<string,(boolean)|null|undefined>(map);console.log('copy:'+typeof copied.get('key'));
for (const [iterationKey, value] of map) {source.clear();console.log('callback:'+typeof value);}console.log(String(source.size));}}
read(base as Target);
