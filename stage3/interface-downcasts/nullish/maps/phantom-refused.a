type Branded=number&{readonly __brand:void};
interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,Branded>}
const raw={kind:'box',value:new Map<string,number>()};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
