interface Base{readonly kind:string}
interface Target extends Base{readonly kind:'box';readonly value:ReadonlyMap<string,number|string>|null}
const map=new Map<string,number|null>();map.set('bad',null);
const raw={kind:'box',value:map};const base:Base=raw;
function read(node:Target):void{console.log(typeof node.value);}
read(base as Target);
