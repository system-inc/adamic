class Named {readonly count:number=7;}
interface Entry {readonly child:Named}
interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:ReadonlyMap<string,Entry>|null}
const fake={count:7};const item:Entry={child:new Named()};
const source=new Map<string,Entry>([['key',item]]);
const raw={kind:'box',value:source};const base:Base=raw;
function read(node:Target):void{const map=node.value;if(map!==null){const entry=map.get('key');if(entry!==undefined){console.log(typeof entry.child);}}}
read(base as Target);console.log(String(fake.count));
