interface Base {readonly kind:string}
interface Target extends Base {readonly kind:'box';readonly value:{readonly kind:'a'; readonly text:string} | {readonly kind:'b';readonly count:number} | undefined}
function make(which:number):Base {
 if(which===0) {const raw={kind:'box',value:{kind:'c',text:'bad'}};return raw;}
 const raw={kind:'box',value:undefined};return raw;
}
function read(node:Target):void {
 const value=node.value;
 console.log(typeof value+':'+String(value===null)+':'+String(value===undefined));
 if(value!==null && value!==undefined) {console.log(value.kind === 'a' ? value.text : String(value.count));}
}
read(make(0) as Target);
read(make(1) as Target);
