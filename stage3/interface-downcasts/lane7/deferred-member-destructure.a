interface Left { readonly value: number; readonly left: number }
interface Right { readonly value: number; readonly right: string }
interface Named { readonly descendant: Left | Right }
interface Counted { readonly count: number; readonly items: readonly number[] }
interface Carrier { readonly value: object }
interface Target extends Carrier { readonly value: Named & Counted }
const actual = { count: 1, items: [], descendant: { value: 42 } };
const carrier: Carrier = { value: actual };
const view = carrier as Target;
const root = view.value;
const { descendant: selected } = root;
console.log(`${selected.value}`);
