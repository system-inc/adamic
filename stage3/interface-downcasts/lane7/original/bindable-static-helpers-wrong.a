import type { BindableStaticPropertyAssignmentExpression, SyntaxKind } from 'original-tsc-types';
interface Base { readonly kind: SyntaxKind }
const top = { pos: 0, end: 9, kind: 308, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: {} };
const statement = { pos: 0, end: 9, kind: 245, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: top };
const symbol = { flags: 4, escapedName: 'value', id: 1, mergeId: 0, constEnumOnlyModule: false };
const exportsName = { pos: 0, end: 7, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'exports', symbol };
const name = { pos: 8, end: 13, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'value' };
const left = { pos: 0, end: 13, kind: 212, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, expression: exportsName, name, symbol };
const actual = { pos: 0, end: 17, kind: 227, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, left };
const base: Base = actual;
function read(node: BindableStaticPropertyAssignmentExpression): boolean {
 const access = node.left;
 return access.end > access.pos;
}
function identity<T>(value: T): T { return value; }
const alias = identity(base as BindableStaticPropertyAssignmentExpression);
const stored = { node: alias };
const values = [stored.node];
values.forEach(node => console.log(`${read(node)}`));
