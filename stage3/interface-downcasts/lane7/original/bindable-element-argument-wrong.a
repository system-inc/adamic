// exports[value] with an identifier argument is a BindableElementAccessExpression, not a static one.
import type { BindableStaticPropertyAssignmentExpression, BindableStaticElementAccessExpression, SyntaxKind } from 'original-tsc-types';
interface Base { readonly kind: SyntaxKind }
const top = { pos: 0, end: 9, kind: 308, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: {} };
const statement = { pos: 0, end: 9, kind: 245, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: top };
const symbol = { flags: 4, escapedName: 'value', id: 1, mergeId: 0, constEnumOnlyModule: false };
const exportsName = { pos: 0, end: 7, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'exports', symbol };
const argument = { pos: 8, end: 15, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'value', symbol };
const left = { pos: 0, end: 16, kind: 213, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, expression: exportsName, argumentExpression: argument, symbol };
const actual = { pos: 0, end: 20, kind: 227, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, left };
const base: Base = actual;
function read(node: BindableStaticPropertyAssignmentExpression): boolean {
 const access = node.left;
 const expression = node.left.expression;
 const element = access as BindableStaticElementAccessExpression;
 const argument = element.argumentExpression;
 return access.kind !== expression.kind && argument.end > argument.pos;
}
console.log(`${read(base as BindableStaticPropertyAssignmentExpression)}`);
