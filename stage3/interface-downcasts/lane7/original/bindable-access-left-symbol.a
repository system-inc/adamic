import type { BindablePropertyAssignmentExpression, SyntaxKind } from 'original-tsc-types';
interface Base { readonly kind: SyntaxKind }
const top = { pos: 0, end: 9, kind: 308, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: {} };
const statement = { pos: 0, end: 9, kind: 245, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: top };
const symbol = { flags: 4, escapedName: 'value', id: 1, mergeId: 0, constEnumOnlyModule: false };
// exports[key] whose receiver Identifier has no Symbol.
const exportsName = { pos: 0, end: 7, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'exports' };
const key = { pos: 8, end: 11, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'key', symbol };
const left = { pos: 0, end: 12, kind: 213, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, expression: exportsName, argumentExpression: key, symbol };
const actual = { pos: 0, end: 16, kind: 227, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, left };
const base: Base = actual;
function read(node: BindablePropertyAssignmentExpression): boolean {
 const access = node.left;
 return access.end > access.pos;
}
console.log(`${read(base as BindablePropertyAssignmentExpression)}`);
