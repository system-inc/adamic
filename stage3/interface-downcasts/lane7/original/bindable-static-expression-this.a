import type { BindableStaticPropertyAssignmentExpression, SyntaxKind } from 'original-tsc-types';
interface Base { readonly kind: SyntaxKind }
const top = { pos: 0, end: 9, kind: 308, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: {} };
const statement = { pos: 0, end: 9, kind: 245, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: top };
const symbol = { flags: 4, escapedName: 'value', id: 1, mergeId: 0, constEnumOnlyModule: false };
// tsc's isBindableStaticAccessExpression admits this.inner.value, whose leftmost expression is no EntityNameExpression.
const outer = { pos: 0, end: 7, kind: 110, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'this', symbol };
const inner = { pos: 8, end: 11, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'inner', symbol };
const name = { pos: 12, end: 17, kind: 80, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, escapedText: 'value', symbol };
const prefix = { pos: 0, end: 11, kind: 212, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, expression: outer, name: inner, symbol };
const left = { pos: 0, end: 17, kind: 212, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, expression: prefix, name, symbol };
const actual = { pos: 0, end: 21, kind: 227, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: statement, left };
const base: Base = actual;
function read(node: BindableStaticPropertyAssignmentExpression): boolean {
 const access = node.left;
 const expression = node.left.expression;
 return access.kind === expression.kind;
}
console.log(`${read(base as BindableStaticPropertyAssignmentExpression)}`);
