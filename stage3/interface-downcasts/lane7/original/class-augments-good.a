import type { JSDocAugmentsTag, JSDocImplementsTag, SyntaxKind } from 'original-tsc-types';
interface Base { readonly kind: SyntaxKind }
const top = { pos: 0, end: 40, kind: 308, flags: 0, modifierFlagsCache: 0, transformFlags: 0, parent: {} };
const comment = { pos: 0, end: 30, kind: 321, flags: 16777216, modifierFlagsCache: 0, transformFlags: 0, parent: top };
const symbol = { flags: 32, escapedName: 'Base', id: 1, mergeId: 0, constEnumOnlyModule: false };
// /** @augments Base */: checkJSDocAugmentsTag reads the heritage and its name.
const baseName = { pos: 14, end: 18, kind: 80, flags: 16777216, modifierFlagsCache: 0, transformFlags: 0, parent: comment, escapedText: 'Base', symbol };
const heritage = { pos: 13, end: 18, kind: 234, flags: 16777216, modifierFlagsCache: 0, transformFlags: 0, parent: comment, expression: baseName };
const tagName = { pos: 4, end: 12, kind: 80, flags: 16777216, modifierFlagsCache: 0, transformFlags: 0, parent: comment, escapedText: 'augments', symbol };
const actual = { pos: 3, end: 18, kind: 329, flags: 16777216, modifierFlagsCache: 0, transformFlags: 0, parent: comment, tagName, class: heritage };
const base: Base = actual;
function heritageName(node: JSDocAugmentsTag): boolean {
 const heritage = node.class;
 const name = node.class.expression;
 return heritage.end >= name.end;
}
function emitHeritage(tag: JSDocImplementsTag | JSDocAugmentsTag): boolean {
 const heritage = tag.class;
 return heritage.end > heritage.pos;
}
const augmentsTag = base as JSDocAugmentsTag;
console.log(`${heritageName(augmentsTag)} ${emitHeritage(augmentsTag)}`);
