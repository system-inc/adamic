interface Extra { readonly common: number }
interface First { readonly first: boolean }
interface Second { readonly second: boolean }
interface Box { readonly value: object }
interface Target extends Box { readonly value: (First & Extra) | (Second & Extra) }
const actual = { kind: 1, first: true, common: true };
const box: Box = { value: actual };
const view = box as Target;
const root = view.value;
console.log(`${root === root}`);
