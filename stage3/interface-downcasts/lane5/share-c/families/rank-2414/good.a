// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface SourceMapEmitResult {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:SourceMapEmitResult[];}
function probe(value:Base):void {const sourceMapDataList=(value as Target).items;const witnessResult=sourceMapDataList.push({value:1});console.log(String(witnessResult));}
const seed:SourceMapEmitResult={value:1};probe({items:[seed]});
