// Original member declaration and read; adjacent carriers and bodies reduced.
type EntityName = Identifier | QualifiedName;
interface Identifier {readonly value:number;readonly kind:80;}
interface QualifiedName {readonly value:number;readonly kind:167;}
interface JSDocMemberName {readonly value:number;readonly kind:312;}
interface Base {readonly createJSDocMemberName:unknown;}
interface Target {createJSDocMemberName(left: EntityName | JSDocMemberName, right: Identifier): JSDocMemberName;}
function probe(value:Base):void {const factory=value as Target;const result=factory.createJSDocMemberName({value:3,kind:80},{value:3,kind:80});console.log("completed");}
probe({createJSDocMemberName:(): JSDocMemberName=>({value:3,kind:312})});
