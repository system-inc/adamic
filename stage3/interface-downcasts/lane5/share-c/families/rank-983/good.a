// Original member declaration and read; adjacent carriers and bodies reduced.
interface SatisfiesExpression {readonly value:number;readonly kind:239;}
interface Expression {readonly value:number;}
interface TypeNode {readonly value:number;}
interface Base {readonly updateSatisfiesExpression:unknown;}
interface Target {updateSatisfiesExpression(node: SatisfiesExpression, expression: Expression, type: TypeNode): SatisfiesExpression;}
function probe(value:Base):void {const context={factory:value as Target};const result=context.factory.updateSatisfiesExpression({value:3,kind:239},{value:3},{value:3});console.log("completed");}
probe({updateSatisfiesExpression:(node: SatisfiesExpression,expression: Expression,type: TypeNode):SatisfiesExpression=>({value:3,kind:239})});
