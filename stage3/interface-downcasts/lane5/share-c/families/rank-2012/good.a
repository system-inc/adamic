// Original member declaration and read; adjacent carriers and bodies reduced.
interface TypeNode {readonly value:number;}
interface Expression {readonly value:number;}
interface TypeAssertion {readonly value:number;readonly kind:217;}
interface Base {readonly createTypeAssertion:unknown;}
interface Target {createTypeAssertion(type: TypeNode, expression: Expression): TypeAssertion;}
function probe(value:Base):void {const factory=value as Target;const result=factory.createTypeAssertion({value:3},{value:3});console.log("completed");}
probe({createTypeAssertion:(type: TypeNode,expression: Expression):TypeAssertion=>({value:3,kind:217})});
