// Original Map receiver, member declaration and read; adjacent payload interfaces reduced.

interface OriginalMember<K,V> {get(key: K): V | undefined;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, number>;}
function probe(value:Base):void {const counts=(value as Target).items;counts.get("missing");console.log("completed");}
const sourceMap:Map<string,number>=new Map<string,number>();probe({items:sourceMap});
