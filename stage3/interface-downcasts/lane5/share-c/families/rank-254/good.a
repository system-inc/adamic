// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface SourceFile {readonly value:number;readonly kind:308;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:SourceFile[];}
function probe(value:Base):void {const modifiedSourceFiles=(value as Target).items;const witnessResult=modifiedSourceFiles.push({value:1,kind:308});console.log(String(witnessResult));}
const seed:SourceFile={value:1,kind:308};probe({items:[seed]});
