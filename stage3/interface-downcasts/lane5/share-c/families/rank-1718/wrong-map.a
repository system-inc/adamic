// Original Map receiver, declaration, aliases and read; adjacent interfaces reduced.
type CommandLineOption = CommandLineOptionOfCustomType | CommandLineOptionOfStringType | CommandLineOptionOfNumberType | CommandLineOptionOfBooleanType | TsConfigOnlyOption | CommandLineOptionOfListType;
interface CommandLineOptionOfCustomType {readonly value:number;}
interface CommandLineOptionOfStringType {readonly value:number;}
interface CommandLineOptionOfNumberType {readonly value:number;}
interface CommandLineOptionOfBooleanType {readonly value:number;}
interface TsConfigOnlyOption {readonly value:number;}
interface CommandLineOptionOfListType {readonly value:number;}
interface OriginalMember<K,V> {has(key: K): boolean;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, CommandLineOption>;}
function probe(value:Base):void {const optionsNameMap=(value as Target).items;optionsNameMap.has("missing");console.log("completed");}
const sourceMap:Map<string,boolean>=new Map<string,boolean>();probe({items:sourceMap});
