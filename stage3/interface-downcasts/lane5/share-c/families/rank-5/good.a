// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface Statement {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Statement[];}
function probe(value:Base):void {const target=(value as Target).items;const witnessResult=target.push({value:1});console.log(String(witnessResult));}
const seed:Statement={value:1};probe({items:[seed]});
