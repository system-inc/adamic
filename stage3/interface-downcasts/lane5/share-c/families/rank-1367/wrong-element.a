// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface DependencyGroup {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:DependencyGroup[];}
function probe(value:Base):void {const dependencyGroups=(value as Target).items;const witnessResult=dependencyGroups.push({value:1});console.log(String(witnessResult));}
probe({items:[{value:"bad"}]});
