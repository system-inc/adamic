// Original member declaration and read; adjacent carriers and bodies reduced.
interface BreakStatement {readonly value:number;readonly kind:253;}
interface Identifier {readonly value:number;readonly kind:80;}
interface Base {readonly updateBreakStatement:unknown;}
interface Target {updateBreakStatement(node: BreakStatement, label: Identifier | undefined): BreakStatement;}
function probe(value:Base):void {const context={factory:value as Target};const result=context.factory.updateBreakStatement({value:3,kind:253},{value:3,kind:80});console.log("completed");}
probe({updateBreakStatement:(node: BreakStatement,label: Identifier | undefined):BreakStatement=>({value:3,kind:253})});
