// Original member declaration and read; adjacent carriers and bodies reduced.
interface Diagnostic {readonly value:number;}
type DiagnosticReporter = (diagnostic: Diagnostic) => void;
interface Base {readonly reportDiagnostic:unknown;}
interface Target {reportDiagnostic: DiagnosticReporter;}
function probe(value:Base):void {const state=value as Target;state.reportDiagnostic({value:3});console.log("completed");}
probe({reportDiagnostic:(): void=>{}});
