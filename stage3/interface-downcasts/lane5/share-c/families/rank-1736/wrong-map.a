// Original Map receiver, member declaration and read; adjacent payload interfaces reduced.
interface ExtendedConfigCacheEntry {readonly value:number;}
interface OriginalMember<K,V> {delete(key: K): boolean;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, ExtendedConfigCacheEntry>;}
function probe(value:Base):void {const extendedConfigCache=(value as Target).items;extendedConfigCache.delete("missing");console.log("completed");}
const sourceMap:Map<string,boolean>=new Map<string,boolean>();probe({items:sourceMap});
