// Original member declaration and read; adjacent carriers and bodies reduced.
interface Identifier {readonly value:number;readonly kind:80;}
interface Declaration {readonly value:number;}
interface Base {readonly getReferencedDeclarationWithCollidingName:unknown;}
interface Target {getReferencedDeclarationWithCollidingName(node: Identifier): Declaration | undefined;}
function probe(value:Base):void {const resolver=value as Target;const result=resolver.getReferencedDeclarationWithCollidingName({value:3,kind:80});console.log("completed");}
probe({getReferencedDeclarationWithCollidingName:(node: Identifier):Declaration | undefined=>({value:3})});
