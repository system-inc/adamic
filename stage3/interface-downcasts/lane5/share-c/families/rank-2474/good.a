interface Base {readonly serializeReturnTypeForSignature:unknown;}
interface Target {serializeReturnTypeForSignature(context: SyntacticTypeNodeBuilderContext, signatureDeclaration: SignatureDeclaration | JSDocSignature, symbol: Symbol | undefined): TypeNode | undefined;}
function probe(value:Base):void {const resolver=value as Target;const result=resolver.serializeReturnTypeForSignature({value:3},{value:3,kind:180},{value:3});console.log("completed");}
