// Original member declaration and read; adjacent carriers and bodies reduced.
interface Diagnostic {readonly value:number;}
type DiagnosticReporter = (diagnostic: Diagnostic) => void;
interface Base {readonly onUnRecoverableConfigFileDiagnostic:unknown;}
interface Target {onUnRecoverableConfigFileDiagnostic: DiagnosticReporter;}
function probe(value:Base):void {const host=value as Target;host.onUnRecoverableConfigFileDiagnostic({value:3});console.log("completed");}
probe({onUnRecoverableConfigFileDiagnostic:(diagnostic: Diagnostic):void=>{}});
