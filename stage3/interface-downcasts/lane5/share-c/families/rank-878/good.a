// Original Map receiver, member declaration and read; adjacent payload interfaces reduced.
interface MutableFileSystemEntries {readonly value:number;}
interface OriginalMember<K,V> {has(key: K): boolean;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, false | MutableFileSystemEntries>;}
function probe(value:Base):void {const cachedReadDirectoryResult=(value as Target).items;cachedReadDirectoryResult.has("missing");console.log("completed");}
const sourceMap:Map<string,false | MutableFileSystemEntries>=new Map<string,false | MutableFileSystemEntries>();probe({items:sourceMap});
