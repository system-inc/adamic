// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface TextSpan {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:TextSpan[];}
function probe(value:Base):void {const result=(value as Target).items;const witnessResult=result.push({value:1});console.log(String(witnessResult));}
const seed:TextSpan={value:1};probe({items:[seed]});
