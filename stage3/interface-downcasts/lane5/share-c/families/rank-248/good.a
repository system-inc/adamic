interface Base {readonly updateForInStatement:unknown;}
interface Target {updateForInStatement(node: ForInStatement, initializer: ForInitializer, expression: Expression, statement: Statement): ForInStatement;}
function probe(value:Base):void {const context={factory:value as Target};const result=context.factory.updateForInStatement({value:3,kind:250},{value:3,kind:262},{value:3},{value:3});console.log("completed");}
probe({updateForInStatement:(node: ForInStatement,initializer: ForInitializer,expression: Expression,statement: Statement):ForInStatement=>({value:3,kind:250})});
