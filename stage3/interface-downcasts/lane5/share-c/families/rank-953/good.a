// Original member declaration and read; adjacent carriers and bodies reduced.
interface Expression {readonly value:number;}
interface Statement {readonly value:number;}
interface WithStatement {readonly value:number;readonly kind:255;}
interface Base {readonly createWithStatement:unknown;}
interface Target {createWithStatement(expression: Expression, statement: Statement): WithStatement;}
function probe(value:Base):void {const factory=value as Target;const result=factory.createWithStatement({value:3},{value:3});console.log("completed");}
probe({createWithStatement:(expression: Expression,statement: Statement):WithStatement=>({value:3,kind:255})});
