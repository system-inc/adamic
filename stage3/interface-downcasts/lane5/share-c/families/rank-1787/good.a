// Original Map receiver, declaration and read; adjacent payload interfaces reduced.
interface StringMappingType {readonly value:number;}
interface OriginalMember<K,V> {get(key: K): V | undefined;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, StringMappingType>;}
function probe(value:Base):void {const stringMappingTypes=(value as Target).items;stringMappingTypes.get("missing");console.log("completed");}
const sourceMap:Map<string,StringMappingType>=new Map<string,StringMappingType>();probe({items:sourceMap});
