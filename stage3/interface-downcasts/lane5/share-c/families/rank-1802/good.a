// Original Map receiver, declaration and read; adjacent payload interfaces reduced.
interface Type {readonly value:number;}
interface OriginalMember<K,V> {has(key: K): boolean;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, Type>;}
function probe(value:Base):void {const typeSet=(value as Target).items;typeSet.has("missing");console.log("completed");}
const sourceMap:Map<string,Type>=new Map<string,Type>();probe({items:sourceMap});
