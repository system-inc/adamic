// Original Map receiver, declaration, aliases and read; adjacent interfaces reduced.
interface Symbol {readonly value:number;}
interface OriginalMember<K,V> {get(key: K): V | undefined;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<number, Symbol[]>;}
function probe(value:Base):void {const links={extendedContainersByFile:(value as Target).items};links.extendedContainersByFile.get(1);console.log("completed");}
