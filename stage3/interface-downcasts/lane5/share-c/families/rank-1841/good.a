// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface MappedPosition {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:MappedPosition[];}
function probe(value:Base):void {const list=(value as Target).items;const witnessResult=list.push({value:1});console.log(String(witnessResult));}
const seed:MappedPosition={value:1};probe({items:[seed]});
