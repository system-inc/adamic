// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface DiagnosticWithLocation {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:DiagnosticWithLocation[];}
function probe(value:Base):void {const diagnosticsWithLocation=(value as Target).items;const witnessResult=diagnosticsWithLocation.push({value:1});console.log(String(witnessResult));}
probe({items:[{value:"bad"}]});
