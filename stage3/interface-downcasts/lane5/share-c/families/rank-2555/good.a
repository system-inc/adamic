// Original Array.pop receiver and declaration; adjacent payload carriers reduced.
interface TypeElement {readonly value:number;}
interface OriginalMember<T> {pop(): T | undefined;}
interface Base {readonly items:unknown;}
interface Target {readonly items:TypeElement[];}
function probe(value:Base):void {const typeElements=(value as Target).items;typeElements.pop();console.log("completed");}
const seed:TypeElement={value:1};probe({items:[seed]});
