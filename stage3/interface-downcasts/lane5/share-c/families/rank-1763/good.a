// Original Map receiver, declaration, aliases and read; adjacent interfaces reduced.
interface ImportSpecifier {readonly value:number;readonly kind:277;}
interface OriginalMember<K,V> {get(key: K): V | undefined;}
interface Base {readonly items:unknown;}
interface Target {readonly items:Map<string, Map<string, ImportSpecifier>>;}
function probe(value:Base):void {const currentFileState={utilizedImplicitRuntimeImports:(value as Target).items};currentFileState.utilizedImplicitRuntimeImports.get("missing");console.log("completed");}
