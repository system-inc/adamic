// Original Array intrinsic member and receiver; adjacent payload interface reduced.
interface LoopOutParameter {readonly value:number;}
interface OriginalMember<T> {push(...items: T[]): number;}
interface Base {readonly items:unknown;}
interface Target {readonly items:LoopOutParameter[];}
function probe(value:Base):void {const loopOutParameters=(value as Target).items;const witnessResult=loopOutParameters.push({value:1});console.log(String(witnessResult));}
const seed:LoopOutParameter={value:1};probe({items:[seed]});
