// Original collection member declaration; adjacent receiver and carriers reduced.
interface Base {readonly has: unknown;}
interface Target<T> {has(value: T): boolean;}
function probe(value: Base | undefined): void {if(value===undefined){console.log("absent");return;}const viewed=value as Target<string>;const result=viewed?.has("inside");console.log("present");}
probe(new Set<string>(["inside"]));
probe(undefined);
