// Original member declaration and read; adjacent carriers and bodies reduced.
interface T {readonly value:number;}
type ResolutionMode = ModuleKind.ESNext | ModuleKind.CommonJS | undefined;
const enum ModuleKind {None=0,CommonJS=1,AMD=2,UMD=3,System=4,ES2015=5,ES2020=6,ES2022=7,ESNext=99,Node16=100,Node18=101,Node20=102,NodeNext=199,Preserve=200}
interface Base {readonly forEach:unknown;}
interface Target {forEach(cb: (elem: T, key: string, mode: ResolutionMode) => void): void;}
function probe(value:Base):void {const resolutions=value as Target;resolutions.forEach((elem: T,key: string,mode: ResolutionMode):void=>{});console.log("completed");}
probe({forEach:(cb: (elem: string, key: string, mode: ResolutionMode) => void):void=>{}});
