// Original member declaration and read; adjacent carriers and bodies reduced.
type DirectoryWatcherCallback = (fileName: string) => void;
interface WatchOptions {readonly value:number;}
interface FileWatcher {readonly value:number;}
interface Base {readonly watchDirectory:unknown;}
interface Target {watchDirectory(path: string, callback: DirectoryWatcherCallback, recursive?: boolean, options?: WatchOptions): FileWatcher;}
function probe(value:Base):void {const host=value as Target;const witnessResult=host.watchDirectory("abc",(fileName: string):void=>{},true,{value:3});console.log("completed");}
probe({watchDirectory:(path: string,callback: DirectoryWatcherCallback,recursive?: boolean,options?: WatchOptions):FileWatcher=>({value:3})});
