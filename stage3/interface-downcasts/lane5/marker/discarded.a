type AnyFunction = (...args: never[]) => void;
interface Base { readonly kind: 'debug' | 'other'; }
interface Debug extends Base { readonly kind: 'debug'; readonly shouldLog: () => boolean; }
function read(input: Base): void {
 const debug = input as Debug;
 (debug.shouldLog as AnyFunction)();
 console.log('called');
}
const input = {kind: 'debug' as const, shouldLog: (): boolean => { console.log('producer'); return true; }};
read(input);
