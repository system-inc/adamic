interface Node {readonly flags:number;}
type LazyNodeCheckFlags = number;
const NodeCheckFlags = {ContainsConstructorReference:1};
interface Base {readonly createVoidZero:unknown;}
interface Target {createVoidZero(): VoidExpression; }
function probe(value:Base):void {const factory=value as Target;const node = factory.createVoidZero(); console.log(`${node.expression.value}`);}
probe({createVoidZero:():VoidExpression=>({kind:"void",expression:{kind:"expression",value:0}})});
