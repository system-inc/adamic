// Original tsc member and read witness; adjacent helpers and data carriers reduced.
interface Expression {readonly kind:"expression";readonly value:number;}
interface ExpressionStatement {readonly kind:"statement";readonly expression:Expression;}
interface VoidExpression {readonly kind:"void";readonly expression:Expression;}
interface ThisExpression {readonly kind:"this";readonly value:number;}
interface Diagnostic {readonly messageText:string;}
interface EmitHelper {readonly name:string;}
interface Node {readonly flags:number;}
type LazyNodeCheckFlags = number;
const NodeCheckFlags = {ContainsConstructorReference:1};
interface Base {readonly requestEmitHelper:unknown;}
interface Target {requestEmitHelper(helper: EmitHelper): void; }
function probe(value:Base):void {const context=value as Target;const decorateHelper:EmitHelper={name:"decorate"};context.requestEmitHelper(decorateHelper);}
probe({requestEmitHelper:(helper:{readonly name:number}):void=>{console.log(`${helper.name}`);}});
