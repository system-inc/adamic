// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface Diagnostic {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<Diagnostic>;
function probe(value:Base):void {const errors=value as Target;errors.push({value:7});console.log("done");}
probe([]);
