// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface DiagnosticRelatedInformation {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<DiagnosticRelatedInformation>;
function probe(value:Base):void {const diagnosticWithLocation={relatedInformation:value as Target};diagnosticWithLocation.relatedInformation.push({value:7});console.log("done");}
probe([]);
