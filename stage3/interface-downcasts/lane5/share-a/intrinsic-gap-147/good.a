// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface Node {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<Node>;
function probe(value:Base):void {const sourceFile={value:7};const getOrCreateEmitNode=(node:{readonly value:number}):{annotatedNodes:Target}=>({annotatedNodes:value as Target});getOrCreateEmitNode(sourceFile).annotatedNodes!.push({value:7});console.log("done");}
probe([]);
