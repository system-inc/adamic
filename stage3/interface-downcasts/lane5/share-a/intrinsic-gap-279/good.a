// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface JSDocComment {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<JSDocComment>;
function probe(value:Base):void {const parts=value as Target;parts.push({value:7});console.log("done");}
probe([]);
