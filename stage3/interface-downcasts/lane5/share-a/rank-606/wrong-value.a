// Original declaration and member read; adjacent carriers and producer bodies reduced.
interface LabeledStatement {readonly value:number;readonly kind:257;}
interface Identifier {readonly value:number;readonly kind:80;}
interface Statement {readonly value:number;}
interface Base {readonly updateLabeledStatement:unknown;}
interface Target {updateLabeledStatement(node: LabeledStatement, label: Identifier, statement: Statement): LabeledStatement;}
function probe(value:Base):void {const context={factory:value as Target};console.log(`${context.factory.updateLabeledStatement({value:7,kind:257},{value:7,kind:80},{value:7}).value}`);}
probe({updateLabeledStatement:7});
