// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface Type {readonly value:number;}
interface Base {readonly set:unknown;}
interface Carrier<K,V> {set(key: K, value: V): this;}
type Target=Carrier<string, Type>;
function probe(value:Base):void {const cachedTypes=value as Target;cachedTypes.set("ok",{value:7});console.log("done");}
probe(new Map<string,Type>());
