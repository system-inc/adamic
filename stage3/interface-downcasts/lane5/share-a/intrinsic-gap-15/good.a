// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface Expression {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<Expression>;
function probe(value:Base):void {const argumentsArray=value as Target;argumentsArray.push({value:7});console.log("done");}
probe([]);
