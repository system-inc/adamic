// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface VariableDeclaration {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<VariableDeclaration>;
function probe(value:Base):void {const declarations=value as Target;declarations.push({value:7});console.log("done");}
probe([]);
