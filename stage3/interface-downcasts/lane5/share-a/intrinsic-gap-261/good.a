// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface Statement {readonly value:number;}
interface Base {readonly slice:unknown;}
interface Carrier<T> {slice(start?: number, end?: number): T[];}
type Target=Carrier<Statement>;
function probe(value:Base):void {const declarations=value as Target;declarations.slice(0);console.log("done");}
probe([]);
