// Original declaration and member read; adjacent carriers and producer bodies reduced.
interface CommaListExpression {readonly value:number;}
interface Expression {readonly value:number;}
interface Base {readonly updateCommaListExpression:unknown;}
interface Target {updateCommaListExpression(node: CommaListExpression, elements: readonly Expression[]): CommaListExpression;}
function probe(value:Base):void {const context={factory:value as Target};console.log(`${context.factory.updateCommaListExpression({value:3},[{value:4}]).value}`);}
probe({updateCommaListExpression:():CommaListExpression=>({value:7})});
