// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface TypeNode {readonly value:number;}
interface Base {readonly push:unknown;}
interface Carrier<T> {push(...items: T[]): number;}
type Target=Carrier<TypeNode>;
function probe(value:Base):void {const types=value as Target;types.push({value:7});console.log("done");}
probe([]);
