// Original intrinsic member and read; actual built-in receiver, reduced adjacent carriers.
interface Base {readonly map:unknown;}
interface Carrier<T> {map<U>(callbackfn: (value: T, index: number, array: readonly T[]) => U, thisArg?: any): U[];}
type Target=Carrier<string>;
function probe(value:Base):void {const patterns=value as Target;patterns.map((value:string):string=>value);console.log("done");}
probe(["ok"]);
