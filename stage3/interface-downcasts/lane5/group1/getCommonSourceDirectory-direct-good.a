interface Base { readonly kind: 'program' | 'other'; }
interface Program extends Base { readonly kind: 'program'; readonly getCommonSourceDirectory: () => string; readonly unread: <T>(value: T) => T; }
function viewed(value: Base): Program { return value as Program; }
function read(p: Program): string { return p.getCommonSourceDirectory(); }
const raw = {kind: 'program' as const, getCommonSourceDirectory: (): string => '/here'};
console.log(read(viewed(raw)));
