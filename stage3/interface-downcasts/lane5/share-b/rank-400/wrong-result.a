// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface Base {readonly createMetadataHelper:unknown;}
interface Target {createMetadataHelper(metadataKey: string, metadataValue: Expression): Expression;}
function probe(value:Base):void {function emitHelpers():Target {return value as Target;}console.log(`${emitHelpers().createMetadataHelper("value3",{value:3}).value}`);}
probe({createMetadataHelper:(metadataKey: string, metadataValue: Expression):number=>9});
