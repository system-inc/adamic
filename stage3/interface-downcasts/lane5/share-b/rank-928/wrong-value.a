// Original declaration and read; adjacent data carriers reduced.
interface TypeNode { readonly value: number; }
interface JSDocNullableType { readonly value: number; }
interface Base {readonly createJSDocNullableType:unknown;}
interface Target {createJSDocNullableType(type: TypeNode, postfix?: boolean): JSDocNullableType;}
