// Original declaration and read; adjacent data carriers reduced.
interface ParameterDeclaration { readonly value: number; }
interface TypeNode { readonly value: number; }
interface JSDocFunctionType { readonly value: number; }
interface Base {readonly createJSDocFunctionType:unknown;}
interface Target {createJSDocFunctionType(parameters: readonly ParameterDeclaration[], type: TypeNode | undefined): JSDocFunctionType;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createJSDocFunctionType([{value:3}],{value:3}).value}`);}
probe({createJSDocFunctionType:(parameters:number,type:number):JSDocFunctionType=>{return {value:3};}});
