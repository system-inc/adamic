// Original declaration and read; adjacent data carriers reduced.
interface ExternalModuleReference { readonly value: number; }
interface Expression { readonly value: number; }
interface Base {readonly updateExternalModuleReference:unknown;}
interface Target {updateExternalModuleReference(node: ExternalModuleReference, expression: Expression): ExternalModuleReference;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateExternalModuleReference({value:3},{value:3}).value}`);}
probe({updateExternalModuleReference:(node: ExternalModuleReference, expression: Expression):number=>9});
