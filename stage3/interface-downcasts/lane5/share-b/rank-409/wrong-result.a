// Original declaration and read; adjacent data carriers reduced.
interface ResolvedProjectReference { readonly value: number; }
interface Base {readonly getResolvedProjectReferences:unknown;}
interface Target {getResolvedProjectReferences(): readonly (ResolvedProjectReference | undefined)[] | undefined;}
function probe(value:Base):void {const host=value as Target;const result=host.getResolvedProjectReferences();if (result !== undefined) {for (const element of result) {if (element !== undefined) {console.log(`${element.value}`);}}}}
probe({getResolvedProjectReferences:():number=>9});
