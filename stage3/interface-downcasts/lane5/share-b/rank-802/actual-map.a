function probe(value:Base):void {const optionsToRedirectsKey=value as Target<CompilerOptions,RedirectsCacheKey>;optionsToRedirectsKey.get({value:3});console.log("called");}
probe(new Map<CompilerOptions,RedirectsCacheKey>());
