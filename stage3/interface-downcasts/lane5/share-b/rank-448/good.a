// Original declaration and read; adjacent data carriers reduced.
interface ArrowFunction { readonly value: number; }
interface Modifier { readonly value: number; }
interface TypeParameterDeclaration { readonly value: number; }
interface ParameterDeclaration { readonly value: number; }
interface TypeNode { readonly value: number; }
interface EqualsGreaterThanToken { readonly value: number; }
interface ConciseBody { readonly value: number; }
interface Base {readonly updateArrowFunction:unknown;}
interface Target {updateArrowFunction(node: ArrowFunction, modifiers: readonly Modifier[] | undefined, typeParameters: readonly TypeParameterDeclaration[] | undefined, parameters: readonly ParameterDeclaration[], type: TypeNode | undefined, equalsGreaterThanToken: EqualsGreaterThanToken, body: ConciseBody): ArrowFunction;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateArrowFunction({value:3},[{value:3}],[{value:3}],[{value:3}],{value:3},{value:3},{value:3}).value}`);}
probe({updateArrowFunction:(node: ArrowFunction, modifiers: readonly Modifier[] | undefined, typeParameters: readonly TypeParameterDeclaration[] | undefined, parameters: readonly ParameterDeclaration[], type: TypeNode | undefined, equalsGreaterThanToken: EqualsGreaterThanToken, body: ConciseBody):ArrowFunction=>{console.log(`${node.value}`);if (modifiers !== undefined) {for (const element of modifiers) {console.log(`${element.value}`);}}if (typeParameters !== undefined) {for (const element of typeParameters) {console.log(`${element.value}`);}}for (const element of parameters) {console.log(`${element.value}`);}if (type !== undefined) {console.log(`${type.value}`);}console.log(`${equalsGreaterThanToken.value}`);console.log(`${body.value}`);return {value:3};}});
