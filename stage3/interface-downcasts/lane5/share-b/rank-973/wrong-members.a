// Original declaration and read; adjacent data carriers reduced.
interface JsxOpeningElement { readonly value: number; }
interface JsxTagNameExpression { readonly value: number; }
interface TypeNode { readonly value: number; }
interface JsxAttributes { readonly value: number; }
interface Base {readonly updateJsxOpeningElement:unknown;}
interface Target {updateJsxOpeningElement(node: JsxOpeningElement, tagName: JsxTagNameExpression, typeArguments: readonly TypeNode[] | undefined, attributes: JsxAttributes): JsxOpeningElement;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateJsxOpeningElement({value:3},{value:3},[{value:3}],{value:3}).value}`);}
probe({updateJsxOpeningElement:(node:number,tagName:number,typeArguments:number,attributes:number):JsxOpeningElement=>{return {value:3};}});
