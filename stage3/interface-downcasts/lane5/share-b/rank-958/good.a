// Original declaration and read; adjacent data carriers reduced.
interface AsExpression { readonly value: number; }
interface Expression { readonly value: number; }
interface TypeNode { readonly value: number; }
interface Base {readonly updateAsExpression:unknown;}
interface Target {updateAsExpression(node: AsExpression, expression: Expression, type: TypeNode): AsExpression;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateAsExpression({value:3},{value:3},{value:3}).value}`);}
probe({updateAsExpression:(node: AsExpression, expression: Expression, type: TypeNode):AsExpression=>{console.log(`${node.value}`);console.log(`${expression.value}`);console.log(`${type.value}`);return {value:3};}});
