// Original declaration and read; adjacent data carriers reduced.
interface Identifier { readonly value: number; }
interface PropertyAccessExpression { readonly value: number; }
interface Base {readonly getNamespaceMemberName:unknown;}
interface Target {getNamespaceMemberName(ns: Identifier, name: Identifier, allowComments?: boolean, allowSourceMaps?: boolean): PropertyAccessExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.getNamespaceMemberName({value:3},{value:3},true,true).value}`);}
probe({getNamespaceMemberName:(ns: Identifier, name: Identifier, allowComments?: boolean, allowSourceMaps?: boolean):PropertyAccessExpression=>{console.log(`${ns.value}`);console.log(`${name.value}`);console.log(`${allowComments}`);console.log(`${allowSourceMaps}`);return {value:3};}});
