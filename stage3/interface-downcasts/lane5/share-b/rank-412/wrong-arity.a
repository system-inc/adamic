// Original declaration and read; adjacent data carriers reduced.
interface GenericType { readonly value: number; }
interface Base {readonly getGlobalIterableIteratorType:unknown;}
interface Target {getGlobalIterableIteratorType: (reportErrors: boolean) => GenericType;}
function probe(value:Base):void {const resolver=value as Target;console.log(`${resolver.getGlobalIterableIteratorType(true).value}`);}
probe({getGlobalIterableIteratorType:():GenericType=>{return {value:3};}});
