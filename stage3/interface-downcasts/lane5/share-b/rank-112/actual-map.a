// Original member/read with an actual Map receiver.
interface Base {readonly get:unknown;}
interface Target<K,V> {get(key: K): V | undefined;}
function probe(value:Base):void {const usedLines=value as Target<string,boolean>;console.log(`${usedLines.get("value3")}`);}
const map=new Map<string,boolean>();map.set("value3",true);probe(map);
