function probe(value:Base):void {const flattenContext={context:{getEmitHelperFactory:():Target=>value as Target}};console.log(`${flattenContext.context.getEmitHelperFactory().createRestHelper({value:3},[{value:3}],[{value:3}],{value:3}).value}`);}
probe({createRestHelper:(value: Expression, elements: readonly BindingOrAssignmentElement[], computedTempVariables: readonly Expression[] | undefined, location: TextRange):number=>9});
