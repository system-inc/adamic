// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface CallExpression { readonly value: number; }
interface Base {readonly createGlobalMethodCall:unknown;}
interface Target {createGlobalMethodCall(globalObjectName: string, globalMethodName: string, argumentsList: readonly Expression[]): CallExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createGlobalMethodCall("value3","value3",[{value:3}]).value}`);}
probe({createGlobalMethodCall:(globalObjectName: string, globalMethodName: string, argumentsList: readonly Expression[]):CallExpression=>{console.log(globalObjectName);console.log(globalMethodName);for (const element of argumentsList) {console.log(`${element.value}`);}return {value:3};}});
