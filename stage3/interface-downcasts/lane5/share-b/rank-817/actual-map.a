// Original Map declaration/read; original primitive aliases retained.
type Path = string & { __pathBrand: any; };
interface PackageDirWatcher {readonly value:number;}
interface Base {readonly get:unknown;}
interface Target<K,V> {get(key: K): V | undefined;}
function probe(value:Base):void {const packageDirWatchers=value as Target<Path,PackageDirWatcher>;packageDirWatchers.get("key" as Path);console.log("called");}
probe(new Map<Path,PackageDirWatcher>());
