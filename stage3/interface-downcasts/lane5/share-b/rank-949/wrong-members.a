// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface TemplateMiddle { readonly value: number; }
interface TemplateTail { readonly value: number; }
interface TemplateSpan { readonly value: number; }
interface Base {readonly createTemplateSpan:unknown;}
interface Target {createTemplateSpan(expression: Expression, literal: TemplateMiddle | TemplateTail): TemplateSpan;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createTemplateSpan({value:3},{value:3}).value}`);}
probe({createTemplateSpan:(expression:number,literal:number):TemplateSpan=>{return {value:3};}});
