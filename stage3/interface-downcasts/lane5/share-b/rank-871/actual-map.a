// Original Map declaration/read; original primitive aliases retained.

interface SourceFile {readonly value:number;}
interface Base {readonly set:unknown;}
interface Target<K,V> {set(key: K, value: V): this;}
function probe(value:Base):void {const packageIdToSourceFile=value as Target<string,SourceFile>;packageIdToSourceFile.set("key",{value:3});console.log("called");}
probe(new Map<string,SourceFile>());
