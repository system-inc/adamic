// Original declaration, read, key aliases, and collection result carrier.

interface Symbol {readonly value:number;}
interface Base {readonly set:unknown;}
interface Target<K,V> {set(key: K, value: V): this;}
function probe(value:Base):void {const context={remappedSymbolReferences:value as Target<number,Symbol>};context.remappedSymbolReferences.set(3,{value:3});console.log("called");}
probe(new Map<number,Symbol>());
