// Original tracing declarations; false default represented as optional boolean.
interface Args {
        [key: string]: string | number | boolean | null | undefined | Args | readonly (string | number | boolean | null | undefined | Args)[]; // eslint-disable-line no-restricted-syntax
    }
enum Phase {
        Parse = "parse",
        Program = "program",
        Bind = "bind",
        Check = "check", // Before we get into checking types (e.g. checkSourceFile)
        CheckTypes = "checkTypes",
        Emit = "emit",
        Session = "session",
    }
interface Base {readonly instant:unknown;}
interface Target {readonly instant: (phase: Phase, name: string, args?: Args) => void;}
function probe(value:Base):void {const tracing:Target=value as Target;console.log(typeof tracing?.instant);}
probe({instant:7});
