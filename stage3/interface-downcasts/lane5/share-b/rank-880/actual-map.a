// Original Map declaration/read; original primitive aliases retained.

interface Base {readonly forEach:unknown;}
interface Target<K,V> {forEach(callbackfn: (value: V, key: K, map: Map<K, V>) => void, thisArg?: any): void;}
function probe(value:Base):void {const durations=value as Target<string,number>;durations.forEach((item:number,key:string,map:Map<string,number>):void=>{});console.log("called");}
probe(new Map<string,number>());
