// Original Map declaration/read; original primitive aliases retained.
type Path = string & { __pathBrand: any; };
interface Base {readonly delete:unknown;}
interface Target<K,V> {delete(key: K): boolean;}
function probe(value:Base):void {const fileExistsCache=value as Target<Path,boolean>;fileExistsCache.delete("key" as Path);console.log("called");}
probe(new Map<Path,boolean>());
