// Original declaration and read; adjacent data carriers reduced.
interface Modifier { readonly value: number; }
interface PropertyName { readonly value: number; }
interface QuestionToken { readonly value: number; }
interface TypeParameterDeclaration { readonly value: number; }
interface ParameterDeclaration { readonly value: number; }
interface TypeNode { readonly value: number; }
interface MethodSignature { readonly value: number; }
interface Base {readonly createMethodSignature:unknown;}
interface Target {createMethodSignature(modifiers: readonly Modifier[] | undefined, name: string | PropertyName, questionToken: QuestionToken | undefined, typeParameters: readonly TypeParameterDeclaration[] | undefined, parameters: readonly ParameterDeclaration[], type: TypeNode | undefined): MethodSignature;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createMethodSignature([{value:3}],{value:3},{value:3},[{value:3}],[{value:3}],{value:3}).value}`);}
probe({createMethodSignature:(modifiers: readonly Modifier[] | undefined, name: string | PropertyName, questionToken: QuestionToken | undefined, typeParameters: readonly TypeParameterDeclaration[] | undefined, parameters: readonly ParameterDeclaration[], type: TypeNode | undefined):MethodSignature=>{if (modifiers !== undefined) {for (const element of modifiers) {console.log(`${element.value}`);}}if (typeof name === "string") {console.log(name);} else {console.log(`${name.value}`);}if (questionToken !== undefined) {console.log(`${questionToken.value}`);}if (typeParameters !== undefined) {for (const element of typeParameters) {console.log(`${element.value}`);}}for (const element of parameters) {console.log(`${element.value}`);}if (type !== undefined) {console.log(`${type.value}`);}return {value:3};}});
