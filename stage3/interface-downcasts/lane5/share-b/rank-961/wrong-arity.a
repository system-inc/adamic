// Original declaration and read; adjacent data carriers reduced.
interface ConditionalExpression { readonly value: number; }
interface Expression { readonly value: number; }
interface QuestionToken { readonly value: number; }
interface ColonToken { readonly value: number; }
interface Base {readonly updateConditionalExpression:unknown;}
interface Target {updateConditionalExpression(node: ConditionalExpression, condition: Expression, questionToken: QuestionToken, whenTrue: Expression, colonToken: ColonToken, whenFalse: Expression): ConditionalExpression;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateConditionalExpression({value:3},{value:3},{value:3},{value:3},{value:3},{value:3}).value}`);}
probe({updateConditionalExpression:():ConditionalExpression=>{return {value:3};}});
