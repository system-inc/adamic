// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface BinaryExpression { readonly value: number; }
interface Base {readonly createLogicalOr:unknown;}
interface Target {createLogicalOr(left: Expression, right: Expression): BinaryExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createLogicalOr({value:3},{value:3}).value}`);}
probe({createLogicalOr:(left: Expression, right: Expression):BinaryExpression=>{console.log(`${left.value}`);console.log(`${right.value}`);return {value:3};}});
