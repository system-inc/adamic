// Original declaration and read; adjacent data carriers reduced.
interface HeritageClause { readonly value: number; }
interface ExpressionWithTypeArguments { readonly value: number; }
interface Base {readonly updateHeritageClause:unknown;}
interface Target {updateHeritageClause(node: HeritageClause, types: readonly ExpressionWithTypeArguments[]): HeritageClause;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateHeritageClause({value:3},[{value:3}]).value}`);}
probe({updateHeritageClause:(node: HeritageClause, types: readonly ExpressionWithTypeArguments[]):HeritageClause=>{console.log(`${node.value}`);for (const element of types) {console.log(`${element.value}`);}return {value:3};}});
