// Original declaration and read; adjacent data carriers reduced.
interface CaseOrDefaultClause { readonly value: number; }
interface CaseBlock { readonly value: number; }
interface Base {readonly createCaseBlock:unknown;}
interface Target {createCaseBlock(clauses: readonly CaseOrDefaultClause[]): CaseBlock;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createCaseBlock([{value:3}]).value}`);}
probe({createCaseBlock:(clauses: readonly CaseOrDefaultClause[]):number=>9});
