// Original declaration and read; adjacent data carriers reduced.
interface Identifier { readonly value: number; }
interface Expression { readonly value: number; }
interface PropertyAccessExpression { readonly value: number; }
interface Base {readonly createAssignmentTargetWrapper:unknown;}
interface Target {createAssignmentTargetWrapper(paramName: Identifier, expression: Expression): PropertyAccessExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createAssignmentTargetWrapper({value:3},{value:3}).value}`);}
probe({createAssignmentTargetWrapper:(paramName: Identifier, expression: Expression):PropertyAccessExpression=>{console.log(`${paramName.value}`);console.log(`${expression.value}`);return {value:3};}});
