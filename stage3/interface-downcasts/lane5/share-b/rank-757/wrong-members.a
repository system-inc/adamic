// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface Base {readonly createValuesHelper:unknown;}
interface Target {createValuesHelper(expression: Expression): Expression;}
function probe(value:Base):void {function emitHelpers():Target {return value as Target;}console.log(`${emitHelpers().createValuesHelper({value:3}).value}`);}
probe({createValuesHelper:(expression:number):Expression=>{return {value:3};}});
