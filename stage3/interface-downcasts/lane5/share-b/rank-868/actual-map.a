// Original Map declaration/read; original primitive aliases retained.

interface HostFileInfo {readonly value:number;}
interface Base {readonly delete:unknown;}
interface Target<K,V> {delete(key: K): boolean;}
function probe(value:Base):void {const sourceFilesCache=value as Target<string,HostFileInfo>;sourceFilesCache.delete("key");console.log("called");}
probe(new Map<string,HostFileInfo>());
