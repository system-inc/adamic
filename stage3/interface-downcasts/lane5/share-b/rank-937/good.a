// Original declaration and read; adjacent data carriers reduced.
interface Identifier { readonly value: number; }
interface NamespaceExportDeclaration { readonly value: number; }
interface Base {readonly createNamespaceExportDeclaration:unknown;}
interface Target {createNamespaceExportDeclaration(name: string | Identifier): NamespaceExportDeclaration;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createNamespaceExportDeclaration({value:3}).value}`);}
probe({createNamespaceExportDeclaration:(name: string | Identifier):NamespaceExportDeclaration=>{if (typeof name === "string") {console.log(name);} else {console.log(`${name.value}`);}return {value:3};}});
