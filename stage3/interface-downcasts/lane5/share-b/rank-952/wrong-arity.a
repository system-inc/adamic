// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface TypeOfExpression { readonly value: number; }
interface Base {readonly createTypeOfExpression:unknown;}
interface Target {createTypeOfExpression(expression: Expression): TypeOfExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createTypeOfExpression({value:3}).value}`);}
probe({createTypeOfExpression:():TypeOfExpression=>{return {value:3};}});
