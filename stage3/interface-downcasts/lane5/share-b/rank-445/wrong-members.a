// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface ThrowStatement { readonly value: number; }
interface Base {readonly createThrowStatement:unknown;}
interface Target {createThrowStatement(expression: Expression): ThrowStatement;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createThrowStatement({value:3}).value}`);}
probe({createThrowStatement:(expression:number):ThrowStatement=>{return {value:3};}});
