// Original array declaration/read; adjacent elements reduced.
interface SourceFile {readonly value:number;}
interface Base {readonly indexOf:unknown;}
interface Target<T> {indexOf(searchElement: T, fromIndex?: number): number;}
function probe(value:Base):void {const sourceFiles=value as Target<SourceFile>;sourceFiles.indexOf({value:3});console.log("called");}
probe([{value:3},{value:4}]);
