// Original Map declaration/read; original primitive aliases retained.
type Path = string & { __pathBrand: any; };
type ResolvedConfigFileName = string & { _isResolvedConfigFileName: never; };
type ResolvedConfigFilePath = ResolvedConfigFileName & Path;
enum ProgramUpdateLevel {
    /** Program is updated with same root file names and options */
    Update,
    /** Loads program after updating root file names from the disk */
    RootNamesAndUpdate,
    /**
     * Loads program completely, including:
     *  - re-reading contents of config file from disk
     *  - calculating root file names for the program
     *  - Updating the program
     */

    Full,
}
interface Base {readonly set:unknown;}
interface Target<K,V> {set(key: K, value: V): this;}
function probe(value:Base):void {const projectPendingBuild=value as Target<ResolvedConfigFilePath,ProgramUpdateLevel>;projectPendingBuild.set("key" as ResolvedConfigFilePath,ProgramUpdateLevel.Update);console.log("called");}
probe(new Map<ResolvedConfigFilePath,ProgramUpdateLevel>());
