// Original declaration and read; adjacent data carriers reduced.
interface ReturnStatement { readonly value: number; }
interface Expression { readonly value: number; }
interface Base {readonly updateReturnStatement:unknown;}
interface Target {updateReturnStatement(node: ReturnStatement, expression: Expression | undefined): ReturnStatement;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateReturnStatement({value:3},{value:3}).value}`);}
probe({updateReturnStatement:(node:number,expression:number):ReturnStatement=>{return {value:3};}});
