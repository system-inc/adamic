// Original declaration and read; adjacent data carriers reduced.
interface CompilerOptions { readonly value: number; }
interface Base {readonly getDefaultLibFileName:unknown;}
interface Target {getDefaultLibFileName(options: CompilerOptions): string;}
function probe(value:Base):void {const host=value as Target;console.log(host.getDefaultLibFileName({value:3}));}
probe({getDefaultLibFileName:(options: CompilerOptions):string=>{console.log(`${options.value}`);return "answer3";}});
