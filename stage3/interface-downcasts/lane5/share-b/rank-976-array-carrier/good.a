// Original declaration and read; adjacent data carriers reduced.
interface MethodSignature { readonly value: number; }
interface Modifier { readonly value: number; }
interface PropertyName { readonly value: number; }
interface QuestionToken { readonly value: number; }
interface NodeArray<T> extends ReadonlyArray<T> {}
interface TypeParameterDeclaration { readonly value: number; }
interface ParameterDeclaration { readonly value: number; }
interface TypeNode { readonly value: number; }
interface Base {readonly updateMethodSignature:unknown;}
interface Target {updateMethodSignature(node: MethodSignature, modifiers: readonly Modifier[] | undefined, name: PropertyName, questionToken: QuestionToken | undefined, typeParameters: NodeArray<TypeParameterDeclaration> | undefined, parameters: NodeArray<ParameterDeclaration>, type: TypeNode | undefined): MethodSignature;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updateMethodSignature({value:3},[{value:3}],{value:3},{value:3},[{value:3}],[{value:3}],{value:3}).value}`);}
probe({updateMethodSignature:(node: MethodSignature, modifiers: readonly Modifier[] | undefined, name: PropertyName, questionToken: QuestionToken | undefined, typeParameters: NodeArray<TypeParameterDeclaration> | undefined, parameters: NodeArray<ParameterDeclaration>, type: TypeNode | undefined):MethodSignature=>{console.log(`${node.value}`);if (modifiers !== undefined) {for (const element of modifiers) {console.log(`${element.value}`);}}console.log(`${name.value}`);if (questionToken !== undefined) {console.log(`${questionToken.value}`);}if (typeParameters !== undefined) {for (const element of typeParameters) {console.log(`${element.value}`);}}for (const element of parameters) {console.log(`${element.value}`);}if (type !== undefined) {console.log(`${type.value}`);}return {value:3};}});
