// Original declaration and read; adjacent data carriers reduced.
interface PrefixUnaryExpression { readonly value: number; }
interface Expression { readonly value: number; }
interface Base {readonly updatePrefixUnaryExpression:unknown;}
interface Target {updatePrefixUnaryExpression(node: PrefixUnaryExpression, operand: Expression): PrefixUnaryExpression;}
function probe(value:Base):void {const context = {factory:value as Target};console.log(`${context.factory.updatePrefixUnaryExpression({value:3},{value:3}).value}`);}
probe({updatePrefixUnaryExpression:():PrefixUnaryExpression=>{return {value:3};}});
