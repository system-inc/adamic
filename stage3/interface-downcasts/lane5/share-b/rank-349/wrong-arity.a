// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface Decorator { readonly value: number; }
interface Base {readonly createDecorator:unknown;}
interface Target {createDecorator(expression: Expression): Decorator;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createDecorator({value:3}).value}`);}
probe({createDecorator:():Decorator=>{return {value:3};}});
