// Original declaration and read; adjacent data carriers reduced.
interface Expression { readonly value: number; }
interface Base {readonly createAssignHelper:unknown;}
interface Target {createAssignHelper(attributesSegments: readonly Expression[]): Expression;}
function probe(value:Base):void {function emitHelpers():Target {return value as Target;}console.log(`${emitHelpers().createAssignHelper([{value:3}]).value}`);}
probe({createAssignHelper:(attributesSegments:number):Expression=>{return {value:3};}});
