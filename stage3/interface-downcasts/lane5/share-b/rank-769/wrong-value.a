// Original declaration and read; adjacent data carriers reduced.
interface Declaration { readonly value: number; }
interface Base {readonly isDeclarationWithCollidingName:unknown;}
interface Target {isDeclarationWithCollidingName(node: Declaration): boolean;}
function probe(value:Base):void {const resolver=value as Target;console.log(`${resolver.isDeclarationWithCollidingName({value:3})}`);}
probe({isDeclarationWithCollidingName:7});
