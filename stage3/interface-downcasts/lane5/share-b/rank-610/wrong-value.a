// Original declaration and read; adjacent data carriers reduced.
interface QualifiedName { readonly value: number; }
interface EntityName { readonly value: number; }
interface Identifier { readonly value: number; }
interface Base {readonly updateQualifiedName:unknown;}
interface Target {updateQualifiedName(node: QualifiedName, left: EntityName, right: Identifier): QualifiedName;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.updateQualifiedName({value:3},{value:3},{value:3}).value}`);}
probe({updateQualifiedName:7});
