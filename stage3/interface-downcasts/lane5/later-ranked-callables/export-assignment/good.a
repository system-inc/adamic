// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface ExportAssignment {readonly value:number;}
interface TypeNode {readonly value:number;}
interface ModifierLike {readonly value:number;}
interface ParameterDeclaration {readonly value:number;}
interface Block {readonly value:number;}
interface Expression {readonly value:number;}
interface TypeParameterDeclaration {readonly value:number;}
interface Base {readonly createExportAssignment:unknown;}
interface Target {createExportAssignment(modifiers: readonly ModifierLike[] | undefined, isExportEquals: boolean | undefined, expression: Expression): ExportAssignment;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createExportAssignment([{value:1}],true,{value:3}).value}`);}
probe({createExportAssignment:(modifiers:readonly ModifierLike[]|undefined,isExportEquals:boolean|undefined,expression:Expression):ExportAssignment=>{const modifier=modifiers===undefined?undefined:modifiers[0];return {value:(modifier===undefined?0:modifier.value)+(isExportEquals===undefined?0:isExportEquals?1:0)+expression.value};}});
