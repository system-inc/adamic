// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Identifier {readonly kind:80;readonly value:number;}
interface StringLiteral {readonly kind:11;readonly value:number;}
interface NoSubstitutionTemplateLiteral {readonly kind:15;readonly value:number;}
interface NumericLiteral {readonly kind:9;readonly value:number;}
interface ComputedPropertyName {readonly kind:168;readonly value:number;}
interface PrivateIdentifier {readonly kind:81;readonly value:number;}
interface BigIntLiteral {readonly kind:10;readonly value:number;}
type PropertyName =
    | Identifier
    | StringLiteral
    | NoSubstitutionTemplateLiteral
    | NumericLiteral
    | ComputedPropertyName
    | PrivateIdentifier
    | BigIntLiteral;
interface Modifier {readonly value:number;}
interface QuestionToken {readonly value:number;}
interface TypeNode {readonly value:number;}
interface PropertySignature {readonly value:number;}
interface Base {readonly createPropertySignature:unknown;}
interface Target {createPropertySignature(modifiers: readonly Modifier[] | undefined, name: PropertyName | string, questionToken: QuestionToken | undefined, type: TypeNode | undefined): PropertySignature;}
function probe(value:Base):void {const factory=value as Target;const modifiers:readonly Modifier[]=[{value:1}];const name:PropertyName={kind:80,value:3};const questionToken:QuestionToken|undefined=undefined;const type:TypeNode|undefined=undefined;console.log(`${factory.createPropertySignature(undefined,"abc",undefined,undefined).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:80,value:3},{value:2},{value:4}).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:11,value:3},{value:2},{value:4}).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:15,value:3},{value:2},{value:4}).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:9,value:3},{value:2},{value:4}).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:168,value:3},{value:2},{value:4}).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:81,value:3},{value:2},{value:4}).value}`);console.log(`${factory.createPropertySignature(modifiers,{kind:10,value:3},{value:2},{value:4}).value}`);}
probe({createPropertySignature:(modifiers:readonly Modifier[]|undefined,name:PropertyName|string,questionToken:QuestionToken|undefined,type:TypeNode|undefined):PropertySignature=>{const modifier=modifiers===undefined?undefined:modifiers[0];return {value:(modifier===undefined?0:modifier.value)+(typeof name==="string"?name.length:name.value)+(questionToken===undefined?0:questionToken.value)+(type===undefined?0:type.value)};}});
