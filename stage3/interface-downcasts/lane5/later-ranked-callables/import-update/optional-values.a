// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface ImportDeclaration {readonly value:number;}
interface Statement {readonly value:number;}
interface Expression {readonly value:number;}
interface TypeNode {readonly value:number;}
interface Modifier {readonly value:number;}
interface ModifierLike {readonly value:number;}
interface Identifier {readonly value:number;}
interface AsteriskToken {readonly value:number;}
interface TypeParameterDeclaration {readonly value:number;}
interface ParameterDeclaration {readonly value:number;}
interface Block {readonly value:number;}
interface ImportClause {readonly value:number;}
interface ImportAttributes {readonly value:number;}
interface Base {readonly updateImportDeclaration:unknown;}
interface Target {updateImportDeclaration(node: ImportDeclaration, modifiers: readonly ModifierLike[] | undefined, importClause: ImportClause | undefined, moduleSpecifier: Expression, attributes: ImportAttributes | undefined): ImportDeclaration;}
function probe(value:Base):void {const context={factory:value as Target};console.log(`${context.factory.updateImportDeclaration({value:1},undefined,undefined,{value:4},undefined).value}`);console.log(`${context.factory.updateImportDeclaration({value:1},[],undefined,{value:4},undefined).value}`);console.log(`${context.factory.updateImportDeclaration({value:1},[{value:2}],{value:3},{value:4},{value:5}).value}`);}
probe({updateImportDeclaration:(node:ImportDeclaration,modifiers:readonly ModifierLike[]|undefined,importClause:ImportClause|undefined,moduleSpecifier:Expression,attributes:ImportAttributes|undefined):ImportDeclaration=>{const modifier=modifiers===undefined?undefined:modifiers[0];return {value:node.value+(modifier===undefined?0:modifier.value)+(importClause===undefined?0:importClause.value)+moduleSpecifier.value+(attributes===undefined?0:attributes.value)};}});
