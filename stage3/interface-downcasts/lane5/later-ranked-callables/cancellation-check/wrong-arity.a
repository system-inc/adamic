// Original tsc declaration/read; adjacent helpers reduced.
interface Base {readonly throwIfCancellationRequested:unknown;}
interface Target {throwIfCancellationRequested(): void;}
function probe(value:Base):void {const cancellationToken=value as Target;cancellationToken.throwIfCancellationRequested();}
probe({throwIfCancellationRequested:(unused:number):void=>{console.log("9");}});
