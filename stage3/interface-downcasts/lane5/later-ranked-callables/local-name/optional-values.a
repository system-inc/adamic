interface Declaration {readonly value:number;}
interface Identifier {readonly value:number;}
interface Base {readonly getLocalName:unknown;}
interface Target {getLocalName(node: Declaration, allowComments?: boolean, allowSourceMaps?: boolean, ignoreAssignedName?: boolean): Identifier;}
function probe(value:Base):void {const factory=value as Target;const node:Declaration={value:3};console.log(`${factory.getLocalName(node).value}`);console.log(`${factory.getLocalName(node,undefined,undefined,undefined).value}`);console.log(`${factory.getLocalName(node,false,false,false).value}`);console.log(`${factory.getLocalName(node,true,true,true).value}`);console.log(`${factory.getLocalName(node,false,true,false).value}`);}
probe({getLocalName:(node:Declaration,allowComments?:boolean,allowSourceMaps?:boolean,ignoreAssignedName?:boolean):Identifier=>({value:node.value+(allowComments===true?1:0)+(allowSourceMaps===true?2:0)+(ignoreAssignedName===true?4:0)})});
