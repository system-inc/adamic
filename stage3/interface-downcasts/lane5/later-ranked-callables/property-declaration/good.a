// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Identifier {readonly kind:80;readonly value:number;}
interface StringLiteral {readonly kind:11;readonly value:number;}
interface NoSubstitutionTemplateLiteral {readonly kind:15;readonly value:number;}
interface NumericLiteral {readonly kind:9;readonly value:number;}
interface ComputedPropertyName {readonly kind:168;readonly value:number;}
interface PrivateIdentifier {readonly kind:81;readonly value:number;}
interface BigIntLiteral {readonly kind:10;readonly value:number;}
type PropertyName =
    | Identifier
    | StringLiteral
    | NoSubstitutionTemplateLiteral
    | NumericLiteral
    | ComputedPropertyName
    | PrivateIdentifier
    | BigIntLiteral;

interface PropertyDeclaration {readonly value:number;}
interface ModifierLike {readonly value:number;}
interface DotDotDotToken {readonly kind:26;readonly value:number;}
interface QuestionToken {readonly kind:58;readonly value:number;}
interface ExclamationToken {readonly kind:54;readonly value:number;}
interface TypeNode {readonly value:number;}
interface Expression {readonly value:number;}

interface Base {readonly createPropertyDeclaration:unknown;}
interface Target {createPropertyDeclaration(modifiers: readonly ModifierLike[] | undefined, name: string | PropertyName, questionOrExclamationToken: QuestionToken | ExclamationToken | undefined, type: TypeNode | undefined, initializer: Expression | undefined): PropertyDeclaration;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createPropertyDeclaration([{value:2}],{kind:80,value:4},{kind:58,value:5},{value:6},{value:7}).value}`);}
probe({createPropertyDeclaration:(modifiers:readonly ModifierLike[]|undefined,name:string|PropertyName,questionOrExclamationToken:QuestionToken|ExclamationToken|undefined,type:TypeNode|undefined,initializer:Expression|undefined):PropertyDeclaration=>{const modifier=modifiers===undefined?undefined:modifiers[0];return {value:(modifier===undefined?0:modifier.value)+(typeof name==="string"?name.length:name.value)+(questionOrExclamationToken===undefined?0:questionOrExclamationToken.value)+(type===undefined?0:type.value)+(initializer===undefined?0:initializer.value)};}});
