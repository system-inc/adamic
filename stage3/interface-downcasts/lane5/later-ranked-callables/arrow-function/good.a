// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Modifier {readonly value:number;}
interface TypeParameterDeclaration {readonly value:number;}
interface ParameterDeclaration {readonly value:number;}
interface TypeNode {readonly value:number;}
interface EqualsGreaterThanToken {readonly value:number;}
interface Expression {readonly value:number;}
interface Block {readonly value:number;}
interface ArrowFunction {readonly value:number;}
type ConciseBody=Expression|Block;
interface Base {readonly createArrowFunction:unknown;}
interface Target {createArrowFunction(modifiers: readonly Modifier[] | undefined, typeParameters: readonly TypeParameterDeclaration[] | undefined, parameters: readonly ParameterDeclaration[], type: TypeNode | undefined, equalsGreaterThanToken: EqualsGreaterThanToken | undefined, body: ConciseBody): ArrowFunction;}
function probe(value:Base):void {const factory=value as Target;const accessor:ConciseBody={value:3};console.log(`${factory.createArrowFunction(undefined,undefined,[{value:0}],undefined,undefined,accessor).value}`);}
probe({createArrowFunction:(modifiers:readonly Modifier[]|undefined,typeParameters:readonly TypeParameterDeclaration[]|undefined,parameters:readonly ParameterDeclaration[],type:TypeNode|undefined,equalsGreaterThanToken:EqualsGreaterThanToken|undefined,body:ConciseBody):ArrowFunction=>({value:body.value})});
