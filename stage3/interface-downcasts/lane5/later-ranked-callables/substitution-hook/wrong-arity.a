// Original tsc declaration/read; adjacent carriers and helpers reduced.
type EmitHint=number;
interface Node {readonly value:number;}
interface Base {readonly onSubstituteNode:unknown;}
interface Target {onSubstituteNode: (hint: EmitHint, node: Node) => Node;}
function probe(value:Base):void {const context=value as Target;const previousOnSubstituteNode=context.onSubstituteNode;const hint:EmitHint=1;const node:Node={value:3};console.log(`${previousOnSubstituteNode(hint,node).value}`);}
probe({onSubstituteNode:():Node=>({value:9})});
