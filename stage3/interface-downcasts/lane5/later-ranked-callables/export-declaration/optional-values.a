// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface ModifierLike {readonly value:number;}
interface NamedExportBindings {readonly value:number;}
interface Expression {readonly value:number;}
interface ImportAttributes {readonly value:number;}
interface ExportDeclaration {readonly value:number;}
interface Base {readonly createExportDeclaration:unknown;}
interface Target {createExportDeclaration(modifiers: readonly ModifierLike[] | undefined, isTypeOnly: boolean, exportClause: NamedExportBindings | undefined, moduleSpecifier?: Expression, attributes?: ImportAttributes): ExportDeclaration;}
function probe(value:Base):void {const factory=value as Target;const exportClause:NamedExportBindings={value:3};console.log(`${factory.createExportDeclaration(undefined,false,undefined).value}`);console.log(`${factory.createExportDeclaration([{value:1}],true,exportClause,{value:4},{value:5}).value}`);}
probe({createExportDeclaration:(modifiers:readonly ModifierLike[]|undefined,isTypeOnly:boolean,exportClause:NamedExportBindings|undefined,moduleSpecifier?:Expression,attributes?:ImportAttributes):ExportDeclaration=>{const modifier=modifiers===undefined?undefined:modifiers[0];return {value:(modifier===undefined?0:modifier.value)+(isTypeOnly?1:0)+(exportClause===undefined?0:exportClause.value)+(moduleSpecifier===undefined?0:moduleSpecifier.value)+(attributes===undefined?0:attributes.value)};}});
