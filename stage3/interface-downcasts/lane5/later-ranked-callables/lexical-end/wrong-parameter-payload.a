// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Statement {readonly value:string;}
interface Base {readonly endLexicalEnvironment:unknown;}
interface Target {endLexicalEnvironment(): Statement[] | undefined;}
function probe(value:Base):void {const context=value as Target;const statements=context.endLexicalEnvironment();const statement=statements===undefined?undefined:statements[0];console.log(`${statement===undefined?0:statement.value}`);}
probe({endLexicalEnvironment:()=>[{value:3}]});
