// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Declaration {readonly value:number;}
interface Identifier {readonly value:number;}
interface Base {readonly getDeclarationName:unknown;}
interface Target {getDeclarationName(node: Declaration | undefined, allowComments?: boolean, allowSourceMaps?: boolean): Identifier;}
function probe(value:Base):void {const factory=value as Target;const source={symbol:{valueDeclaration:{value:3}}};console.log(`${factory.getDeclarationName(source.symbol.valueDeclaration).value}`);}
probe({getDeclarationName:(node:Declaration|undefined,allowComments?:boolean,allowSourceMaps?:boolean):Identifier=>({value:(node===undefined?0:node.value)+(allowComments===true?1:0)+(allowSourceMaps===true?2:0)})});
