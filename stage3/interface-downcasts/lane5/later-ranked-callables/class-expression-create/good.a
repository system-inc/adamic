// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface ClassExpression {readonly value:number;}
interface ModifierLike {readonly value:number;}
interface Identifier {readonly value:number;}
interface TypeParameterDeclaration {readonly value:number;}
interface HeritageClause {readonly value:number;}
interface ClassElement {readonly value:number;}
interface Base {readonly createClassExpression:unknown;}
interface Target {createClassExpression(modifiers: readonly ModifierLike[] | undefined, name: string | Identifier | undefined, typeParameters: readonly TypeParameterDeclaration[] | undefined, heritageClauses: readonly HeritageClause[] | undefined, members: readonly ClassElement[]): ClassExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createClassExpression([{value:2}],{value:3},[{value:4}],[{value:5}],[{value:6}]).value}`);}
probe({createClassExpression:(modifiers:readonly ModifierLike[]|undefined,name:string|Identifier|undefined,typeParameters:readonly TypeParameterDeclaration[]|undefined,heritageClauses:readonly HeritageClause[]|undefined,members:readonly ClassElement[]):ClassExpression=>{const modifier=modifiers===undefined?undefined:modifiers[0];const typeParameter=typeParameters===undefined?undefined:typeParameters[0];const heritage=heritageClauses===undefined?undefined:heritageClauses[0];const member=members[0];return {value:(modifier===undefined?0:modifier.value)+(name===undefined?0:typeof name==="string"?name.length:name.value)+(typeParameter===undefined?0:typeParameter.value)+(heritage===undefined?0:heritage.value)+(member===undefined?0:member.value)};}});
