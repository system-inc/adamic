// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Expression {readonly value:number;}
type BinaryOperator=number;
interface BinaryOperatorToken {readonly value:number;}
interface BinaryExpression {readonly value:number;}
const SyntaxKind={InKeyword:1};
interface Base {readonly createBinaryExpression:unknown;}
interface Target {createBinaryExpression(left: Expression, operator: BinaryOperator | BinaryOperatorToken, right: Expression): BinaryExpression;}
function probe(value:Base):void {const factory=value as Target;const propertyName:Expression={value:3};console.log(`${factory.createBinaryExpression(propertyName,SyntaxKind.InKeyword,{value:4}).value}`);}
probe({createBinaryExpression:(left:Expression,operator:BinaryOperator,right:Expression):BinaryExpression=>({value:8})});
