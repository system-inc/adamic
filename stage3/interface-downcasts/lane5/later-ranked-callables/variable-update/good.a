// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Identifier {readonly value:number;}
interface BindingPattern {readonly value:number;}
type BindingName=Identifier|BindingPattern;
interface VariableDeclaration {readonly value:number;readonly name:BindingName;}
interface ExclamationToken {readonly value:number;}
interface TypeNode {readonly value:number;}
interface Expression {readonly value:number;}
interface Base {readonly updateVariableDeclaration:unknown;}
interface Target {updateVariableDeclaration(node: VariableDeclaration, name: BindingName, exclamationToken: ExclamationToken | undefined, type: TypeNode | undefined, initializer: Expression | undefined): VariableDeclaration;}
function probe(value:Base):void {const factory=value as Target;const firstDeclaration:VariableDeclaration={value:3,name:{value:3}};const boundValue:Expression={value:4};console.log(`${factory.updateVariableDeclaration(firstDeclaration,firstDeclaration.name,undefined,undefined,boundValue).value}`);}
probe({updateVariableDeclaration:(node:VariableDeclaration,name:BindingName,exclamationToken:ExclamationToken|undefined,type:TypeNode|undefined,initializer:Expression|undefined):VariableDeclaration=>({name,value:name.value+(initializer===undefined?0:initializer.value)})});
