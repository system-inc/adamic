// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface UnionTypeNode {readonly value:number;}
interface TypeNode {readonly value:number;}
interface ModifierLike {readonly value:number;}
interface ParameterDeclaration {readonly value:number;}
interface Block {readonly value:number;}
interface Expression {readonly value:number;}
interface TypeParameterDeclaration {readonly value:number;}
interface Base {readonly createUnionTypeNode:unknown;}
interface Target {createUnionTypeNode(types: readonly TypeNode[]): UnionTypeNode;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createUnionTypeNode([{value:3}]).value}`);}
probe({createUnionTypeNode:(types:readonly TypeNode[]):UnionTypeNode=>{const type=types[0];return {value:type===undefined?0:type.value};}});
