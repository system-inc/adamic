// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface ModuleBlock {readonly value:number;}
interface Statement {readonly value:number;}
interface Expression {readonly value:number;}
interface TypeNode {readonly value:number;}
interface Modifier {readonly value:number;}
interface ModifierLike {readonly value:number;}
interface Identifier {readonly value:number;}
interface AsteriskToken {readonly value:number;}
interface TypeParameterDeclaration {readonly value:number;}
interface ParameterDeclaration {readonly value:number;}
interface Block {readonly value:number;}
interface ImportClause {readonly value:number;}
interface ImportAttributes {readonly value:number;}
interface Base {readonly createModuleBlock:unknown;}
interface Target {createModuleBlock(statements: readonly Statement[]): ModuleBlock;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createModuleBlock([{value:3}]).value}`);}
probe({createModuleBlock:(statements:number):ModuleBlock=>({value:3})});
