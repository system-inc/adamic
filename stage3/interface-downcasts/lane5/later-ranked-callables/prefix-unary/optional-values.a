// Original tsc declaration/read; adjacent carriers and helpers reduced.
type PrefixUnaryOperator=number;
interface Expression {readonly value:number;}
interface PrefixUnaryExpression {readonly value:number;}
interface Base {readonly createPrefixUnaryExpression:unknown;}
interface Target {createPrefixUnaryExpression(operator: PrefixUnaryOperator, operand: Expression): PrefixUnaryExpression;}
function probe(value:Base):void {const factory=value as Target;const operator:PrefixUnaryOperator=41;const temp:Expression={value:3};console.log(`${factory.createPrefixUnaryExpression(operator,temp).value}`);}
probe({createPrefixUnaryExpression:(operator:PrefixUnaryOperator,operand:Expression):PrefixUnaryExpression=>({value:operator+operand.value})});
