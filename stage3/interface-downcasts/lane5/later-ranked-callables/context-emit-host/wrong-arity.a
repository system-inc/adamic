// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface EmitHost {readonly value:string;}
interface Base {readonly getEmitHost:unknown;}
interface Target {getEmitHost(): EmitHost;}
function probe(value:Base):void {const context=value as Target;console.log(`${context.getEmitHost().value}`);}
probe({getEmitHost:(unused:number):EmitHost=>({value:"9"})});
