// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface PropertyNameLiteral {readonly value:number;}
interface PrivateIdentifier {readonly value:number;}
interface StringLiteral {readonly value:number;}
interface Base {readonly createStringLiteralFromNode:unknown;}
interface Target {createStringLiteralFromNode(sourceNode: PropertyNameLiteral | PrivateIdentifier, isSingleQuote?: boolean): StringLiteral;}
function probe(value:Base):void {const factory=value as Target;const node:PrivateIdentifier={value:3};console.log(`${factory.createStringLiteralFromNode(node).value}`);}
probe({createStringLiteralFromNode:(sourceNode:PropertyNameLiteral|PrivateIdentifier,isSingleQuote?:boolean):StringLiteral=>({value:sourceNode.value+(isSingleQuote===true?1:0)})});
