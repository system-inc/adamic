// Original tsc declaration/read; adjacent carriers and helpers reduced.

interface Base {readonly directoryExists:unknown;}
interface Target {directoryExists?(path: string): boolean;}
function probe(value:Base):void {const host=value as Target;function directoryExists(path:string):boolean{return path.length===3;}const wrapped={directoryExists:host.directoryExists && directoryExists};console.log(`${wrapped.directoryExists===undefined?false:wrapped.directoryExists("abc")}`);}
probe({directoryExists:(path:string):boolean=>true});
