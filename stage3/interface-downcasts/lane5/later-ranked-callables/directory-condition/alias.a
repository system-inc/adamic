// Original tsc declaration/read; adjacent carriers and helpers reduced.

interface Base {readonly fileExists:(path:string)=>boolean;readonly directoryExists:unknown;}
interface Target {fileExists(path: string): boolean;directoryExists?(path: string): boolean;}
function probe(value:Base):void {const viewed=value as Target;const host=viewed;function directoryExists(path:string):boolean{return path.length===3;}const wrapped={directoryExists:host.directoryExists && directoryExists};console.log(`${wrapped.directoryExists===undefined?false:wrapped.directoryExists("abc")}`);}
probe({fileExists:(path:string):boolean=>true,directoryExists:(path:string):boolean=>true});
