// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface OmittedExpression {readonly value:number;}
interface Base {readonly createOmittedExpression:unknown;}
interface Target {createOmittedExpression(): OmittedExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createOmittedExpression().value}`);}
probe({createOmittedExpression:3});
