// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface SourceFile {readonly value:string;}
interface Base {readonly getSourceFiles:unknown;}
interface Target {getSourceFiles(): readonly SourceFile[];}
function probe(value:Base):void {const program=value as Target;const files=program.getSourceFiles();const sourceFile=files[0];console.log(`${sourceFile===undefined?0:sourceFile.value}`);}
probe({getSourceFiles:():readonly SourceFile[]=>[{value:"3"}]});
