// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Expression {readonly value:number;}
interface BinaryExpression {readonly value:number;}
interface Base {readonly createStrictInequality:unknown;}
interface Target {createStrictInequality(left: Expression, right: Expression): BinaryExpression;}
function probe(value:Base):void {const factory=value as Target;const left:Expression={value:3};const right:Expression={value:4};console.log(`${factory.createStrictInequality(left,right).value}`);}
probe({createStrictInequality:():BinaryExpression=>({value:9})});
