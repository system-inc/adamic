// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface Base {readonly measure:unknown;}
interface Target {measure(measureName: string, startMarkName?: string, endMarkName?: string): void;}
function probe(value:Base):void {const performance=value as Target;performance.measure("Tracing","beginTracing","endTracing");}
probe({measure:(measureName:number,startMarkName?:string,endMarkName?:string):void=>{console.log("29");}});
