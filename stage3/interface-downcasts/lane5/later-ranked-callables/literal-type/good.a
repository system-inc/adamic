// Original tsc declaration/read; adjacent carriers and helpers reduced.
interface LiteralExpression {readonly value:number;}
interface PrefixUnaryExpression {readonly value:number;}
interface BooleanLiteral {readonly value:number;}
interface NullLiteral {readonly value:number;}
interface LiteralTypeNode {readonly literal:LiteralExpression|PrefixUnaryExpression|BooleanLiteral|NullLiteral;readonly value:number;}
interface Base {readonly createLiteralTypeNode:unknown;}
interface Target {createLiteralTypeNode(literal: LiteralTypeNode["literal"]): LiteralTypeNode;}
function probe(value:Base):void {const factory=value as Target;const expression:LiteralExpression={value:3};console.log(`${factory.createLiteralTypeNode(expression).value}`);}
probe({createLiteralTypeNode:(literal:LiteralTypeNode["literal"]):LiteralTypeNode=>({literal,value:literal.value})});
