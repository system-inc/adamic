// Original tsc declaration/read; adjacent carriers and helpers reduced.
type Path=string;
interface Base {readonly toPath:unknown;}
interface Target {toPath(fileName: string): Path;}
function probe(value:Base):void {const resolutionHost=value as Target;const rootDir="root";console.log(resolutionHost.toPath(rootDir));}
probe({toPath:(fileName:string):Path=>fileName+"/3"});
