// Original tsc binding-read witness; adjacent carriers reduced.
type BindingName = Expression;
interface ExclamationToken {readonly value:number;}
interface TypeNode {readonly value:number;}
interface Expression {readonly value:number;}
interface VariableDeclaration {readonly value:number;}
interface Base {readonly createVariableDeclaration:unknown;}
interface Target {createVariableDeclaration(name: string | BindingName, exclamationToken?: ExclamationToken, type?: TypeNode, initializer?: Expression): VariableDeclaration;}
function inspect(node:VariableDeclaration):void {console.log(`${node.value}`);}
function probe(value:Base):void {const factory=value as Target; const {createVariableDeclaration: factoryCreateVariableDeclaration} = factory; inspect(factoryCreateVariableDeclaration("name", undefined, undefined, {value:5}));}
probe({createVariableDeclaration:(name:string|BindingName, exclamationToken?:ExclamationToken, type?:TypeNode, initializer?:Expression):VariableDeclaration=>({value:typeof name === "string" ? name.length+(initializer?.value ?? 0) : name.value})});
