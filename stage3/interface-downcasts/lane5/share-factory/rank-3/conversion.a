// Original overloaded/generic declarations and read; adjacent carriers reduced.
interface Identifier {readonly value:number;}
type SyntaxKind=number;
interface Base {readonly createIdentifier:unknown;}
interface Target {createIdentifier(text: string): Identifier;
createIdentifier(text: string, originalKeywordKind?: SyntaxKind, hasExtendedUnicodeEscape?: boolean): Identifier;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createIdentifier("ok",8,true).value}`);console.log(`${factory.createIdentifier("ok").value}`);console.log(`${factory.createIdentifier("ok",undefined,undefined).value}`);}
probe({createIdentifier:(text:string, originalKeywordKind?:SyntaxKind, hasExtendedUnicodeEscape?:boolean):Identifier=>({value:(originalKeywordKind===undefined ? 100 : originalKeywordKind)+(hasExtendedUnicodeEscape===undefined ? 10 : hasExtendedUnicodeEscape===true ? 1 : 0)})});
