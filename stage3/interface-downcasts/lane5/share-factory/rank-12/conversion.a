// Original overloaded/generic declarations and read; adjacent carriers reduced.
interface Node {readonly value:number;}
interface Base {readonly cloneNode:unknown;}
interface Target {cloneNode<T extends Node | undefined>(node: T): T;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.cloneNode({value:7}).value}`);console.log(factory.cloneNode({value:8,label:"ok"}).label);console.log(`${factory.cloneNode(undefined)===undefined}`);function optional(node:Node|undefined):void {console.log(`${factory.cloneNode(node)?.value}`);}optional({value:9});optional(undefined);}
function clone<T extends Node | undefined>(node:T):T {return node;}
probe({cloneNode:clone});
