// Original overloaded/generic declarations and read; adjacent carriers reduced.
interface AsteriskToken {readonly value:number;}
interface Expression {readonly value:number;}
interface YieldExpression {readonly value:number;}
interface Base {readonly createYieldExpression:unknown;}
interface Target {createYieldExpression(asteriskToken: AsteriskToken, expression: Expression): YieldExpression;
createYieldExpression(asteriskToken: undefined, expression: Expression | undefined): YieldExpression;
createYieldExpression(asteriskToken: AsteriskToken | undefined, expression: Expression | undefined): YieldExpression;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createYieldExpression(undefined,undefined).value}`);}
probe({createYieldExpression:(asteriskToken:AsteriskToken|undefined,expression:Expression|undefined):YieldExpression=>({value:7})});
