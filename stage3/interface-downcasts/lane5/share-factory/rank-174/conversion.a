// Original overloaded/generic declarations and read; adjacent carriers reduced.
type ModifierSyntaxKind=number;
interface ModifierToken<T> {readonly value:number;readonly kind:T;}
interface Base {readonly createModifier:unknown;}
interface Target {createModifier<T extends ModifierSyntaxKind>(kind: T): ModifierToken<T>;}
function probe(value:Base):void {const factory=value as Target;console.log(`${factory.createModifier(1).value}`);console.log(`${factory.createModifier(1).kind}`);console.log(`${factory.createModifier(2).kind}`);}
function modifier<T extends ModifierSyntaxKind>(kind:T):ModifierToken<T> {return {value:7,kind};}
probe({createModifier:modifier});
