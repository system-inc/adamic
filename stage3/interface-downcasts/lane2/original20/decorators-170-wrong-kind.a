import type { HasDecorators } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as HasDecorators;
 const items = viewed.modifiers;
 if (items === undefined) return;
 console.log(`${items[0]!.pos}`);
}
const raw = { kind: 170, modifiers: [42] };
read(raw);
