interface Base { readonly kind: 'pattern' | 'types' | 'signature' | 'class' | 'reference'; }
interface Range { readonly pos: number; readonly end: number; }
interface NodeArray<T> extends ReadonlyArray<T>, Range { readonly hasTrailingComma: boolean; }
interface BindingElement { readonly kind: 'binding'; readonly pos: number; }
interface OmittedExpression { readonly kind: 'omitted'; readonly pos: number; }
type ArrayBindingElement = BindingElement | OmittedExpression;
interface Type { readonly id: number; }
interface ParameterDeclaration { readonly pos: number; }
interface ClassElement { readonly pos: number; }
interface TypeNode { readonly pos: number; }
interface BindingPattern extends Base { readonly kind: 'pattern'; readonly elements: NodeArray<BindingElement> | NodeArray<ArrayBindingElement>; }
interface UnionOrIntersectionType extends Base { readonly kind: 'types'; readonly types: Type[]; }
interface SignatureDeclaration extends Base { readonly kind: 'signature'; readonly parameters: NodeArray<ParameterDeclaration>; }
interface ClassLikeDeclaration extends Base { readonly kind: 'class'; readonly members: NodeArray<ClassElement>; }
interface TypeReferenceNode extends Base { readonly kind: 'reference'; readonly typeArguments?: NodeArray<TypeNode>; }
function pattern(node: Base): BindingPattern { return node as BindingPattern; }
function types(node: Base): UnionOrIntersectionType { return node as UnionOrIntersectionType; }
function signature(node: Base): SignatureDeclaration { return node as SignatureDeclaration; }
function classNode(node: Base): ClassLikeDeclaration { return node as ClassLikeDeclaration; }
function reference(node: Base): TypeReferenceNode { return node as TypeReferenceNode; }
const raw = {kind: 'signature' as const, parameters: 7};
const values = signature(raw).parameters;
console.log(`${values === undefined ? 'absent' : values.length}`);
