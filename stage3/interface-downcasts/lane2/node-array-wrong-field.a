interface Base { readonly kind: 'block' | 'other'; }
interface Statement { readonly text: string; }
interface ReadonlyTextRange { readonly pos: number; readonly end: number; }
interface NodeArray<T> extends ReadonlyArray<T>, ReadonlyTextRange { readonly hasTrailingComma: boolean; }
interface Block extends Base { readonly kind: 'block'; readonly statements: NodeArray<Statement>; }
function block(node: Base): Block { return node as Block; }
const raw = {kind: 'block' as const, statements: Object.assign([{text: 9}], {pos: 3, end: 9, hasTrailingComma: true})};
const statements = block(raw).statements;
const statement = statements[0];
if (statement !== undefined) console.log(statement.text);
