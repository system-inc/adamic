import type { FunctionLikeDeclaration } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as FunctionLikeDeclaration;
 const items = viewed.typeParameters;
 if (items === undefined) return;
 console.log(`${items.length}:${items[0]!.pos}`);
}
const raw = { kind: 179, typeParameters: [{kind: 169, pos: 7}] };
read(raw);
