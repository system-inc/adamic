import type { CallExpression, NewExpression } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as CallExpression | NewExpression;
 const items = viewed.typeArguments;
 if (items === undefined) return;
 console.log(items.map(item => `${item.pos}`).join(';'));
}
const raw = { kind: 214, typeArguments: [{kind: 184, pos: 'bad'}] };
read(raw);
