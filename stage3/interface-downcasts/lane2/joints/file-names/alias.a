import type { IncrementalBuildInfo } from 'original-tsc-builder';
interface Base { readonly version: string; }
function read(node: IncrementalBuildInfo): string { return node.fileNames.join(';'); }
const values = ['a', 'b'];
const raw = {version: '1', fileNames: values};
values[1] = 'second';
const base: Base = raw;
console.log(read(base as IncrementalBuildInfo));
