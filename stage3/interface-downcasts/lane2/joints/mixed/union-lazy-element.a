import type { IncrementalMultiFileEmitBuildInfo, IncrementalBuildInfo } from 'original-tsc-builder';
interface Base { readonly fileNames: readonly string[]; }
function read(node: IncrementalBuildInfo): string { return node.fileInfos.some(file => typeof file === 'string') ? 'found' : 'absent'; }
const concrete = {fileNames:['a'], root:[1], emitSignatures:[1], outSignature:'sig', fileInfos:['sig',42]};
const base: Base = concrete;
console.log(read(base as IncrementalMultiFileEmitBuildInfo));
