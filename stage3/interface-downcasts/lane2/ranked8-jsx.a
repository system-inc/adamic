interface Base { readonly kind: 'jsx-element' | 'jsx-fragment' | 'jsx-text' | 'jsx-expression' | 'method' | 'function' | 'property' | 'parameter' | 'identifier' | 'string' | 'template-literal' | 'export' | 'abstract' | 'decorator' | 'enum' | 'enum-member' | 'bundle' | 'source' | 'resolved' | 'generic'; }
interface Range { readonly pos: number; readonly end: number; }
interface NodeArray<T> extends ReadonlyArray<T>, Range { readonly hasTrailingComma: boolean; }
interface Identifier extends Base { readonly kind: 'identifier'; readonly text: string; }
interface StringLiteral extends Base { readonly kind: 'string'; readonly text: string; }
interface NoSubstitutionTemplateLiteral extends Base { readonly kind: 'template-literal'; readonly text: string; }
type StringLiteralLike = StringLiteral | NoSubstitutionTemplateLiteral;
interface JsxText extends Base { readonly kind: 'jsx-text'; readonly text: string; readonly containsOnlyTriviaWhiteSpaces: boolean; }
interface JsxExpression extends Base { readonly kind: 'jsx-expression'; readonly expression?: Identifier; }
interface JsxElement extends Base { readonly kind: 'jsx-element'; readonly tagName: Identifier; readonly children: NodeArray<JsxChild>; }
interface JsxFragment extends Base { readonly kind: 'jsx-fragment'; readonly children: NodeArray<JsxChild>; }
type JsxChild = JsxText | JsxExpression | JsxElement | JsxFragment;
interface ModifierToken extends Base { readonly kind: 'export' | 'abstract'; }
interface Decorator extends Base { readonly kind: 'decorator'; readonly expression: Identifier; }
type ModifierLike = ModifierToken | Decorator;
interface ParameterDeclaration extends Base { readonly kind: 'parameter'; readonly modifiers?: NodeArray<ModifierLike>; readonly name: Identifier; }
interface MethodDeclaration extends Base { readonly kind: 'method'; readonly name: Identifier; readonly parameters: NodeArray<ParameterDeclaration>; }
interface FunctionDeclaration extends Base { readonly kind: 'function'; readonly name?: Identifier; readonly parameters: NodeArray<ParameterDeclaration>; }
interface PropertyDeclaration extends Base { readonly kind: 'property'; readonly name: Identifier; }
type HasType = MethodDeclaration | FunctionDeclaration | PropertyDeclaration | ParameterDeclaration;
interface EnumMember extends Base { readonly kind: 'enum-member'; readonly name: Identifier | StringLiteral; readonly initializer?: Identifier; }
interface EnumDeclaration extends Base { readonly kind: 'enum'; readonly name: Identifier; readonly members: NodeArray<EnumMember>; }
interface SourceFile extends Base { readonly kind: 'source'; fileName: string; imports: readonly StringLiteralLike[]; }
interface Bundle extends Base { readonly kind: 'bundle'; readonly sourceFiles: readonly SourceFile[]; }
interface Symbol { readonly escapedName: string; }
interface Signature { parameters: readonly Symbol[]; minArgumentCount: number; compositeSignatures?: Signature[]; }
interface ResolvedType extends Base { readonly kind: 'resolved'; callSignatures: readonly Signature[]; constructSignatures: readonly Signature[]; }
interface TypeParameter { flags: number; isThisType?: boolean; }
interface GenericType extends Base { readonly kind: 'generic'; flags: number; typeParameters: TypeParameter[] | undefined; localTypeParameters: TypeParameter[] | undefined; }
function jsxElement(node: Base): JsxElement { return node as JsxElement; }
function method(node: Base): MethodDeclaration { return node as MethodDeclaration; }
function functionDeclaration(node: Base): FunctionDeclaration { return node as FunctionDeclaration; }
function parameter(node: Base): ParameterDeclaration { return node as ParameterDeclaration; }
function enumDeclaration(node: Base): EnumDeclaration { return node as EnumDeclaration; }
function bundle(node: Base): Bundle { return node as Bundle; }
function sourceFile(node: Base): SourceFile { return node as SourceFile; }
function resolved(type: Base): ResolvedType { return type as ResolvedType; }
function generic(type: Base): GenericType { return type as GenericType; }
function parameterCount(node: HasType): number { return node.kind === 'method' || node.kind === 'function' ? node.parameters.length : 0; }
function childText(child: JsxChild): string { return child.kind === 'jsx-text' ? child.text : child.kind === 'jsx-expression' ? `{${child.expression === undefined ? '' : child.expression.text}}` : child.kind === 'jsx-element' ? `<${child.tagName.text}>${child.children.map(childText).join('')}` : `<>${child.children.map(childText).join('')}`; }
const inner = {kind: 'jsx-element' as const, tagName: {kind: 'identifier' as const, text: 'b'}, children: Object.assign([{kind: 'jsx-text' as const, text: 'bold', containsOnlyTriviaWhiteSpaces: false}], {pos: 0, end: 1, hasTrailingComma: false})};
const raw = {kind: 'jsx-element' as const, tagName: {kind: 'identifier' as const, text: 'p'}, children: Object.assign([{kind: 'jsx-text' as const, text: 'hi ', containsOnlyTriviaWhiteSpaces: false}, {kind: 'jsx-expression' as const, expression: {kind: 'identifier' as const, text: 'name'}}, inner], {pos: 0, end: 3, hasTrailingComma: false})};
const children = jsxElement(raw).children;
console.log(`${children.length}:${children.map(childText).join('')}`);
