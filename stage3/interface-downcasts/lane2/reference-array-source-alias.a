interface Base { readonly kind: 'items' | 'entry' | 'other'; }
interface Entry { readonly value: number; readonly text: string; }
interface Items extends Base { readonly kind: 'items'; readonly values: Entry[]; }
function items(node: Base): Items { return node as Items; }
function entry(value: number): Entry { return {value, text: `item${value}`}; }
interface Writable extends Base { readonly kind: 'entry'; value: number; readonly text: string; }
function writable(node: Base): Writable { return node as Writable; }
const incoming = {kind: 'entry' as const, value: 7 as const, text: String('item7')};
const raw = {kind: 'items' as const, values: [incoming]};
const values = items(raw).values;
writable(incoming).value = 9;
console.log(`written:${values.length}`);
