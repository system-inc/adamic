import type { CompilerOptions } from 'original-tsc-types';
interface Base { readonly allowJs?: boolean; }
function read(base: Base, alias: string[]): void {
 const viewed = base as CompilerOptions;
 const items = viewed.rootDirs;
 console.log(items === undefined ? 'absent' : 'present');
}
const raw = {allowJs: false, rootDirs: undefined};
read(raw, []);
