import type { ConfigFileSpecs } from 'original-tsc-types';
interface Base { readonly isDefaultIncludeSpec: boolean; }
function read(base: Base, alias: string[]): void {
 const viewed = base as ConfigFileSpecs;
 const items = viewed.validatedIncludeSpecs;
 if (items === undefined) return;
 console.log(items.map(item => `${item}!`).join(';'));
}
const raw = {isDefaultIncludeSpec: false, validatedIncludeSpecs: ['a', 'b']};
read(raw, []);
