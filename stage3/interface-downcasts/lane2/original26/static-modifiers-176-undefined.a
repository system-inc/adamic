import type { ClassStaticBlockDeclaration } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as ClassStaticBlockDeclaration;
 const items = viewed.modifiers;
 console.log(items === undefined ? 'absent' : 'present');
}
const raw = { kind: 176, modifiers: undefined };
read(raw);
