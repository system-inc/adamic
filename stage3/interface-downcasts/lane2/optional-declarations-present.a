interface Base { readonly kind: 'symbol' | 'other'; }
interface Declaration { readonly name: string; }
interface SymbolView extends Base { readonly kind: 'symbol'; readonly declarations?: Declaration[]; }
function symbol(node: Base): SymbolView { return node as SymbolView; }
const raw = {kind: 'symbol' as const, declarations: [{name: 'first'}, {name: 'second'}]};
const declarations = symbol(raw).declarations;
if (declarations !== undefined) {
    console.log(`${declarations.length}`);
    const declaration = declarations[0];
    if (declaration !== undefined) console.log(declaration.name);
}
