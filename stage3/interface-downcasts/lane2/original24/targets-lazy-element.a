import type { TypeMapper, FlowReduceLabelData } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base, alias: {flags: number}[]): void {
 const viewed = base as Extract<TypeMapper, {kind: 1}>;
 const items = viewed.targets;
 if (items === undefined) return;
 console.log(`${items[0]!.flags}`);
}
const raw = {kind: 1, sources: [], targets: [{flags: 1}, {flags: 'bad'}]};
read(raw, []);
