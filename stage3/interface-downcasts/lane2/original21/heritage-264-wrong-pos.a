import type { ClassLikeDeclaration } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as ClassLikeDeclaration;
 const items = viewed.heritageClauses;
 if (items === undefined) return;
 console.log(`${items[0]!.pos}`);
}
const raw = { kind: 264, heritageClauses: [{kind: 299, pos: 'bad'}] };
read(raw);
