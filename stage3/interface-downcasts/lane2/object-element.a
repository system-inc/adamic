interface Base { readonly kind: 'items' | 'other'; }
interface Child { readonly name: string; }
interface Items extends Base { readonly kind: 'items'; readonly values: readonly Child[]; }
function items(node: Base): Items { return node as Items; }
const raw = {kind: 'items' as const, values: [{name: 'ok'}]};
const child = items(raw).values[0];
if (child !== undefined) { console.log(child.name); }
