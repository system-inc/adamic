import type { CallSignatureDeclaration } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as CallSignatureDeclaration;
 const items = viewed.parameters;
 console.log(items.map(item => `${item.pos}`).join(';'));
}
const raw = { kind: 180, parameters: [{kind: 170, pos: 'bad'}] };
read(raw);
