import type { ConstructSignatureDeclaration } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as ConstructSignatureDeclaration;
 const items = viewed.typeParameters;
 if (items === undefined) return;
 console.log(`${items[0]!.pos}`);
}
const raw = { kind: 181, typeParameters: [{kind: 169, pos: 'bad'}] };
read(raw);
