import type { SignatureDeclaration, JSDocSignature } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(base: Base): void {
 const viewed = base as SignatureDeclaration | JSDocSignature;
 const items = viewed.parameters;
 console.log(items.map(item => `${item.pos}`).join(';'));
}
const raw = { kind: 324, parameters: [{kind: 342, pos: 7}] };
read(raw);
