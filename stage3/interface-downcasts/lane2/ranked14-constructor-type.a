interface Base { readonly kind: 'constructor-type' | 'method-signature' | 'property-signature' | 'namespace-export' | 'export-assignment' | 'enum' | 'jsdoc-signature' | 'jsdoc-parameter' | 'jsx-fragment' | 'jsx-text' | 'union-type' | 'default' | 'variable' | 'return' | 'identifier' | 'keyword' | 'type-parameter' | 'parameter' | 'export' | 'abstract' | 'readonly' | 'decorator' | 'node' | 'interface-type' | 'transient' | 'build-order'; }
interface Range { readonly pos: number; readonly end: number; }
interface NodeArray<T> extends ReadonlyArray<T>, Range { readonly hasTrailingComma: boolean; }
interface Identifier extends Base { readonly kind: 'identifier'; readonly text: string; }
interface KeywordTypeNode extends Base { readonly kind: 'keyword'; readonly text: string; }
interface ModifierToken extends Base { readonly kind: 'export' | 'abstract' | 'readonly'; }
interface Decorator extends Base { readonly kind: 'decorator'; readonly expression: Identifier; }
type Modifier = ModifierToken;
type ModifierLike = Modifier | Decorator;
interface TypeParameterDeclaration extends Base { readonly kind: 'type-parameter'; readonly name: Identifier; }
interface ParameterDeclaration extends Base { readonly kind: 'parameter'; readonly name: Identifier; }
interface ConstructorTypeNode extends Base { readonly kind: 'constructor-type'; readonly modifiers?: NodeArray<Modifier>; readonly typeParameters?: NodeArray<TypeParameterDeclaration>; readonly parameters: NodeArray<ParameterDeclaration>; readonly type: KeywordTypeNode; }
interface MethodSignature extends Base { readonly kind: 'method-signature'; readonly modifiers?: NodeArray<Modifier>; readonly name: Identifier; }
interface PropertySignature extends Base { readonly kind: 'property-signature'; readonly modifiers?: NodeArray<Modifier>; readonly name: Identifier; }
type HasType = ConstructorTypeNode | MethodSignature | PropertySignature;
interface NamespaceExportDeclaration extends Base { readonly kind: 'namespace-export'; readonly modifiers?: NodeArray<ModifierLike>; readonly name: Identifier; }
interface ExportAssignment extends Base { readonly kind: 'export-assignment'; readonly modifiers?: NodeArray<ModifierLike>; readonly isExportEquals?: boolean; readonly expression: Identifier; }
interface EnumDeclaration extends Base { readonly kind: 'enum'; readonly modifiers?: NodeArray<ModifierLike>; readonly name: Identifier; }
interface JSDocParameterTag extends Base { readonly kind: 'jsdoc-parameter'; readonly name: Identifier; readonly isNameFirst: boolean; readonly isBracketed: boolean; }
interface JSDocSignature extends Base { readonly kind: 'jsdoc-signature'; readonly parameters: readonly JSDocParameterTag[]; }
interface JsxText extends Base { readonly kind: 'jsx-text'; readonly text: string; }
interface JsxFragment extends Base { readonly kind: 'jsx-fragment'; readonly children: NodeArray<JsxText | JsxFragment>; }
interface UnionTypeNode extends Base { readonly kind: 'union-type'; readonly types: NodeArray<KeywordTypeNode>; }
interface VariableStatement extends Base { readonly kind: 'variable'; readonly name: Identifier; }
interface ReturnStatement extends Base { readonly kind: 'return'; }
interface DefaultClause extends Base { readonly kind: 'default'; readonly statements: NodeArray<VariableStatement | ReturnStatement>; }
interface EmitHelperBase { readonly name: string; readonly scoped: boolean; readonly text: string; readonly priority?: number; }
interface ScopedEmitHelper extends EmitHelperBase { readonly scoped: true; }
interface UnscopedEmitHelper extends EmitHelperBase { readonly scoped: false; readonly importName?: string; readonly text: string; }
type EmitHelper = ScopedEmitHelper | UnscopedEmitHelper;
interface SourceMapRange { pos: number; end: number; }
interface EmitNode { flags: number; helpers?: EmitHelper[]; tokenSourceMapRanges?: (SourceMapRange | undefined)[]; }
interface EmittedNode extends Base { readonly kind: 'node'; emitNode?: EmitNode; }
interface Type { flags: number; }
interface TypeParameter { flags: number; }
interface Symbol { escapedName: string; flags: number; declarations?: Base[]; }
interface InterfaceTypeWithDeclaredMembers extends Base { readonly kind: 'interface-type'; flags: number; localTypeParameters: TypeParameter[] | undefined; resolvedBaseTypes: Type[]; declaredProperties: Symbol[]; }
interface TransientSymbol extends Base { readonly kind: 'transient'; escapedName: string; flags: number; declarations?: Base[]; links: { checkFlags: number; }; }
interface Diagnostic { category: number; code: number; messageText: string; }
interface CircularBuildOrder extends Base { readonly kind: 'build-order'; buildOrder: readonly string[]; circularDiagnostics: readonly Diagnostic[]; }
function constructorType(node: Base): ConstructorTypeNode { return node as ConstructorTypeNode; }
function methodSignature(node: Base): MethodSignature { return node as MethodSignature; }
function propertySignature(node: Base): PropertySignature { return node as PropertySignature; }
function namespaceExport(node: Base): NamespaceExportDeclaration { return node as NamespaceExportDeclaration; }
function exportAssignment(node: Base): ExportAssignment { return node as ExportAssignment; }
function enumDeclaration(node: Base): EnumDeclaration { return node as EnumDeclaration; }
function jsdocSignature(node: Base): JSDocSignature { return node as JSDocSignature; }
function jsxFragment(node: Base): JsxFragment { return node as JsxFragment; }
function unionType(node: Base): UnionTypeNode { return node as UnionTypeNode; }
function defaultClause(node: Base): DefaultClause { return node as DefaultClause; }
function emitted(node: Base): EmittedNode { return node as EmittedNode; }
function interfaceType(type: Base): InterfaceTypeWithDeclaredMembers { return type as InterfaceTypeWithDeclaredMembers; }
function transient(symbol: Base): TransientSymbol { return symbol as TransientSymbol; }
function buildOrder(value: Base): CircularBuildOrder { return value as CircularBuildOrder; }
function modifierKinds(node: HasType): string { return node.modifiers === undefined ? 'none' : node.modifiers.map(item => item.kind).join(' '); }
function modifierLikeKinds(modifiers: NodeArray<ModifierLike> | undefined): string { return modifiers === undefined ? 'none' : modifiers.map(item => item.kind === 'decorator' ? `@${item.expression.text}` : item.kind).join(' '); }
function fragmentText(fragment: JsxFragment): string { return fragment.children.map(child => child.kind === 'jsx-text' ? child.text : `<>${fragmentText(child)}</>`).join(''); }
const raw = {kind: 'constructor-type' as const, modifiers: Object.assign([{kind: 'abstract' as const}], {pos: 0, end: 1, hasTrailingComma: false}), typeParameters: Object.assign([{kind: 'type-parameter' as const, name: {kind: 'identifier' as const, text: 'T'}}], {pos: 0, end: 1, hasTrailingComma: false}), parameters: Object.assign([{kind: 'parameter' as const, name: {kind: 'identifier' as const, text: 'a'}}, {kind: 'parameter' as const, name: {kind: 'identifier' as const, text: 'b'}}], {pos: 0, end: 2, hasTrailingComma: false}), type: {kind: 'keyword' as const, text: 'object'}};
const node = constructorType(raw);
console.log(`${modifierKinds(node)} new <${node.typeParameters === undefined ? '' : node.typeParameters.map(item => item.name.text).join(',')}>(${node.parameters.map(item => item.name.text).join(', ')}) => ${node.type.text}`);
