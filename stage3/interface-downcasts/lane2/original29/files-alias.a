import type { SortedAndCanonicalizedMutableFileSystemEntries } from 'original-tsc-directory';
interface Base { readonly directories: string[]; }
function read(base: Base, alias: string[]): void {
 const viewed = base as SortedAndCanonicalizedMutableFileSystemEntries;
 const items = viewed.files;
 alias[0] = 'new'; console.log(items.join(';'));
}
const raw = {directories: ['kept'], files: ['a', 'b']};
read(raw, raw.files);
