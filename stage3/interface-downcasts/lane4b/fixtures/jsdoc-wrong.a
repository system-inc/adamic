interface Comment { readonly text: string; }
interface Base { readonly kind: string; }
interface Box extends Base { readonly kind: 'Box'; readonly comment: string | readonly Comment[] | undefined; }
function read(value: Box): string {
 const member = value.comment;
 if (member === undefined) return 'absent';
 if (typeof member === 'string') return member;
 const first = member[0];
 return first === undefined ? 'empty' : first.text;
}
const concrete0 = { kind: 'Box', comment: [{ text: 42 }] };
const source0: Base = concrete0;
console.log(read(source0 as Box));
