import type { PackageJsonInfoContents } from 'original-tsc-resolver';
interface Base { readonly packageJsonContent: {}; }
function read(info: PackageJsonInfoContents): string {
 const member = info.resolvedEntrypoints;
 if (member === undefined) return 'absent';
 if (typeof member === 'boolean') return `${member}`;
 const first = member[0];
 if (first === undefined) return 'empty';
 return `${typeof first}`;
}
const literal = { packageJsonContent: {}, resolvedEntrypoints: false };
const literalBase: Base = literal;
console.log(read(literalBase as PackageJsonInfoContents));
const object = { packageJsonContent: {}, resolvedEntrypoints: ['entry'] };
const objectBase: Base = object;
console.log(read(objectBase as PackageJsonInfoContents));
const absent = { packageJsonContent: {}, resolvedEntrypoints: undefined };
const absentBase: Base = absent;
console.log(read(absentBase as PackageJsonInfoContents));
