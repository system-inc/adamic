import type { AutoGenerateInfo } from 'original-tsc-types';
interface Base { readonly id: number; }
function read(info: AutoGenerateInfo): string {
 const member = info.prefix;
 if (member === undefined) return 'absent';
 if (typeof member === 'boolean') return 'wrong';
 if (typeof member === 'string') return member;
 return `${member.prefix}`;
}
const plain = { id: 1, prefix: 'plain' };
const nested = { id: 2, prefix: { prefix: 'nested' } };
const absent = { id: 3 };
const plainBase: Base = plain;
const nestedBase: Base = nested;
const absentBase: Base = absent;
console.log(read(plainBase as AutoGenerateInfo));
console.log(read(nestedBase as AutoGenerateInfo));
console.log(read(absentBase as AutoGenerateInfo));
const missingNested = { id: 4, prefix: {} };
const explicit = { id: 5, prefix: undefined };
const missingNestedBase: Base = missingNested;
const explicitBase: Base = explicit;
console.log(read(missingNestedBase as AutoGenerateInfo));
console.log(read(explicitBase as AutoGenerateInfo));
