import type { Diagnostic } from 'original-tsc-types';
interface Base { readonly category: number; }
function read(diagnostic: Diagnostic): string {
 const member = diagnostic.messageText;
 if (typeof member === 'boolean') return 'wrong';
 if (typeof member === 'string') return member;
 return `${member.messageText}:${member.code}`;
}
const concrete = { category: 1, messageText: { messageText: 'chain', code: false } };
const base: Base = concrete;
console.log(read(base as Diagnostic));
