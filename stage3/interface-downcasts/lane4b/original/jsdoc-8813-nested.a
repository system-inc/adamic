import type { JSDocCallbackTag } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(node: JSDocCallbackTag): string {
 const member = node.comment;
 if (member === undefined) return 'absent';
 if (typeof member === 'string') return member;
 if (typeof member !== 'object') return 'wrong';
 const first = member[0];
 if (first === undefined) return 'empty';
 return `${first.flags}`;
}
const concrete = { kind: 339, comment: [{ kind: 322, flags: false, text: 'nested' }] };
const base: Base = concrete;
console.log(read(base as JSDocCallbackTag));
