import type { JSDocSeeTag } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(node: JSDocSeeTag): string {
 const member = node.comment;
 if (member === undefined) return 'absent';
 if (typeof member === 'string') return member;
 if (typeof member !== 'object') return 'wrong';
 const first = member[0];
 if (first === undefined) return 'empty';
 return `${first.flags}`;
}
function wrongMember(): string | boolean { return false; }
const concrete: { readonly kind: number; readonly comment: string | boolean; } = { kind: 348, comment: wrongMember() };
const base: Base = concrete;
console.log(read(base as JSDocSeeTag));
