import type { DiagnosticWithDetachedLocation } from 'original-tsc-types';
interface Base { readonly category: number; }
function read(diagnostic: DiagnosticWithDetachedLocation): string {
 const member = diagnostic.messageText;
 if (typeof member === 'boolean') return 'wrong';
 if (typeof member === 'string') return member;
 return `${member.messageText}:${member.code}`;
}
const poison = `${42}` === '42' ? false : 'plain';
const concrete = { category: 1, messageText: poison };
const base: Base = concrete;
console.log(read(base as DiagnosticWithDetachedLocation));
