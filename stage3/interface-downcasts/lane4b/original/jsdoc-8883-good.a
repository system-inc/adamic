import type { JSDocAugmentsTag } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(node: JSDocAugmentsTag): string {
 const member = node.comment;
 if (member === undefined) return 'absent';
 if (typeof member === 'string') return member;
 if (typeof member !== 'object') return 'wrong';
 const first = member[0];
 if (first === undefined) return 'empty';
 return `${first.flags}`;
}
const plain = { kind: 329, comment: 'plain' };
const array = { kind: 329, comment: [{ kind: 322, flags: 7, text: 'nested' }] };
const absent = { kind: 329 };
const plainBase: Base = plain;
const arrayBase: Base = array;
const absentBase: Base = absent;
console.log(read(plainBase as JSDocAugmentsTag));
console.log(read(arrayBase as JSDocAugmentsTag));
console.log(read(absentBase as JSDocAugmentsTag));
