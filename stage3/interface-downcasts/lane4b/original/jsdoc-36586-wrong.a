import type { JSDocCallbackTag, JSDocEnumTag, JSDocTypedefTag } from 'original-tsc-types';
interface Base { readonly kind: number; }
function read(node: JSDocCallbackTag | JSDocEnumTag | JSDocTypedefTag): string {
 const member = node.comment;
 if (member === undefined) return 'absent';
 if (typeof member === 'string') return member;
 if (typeof member !== 'object') return 'wrong';
 const first = member[0];
 if (first === undefined) return 'empty';
 return `${first.flags}`;
}
function wrongMember(): string | boolean { return false; }
const concrete: { readonly kind: number; readonly comment: string | boolean; } = { kind: 339, comment: wrongMember() };
const base: Base = concrete;
console.log(read(base as JSDocCallbackTag));
function viewJSDocEnumTag(base: Base): JSDocEnumTag { return base as JSDocEnumTag; }
function viewJSDocTypedefTag(base: Base): JSDocTypedefTag { return base as JSDocTypedefTag; }
