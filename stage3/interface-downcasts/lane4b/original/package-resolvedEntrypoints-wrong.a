import type { PackageJsonInfoContents } from 'original-tsc-resolver';
interface Base { readonly packageJsonContent: {}; }
function read(info: PackageJsonInfoContents): string {
 const member = info.resolvedEntrypoints;
 if (member === undefined) return 'absent';
 if (typeof member === 'boolean') return `${member}`;
 const first = member[0];
 if (first === undefined) return 'empty';
 return `${typeof first}`;
}
function wrongMember(): boolean | string[] { return true; }
const concrete: { readonly packageJsonContent: {}; readonly resolvedEntrypoints: boolean | string[] | undefined; } = { packageJsonContent: {}, resolvedEntrypoints: wrongMember() };
const base: Base = concrete;
console.log(read(base as PackageJsonInfoContents));
