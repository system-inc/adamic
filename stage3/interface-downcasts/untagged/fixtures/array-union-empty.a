// Independent lazy array-union projection.
interface ElementA {readonly kind:1; readonly payload:{readonly label:string}; readonly a:any;}
interface ElementB {readonly kind:2; readonly payload:{readonly label:string}; readonly b:any;}
interface Receiver {readonly kind:'Receiver'; readonly elements:readonly ElementA[]|readonly ElementB[];}
const raw={kind:'Receiver' as const,elements:[]};
const base:{readonly kind:'Receiver'}=raw;
const view=base as Receiver;
const values=view.elements;
const item=values[0];
console.log(`${item===undefined}`);
