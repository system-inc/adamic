type Item = number | readonly [number,string];
interface Base {readonly kind:string;}
interface Target extends Base {readonly values:readonly Item[];}
const source=[7,8];
const raw={kind:'probe',values:source}; const base:Base=raw; const viewed=base as Target; const values=viewed.values;
try { values.forEach((item):void=>{console.log(typeof item);throw new Error('stop');}); } catch {console.log('caught');}
console.log('done');
