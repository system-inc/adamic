import type {FileWatcherCallback,DirectoryWatcherCallback} from 'original-tsc-sys';
type Args=Parameters<FileWatcherCallback>|Parameters<DirectoryWatcherCallback>;
interface Base {readonly kind:string;} interface Target extends Base {readonly args:Args;}
const pair:[string,number]=['file',1]; const raw={kind:'probe',args:pair};const base:Base=raw;const viewed=base as Target;let args:Args=viewed.args;function drop():void {const short:[string]=['file']; args=short;} if(args[1]!==undefined) {drop(); console.log(String(args[1]+1));}
