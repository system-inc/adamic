import type { IncrementalBundleEmitBuildInfo, EmitSignature } from 'original-tsc-builder';
interface Base { readonly version: string; }
const value: [boolean] = [false];
const raw = {version:'probe',outSignature:value};
const base: Base = raw;
const viewed = base as IncrementalBundleEmitBuildInfo;
const signature = viewed.outSignature;
if (signature === undefined) console.log('absent');
else console.log(typeof signature === 'string' ? signature : signature[0]);
