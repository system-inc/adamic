type Pair=readonly [number,...string[]];
interface Base {readonly kind:string;}
interface Target extends Base {readonly value:Pair;}
const pair:readonly [number,string,string,boolean]=[7,'a','b',false]; const raw={kind:'probe',value:pair}; const base:Base=raw; const target=base as Target;
const selected=target.value; console.log(String(selected[0])); console.log(typeof selected[3]);
