import type { JsxNames } from 'original-tsc-names';
interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: typeof JsxNames; }
function helper(value: typeof JsxNames): void { console.log(String(value.ElementAttributesPropertyNameContainer)); }
const raw = {kind: 'box' as const, child: {ElementAttributesPropertyNameContainer: undefined}};
