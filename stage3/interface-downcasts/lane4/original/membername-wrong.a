import type { MemberName, Identifier, PrivateIdentifier } from 'original-tsc-types';
interface Base { readonly kind: number; }
function helper(value: MemberName): void { console.log(String(value.escapedText)); }
const raw = { kind: 81, escapedText: 42 };
const base: Base = raw;
