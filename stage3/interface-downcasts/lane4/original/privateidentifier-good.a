import type { PrivateIdentifier } from 'original-tsc-types';
interface Base { readonly kind: number; }
function helper(value: PrivateIdentifier): void { console.log(String(value.escapedText)); }
const raw = { kind: 81, escapedText: 'word' + '-built' };
const base: Base = raw;
helper(base as PrivateIdentifier);
