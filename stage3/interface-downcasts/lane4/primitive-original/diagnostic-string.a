import type { Diagnostic } from 'original-tsc-types';
interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: Diagnostic; }
function helper(value: Diagnostic): void { console.log(String(value.skippedOn)); }
const raw = {kind: 'box' as const, child: {skippedOn: 'word'.concat('-built')}};
const base: Base = raw;
const carrier = base as Carrier;
helper(carrier.child);
