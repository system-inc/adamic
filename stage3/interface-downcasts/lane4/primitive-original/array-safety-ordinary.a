interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: (string | number)[]; }
function helper(value: Carrier): void { console.log(String(value.child[0])); }
const ordinary: Carrier = {kind: 'box', child: [42]};
const raw = {kind: 'box' as const, child: ['word' + '-built']};
const base: Base = raw;
const viewed = base as Carrier;
helper(ordinary);
helper(viewed);
