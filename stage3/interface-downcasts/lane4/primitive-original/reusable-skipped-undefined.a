import type { ReusableDiagnostic } from 'original-tsc-builder';
interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: ReusableDiagnostic; }
function helper(value: ReusableDiagnostic): void { console.log(String(value.skippedOn)); }
const raw = {kind: 'box' as const, child: {skippedOn: undefined}};
const base: Base = raw;
const carrier = base as Carrier;
helper(carrier.child);
