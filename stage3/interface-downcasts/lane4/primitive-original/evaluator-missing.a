import type { EvaluatorResult } from 'original-tsc-types';
interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: EvaluatorResult<string | number | undefined>; }
function helper(value: EvaluatorResult<string | number | undefined>): void { console.log(String(value.value)); }
const raw = {kind: 'box' as const, child: {}};
const base: Base = raw;
const carrier = base as Carrier;
helper(carrier.child);
