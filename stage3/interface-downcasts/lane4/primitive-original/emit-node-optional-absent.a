import type { NodeLinks, EmitNode } from 'original-tsc-types';
interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: EmitNode | undefined; }
function helper(value: EmitNode | undefined): void { console.log(String(value?.constantValue)); }
const raw = {kind: 'box' as const, child: undefined};
const base: Base = raw;
const carrier = base as Carrier;
helper(carrier.child);
