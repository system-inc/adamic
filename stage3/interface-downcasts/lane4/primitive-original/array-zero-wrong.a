interface Base { readonly kind: 'box' | 'other'; }
interface Carrier extends Base { readonly kind: 'box'; readonly child: (string | number)[]; }
function helper(value: (string | number)[]): void { console.log(String(value[0])); }
const raw = {kind: 'box' as const, child: [true]};
const base: Base = raw;
const carrier = base as Carrier;
helper(carrier.child);
