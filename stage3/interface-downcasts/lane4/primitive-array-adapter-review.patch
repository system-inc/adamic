+func (l *lowering) primitiveUnionType(target *checker.Type) bool {
+	target = l.concrete(target)
+	if base := l.phantomBase(target); base != nil {
+		return l.primitiveUnionType(base)
+	}
+	if target.Flags()&checker.TypeFlagsUnion != 0 {
+		for _, member := range target.Types() {
+			if !l.primitiveUnionType(member) {
+				return false
+			}
+		}
+		return len(target.Types()) != 0
+	}
+	return l.phantomUndefined(target) || target.Flags()&(checker.TypeFlagsStringLike|checker.TypeFlagsNumberLike|checker.TypeFlagsBooleanLike|checker.TypeFlagsUndefined) != 0
+}
