+func (e *emitter) viewPrimitiveMembers(id ir.ViewContractID) (string, int) {
+	members, ok := ir.PrimitiveViewMembers(e.program, id)
+	if !ok {
+		panic("compiler bug: incomplete primitive view contract")
+	}
+	header := `#include "view_unions_mixed.h"`
+	found := false
+	for _, declaration := range e.declarations {
+		found = found || declaration == header
+	}
+	if !found {
+		e.declarations = append(e.declarations, header)
+	}
+	var rows []string
+	for _, member := range members {
+		if member.Kind == ir.ViewUndefined {
+			rows = append(rows, "{adamic_view_union_undefined, false, {.reference = NULL}, 0}")
+			continue
+		}
+		kind := map[ir.Type]string{ir.Number: "number", ir.Boolean: "boolean", ir.String: "string"}[member.Of]
+		if len(member.Allowed) == 0 {
+			rows = append(rows, "{adamic_view_union_"+kind+", false, {.reference = NULL}, 0}")
+			continue
+		}
+		for _, literal := range member.Allowed {
+			payload := ""
+			switch literal.Of {
+			case ir.Number:
+				payload = ".number = " + cNumber(literal.Number)
+			case ir.Boolean:
+				payload = fmt.Sprintf(".boolean = %t", literal.Boolean)
+			case ir.String:
+				name := e.temporary()
+				e.declarations = append(e.declarations, fmt.Sprintf("static adamic_string %s = ADAMIC_STRING(%s);", name, cString(literal.String)))
+				payload = ".reference = &" + name
+			}
+			rows = append(rows, "{adamic_view_union_"+kind+", true, {"+payload+"}, 0}")
+		}
+	}
+	return "(adamic_view_union_member[]){" + strings.Join(rows, ", ") + "}", len(rows)
+}
+
+func (e *emitter) viewPrimitiveSelect(snapshot string, id ir.ViewContractID, expression, declared string) {
+	members, count := e.viewPrimitiveMembers(id)
+	e.line("(void)adamic_view_mixed_union_select(&%s, %s, %d, NULL, NULL, %s, %s);", snapshot, members, count, cString(expression), cString(declared))
+}
+
+// Every result owns exactly one reference, independent of source slot format.
+// Called only after complete primitive member selection has accepted the snapshot.
+func (e *emitter) viewPrimitiveBox(snapshot string) string {
+	result := e.own(ir.Union, "NULL")
+	e.line("if (%s.kind == adamic_view_union_number) %s = adamic_box_number(%s.payload.number);", snapshot, result, snapshot)
+	e.line("else if (%s.kind == adamic_view_union_boolean) %s = %s.payload.boolean ? &adamic_box_true.heap : &adamic_box_false.heap;", snapshot, result, snapshot)
+	e.line("else if (%s.kind == adamic_view_union_string) %s = adamic_retain(%s.payload.reference);", snapshot, result, snapshot)
+	return result
+}
+
+func (e *emitter) emitViewPrimitiveField(property ir.Property, object string) string {
+	cache := e.temporary()
+	e.declarations = append(e.declarations, "static adamic_slot_cache "+cache+" = {NULL, 0};")
+	snapshot := e.temporary()
+	e.line("adamic_view_union_value %s = adamic_object_view_union_snapshot(%s, %s, &%s, %s, %s, %t);", snapshot, object, cString(property.Name), cache, cString(property.View), cString(property.ViewType), property.Absent || property.Optional)
+	e.viewPrimitiveSelect(snapshot, property.ViewContract, property.View, property.ViewType)
+	return e.viewPrimitiveBox(snapshot)
+}
+
+func (e *emitter) emitViewPrimitiveArrayRead(read ir.ArrayIndex, array, index string) string {
+	members, count := e.viewPrimitiveMembers(read.ViewContract)
+	snapshot, present, slot := e.temporary(), e.temporary(), e.temporary()
+	e.line("adamic_view_union_value %s;", snapshot)
+	e.line("bool %s = adamic_view_primitive_array_snapshot(%s, %s, %t, %t, %s, %s, &%s);", present, array, index, read.Relative, read.UndefinedAllowed, cString(read.View), cString(read.ViewType), snapshot)
+	if read.Required {
+		e.line("if (!%s) adamic_view_array_missing(%s, %s);", present, cString(read.View), cString(read.ViewType))
+	}
+	e.line("if (%s) (void)adamic_view_mixed_union_select(&%s, %s, %d, NULL, NULL, %s, %s);", present, snapshot, members, count, cString(read.View), cString(read.ViewType))
+	boxed := e.viewPrimitiveBox(snapshot)
+	result := e.temporary()
+	e.line("adamic_value %s = {.reference = %s};", result, boxed)
+	e.line("adamic_value *%s = %s ? &%s : NULL;", slot, present, result)
+	return slot
+}
