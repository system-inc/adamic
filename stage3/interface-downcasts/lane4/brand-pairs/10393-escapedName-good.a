export {};
type InternalSymbolName = '__call' | '__new';
type __String = (string & { __escapedIdentifier: void }) | (void & { __escapedIdentifier: void }) | InternalSymbolName;
interface Base { readonly kind: 'box' | 'other' }
interface TransientSymbol extends Base { readonly kind: 'box'; readonly escapedName: __String }
function helper(value: TransientSymbol): void { console.log(String(value.escapedName)); }
const raw = {kind: 'box' as const, escapedName: 'word'};
const base: Base = raw;
helper(base as TransientSymbol);
