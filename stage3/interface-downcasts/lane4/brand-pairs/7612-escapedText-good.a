export {};
type InternalSymbolName = '__call' | '__new';
type __String = (string & { __escapedIdentifier: void }) | (void & { __escapedIdentifier: void }) | InternalSymbolName;
interface Base { readonly kind: 'box' | 'other' }
interface GeneratedIdentifier extends Base { readonly kind: 'box'; readonly escapedText: __String }
function helper(value: GeneratedIdentifier): void { console.log(String(value.escapedText)); }
const raw = {kind: 'box' as const, escapedText: 'word'};
const base: Base = raw;
helper(base as GeneratedIdentifier);
