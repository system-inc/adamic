interface Left { readonly text: string }
interface Right { readonly text: number }
interface Base { readonly kind: 'box' | 'other' }
interface Box extends Base { readonly kind: 'box'; readonly value: Left | Right }
function read(base: Base): void {
 const value = (base as Box).value;
 console.log((typeof value.text === 'string' ? 'Left:' : 'Right:') + String(value.text));
}
const raw = {kind: 'box' as const, value: {text: true}};
read(raw);
