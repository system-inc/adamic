interface Base { readonly kind: 'identifier' | 'literal'; }
interface Identifier extends Base {
 readonly kind: 'identifier';
 readonly name: string;
 readonly opaque: (value: number) => number;
}
function make(): Base { const kind: 'identifier' = 'identifier'; const raw = { kind, name: 'ok'.repeat(2) }; return raw; }
function identifier(value: Base): Identifier { return value as Identifier; }
function name(value: Identifier): string { return value.name; }
console.log(name(identifier(make())));
