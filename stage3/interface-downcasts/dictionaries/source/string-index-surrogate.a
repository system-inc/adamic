interface Base { readonly kind: 'Text'; }
interface TextView extends Base { readonly text: string; }
const payload = {kind: 'Text' as const, text: 'A😀'};
const base: Base = payload;
const view = base as TextView;
function read(value: string, index: number): void { const selected = value[index]; if (selected !== undefined) console.log(`${selected.charCodeAt(0)}`); else console.log('missing'); }
read(view.text, 1);
