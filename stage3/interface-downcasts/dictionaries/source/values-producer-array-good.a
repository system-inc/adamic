interface MapLike<T>{[key:string]:T;}
interface Entry{readonly name:string;}
interface Base{readonly kind:'Enum';}
interface Holder extends Base{readonly table:MapLike<string[]>;}
const table:Record<string,string[]>={item:['name']};
const payload={kind:'Enum' as const,table};
const base:Base=payload;const view=base as Holder;
const result=Object.values(view.table);console.log(`${result.length}`);
for(const item of result){const value=item;console.log(`${value[0]}`);}
