interface MapLike<T> { [key: string]: T; }
interface Plugin { readonly name: string; }
interface Project { readonly path: string; }
interface Source { readonly text: string; }
type RichValue = string | number | boolean | (string | number)[] | MapLike<string[]> | Plugin[] | Project[] | Source | null | undefined;
interface CompilerOptions { readonly [key: string]: RichValue; }
interface Base { readonly kind: 'Command'; }
interface ParsedCommandLine extends Base { readonly options: CompilerOptions; }
const payload = { kind: 'Command' as const };
const base: Base = payload;
const view = base as ParsedCommandLine;
console.log(typeof view.options);
