interface MapLike<T> { [key: string]: T; }
interface Base { readonly kind: 'Paths'; }
interface Holder extends Base { readonly paths?: MapLike<string[]>; }
const entries: MapLike<string[]> = { item: ['name'] };
const payload={kind:'Paths' as const,paths:entries};
const base:Base=payload;
const view=base as Holder;
const table=view.paths; if(table!==undefined) { const values=table['item']; if(values!==undefined) console.log(`${values[0]}`); }
