interface MapLike<T>{[key:string]:T}
interface Base{readonly kind:'Storage'}
interface Holder extends Base{readonly table:{readonly [key:string]:string}}
const table:Record<string,string>={item:'name'};
const payload={kind:'Storage' as const,table};
const base:Base=payload; const view=base as Holder;
console.log(`${view.table['item']}`); console.log(`${view.table['missing']}`);
