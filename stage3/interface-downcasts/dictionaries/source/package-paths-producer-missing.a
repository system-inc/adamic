interface MapLike<T> { [key: string]: T; }
interface PackageJsonPathFields { readonly [key: string]: MapLike<string> | undefined; }
interface Base { readonly kind: 'Table'; }
interface Holder extends Base { readonly fields: PackageJsonPathFields; }
const dictionary: Record<string, Record<string, string>> = { other: { item: 'name' } };
const payload = { kind: 'Table' as const, fields: dictionary };
const base: Base = payload;
const view = base as Holder;
const paths = view.fields;
const table = paths['imports']; if (table === undefined) console.log('missing');
