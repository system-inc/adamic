interface MapLike<T> { [key: string]: T; }
interface Base { readonly kind: 'Paths'; }
interface Holder extends Base { readonly paths?: MapLike<string[]>; }
const payload={kind:'Paths' as const,paths:{ item: 42 }};
const base:Base=payload;
const view=base as Holder;
const table=view.paths; if(table!==undefined) console.log(typeof table['item']);
