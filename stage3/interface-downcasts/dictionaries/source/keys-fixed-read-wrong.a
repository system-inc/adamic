interface MapLike<T> { [key:string]: T; }
interface Base { readonly kind:'Keys'; }
interface Holder extends Base { readonly table: MapLike<string>; }
const payload = {kind:'Keys' as const,table:{'10':1,'2':2,z:42,a:3}};
const base:Base=payload;
const view=base as Holder;
const keys=Object.keys(view.table); for(const key of keys) console.log(key);
console.log(`${view.table['z']}`);
