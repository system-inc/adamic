interface MapLike<T> { [key: string]: T; }
interface Plugin { readonly name: string; }
interface Project { readonly path: string; }
interface Source { readonly text: string; }
type RichValue = string | number | boolean | (string | number)[] | MapLike<string[]> | Plugin[] | Project[] | Source | null | undefined;
interface Base { readonly kind: 'Paths'; }
interface CompilerOptions extends Base { readonly paths?: MapLike<string[]>; readonly [key: string]: RichValue; }
let calls = 0;
function receiver(value: CompilerOptions | undefined): CompilerOptions | undefined { calls++; return value; }
function read(base: Base | undefined): void {
 const view = base === undefined ? undefined : base as CompilerOptions;
 const table = receiver(view)?.paths;
 if (table === undefined) console.log('missing');
 else { const values = table['item']; if (values !== undefined) console.log(`${values[0]}`); }
}
const payload = {kind:'Paths' as const,paths:{item:['name']}};
read(undefined);
read(payload);
console.log(`${calls}`);
