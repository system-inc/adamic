interface MapLike<T>{[key:string]:T;}
interface Entry{readonly name:string;}
interface Base{readonly kind:'Enum';}
interface Holder extends Base{readonly table:MapLike<Entry>;}
const table:Record<string,Entry>={};
const payload={kind:'Enum' as const,table};
const base:Base=payload;const view=base as Holder;
const result=Object.entries(view.table);console.log(`${result.length}`);
for(const item of result){const value=item[1];console.log(`${value.name}`);}
