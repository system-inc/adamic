interface Options { readonly [key: string]: boolean | undefined; }
interface Base { readonly kind: 'Options'; }
interface Holder extends Base { readonly options: Options; }
function read(holder: Holder): void {
    console.log(`${holder.options['strict']}`);
}
const payload = { kind: 'Options' as const, options: { strict: 42 } };
const holder: Base = payload;
read(holder as Holder);
