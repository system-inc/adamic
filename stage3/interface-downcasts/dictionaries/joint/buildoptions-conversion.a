interface MapLike<T> { [key:string]:T; }
interface PluginImport { name:string; }
interface ProjectReference { path:string; }
type CompilerOptionsValue = string | number | boolean | (string|number)[] | string[] | MapLike<string[]> | PluginImport[] | ProjectReference[] | null | undefined;
interface BuildOptions { [key:string]:CompilerOptionsValue; }
interface Base { readonly kind:'options'; }
interface Carrier extends Base { readonly child:BuildOptions; }
const raw={kind:'options' as const,child:{item:{name:['built'.concat('-value')]}}};
const base:Base=raw;
const carrier=base as Carrier;
const selected=carrier.child['item'];
const dictionary=selected as {readonly [key:string]:string[]|undefined};
const values=dictionary['name'];
console.log(values===undefined ? 'missing' : values[0] ?? 'missing');
