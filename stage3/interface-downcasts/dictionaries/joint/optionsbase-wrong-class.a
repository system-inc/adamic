import type { OptionsBase } from 'original-tsc-commandLineParser';
interface Base { readonly kind:'options'; }
interface Carrier extends Base { readonly child:OptionsBase; }
class Entry {}
const raw={kind:'options' as const,child:{item:new Entry()}};
const base:Base=raw;
const carrier=base as Carrier;
const selected=carrier.child['item'];
const dictionary=selected as {readonly [key:string]:string[]|undefined};
console.log(typeof dictionary);
