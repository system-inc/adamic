namespace Debug {
 export function log(message:string):void{console.log('log:'+message);}
 export namespace log {
  export let level:number=1;
  export function error(this:{level:number},message:string):void{console.log(`error:${this.level}:${message}`);}
 }
}
Debug.log('first');
Debug.log.error('second');
Debug.log.level=2;
Debug.log.error('third');
console.log(`${Debug.log===Debug.log}:${Debug.log.error===Debug.log.error}:${Debug.log!==Debug.log.error}`);
function print(message:string):void{console.log('print:'+message);}
namespace print {export const level:number=3;}
print('fourth');
console.log(`${print.level}:${print===print}`);
