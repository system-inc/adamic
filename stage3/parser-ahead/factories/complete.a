interface Node { readonly kind: 'identifier' | 'other'; pos:number; end:number; }
interface Identifier extends Node { readonly kind:'identifier'; text:string; }
function createBaseNode():Node { return {kind:'identifier',pos:-1,end:-1}; }
function createIdentifier(text:string):Identifier {
 const node=createBaseNode() as Identifier;
 node.text=text;
 node.pos=0;
 node.end=text.length;
 return node;
}
console.log(createIdentifier('ready').text);
