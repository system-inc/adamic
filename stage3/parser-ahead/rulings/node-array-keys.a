interface NodeArray<T> extends Array<T>{pos:number;end:number;hasTrailingComma:boolean;transformFlags:number;}
const nodes=[1,2] as NodeArray<number>;
console.log(Object.keys(nodes).join(','));
console.log(String('pos' in nodes));
nodes.end=7;
nodes.pos=-1;
nodes.transformFlags=1;
nodes.hasTrailingComma=true;
console.log(Object.keys(nodes).join(','));
console.log(String(Array.isArray(nodes)));
