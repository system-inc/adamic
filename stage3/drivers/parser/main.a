// Run from the adapted tree root. run.sh stages this driver there.
import { panic, programArguments, readTextFile } from 'adamic';
import { createSourceFile, forEachChild } from './src/compiler/parser.ts';
import { flattenDiagnosticMessageText } from './src/compiler/program.ts';
import { unescapeLeadingUnderscores } from './src/compiler/utilitiesPublic.ts';
import { ScriptKind, ScriptTarget, SyntaxKind } from './src/compiler/types.ts';
import type { Identifier, JSDoc, JSDocComment, JSDocContainer, JSDocTag, LiteralLikeNode, Node, NodeArray, PrivateIdentifier } from './src/compiler/types.ts';
import { kindNames } from './kinds.a';

function written(text: string): string {
    let result = '';
    for(let index = 0; index < text.length; index++) {
        const code = text.charCodeAt(index);
        result += code >= 32 && code <= 126 && code !== 92
            ? text.slice(index, index + 1)
            : `\\u${code.toString(16).padStart(4, '0')}`;
    }
    return result;
}

function nodeText(node: Node): string {
    switch(node.kind) {
        case SyntaxKind.Identifier:
            return unescapeLeadingUnderscores((node as Identifier).escapedText);
        case SyntaxKind.PrivateIdentifier:
            return unescapeLeadingUnderscores((node as PrivateIdentifier).escapedText);
        case SyntaxKind.JsxText:
        case SyntaxKind.JsxTextAllWhiteSpaces:
        case SyntaxKind.NumericLiteral:
        case SyntaxKind.BigIntLiteral:
        case SyntaxKind.StringLiteral:
        case SyntaxKind.RegularExpressionLiteral:
        case SyntaxKind.NoSubstitutionTemplateLiteral:
        case SyntaxKind.TemplateHead:
        case SyntaxKind.TemplateMiddle:
        case SyntaxKind.TemplateTail:
            return (node as LiteralLikeNode).text;
        case SyntaxKind.JSDocText:
        case SyntaxKind.JSDocLink:
        case SyntaxKind.JSDocLinkCode:
        case SyntaxKind.JSDocLinkPlain:
            return (node as JSDocComment).text;
        default:
            return '';
    }
}

function commentDetails(comment: string | NodeArray<JSDocComment> | undefined): string {
    if (comment === undefined) { return 'absent'; }
    if (typeof comment === 'string') { return `text ${written(comment)}`; }
    let result = `parts ${comment.length}`;
    for (const part of comment) {
        result += `\t${kindNames[part.kind] ?? panic('unknown comment kind')}:${written(part.text)}`;
    }
    return result;
}

function jsDocDetails(node: Node): string {
    if (node.kind === SyntaxKind.JSDoc) {
        return `\tcomment ${commentDetails((node as JSDoc).comment)}`;
    }
    if (node.kind >= SyntaxKind.FirstJSDocTagNode && node.kind <= SyntaxKind.LastJSDocTagNode) {
        const tag = node as JSDocTag;
        return `\ttagName ${written(unescapeLeadingUnderscores(tag.tagName.escapedText))}\tcomment ${commentDetails(tag.comment)}`;
    }
    return '';
}

function dump(node: Node): void {
    const pending: Node[] = [node];
    while (pending.length > 0) {
        const current = pending.pop() ?? panic('missing pending node');
        console.log(`${kindNames[current.kind] ?? panic('unknown node kind')} ${current.pos} ${current.end} ${current.flags}\t${written(nodeText(current))}${jsDocDetails(current)}`);
        const children: Node[] = [];
        for (const doc of (current as JSDocContainer).jsDoc ?? []) { children.push(doc); }
        forEachChild(current, child => { children.push(child); });
        for (let index = children.length - 1; index >= 0; index--) {
            pending.push(children[index] ?? panic('missing child node'));
        }
    }
}

const args = programArguments();
const tree = args[0] ?? panic('missing adapted tree');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') { panic(manifest.message); }
for(const name of manifest.text.split('\n')) {
    if(name === '') { continue; }
    const input = readTextFile(`${tree}/src/compiler/${name}`);
    if(input.kind === 'Error') { panic(input.message); }
    const kind = name.endsWith('.tsx') ? ScriptKind.TSX
        : name.endsWith('.jsx') ? ScriptKind.JSX
        : name.endsWith('.js') || name.endsWith('.mjs') || name.endsWith('.cjs') ? ScriptKind.JS
        : ScriptKind.TS;
    const file = createSourceFile(name, input.text, ScriptTarget.Latest, false, kind);
    console.log(`file\t${written(name)}`);
    dump(file);
    console.log(`diagnostics ${file.parseDiagnostics.length}`);
    for(const diagnostic of file.parseDiagnostics) {
        console.log(`diagnostic ${diagnostic.category} ${diagnostic.code} ${diagnostic.start ?? -1} ${diagnostic.length ?? -1}\t${written(flattenDiagnosticMessageText(diagnostic.messageText, '\n'))}`);
    }
    console.log(`jsDocDiagnostics ${file.jsDocDiagnostics?.length ?? 0}`);
    for (const diagnostic of file.jsDocDiagnostics ?? []) {
        console.log(`jsDocDiagnostic ${diagnostic.category} ${diagnostic.code} ${diagnostic.start ?? -1} ${diagnostic.length ?? -1}\t${written(flattenDiagnosticMessageText(diagnostic.messageText, '\n'))}`);
    }
}
