// The stage-1 witness: kinds, UTF-16 positions/ends and identifier text only.
import { panic, programArguments, readTextFile } from 'adamic';
import { Parser } from '../../../stage1/typescript/parser/parser.ts';
import { written } from '../../../stage1/typescript/parser/nodes.ts';
import type { ParseNode } from '../../../stage1/typescript/parser/nodes.ts';

function dump(nodes: readonly ParseNode[], index: number): void {
    const node = nodes[index] ?? panic('missing witness node');
    const kind = node.kind === 'EndOfFile' ? 'EndOfFileToken' : node.kind;
    const text = kind === 'Identifier' || kind === 'PrivateIdentifier' ? node.text : '';
    console.log(`${kind} ${node.pos} ${node.end}\t${written(text)}`);
    for(const child of node.children) { dump(nodes, child); }
}

const args = programArguments();
const tree = args[0] ?? panic('missing tree');
const manifest = readTextFile(args[1] ?? panic('missing manifest'));
if(manifest.kind === 'Error') { panic(manifest.message); }
for(const name of manifest.text.split('\n')) {
    // The stage-1 port does not recover a TypeScript parse of the JSON inputs.
    if(!name.endsWith('.ts')) { continue; }
    const source = readTextFile(`${tree}/src/compiler/${name}`);
    if(source.kind === 'Error') { panic(source.message); }
    const parser = new Parser(source.text, name);
    const root = parser.file();
    console.log(`file\t${written(name)}`);
    dump(parser.nodes, root);
}
