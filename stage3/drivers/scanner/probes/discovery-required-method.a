interface Scanner {
    setText(text: string): void;
    getEnd(): number;
}
function createScanner(): Scanner {
    let end = 0;
    function setText(newText: string): void {
        end = newText.length;
    }
    return { setText, getEnd: () => end };
}
const scanner = createScanner();
scanner.setText('let x = 1;\n');
console.log(`${scanner.getEnd()}`);
