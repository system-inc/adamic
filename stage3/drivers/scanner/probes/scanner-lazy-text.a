// Scanner's original initialization and first setText call, including absence.
function createScanner(textInitial?: string): () => string {
    var text = textInitial!;
    setText(text);
    return () => text;
    function setText(newText: string | undefined): void {
        text = newText || '';
    }
}
console.log('[' + createScanner()() + ']');
console.log('[' + createScanner('source')() + ']');
