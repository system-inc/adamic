import type {} from 'node:util';
import { createScanner } from './adapted/src/compiler/scanner.ts';
import { ScriptTarget, SyntaxKind } from './adapted/src/compiler/types.ts';
import { tokenNames } from './token-names.a';
import { panic, programArguments, readTextFile } from 'adamic';

const scanner = createScanner(ScriptTarget.Latest, /*skipTrivia*/ true);
for (const path of programArguments()) {
    const input = readTextFile(path);
    if (input.kind === 'Error') {
        panic(input.message);
    }
    scanner.setText(input.text);
    while (true) {
        const kind = scanner.scan();
        console.log(`${tokenNames[kind] ?? panic('missing SyntaxKind name')}\t${scanner.getTokenFullStart()}\t${scanner.getTokenStart()}\t${scanner.getTokenEnd()}\t${scanner.getTokenFlags()}\t${JSON.stringify(scanner.getTokenText())}`);
        if (kind === SyntaxKind.EndOfFileToken) {
            break;
        }
    }
}
