// The harness supplies the actual driver functions or Node's JSON.stringify.
export function exerciseEscaper(escape: (text: string) => string, format: (value: string | number | undefined) => string): void {
    let ascii = '';
    for (let code = 0; code <= 0x7f; code++) {
        const text = String.fromCharCode(code);
        console.log(escape(text));
        ascii += text;
    }
    console.log(escape(ascii));
    for (const text of ['', '\ud83d\ude00', '\ud800\udc00', '\udbff\udfff', 'a\ud83d\ude00b', '\ud800', '\udfff', '\ud800x', '\ud800\ud800\udc00', '\udc00\ud800', '\u2028\u2029']) {
        console.log(escape(text));
    }
    console.log(format('quote"slash\\\n'));
    console.log(format(42));
    console.log(format(-0));
    console.log(format(1.25));
    console.log(format(undefined));
}
