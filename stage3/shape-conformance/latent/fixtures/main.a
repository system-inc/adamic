interface Base {readonly kind:'ok'|'other';}
interface Ready extends Base {readonly kind:'ok';readonly ready:boolean;}
const diagnosedModule:number='bad';
function make():Ready {return {kind:'ok',ready:true};}
function read(node:Base):Ready {return node as Ready;}
const good=read(make());
function staged():Ready {return {kind:'ok',ready:undefined!};}
function stageRead():Ready {const node:Base=staged();return node as Ready;}
function wrong():Ready {const raw={kind:'ok' as const,ready:0};const node:Base=raw;return node as Ready;}
function hostRead():Ready {const node:Base=JSON.parse('{}');return node as Ready;}
function diagnosed(node:Base):Ready {const error:number='bad';return node as Ready;}
function incoming(node:Base):Ready {return node as Ready;}
function broken():void {const error:number='bad';incoming({kind:'ok',ready:true});}
function callback(node:Base):Ready {return node as Ready;}
const escapedCallback=callback;
function forged():Ready {const raw={kind:'ok' as const,ready:0 as unknown as boolean};const node:Base=raw;return node as Ready;}
function hostField():Ready {const raw={kind:'ok' as const,ready:JSON.parse('false') as boolean};const node:Base=raw;return node as Ready;}
interface Unsafe extends Base {readonly kind:'ok';readonly unsafe:boolean;}
function aliased():Unsafe {const raw={kind:'ok' as const,unsafe:true};const wide:{unsafe:boolean|number}=raw;wide.unsafe=0;const node:Base=raw;return node as Unsafe;}
function rejectedOuter():void {
 const error:number='bad';
 function nestedClean():Ready {const exact:Ready={kind:'ok',ready:true};const node:Base=exact;return node as Ready;}
}
function rejectedCapture():void {
 const raw:Ready={kind:'ok',ready:true};const error:number='bad';
 function nestedCapture():Ready {const node:Base=raw;return node as Ready;}
}

function propertyRead():Ready {const holder={pristineChild:make()};const node:Base=holder.pristineChild;return node as Ready;}
function stringKeyRead():Ready {const holder={keyChild:make()};const node:Base=holder['keyChild'];return node as Ready;}
function arrayRead():Ready {const values=[make()];const node:Base=values[0]!;return node as Ready;}
function storeRead():Ready {const holder:{storeChild:Base}={storeChild:make()};const wrong={kind:'ok' as const,ready:0};holder.storeChild=wrong;const node:Base=holder.storeChild;return node as Ready;}
function opaqueStore(holder:{opaqueChild:Base}):void {holder.opaqueChild=make();}
function opaqueRead():Ready {const holder={opaqueChild:make()};const node:Base=holder.opaqueChild;return node as Ready;}
function rejectedStore(holder:{diagnosedChild:Base}):void {const error:number='bad';holder.diagnosedChild=make();}
function diagnosedStoreRead():Ready {const holder={diagnosedChild:make()};const node:Base=holder.diagnosedChild;return node as Ready;}
function hostThroughField():Ready {const holder={hostChild:JSON.parse('{}')};const node:Base=holder.hostChild;return node as Ready;}

interface Augmented extends Array<Ready> {readonly stamp:number;}
function augmentedArray():Augmented {const values=[make()];return values as Augmented;}

function closedCallback(node:Base):Ready {return node as Ready;}
function closedInvoke(callback:(node:Base)=>Ready,node:Base):Ready {return callback(node);}
const closedAlias=closedCallback;
closedInvoke(closedAlias,make());
function returnedCallback(node:Base):Ready {return node as Ready;}
function callbackFactory():(node:Base)=>Ready {return returnedCallback;}
closedInvoke(callbackFactory(),make());
function mixedCallback(node:Base):Ready {return node as Ready;}
function mixedInvoke(callback:(node:Base)=>Ready,node:Base):Ready {return callback(node);}
const mixedWrong={kind:'ok' as const,ready:0};
mixedInvoke(mixedCallback,mixedWrong);
function hostCallback(node:Base):Ready {return node as Ready;}
const hostSink=JSON.parse('null') as (callback:(node:Base)=>Ready)=>void;
hostSink(hostCallback);
function genericCallback(node:Base):Ready {return node as Ready;}
function genericSink<T>(callback:(node:Base)=>Ready):void {}
genericSink(genericCallback);
function diagnosedCallback(node:Base):Ready {return node as Ready;}
function diagnosedSink(callback:(node:Base)=>Ready):void {const error:number='bad';}
diagnosedSink(diagnosedCallback);
