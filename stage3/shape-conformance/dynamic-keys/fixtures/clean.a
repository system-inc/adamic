interface Base {readonly kind:'ok'|'other';}
interface Ready extends Base {readonly kind:'ok';readonly ready:boolean;}
const rejectedModule:number='bad';
function make():Ready {return {kind:'ok',ready:true};}
function finiteString():Ready {const holder={first:make(),second:make()};const key=true?'first':'second';const node:Base=holder[key];return node as Ready;}
function finiteNumber():Ready {const values=[make(),make()];const key=true?0:1;const node:Base=values[key]!;return node as Ready;}
function wrongString():Ready {const holder={first:make(),second:{kind:'ok' as const,ready:0}};const key='second';const node:Base=holder[key];return node as Ready;}
function wrongNumber():Ready {const values=[make(),{kind:'ok' as const,ready:0}];const key=1;const node:Base=values[key]!;return node as Ready;}
function openKey(key:string):Ready {const holder:Record<string,Base>={first:make(),second:make()};const node:Base=holder[key]!;return node as Ready;}
function absentKey():Ready {const holder:Record<string,Base>={first:make()};const key='absent';const node:Base=holder[key]!;return node as Ready;}
