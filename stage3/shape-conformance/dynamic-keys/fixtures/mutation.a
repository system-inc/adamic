interface Base {readonly kind:'ok'|'other';}
interface Ready extends Base {readonly kind:'ok';readonly ready:boolean;}
const rejectedModule:number='bad';
function make():Ready {return {kind:'ok',ready:true};}
function indexedStore():Ready {const holder:Record<string,Base>={first:make()};const key='first';const replacement:Ready={kind:'ok',ready:false};holder[key]=replacement;const node:Base=holder[key]!;return node as Ready;}
function directStore():Ready {const raw={kind:'ok' as const,ready:true};const wide:Record<string,unknown>=raw;const key='ready';wide[key]=0;const node:Base=raw;return node as Ready;}
