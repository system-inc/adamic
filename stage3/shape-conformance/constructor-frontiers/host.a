interface Base {readonly kind:'ok'|'other';}
interface Ready extends Base {readonly kind:'ok';readonly ready:boolean;}
const rejectedModule:number='bad';
const hostConstructor=JSON.parse('null') as new()=>Ready;
class ReadyObject {readonly kind='ok' as const;readonly ready=true;constructor(value?:Base) {}}
function hostConstructorRead():Ready {const node:Base=new hostConstructor();return node as Ready;}
function hostArgumentRead():Ready {const node:Base=new ReadyObject(JSON.parse('{}'));return node as Ready;}
