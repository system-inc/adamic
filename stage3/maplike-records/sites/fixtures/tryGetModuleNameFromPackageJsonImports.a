// TypeScript 050880ce59e30b356b686bd3144efe24f875ebc8: moduleSpecifiers.ts:1165:121
interface MapLike<T> { [key: string]: T; }
const imports: unknown = {'#one': './one' + String(1), '#': './invalid', '#/bad': './invalid'};
for (const k of Object.keys(imports as MapLike<unknown>)) {
    if (!k.startsWith('#') || k === '#' || k.startsWith('#/')) continue;
    const target = (imports as MapLike<unknown>)[k];
    if (typeof target === 'string') console.log(k + ':' + target);
}
