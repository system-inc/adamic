interface MapLike<T> { [key: string]: T; }
const textToKeywordObj: MapLike<number> = {if: 1, for: 2, while: 3};
textToKeywordObj['keyword' + String(1)] = 4;
const entries = Object.entries(textToKeywordObj);
for (const [word, token] of entries) console.log(word + ':' + String(token));
