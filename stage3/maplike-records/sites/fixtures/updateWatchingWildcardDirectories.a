interface MapLike<T> { [key: string]: T; }
const wildcardDirectories: MapLike<number> = {};
const name = 'dir' + String(1);
wildcardDirectories[name] = 1; wildcardDirectories['10'] = 2; wildcardDirectories['2'] = 1;
const existingWatchedForWildcards = new Map(Object.entries(wildcardDirectories));
for (const [key, flags] of existingWatchedForWildcards) console.log(key + ':' + String(flags));
delete wildcardDirectories[name]; wildcardDirectories[name] = 2;
for (const [key, flags] of Object.entries(wildcardDirectories)) console.log(key + ':' + String(flags));
