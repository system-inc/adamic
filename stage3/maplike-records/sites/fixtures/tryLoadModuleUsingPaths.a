interface MapLike<T> { [key: string]: T; }
function forEach<T>(array: readonly T[] | undefined, callback: (value: T) => string | undefined): string | undefined {
    if (array !== undefined) for (const item of array) { const value = callback(item); if (value) return value; }
    return undefined;
}
