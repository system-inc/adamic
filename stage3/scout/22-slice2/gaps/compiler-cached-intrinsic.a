// a-check: refused a method read as a value (hasOwnProperty would lose its object, and this with it); call it in an arrow that keeps the object: (v) => its object.hasOwnProperty(v) (unbound-method)
// Compiler ruling 2. Cached intrinsic signature must come from provenance, without an annotation.
const hasOwnProperty = Object.prototype.hasOwnProperty;
console.log(`${hasOwnProperty.call({key:1}, "key")}`);
