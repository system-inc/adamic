import { handleRequest } from './service.a';
import { programArguments, readTextFile } from 'adamic';

function serveBatch(requests: readonly string[], verify: boolean): number {
	let checksum = 0;
	for (const request of requests) {
		const response = handleRequest(request);
		checksum += response.length;
		if (verify) { console.log(response); }
	}
	return checksum;
}

const argumentsList = programArguments();
const input = readTextFile(argumentsList[0] ?? '');
if (input.kind === 'Ok') {
	const requests = input.text.split('\n').slice(0, -1);
	if (argumentsList[1] === 'warm') { serveBatch(requests, false); }
	console.error('serve:start');
	const checksum = argumentsList[1] === 'control' ? requests.length : serveBatch(requests, argumentsList[1] === 'verify');
	console.error('serve:stop');
	console.log(`${checksum}`);
} else { console.error(input.message); }
