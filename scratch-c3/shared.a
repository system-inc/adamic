// A probe of Emit's shared-value row: two members of one value compared under &&, written into a third's slot.
enum K { A = 1, B = 1, C = 2 }
function kindOf(n: number): K {
	return n;
}
function take(x: K.C): string {
	return "took " + String(x);
}
function shared(n: number): string {
	const t = kindOf(n);
	if (t === K.A && t === K.B) {
		return take(t);
	}
	return "skip";
}
console.log(shared(1) + ", " + shared(2));
