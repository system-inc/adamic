# The keeps-nullish one-list follow-up (Performance, #eg3krrp): castProof.checksRoad read by castRoadValue,
# keepsNullishValue and keptCheckDowncastRefusal. Source after environment.sh, cloud/sandboxed-job.sh, sandboxed_npm
# stage3/api and sandboxed_products. Never merged.
set -u
fail=0
P=./internal/lower
pins='^(TestKeepsNullishCast.*|TestUntaggedUnionCast.*|TestAbsentArm.*|TestCastDropsNullish.*|TestCastStopNamesItsCause|TestStructuralViewCast.*)$'
out=$(gofmt -l internal/lower); [ -z "$out" ] && echo "PASS gofmt" || { echo "FAIL gofmt: $out"; fail=1; }
go vet $P > "$TMPDIR/vet.log" 2>&1 && echo "PASS vet" || { echo "FAIL vet"; head -20 "$TMPDIR/vet.log"; fail=1; }
go test -count=1 -v -run "$pins" $P > "$TMPDIR/pins.log" 2>&1; r=$?
grep -E -- '^\s*--- FAIL|_test.go:[0-9]+:' "$TMPDIR/pins.log" | cut -c1-400 | head -30
echo "pins: $(grep -cE -- '^\s*--- PASS' "$TMPDIR/pins.log") passed, $(grep -cE -- '^\s*--- FAIL' "$TMPDIR/pins.log") failed"
[ $r = 0 ] && echo "PASS pins" || { echo "FAIL pins"; fail=1; }
echo "== mutant: checksRoad without the untagged arm"
cp internal/lower/cast.go "$TMPDIR/cast.keep"
python3 -I -c 'import sys; p=sys.argv[1]; t=open(p).read(); o="return proof.overlap || proof.untagged || "; assert t.count(o)==1; open(p,"w").write(t.replace(o,"return proof.overlap || "))' internal/lower/cast.go || { echo "FAIL mutant: not applied"; fail=1; }
if go vet $P > "$TMPDIR/mvet.log" 2>&1; then
	echo "compiles"
	go test -count=1 -v -run "$pins" $P > "$TMPDIR/m.log" 2>&1
	grep -E -- '^\s*--- FAIL' "$TMPDIR/m.log" | cut -c1-200 | head -10
	for red in 'TestKeepsNullishCastOverTheUntaggedArmIsChecked' 'TestUntaggedUnionCastsKeepTheirStops/in_.a'; do
		grep -qE -- "^\s*--- FAIL: ${red}" "$TMPDIR/m.log" && echo "PASS mutant red: $red" || { echo "FAIL mutant survived at: $red"; fail=1; }
	done
else
	echo "FAIL mutant: doesn't compile"; head -5 "$TMPDIR/mvet.log"; fail=1
fi
cp "$TMPDIR/cast.keep" internal/lower/cast.go
echo "== internal/lower, stage3/fixtures and internal/oracle whole"
go test -count=1 -timeout 100m $P ./stage3/fixtures ./internal/oracle > "$TMPDIR/whole.log" 2>&1; r=$?
grep -E -- '^(ok|FAIL)|--- FAIL|panic:' "$TMPDIR/whole.log" | cut -c1-300 | head -30
[ $r = 0 ] && echo "PASS whole" || { echo "FAIL whole"; grep -E '_test.go:[0-9]+:' "$TMPDIR/whole.log" | grep -v 'gate cache' | cut -c1-300 | head -30; fail=1; }
[ $fail = 0 ] && echo "VERDICT PASS" || { echo "VERDICT FAIL"; false; }
