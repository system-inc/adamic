# #k8ed1f2: implements-types' census, both sides in this one job on one box: the base side first (the adaptation's
# directory set aside), then the with side, each in a scratch directory of its own. Run after environment.sh,
# sandboxed-job.sh, sandboxed_typescript_source and sandboxed_npm stage3/api stage3/typescript. Never merged.
set -u
F="sys.ts program.ts checker.ts watchPublic.ts tsbuildPublic.ts builder.ts ../tsc/tsc.ts"
D=stage3/adapt/99-readonly-family3-implements-types
ROOT=$TMPDIR
mkdir -p "$ROOT/base" "$ROOT/with"
mv "$D" "$ROOT/aside" && TMPDIR="$ROOT/base" bash proof/performance/k8ed1f2-ea3/census base $F; code=$?; mv "$ROOT/aside" "$D"; [ $code = 0 ] || exit $code
TMPDIR="$ROOT/with" bash proof/performance/k8ed1f2-ea3/census with $F
