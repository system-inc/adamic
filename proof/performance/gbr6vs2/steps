# #gbr6vs2 proof (Performance): the structural view over an intersection source that reads a field narrower. Source
# after environment.sh, cloud/sandboxed-job.sh, sandboxed_npm stage3/api and sandboxed_products. Never merged.
set -u
fail=0
P=./internal/lower
pins='^(TestIntersectionFieldRefinement.*|TestCastStopNamesItsCause|TestStructuralViewCast.*|TestUntaggedUnionCast.*|TestAbsentArm.*)$'
opins='^(TestIntersectionFieldRefinementView|TestObjectUnionTargetCast|TestUntaggedUnionTargetCast)$'
out=$(gofmt -l internal/lower internal/oracle); [ -z "$out" ] && echo "PASS gofmt" || { echo "FAIL gofmt: $out"; fail=1; }
go vet $P ./internal/oracle > "$TMPDIR/vet.log" 2>&1 && echo "PASS vet" || { echo "FAIL vet"; head -20 "$TMPDIR/vet.log"; fail=1; }
go test -count=1 -v -run "$pins" $P > "$TMPDIR/pins.log" 2>&1; r=$?
grep -E -- '^\s*--- FAIL|_test.go:[0-9]+:' "$TMPDIR/pins.log" | cut -c1-400 | head -30
echo "pins: $(grep -cE -- '^\s*--- PASS' "$TMPDIR/pins.log") passed, $(grep -cE -- '^\s*--- FAIL' "$TMPDIR/pins.log") failed"
[ $r = 0 ] && echo "PASS pins" || { echo "FAIL pins"; fail=1; }
go test -count=1 -v -run "$opins" ./internal/oracle > "$TMPDIR/opins.log" 2>&1; r=$?
grep -E -- '^\s*--- (PASS|FAIL)|_test.go:[0-9]+:' "$TMPDIR/opins.log" | grep -v 'gate cache\|oracle_test.go:6' | cut -c1-400 | head -30
[ $r = 0 ] && echo "PASS oracle pins" || { echo "FAIL oracle pins"; fail=1; }
mutant() {
	local label=$1 file=$2 old=$3 new=$4 all=$5 red=$6 package=$7 run=$8 vet=$9
	echo "== mutant: $label"
	cp "$file" "$TMPDIR/keep"
	python3 -I - "$file" "$old" "$new" "$all" <<'PY' || { echo "FAIL mutant $label: not applied"; fail=1; return; }
import sys
path, old, new, every = sys.argv[1:]
text = open(path).read()
count = text.count(old)
if count == 0 or every == "one" and count != 1:
    sys.exit(1)
open(path, "w").write(text.replace(old, new))
print("applied", count)
PY
	go vet $vet > "$TMPDIR/mvet.log" 2>&1 || { echo "FAIL mutant $label: doesn't compile"; head -5 "$TMPDIR/mvet.log"; fail=1; cp "$TMPDIR/keep" "$file"; return; }
	echo "compiles"
	go test -count=1 -v -run "$run" $package > "$TMPDIR/m.log" 2>&1
	grep -E -- '^\s*--- FAIL' "$TMPDIR/m.log" | cut -c1-200 | head -8
	grep -qE -- "^\s*--- FAIL: ${red}" "$TMPDIR/m.log" && echo "PASS mutant red: $label" || { echo "FAIL mutant survived: $label"; fail=1; }
	cp "$TMPDIR/keep" "$file"
}
arm='source.Flags()&checker.TypeFlagsIntersection != 0 && l.objectCastCause(source, target) == castFieldRefinement'
mutant "castRoad without its intersection arm" internal/lower/cast_proof.go "$arm" "false && $arm" one 'TestIntersectionFieldRefinementLowersAsAStructuralView' $P "$pins" $P
mutant "castRoad without its arm, on the oracle" internal/lower/cast_proof.go "$arm" "false && $arm" one 'TestIntersectionFieldRefinementView' ./internal/oracle "$opins" $P
mutant "structuralViewCast refusing an intersection source again" internal/lower/view_objects.go 'source.Flags()&checker.TypeFlagsObject == 0 && source.Flags()&checker.TypeFlagsIntersection == 0 ||' 'source.Flags()&checker.TypeFlagsObject == 0 ||' one 'TestIntersectionFieldRefinementLowersAsAStructuralView' $P "$pins" $P
mutant "the arm without its castFieldRefinement condition" internal/lower/cast_proof.go ' && l.objectCastCause(source, target) == castFieldRefinement) && target' ') && target' one 'TestIntersectionFieldRefinementKeepsItsStops' $P "$pins" $P
mutant "the union read's kind test accepts any kind" internal/native/view_unions_read.go '(void)adamic_view_mixed_union_select(' 'if (0) (void)adamic_view_mixed_union_select(' all 'TestIntersectionFieldRefinementView' ./internal/oracle "$opins" ./internal/native
echo "== internal/lower, stage3/fixtures and internal/oracle whole"
go test -count=1 -timeout 100m $P ./stage3/fixtures ./internal/oracle > "$TMPDIR/whole.log" 2>&1; r=$?
grep -E -- '^(ok|FAIL)|--- FAIL|panic:' "$TMPDIR/whole.log" | cut -c1-300 | head -30
[ $r = 0 ] && echo "PASS whole" || { echo "FAIL whole"; grep -E '_test.go:[0-9]+:' "$TMPDIR/whole.log" | grep -v 'gate cache' | cut -c1-300 | head -30; fail=1; }
[ $fail = 0 ] && echo "VERDICT PASS" || { echo "VERDICT FAIL"; false; }
