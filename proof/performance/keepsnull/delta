# #b5w3ycg keeps-nullish (compiler/cast-keeps-nullish-5): the admission delta against castRoad 6c27dafd, the head's
# parent, with the corpus manifest, so only keeps-nullish's own rows can move and its lie is read as a witness.
# Source it in the job's shell after the sealed opening, sandboxed_repositories and sandboxed_npm stage3/api. Never merged.
L="$TMPDIR/knd"; mkdir -p "$L"
echo "on $(hostname), $(nproc) cores, load $(cut -d' ' -f1-3 /proc/loadavg)"
base=6c27dafdd0
python3 -I cloud/admission-corpus/manifest.py --sha "$(git rev-parse HEAD)" > "$L/manifest.json"; code=$?
if [ $code -ne 0 ]; then echo "FAIL manifest exit $code"; echo "VERDICT FAIL"; return 1 2>/dev/null || exit 1; fi
python3 -I -c 'import json,sys; m=json.load(open(sys.argv[1])); print(" ".join("%s=%d" % (c["name"], len(c["programs"])) for c in m["corpora"]))' "$L/manifest.json"
echo "manifest ok"
go run ./cmd/adamic-admission-delta --base "$(git rev-parse "$base")" --manifest "$L/manifest.json" > "$L/delta.log" 2>&1; code=$?
echo "delta exit $code"
grep -nE 'cast_keeps_nullish|cast_drops_nullish' "$L/delta.log" | cut -c1-300 | head -20
tail -14 "$L/delta.log" | cut -c1-300
if [ $code -eq 0 ] && grep -q 'verdict: pass' "$L/delta.log"; then echo "VERDICT PASS"; else echo "VERDICT FAIL"; fi
