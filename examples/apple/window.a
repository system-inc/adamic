// window.a: an Adamic program that opens a real window on a Mac, through AppKit, with no
// Objective-C or Swift written. Build it with `adamic build examples/apple/window.a`.

import { Application } from 'apple/appkit/application';
import { Button } from 'apple/appkit/button';
import { TextField } from 'apple/appkit/text-field';
import { View } from 'apple/appkit/view';
import { Window } from 'apple/appkit/window';

const dedication = 'In dedication, with gratitude, to Kenneth Lane Thompson, whose work we stand on. - Kirk and Ahra';

const application = Application.shared;
application.setActivationPolicy('Regular');

const window = new Window({ contentRectangle: { x: 0, y: 0, width: 560, height: 220 }, styleMask: ['Titled', 'Closable', 'Miniaturizable'], backing: 'Buffered', defer: false });
window.title = 'Adamic';

const content = new View({ frame: { x: 0, y: 0, width: 560, height: 220 } });
const label = TextField.label({ with: dedication });
label.setFrame({ x: 20, y: 130, width: 520, height: 60 });
const counter = TextField.label({ with: 'Not pressed yet' });
counter.setFrame({ x: 20, y: 80, width: 520, height: 24 });

let presses = 0;
const button = new Button({
	title: 'Press',
	action: () => {
		presses += 1;
		counter.stringValue = `Pressed ${presses} ${presses === 1 ? 'time' : 'times'}`;
		console.log(counter.stringValue);
	},
});
button.setFrame({ x: 20, y: 24, width: 120, height: 32 });

content.addSubview(label);
content.addSubview(counter);
content.addSubview(button);
window.contentView = content;

window.center();
window.makeKeyAndOrderFront(undefined);
application.activate();
console.log(`${window.title}: ${window.isVisible ? 'visible' : 'hidden'}`);
application.run();
