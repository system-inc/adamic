// nexus/shouting.go:125; `\b[A-Z][A-Z0-9_]*\b`
import { observe } from '../observe.a';
const pattern = "\\b[A-Z][A-Z0-9_]*\\b";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "A", 4);
observe(regex, "xA", 5);
observe(regex, "A\n", 6);
observe(regex, "TODO", 7);
observe(regex, "K", 8);
observe(regex, "S", 9);
