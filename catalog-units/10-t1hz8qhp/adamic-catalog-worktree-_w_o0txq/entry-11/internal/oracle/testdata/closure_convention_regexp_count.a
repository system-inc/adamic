function count(match: string): string {
    return `${match}:${arguments.length}`;
}
console.log("ab".replace(/a/, count));
console.log("ab".replace(/(a)(b)/, count));
console.log("ab".replace(/(?<first>a)(b)/, count));
function tail(match: string, ...values: (string | number | undefined)[]): string {
    return `${match}:${arguments.length}:${values.length}:${String(values[0])}:${String(values[1])}`;
}
console.log("ab".replace(/(a)(b)/, tail));
