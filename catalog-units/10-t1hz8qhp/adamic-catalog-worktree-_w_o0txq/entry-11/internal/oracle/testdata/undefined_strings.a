// undefined in every place a string | undefined slot takes it, a return first: a return of undefined
// from a function returning string | undefined once reached clang as an object pointer returned as
// a string's (found writing undefined_keys.a).
function find(index: number): string | undefined {
	if (index > 1) {
		return undefined;
	}
	return `k${index}`;
}
function show(key: string | undefined): string {
	return key ?? 'none';
}
let held: string | undefined = undefined;
console.log(show(held));
held = `h${1}`;
console.log(show(held));
held = undefined;
console.log(`${show(held)} ${show(undefined)} ${show(find(1))} ${show(find(2))}`);
const keys: (string | undefined)[] = [undefined, `k${2}`];
keys.push(undefined);
console.log(`${keys.length} ${show(keys[0])} ${show(keys[2])}`);
const box: { readonly name: string | undefined } = { name: undefined };
console.log(show(box.name));
const pick = (flag: boolean): string | undefined => {
	if (flag) {
		return `p${1}`;
	}
	return undefined;
};
console.log(`${show(pick(true))} ${show(pick(false))}`);
