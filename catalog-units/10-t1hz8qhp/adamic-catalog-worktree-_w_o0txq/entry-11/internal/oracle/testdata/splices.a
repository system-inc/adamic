// splice(start, count, ...items): removes, inserts, and is what it removed, with start and count
// clamped as ECMAScript says.
function show(label: string, removed: number[], left: number[]): void {
	console.log(`${label}: [${removed.join(',')}] [${left.join(',')}]`);
}

let values = [0, 1, 2, 3, 4, 5];
show('middle', values.splice(2, 2), values);
values = [0, 1, 2, 3, 4, 5];
show('insert', values.splice(1, 0, 10, 11, 12), values);
values = [0, 1, 2, 3, 4, 5];
show('replace', values.splice(4, 1, 40), values);
values = [0, 1, 2, 3, 4, 5];
show('negative', values.splice(-2, 1), values);
values = [0, 1, 2, 3, 4, 5];
show('to the end', values.splice(3), values);
values = [0, 1, 2, 3, 4, 5];
show('too many', values.splice(4, 99), values);
values = [0, 1, 2, 3, 4, 5];
show('negative count', values.splice(1, -3, 7), values);
values = [0, 1, 2, 3, 4, 5];
show('NaN', values.splice(0 / 0, 0 / 0, 8), values);
values = [0, 1, 2, 3, 4, 5];
show('past the end', values.splice(99, 1, 6, 7), values);
values = [0, 1, 2, 3, 4, 5];
show('far negative', values.splice(-99, 2), values);
values = [0, 1, 2, 3, 4, 5];
show('fraction', values.splice(1.9, 1.9), values);
values = [0, 1, 2, 3, 4, 5];
show('everything', values.splice(0), values);

// Strings that were made, so a reference moved wrong is a use-after-free or a leak.
const words = ['ant', 'bee', 'cat', 'dog'].map((word) => `${word}s`);
const taken = words.splice(1, 2, 'elk'.repeat(2), `${'fox'}es`);
console.log(`${taken.join(',')} | ${words.join(',')}`);
words.splice(0, 1);
words.splice(words.length, 0, 'gnu');
console.log(words.join(','));
