// A self tail call. clang turns one into a loop unless told not to, and then its frame never moves,
// the stack check never fires, and this printed 0 twice and end. Every call keeps its frame now, so
// the deep one runs out of stack as Node's does. (Shallow enough for Node first: Node stops near ten
// thousand frames, native much deeper, so what has to match is how the deep one ends.)
function count(n: number): number {
	if (n === 0) {
		return 0;
	}
	return count(n - 1);
}
console.log(`${count(1000)}`);
console.log(`${count(1e9)}`);
console.log('end');
