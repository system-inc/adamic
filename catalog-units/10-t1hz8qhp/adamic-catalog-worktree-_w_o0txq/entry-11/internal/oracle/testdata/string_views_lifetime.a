// Small views must retain runtime parents after reassignment and return.
function cut(word: string): string {
    let parent = `${word}/0123456789/end`;
    let outer = parent.slice(2, 14);
    const inner = outer.substring(1, 7);
    parent = 'changed';
    outer = 'gone';
    return inner;
}
for (const word of ['abc', 'é世', '🌍x']) {
    const kept = cut(word);
    console.log(`${kept} ${kept.length} ${kept.charCodeAt(0)} ${kept.at(-1) ?? 'missing'}`);
}
