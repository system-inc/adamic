// From TypeScript 6.0.3, src/compiler/factory/nodeTests.ts:318
// From TypeScript 6.0.3, src/compiler/factory/nodeTests.ts:820
// From TypeScript 6.0.3, src/compiler/utilities.ts:2098
// Census reason: a type predicate

const SyntaxKind = { Identifier: 80, StringLiteral: 11, NumericLiteral: 9, ModuleDeclaration: 268, VoidExpression: 223, PrefixUnaryExpression: 225, NoSubstitutionTemplateLiteral: 15, PlusToken: 40, MinusToken: 41 } as const;
type Identifier = { readonly kind: typeof SyntaxKind.Identifier; readonly escapedText: string };
type StringLiteral = { readonly kind: typeof SyntaxKind.StringLiteral; readonly text: string };
type NumericLiteral = { readonly kind: typeof SyntaxKind.NumericLiteral; readonly text: string };
type NoSubstitutionTemplateLiteral = { readonly kind: typeof SyntaxKind.NoSubstitutionTemplateLiteral; readonly text: string };
type StringLiteralLike = StringLiteral | NoSubstitutionTemplateLiteral;
type ModuleDeclaration = { readonly kind: typeof SyntaxKind.ModuleDeclaration };
type VoidExpression = { readonly kind: typeof SyntaxKind.VoidExpression; readonly expression: NumericLiteral | Identifier };
type PrefixUnaryExpression = { readonly kind: typeof SyntaxKind.PrefixUnaryExpression; readonly operator: number; readonly operand: NumericLiteral | Identifier };
interface Node { readonly kind: number; }
type ModuleName = Identifier | StringLiteral;
type PropertyNameLiteral = Identifier | StringLiteralLike | NumericLiteral;
const identifier: Identifier = { kind: SyntaxKind.Identifier, escapedText: 'x' };
const literal: StringLiteral = { kind: SyntaxKind.StringLiteral, text: 'm' };
const numeric: NumericLiteral = { kind: SyntaxKind.NumericLiteral, text: '0' };

export function isIdentifier(node: Node): node is Identifier {
    return node.kind === SyntaxKind.Identifier;
}

export function isModuleDeclaration(node: Node): node is ModuleDeclaration {
    return node.kind === SyntaxKind.ModuleDeclaration;
}

function isEffectiveModuleDeclaration(node: Node) {
    return isModuleDeclaration(node) || isIdentifier(node);
}

for (const node of [identifier, literal, { kind: SyntaxKind.ModuleDeclaration } as const]) console.log(String(isEffectiveModuleDeclaration(node)));
