// First and subsequent reads on both sides of the index threshold.
function reads(text: string): void {
	console.log(`${text.length} ${text.charCodeAt(0)} ${text.codePointAt(0) ?? -1}`);
	for (const position of [0, -0, 1, 2, 31, 32, 33, text.length - 7, text.length - 6, text.length - 5, text.length - 4, text.length - 3, text.length - 2, text.length - 1, text.length, 1.9, -0.9, -1.9, NaN, Infinity, -Infinity]) {
		console.log(`${position}: ${text.charCodeAt(position)} ${text.codePointAt(position) ?? -1} ${(text[position] ?? '').charCodeAt(0)}`);
	}
}
for (const count of [1, 15, 16, 17, 40]) {
	reads('🌍'.repeat(count));
	reads('é'.repeat(count));
	reads('世'.repeat(count));
	reads('a'.repeat(count));
}
reads(`${'a🌍é世'.repeat(20)}\ud800x\ud800\ud800\udfff\udfff\ud800`);
reads('a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世');
// Start by codePointAt rather than charCodeAt, then append after the view exists.
function grow(): void {
	let text = '🌍'.repeat(20);
	console.log(`${text.codePointAt(0) ?? -1}`);
	for (let round = 0; round < 6; round++) {
		text = text + 'a' + '\ud83c';
		console.log(`${text.length} ${text.charCodeAt(text.length - 1)}`);
		text += '\udf0d';
		console.log(`${text.length} ${text.codePointAt(text.length - 2) ?? -1} ${(text[text.length - 1] ?? '').charCodeAt(0)}`);
	}
}
grow();
