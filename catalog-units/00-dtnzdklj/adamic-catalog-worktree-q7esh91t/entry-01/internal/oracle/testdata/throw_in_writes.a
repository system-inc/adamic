// A field write and an element write whose value throws, after a spread that would reuse a value the
// catch reads.
type Tree = { value: number; label: string };
type Holder = { count: number };
function failNumber(when: boolean): number {
	if (when) {
		throw new Error(`failed${1}`);
	}
	return 1;
}
function fieldWrite(): string {
	const local: Tree = { value: 5, label: `field${5}` };
	const holder: Holder = { count: 0 };
	try {
		const other = { ...local, value: 6 };
		holder.count = failNumber(true);
		return `${other.value}`;
	} catch (error) {
		return `field caught: ${local.value} ${local.label} ${holder.count}`;
	}
}
function elementWrite(): string {
	const local: Tree = { value: 8, label: `element${8}` };
	const numbers: number[] = [1, 2, 3];
	try {
		const other = { ...local, value: 9 };
		numbers[1] = failNumber(true);
		return `${other.value}`;
	} catch (error) {
		return `element caught: ${local.value} ${local.label} ${numbers[1]}`;
	}
}
console.log(fieldWrite());
console.log(elementWrite());
