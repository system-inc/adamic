// find calls its callback even at an index the callback took away, with undefined, which an element
// typed number can't hold: an inserted check, the same in both backends. Found by adamic-fuzz, next
// to seed 138's map: native skipped the index and printed 1,2 where Node printed 1,2,undefined.
const list: number[] = [1, 2, 3];
const seen: string[] = [];
console.log(`${list.find((item) => item > 1) ?? -1}`);
const found = list.find((item) => {
	seen.push(`${item}`);
	console.log(seen.join(','));
	list.pop();
	return false;
});
console.log(`${found ?? -1}`);
