import type { Weak } from 'adamic';
interface Loop {
    pattern: RegExp;
    self: Weak<Loop> | undefined;
}
function loop(): Loop {
    const node: Loop = { pattern: /a/, self: undefined };
    node.self = node;
    return node;
}
const node = loop();
const again = node.self;
console.log(again === undefined ? 'gone' : `${again.pattern.test('a') ? 'yes' : 'no'}`);
