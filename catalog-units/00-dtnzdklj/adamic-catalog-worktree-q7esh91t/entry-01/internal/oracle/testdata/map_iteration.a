// for...of over a Map, in insertion order: an entry added during the loop is visited, an entry
// deleted before the loop gets to it isn't, and a deleted and re-added one comes again at the end.
const ages = new Map<string, number>([['ann', 31], ['bob', 27]]);
ages.set('cat', 40);
for (const [name, age] of ages) {
	console.log(`${name} ${age}`);
}
const names: string[] = [];
for (const name of ages.keys()) {
	names.push(name);
}
let total = 0;
for (const age of ages.values()) {
	total += age;
}
for (const [name] of ages.entries()) {
	names.push(name);
}
console.log(`${names.join(',')} ${total}`);

const changing = new Map<number, string>([[1, 'one'], [2, 'two'], [3, 'three']]);
const seen: string[] = [];
for (const [key, word] of changing) {
	seen.push(word);
	if (key === 1 && word === 'one') {
		changing.delete(2);
		changing.set(4, 'four');
		changing.delete(1);
		changing.set(1, 'one again');
	}
}
console.log(seen.join(','));

// Fill the map, then at its sixth entry delete the five behind and add one: the map is full of
// tombstones, and compacting them now would pull the rest of the entries out from under the loop.
const full = new Map<string, number>();
for (let index = 0; index < 8; index++) {
	full.set(`k${index}`, index);
}
const visited: string[] = [];
for (const [key, value] of full) {
	visited.push(key);
	if (value === 5) {
		for (let gone = 0; gone < 5; gone++) {
			full.delete(`k${gone}`);
		}
		full.set('new', 99);
	}
}
console.log(`${visited.join(',')} size ${full.size}`);
// After the loop, the map compacts freely again.
for (let index = 0; index < 20; index++) {
	full.set(`more${index}`, index);
	full.delete(`more${index}`);
}
console.log(`${[...full].length}`);

function firstOver(limit: number): string {
	for (const [name, age] of ages) {
		if (age > limit) {
			return name;
		}
	}
	return 'nobody';
}
console.log(`${firstOver(30)} ${firstOver(50)}`);
let pairs = 0;
for (const outer of ages.keys()) {
	for (const inner of ages.keys()) {
		if (outer < inner) {
			pairs++;
		}
	}
	if (outer === 'bob') {
		break;
	}
}
console.log(`${pairs}`);
