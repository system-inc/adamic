import type { RuleContext } from '../../context.ts';
import { debuggerMessage } from '../../rules/no-debugger/messages.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) { this.context = context; }
    visit(index: number, parent: number): void {
        const start = this.context.start(index);
        const finding = this.context.report(index, 'no-debugger', 'unexpectedDebugger', debuggerMessage, '', '', '');
        finding.suggestions.push(new Suggestion('first', 'first | :\n😀', [
            new SuggestionEdit(start, start + 1, 'a|:\t\n😀\\'),
            new SuggestionEdit(start + 1, start + 2, ''),
        ]));
        finding.suggestions.push(new Suggestion('second', 'second', [new SuggestionEdit(start + 2, start + 2, '?.')]));
        finding.suggestions.push(new Suggestion('empty', 'no edits', []));
    }
}
export function create(context: RuleContext): Rule { return new Rule(context); }
