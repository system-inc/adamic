// A scanner's loop over an ASCII string the program builds: once its length has been counted,
// charCodeAt reads its bytes inline. Every edge of a position is read after the length is known,
// fractions, -0, negatives, NaN, infinities and the end, where JavaScript says NaN or truncates.
const source = `let total = ${'count'.repeat(2)} + 42; // done`;
let words = 0;
let digits = 0;
let checksum = 0;
for (let position = 0; position < source.length; position += 1) {
	const code = source.charCodeAt(position);
	checksum = (checksum * 31 + code) % 1000003;
	if (code >= 97 && code <= 122 && (position === 0 || source.charCodeAt(position - 1) === 32)) {
		words += 1;
	}
	if (code >= 48 && code <= 57) {
		digits += 1;
	}
}
console.log(`${source.length} ${words} ${digits} ${checksum}`);
const edges = [0, -0, 0.5, 1.9999, -0.5, -1, source.length - 0.5, source.length, source.length + 1, NaN, Infinity, -Infinity, 2 ** 53];
console.log(edges.map((position) => `${source.charCodeAt(position)}`).join(' '));
const empty = ''.slice(0);
console.log(`${empty.length} ${empty.charCodeAt(0)} ${empty.charCodeAt(NaN)}`);

// A string that isn't ASCII, counted the same way, is read through its index, never as bytes.
const accented = `café ${'é'.repeat(3)} 🌍!`;
const codes: number[] = [];
for (let position = 0; position < accented.length; position += 1) {
	codes.push(accented.charCodeAt(position));
}
console.log(`${accented.length} ${codes.join(',')}`);
