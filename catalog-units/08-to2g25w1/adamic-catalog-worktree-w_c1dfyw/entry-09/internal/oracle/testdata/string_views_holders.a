// Arrays, Map keys and values, and object fields outlive small parents.
function keep(word: string): { readonly items: string[]; readonly map: Map<string, string>; readonly text: string } {
    let parent = `${word}/middle/tail`;
    const first = parent.slice(1, 7);
    const second = first.substring(1, 5);
    const map = new Map<string, string>([[second, parent.substring(3, 10)]]);
    const result = { items: [first, second, parent.charAt(0)], map, text: parent.slice(-4) };
    parent = 'replaced';
    return result;
}
for (const word of ['abc', 'é世', '🌍x']) {
    const holder = keep(word);
    console.log(`${holder.items.join('|')} ${holder.text}`);
    for (const [key, value] of holder.map) {
        console.log(`${key} ${value} ${holder.map.get(key.slice()) ?? 'missing'} ${value.charCodeAt(0)}`);
    }
    holder.items.splice(0, 1);
    console.log(holder.items.join('|'));
}
