class First {
    readonly seed: number;
    readonly label: string;
    constructor(seed: number) {
        this.seed = seed;
        this.label = `first${seed}`;
    }
    value(): number { return this.seed; }
    describe(): string { return this.label; }
    inherited(): string { return 'first method'; }
}
class Second extends First {
    readonly doubled = this.seed * 2;
    readonly copy = this.label + '/second';
    override value(): number { return super.value() + this.doubled; }
    override describe(): string { return super.describe() + '/second'; }
    override inherited(): string { return 'second method'; }
}
class Third extends Second {
    readonly tripled = this.doubled + this.seed;
    override value(): number { return super.value() + this.tripled; }
    override describe(): string { return super.describe() + '/third'; }
}
class Fourth extends Third {
    readonly total = this.tripled + this.doubled;
    override value(): number { return super.value() + this.total; }
    override describe(): string { return super.describe() + '/fourth'; }
}
function show(value: First): void {
    console.log(`${value.describe()} ${value.value()} ${value.inherited()}`);
    console.log(`${value instanceof First}/${value instanceof Second}/${value instanceof Third}/${value instanceof Fourth}`);
}
const values: readonly First[] = [new First(1), new Second(2), new Third(3), new Fourth(4)];
for (const value of values) { show(value); }
const fourth = new Fourth(5);
console.log(`${fourth.seed}/${fourth.doubled}/${fourth.tripled}/${fourth.total}/${fourth.copy}`);
