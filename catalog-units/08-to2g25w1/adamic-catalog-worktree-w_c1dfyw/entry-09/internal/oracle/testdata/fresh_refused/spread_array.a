// An array spread makes a new array holding the holder, which the holder is then given.
interface Node {
	readonly kind: string;
	nodes: Node[];
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	node.nodes = [...node.nodes, node]; // closes the cycle
	return node.nodes.length;
}
console.log(`${run(1)}`);
