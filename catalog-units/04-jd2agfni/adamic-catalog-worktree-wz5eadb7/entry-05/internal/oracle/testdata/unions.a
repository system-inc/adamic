import { panic } from 'adamic';

// ?? whose sides have different types makes a union: text ?? count is string | number. A union is held
// as one value that knows which member it is, and typeof, === and assignment narrow it back.
function label(text: string | undefined, count: number): string {
	const shown = text ?? count;
	if (typeof shown === 'string') {
		return `text "${shown}" of ${shown.length}`;
	}
	return `count ${shown * 2}`;
}
console.log(`${label('hey', 2)}; ${label(undefined, 21)}; ${label('', 0)}`);

// From an array's index, a map's get, and a pair.
const words = ['zero', 'one'];
const counts = new Map<string, number>([['a', 1]]);
const fromIndex = words[1] ?? -1;
const fromMissing = words[9] ?? -1;
const fromMap = counts.get('a') ?? 'none';
const fromNothing = counts.get('z') ?? 'none';
const flags = [true];
const fromFlags = flags[3] ?? 'no flag';
console.log(`${fromIndex} ${fromMissing} ${fromMap} ${fromNothing} ${fromFlags} ${typeof fromIndex} ${typeof fromMissing} ${typeof fromFlags}`);

// Inside a function, where every box made must be let go by the time it returns.
function lookups(keys: readonly string[]): string {
	let said = '';
	for (const key of keys) {
		const found = counts.get(key) ?? `no ${key}`;
		const flag = flags[keys.indexOf(key)] ?? key.length;
		said += `${found}/${flag} `;
	}
	return said;
}
console.log(lookups(['a', 'z', 'a']));

// === compares by member and value: NaN is never equal, -0 equals 0, strings by their text.
function either(useText: boolean, text: string, count: number): string | number {
	return useText ? text : count;
}
const nan = either(false, '', NaN);
const negativeZero = either(false, '', -0);
const built = either(true, 'ab'.repeat(2), 0);
console.log(`${nan === nan} ${nan !== nan} ${negativeZero === either(false, '', 0)} ${built === 'abab'} ${built === either(true, 'abab', 1)}`);
console.log(`${built === 4} ${either(false, '', 4) === 4} ${either(false, '', 4) === '4'} ${either(true, '4', 4) === 4}`);

// typeof of everything.
interface Tree {
	readonly value: number;
}
function pickOne(which: number): string | number | boolean | Tree | number[] | (() => string) | undefined {
	switch (which) {
		case 0:
			return 'text';
		case 1:
			return 1.5;
		case 2:
			return false;
		case 3:
			return { value: 9 };
		case 4:
			return [1, 2, 3];
		case 5:
			return () => 'called';
	}
	return undefined;
}
for (let which = 0; which < 7; which += 1) {
	const picked = pickOne(which);
	let said = 'nothing';
	if (typeof picked === 'string') {
		said = picked.toUpperCase();
	} else if (typeof picked === 'number') {
		said = `${picked + 1}`;
	} else if (typeof picked === 'boolean') {
		said = `${!picked}`;
	} else if (typeof picked === 'function') {
		said = picked();
	} else if (picked === undefined) {
		said = 'undefined';
	} else if (typeof picked === 'object') {
		said = 'object';
	}
	console.log(`${which}: ${typeof picked} ${said}`);
}

// Narrowed by ===, and by assignment.
function describe(value: string | number): string {
	if (value === 0) {
		return 'zero';
	}
	if (value === 'none') {
		return 'none';
	}
	return typeof value === 'number' ? `number ${value.toFixed(1)}` : `string ${value.slice(1)}`;
}
console.log(`${describe(0)} ${describe('none')} ${describe(2.25)} ${describe('xyz')}`);

let current: string | number = 'start';
console.log(`${current.length}`);
current = 42;
console.log(`${current + 1}`);

// A union narrowed to number | undefined, a pair, and back.
function rest(value: string | number | undefined): number {
	if (typeof value === 'string') {
		return value.length;
	}
	return value ?? -1;
}
console.log(`${rest('four')} ${rest(4)} ${rest(undefined)}`);

// A conditional of two kinds is a union too, and a default for a union parameter.
function shown(value: string | number = 'default'): string {
	return `${value}`;
}
for (const count of [0, 1, 2]) {
	const either = count > 0 ? `${count} times` : count;
	console.log(`${either} ${shown(either)} ${shown()} ${shown(undefined)}`);
}

// A global union, written from a function, which may run before or after its declaration has.
let tally: string | number = 0;
function bump(): void {
	tally = typeof tally === 'number' ? tally + 1 : `${tally}!`;
}
bump();
bump();
console.log(`${tally}`);
tally = 'loud';
bump();
console.log(`${tally}`);

// Many boxes made and let go: every one must be freed.
let churn: string | number = 0;
for (let step = 0; step < 1000; step += 1) {
	churn = step % 3 === 0 ? `${step}` : step * 0.5;
}
console.log(`${churn}`);

const sure = fromMap ?? panic('a union that is there');
console.log(`${sure}`);
