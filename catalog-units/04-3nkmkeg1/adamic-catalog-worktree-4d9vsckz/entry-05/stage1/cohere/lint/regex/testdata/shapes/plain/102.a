// typescript/ban_tslint_comment.go:24; `^\s*tslint:(enable|disable)(?:-(line|next-line))?(:|\s|$)`
import { observe } from '../observe.a';
const pattern = "^[ \\t\\n\\f\\r]*tslint:(enable|disable)(?:-(line|next-line))?(:|[ \\t\\n\\f\\r]|(?![\\s\\S]))";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "tslint:enable\t", 4);
observe(regex, "xtslint:enable\t", 5);
observe(regex, "tslint:enable\t\n", 6);
