let trace = '';
function mark(label: string): string { trace += label; return `${label}${trace.length}`; }
class StaticBase {
    static text = mark('a');
    static { trace += 'b'; this.text += 'base'; }
    static second = mark('i');
    static number = 2;
    static label(): string { return 'base:' + this.text; }
    static get amount(): number { trace += 'g'; return this.number; }
    static set amount(value: number) { trace += 's'; this.number = value; }
}
class StaticChild extends StaticBase {
    static own = mark('c');
    static { trace += 'd'; this.own += this.text; }
    static summary = this.label();
    static override label(): string { return super.label() + ':child:' + this.own; }
    static override get amount(): number { return super.amount * 2; }
    static override set amount(value: number) { super.amount = value / 2; }
}
class StaticLeaf extends StaticChild {
    static last = mark('e');
    static { trace += 'f'; this.last += this.own; }
    static override label(): string { return super.label() + ':leaf:' + this.last; }
}
console.log(trace);
function describe(value: typeof StaticBase): string { return value.label(); }
console.log(describe(StaticLeaf));
console.log(typeof StaticLeaf);
StaticBase.text = mark('x');
console.log(StaticChild.text + '/' + StaticLeaf.text);
StaticChild.text = mark('y');
StaticBase.text = mark('z');
console.log(StaticBase.text + '/' + StaticChild.text + '/' + StaticLeaf.text);
StaticChild.amount += 4;
console.log(`${StaticBase.number}/${StaticChild.number}/${StaticLeaf.amount}/${trace}`);
console.log(Object.keys(StaticBase).join(',') + '/' + Object.keys(StaticChild).join(',') + '/' + Object.keys(StaticLeaf).join(','));
class NeverConstructed { static { console.log('unused static block'); } }

class PlainBase {}
class StaticOnlyChild extends PlainBase { static value = 'from empty base'; static { console.log(this.value); } }
class StaticGeneric<T> { item: T; constructor(item: T) { this.item = item; } static value = mark('h'); static read(): string { return this.value; } }
const genericNumber = new StaticGeneric(1);
const genericString = new StaticGeneric('one');
console.log(StaticGeneric.read());
console.log(`${genericNumber.item}/${genericString.item}`);

console.log(StaticChild.summary);
class StaticFailure { static text = mark('q'); static fail(): string { throw new Error(this.text + 'fail'); } static get broken(): string { throw new Error(this.text + 'get'); } static set broken(value: string) { throw new Error(value + this.text); } }
try { console.log(StaticFailure.fail()); } catch (error) { if (error instanceof Error) console.log(error.message); }
try { console.log(StaticFailure.broken); } catch (error) { if (error instanceof Error) console.log(error.message); }
try { StaticFailure.broken = mark('r'); } catch (error) { if (error instanceof Error) console.log(error.message); }
class SuperData extends StaticBase { static readBase(): string { return super.text; } static writeOwn(value: string): void { super.text = value; } }
SuperData.writeOwn(mark('t'));
console.log(SuperData.text + '/' + SuperData.readBase() + '/' + StaticBase.text);

class StaticName { static value = mark('n'); static { console.log(StaticName.value); } static readName(): string { return StaticName.value; } }
console.log(StaticName.readName());
function replaceBase(): string { StaticBase.text = mark('u'); return '!'; }
class StaticAlias extends StaticBase { static combine(): string { return this.text + replaceBase(); } }
console.log(StaticAlias.combine());
