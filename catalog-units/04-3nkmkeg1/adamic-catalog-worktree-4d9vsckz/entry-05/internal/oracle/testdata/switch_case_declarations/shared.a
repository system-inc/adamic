function make(input: number): () => string {
	switch (input) {
		case 0:
		case 1:
			const value = `value${input}`;
			let suffix = '!';
			suffix += `${input}`;
			return read;
		default:
			function read(): string {
				return value + suffix;
			}
			return () => 'other';
	}
}
const first = make(1);
const second = make(0);
console.log(`${first()} ${second()} ${make(2)()}`);
function hoisted(input: number): number {
	switch (input) {
		case 1: return double(input);
		default:
			function double(value: number): number { return value * 2; }
			return double(3);
	}
}
console.log(`${hoisted(1)} ${hoisted(2)}`);
