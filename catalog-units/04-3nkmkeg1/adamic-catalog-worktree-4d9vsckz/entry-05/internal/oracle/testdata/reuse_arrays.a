// Reuse for arrays (internal/native/reuse.go): a map over a unique array no one reads after writes
// its results over its elements, and [...list, more] of one appends to it, instead of making a new
// array. Beside each, the cases where that would be seen: the array read after, held by someone
// else, or handed to the callback as its third argument. A splice whose result nothing uses makes no
// array of what it removed. Strings are built at runtime, since literals are immortal.
function doubled(count: number): string {
	const numbers: number[] = [];
	for (let index = 0; index < count; index++) {
		numbers.push(index);
	}
	const twice = numbers.map((value) => value * 2);
	return twice.join(',');
}

function shouted(count: number): string {
	const words: string[] = [];
	for (let index = 0; index < count; index++) {
		words.push(`word${index}`);
	}
	const loud = words.map((word) => `${word}!`);
	return loud.join(' ');
}

function mappedButRead(): string {
	const numbers = [1, 2, 3];
	const tripled = numbers.map((value) => value * 3);
	return `${numbers.join(',')} ${tripled.join(',')}`;
}

function mappedButShared(): string {
	const numbers = [1, 2, 3];
	const alias = numbers;
	const squared = numbers.map((value) => value * value);
	return `${alias.join(',')} ${squared.join(',')}`;
}

function mappedWithTheArray(): string {
	const numbers = [5, 6, 7];
	const offset = numbers.map((value, index, all) => value + (all[0] ?? 0) + index);
	return offset.join(',');
}

function grown(count: number): string {
	let list: string[] = [];
	for (let index = 0; index < count; index++) {
		list = [...list, `item${index}`];
	}
	return list.join(',');
}

function grownButKept(): string {
	const first = [`a${1}`, `b${2}`];
	const second = [...first, `c${3}`];
	return `${first.join(',')} ${second.join(',')}`;
}

function grownButShared(): string {
	let list = [`a${1}`];
	const alias = list;
	list = [...list, `b${2}`];
	return `${alias.join(',')} ${list.join(',')}`;
}

function spliced(): string {
	const items = [`a${1}`, `b${2}`, `c${3}`, `d${4}`, `e${5}`];
	items.splice(1, 2);
	const removed = items.splice(0, 1, `f${6}`);
	return `${items.join(',')} ${removed.join(',')}`;
}

console.log(doubled(5));
console.log(shouted(3));
console.log(mappedButRead());
console.log(mappedButShared());
console.log(mappedWithTheArray());
console.log(grown(4));
console.log(grownButKept());
console.log(grownButShared());
console.log(spliced());
