function show(input: number): string {
	switch (input) {
		case 1:
			const value = `value${input}`;
			return read();
		case 2:
			return read();
		default:
			function read(): string { return value; }
			return 'other';
	}
}
console.log(show(1));
console.log('before');
console.log(show(2));
console.log('unreachable');
