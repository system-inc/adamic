interface Note { label: string; }
class Holder {
    #text = '';
    #note: Note = { label: '' };
    #lines: readonly string[] = [];
    get text(): string { return this.#text; }
    set text(value: string) { this.#text = value; }
    get note(): Note { return this.#note; }
    set note(value: Note) { this.#note = value; }
    get lines(): readonly string[] { return this.#lines; }
    set lines(value: readonly string[]) { this.#lines = value; }
}
class Loud extends Holder {
    get text(): string { return super.text; }
    set text(value: string) { super.text = `${value}!`; }
    get note(): Note { return super.note; }
    set note(value: Note) { super.note = { label: `wrapped${value.label}` }; }
    get lines(): readonly string[] { return super.lines; }
    set lines(value: readonly string[]) { super.lines = [...value, `extra${6}`]; }
}
function plant(holder: Holder): void {
    holder.text = `hello${4}`;
    holder.note = { label: `kept${1}` };
    holder.lines = [`one${2}`, `two${3}`];
}
const loud = new Loud();
plant(loud);
console.log(`${loud.text}/${loud.note.label}/${loud.lines.join(',')}`);
loud.note.label = `edited${5}`;
console.log(loud.note.label);
loud.text = `again${7}`;
console.log(loud.text);
const direct = new Holder();
plant(direct);
console.log(`${direct.text}/${direct.note.label}/${direct.lines.join(',')}`);
direct.note.label = `edited${8}`;
direct.lines = [`only${9}`];
console.log(`${direct.note.label}/${direct.lines.join(',')}`);
