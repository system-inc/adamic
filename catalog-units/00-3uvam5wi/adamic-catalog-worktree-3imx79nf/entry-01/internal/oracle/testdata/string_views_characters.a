// All cached ASCII characters, including NUL, reused after their sources die.
function characters(wide: boolean): string[] {
    let parent = '';
    for (let code = 0; code < 128; code++) { parent += String.fromCharCode(code); }
    if (wide) { parent = `é${parent}🌍`; }
    const result: string[] = [];
    for (let code = 0; code < 128; code++) {
        const index = code + (wide ? 1 : 0);
        result.push(parent.charAt(index));
        result.push(parent.at(index) ?? '');
        result.push(parent[index] ?? '');
    }
    return result;
}
const plain = characters(false);
const wide = characters(true);
let sum = 0;
for (let index = 0; index < plain.length; index++) {
    const first = plain[index] ?? '';
    const second = wide[index] ?? '';
    sum = (sum * 31 + first.charCodeAt(0)) % 1000003;
    if (first !== second) { console.log(`different at ${index}`); }
}
console.log(`${plain.length} ${wide.length} ${sum} ${(plain[0] ?? '').length} ${(plain[383] ?? '').charCodeAt(0)}`);
