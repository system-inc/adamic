let order = "";
namespace Debug {
    let next = 0;
    export class DebugTypeMapper {
        kind = next;
        constructor() { next += 1; order += "construct;"; }
        read(): number { return this.kind; }
    }
}
const first = new Debug.DebugTypeMapper();
const second = new Debug.DebugTypeMapper();
console.log(`${first.read()}:${second.kind}:${first === second}`);
console.log(order);
