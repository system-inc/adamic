class Base {
    readonly text: string;
    readonly count: number;
    constructor(text: string, count: number) {
        this.text = text + '/base';
        this.count = count + 1;
    }
    read(): string { return `${this.text}:${this.count}`; }
}
class Child extends Base {
    readonly fromBase = this.text + '/field';
    readonly fromField = this.fromBase + '/next';
    readonly own: string;
    readonly amount: number;
    constructor(text: string, count: number) {
        super(text + '/argument', count * 2);
        this.own = text + '/child';
        this.amount = this.count + count;
    }
    override read(): string { return `${super.read()}/${this.fromField}/${this.own}:${this.amount}`; }
}
class Grandchild extends Child {
    readonly final = this.fromField + '/grandchild';
}
for (const count of [0, 3, 11]) {
    const child = new Grandchild(`input${count}`, count);
    const base: Base = child;
    console.log(`${base.read()}/${child.final}`);
}
