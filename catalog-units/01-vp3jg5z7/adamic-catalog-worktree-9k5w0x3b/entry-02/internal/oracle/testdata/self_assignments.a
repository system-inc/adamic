// A variable assigned to itself is JavaScript, and a linter's business; the C must still compile.
// Found by adamic-fuzz (seeds 192 and 196): flag = flag was C that clang refused under -Werror. A
// string assigned to itself must be kept before it's let go, or it's read after it's freed.
let flag = true;
flag = flag;
let count = 1.5;
count = count;
let name = `built ${count}`;
name = name;
function again(value: number, text: string): string {
	value = value;
	text = text;
	return `${value} ${text}`;
}
console.log(`${flag} ${count} ${name} ${again(2, name)}`);
