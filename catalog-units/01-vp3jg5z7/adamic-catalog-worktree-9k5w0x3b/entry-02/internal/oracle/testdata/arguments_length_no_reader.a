function optional(value?: number): string {
	return `${value ?? -1}`;
}
const run = optional;
console.log(run());
console.log(run(undefined));
console.log(run(7));
function rest(...items: number[]): string {
	return items.join(',');
}
const collect: (...items: number[]) => string = rest;
console.log(collect());
console.log(collect(1, 2, 3));
const items = [4, 5];
console.log(collect(...items));
function defaulted(value: number = 9): string { return `${value}`; }
const defaultValue = defaulted;
console.log(defaultValue());
console.log(defaultValue(undefined));
class Readerless {
	read(value?: number): string { return `${value ?? -1}`; }
}
interface View { read(value?: number): string; }
function viewed(value: View): string { return `${value.read()} ${value.read(6)}`; }
console.log(viewed(new Readerless()));
