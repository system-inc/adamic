// Indexing a long non-ASCII string, which the runtime finds through an index built for it (a
// checkpoint every 32 UTF-16 units, and a cursor at the last place found). Two strings read in turn
// must each keep their own; reads forward, backward and jumping must each land on the unit asked for,
// however the last read left the cursor; and slices must cut pairs where JavaScript does.

function units(text: string): string {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(text.charCodeAt(index));
	}
	return codes.join(',');
}

const pieces: string[] = [];
for (let round = 0; round < 12; round += 1) {
	pieces.push(`é${round}世🌍x`);
}
const first = pieces.join('-');
const second = `${'ab'.repeat(5)}${pieces.slice(3).join('|')}`;
console.log(`${first.length} ${second.length}`);

// Turn by turn, unit by unit: a position cached for one string is no answer for the other.
let turns = '';
for (let index = 0; index < 40; index += 1) {
	turns += `${first.charCodeAt(index)}/${second.charCodeAt(index)} `;
}
console.log(turns);

// Backward, and jumping both ways across checkpoints.
let backward = 0;
for (let index = first.length - 1; index >= 0; index -= 1) {
	backward = (backward * 31 + first.charCodeAt(index)) % 1000003;
}
const jumps: number[] = [];
for (const at of [70, 3, 69, 33, 32, 31, 64, 65, 0, 97, 96, 1, 95, 30]) {
	jumps.push(first.codePointAt(at) ?? -1);
	jumps.push(second.charCodeAt(at));
}
console.log(`${backward} ${jumps.join(',')}`);

// Every one-unit read, then slices that start and end on halves of pairs.
const characters: string[] = [];
for (let index = 0; index < first.length; index += 1) {
	characters.push(first[index] ?? '?');
}
console.log(`${characters.join('') === first} ${units(characters[4] ?? '')} ${units(characters[5] ?? '')}`);
console.log(`${units(first.slice(4, 6))} ${units(first.slice(5, 9))} ${units(first.slice(3, 5))} ${units(first.slice(60, 70))}`);
console.log(`${units(second.slice(-9, -1))} ${second.at(-3) ?? 'none'} ${first.at(-1) ?? 'none'} ${first[first.length] ?? 'none'}`);

// A tokenizer's loop: words between spaces, by index.
const sentence = `${'Ça va très bien, 谢谢 🌍 '.repeat(4)}fin`;
const words: string[] = [];
let start = 0;
for (let index = 0; index <= sentence.length; index += 1) {
	if (index === sentence.length || sentence[index] === ' ') {
		if (index > start) {
			words.push(sentence.slice(start, index));
		}
		start = index + 1;
	}
}
console.log(`${words.length} ${words.slice(0, 7).join('|')} ${words[words.length - 1] ?? ''}`);
