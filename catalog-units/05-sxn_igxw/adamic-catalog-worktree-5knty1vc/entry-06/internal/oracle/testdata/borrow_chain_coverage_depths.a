interface Leaf { readonly text: string; }
interface Middle { readonly leaf: Leaf; }
interface Root { readonly middle: Middle; }
function make(n: number): Root { return { middle: { leaf: { text: `depth${n}` } } }; }
function length(text: string): number { return text.length; }
function inspect(root: Root): number {
 const middle = root.middle;
 const leaf = middle.leaf;
 const text = root.middle.leaf.text;
 return length(text) + length(leaf.text) + length(root.middle.leaf.text);
}
function local(): number { const root = make(3); return inspect(root) + length(root.middle.leaf.text); }
console.log(`${local()}`);
