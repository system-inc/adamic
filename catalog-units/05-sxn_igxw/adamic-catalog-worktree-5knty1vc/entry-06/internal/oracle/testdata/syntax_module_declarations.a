namespace BuilderState {
    export interface FileInfo {
        readonly version: string;
        readonly affectsGlobalScope: boolean;
    }
    export namespace Types {
        export type Version = string;
    }
}
namespace JsxNames {
    export const Element = "Element";
    export const IntrinsicElements = "IntrinsicElements";
}
namespace ReactNames {
    export const Element = "Fragment";
}
const version: BuilderState.Types.Version = `${JsxNames.Element}:${ReactNames.Element}`;
const info: BuilderState.FileInfo = {version, affectsGlobalScope: false};
console.log(`${info.version} ${info.affectsGlobalScope}`);
console.log(`${JsxNames.IntrinsicElements} ${JsxNames.Element} ${ReactNames.Element}`);
