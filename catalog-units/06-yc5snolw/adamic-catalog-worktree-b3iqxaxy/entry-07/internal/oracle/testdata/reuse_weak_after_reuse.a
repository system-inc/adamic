import type { Weak } from 'adamic';

// After a spread takes over its source's object, a Weak that pointed at the source. Natively a Weak
// to a source that's gone should read undefined (docs/memory.md); Node keeps the old target.
// Natively, what does it read?
interface Item {
	label: string;
	count: number;
}
interface Holder {
	item: Weak<Item>;
}
const holder: Holder = { item: undefined };
function run(): void {
	const item: Item = { label: `old${1}`, count: 1 };
	holder.item = item;
	const next = { ...item, label: `new${2}` };
	const seen = holder.item;
	console.log(`${seen === undefined ? 'undefined' : seen.label} ${seen === next} ${next.label}`);
}
run();
