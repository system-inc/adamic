// fill(value, start, end), with ECMAScript's relative bounds, and new Array(length).fill(value).
const zeros = new Array<number>(5).fill(0);
console.log(zeros.join(','));
console.log(zeros.fill(7, 1, 3).join(','));
console.log(zeros.fill(9, -2).join(','));
console.log(zeros.fill(4, 0 / 0, 1.9).join(','));
console.log(`${zeros.fill(1, 3, 1).join(',')} ${zeros.fill(2, 99) === zeros}`);
const empty = new Array<number>(0).fill(3);
console.log(`[${empty.join(',')}] ${empty.length}`);

// One string shared by every element, counted once for each.
const word = ['ab'].map((part) => part.repeat(2))[0] ?? '';
const grid = new Array<string>(3).fill(word);
grid.fill(`${word}!`, 1);
console.log(grid.join('|'));
const rows = new Array<number[]>(2).fill([]);
const first = rows[0];
if (first !== undefined) {
	first.push(1);
}
console.log(`${rows.map((row) => row.length).join(',')} ${rows[0] === rows[1]}`);

