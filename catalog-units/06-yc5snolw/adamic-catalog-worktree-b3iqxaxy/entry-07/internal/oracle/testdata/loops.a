let total = 0;
let step = 0;
while (step < 10) {
	step += 1;
	const label = `step ${step}`;
	if (step % 2 === 0) {
		continue;
	}
	if (step > 7) {
		break;
	}
	total += step;
	console.log(label);
}
let countdown = 3;
do {
	console.log(`countdown ${countdown}`);
	countdown -= 1;
} while (countdown > 0);
let once = 0;
do {
	once += 1;
	if (once < 3) {
		continue;
	}
	console.log(`once ${once}`);
} while (once < 3);
for (let outer = 0; outer < 3; outer += 1) {
	for (let inner = 0; inner < 3; inner += 1) {
		const pair = `${outer},${inner}`;
		if (inner === outer) {
			continue;
		}
		if (inner > outer) {
			break;
		}
		console.log(pair);
	}
}
for (;;) {
	const forever = 'leaves';
	console.log(forever);
	break;
}
console.log(`total ${total}`);
