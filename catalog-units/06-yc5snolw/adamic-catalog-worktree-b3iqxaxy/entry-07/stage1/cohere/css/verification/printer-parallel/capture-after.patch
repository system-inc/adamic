+func scratchDump(t *testing.T, side string, data []byte) {
+	t.Helper()
+	if root := os.Getenv("CSS_PROOF_DUMP"); root != "" {
+		path := filepath.Join(root, strings.ReplaceAll(t.Name()+"-"+side, "/", "_"))
+		if err := os.WriteFile(path, data, 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
