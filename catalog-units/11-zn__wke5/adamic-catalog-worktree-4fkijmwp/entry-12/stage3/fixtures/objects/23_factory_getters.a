const SyntaxKind = {CommaToken: 28, BarBarToken: 57, AmpersandAmpersandToken: 56};
// Dependency stub keeps memoizeOne's identity contract for these numeric keys.
const binaryFactories = new Map<number, (left: string, right: string) => string>();
