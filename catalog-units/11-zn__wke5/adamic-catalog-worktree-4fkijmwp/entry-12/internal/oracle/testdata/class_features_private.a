import type { Weak } from 'adamic';
class Vault {
    readonly label: string;
    #secret: string;
    constructor(value: string) { this.label = `public${value}`; this.#secret = `private${value}`; }
    #read(): string { return this.#secret; }
    read(): string { return this.#read(); }
    replace(value: string): void { this.#secret = `changed${value}`; }
}
class ChildVault extends Vault {
    readonly child = 'child';
    #parent: Weak<Vault> = undefined;
    attach(parent: Vault): void { this.#parent = parent; }
    parentLabel(): string { const parent = this.#parent; return parent === undefined ? 'none' : parent.label; }
    #secret = `child${1}`;
    #read(): string { return this.#secret; }
    readChild(): string { return this.#read(); }
}
const child = new ChildVault('one');
console.log(`${child.read()}/${child.readChild()}`);
child.replace('two');
console.log(`${child.read()}/${child.readChild()}`);
console.log(Object.keys(child).join(','));
const copied = { ...child };
console.log(`${Object.keys(copied).join(',')}/${copied.label}/${copied.child}`);
function copy(value: string): { readonly label: string } {
    const source = new Vault(value);
    return { ...source };
}
console.log(Object.keys(copy('temporary')).join(','));
// Ordinary quoted fields that start with # are public, unlike private identifiers.
const ordinary = { '#visible': `visible${2}`, shown: 'yes' };
console.log(Object.keys(ordinary).join(','));
class ReadonlyBox {
    readonly value: string;
    readonly contents = { text: `initial${3}` };
    constructor() { this.value = `first${4}`; this.value = `last${5}`; }
}
const readonlyBox = new ReadonlyBox();
readonlyBox.contents.text = `changed${6}`;
console.log(`${readonlyBox.value}/${readonlyBox.contents.text}`);

const parent = new Vault('parent');
child.attach(parent);
console.log(child.parentLabel());
