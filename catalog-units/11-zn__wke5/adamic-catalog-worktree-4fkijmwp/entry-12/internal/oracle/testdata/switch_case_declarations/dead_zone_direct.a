function show(input: number): void {
	switch (input) {
		case 0:
			let value: string | undefined = `value${input}`;
			console.log(`${value ?? 'missing'}`);
			break;
		case 1:
			console.log(`${value ?? 'missing'}`);
			break;
	}
}
show(0);
console.log('before');
show(1);
console.log('unreachable');
