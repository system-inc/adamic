enum SyntaxKind { First, Last }
function describe(value: SyntaxKind): number {
    if (value === SyntaxKind.First) { return 10; }
    if (value === SyntaxKind.Last) { return 20; }
    value++;
    return 99;
}
function other(): number { return 42; }
console.log('before');
console.log(`${describe(other())}`);
