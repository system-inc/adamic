// A throw between a move and its use. bump takes its counter over (reuse in place) and only then
// throws, so the caller's assignment never happens: on Node, total and held keep the values they
// had. A move of total into bump, or of held, would leave each pointing at what it handed over.
// The graph follows a throw to its handler (flow's MayThrow edges), and reuse overwrites a variable
// only in a statement that can't throw (native/reuse.go, overwrites).
interface Counter {
	readonly count: number;
	readonly label: string;
}

function bump(counter: Counter, fail: boolean): Counter {
	const next = { ...counter, count: counter.count + 1 };
	if (fail) {
		throw new Error(`refused at ${next.count}`);
	}
	return next;
}

let total: Counter = { count: 0, label: `total ${0}` };
total = bump(total, false);
try {
	total = bump(total, true);
} catch (error) {
	if (error instanceof Error) {
		console.log(error.message);
	}
}
console.log(`${total.count} ${total.label}`);

// The move made in a function with no try of its own, the throw caught by its caller.
function step(fail: boolean): void {
	total = bump(total, fail);
}
try {
	step(true);
} catch (error) {
	if (error instanceof Error) {
		console.log(error.message);
	}
}
step(false);
console.log(`${total.count} ${total.label}`);

function local(): string {
	let held: Counter = { count: 10, label: `held ${10}` };
	try {
		held = bump(held, true);
	} catch (error) {
		if (error instanceof Error) {
			console.log(error.message);
		}
	}
	return `${held.count} ${held.label}`;
}
console.log(local());
