// A tuple is held as an object, so stage 0 can't see one as an array yet (lower_test.go probes each
// place one could flow into an array slot). Every place a tuple goes into a tuple slot runs, natively
// as on Node: an initializer, an assignment, an argument, a return, a field, an element, a map value.

type Pair = [string, number];

function swap(pair: Pair): [number, string] {
	const [name, count] = pair;
	return [count, name];
}

function describe(pair: readonly [string, number]): string {
	const [name, count] = pair;
	return `${name}=${count}`;
}

let current: Pair = [`a${1}`, 1];
const pairs: Pair[] = [current];
for (let index = 2; index <= 3; index++) {
	current = [`a${index}`, index];
	pairs.push(current);
}
const held: { readonly pair: Pair } = { pair: current };
const byName = new Map<string, Pair>();
for (const pair of pairs) {
	const [name] = pair;
	byName.set(name, pair);
}
for (const pair of pairs) {
	const [count, name] = swap(pair);
	console.log(`${describe(pair)} ${count} ${name}`);
}
const [lastName, lastCount] = held.pair;
console.log(`${lastName} ${lastCount} ${byName.size} ${pairs.length}`);
