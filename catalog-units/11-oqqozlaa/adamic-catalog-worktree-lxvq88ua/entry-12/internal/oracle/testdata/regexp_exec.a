// exec walks with lastIndex. g and y both clear it after a miss. An empty match advances one unit.
function walk(regex: RegExp, text: string): string {
	const seen: string[] = [];
	for (let step = 0; step < 8; step += 1) {
		const match = regex.exec(text);
		if (match === null) {
			seen.push(`null:${regex.lastIndex}`);
			break;
		}
		seen.push(`${match.index}:${regex.lastIndex}`);
	}
	return seen.join('|');
}
const global = /a/g;
console.log(walk(global, 'aaba'));
console.log(walk(global, 'aaba'));
const sticky = /a/y;
sticky.lastIndex = 1;
console.log(walk(sticky, 'baa'));
sticky.lastIndex = 2;
console.log(`${sticky.exec('ba') === null} ${sticky.lastIndex}`);
const empty = /(?:)/g;
console.log(walk(empty, 'ab'));
const stuck = /(?:)/y;
stuck.lastIndex = 1;
console.log(walk(stuck, 'ab'));
const emoji = /🌍/uy;
emoji.lastIndex = 1;
const found = emoji.exec('a🌍');
console.log(`${found === null ? 'null' : found.index}:${emoji.lastIndex}`);
emoji.lastIndex = 2;
console.log(`${emoji.exec('🌍x') === null} ${emoji.lastIndex}`);
const units = /🌍/y;
units.lastIndex = 1;
console.log(`${units.exec('🌍') === null} ${units.lastIndex}`);
