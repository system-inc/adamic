// tailwind/no_deprecated_classes.go:64; `^shadow$`
import { observe } from '../observe.a';
const pattern = "^shadow(?![\\s\\S])";
const flags = "gu";
const regex = new RegExp(pattern, flags);
observe(regex, "", 0);
observe(regex, "🌍", 1);
observe(regex, "TODO\n", 2);
observe(regex, " TODO", 3);
observe(regex, "shadow", 4);
observe(regex, "xshadow", 5);
observe(regex, "shadow\n", 6);
