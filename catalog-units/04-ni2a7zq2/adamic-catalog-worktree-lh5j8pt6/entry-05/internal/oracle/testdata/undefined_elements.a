// An array of string | undefined holds undefined as a null reference, and every operation that
// reads its elements has to expect one: join writes nothing for it, as JavaScript does.
const parts: (string | undefined)[] = ['a'.repeat(2), undefined, 'c'];
console.log(parts.join('-'));
const empty: (string | undefined)[] = [''.slice(0), undefined];
console.log(`[${empty.join(',')}] [${parts.join('')}]`);
parts.push(undefined);
console.log(`${parts.join('+')} ${parts.length}`);
const copied = [...parts, undefined, 'e'.repeat(3)];
console.log(copied.join('|'));
console.log(parts.concat(copied).slice(2).join(':'));
let present = 0;
for (const part of copied) {
	if (part !== undefined) {
		present += part.length;
	}
}
console.log(`${present} ${parts.reverse().join(',')} ${parts.at(-1) ?? 'missing'} ${parts[1] ?? 'missing'}`);
