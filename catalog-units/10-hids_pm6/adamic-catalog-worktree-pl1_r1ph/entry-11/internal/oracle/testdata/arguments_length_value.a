function counted(value?: number): string {
	return `${arguments.length}:${value ?? -1}`;
}
function plain(value?: number): string {
	return `plain:${value ?? -1}`;
}
function apply(run: (value?: number) => string, passed: boolean): string {
	return passed ? run(undefined) : run();
}
let run: (value?: number) => string = plain;
console.log(apply(run, false));
run = counted;
console.log(apply(run, false));
console.log(apply(run, true));
console.log(run(4));
function zero(): number {
	return arguments.length;
}
const wider: (first: number, second: number, third: number) => number = zero;
console.log(`${wider(1, 2, 3)}`);
const holder = { read: counted };
console.log(holder.read());
console.log(holder.read(undefined));
function returned(): (value?: number) => string {
	return counted;
}
console.log(returned()(undefined));

function greet(name: string, greeting?: string): string {
    return `${arguments.length}:${greeting ?? 'hi'} ${name}`;
}
const greeting: (name: string, greeting?: string) => string = greet;
console.log(greeting('a'));
console.log(greeting('b', undefined));
console.log(greeting('c', 'hello'));
