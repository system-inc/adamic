function errorCode(error: unknown): string | undefined {
	return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'string' ? error.code : undefined;
}
function numberCode(error: unknown): number | undefined {
	return typeof error === 'object' && error !== null && 'code' in error && typeof error.code === 'number' ? error.code : undefined;
}
function hasCode(error: unknown): boolean {
	return typeof error === 'object' && error !== null && 'code' in error;
}
console.log(String(errorCode({ code: 'EEXIST' })));
console.log(String(errorCode({ message: 'absent' })));
console.log(String(hasCode({ message: 'absent' })));
console.log(String(errorCode({ code: 42 })));
console.log(String(numberCode({ code: 42 })));
console.log(String(errorCode('text')));
console.log(String(errorCode(7)));
console.log(String(errorCode(null)));
console.log(String(errorCode(undefined)));
class Failure {
	readonly code = 'CLASS';
}
console.log(String(errorCode(new Failure())));
console.log(String(hasCode(['code'])));
function hasLength(value: unknown): boolean {
	return typeof value === 'object' && value !== null && 'length' in value;
}
console.log(String(hasLength([1, 2])));
try { throw new Error('caught message'); }
catch (error) { if (error instanceof Error) { console.log(error.message); } }
function printCode(error: unknown): void {
	if (typeof error === 'object' && error !== null && 'code' in error) {
		const code: unknown = error.code;
		console.log(String(code));
	}
}
printCode({code: 'unguarded'});
printCode({code: 123});
printCode({code: true});
printCode({code: undefined});
console.log(String('toString' in {}));
console.log(String('map' in [1]));
console.log(String('0' in [1]));
console.log(String('1' in [1]));
class Parent {
	inherited(): string { return 'method'; }
}
class Child extends Parent {
	readonly code = 'inherited instance';
}
console.log(String(errorCode(new Child())));
console.log(String('inherited' in new Child()));
console.log(String('constructor' in new Child()));
function showTag(value: unknown): void {
	console.log(typeof value);
	console.log(String(value === null));
	console.log(String(value === undefined));
}
showTag(null);
showTag(undefined);
showTag(1);
showTag('s');
showTag(true);
class PrivateFailure {
	readonly #hidden = 1;
	readonly code = 'PRIVATE';
	readonly unique = true;
}
console.log(String(errorCode(new PrivateFailure())));
console.log(String('#hidden' in new PrivateFailure()));
console.log(String('#ordinary' in {'#ordinary': 1}));
