// Padding counts UTF-16 units, including a fill cut between surrogate halves.
function show(text: string): void {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(text.charCodeAt(index));
		codes.push(text.codePointAt(index) ?? -1);
	}
	console.log(`${text.length}: ${codes.join(',')}`);
}
for (const fill of ['a', 'é', '世', '🌍', '\ud83c', '\udf0d', '\udf0d\ud83c', 'a🌍é']) {
	for (const target of [0, 1, 2, 3, 4, 5, 6.9, 9]) {
		show('x'.padStart(target, fill));
		show('x'.padEnd(target, fill));
	}
}
show('\udf0d'.padStart(2, '\ud83c'));
show('\ud83c'.padEnd(2, '\udf0d'));
show('🌍'.padStart(7, 'é🌍'));
show('🌍'.padEnd(7, 'é🌍'));
