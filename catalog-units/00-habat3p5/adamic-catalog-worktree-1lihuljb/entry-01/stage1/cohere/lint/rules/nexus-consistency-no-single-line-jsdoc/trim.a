// cohere text.TrimWhitespace uses ECMAScript whitespace: retain NEL and trim BOM.
function whiteSpace(code: number): boolean {
    return (
        (code >= 9 && code <= 13) ||
        code === 32 ||
        code === 160 ||
        code === 5760 ||
        (code >= 8192 && code <= 8202) ||
        code === 8232 ||
        code === 8233 ||
        code === 8239 ||
        code === 8287 ||
        code === 12288 ||
        code === 65279
    );
}
export function trim(value: string): string {
    let start = 0;
    let end = value.length;
    while(start < end && whiteSpace(value.charCodeAt(start))) {
        start++;
    }
    while(end > start && whiteSpace(value.charCodeAt(end - 1))) {
        end--;
    }
    return value.slice(start, end);
}
