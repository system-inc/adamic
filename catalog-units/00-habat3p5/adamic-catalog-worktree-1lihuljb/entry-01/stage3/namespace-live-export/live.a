// Reduced from the native scanner's debug.ts:8:5 blocker.
// Outside writes must update the same slot used by namespace functions.
// Initial reads see false.
// After an outside write both reads see true.
// After another outside write both reads see false.

namespace Debug {
    export let isDebugging = false;
    export function read(): boolean { return isDebugging; }
}
console.log(`${Debug.isDebugging}:${Debug.read()}`);
Debug.isDebugging = true;
console.log(`${Debug.isDebugging}:${Debug.read()}`);
Debug.isDebugging = false;
console.log(`${Debug.isDebugging}:${Debug.read()}`);
