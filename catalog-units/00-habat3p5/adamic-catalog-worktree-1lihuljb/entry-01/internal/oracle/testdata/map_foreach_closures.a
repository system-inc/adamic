// Closures are identity keys and counted values. The callback calls them after the map lets go.
function make(label: string): () => string {
	const text = `${label}`;
	return () => text;
}

function calls(items: readonly (() => string)[]): string {
	return items.map((item) => item()).join(",");
}

function probe(mode: number): void {
	const keys: (() => string)[] = [];
	const values: (() => string)[] = [];
	const collection = new Map<() => string, () => string>();
	for (let index = 0; index < 8; index += 1) {
		const madeKey = make(`k${index}`);
		const madeValue = make(`v${index}`);
		keys.push(madeKey);
		values.push(madeValue);
		collection.set(madeKey, madeValue);
	}
	const first = keys[0] ?? make("missing-key");
	const second = keys[1] ?? make("missing-later");
	const keptKeys: (() => string)[] = [];
	const keptValues: (() => string)[] = [];
	try {
		collection.forEach((item, current, owner) => {
			if (mode === 0) { owner.delete(current); }
			if (mode === 1 && current === first) { owner.delete(second); }
			if (mode === 2) { owner.clear(); }
			if (mode === 3) { owner.set(current, make(`changed${current()}`)); }
			if (mode === 4 && current === first) {
				owner.delete(current);
				owner.set(make("k8"), make("v8"));
			}
			if (mode === 5) {
				owner.delete(current);
				keptKeys.push(current);
				keptValues.push(item);
				throw new Error(`deleted ${current()} ${item()}`);
			}
			keptKeys.push(current);
			keptValues.push(item);
			console.log(`${mode}: ${current()} ${item()} ${owner.size}`);
		});
	} catch (error) {
		console.log(error instanceof Error ? error.message : "unexpected");
	}
	console.log(`kept ${mode}: ${calls(keptKeys)} ${calls(keptValues)}`);
	console.log(`remaining ${mode}: ${collection.size}`);
	collection.forEach((item, current) => { console.log(`after ${current()} ${item()}`); });
}

function returned(): void {
	const collection = new Map<() => string, () => string>();
	const key = make("only");
	const value = make("kept");
	collection.set(key, value);
	const kept: (() => string)[] = [];
	collection.forEach((item, current, owner): (() => string) => {
		owner.delete(current);
		kept.push(current);
		kept.push(item);
		console.log(`return ${current()} ${item()}`);
		return item;
	});
	console.log(`returned ${calls(kept)} ${collection.size}`);
}

for (let mode = 0; mode < 6; mode += 1) { probe(mode); }
returned();
