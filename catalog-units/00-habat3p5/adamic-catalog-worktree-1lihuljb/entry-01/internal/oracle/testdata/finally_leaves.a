// A return, break or continue out of a finally overrides whatever the try was doing: a return, a
// throw, a break or a continue. What the try was holding for it, a result or an error, is let go.
// The strings are built at run time, so one not let go, or let go twice, is caught.

function word(stem: string, index: number): string {
	return `${stem}${index}`;
}

// A return overriding a return: the try's result is dropped.
function overridden(index: number): string {
	try {
		return word('from the try ', index);
	} finally {
		console.log(word('finally ', index));
		return word('from the finally ', index);
	}
}
console.log(overridden(1));

// A return overriding a throw: the error is dropped, and the caller sees a result.
function swallowed(index: number): string {
	try {
		throw new Error(word('lost ', index));
	} finally {
		return word('swallowed ', index);
	}
}
console.log(swallowed(2));

// A return overriding a throw from the catch.
function rethrownThenSwallowed(index: number): string {
	try {
		throw new Error(word('first ', index));
	} catch (error) {
		console.log(error instanceof Error ? error.message : 'something');
		throw new Error(word('second ', index));
	} finally {
		return word('the finally won ', index);
	}
}
console.log(rethrownThenSwallowed(3));

// Only sometimes: the finally returns on some paths and lets the try's own way out go on on others.
function sometimes(index: number): string {
	try {
		if (index % 2 === 0) {
			throw new Error(word('odd one out ', index));
		}
		return word('kept ', index);
	} finally {
		if (index > 4) {
			return word('replaced ', index);
		}
	}
}
for (let index = 3; index < 8; index += 1) {
	try {
		console.log(sometimes(index));
	} catch (error) {
		console.log(`caught ${error instanceof Error ? error.message : 'something'}`);
	}
}

// A return of a number and of an object, over a string's return.
function counted(label: string): number {
	try {
		return label.length;
	} finally {
		if (label.startsWith('x')) {
			return -1;
		}
	}
}
console.log(`${counted(word('abc', 1))} ${counted(word('x', 2))}`);
interface Pair {
	name: string;
	size: number;
}
function paired(index: number): Pair {
	try {
		return { name: word('try ', index), size: index };
	} finally {
		if (index > 1) {
			return { name: word('finally ', index), size: -index };
		}
	}
}
console.log(`${paired(1).name} ${paired(2).name} ${paired(2).size}`);

// Nested: the inner finally's return goes through the outer finally, which runs after it.
function nested(index: number): string {
	try {
		try {
			throw new Error(word('inner ', index));
		} finally {
			console.log('inner finally');
			return word('inner finally returned ', index);
		}
	} finally {
		console.log(word('outer finally ', index));
	}
}
console.log(nested(4));

// The inner finally's return overridden in turn by the outer's.
function twice(index: number): string {
	try {
		try {
			return word('try ', index);
		} finally {
			return word('inner finally ', index);
		}
	} finally {
		return word('outer finally ', index);
	}
}
console.log(twice(5));

// A break out of a finally ends the loop, whatever the try was doing.
function broken(): string {
	const seen: string[] = [];
	for (let index = 0; index < 5; index += 1) {
		try {
			seen.push(word('at ', index));
			if (index === 2) {
				throw new Error(word('broken at ', index));
			}
		} finally {
			if (index === 2) {
				break;
			}
		}
	}
	return seen.join(', ');
}
console.log(broken());
function brokenReturn(): string {
	for (let index = 0; index < 5; index += 1) {
		try {
			return word('never returned ', index);
		} finally {
			break;
		}
	}
	return word('after the loop ', 0);
}
console.log(brokenReturn());

// A continue out of a finally goes on with the loop, whatever the try was doing: a return, a throw,
// a break.
function continued(): string {
	const seen: string[] = [];
	for (let index = 0; index < 4; index += 1) {
		try {
			if (index === 1) {
				return word('returned at ', index);
			}
			if (index === 2) {
				throw new Error(word('thrown at ', index));
			}
			if (index === 3) {
				break;
			}
			seen.push(word('passed ', index));
		} finally {
			seen.push(word('finally ', index));
			continue;
		}
	}
	return seen.join(', ');
}
console.log(continued());

// A break out of a finally inside a while, and a loop of its own inside the finally that only
// breaks itself.
let rounds = 0;
while (true) {
	rounds += 1;
	try {
		if (rounds === 3) {
			throw new Error(word('round ', rounds));
		}
	} finally {
		for (let inner = 0; inner < 3; inner += 1) {
			if (inner === 1) {
				break;
			}
			console.log(word('inner round ', rounds));
		}
		if (rounds === 3) {
			break;
		}
	}
}
console.log(`stopped after ${rounds} rounds`);

// A switch inside the finally whose break leaves only the switch, then a break out of the finally
// that leaves the loop.
for (let cell = 0; cell < 4; cell += 1) {
	try {
		if (cell === 1) {
			throw new Error(word('cell ', cell));
		}
		console.log(word('cell ', cell));
	} finally {
		switch (cell) {
			case 0:
				break;
			default:
				console.log(word('switched at ', cell));
		}
		if (cell === 1) {
			break;
		}
	}
}

// In a function value, called from map's loop.
const picked = [1, 2, 3].map((value) => {
	try {
		if (value === 2) {
			throw new Error(word('mapped ', value));
		}
		return word('kept ', value);
	} finally {
		if (value >= 2) {
			return word('replaced ', value);
		}
	}
});
console.log(picked.join(', '));

// A finally that throws after all, over a finally's earlier return in an inner try.
function thrownAfterAll(index: number): string {
	try {
		try {
			return word('inner ', index);
		} finally {
			throw new Error(word('the outer try sees ', index));
		}
	} catch (error) {
		return error instanceof Error ? error.message : 'something';
	}
}
console.log(thrownAfterAll(6));

// A variable handed over to a call that takes its array, in a return the finally overrides: the
// continue reads it again after, so it must not have been moved out.
function grown(list: string[]): string[] {
	return [...list, word('grown ', 3)];
}
function handedThenOverridden(): string {
	let held = [word('held ', 1), word('held ', 2)];
	for (let round = 0; round < 2; round += 1) {
		try {
			if (round === 0) {
				return grown(held).join(', ');
			}
			held = grown(held);
		} finally {
			continue;
		}
	}
	return held.join(', ');
}
console.log(handedThenOverridden());
