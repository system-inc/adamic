// replace and replaceAll with a string pattern, lastIndexOf, trimStart, trimEnd and at, as
// JavaScript means them, down to the $ patterns in a replacement and an empty search.
const text = 'one two one two';
console.log(text.replace('two', '2'));
console.log(text.replaceAll('two', '2'));
console.log(`${text.replace('three', '3') === text} ${'aaa'.replaceAll('aa', 'b')}`);
console.log(`${'ab'.replaceAll('', '-')} ${'ab'.replace('', '-')} ${''.replaceAll('', '-')}`);

// An empty search falls between the halves of an emoji, too.
const split = 'a🌍'.replaceAll('', '|');
const codes: number[] = [];
for (let index = 0; index < split.length; index++) {
	codes.push(split.charCodeAt(index));
}
console.log(codes.join(','));

// The replacement's $ patterns.
const word = 'left middle right';
console.log(word.replace('middle', '[$&]'));
console.log(word.replace('middle', '[$`]'));
console.log(word.replace('middle', "[$']"));
console.log(word.replace('middle', '$$'));
console.log(word.replace('middle', '$$&'));
console.log(word.replace('middle', '$1 $<name> $ $x'));
console.log(word.replace('middle', 'end$'));
console.log('a.b.c'.replaceAll('.', '$&$&'));

console.log(`${text.lastIndexOf('one')} ${text.lastIndexOf('four')} ${text.lastIndexOf('')} ${'a🌍'.lastIndexOf('a🌍'.slice(2))}`);

const padded = '  \tpadded text\n ';
console.log(`[${padded.trimStart()}] [${padded.trimEnd()}] [${padded.trim()}]`);

const letters = 'abc';
for (const index of [0, 2, -1, -3, -4, 3, 1.5, -1.5, 0 / 0]) {
	console.log(`${index}: ${letters.at(index) ?? 'none'}`);
}
