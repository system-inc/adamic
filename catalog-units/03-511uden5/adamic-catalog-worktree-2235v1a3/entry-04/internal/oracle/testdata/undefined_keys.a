// A Set or Map keyed by string | undefined holds undefined as a key of its own, distinct from every
// string, the empty one included (R's a5.a crashed natively on it). Every operation meets it: add and
// set, has, get, delete and adding it again (which moves it to the end), size, iteration in insertion
// order, keys, values, entries, spread, new Set from an array, and clear. The strings are built by
// the program, so a key let go too early is a use after free under ASan.

function name(index: number): string | undefined {
	if (index % 3 === 0) {
		return undefined;
	}
	return `k${index}`;
}

function show(key: string | undefined): string {
	if (key === undefined) {
		return 'undefined';
	}
	return `'${key}'`;
}

const keys: (string | undefined)[] = [];
for (let index = 0; index < 7; index++) {
	keys.push(name(index));
}
keys.push(`${''}`);
const missing = name(0);
const empty: string | undefined = `${''}`;

const set = new Set<string | undefined>(keys);
console.log(`set size ${set.size}, has undefined ${set.has(missing)}, has '' ${set.has(empty)}`);
console.log(`set order ${[...set].map((key) => show(key)).join(' ')}`);
set.delete(missing);
console.log(`after delete ${set.size} ${set.has(missing)}`);
set.add(missing);
set.add(name(3));
console.log(`readded at the end: ${[...set].map((key) => show(key)).join(' ')}`);

const map = new Map<string | undefined, number>();
for (let index = 0; index < keys.length; index++) {
	map.set(keys[index], index);
}
console.log(`map size ${map.size}, undefined is ${map.get(missing)}, '' is ${map.get(empty)}`);
for (const [key, value] of map) {
	console.log(`${show(key)} => ${value}`);
}
console.log(`keys ${[...map.keys()].map((key) => show(key)).join(' ')}`);
console.log(`values ${[...map.values()].join(' ')}`);
map.delete(missing);
console.log(`deleted: ${map.has(missing)} ${map.get(missing) ?? 'missing'} ${map.size}`);
map.set(missing, 99);
const after: string[] = [];
for (const [key, value] of map.entries()) {
	after.push(`${show(key)}:${value}`);
}
console.log(`set again, last: ${after.join(' ')}`);
map.clear();
set.clear();
console.log(`cleared ${map.size} ${set.size} ${map.has(missing)} ${set.has(missing)}`);
