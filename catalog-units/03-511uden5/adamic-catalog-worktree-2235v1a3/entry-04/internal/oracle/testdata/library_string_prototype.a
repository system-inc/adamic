console.log(typeof String.prototype.at);
console.log(typeof String.prototype.trim);
console.log(`[${String.prototype.trim.call(' \ttext\n ')}]`);
console.log(`[${String.prototype.trimStart.call('  text  ')}]`);
console.log(`[${String.prototype.trimEnd.call('  text  ')}]`);
console.log(String.prototype.trim.call(42));
console.log(String.prototype.trim.call(true));
console.log(String.prototype.toUpperCase.call('Straße'));
console.log(String.prototype.toLowerCase.call('ΟΣ'));
console.log(String.prototype.charCodeAt.call('a🌍', 1).toString());
console.log(`${String.prototype.codePointAt.call('a🌍', 1) ?? -1}`);
console.log(`${(String.prototype.at.call('a🌍', -1) ?? '').charCodeAt(0)}`);
console.log(String.prototype.slice.call('abcdef', 1, 4));
console.log(String.prototype.indexOf.call('abcabc', 'a', 1).toString());
console.log(`${String.prototype.includes.call('abcabc', 'a', 1)}`);
console.log(String.prototype.repeat.call('ab', 2));
console.log(String.prototype.padStart.call('ab', 4, '-'));
console.log(String.prototype.normalize.call('e\u0301', 'NFC'));
console.log(String.prototype.toString.call('abc'));
console.log(String.prototype.valueOf.call('abc'));
let text = 'before';
function change(): number { text = 'after'; return 1; }
console.log(String.prototype.slice.call(text, change()));
console.log(text);
