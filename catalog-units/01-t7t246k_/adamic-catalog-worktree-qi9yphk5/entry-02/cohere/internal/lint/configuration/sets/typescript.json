{
    "extends": [
        "cohere:adamic",
        "cohere:style"
    ],
    "format": {
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": true,
        "printWidth": 120,
        "ignore": [
            "next-env.d.ts",
            "pnpm-lock.yaml",
            "*.sqlite",
            "*.sqlite3",
            "*.db",
            "*.db-wal",
            "*.db-shm"
        ]
    },
    "rules": {
        "no-restricted-globals": [
            "error",
            "addEventListener",
            "blur",
            "close",
            "closed",
            "confirm",
            "defaultStatus",
            "defaultstatus",
            "event",
            "external",
            "find",
            "focus",
            "frameElement",
            "frames",
            "history",
            "innerHeight",
            "innerWidth",
            "length",
            "location",
            "locationbar",
            "menubar",
            "moveBy",
            "moveTo",
            "name",
            "onblur",
            "onerror",
            "onfocus",
            "onload",
            "onresize",
            "onunload",
            "open",
            "opener",
            "opera",
            "outerHeight",
            "outerWidth",
            "pageXOffset",
            "pageYOffset",
            "parent",
            "print",
            "removeEventListener",
            "resizeBy",
            "resizeTo",
            "screen",
            "screenLeft",
            "screenTop",
            "screenX",
            "screenY",
            "scroll",
            "scrollbars",
            "scrollBy",
            "scrollTo",
            "scrollX",
            "scrollY",
            "self",
            "status",
            "statusbar",
            "stop",
            "toolbar",
            "top"
        ],
        "@typescript-eslint/await-thenable": "error",
        "@typescript-eslint/no-array-delete": "error",
        "@typescript-eslint/no-implied-eval": "error",
        "@typescript-eslint/no-duplicate-enum-values": "error",
        "@typescript-eslint/no-extra-non-null-assertion": "error",
        "@typescript-eslint/no-for-in-array": "error",
        "@typescript-eslint/no-floating-promises": "error",
        "@typescript-eslint/no-misused-new": "error",
        "@typescript-eslint/no-misused-promises": "error",
        "@typescript-eslint/no-non-null-asserted-optional-chain": "error",
        "@typescript-eslint/no-require-imports": "error",
        "@typescript-eslint/no-this-alias": "error",
        "@typescript-eslint/no-unsafe-unary-minus": "error",
        "@typescript-eslint/no-unused-expressions": "error",
        "@typescript-eslint/no-unused-vars": [
            "error",
            {
                "ignoreRestSiblings": true
            }
        ],
        "@typescript-eslint/no-wrapper-object-types": "error",
        "@typescript-eslint/switch-exhaustiveness-check": "error",
        "for-direction": "error",
        "getter-return": "error",
        "no-async-promise-executor": "error",
        "no-case-declarations": "error",
        "no-caller": "error",
        "no-class-assign": "error",
        "no-const-assign": "error",
        "no-import-assign": "error",
        "no-compare-neg-zero": "error",
        "no-dupe-class-members": "error",
        "no-new-native-nonconstructor": "error",
        "no-obj-calls": "error",
        "no-iterator": "error",
        "no-octal": "error",
        "no-cond-assign": "error",
        "no-constant-binary-expression": [
            "error",
            {
                "checkRelationalComparisons": false
            }
        ],
        "no-constant-condition": "error",
        "no-control-regex": "error",
        "no-debugger": "error",
        "no-delete-var": "error",
        "no-dupe-else-if": "error",
        "no-duplicate-case": "error",
        "no-eval": "error",
        "no-empty": "error",
        "no-empty-character-class": "error",
        "no-empty-pattern": "error",
        "no-empty-static-block": "error",
        "no-ex-assign": "error",
        "no-fallthrough": "error",
        "no-func-assign": "error",
        "no-global-assign": "error",
        "no-invalid-regexp": "error",
        "no-irregular-whitespace": "error",
        "no-loss-of-precision": "error",
        "no-misleading-character-class": "error",
        "no-nonoctal-decimal-escape": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "no-self-assign": "error",
        "no-setter-return": "error",
        "no-shadow-restricted-names": "error",
        "no-sparse-arrays": "error",
        "constructor-super": "error",
        "no-this-before-super": "error",
        "no-unassigned-vars": "error",
        "no-unsafe-finally": "error",
        "no-unsafe-negation": "error",
        "no-unsafe-optional-chaining": "error",
        "no-unused-private-class-members": "off",
        "no-useless-assignment": "error",
        "no-useless-backreference": "error",
        "no-useless-catch": "error",
        "no-with": "error",
        "preserve-caught-error": "error",
        "require-yield": "error",
        "use-isnan": "error",
        "valid-typeof": "error",
        "nexus/performance-no-independent-await-in-loop": "error",
        "nexus/concurrency-no-check-then-write": "error",
        "nexus/correctness-no-callback-in-parse-try": "error",
        "nexus/correctness-no-collection-misuse": "error",
        "nexus/correctness-no-discarded-outcome": "error",
        "nexus/correctness-no-discarded-pure-result": "error",
        "nexus/correctness-no-global-listener-target-assertion": "error",
        "nexus/correctness-no-implicit-return": "error",
        "nexus/correctness-no-mock-on-module-namespace": "error",
        "nexus/correctness-no-test-on-global-regex": "error",
        "nexus/correctness-no-uncleared-race-timeout": "error",
        "nexus/correctness-require-child-process-error-listener": "error",
        "nexus/security-no-interpolated-shell-command": "error",
        "nexus/security-no-interpolated-sql-string": "error",
        "nexus/correctness-require-blocking-standard-streams": "error",
        "nexus/correctness-no-identical-branches": "error",
        "nexus/correctness-no-leaked-number-render": "error",
        "nexus/correctness-require-response-status-check": "error",
        "nexus/correctness-no-import-cycle-load-time-read": "error",
        "nexus/correctness-no-nullish-stripping-assertion": "error",
        "nexus/correctness-no-process-exit-after-output": "off",
        "@typescript-eslint/no-unsafe-type-assertion": "off",
        "nexus/correctness-no-caller-data-mutation": "error",
        "@typescript-eslint/no-base-to-string": "error",
        "@typescript-eslint/restrict-template-expressions": [
            "error",
            {
                "allowNever": true
            }
        ],
        "@typescript-eslint/require-array-sort-compare": "error",
        "@typescript-eslint/no-misused-spread": "error",
        "no-new-wrappers": "error",
        "@typescript-eslint/related-getter-setter-pairs": "error",
        "no-constructor-return": "error",
        "@typescript-eslint/only-throw-error": "error",
        "no-proto": "error",
        "no-template-curly-in-string": "error",
        "no-self-compare": "error",
        "no-octal-escape": "error",
        "no-new-func": "error",
        "@typescript-eslint/no-invalid-this": "error",
        "no-invalid-this": "off",
        "no-script-url": "error",
        "@typescript-eslint/no-mixed-enums": "error",
        "no-throw-literal": "error",
        "no-extend-native": "error",
        "no-useless-call": "error",
        "require-atomic-updates": "off",
        "@typescript-eslint/no-unsafe-enum-comparison": "error",
        "nexus/concurrency-no-lost-update": "error",
        "no-alert": "error",
        "@typescript-eslint/prefer-promise-reject-errors": "error",
        "array-callback-return": "error",
        "no-unreachable-loop": "error",
        "@typescript-eslint/no-redeclare": "error",
        "@typescript-eslint/use-unknown-in-catch-callback-variable": "error",
        "no-loop-func": "off",
        "@typescript-eslint/restrict-plus-operands": "error",
        "no-unmodified-loop-condition": "error",
        "@typescript-eslint/no-non-null-asserted-nullish-coalescing": "error",
        "no-await-in-loop": "off",
        "no-unexpected-multiline": "error",
        "@typescript-eslint/no-confusing-non-null-assertion": "error",
        "no-promise-executor-return": "error",
        "consistent-return": "off",
        "@typescript-eslint/no-dupe-class-members": "error",
        "@typescript-eslint/no-unused-private-class-members": "error",
        "require-await": "error",
        "@typescript-eslint/return-await": "error",
        "prefer-promise-reject-errors": "off",
        "no-implied-eval": "off"
    },
    "reasons": {
        "@typescript-eslint/no-unsafe-type-assertion": "On when the type-assertion waves (#tbk2vkj and its siblings) read 0 in every consumer: measured 2026-10-04 at ahra 947, www-phi-health 285, www-ahra-ai 232 and api 1,367 (#79aqact).",
        "nexus/correctness-no-process-exit-after-output": "Off on purpose, by @system_cohere's ruling of 2026-10-03 (#h1jwmmz). Its findings are true, but every process entry blocks stdout and stderr, which correctness-require-blocking-standard-streams requires, so an exit after a write has nothing queued to lose. Turn it on only for a project whose entries don't block.",
        "no-unused-private-class-members": "The core rule sees only #private names. @typescript-eslint/no-unused-private-class-members, on here, is the typed rule that supersedes it.",
        "no-invalid-this": "@typescript-eslint/no-invalid-this, on here, is the same rule taught TypeScript's this parameters.",
        "require-atomic-updates": "It flags any write after an await to something read before it, and on ahra none of its 39 findings was a read-modify-write. nexus/concurrency-no-lost-update replaces it, firing only when the written value is computed from the same location read before the suspension.",
        "no-loop-func": "It cannot tell a closure that runs inside the iteration from one that runs after it, or a flag shared on purpose from a stale capture: of 15 findings across ahra and api (11 and 4), none was a defect, and no-var already removes the var-era form (#bchhqdc).",
        "no-await-in-loop": "It cannot tell a loop that must be sequential from one that need not be: on ahra about three in four of its findings were pagination, retries, polling or ordered output. nexus/performance-no-independent-await-in-loop replaces it, firing only where the iterations are provably independent.",
        "consistent-return": "Ruled by Kirk on 2026-08-25: it cannot see types, so it flags exhaustive switches the checker proves end and effects typed void | Destructor. noImplicitReturns catches the real fall-off-the-end bug, and nexus/consistency-require-matching-return-type rules the return forms.",
        "prefer-promise-reject-errors": "@typescript-eslint/prefer-promise-reject-errors, on here, is the type-aware version of the same rule.",
        "no-implied-eval": "@typescript-eslint/no-implied-eval, on here, reads types, so it catches an alias of setTimeout the core rule sees only by name."
    }
}