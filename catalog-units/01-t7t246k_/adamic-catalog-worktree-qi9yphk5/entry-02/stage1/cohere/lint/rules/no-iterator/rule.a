import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { Suggestion, SuggestionEdit } from '../../suggestions.a';
import { messageNoIterator, messageUseSymbolIterator } from './messages.a';

const noEdits: readonly SuggestionEdit[] = [];

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        const object = node.children[0] ?? -1;
        const key = node.children[node.children.length - 1] ?? -1;
        if(object < 0 || key < 0) {
            return;
        }
        const property = this.context.node(this.context.unwrap(key));
        // The driver selects access nodes. A computed identifier is a variable, not a static key.
        const staticName = node.kind === 'PropertyAccessExpression' ||
            property.kind === 'StringLiteral' || property.kind === 'NoSubstitutionTemplateLiteral';
        if(!staticName || property.text !== '__iterator__') {
            return;
        }
        this.context.reportRange(
            this.context.start(index), node.end, 'no-iterator', 'noIterator', messageNoIterator, noEdits,
            [new Suggestion('useSymbolIterator', messageUseSymbolIterator,
                [new SuggestionEdit(this.context.node(object).end, node.end, '[Symbol.iterator]')])],
        );
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
