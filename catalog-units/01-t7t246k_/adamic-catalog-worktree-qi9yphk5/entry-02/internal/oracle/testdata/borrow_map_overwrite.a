// map's loop hands its callback each element in place, without a count of its own, and this
// callback overwrites the element it was given before it reads its parameter. A closure's parameter
// stays owned for exactly this (docs/memory.md, "Borrowed parameters"): borrowed, the overwrite
// would free the string the parameter still names. The strings are built at runtime, since
// literals are immortal, and the array holds the only count on each.
const names: string[] = [];
for (let index = 0; index < 4; index++) {
	names.push(`name${index * 3}`);
}
const described = names.map((name, index) => {
	names[index] = `replaced${index}`;
	return `${name}:${name.length}`;
});
console.log(described.join(' '));
console.log(names.join(' '));
