interface Person {
	readonly name: string;
	readonly age: number;
}

function byAge(left: Person, right: Person): number {
	return left.age - right.age;
}

function byNothing(left: number, right: number): number {
	return 0 * left * right;
}

const people: Person[] = [
	{ name: 'a', age: 30 },
	{ name: 'b', age: 20 },
	{ name: 'c', age: 30 },
	{ name: 'd', age: 20 },
	{ name: 'e', age: 10 },
];
people.sort(byAge);
let order = '';
for (const person of people) {
	order = order + person.name;
}
console.log(order);
const numbers: number[] = [3, 1, 1 / 0, 2];
numbers.sort(byNothing);
console.log(numbers.join(','));
console.log(`${'a,b,,c'.split(',').length} ${'a,b,,c'.split(',').join('|')} ${''.split(',').length} ${'🌍x'.split('').length} ${'🌍x'.split('').join('')} ${'abc'.split('').join('-')}`);
const letters = ['a', 'b', 'c', 'd', 'e'];
console.log(`${letters.slice(1, 3).join('')} ${letters.slice(-2).join('')} ${letters.slice(3, 1).length} ${letters.slice().join('')}`);
const counts = new Map<string, number>([
	['x', 1],
	['y', 2],
]);
counts.delete('x');
counts.set('z', 3);
for (const [key, value] of [...counts]) {
	console.log(`${key}=${value}`);
}
