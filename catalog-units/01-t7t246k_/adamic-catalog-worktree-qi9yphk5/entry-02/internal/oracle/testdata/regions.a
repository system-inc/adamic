// Regions (internal/native/region.go): a statement that hands what a fresh function returns straight
// to a parameter that flows nowhere gets a region, and every node made into that value lives and
// dies in it. Beside it, every way a value could outlive its statement, each of which must keep it
// off the region: a callee that keeps its parameter (in a global, in another object, by returning
// it), keeps something read out of it, a function that keeps what it makes as well as returning it,
// one that keeps a fresh value it doesn't return, and a fresh value declared into a variable. Each
// kept value is read after its statement, so a region freed under it would be read after it ended.
// Labels are built at runtime, so a region's end has heap strings to let go of.
interface Node {
	readonly label: string;
	readonly left: Node | undefined;
	readonly right: Node | undefined;
}

interface Holder {
	node: Node | undefined;
}

function build(depth: number): Node {
	if (depth === 0) {
		return { label: `leaf${depth}`, left: undefined, right: undefined };
	}
	return { label: `node${depth}`, left: build(depth - 1), right: build(depth - 1) };
}

function count(node: Node | undefined): number {
	if (node === undefined) {
		return 0;
	}
	return 1 + count(node.left) + count(node.right) + (node.label.length > 4 ? 0 : 0);
}

let kept: Node | undefined = undefined;

// Read through a function: at the top level the checker narrows kept to the undefined it started as.
function keptLabel(): string {
	return kept?.label ?? '-';
}

function keep(node: Node): number {
	kept = node;
	return 1;
}

function keepLeft(node: Node): number {
	kept = node.left;
	return 2;
}

function same(node: Node): Node {
	return node;
}

function attach(holder: Holder, node: Node): number {
	holder.node = node;
	return 3;
}

const holder: Holder = { node: undefined };

function buildInto(depth: number): Node {
	const node: Node = { label: `kept${depth}`, left: undefined, right: build(depth) };
	holder.node = node;
	return node;
}

function buildKeeping(depth: number): Node {
	kept = build(depth);
	return { label: `pair${depth}`, left: build(depth), right: undefined };
}

let total = 0;
for (let round = 0; round < 3; round++) {
	total += count(build(3));
}
console.log(`counted ${total}`);

console.log(`${keep(build(2))} ${count(kept)} ${keptLabel()}`);
console.log(`${keepLeft(build(2))} ${count(kept)} ${keptLabel()}`);
const returned = same(build(2));
console.log(`${count(returned)} ${returned.label}`);
console.log(`${attach(holder, build(2))} ${count(holder.node)} ${holder.node?.label ?? '-'}`);
console.log(`${count(buildInto(1))} ${count(holder.node)} ${holder.node?.label ?? '-'}`);
console.log(`${count(buildKeeping(1))} ${count(kept)} ${keptLabel()}`);
// One statement, two fresh values: the one count looks at lives in the statement's region, and the
// one keep keeps must not, though it's made in the same statement.
console.log(`${count(build(2)) + keep(build(1))} ${count(kept)} ${keptLabel()}`);
const declared = build(1);
console.log(`${count(declared)} ${declared.label}`);
