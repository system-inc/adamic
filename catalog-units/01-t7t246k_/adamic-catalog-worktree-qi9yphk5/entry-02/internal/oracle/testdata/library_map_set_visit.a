// Live visits: a deleted entry is skipped, one added is visited, a replaced value is seen once.
const ahead = new Map<number, string>([[1, 'a'], [2, 'b'], [3, 'c']]);
const aheadSeen: string[] = [];
ahead.forEach((value: string, key: number) => {
	aheadSeen.push(`${key}=${value}`);
	if (key === 1) {
		ahead.delete(3);
	}
});
console.log(`ahead ${aheadSeen.join(',')}`);

const updated = new Map<number, string>([[1, 'a'], [2, 'b'], [3, 'c']]);
const updatedSeen: string[] = [];
updated.forEach((value: string, key: number) => {
	updatedSeen.push(`${key}=${value}`);
	if (key === 1) {
		updated.set(3, 'z');
		updated.set(1, 'changed');
	}
});
console.log(`update ${updatedSeen.join(',')} ${updated.get(1)}`);

const readded = new Map<number, string>([[1, 'a'], [2, 'b'], [3, 'c']]);
const readdedSeen: string[] = [];
readded.forEach((value: string, key: number) => {
	readdedSeen.push(`${key}=${value}`);
	if (key === 1) {
		readded.delete(2);
		readded.set(2, 'again');
	}
});
console.log(`readd ${readdedSeen.join(',')}`);

const cleared = new Map<number, string>([[1, 'a'], [2, 'b'], [3, 'c']]);
const clearedSeen: string[] = [];
cleared.forEach((value: string, key: number) => {
	clearedSeen.push(`${key}=${value}`);
	if (key === 1) {
		cleared.clear();
		cleared.set(9, 'n');
	}
});
console.log(`clear ${clearedSeen.join(',')}`);

const walked = new Map<number, string>([[1, 'a'], [2, 'b'], [3, 'c']]);
const walkedSeen: string[] = [];
let walkedOnce = false;
for (const [key, value] of walked) {
	walkedSeen.push(`${key}=${value}`);
	if (key === 1 && !walkedOnce) {
		walkedOnce = true;
		walked.delete(2);
		walked.set(4, 'd');
		walked.delete(1);
		walked.set(1, 'back');
	}
}
console.log(`walk ${walkedSeen.join(',')}`);

const set = new Set<number>([1, 2, 3]);
const setSeen: string[] = [];
let setOnce = false;
set.forEach((value: number) => {
	setSeen.push(`${value}`);
	if (value === 1 && !setOnce) {
		setOnce = true;
		set.delete(1);
		set.add(1);
		set.delete(3);
		set.add(4);
	}
});
console.log(`set each ${setSeen.join(',')}`);

const setWalk = new Set<number>([1, 2, 3]);
const setWalked: string[] = [];
let setWalkOnce = false;
for (const value of setWalk) {
	setWalked.push(`${value}`);
	if (value === 2 && !setWalkOnce) {
		setWalkOnce = true;
		setWalk.clear();
		setWalk.add(8);
		setWalk.add(9);
	}
}
console.log(`set walk ${setWalked.join(',')}`);
