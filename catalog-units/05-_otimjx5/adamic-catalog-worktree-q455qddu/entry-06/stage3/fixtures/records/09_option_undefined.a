};
const Debug = { fail: (message: string): never => { throw new Error(message); } };
function startsWith(text: string, prefix: string): boolean { return text.startsWith(prefix); }
function validateJsonOptionValue(opt: CommandLineOption, value: CompilerOptionsValue, errors: Diagnostic[]): CompilerOptionsValue { return value; }
function createCompilerDiagnostic(message: string, name: string, type?: string): Diagnostic { return message + ":" + name; }
function getCompilerOptionValueTypeString(opt: CommandLineOption): string { return opt.type; }
function parseListTypeOption(opt: CommandLineOption, value: string | undefined, errors: Diagnostic[]): string[] | undefined { return value?.split(","); }
function parseCustomTypeOption(opt: CommandLineOptionOfCustomType, value: string | undefined, errors: Diagnostic[]): CompilerOptionsValue { return value; }
function parseOptionValue(
    args: readonly string[],
    i: number,
    diagnostics: ParseCommandLineWorkerDiagnostics,
    opt: CommandLineOption,
    options: OptionsBase,
    errors: Diagnostic[],
) {
    if (opt.isTSConfigOnly) {
        const optValue = args[i];
        if (optValue === "null") {
            options[opt.name] = undefined;
            i++;
        }
        else if (opt.type === "boolean") {
            if (optValue === "false") {
                options[opt.name] = validateJsonOptionValue(opt, /*value*/ false, errors);
                i++;
