{
    "rule": "object-shorthand",
    "firing": {
        "file": "/repository/source/ObjectShorthand.ts",
        "source": "var x = {x: x}",
        "findings": [
            {
                "line": 1,
                "column": 10,
                "endLine": 1,
                "endColumn": 14,
                "messageId": "expectedPropertyShorthand",
                "message": "A property whose key and value are the same name reads as a duplication.",
                "fix": true
            }
        ],
        "fixedSource": "var x = {x}"
    },
    "clean": {
        "file": "/repository/source/ObjectShorthand.ts",
        "source": "var x = {y}"
    },
    "assertedMessageIds": [
        "expectedAllPropertiesShorthanded",
        "expectedLiteralMethodLongform",
        "expectedMethodLongform",
        "expectedMethodShorthand",
        "expectedPropertyLongform",
        "expectedPropertyShorthand",
        "unexpectedMix"
    ],
    "assertsFix": true
}
