let greeting = 'hello';
greeting += ', world';
const shout = greeting + '!';
console.log(shout);
let built = '';
for (let index = 0; index < 5; index += 1) {
	built = built + `${index}`;
	if (index === 3) {
		continue;
	}
	const piece = `[${index}:${built}]`;
	console.log(piece);
}
console.log(built === '01234' ? 'equal' : 'different');
console.log(`${built !== 'x'} ${built === built}`);
built = built;
console.log(built);
console.error(`to stderr: ${built}`);
