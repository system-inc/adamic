interface Point {
	readonly x: number;
	readonly y: number;
}

interface Named {
	readonly name: string;
}

function describe(point: Point): string {
	return `(${point.x}, ${point.y})`;
}

function nameOf(named: Named): string {
	return named.name;
}

const plain: Point = { x: 1, y: 2 };
const labeled = { name: 'origin', y: 0, x: 0, extra: true };
const points: readonly Point[] = [plain, labeled, { y: 5, x: 4 }];
for (const point of points) {
	console.log(describe(point));
}
console.log(nameOf(labeled));
const moved = { ...labeled, x: 10 };
console.log(`${describe(moved)} ${nameOf(moved)} ${moved.extra} ${labeled.x}`);
const same = plain;
console.log(`${same === plain} ${moved === labeled} ${points.length}`);

function firstNamed(items: readonly Named[], wanted: string): string {
	for (const item of items) {
		const label = `[${item.name}]`;
		if (item.name === wanted) {
			return label;
		}
	}
	return 'none';
}

const people: readonly Named[] = [{ name: 'Kirk' }, { name: 'Ahra' }, labeled];
console.log(firstNamed(people, 'Ahra'));
console.log(firstNamed(people, 'Ken'));

type Weather = 'Sun' | 'Rain' | 'Snow' | 'Fog';

function advise(weather: Weather): string {
	switch (weather) {
		case 'Sun':
			return 'hat';
		case 'Rain':
		case 'Snow':
			return 'coat';
		default:
			return 'stay in';
	}
}

const forecast: readonly Weather[] = ['Sun', 'Fog', 'Rain', 'Snow', 'Sun'];
let advice = '';
for (const weather of forecast) {
	switch (weather) {
		case 'Fog':
			continue;
		case 'Snow':
			advice = advice + '!';
			break;
		default:
			advice = advice + advise(weather) + ' ';
	}
	if (weather === 'Snow') {
		break;
	}
}
console.log(advice);
console.log(`${Math.max(1, 5, 3)} ${Math.min()} ${Math.max()} ${Math.round(-2.5)} ${Math.round(2.5)} ${Math.sign(-3)} ${Math.abs(-7.5)}`);
console.log(`${Math.floor(-1.5)} ${Math.trunc(-1.5)} ${Math.ceil(1.2)} ${Math.sqrt(2)} ${Math.pow(2, 0.5)} ${Math.E} ${Math.PI}`);
console.log(`${(1.005).toFixed(2)} ${(2.5).toFixed(0)} ${(-1.5).toFixed(0)} ${(1e21).toFixed(2)} ${(0).toFixed(3)} ${(-0.0001).toFixed(2)}`);
