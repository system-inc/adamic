interface Visible { readonly visible: number; }
const source: { visible: number; [key: string]: number | string } = { visible: 1 };
const alias = source;
console.log(Object.keys(source).join(','));
alias['late'] = 2;
alias['10'] = 10;
alias['2'] = 2;
alias['01'] = 1;
alias.visible = 3;
function write(view: { visible: number }): void { view.visible = 4; }
function read(view: Visible): number { return view.visible; }
write(source);
const view: Visible = source;
const entries: [string, number][] = Object.entries(view);
console.log('visible:' + read(view));
console.log('own:' + source.hasOwnProperty('late'));
console.log(Object.keys(view).join(','));
entries.forEach(entry => console.log(entry[0] + ':' + entry[1]));
const values: number[] = Object.values(view);
console.log(values.join(','));
const words: { label: string; [key: string]: number | string } = { label: 'first' };
const wordAlias = words;
wordAlias['last'] = 'second';
function writeLabel(target: { label: string }, value: string): void { target.label = value; }
writeLabel(words, 'changed'.repeat(2));
const wordView: { readonly label: string } = words;
const wordEntries: [string, string][] = Object.entries(wordView);
wordEntries.forEach(entry => console.log(entry[0] + ':' + entry[1]));
const flags: { enabled: boolean; [key: string]: number | boolean } = { enabled: true };
const flagAlias = flags;
flagAlias['disabled'] = false;
const flagView: { readonly enabled: boolean } = flags;
const flagEntries: [string, boolean][] = Object.entries(flagView);
flagEntries.forEach(entry => console.log(entry[0] + ':' + entry[1]));
