// Deep recursion with long arguments or a long environment above the stack (stack_test.go passes
// them). The stack's limit counts from its top, above those, and was once measured from the first
// frame below them, so native crashed (exit 139) where Node panics.
function sum(n: number): number {
	if (n === 0) {
		return 0;
	}
	return n + sum(n - 1);
}
console.log('start');
console.log(`${sum(1e9)}`);
