import { Buffer } from 'node:buffer';
const input = [1, 255, 256, -1, 257.9, NaN, Infinity];
const bytes = Buffer.from(input);
input[0] = 42;
console.log(bytes.toString('hex'));
const copy = Buffer.from(bytes);
const alias = bytes;
for (const index of [-1, 0, 1, 2, 20, 0.5, NaN, Infinity]) {
 alias[index] = 258.9;
 console.log(bytes.toString('hex'));
 console.log(`${bytes[index] ?? -1}`);
}
console.log(copy.toString('hex'));
