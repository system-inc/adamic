console.log(`${Object === Object} ${Array === Array} ${String === String} ${Number === Number} ${JSON === JSON} ${Map === Map} ${Set === Set}`);
console.log(`${Object !== Object} ${Map !== Map} ${JSON !== JSON}`);
console.log(`${typeof Object}|${typeof Array}|${typeof String}|${typeof Number}|${typeof JSON}|${typeof Map}|${typeof Set}`);
const custom = function (): number { return 1; };
console.log(`${Object === custom}`);

