// includes, indexOf, at, reverse, concat and reduce, as JavaScript means them.
interface Point {
	readonly x: number;
}

const numbers = [0, -0, 3, 0 / 0, 7, 3];
console.log(`${numbers.indexOf(3)} ${numbers.indexOf(-0)} ${numbers.indexOf(0 / 0)} ${numbers.includes(0 / 0)} ${numbers.includes(8)}`);

// Strings compare by contents: a made string finds a written one.
const made = ['te', 'ket'].map((part) => `${part}${part.length}`);
console.log(`${made.indexOf('ket3')} ${made.includes('te2')} ${made.includes('te')}`);
console.log(`${[true, false].indexOf(false)} ${[true].includes(false)}`);

// Objects compare by identity: an equal copy isn't the same object.
const origin: Point = { x: 0 };
const points: Point[] = [{ x: 1 }, origin];
console.log(`${points.indexOf(origin)} ${points.includes({ x: 0 })}`);

for (const index of [0, 2, -1, -6, -7, 6, 1.5, -1.5, 0 / 0, 1 / 0, -1 / 0]) {
	console.log(`at ${index}: ${numbers.at(index) ?? -1} ${made.at(index) ?? 'none'}`);
}

const letters = ['a', 'b', 'c'].map((letter) => letter.repeat(2));
const reversed = letters.reverse();
console.log(`${reversed.join(',')} ${letters.join(',')} ${reversed === letters}`);
const odd = [1, 2, 3, 4, 5];
odd.reverse();
const none: number[] = [];
none.reverse();
console.log(`${odd.join(',')} [${none.join(',')}]`);

const joined = letters.concat(made, letters);
joined.push('more');
console.log(`${joined.join(',')} ${letters.length}`);
console.log(`${numbers.concat().length} ${points.concat(points).indexOf(origin)}`);

console.log(`${numbers.slice(4).reduce((sum, value) => sum + value, 100)}`);
console.log(letters.reduce((text, letter, index) => `${text}${index}${letter}`, '>'));
const lengths = made.reduce((all: number[], word) => {
	all.push(word.length);
	return all;
}, []);
console.log(lengths.join(','));
console.log(`${none.reduce((sum, value) => sum + value, -1)}`);
console.log(`${[3, 9, 2].reduce((largest, value) => Math.max(largest, value), -1 / 0)}`);

// An index the callback pops away is skipped, as forEach skips it.
const shrinking = [1, 2, 3, 4];
console.log(`${shrinking.reduce((sum, value) => {
	shrinking.pop();
	return sum + value;
}, 0)}`);
