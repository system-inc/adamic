// Typed-buffer variant of TypeScript 6.0.3 checker.ts:7440, labeledElementDeclarations?.[i].
let count = 0;
function position(): number { count++; return 0; }
function byte(values: Uint8Array | undefined, i: number): number | undefined { return values?.[i]; }
function integer(values: Int32Array | undefined, i: number): number | undefined { return values?.[i]; }
function decimal(values: Float64Array | undefined, i: number): number | undefined { return values?.[i]; }
function observe(values: Uint8Array | undefined): void { console.log(`${values?.[position()]} ${count}`); }
observe(undefined);
observe(new Uint8Array([257]));
console.log(`${byte(undefined, 0)} ${byte(new Uint8Array([257]), 0)} ${byte(new Uint8Array(0), 0)}`);
console.log(`${integer(undefined, 0)} ${integer(new Int32Array([-3]), 0)} ${integer(new Int32Array([7]), 99)}`);
console.log(`${decimal(undefined, 0)} ${decimal(new Float64Array([1.5]), 0)} ${decimal(new Float64Array([7]), -1)}`);
interface BufferHolder { readonly bytes: Uint8Array; }
function chained(holder: BufferHolder | undefined): number | undefined { return holder?.bytes[position()]; }
console.log(`${chained(undefined)} ${count}`);
console.log(`${chained({ bytes: new Uint8Array([9]) })} ${count}`);
