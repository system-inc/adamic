// A closure captures the holder, and what a call of it returns is written into the holder.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	const get = (): Node => node;
	node.nodes.push(get()); // closes the cycle
	return node.nodes.length;
}
console.log(`${run(1)}`);
