import { panic, type Weak } from 'adamic';

// A tree whose children are strong and whose parent pointers are weak, so the parent and its children
// are no cycle: when the last strong reference to the root goes, the whole tree is freed. A Weak reads
// as the node it points to, or undefined.
interface TreeNode {
	readonly name: string;
	parent: Weak<TreeNode>;
	readonly children: readonly TreeNode[];
}

function leaf(name: string): TreeNode {
	return { name: name.repeat(1), parent: undefined, children: [] };
}

function branch(name: string, children: readonly TreeNode[]): TreeNode {
	const made: TreeNode = { name: `${name}`, parent: undefined, children };
	for (const child of children) {
		child.parent = made;
	}
	return made;
}

function path(node: TreeNode): string {
	const up = node.parent;
	return up === undefined ? node.name : `${path(up)}/${node.name}`;
}

function depth(node: Weak<TreeNode>): number {
	return node === undefined ? 0 : 1 + depth(node.parent);
}

function child(node: TreeNode, index: number): TreeNode {
	return node.children[index] ?? panic(`${node.name} has no child ${index}`);
}

let root = branch('root', [branch('a', [leaf('a1'), leaf('a2')]), leaf('b')]);
const a = child(root, 0);
const a2 = child(a, 1);
console.log(`${path(a2)} depth ${depth(a2)} ${a2.parent === a} ${a.parent === root} ${root.parent === undefined}`);
console.log(`${a2.parent?.name ?? 'none'} ${a.parent?.name ?? 'none'} ${root.parent?.name ?? 'none'}`);

// Moved: the weak pointer is written again, and what it pointed at before is let go of nothing.
const b = child(root, 1);
a2.parent = b;
console.log(path(a2));
a2.parent = undefined;
console.log(`${path(a2)} ${a2.parent === undefined}`);

// Weak elements, a weak map's values, and a weak variable a closure captures, each pointing into the
// tree while the tree is held.
const seen: Weak<TreeNode>[] = [root, a, undefined];
const byName = new Map<string, Weak<TreeNode>>();
for (const child of root.children) {
	byName.set(child.name, child);
}
let last: Weak<TreeNode> = undefined;
const remember = (node: TreeNode): void => {
	last = node;
};
remember(root);
function lastName(): string {
	return last?.name ?? '-';
}
console.log(`${seen.length} ${seen[0]?.name ?? '-'} ${seen[1]?.name ?? '-'} ${seen[2]?.name ?? '-'} ${seen.indexOf(a)} ${seen.includes(undefined)}`);
console.log(`${byName.get('a')?.name ?? '-'} ${byName.get('b')?.name ?? '-'} ${byName.get('z')?.name ?? '-'} ${lastName()}`);
seen.push(b);
seen[0] = undefined;
console.log(seen.map((node) => node?.name ?? '-').join(','));

// A second tree, made and dropped inside a function: everything in it is freed when the function
// returns, whatever pointed at it weakly.
function throwaway(count: number): number {
	const made = branch('t', Array.from({ length: count }, (_, index) => leaf(`t${index}`)));
	let total = 0;
	for (const child of made.children) {
		total += depth(child);
	}
	return total;
}
console.log(`${throwaway(5)} ${throwaway(0)}`);

// The root let go: the tree is freed, and nothing above leaks.
root = leaf('replacement');
console.log(`${root.name} ${depth(root)}`);
