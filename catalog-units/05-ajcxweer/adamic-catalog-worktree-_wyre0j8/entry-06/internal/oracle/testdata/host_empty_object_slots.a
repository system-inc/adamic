const object = {};
const array = [0, object];
console.log(`${array.indexOf(0)} ${array.indexOf(object)} ${array.lastIndexOf(0)} ${array.lastIndexOf(object)}`);
console.log(`${array.indexOf({})} ${array.lastIndexOf({})}`);
let value: {} = 1;
console.log(typeof value);
value = 'text';
console.log(typeof value);
value = object;
console.log(typeof value);
function kind(value: {}): string { return typeof value; }
console.log(kind(2)); console.log(kind('x')); console.log(kind(object));
const mixed: {}[] = [0, -0, NaN, true, 'x', object, 'x'];
console.log(`${mixed.indexOf(-0)} ${mixed.lastIndexOf(0)} ${mixed.indexOf(NaN)} ${mixed.includes(NaN)}`);
console.log(`${mixed.indexOf(true)} ${mixed.indexOf('x')} ${mixed.lastIndexOf('x')} ${mixed.includes(object)}`);
let effects = 0;
function search(value: {}): {} { effects += 1; return value; }
console.log(`${mixed.indexOf(search(0))} ${effects}`);
