const search = Array.prototype.indexOf;
const last = Array.prototype.lastIndexOf;
const includes = Array.prototype.includes;
const at = Array.prototype.at;
const join = Array.prototype.join;
const numbers: (number | undefined)[] = [undefined, NaN, -0, 3, undefined];
console.log(`${search.call(numbers, undefined)} ${last.apply(numbers, [undefined])} ${includes.apply(numbers, [NaN])}`);
console.log(`${at.apply(numbers, [99])} ${at.call(numbers, -2)}`);
console.log(join.apply(numbers, [undefined]));
const strings = ['🌍', '', '🌍'];
console.log(
    `${search.apply(strings, ['🌍', -1])} ${last.call(strings, '🌍', -2)} ${includes.call(strings, '', Infinity)}`,
);
console.log(`${search.call([true, false], false)} ${includes.apply([false], [true])}`);
const one = { value: 1 };
const two = { value: 1 };
console.log(`${search.call([one, two], two)} ${includes.call([one], two)}`);
