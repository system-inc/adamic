import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { Settings } from '../../settings.ts';

// The batch initializer helper scans punctuation between children, including typed declarations.
export function initializer(context: RuleContext, node: ParseNode, bound: number): number {
    if(bound < 0) return -1;
    let position = context.node(bound).end;
    for(const child of node.children) {
        if(child === bound) continue;
        const start = context.start(child);
        context.scanner.pos = position;
        while(context.scanner.scan() !== 'EndOfFile' && context.scanner.start < start) {
            if(context.scanner.kind === 'EqualsToken') return child;
        }
        position = context.node(child).end;
    }
    return -1;
}

export function enabled(context: RuleContext, declarator: boolean, array: boolean): boolean {
    if(context.settings.text === '' || context.settings.text === 'null') return true;
    const pair = new Settings();
    pair.load(context.settings.read(declarator ? 'variabledeclarator' : 'assignmentexpression', '{}'));
    return pair.read(array ? 'array' : 'object', 'false') === 'true';
}

// Skip literal contents using the context's shared literal index; count complete comments only.
export function commentsInside(context: RuleContext, start: number, end: number): number {
    const literalEnds = context.literalEnds();
    let count = 0;
    for(let at = start; at < end;) {
        const literalEnd = literalEnds[at] ?? -1;
        if(literalEnd > at) { at = literalEnd; continue; }
        const opening = context.source.slice(at, at + 2);
        if(opening === '/*') {
            const closing = context.source.indexOf('*/', at + 2);
            if(closing < 0 || closing + 2 > end) break;
            count++; at = closing + 2;
        }
        else if(opening === '//') {
            let closing = at + 2;
            while(closing < context.source.length && ![10, 13, 8232, 8233].includes(context.source.charCodeAt(closing))) closing++;
            if(closing <= end) count++;
            at = closing;
        }
        else at++;
    }
    return count;
}
