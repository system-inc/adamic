class Base {
    readonly label = `base${1}`;
    constructor(fail: boolean) {
        if(fail) {
            throw new Error('base constructor');
        }
    }
    value(): string {
        return this.label;
    }
}
class Derived extends Base {
    readonly detail = `derived${2}`;
    constructor(fail: boolean, later: boolean) {
        super(fail);
        if(later) {
            throw new Error('derived constructor');
        }
    }
    override value(): string {
        throw new Error(this.label + '/' + this.detail);
    }
}
function read(value: Base): string {
    return value.value();
}
for(const fail of [false, true]) {
    for(const later of [false, true]) {
        try {
            const value: Base = new Derived(fail, later);
            console.log(read(value));
        }
        catch(error) {
            if(error instanceof Error) {
                console.log(error.message);
            }
        }
    }
}
class Plain {
    readonly value = `plain${3}`;
}
function copy(): { readonly value: string } {
    const original = new Plain();
    return { ...original };
}
const copied = copy();
console.log(`${copied.value} ${copied instanceof Plain}`);
