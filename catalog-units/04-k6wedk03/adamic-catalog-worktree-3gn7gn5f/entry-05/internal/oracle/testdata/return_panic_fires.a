// return panic('why') where it runs: in a method returning a string, reached through a function
// value, with what was printed before it flushed first.
import { panic } from 'adamic';

class Registry {
	readonly names: string[] = ['Kirk'];

	find(index: number): string {
		const name = this.names[index];
		if (name !== undefined) {
			return name;
		}
		return panic(`no name at ${index}`);
	}
}

const registry = new Registry();
const lookup: (index: number) => string = (index) => registry.find(index);
console.log(lookup(0));
console.log(lookup(1));
console.log('never printed');
