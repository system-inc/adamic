// A helper that calls a function value, which writes the parent into the child it was given.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function attach(parent: Node, child: Node, tie: () => void): void {
	tie();
	parent.nodes.push(child); // closes the cycle
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	const child: Node = { kind: `c${n}`, nodes: [] };
	const holder: Node[] = [node];
	attach(node, child, () => {
		child.nodes.push(holder[0] ?? child);
	});
	return node.nodes.length;
}
console.log(`${run(1)}`);
