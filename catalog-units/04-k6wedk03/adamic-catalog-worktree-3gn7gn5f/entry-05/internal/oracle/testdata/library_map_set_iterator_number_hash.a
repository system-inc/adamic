const map = new Map<number, number>();
for (let key = 0; key < 1000; key += 1) { map.set(key, key); }
let total = 0;
for (let round = 0; round < 2000; round += 1) {
	for (let key = 0; key < 1000; key += 1) { total += map.get(key) ?? -1; }
}
console.log(`${total}`);
const special = new Map<number, string>();
special.set(-0, 'zero');
special.set(0, 'positive');
special.set(NaN, 'nan');
special.set(0 / 0, 'same nan');
for (const value of [-2147483648, 2147483647, 2147483648, -2147483649, 1.5, -1.5, Infinity, -Infinity]) {
	special.set(value, `${value}`);
}
console.log(`${special.size} ${special.get(-0)} ${special.get(NaN)}`);
for (const key of special.keys()) { console.log(`${key} ${special.get(key)} ${1 / key}`); }
const optional = new Set<number | undefined>([undefined, -0, 0, NaN, 0 / 0, 1.5, Infinity]);
console.log(`${optional.size} ${optional.has(undefined)} ${optional.has(NaN)} ${optional.has(0)}`);
console.log([...optional].join(' '));
