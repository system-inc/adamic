// Concatenation past V8's longest string (536,870,888 UTF-16 units): two halves of 2^28 units each
// are 24 units over, RangeError: Invalid string length on Node and a panic here, checked before the
// joined string is allocated.
const half = 'ab'.repeat(2 ** 27);
console.log(`${half.length}`);
const whole = half + half;
console.log(`${whole.length}`);
