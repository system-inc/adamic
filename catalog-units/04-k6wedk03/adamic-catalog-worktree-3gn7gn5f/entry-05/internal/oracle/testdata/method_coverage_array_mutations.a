const fill = Array.prototype.fill;
const splice = Array.prototype.splice;
const concat = Array.prototype.concat;
const slice = Array.prototype.slice;
const array = ['a', 'b', 'c', 'd'];
fill.call(array, 'x', 1, -1);
console.log(array.join('|'));
fill.apply(array, ['y']);
console.log(array.join('|'));
/* eslint-disable-next-line @typescript-eslint/no-unsafe-assignment -- The lowerer proves the receiver and returned array have the same element type. */
const removed: string[] = splice.apply(array, [1, 2, 'z', 'q']);
console.log(removed.join('|'));
console.log(array.join('|'));
/* eslint-disable-next-line @typescript-eslint/no-unsafe-assignment -- The lowerer proves the receiver and returned array have the same element type. */
const suffix: string[] = splice.call(array, -2, 2);
console.log(suffix.join('|'));
/* eslint-disable-next-line @typescript-eslint/no-unsafe-assignment -- The lowerer proves the receiver and returned array have the same element type. */
const combined: string[] = concat.apply(array, [['end'], ['last']]);
console.log(combined.join('|'));
/* eslint-disable-next-line @typescript-eslint/no-unsafe-assignment -- The lowerer proves the receiver and returned array have the same element type. */
const copied: string[] = slice.apply(combined, []);
console.log(copied.join('|'));
