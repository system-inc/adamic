// ES2025 Set order, SameValueZero, aliasing, and predicate size branches against Node.
function show(values: ReadonlySet<number>): string {
	return [...values].join(',');
}
const first = new Set<number>([3, 1, 2, NaN, -0]);
const second = new Set<number>([2, 3, 7, NaN]);
console.log(`union ${show(first.union(second))}`);
console.log(`intersection ${show(first.intersection(second))} reverse ${show(second.intersection(first))}`);
console.log(`difference ${show(first.difference(second))} reverse ${show(second.difference(first))}`);
console.log(`symmetric ${show(first.symmetricDifference(second))}`);
console.log(`predicates ${first.isSubsetOf(second)} ${first.isSupersetOf(second)} ${first.isDisjointFrom(second)}`);
console.log(`self ${show(first.union(first))} ${show(first.intersection(first))} ${show(first.difference(first))} ${show(first.symmetricDifference(first))}`);
console.log(`self predicates ${first.isSubsetOf(first)} ${first.isSupersetOf(first)} ${first.isDisjointFrom(first)}`);
const empty = new Set<number>();
console.log(`empty ${show(empty.union(first))} ${show(first.intersection(empty))} ${show(first.difference(empty))} ${show(empty.symmetricDifference(first))}`);
console.log(`empty predicates ${empty.isSubsetOf(first)} ${first.isSupersetOf(empty)} ${empty.isDisjointFrom(first)} ${first.isDisjointFrom(empty)}`);
const tieA = new Set<number>([3, 2, 1]);
const tieB = new Set<number>([1, 2, 4]);
console.log(`tie ${show(tieA.intersection(tieB))} ${show(tieB.intersection(tieA))}`);
console.log(`unchanged ${show(first)} ${show(second)}`);
const textA = new Set<string>(['ab'.repeat(2), 'cd'.repeat(2)]);
const textB = new Set<string>(['cd'.repeat(2), 'ef'.repeat(2)]);
console.log(`${[...textA.union(textB)].join(',')} ${[...textA.intersection(textB)].join(',')} ${[...textA.difference(textB)].join(',')} ${[...textA.symmetricDifference(textB)].join(',')}`);
console.log(`${textA.isSubsetOf(textB)} ${textA.isSupersetOf(textB)} ${textA.isDisjointFrom(textB)}`);
const object = { readonlyValue: 1 };
const other = { readonlyValue: 1 };
const objects = new Set([object]);
const others = new Set([other]);
console.log(`${objects.union(others).size} ${objects.intersection(others).size} ${objects.difference(others).size} ${objects.symmetricDifference(others).size} ${objects.isDisjointFrom(others)}`);
const flags = new Set<boolean>([true]);
const moreFlags = new Set<boolean>([false]);
console.log(`${[...flags.union(moreFlags)].join(',')} ${flags.intersection(moreFlags).size} ${flags.isDisjointFrom(moreFlags)}`);
