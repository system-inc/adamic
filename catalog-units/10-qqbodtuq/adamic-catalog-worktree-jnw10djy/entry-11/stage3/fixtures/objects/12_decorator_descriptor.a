interface MemberInfo { memberDecoratorsName: string; memberDescriptorName?: string; }
function createHelperVariable(member: string, name: string): string { return member + "_" + name; }
function partialTransformClassElement(member: string, privateMethod: boolean): MemberInfo {
    const memberDecoratorsName = createHelperVariable(member, "decorators");
            const memberInfo: MemberInfo = { memberDecoratorsName };
    let descriptorName: string | undefined;
    if (privateMethod) {
                    memberInfo.memberDescriptorName = descriptorName = createHelperVariable(member, "descriptor");
    } else {
                    memberInfo.memberDescriptorName = descriptorName = createHelperVariable(member, "descriptor");
    }
    return memberInfo;
}
