// text += more on a local, which may write in place when nothing else holds the string
// (string_append.c): a long loop of appends (counts.md shows its allocations stay few), a string read
// by length and by index between appends, so its cached units and index must follow its new bytes,
// halves of a surrogate pair appended apart, text += text, and every way something else can hold the
// string, each of which must keep the value it had.

function joined(word: string, times: number): string {
	let text = '';
	for (let index = 0; index < times; index++) {
		text += word;
		text += index % 3 === 0 ? '0' : '1';
	}
	return text;
}

const long = joined('ab', 20000);
console.log(`${long.length} ${long.slice(0, 9)} ${long.slice(-9)}`);

// Read between appends: the length, an index, and a non-ASCII string's index past 64 bytes.
function readBetween(): void {
	let growing = 'é';
	const lengths: number[] = [];
	const codes: number[] = [];
	for (let round = 0; round < 40; round++) {
		growing += round % 3 === 0 ? '🌍' : `x${round}`;
		lengths.push(growing.length);
		codes.push(growing.charCodeAt(growing.length - 1));
		codes.push(growing.charCodeAt(round));
	}
	console.log(lengths.join(' '));
	console.log(codes.join(' '));
}
readBetween();

// The halves of a pair, appended one at a time, are one character again, the second written in place.
function halvesApart(): void {
	let halves = 'pair:';
	halves += 'pair:';
	halves += '\uD83C';
	console.log(`${halves.length} ${halves.charCodeAt(10)}`);
	halves += '\uDF0D';
	console.log(`${halves.length} ${halves.codePointAt(10)} ${halves === 'pair:pair:🌍'} ${[...halves].length}`);
}
halvesApart();

// text += text, and the string twice in one append.
function doubling(): void {
	let doubled = `ab${long.length}`;
	doubled += doubled;
	doubled = doubled + doubled + '|' + doubled;
	console.log(doubled);
}
doubling();

// Held elsewhere first: another local, an array, a map, an object, a slice of it, a parameter. Each
// string has room to grow first, so only its count keeps it from being written in place.
function heldElsewhere(): void {
	let base = `${'base'}-${long.length}`;
	base += '!';
	const alias = base;
	const list = [base];
	const keyed = new Map<string, number>([[base, 1]]);
	const box = { held: base };
	const whole = base.slice(0);
	base += '+more';
	console.log(`${base} ${alias} ${list.join(',')} ${keyed.get(alias) ?? 0} ${keyed.get(base) ?? 0} ${box.held} ${whole}`);
}
heldElsewhere();

function extended(text: string, times: number): string {
	for (let index = 0; index < times; index++) {
		text += '.';
	}
	return text;
}
const original = extended(`kept${long.length}`, 2);
console.log(`${extended(original, 5)} ${original}`);

// A global, and a local a closure writes: appended to as before.
let total = '';
function addToTotal(part: string): string {
	total += part;
	return part;
}
total += addToTotal('a') + addToTotal('b');
console.log(total);
let captured = 'c';
const appendCaptured = (part: string): string => {
	captured += part;
	return part;
};
captured = captured + appendCaptured('d') + appendCaptured('e');
console.log(captured);

// A local a closure writes, inside a function: the closure's appends come between reading it and
// assigning it, so it must not be appended to in place.
function capturedLocal(): string {
	let local = 'f';
	local += 'g';
	const appendLocal = (part: string): string => {
		local += part;
		return part;
	};
	local = local + appendLocal('h') + appendLocal('i');
	return local;
}
console.log(capturedLocal());

// Halves of a pair meet only where pieces do: across two parts, with an empty part between them, after
// a part shorter than a half, and text += text with a low half at its start and a high one at its end.
function seams(): void {
	const high = String.fromCharCode(0xd83c);
	const low = String.fromCharCode(0xdf0d);
	const empty = high.slice(0, 0);
	const pieces = [`${high}${low}`, `a${high}${empty}${low}b`, `${high}${empty}${empty}${low}`, `${low}${high}`, `x${high}`, `${low}y`];
	for (const piece of pieces) {
		console.log(`${piece.length} ${piece.codePointAt(0)} ${piece.codePointAt(1)} ${[...piece].length}`);
	}
	const joined = `${pieces[4] ?? ''}${pieces[5] ?? ''}`;
	console.log(`${joined.length} ${joined === 'x🌍y'}`);
	let twice = `${low}ab${high}`;
	twice += twice;
	console.log(`${twice.length} ${twice.codePointAt(3)} ${[...twice].length}`);
	let grow = `${low}${'z'.repeat(20)}`;
	grow += high;
	grow += low;
	grow += `${high}${low}${high}`;
	grow += low;
	console.log(`${grow.length} ${[...grow].length} ${grow.codePointAt(21)} ${grow.codePointAt(23)} ${grow.codePointAt(25)}`);
}
seams();
