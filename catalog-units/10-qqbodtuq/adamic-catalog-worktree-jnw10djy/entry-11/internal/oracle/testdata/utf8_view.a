// utf8Length and utf8At from 'adamic': a string's UTF-8 as TextEncoder writes it, read in place.
// ASCII, two, three and four bytes, a lone surrogate of each half (U+FFFD's bytes, though stored as
// WTF-8), a pair made from two halves, strings made at runtime, and the empty string.
import { utf8At, utf8Length } from 'adamic';

function bytesOf(text: string): string {
	const bytes: number[] = [];
	for (let index = 0; index < utf8Length(text); index++) {
		bytes.push(utf8At(text, index));
	}
	return bytes.join(' ');
}

const made = ['h', 'é', '世', '🌍'].join('').repeat(2);
const halves = String.fromCharCode(0xd83c) + String.fromCharCode(0xdf0d);
const texts = ['abc', 'héllo', '世界', '🌍!', '\uD800x', 'a\uDFFF', 'x\uDBFFy\uDC00', '􏿿', '', made, halves, made.slice(1, 4)];
for (const text of texts) {
	console.log(`${utf8Length(text)}: ${bytesOf(text)}`);
}
console.log(`${utf8At('é', 1)} ${utf8At(made, -0)} ${utf8Length(halves) === utf8Length('🌍')}`);
