function make(start: number): () => number {
 let count = start;
 function identity<T>(value: T): T { count += 1; return value; }
 console.log(identity("start"));
 console.log(String(identity(undefined) === undefined));
 function read(): number { return identity(count); }
 return read;
}
const first = make(10);
const second = make(20);
console.log(String(first()));
console.log(String(second()));
console.log(String(first()));
