// Intrinsic calls convert primitive receivers, and preserve argument evaluation order.
for (const needle of ['a', 'é', '😀', '\ud83d', '\ude00', '', 'missing']) {
    const text = 'aé😀'.repeat(30);
    console.log(`${String.prototype.lastIndexOf.call(text, needle)} ${String.prototype.indexOf.call(text, needle)} ${String.prototype.indexOf.call(text, needle, 2)}`);
}
console.log(`${String.prototype.lastIndexOf.call(12121, '21')} ${String.prototype.indexOf.call(true, 'r')}`);
let source = 'aé😀'.repeat(30);
let order = '';
function needle(): string {
    order += 'n';
    source = 'changed';
    return '😀';
}
console.log(`${source.lastIndexOf(needle())} ${source} ${order}`);
source = 'aé😀'.repeat(30);
console.log(`${String.prototype.lastIndexOf.call(source, needle())} ${source} ${order}`);
