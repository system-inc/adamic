// fill writing the holder over its children.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	node.nodes.push({ kind: `child${n}`, nodes: [] });
	node.nodes.fill(node); // closes the cycle
	return node.nodes.length;
}
console.log(`${run(1)}`);
