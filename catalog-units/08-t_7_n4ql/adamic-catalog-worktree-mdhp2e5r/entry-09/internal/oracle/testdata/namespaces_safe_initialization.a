class Box { readonly debugging = Debug.isDebugging; }
function count(): number { return new Map<string, number>().size; }
function helper(): number { return count(); }
console.log(`${helper()}`);
namespace Debug {
    export const size = helper();
    export let isDebugging = false;
    export function answer(): boolean { return true; }
    helper();
}
console.log(`${Debug.size}:${Debug.answer()}:${Debug.isDebugging}`);
console.log(`${new Box().debugging}`);
const empty = new Map<never, never>();
const view: ReadonlyMap<string, number> = empty;
console.log(`${view.size}:${view.get('missing') === undefined}:${view.has('missing')}`);
