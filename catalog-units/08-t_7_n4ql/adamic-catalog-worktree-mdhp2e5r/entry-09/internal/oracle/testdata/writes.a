const numbers: number[] = [1, 2, 3];
const words = ['a', 'b', 'c'];
numbers[0] = 10;
numbers[2] = numbers[1] ?? 0;
words[1] = 'bee';
words[1] = words[1] ?? 'missing';
for (let index = 0; index < words.length; index += 1) {
	words[index] = `${words[index] ?? '?'}!`;
}
console.log(`${numbers.join(',')} ${words.join(',')}`);
const alias = words;
alias[0] = 'changed through the alias';
console.log(words[0] ?? 'none');
