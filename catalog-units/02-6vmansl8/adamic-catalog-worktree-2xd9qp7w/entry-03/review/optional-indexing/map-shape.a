const storage = new Map<string, number>();
const shaped: ReadonlyMap<string, number> = {
    size: 0,
    get(key: string): number | undefined { return key.length === 0 ? undefined : 7; },
    has(key: string): boolean { return key.length > 0; },
    forEach(callback: (value: number, key: string, map: ReadonlyMap<string, number>) => void): void { callback(7, 'key', storage); },
    entries() { return storage.entries(); },
    keys() { return storage.keys(); },
    values() { return storage.values(); },
    [Symbol.iterator]() { return storage.entries(); },
};
console.log(`${shaped?.get('key')}`);
