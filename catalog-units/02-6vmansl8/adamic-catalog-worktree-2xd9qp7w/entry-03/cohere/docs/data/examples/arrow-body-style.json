{
    "rule": "arrow-body-style",
    "firing": {
        "file": "/repository/source/ArrowBodyStyle.ts",
        "source": "var foo = () => { return 5; };",
        "findings": [
            {
                "line": 1,
                "column": 17,
                "endLine": 1,
                "endColumn": 30,
                "messageId": "unexpectedSingleBlock",
                "message": "This arrow function uses a braced body only to return a value. Put the value straight after the arrow, so the braces and the return keyword stop standing between the reader and what the function produces.",
                "fix": true
            }
        ],
        "fixedSource": "var foo = () => 5;"
    },
    "clean": {
        "file": "/repository/source/ArrowBodyStyle.ts",
        "source": "var foo = () => 0;"
    },
    "assertedMessageIds": [
        "expectedBlock",
        "unexpectedEmptyBlock",
        "unexpectedObjectBlock",
        "unexpectedOtherBlock",
        "unexpectedSingleBlock"
    ],
    "assertsFix": true
}
