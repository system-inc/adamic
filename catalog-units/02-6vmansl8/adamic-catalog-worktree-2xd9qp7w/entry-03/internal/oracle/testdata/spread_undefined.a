// A spread of a value that may be undefined (reviewer R, round 8b): JavaScript's { ...undefined } is
// {}, so the object is the literal's own fields, and a read of any other field the source's type has
// is undefined. Natively that read NULL, in the copy and, once the spread was a reuse source, at the
// reuse check. Here every way a spread is made: reused (the source dead after) and copied (read
// after), with fields given and without, the result spread again, and each with the source there and
// not. Labels are built at runtime, so a copy has heap strings to hold.
type Tree = { value: number; label: string };

function make(depth: number): Tree | undefined {
	return depth > 0 ? { value: depth, label: `t${depth}` } : undefined;
}

function spreadMaybe(depth: number): string {
	const maybe = make(depth);
	const spread = { ...maybe };
	return `${depth} ${spread.value ?? `none`}`;
}

function relabel(depth: number): string {
	const maybe = make(depth);
	const relabeled = { ...maybe, label: `re${depth}` };
	return `${relabeled.label} ${relabeled.value ?? -1}`;
}

function keepSource(depth: number): string {
	const maybe = make(depth);
	const copied = { ...maybe, value: depth * 10 };
	const again = { ...copied };
	return `${copied.value} ${copied.label ?? `none`} ${again.value} ${again.label ?? `none`} ${maybe?.label ?? `gone`}`;
}

let global: Tree | undefined = make(3);

function fromGlobal(): string {
	const spread = { ...global };
	return `${spread.value ?? 0} ${spread.label ?? `none`}`;
}

for (const depth of [2, 0]) {
	console.log(spreadMaybe(depth));
	console.log(relabel(depth));
	console.log(keepSource(depth));
}
console.log(fromGlobal());
global = undefined;
console.log(fromGlobal());
