import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { messageNoCaller } from './messages.a';

export class Rule {
    readonly context: RuleContext;
    constructor(context: RuleContext) {
        this.context = context;
    }
    visit(node: ParseNode, index: number): void {
        const receiverIndex = node.children[0] ?? -1;
        const key = node.children[node.children.length - 1] ?? -1;
        if(receiverIndex < 0 || key < 0) {
            return;
        }
        const receiver = this.context.node(this.context.unwrap(receiverIndex));
        if(receiver.kind !== 'Identifier' || receiver.text !== 'arguments') {
            return;
        }
        const name = this.context.node(key).text;
        if(name !== 'caller' && name !== 'callee') {
            return;
        }
        this.context.reportNode(key, 'no-caller', 'noCaller', messageNoCaller(name));
    }
}

export function create(context: RuleContext): Rule {
    return new Rule(context);
}
