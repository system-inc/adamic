const original = [10, 9, 1, -0, NaN, Infinity, -Infinity];
const reversed = original.toReversed();
console.log(`${original.join('|')} / ${reversed.join('|')} / ${original === reversed}`);
const sorted = original.toSorted();
console.log(`${original.join('|')} / ${sorted.join('|')} / ${original === sorted}`);
console.log(['\uFFFF', '🌍', 'a', ''].toSorted().join('|'));
console.log([true, false, true].toSorted().join('|'));
function compare(left: number, right: number): number { return left - right; }
console.log([10, 9, 1].toSorted(compare).join('|'));
const words = ['a' + 'b', 'c' + 'd', 'e' + 'f'];
const backwards = words.toReversed();
words.splice(0, 3);
console.log(backwards.join('|'));
const empty: number[] = [];
console.log(`${empty.toReversed().length} ${empty.toSorted().length}`);
const items = [{ key: 1, tag: 'a' }, { key: 0, tag: 'b' }, { key: 1, tag: 'c' }];
const stable = items.toSorted((left: { key: number; tag: string }, right: { key: number; tag: string }): number => left.key - right.key);
console.log(stable.map((item: { key: number; tag: string }): string => item.tag).join(''));
