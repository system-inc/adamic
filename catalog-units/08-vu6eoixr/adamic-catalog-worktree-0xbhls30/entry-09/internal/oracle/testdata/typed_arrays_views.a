function escaped(): Int32Array {
 const parent = new Int32Array([1, 2, 3, 4]);
 return parent.subarray(1).subarray(1, 2);
}
const alive = escaped();
console.log(`escaped ${alive[0]} ${alive.length}`);
alive[0] = 2147483648;
console.log(`converted ${alive[0]}`);
const parent = new Uint8Array([1, 2, 3, 4, 5]);
const child = parent.subarray(1, -1);
child[0] = 300;
parent[2] = -1;
console.log(`alias ${parent[1]} ${child[1]} ${child.length}`);
child.fill(7, -1);
console.log(`fill alias ${parent[3]}`);
parent.set(parent.subarray(0, 4), 1);
for (const value of parent) { console.log(`right overlap ${value}`); }
parent.subarray(0, 4).set(parent.subarray(1));
for (const value of parent) { console.log(`left overlap ${value}`); }
parent.set(new Uint8Array([]), parent.length);
console.log(`views ${parent.subarray(4, 1).length} ${parent.subarray(-Infinity, Infinity).length} ${parent.subarray(undefined, undefined).length} ${parent.subarray(NaN, -1.9).length}`);
const doubles = new Float64Array([-0, NaN, Infinity]);
const doubleView = doubles.subarray();
doubleView.set(doubleView, NaN);
console.log(`double alias ${1 / (doubleView[0] ?? 0)} ${doubleView[1]} ${doubleView[2]}`);
doubleView[1] = 3.25;
console.log(`double write ${doubles[1]}`);
function early(values: Float64Array): number {
 for (const value of values) { if (value === 0) { continue; } return value; }
 return -1;
}
console.log(`return ${early(new Float64Array([0, 9]))}`);
let held = new Float64Array([1, 2, 3]);
let index = 0;
for (const value of held) {
 console.log(`held ${value}`);
 held = new Float64Array(0);
 index += 1;
 if (index === 2) { break; }
}
try {
 for (const value of new Float64Array([5])) { throw new Error(value.toString()); }
} catch (error) { if (error instanceof Error) { console.log(`caught ${error.message}`); } }
