// The holder escapes on the way to a catch: a call that throws after storing it, and the write
// after the catch.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
let saved: Node = { kind: 'empty', nodes: [] };
function keepThenThrow(node: Node): void {
	saved = node;
	throw new Error('kept');
}
function current(): Node {
	return { kind: 'current', nodes: [saved] };
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	try {
		keepThenThrow(node);
	} catch (error) {
		node.nodes.push(current()); // closes the cycle
	}
	return node.nodes.length;
}
console.log(`${run(1)}`);
saved = { kind: 'cleared', nodes: [] };
