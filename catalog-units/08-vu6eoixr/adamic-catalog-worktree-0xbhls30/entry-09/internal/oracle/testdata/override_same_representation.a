class Base {
    scale(value: number, factor: number = 2): number { return value * factor; }
    widen(value: 3): number { return value; }
    optional(factor?: number): number { return factor ?? 2; }
}
class Child extends Base {
    override scale(value: number, factor: number = 2): number { return value * factor + 1; }
    override widen(value: number): number { return value + 1; }
    override optional(factor?: number): number { return (factor ?? 2) + 1; }
}
const values: readonly Base[] = [new Base(), new Child()];
for (const value of values) {
    console.log(`${value.scale(3)} ${value.scale(3, 4)} ${value.widen(3)} ${value.optional()} ${value.optional(4)}`);
}
