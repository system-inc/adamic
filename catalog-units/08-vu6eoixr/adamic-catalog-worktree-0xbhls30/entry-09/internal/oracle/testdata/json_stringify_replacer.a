// A replacer array keeps first-seen order, so duplicates and -0 collapse and integer keys are not re-sorted.
console.log(JSON.stringify({ '2': 'two', '10': 'ten', '1': 'one', a: 'A' }, ['10', '2', '10', '1']) ?? '<undefined>');
console.log(JSON.stringify({ '2': 'two', '10': 'ten', a: 'A', '0': 'zero' }, [10, 2, 10, 'a', 'a', -0, 0]) ?? '<undefined>');
console.log(JSON.stringify({ a: { b: 1, c: 2, a: 3 }, b: 4, c: 5 }, ['b', 'a', 'b']) ?? '<undefined>');
console.log(JSON.stringify({ a: 1, '1.5': 2, '-1': 3, '0': 4 }, [1.5, -1, 0, 0, '0', 'missing']) ?? '<undefined>');
console.log(JSON.stringify({ a: 1, 'undefined': 2 }, [undefined, 'a', undefined, 'undefined']) ?? '<undefined>');
console.log(JSON.stringify({ '2': 3, a: { '2': 1, b: 2, c: 9 }, b: 4 }, ['b', 'a', 2], 2) ?? '<undefined>');
