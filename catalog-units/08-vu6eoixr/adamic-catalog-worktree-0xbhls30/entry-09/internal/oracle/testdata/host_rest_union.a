function combine(path: string, ...paths: (string | undefined)[]): string {
    for (const next of paths) {
        if (!next) continue;
        path = path ? path + '/' + next : next;
    }
    return path;
}
let calls = 0;
function part(value: string | undefined): string | undefined { calls += 1; return value; }
console.log(combine('x'));
console.log(combine('x', part(undefined), part(''), part('a'), part('b')));
console.log(combine('', undefined, 'a', undefined, 'b'));
console.log(String(calls));

const entries: { name: string }[] = [{ name: 'z' }, { name: 'a' }];
for (const dirent of entries) {
    const entry = typeof dirent === 'string' ? dirent : dirent.name;
    console.log(entry);
}
