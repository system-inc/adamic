interface CompilerOptions { tscBuild?: boolean; }
type BuildOptions = CompilerOptions;
function getCompilerOptionsOfBuildOptions(buildOptions: BuildOptions): CompilerOptions {
    const result = {} as CompilerOptions;
    result.tscBuild = true;
    return result;
}

console.log(`${getCompilerOptionsOfBuildOptions({}).tscBuild}`);

interface CompilerOptions { configFilePath?: string; [key: string]: string | boolean | undefined; }
type CompilerOptionsValue = string | boolean | undefined;
function getOptionsNameMap() { return {optionsNameMap: new Map<string, string>()}; }
function hasProperty(_value: CompilerOptions, _key: string): boolean { return true; }
function convertToOptionValueWithAbsolutePaths(_option: string | undefined, value: CompilerOptionsValue, _toAbsolutePath: (path: string) => string): CompilerOptionsValue { return value; }
export function convertToOptionsWithAbsolutePaths(options: CompilerOptions, toAbsolutePath: (path: string) => string): CompilerOptions {
    const result: CompilerOptions = {};
    const optionsNameMap = getOptionsNameMap().optionsNameMap;

    for (const name in options) {
        if (hasProperty(options, name)) {
            result[name] = convertToOptionValueWithAbsolutePaths(
                optionsNameMap.get(name.toLowerCase()),
                options[name] as CompilerOptionsValue,
                toAbsolutePath,
            );
        }
    }
    if (result.configFilePath) {
        result.configFilePath = toAbsolutePath(result.configFilePath);
    }
    return result;
}

console.log(`${convertToOptionsWithAbsolutePaths({configFilePath: "tsconfig.json"}, path => "/project/" + path).configFilePath}`);
