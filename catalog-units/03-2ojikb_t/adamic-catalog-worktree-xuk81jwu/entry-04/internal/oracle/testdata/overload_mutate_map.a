function mutateMap<K, T>(map: Map<K, T>, newMap: ReadonlySet<K> | undefined, create: (key: K) => T): void;
// The set overload never reads the map-value type U of the other source arm.
function mutateMap<K, T, U>(map: Map<K, T>, newMap: ReadonlySet<K> | undefined, create: (key: K) => T): void {
    if (newMap === undefined) { map.clear(); return; }
    for (const key of newMap) if (!map.has(key)) map.set(key, create(key));
}
const values = new Map<string, number>([['old', 3]]);
mutateMap(values, new Set(['old', 'new']), (key) => key.length + 1);
console.log(`${values.size}:${values.get('old') ?? -1}:${values.get('new') ?? -1}`);
mutateMap(values, undefined, (key) => key.length);
console.log(`${values.size}`);
