// A function that reassigns its string parameter owns it: the write releases the old value, and
// that value is the caller's, which the caller goes on using. A borrowed parameter is never
// reassigned (docs/memory.md, "Borrowed parameters"); this is the program that breaks if one is.
// The strings are built at runtime, since literals are immortal, and each is held only by the
// caller's own variable, so a release that isn't the callee's to make frees it.
function louder(text: string, times: number): string {
	for (let index = 0; index < times; index++) {
		text = `${text}!`;
	}
	return text;
}

// The parameter here is only read, so it's borrowed, beside one that's reassigned.
function framed(text: string): string {
	return `[${text}]`;
}

const words = ['quiet', 'calm', 'still'];
for (let index = 0; index < words.length; index++) {
	const built = `${words[index] ?? ''}${index}`;
	const result = louder(built, index + 1);
	console.log(`${built} ${result} ${framed(built)} ${built.length}`);
}
