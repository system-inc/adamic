// The core.ts reduceLeft decision: an absent initial value differs from an
// explicitly passed undefined. The callback and loop retain that source shape.
function reduceLeft(items: readonly number[], callback: (memo: number | undefined, item: number, index: number) => number, initial?: number, start?: number, count?: number): number | undefined {
	if (items.length === 0) {
		return initial;
	}
	const size = items.length;
	let index = start === undefined || start < 0 ? 0 : start;
	const end = count === undefined || index + count > size - 1 ? size - 1 : index + count;
	let result: number | undefined;
	if (arguments.length <= 2) {
		result = items[index];
		index++;
	} else {
		result = initial;
	}
	while (index <= end) {
		result = callback(result, items[index] ?? 0, index);
		index++;
	}
	return result;
}
function sum(memo: number | undefined, item: number, index: number): number {
	return memo === undefined ? 100 + item + index : memo + item + index;
}
const items = [2, 3, 4];
console.log(`${reduceLeft(items, sum)}`);
console.log(`${reduceLeft(items, sum, undefined)}`);
console.log(`${reduceLeft(items, sum, 10)}`);
console.log(`${reduceLeft(items, sum, 10, 1, 0)}`);
console.log(`${reduceLeft([], sum, undefined)}`);
const value = reduceLeft;
console.log(`${value(items, sum)}`);
console.log(`${value(items, sum, undefined)}`);
