// next() after done stays done, including once the collection grows.
const emptyMap = new Map<number, string>();
const emptyKeys = emptyMap.keys();
const emptyFirst = emptyKeys.next();
const emptySecond = emptyKeys.next();
console.log(`empty ${emptyFirst.done} ${emptyFirst.value === undefined} ${emptySecond.done} ${emptySecond.value === undefined}`);
emptyMap.set(1, 'a');
const emptyThird = emptyKeys.next();
console.log(`empty grown ${emptyThird.done} ${emptyThird.value === undefined}`);

const map = new Map<number, string>([[1, 'a'], [2, 'b']]);
const keys = map.keys();
const first = keys.next();
if (!first.done) {
	console.log(`key ${first.value}`);
}
const mid = keys.next();
if (!mid.done) {
	console.log(`key ${mid.value}`);
}
const done = keys.next();
const doneAgain = keys.next();
console.log(`done ${done.done} ${done.value === undefined} ${doneAgain.done} ${doneAgain.value === undefined}`);
map.set(3, 'c');
const still = keys.next();
console.log(`still ${still.done} ${still.value === undefined}`);

const values = map.values();
const seen: string[] = [];
for (const value of values) {
	seen.push(value);
}
const afterValues = values.next();
console.log(`values after ${seen.join(',')} ${afterValues.done} ${afterValues.value === undefined}`);

const entries = new Map<number, string>([[7, 'g']]).entries();
const entry = entries.next();
if (!entry.done) {
	console.log(`entry ${entry.value[0]}=${entry.value[1]}`);
}
const entryDone = entries.next();
const entryAgain = entries.next();
console.log(`entry done ${entryDone.done} ${entryDone.value === undefined} ${entryAgain.done}`);

const set = new Set<number>([4]);
const setValues = set.values();
const setFirst = setValues.next();
if (!setFirst.done) {
	console.log(`set ${setFirst.value}`);
}
const setDone = setValues.next();
console.log(`set done ${setDone.done} ${setDone.value === undefined}`);
set.add(5);
const setStill = setValues.next();
console.log(`set still ${setStill.done} ${setStill.value === undefined}`);

const setEntries = new Set<number>([9]).entries();
const setEntry = setEntries.next();
if (!setEntry.done) {
	console.log(`set entry ${setEntry.value[0]} ${setEntry.value[1]}`);
}
const setEntryDone = setEntries.next();
console.log(`set entry done ${setEntryDone.done} ${setEntryDone.value === undefined}`);
