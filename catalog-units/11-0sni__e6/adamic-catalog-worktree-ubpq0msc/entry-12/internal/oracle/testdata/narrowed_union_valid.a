function first(text: boolean): string | number | boolean | undefined {
	return text ? 'word'.repeat(2) : 7;
}
let shared: string | number | boolean | undefined = first(true);
function keep(): void {
	shared = 'text'.repeat(2);
}
function check(): void {
	if (typeof shared === 'string') {
		keep();
		console.log(`kept: ${shared.length}`);
		console.log(`observed: ${typeof shared} ${shared === undefined}`);
	}
	shared = first(false);
	if (typeof shared === 'number') {
		console.log(`number: ${shared + 1}`);
	}
	shared = true;
	if (typeof shared === 'boolean') {
		console.log(`boolean: ${shared}`);
	}
}
check();
