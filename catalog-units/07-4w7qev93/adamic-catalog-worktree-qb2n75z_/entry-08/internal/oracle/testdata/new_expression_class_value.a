class Base {
    static readonly label: string = "base";
    readonly value: number;
    constructor(value: number) {
        this.value = value;
        console.log(`base ${value}`);
    }
}
class Derived extends Base {
    constructor(value: number) {
        super(value + 100);
        console.log(`derived ${value}`);
    }
}
let Constructor: typeof Base = Base;
function change(): number {
    console.log("argument");
    Constructor = Derived;
    return 7;
}
function make(Ctor: typeof Base, value: number): Base {
    return new Ctor(value);
}
const first = new Constructor(change());
console.log(`first ${first.value}`);
const second = new Constructor(8);
console.log(`second ${second.value}`);
console.log(`parameter ${make(Base, 9).value}`);
console.log(`parameter ${make(Derived, 10).value}`);
function choose(): typeof Base {
    console.log("choose");
    return Constructor;
}
const third = new (choose())(11);
console.log(`chosen ${third.value}`);
Constructor = Base;
const fourth = new (Constructor === Base ? Constructor : Derived)(12);
console.log(`conditional ${fourth.value}`);
const holder: {readonly Ctor: typeof Base} = {Ctor: Constructor};
const fifth = new holder.Ctor(change());
console.log(`property ${fifth.value}`);
function getHolder(): {readonly Ctor: typeof Base} {
    console.log("holder");
    return {Ctor: Constructor};
}
const sixth = new (getHolder().Ctor)(13);
console.log(`holder ${sixth.value}`);

function makeStructural(Ctor: new (value: number) => Base, value: number): Base {
    return new Ctor(value);
}
console.log(`structural ${makeStructural(Derived, 14).value}`);
let Cached: typeof Base | undefined;
const cachedFirst = new (Cached ?? (Cached = choose()))(15);
const cachedSecond = new (Cached ?? (Cached = choose()))(16);
console.log(`cached ${cachedFirst.value} ${cachedSecond.value}`);
