function sortAndDeduplicate(array: readonly string[]): readonly string[];
function sortAndDeduplicate<T extends string>(array: readonly T[]): readonly T[] {
    const sorted = array.slice();
    sorted.sort((left, right) => left < right ? -1 : left > right ? 1 : 0);
    const result: T[] = [];
    let previous: T | undefined = undefined;
    for (const value of sorted) {
        if (previous === undefined || previous !== value) result.push(value);
        previous = value;
    }
    return result;
}
console.log(sortAndDeduplicate(['b', 'a', 'b', 'a', 'c']).join(','));
console.log(sortAndDeduplicate([]).join(','));
