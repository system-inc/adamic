// The file's comments, as cohere's comment scan sees them: only comments reachable from a token boundary
// count, so a comment-shaped run inside a literal or a template is never one. Built once per file by the
// rule's SourceFile visit.
import type { RuleContext } from '../../context.ts';
import type { ParseNode } from '../../../../typescript/parser/nodes.ts';
import { CommentRange, comments as collectComments } from '../../comment_ranges.a';
import { space as commentSpace } from '../../comments.ts';
import { isLineBreak, isSpace } from '../../../../typescript/scanner/characters.ts';

function isParameterListKind(kind: string): boolean {
    switch(kind) {
        case 'FunctionDeclaration':
        case 'FunctionExpression':
        case 'ArrowFunction':
        case 'MethodDeclaration':
        case 'Constructor':
        case 'GetAccessor':
        case 'SetAccessor':
        case 'FunctionType':
        case 'ConstructorType':
        case 'CallSignature':
        case 'ConstructSignature':
        case 'MethodSignature':
        case 'IndexSignature':
            return true;
        default:
            return false;
    }
}
function isBracedListKind(kind: string): boolean {
    switch(kind) {
        case 'ClassDeclaration':
        case 'ClassExpression':
        case 'Block':
        case 'CaseBlock':
        case 'ModuleBlock':
        case 'InterfaceDeclaration':
        case 'EnumDeclaration':
        case 'TypeLiteral':
        case 'ObjectLiteralExpression':
        case 'ObjectBindingPattern':
        case 'NamedImports':
        case 'NamedExports':
            return true;
        default:
            return false;
    }
}
export function trim(value: string): string {
    let start = 0;
    let end = value.length;
    while(start < end && commentSpace(value[start] ?? '')) { start++; }
    while(end > start && commentSpace(value[end - 1] ?? '')) { end--; }
    return value.slice(start, end);
}
export function commentRanges(context: RuleContext, node: ParseNode, index: number): readonly CommentRange[] {
    const anchors = new Array<boolean>(context.source.length + 1).fill(false);
    commentAnchors(context, index, anchors, node);
    anchors[0] = true;
    return collectComments(context.source, context.literalEnds(), reachableComments(context, anchors));
}
export function commentAnchors(context: RuleContext, index: number, anchors: boolean[], node: ParseNode): void {
    anchors[node.pos] = true;
    anchors[node.end] = true;
    const parameterList = isParameterListKind(node.kind);
    const argumentsList = node.kind === 'CallExpression' || node.kind === 'NewExpression';
    const bracedList = isBracedListKind(node.kind);
    const arrayList = node.kind === 'ArrayLiteralExpression' || node.kind === 'ArrayBindingPattern';
    const caseList = node.kind === 'CaseClause' || node.kind === 'DefaultClause';
    if(parameterList || argumentsList || bracedList || arrayList || caseList) {
        const children = new Map<number, number>();
        const start = context.start(index);
        for(const child of node.children) {
            const childStart = Math.max(start, context.node(child).pos);
            children.set(childStart, Math.max(children.get(childStart) ?? 0, context.node(child).end));
        }
        let depth = 0;
        for(let position = start; position < node.end; position++) {
            const childEnd = children.get(position);
            if(childEnd !== undefined && childEnd > position) {
                position = childEnd - 1;
                continue;
            }
            const code = context.source.charCodeAt(position);
            if(code === 47) {
                const next = context.source.charCodeAt(position + 1);
                if(next === 47) {
                    while(position < node.end && !isLineBreak(context.source.charCodeAt(position))) {
                        position++;
                    }
                    continue;
                }
                if(next === 42) {
                    const close = context.source.indexOf('*/', position + 2);
                    position = close < 0 ? node.end : close + 1;
                    continue;
                }
            }
            const opening =
                parameterList || argumentsList ? (node.kind === 'IndexSignature' ? 91 : 40) : arrayList ? 91 : 123;
            const closing = opening === 40 ? 41 : opening === 91 ? 93 : 125;
            if(code === opening) {
                depth++;
                if(depth === 1) {
                    anchors[position + 1] = true;
                }
            }
            if(code === closing) {
                depth--;
            }
            if(code === 44 && depth === 1) {
                anchors[position + 1] = true;
            }
            if(caseList && code === 58) {
                anchors[position + 1] = true;
            }
        }
    }
    for(const child of node.children) {
        commentAnchors(context, child, anchors, context.node(child));
    }
}
export function reachableComments(context: RuleContext, anchors: readonly boolean[]): boolean[] {
    const reachable = new Array<boolean>(context.source.length + 1).fill(false);
    for(let anchor = 0; anchor < anchors.length; anchor++) {
        if(anchors[anchor] !== true) {
            continue;
        }
        let position = anchor;
        while(
            position < context.source.length &&
            (context.source.charCodeAt(position) === 32 ||
                (context.source.charCodeAt(position) >= 9 && context.source.charCodeAt(position) <= 13))
        ) {
            position++;
        }
        if(anchor === 0 && context.source.startsWith('#!')) {
            while(position < context.source.length && !isLineBreak(context.source.charCodeAt(position))) {
                position++;
            }
        }
        if(context.source.charCodeAt(position) !== 47) {
            continue;
        }
        for(;;) {
            while(
                position < context.source.length &&
                (isSpace(context.source.charCodeAt(position)) ||
                    isLineBreak(context.source.charCodeAt(position)))
            ) {
                position++;
            }
            const opening =
                context.source.charCodeAt(position) === 47
                    ? context.source.slice(position, position + 2)
                    : '';
            if(opening !== '//' && opening !== '/*') {
                break;
            }
            reachable[position] = true;
            if(opening === '//') {
                while(
                    position < context.source.length &&
                    !isLineBreak(context.source.charCodeAt(position))
                ) {
                    position++;
                }
            }
            else {
                const close = context.source.indexOf('*/', position + 2);
                position = close < 0 ? context.source.length : close + 2;
            }
        }
    }
    return reachable;
}
