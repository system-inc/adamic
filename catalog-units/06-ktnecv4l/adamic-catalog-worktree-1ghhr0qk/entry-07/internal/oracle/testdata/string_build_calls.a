// The library call path uses the same runtime on strings built at runtime.
function show(text: string): void {
	const codes: number[] = [];
	for (let index = 0; index < text.length; index++) {
		codes.push(text.charCodeAt(index));
		codes.push(text.codePointAt(index) ?? -1);
	}
	console.log(`${text.length}:${codes.join(',')}`);
}
const made = 'a🌍é'.repeat(20);
show(String.prototype.concat.call('\ud83c', '\udf0d', made));
show(String.prototype.repeat.call('\udf0d\ud83c', 3));
show(String.prototype.padStart.call('\udf0d', 5, '🌍'));
show(String.prototype.padEnd.call('\ud83c', 5, '\udf0d'));
show(String.prototype.slice.call(made, 2, 7));
show(String.prototype.substring.call(made, 7, 2));
console.log(`${String.prototype.charCodeAt.call(made, 2)} ${String.prototype.codePointAt.call(made, 1) ?? -1}`);
const literal = 'a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世a🌍é世';
show(literal.slice(5, 60));
show(literal.slice(5, 60).slice(5, 50));
