// Named Set callbacks over objects: the element is passed twice, then kept after delete.
interface Box {
	readonly label: string;
}

function box(label: string): Box {
	return { label: `${label}` };
}

let kept: Box[] = [];
let later = box("later");

function filled(): Set<Box> {
	const collection = new Set<Box>();
	later = box("k1");
	collection.add(box("k0"));
	collection.add(later);
	collection.add(box("k2"));
	return collection;
}

function deleteLater(item: Box, current: Box, owner: Set<Box>): void {
	if (current.label === "k0") { owner.delete(later); }
	kept.push(item);
	kept.push(current);
	console.log(`later ${item.label} ${current.label} ${item === current} ${owner.size}`);
}

function reassignFirst(item: Box, current: Box, owner: Set<Box>): void {
	owner.delete(current);
	console.log(`first ${item.label} ${current.label}`);
	item = box(`${item.label}/reassigned`);
	kept.push(current);
	kept.push(item);
	console.log(`reassigned ${item.label} ${current.label}`);
}

function throwBorrowed(item: Box, current: Box, owner: Set<Box>): void {
	owner.clear();
	kept.push(current);
	throw new Error(`cleared ${current.label} ${item.label}`);
}

function run(name: string, visit: (item: Box, current: Box, owner: Set<Box>) => void): void {
	kept = [];
	const collection = filled();
	try {
		collection.forEach(visit);
	} catch (error) {
		console.log(error instanceof Error ? error.message : "unexpected");
	}
	console.log(`${name} kept ${kept.map((item) => item.label).join(",")} remaining ${collection.size}`);
	const after: string[] = [];
	collection.forEach((item) => { after.push(item.label); });
	console.log(`${name} after ${after.join(",")}`);
}

run("later", deleteLater);
run("reassign", reassignFirst);
run("throw", throwBorrowed);
