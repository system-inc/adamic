{
    "rule": "@typescript-eslint/consistent-type-exports",
    "firing": {
        "file": "main.ts",
        "source": "type T = 1;\nexport { T };\n",
        "findings": [
            {
                "line": 2,
                "column": 1,
                "endLine": 2,
                "endColumn": 14,
                "messageId": "typeOverValue",
                "message": "Every name in this export is a type, so the statement emits an import at runtime that resolves to nothing. Writing `export type` tells the compiler and any bundler that the whole statement can be erased.",
                "fix": true
            }
        ],
        "fixedSource": "type T = 1;\nexport type { T };\n"
    },
    "clean": {
        "file": "main.ts",
        "source": "import { Type1 } from './consistent-type-exports/index';\nexport { Type1 };"
    },
    "assertedMessageIds": [
        "multipleExportsAreTypes",
        "singleExportIsType",
        "typeOverValue"
    ],
    "assertsFix": true
}
