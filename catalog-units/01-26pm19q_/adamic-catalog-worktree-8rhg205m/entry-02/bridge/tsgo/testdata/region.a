import { panic, programArguments, tsgoProgram, tsgoQuery, tsgoRelease } from 'adamic';

// String length is pure, so the query result can live in the statement's region.
function measure(answer: { readonly nodeKind: number; readonly symbolName: string; readonly type: string }): number {
	return answer.symbolName.length + answer.type.length;
}

const argumentsGiven = programArguments();
const config = argumentsGiven[0] ?? panic('missing config');
const file = argumentsGiven[1] ?? panic('missing file');
const program = tsgoProgram(config, [file]);
console.log(`${measure(tsgoQuery(program, file, 14))}`);
tsgoRelease(program);
