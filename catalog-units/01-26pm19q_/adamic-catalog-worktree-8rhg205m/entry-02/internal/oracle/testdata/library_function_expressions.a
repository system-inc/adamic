function counter(start: number): (amount: number) => string {
	let total = start;
	return function add(amount: number): string {
		total += amount;
		return `count:${total}`;
	};
}
const first = counter(10);
const second = counter(100);
console.log(`${first(2)} ${first(3)} ${second(4)}`);
const factorial = function fact(value: number): number {
	return value === 0 ? 1 : value * fact(value - 1);
};
const saved = factorial;
console.log(`${saved(6)}`);
const self = function identity(): () => unknown {
	return identity;
};
console.log(`${self() === self}`);
const functions: (() => string)[] = [];
for (let index = 0; index < 3; index += 1) {
	functions.push(function (): string { return `iteration:${index}`; });
}
console.log(functions.map(function (call): string { return call(); }).join(','));
console.log([1, 2, 3].map(function (value, index): number { return value * 10 + index; }).join(','));
console.log([4, 2, 8].sort(function compare(left, right): number { return left - right; }).join(','));
const holder = { callback: function (value: number): number { return value + 5; } };
console.log(`${holder.callback(7)}`);
class NamedObject {
	readonly value = 42;
	read(): number {
		const ordinary = function (): number { return 7; };
		const arrow = (): number => this.value;
		return ordinary() + arrow();
	}
}
console.log(`${new NamedObject().read()}`);
try {
	[1].forEach(function (): void { throw new Error('expression throw'); });
} catch (error) {
	if (error instanceof Error) {
		console.log(error.message);
	}
}

console.log(Array.from({ length: 3 }, function (_value: unknown, index: number): number { return index * 2; }).join(","));
