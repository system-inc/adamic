import { Buffer } from 'node:buffer';
// All lead bytes with every possible first continuation, including truncation.
for (let lead = 0; lead < 256; lead += 1) {
 console.log(Buffer.from([lead]).toString('utf8'));
 for (let next = 0; next < 256; next += 1) {
  console.log(Buffer.from([lead, next]).toString('utf8'));
 }
}
for (const hex of ['e282', 'e28241', 'eda080', 'edbfbf', 'e08080', 'f0908080', 'f08f8080', 'f4908080', 'f48fbfbf', 'f5808080', 'f09f8c', 'f09f8c41', 'f09f8c8d', 'efbbbf']) {
 const text = Buffer.from(hex, 'hex').toString('utf8');
 console.log(`${text.length}:${Buffer.from(text).toString('hex')}`);
}
