// Same names as the prelude are ordinary functions when declared locally.
function readTextFile(values: string): string {
	return 'readTextFile:' + values;
}
function writeTextFile(values: string): string {
	return 'writeTextFile:' + values;
}
function utf8Length(values: string): string {
	return 'utf8Length:' + values;
}
function utf8At(values: string): string {
	return 'utf8At:' + values;
}
function readDirectory(values: string): string {
	return 'readDirectory:' + values;
}
function fileStatus(values: string): string {
	return 'fileStatus:' + values;
}
function programArguments(values: string): string {
	return 'programArguments:' + values;
}
const tuple: [string, string] = ['é', 'tail'];
const array: string[] = ['array', 'value'];
console.log(readTextFile(`${tuple[0]}|${tuple[1]}`));
console.log(readTextFile(array.join('|')));
console.log(readTextFile([...array, 'nested'].join('|')));
console.log(writeTextFile(`${tuple[0]}|${tuple[1]}`));
console.log(writeTextFile(array.join('|')));
console.log(writeTextFile([...array, 'nested'].join('|')));
console.log(utf8Length(`${tuple[0]}|${tuple[1]}`));
console.log(utf8Length(array.join('|')));
console.log(utf8Length([...array, 'nested'].join('|')));
console.log(utf8At(`${tuple[0]}|${tuple[1]}`));
console.log(utf8At(array.join('|')));
console.log(utf8At([...array, 'nested'].join('|')));
console.log(readDirectory(`${tuple[0]}|${tuple[1]}`));
console.log(readDirectory(array.join('|')));
console.log(readDirectory([...array, 'nested'].join('|')));
console.log(fileStatus(`${tuple[0]}|${tuple[1]}`));
console.log(fileStatus(array.join('|')));
console.log(fileStatus([...array, 'nested'].join('|')));
console.log(programArguments(`${tuple[0]}|${tuple[1]}`));
console.log(programArguments(array.join('|')));
console.log(programArguments([...array, 'nested'].join('|')));
