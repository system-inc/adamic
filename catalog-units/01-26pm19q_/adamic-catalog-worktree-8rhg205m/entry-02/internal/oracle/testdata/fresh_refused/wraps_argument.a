// A function that makes a fresh value, holding its argument.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function wrap(node: Node): Node {
	return { kind: 'wrap', nodes: [node] };
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	node.nodes.push(wrap(node)); // closes the cycle
	return node.nodes.length;
}
console.log(`${run(1)}`);
