// The holder is captured into the value before the write: wrapper holds node, and node's children
// are given wrapper. node.nodes then reaches itself.
interface Node {
	readonly kind: string;
	readonly nodes: Node[];
}
function run(n: number): number {
	const node: Node = { kind: `n${n}`, nodes: [] };
	const wrapper: Node = { kind: `w${n}`, nodes: [node] };
	node.nodes.push(wrapper); // closes the cycle
	return node.nodes.length + wrapper.nodes.length;
}
console.log(`${run(1)}`);
