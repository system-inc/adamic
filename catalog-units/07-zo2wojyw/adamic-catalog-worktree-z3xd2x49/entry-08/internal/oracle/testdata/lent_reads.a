// A read lent without a count (internal/native/borrow.go) is only safe when nothing can run between
// it and its use. Each line here puts a call that reassigns what's read beside the read, or beside
// its consumer: JavaScript uses the value read before the call, which must still be alive. The
// strings are built at runtime and held only by what's reassigned, so a read that took no count
// would be freed under its reader.
interface Holder {
	name: string;
}

let text = `abc${1}`;
function change(): number {
	text = `xyz${2}`;
	return 0;
}

const holder: Holder = { name: `field${3}` };
function rename(): number {
	holder.name = `other${4}`;
	return 1;
}

function pick(first: number, second: number): number {
	return first + second * 0;
}

function captured(): string {
	let label = `label${5}`;
	const relabel = (): number => {
		label = `relabeled${6}`;
		return 2;
	};
	return `${label.charCodeAt(relabel())} ${label}`;
}

console.log(`${text.charCodeAt(change())} ${text}`);
text = `abc${7}`;
console.log(`${pick(text.charCodeAt(0), change())} ${text}`);
console.log(`${holder.name.charCodeAt(rename())} ${holder.name}`);
holder.name = `field${8}`;
console.log(`${pick(holder.name.length, rename())} ${holder.name}`);
console.log(captured());
console.log(`${text.length + text.charCodeAt(1)} ${holder.name.slice(1, 3)}`);
