const cases = [[], [1]];
for(const values of cases) {
    console.log(`before ${values.length} ${values[0]}`);
    values.push(9);
    console.log(`after ${values.length} ${values[0]} ${values[1]}`);
}
const words = [[], ['word'.repeat(2)]];
for(const values of words) {
    values.push('fresh'.repeat(2));
    console.log(`${values.length} ${values[0]} ${values[1] ?? 'missing'}`);
}
