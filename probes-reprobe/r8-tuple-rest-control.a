// Row 8 control: the same array made by a literal.
interface Node { name: string; next: Node[]; tails: Node[][] }
const a: Node = { name: 'a' + '', next: [], tails: [] };
const b: Node = { name: 'b' + '', next: [a], tails: [] };
a.next.push(b); // a cycle: the program is a graph program
const pool: [Node, Node] = [a, b];
const first = pool[0];
const rest: Node[] = [pool[1]];
a.tails.push(rest); // a holds rest, rest holds b, b holds a
const tail = a.tails[0];
if (tail !== undefined) console.log(`${first.name} ${a.tails.length} ${tail.length} ${tail[0] === b}`);
