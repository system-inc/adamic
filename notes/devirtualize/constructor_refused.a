class Base {
    ready = 'ready';
    constructor() { console.log(`${this.ready}/${this.run()}`); }
    run(): string { return 'base'; }
}
class Child extends Base { override run(): string { return 'child'; } }
const base = new Base();
const child = new Child();
console.log(`${base.run()}/${child.run()}`);

