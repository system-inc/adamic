// Row 14: a Node a parallelMap task makes comes back counted; the main thread closes a cycle through
// it and a graph member: a holds made, made holds a.
import { parallelMap } from 'adamic';
interface Node { name: string; next: Node[] }
const a: Node = { name: 'a' + '', next: [] };
const b: Node = { name: 'b' + '', next: [a] };
a.next.push(b); // a cycle: the program is a graph program
const items: readonly number[] = [1, 2];
function build(item: number): Node { return { name: `n${item}`, next: [] }; }
const made = parallelMap(items, build);
const first = made[0];
if (first !== undefined) {
  a.next.push(first);
  first.next.push(a);
}
console.log(`${a.next.length} ${made.length}`);
