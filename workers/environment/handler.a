import type { HttpRequest, HttpResponse } from 'adamic/http';
interface Environment {
    readonly ZONE: string;
    readonly GREETING: string;
}
async function text(value: string): Promise<string> { return value; }
export async function handle(request: HttpRequest, environment: Environment): Promise<HttpResponse> {
    const greeting = await text(environment.GREETING);
    return { status: 200, headers: [{ name: 'content-type', value: 'text/plain; charset=utf-8' }],
        body: greeting + ' ' + environment.ZONE + ' ' + request.path };
}
