import { decodeJson, encodeJson, panic } from 'adamic';
import type { HttpField, HttpRequest, HttpResponse } from 'adamic/http';

interface StatsRequest { readonly values: readonly number[]; }
interface Item { readonly sku: string; readonly quantity: number; readonly unitPriceCents: number; }
interface Order {
	readonly currency: 'USD' | 'EUR';
	readonly shippingZone: 'domestic' | 'international';
	readonly items: readonly Item[];
	readonly couponCode?: string;
}
interface TextRequest { readonly text: string; readonly limit: number; }

// These declarations specify the observable JSON field order.
interface ErrorBody { readonly error: string; }
interface PrimesBody { readonly limit: number; readonly count: number; readonly last: number; }
interface StatsBody {
	readonly count: number;
	readonly mean: number;
	readonly median: number;
	readonly p95: number;
	readonly min: number;
	readonly max: number;
	readonly standardDeviation: number;
}
interface QuoteLine { readonly sku: string; readonly quantity: number; readonly lineCents: number; }
interface QuoteBody {
	readonly currency: 'USD' | 'EUR';
	readonly subtotalCents: number;
	readonly discountCents: number;
	readonly shippingCents: number;
	readonly taxCents: number;
	readonly totalCents: number;
	readonly lines: readonly QuoteLine[];
}
interface Word { readonly word: string; readonly count: number; }
interface WordsBody { readonly words: readonly Word[]; }

function json(body: string, status = 200, allow?: string): HttpResponse {
	const headers: HttpField[] = [];
	if (allow !== undefined) headers.push({ name: 'allow', value: allow });
	headers.push({ name: 'content-type', value: 'application/json; charset=utf-8' });
	return { status, headers, body };
}
function error(message: string, status: number, allow?: string): HttpResponse {
	return json(encodeJson<ErrorBody>({ error: message }), status, allow);
}
function invalid(): HttpResponse { return error('invalid request', 400); }
function integer(value: number, minimum: number, maximum: number): boolean {
	return Number.isInteger(value) && value >= minimum && value <= maximum;
}
function skuValid(sku: string): boolean {
	if (sku.length < 1 || sku.length > 32) return false;
	for (let index = 0; index < sku.length; index += 1) {
		const unit = sku.charCodeAt(index);
		if (!((unit >= 65 && unit <= 90) || (unit >= 48 && unit <= 57) || unit === 45)) return false;
	}
	return true;
}
function primes(limit: number): PrimesBody {
	const composite = new Uint8Array(limit + 1);
	for (let prime = 2; prime * prime <= limit; prime += 1) {
		if (composite[prime] === 0) {
			for (let multiple = prime * prime; multiple <= limit; multiple += prime) composite[multiple] = 1;
		}
	}
	let count = 0;
	let last = 0;
	for (let value = 2; value <= limit; value += 1) {
		if (composite[value] === 0) { count += 1; last = value; }
	}
	return { limit, count, last };
}
function numberAt(values: readonly number[], index: number): number {
	return values[index] ?? panic('stats index out of bounds');
}
function summarize(values: readonly number[]): StatsBody {
	const count = values.length;
	let sum = 0;
	for (let index = 0; index < count; index += 1) sum = sum + numberAt(values, index);
	const mean = sum / count;
	const sorted = values.slice().sort((left, right) => left - right);
	const middle = Math.floor(count / 2);
	const median = count % 2 === 1 ? numberAt(sorted, middle) : (numberAt(sorted, middle - 1) + numberAt(sorted, middle)) / 2;
	const p95 = numberAt(sorted, Math.ceil(0.95 * count) - 1);
	let squaredSum = 0;
	for (let index = 0; index < count; index += 1) {
		const difference = numberAt(values, index) - mean;
		squaredSum = squaredSum + difference * difference;
	}
	const standardDeviation = Math.sqrt(squaredSum / count);
	return { count, mean, median, p95, min: numberAt(sorted, 0), max: numberAt(sorted, count - 1), standardDeviation };
}
function quote(value: Order): QuoteBody {
	let subtotalCents = 0;
	const lines: QuoteLine[] = [];
	for (const entry of value.items) {
		const lineCents = Math.round(entry.quantity * entry.unitPriceCents);
		subtotalCents = subtotalCents + lineCents;
		lines.push({ sku: entry.sku, quantity: entry.quantity, lineCents });
	}
	const discountCents = value.couponCode === 'SAVE10' ? Math.round(subtotalCents * 0.1)
		: value.couponCode === 'FLAT500' ? Math.min(500, subtotalCents) : 0;
	const shippingCents = value.shippingZone === 'domestic' ? (subtotalCents >= 5000 ? 0 : 799) : 2499;
	const taxCents = value.shippingZone === 'domestic' ? Math.round((subtotalCents - discountCents) * 0.0725) : 0;
	const totalCents = subtotalCents - discountCents + shippingCents + taxCents;
	return { currency: value.currency, subtotalCents, discountCents, shippingCents, taxCents, totalCents, lines };
}
function asciiToken(unit: number): boolean {
	return (unit >= 65 && unit <= 90) || (unit >= 97 && unit <= 122) || (unit >= 48 && unit <= 57);
}
function topWords(value: TextRequest): WordsBody {
	const counts = new Map<string, number>();
	let start = 0;
	for (let index = 0; index <= value.text.length; index += 1) {
		if (index < value.text.length && asciiToken(value.text.charCodeAt(index))) continue;
		if (index > start) {
			const word = value.text.slice(start, index).toLowerCase();
			counts.set(word, (counts.get(word) ?? 0) + 1);
		}
		start = index + 1;
	}
	const words: Word[] = [];
	for (const [word, count] of counts) words.push({ word, count });
	words.sort((left, right) => left.count !== right.count ? right.count - left.count : left.word < right.word ? -1 : left.word > right.word ? 1 : 0);
	return { words: words.slice(0, value.limit) };
}

export function handle(request: HttpRequest): HttpResponse {
	const path = request.path;
	const method = path === '/health' || path === '/primes' ? 'GET'
		: path === '/stats' || path === '/orders/quote' || path === '/text/top-words' ? 'POST' : '';
	if (method === '') return error('not found', 404);
	if (request.method !== method) return error('method not allowed', 405, method);
	if (path === '/health') return { status: 200, headers: [{ name: 'content-type', value: 'text/plain; charset=utf-8' }], body: 'ok' };
	if (path === '/primes') {
		let raw = '';
		for (const field of request.query) { if (field.name === 'limit') { raw = field.value; break; } }
		if (raw.length === 0 || (raw.length > 1 && raw.charCodeAt(0) === 48)) return invalid();
		for (let index = 0; index < raw.length; index += 1) {
			const unit = raw.charCodeAt(index);
			if (unit < 48 || unit > 57) return invalid();
		}
		const limit = Number(raw);
		if (limit > 5000000) return invalid();
		return json(encodeJson<PrimesBody>(primes(limit)));
	}
	if (path === '/stats') {
		const decoded = decodeJson<StatsRequest>(request.body);
		if (decoded.kind === 'Error') return invalid();
		const values = decoded.value.values;
		if (values.length < 1 || values.length > 100000) return invalid();
		for (const value of values) { if (Number.isFinite(value) !== true) return invalid(); }
		return json(encodeJson<StatsBody>(summarize(values)));
	}
	if (path === '/orders/quote') {
		const decoded = decodeJson<Order>(request.body);
		if (decoded.kind === 'Error') return invalid();
		const value = decoded.value;
		if (value.items.length < 1 || value.items.length > 100) return invalid();
		for (const entry of value.items) {
			if (skuValid(entry.sku) !== true || integer(entry.quantity, 1, 1000) !== true || integer(entry.unitPriceCents, 0, 10000000) !== true) return invalid();
		}
		if (value.couponCode !== undefined && value.couponCode !== 'SAVE10' && value.couponCode !== 'FLAT500') return invalid();
		return json(encodeJson<QuoteBody>(quote(value)));
	}
	const decoded = decodeJson<TextRequest>(request.body);
	if (decoded.kind === 'Error') return invalid();
	if (decoded.value.text.length > 1000000 || integer(decoded.value.limit, 1, 100) !== true) return invalid();
	return json(encodeJson<WordsBody>(topWords(decoded.value)));
}
