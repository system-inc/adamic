// JD3: a decoded recursive tree given a cycle through a required mutable array: the decoded
// objects were made outside any region.
import { decodeJson } from 'adamic';
interface Tree {
	name: string;
	kids: Tree[];
}
const result = decodeJson<Tree>('{"name":"a","kids":[{"name":"b","kids":[]}]}');
if (result.kind === 'Error') {
	console.log(result.message);
} else {
	const a = result.value;
	const b = a.kids[0];
	if (b !== undefined) {
		b.kids.push(a);
		console.log(`${a.name} ${b.name} ${b.kids.length}`);
	}
}
