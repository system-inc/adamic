// JD2: a decoded value written into a cycle with a literal: decoded b kept by literal a, which b then holds.
import { decodeJson } from 'adamic';
interface Link {
	name: string;
	next?: Link;
}
const result = decodeJson<Link>('{"name":"b"}');
if (result.kind !== 'Error') {
	const b = result.value;
	const a: Link = { name: 'a' + '', next: b };
	b.next = a;
	console.log(`${a.name} ${b.name}`);
}
